#ifndef HCCL_API_TEST_MEASUREMENT_H
#define HCCL_API_TEST_MEASUREMENT_H

// Communication diagnosis only: this delay is not an AICPU expansion-ready acknowledgement.
static constexpr bool HCCL_API_TEST_AUTO_COMMIT = !@MC2_BENCH_COMM_ONLY_VALUE@;
static constexpr uint32_t HCCL_API_TEST_COMMIT_DELAY_NOPS = 5000000;

template <typename HcclType, typename HandleType>
__aicore__ inline void HcclApiTestCommit(HcclType& hccl, HandleType handle)
{
    if constexpr (!HCCL_API_TEST_AUTO_COMMIT) {
        const uint64_t start = static_cast<uint64_t>(AscendC::GetSystemCycle());

        while (static_cast<uint64_t>(AscendC::GetSystemCycle()) - start <
            HCCL_API_TEST_COMMIT_DELAY_NOPS) {}

        hccl.Commit(handle);
    }
}
#endif
