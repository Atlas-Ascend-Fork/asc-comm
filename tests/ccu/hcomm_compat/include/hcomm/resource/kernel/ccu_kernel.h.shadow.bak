#ifndef ASCCOMM_CCU_UT_CCU_KERNEL_H
#define ASCCOMM_CCU_UT_CCU_KERNEL_H

#include "hcomm/resource/representation/context/ccu_rep_context_v1.h"
#include "hcomm/resource/representation/interface/ccu_datatype_v1.h"
#include "hcomm/resource/representation/interface/ccu_interface_assist_v1.h"

#include <unordered_map>

namespace asc {
class ccu_kernel : public asc::ccu_rep::ccu_rep_context {
public:
    ~ccu_kernel() override;
    void append(std::shared_ptr<asc::ccu_rep::ccu_rep_base> rep) override;
    asc::ccu_rep::variable create_variable();

    std::unordered_map<uint64_t, asc::ccu_rep::variable>& get_const_value2_var_map() { return const_value2_var_map_; }

private:
    std::unordered_map<uint64_t, asc::ccu_rep::variable> const_value2_var_map_{};
};
} // namespace asc

#endif
