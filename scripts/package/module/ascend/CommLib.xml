<?xml version="1.0" encoding="UTF-8"?>
<block name="CommLib" copy_type="delivery" src_path="" dst_path="" install_path="" install_own="$username:$usergroup" install_mod="550" install_type="run;devel">
    <dir_info install_mod="550">
        <path value="$(TARGET_ENV)/lib64"/>
        <path value="$(TARGET_ENV)/include" install_type="devel"/>
        <path value="$(TARGET_ENV)/include/collective_comm" install_type="devel"/>
        <path value="$(TARGET_ENV)/include/collective_comm/host" install_type="devel"/>
        <path value="$(TARGET_ENV)/include/collective_comm/device" install_type="devel"/>
        <path value="opp"/>
        <path value="opp/built-in"/>
        <path value="opp/built-in/op_impl"/>
        <path value="opp/built-in/op_impl/aicpu"/>
        <path value="opp/built-in/op_impl/aicpu/kernel"/>
        <path value="opp/built-in/op_impl/aicpu/config"/>
    </dir_info>
    <file_info value="include" copy_type="source" src_path="asc-comm/include/collective_comm/device" dst_path="include/asc-comm" install_path="$(TARGET_ENV)/include/asc-comm" install_type="devel" install_mod="440">
        <file value="hccl_msg.h"/>
        <file value="hccl.h"/>
