        <file value="libmc2_client.so" file_type="shared"/>
        <file value="libmc2_compat.so" file_type="shared"/>
    </file_info>
    <file_info value="device" copy_type="delivery" src_path="build" dst_path="Ascend/aicpu" install_path="opp/built-in/op_impl/aicpu/kernel" install_type="all" install_mod="440" optional="true">
