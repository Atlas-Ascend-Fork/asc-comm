/*!
 * \file roce_normal_write_read.asc
 * \brief Host side of the Hcomm RoCE normal write/read example.
 */

#include <cstdint>
#include <cstdio>
#include <cstring>
#include <vector>

#include <mpi.h>

#include "acl/acl.h"
#include "hccl/hccl.h"
#include "hccl/hccl_comm.h"
#include "hccl/hccl_rank_graph.h"
#include "hccl/hccl_res.h"
#include "hccl/hccl_types.h"

extern "C" void LaunchHcommRoceWriteRead(
    uint64_t channel, uint64_t localBuffer, uint64_t remoteBuffer, void* context, void* stream);

#include "hcomm_roce_rw_def.h"

namespace {

using HcommRoceExample::FAIL;
using HcommRoceExample::SUCCESS;

constexpr const char* MEMORY_TAG = "hcommRoceShareBuf";

#define CHECK_EQ(expr, expected)                                                                              \
    do {                                                                                                      \
        const auto checkRet = static_cast<int64_t>(expr);                                                     \
        const auto checkExpected = static_cast<int64_t>(expected);                                            \
        if (checkRet != checkExpected) {                                                                      \
            std::fprintf(                                                                                     \
                stderr, "[ERROR] rank %u: %s failed, ret=%lld, expected=%lld, at %s:%d\n", rank, #expr,       \
                static_cast<long long>(checkRet), static_cast<long long>(checkExpected), __FILE__, __LINE__); \
            return FAIL;                                                                                      \
        }                                                                                                     \
    } while (0)

struct RankResources {
    explicit RankResources(uint32_t rankId) : rank(rankId) {}

    ~RankResources()
    {
        if (comm != nullptr) {
            (void)HcclCommDestroy(comm);
        }
        if (deviceContext != nullptr) {
            (void)aclrtFree(deviceContext);
        }
        if (deviceBuffer != nullptr) {
            (void)aclrtFree(deviceBuffer);
        }
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (deviceSet) {
            (void)aclrtResetDevice(static_cast<int32_t>(rank));
        }
        if (aclInitialized) {
            (void)aclFinalize();
        }
    }

    RankResources(const RankResources&) = delete;
    RankResources& operator=(const RankResources&) = delete;

    uint32_t rank;
    uint32_t rankNum;
    bool aclInitialized{false};
    bool deviceSet{false};
    aclrtStream stream{nullptr};
    HcclComm comm{nullptr};
    void* deviceBuffer{nullptr};
    uint8_t* deviceContext{nullptr};
    HcclMemHandle memHandle{nullptr};
    ChannelHandle channel{0};
    uint64_t remoteBuffer{0};
};

struct MpiSession {
    MpiSession(int* argc, char*** argv)
    {
        if (MPI_Init(argc, argv) != MPI_SUCCESS) {
            std::fprintf(stderr, "[ERROR] MPI_Init failed\n");
            valid = false;
        }
    }

    ~MpiSession()
    {
        if (valid) {
            (void)MPI_Finalize();
        }
    }

    MpiSession(const MpiSession&) = delete;
    MpiSession& operator=(const MpiSession&) = delete;

    bool valid{true};
};

uint8_t GetDataValue(uint32_t rank, uint32_t index)
{
    return index == 0U ? static_cast<uint8_t>(rank) : static_cast<uint8_t>(rank + index);
}

const char* GetKernelError(HcommRoceExample::TestResult result)
{
    switch (result) {
        case HcommRoceExample::TEST_HCOMM_INIT_FAILED:
            return "Hcomm Init failed";
        case HcommRoceExample::TEST_HCOMM_WRITE_FAILED:
            return "Hcomm WriteNbi failed";
        case HcommRoceExample::TEST_HCOMM_READ_FAILED:
            return "Hcomm ReadNbi failed";
        case HcommRoceExample::TEST_HCOMM_COMMIT_FAILED:
            return "Hcomm Commit failed";
        case HcommRoceExample::TEST_HCOMM_DRAIN_FAILED:
            return "Hcomm Drain failed";
        case HcommRoceExample::TEST_HCOMM_LOCK_FAILED:
            return "Hcomm Lock failed";
        case HcommRoceExample::TEST_HCOMM_UNLOCK_FAILED:
            return "Hcomm Unlock failed";
        default:
            return "unknown kernel error";
    }
}

int32_t InitAcl(RankResources& resources)
{
    const uint32_t rank = resources.rank;
    CHECK_EQ(aclInit(nullptr), ACL_SUCCESS);
    resources.aclInitialized = true;

    uint32_t deviceCount = 0;
    CHECK_EQ(aclrtGetDeviceCount(&deviceCount), ACL_SUCCESS);
    if (deviceCount < resources.rankNum) {
        std::fprintf(
            stderr, "[ERROR] rank %u: %u devices are required, found %u\n", resources.rank, resources.rankNum,
            deviceCount);
        return FAIL;
    }

    CHECK_EQ(aclrtSetDevice(static_cast<int32_t>(resources.rank)), ACL_SUCCESS);
    resources.deviceSet = true;
    CHECK_EQ(aclrtCreateStream(&resources.stream), ACL_SUCCESS);
    return SUCCESS;
}

int32_t InitHccl(RankResources& resources)
{
    const uint32_t rank = resources.rank;
    HcclRootInfo rootInfo = {};
    if (resources.rank == 0U) {
        CHECK_EQ(HcclGetRootInfo(&rootInfo), HCCL_SUCCESS);
    }
    if (MPI_Bcast(&rootInfo, sizeof(rootInfo), MPI_BYTE, 0, MPI_COMM_WORLD) != MPI_SUCCESS) {
        std::fprintf(stderr, "[ERROR] rank %u: MPI_Bcast root info failed\n", resources.rank);
        return FAIL;
    }

    HcclCommConfig config = {};
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = resources.rank;
    CHECK_EQ(
        HcclCommInitRootInfoConfig(resources.rankNum, &rootInfo, resources.rank, &config, &resources.comm),
        HCCL_SUCCESS);
    if (resources.comm == nullptr) {
        std::fprintf(stderr, "[ERROR] rank %u: HcclCommInitRootInfoConfig returned null comm\n", resources.rank);
        return FAIL;
    }
    return SUCCESS;
}

int32_t PrepareMemory(RankResources& resources)
{
    const uint32_t rank = resources.rank;
    CHECK_EQ(
        aclrtMalloc(&resources.deviceBuffer, HcommRoceExample::COMM_BUF_SIZE, ACL_MEM_MALLOC_HUGE_ONLY), ACL_SUCCESS);
    CHECK_EQ(
        aclrtMalloc(
            reinterpret_cast<void**>(&resources.deviceContext), sizeof(HcommRoceExample::CommContext),
            ACL_MEM_MALLOC_HUGE_ONLY),
        ACL_SUCCESS);

    std::vector<uint8_t> hostBuffer(static_cast<size_t>(HcommRoceExample::COMM_BUF_SIZE), 0U);
    for (uint32_t i = 0; i < HcommRoceExample::DATA_SIZE; ++i) {
        hostBuffer[HcommRoceExample::SEND_DATA_OFFSET + i] = GetDataValue(resources.rank, i);
    }
    CHECK_EQ(
        aclrtMemcpy(
            resources.deviceBuffer, HcommRoceExample::COMM_BUF_SIZE, hostBuffer.data(), HcommRoceExample::COMM_BUF_SIZE,
            ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS);

    CommMem registeredMemory = {};
    registeredMemory.type = COMM_MEM_TYPE_DEVICE;
    registeredMemory.addr = resources.deviceBuffer;
    registeredMemory.size = HcommRoceExample::COMM_BUF_SIZE;
    CHECK_EQ(HcclCommMemReg(resources.comm, MEMORY_TAG, &registeredMemory, &resources.memHandle), HCCL_SUCCESS);
    return SUCCESS;
}

int32_t AcquireRoceChannel(RankResources& resources, uint32_t peerRank)
{
    const uint32_t rank = resources.rank;
    uint32_t* networkLayers = nullptr;
    uint32_t networkLayerCount = 0;
    CHECK_EQ(HcclRankGraphGetLayers(resources.comm, &networkLayers, &networkLayerCount), HCCL_SUCCESS);
    if (networkLayers == nullptr || networkLayerCount == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: no rank graph layer found\n", resources.rank);
        return FAIL;
    }

    CommLink* links = nullptr;
    uint32_t linkCount = 0;
    CHECK_EQ(
        HcclRankGraphGetLinks(resources.comm, networkLayers[1], resources.rank, peerRank, &links, &linkCount),
        HCCL_SUCCESS);
    if (links == nullptr || linkCount == 0U) {
        std::fprintf(
            stderr, "[ERROR] rank %u: no link found from rank %u to rank %u\n", resources.rank, resources.rank,
            peerRank);
        return FAIL;
    }

    HcclChannelDesc channelDesc = {};
    CHECK_EQ(HcclChannelDescInit(&channelDesc, 1U), HCCL_SUCCESS);
    channelDesc.remoteRank = peerRank;
    channelDesc.channelProtocol = HcommRoceExample::HOST_COMM_PROTOCOL;
    channelDesc.memHandles = &resources.memHandle;
    channelDesc.memHandleNum = 1U;

    bool linkFound = false;
    for (uint32_t i = 0; i < linkCount; ++i) {
        if (links[i].linkAttr.linkProtocol == HcommRoceExample::HOST_COMM_PROTOCOL) {
            channelDesc.localEndpoint = links[i].srcEndpointDesc;
            channelDesc.remoteEndpoint = links[i].dstEndpointDesc;
            linkFound = true;
            break;
        }
    }
    if (!linkFound) {
        std::fprintf(stderr, "[ERROR] rank %u: no COMM_PROTOCOL_ROCE link to rank %u\n", resources.rank, peerRank);
        return FAIL;
    }

    CHECK_EQ(
        HcclChannelAcquire(resources.comm, CommEngine::COMM_ENGINE_AIV, &channelDesc, 1U, &resources.channel),
        HCCL_SUCCESS);
    if (resources.channel == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: HcclChannelAcquire returned an invalid channel\n", resources.rank);
        return FAIL;
    }

    uint32_t remoteMemoryCount = 0;
    CommMem* remoteMemories = nullptr;
    char** memoryTags = nullptr;
    CHECK_EQ(
        HcclChannelGetRemoteMems(resources.comm, resources.channel, &remoteMemoryCount, &remoteMemories, &memoryTags),
        HCCL_SUCCESS);
    if (remoteMemories == nullptr || remoteMemoryCount == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: no remote memory found\n", resources.rank);
        return FAIL;
    }

    for (uint32_t i = 0; i < remoteMemoryCount; ++i) {
        if (memoryTags != nullptr && memoryTags[i] != nullptr && std::strcmp(memoryTags[i], MEMORY_TAG) == 0) {
            resources.remoteBuffer = reinterpret_cast<uint64_t>(remoteMemories[i].addr);
            break;
        }
    }
    if (resources.remoteBuffer == 0U && remoteMemoryCount == 1U) {
        resources.remoteBuffer = reinterpret_cast<uint64_t>(remoteMemories[0].addr);
    }
    if (resources.remoteBuffer == 0U) {
        std::fprintf(
            stderr, "[ERROR] rank %u: remote communication buffer not found by tag %s\n", resources.rank, MEMORY_TAG);
        return FAIL;
    }
    return SUCCESS;
}

int32_t RunKernel(RankResources& resources)
{
    const uint32_t rank = resources.rank;
    HcommRoceExample::CommContext context = {};
    context.channelHandle = resources.channel;
    context.localBufferAddr = reinterpret_cast<uint64_t>(resources.deviceBuffer);
    context.remoteBufferAddr = resources.remoteBuffer;
    context.testResult = HcommRoceExample::TEST_SUCCESS;
    CHECK_EQ(
        aclrtMemcpy(resources.deviceContext, sizeof(context), &context, sizeof(context), ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS);

    LaunchHcommRoceWriteRead(
        resources.channel, reinterpret_cast<uint64_t>(resources.deviceBuffer), resources.remoteBuffer,
        resources.deviceContext, resources.stream);
    CHECK_EQ(aclrtSynchronizeStream(resources.stream), ACL_SUCCESS);

    HcommRoceExample::CommContext kernelResult = {};
    CHECK_EQ(
        aclrtMemcpy(
            &kernelResult, sizeof(kernelResult), resources.deviceContext, sizeof(kernelResult),
            ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS);
    if (kernelResult.testResult != HcommRoceExample::TEST_SUCCESS) {
        std::fprintf(stderr, "[ERROR] rank %u: %s\n", resources.rank, GetKernelError(kernelResult.testResult));
        return FAIL;
    }
    return SUCCESS;
}

int32_t ValidateRegion(RankResources& resources, uint64_t offset, uint32_t expectedRank, const char* name)
{
    const uint32_t rank = resources.rank;
    std::vector<uint8_t> hostBuffer(static_cast<size_t>(HcommRoceExample::COMM_BUF_SIZE), 0U);
    CHECK_EQ(
        aclrtMemcpy(
            hostBuffer.data(), HcommRoceExample::COMM_BUF_SIZE, resources.deviceBuffer, HcommRoceExample::COMM_BUF_SIZE,
            ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS);

    for (uint32_t i = 0; i < HcommRoceExample::DATA_SIZE; ++i) {
        const uint8_t actual = hostBuffer[offset + i];
        const uint8_t expected = GetDataValue(expectedRank, i);
        if (actual != expected) {
            std::fprintf(
                stderr, "[ERROR] rank %u: %s mismatch at %u, actual=0x%02x, expected=0x%02x\n", resources.rank, name, i,
                actual, expected);
            return FAIL;
        }
    }
    return SUCCESS;
}

int32_t RunRank(uint32_t rank, uint32_t rankNum)
{
    RankResources resources(rank);
    resources.rankNum = rankNum;
    const uint32_t nextRank = (rank + 1U) % rankNum;
    const uint32_t prevRank = (rank + rankNum - 1U) % rankNum;

    CHECK_EQ(InitAcl(resources), SUCCESS);
    CHECK_EQ(InitHccl(resources), SUCCESS);
    CHECK_EQ(PrepareMemory(resources), SUCCESS);
    CHECK_EQ(AcquireRoceChannel(resources, nextRank), SUCCESS);
    if (MPI_Barrier(MPI_COMM_WORLD) != MPI_SUCCESS) {
        std::fprintf(stderr, "[ERROR] rank %u: MPI_Barrier before kernel failed\n", rank);
        return FAIL;
    }
    CHECK_EQ(RunKernel(resources), SUCCESS);
    if (MPI_Barrier(MPI_COMM_WORLD) != MPI_SUCCESS) {
        std::fprintf(stderr, "[ERROR] rank %u: MPI_Barrier after kernel failed\n", rank);
        return FAIL;
    }
    CHECK_EQ(ValidateRegion(resources, HcommRoceExample::WRITE_RESULT_OFFSET, prevRank, "WriteNbi result"), SUCCESS);
    CHECK_EQ(ValidateRegion(resources, HcommRoceExample::READ_RESULT_OFFSET, nextRank, "ReadNbi result"), SUCCESS);

    std::printf(
        "[rank %u] hcomm_roce_write_read_nbi | sent to rank %u, received from rank %u | PASS\n", rank, nextRank,
        prevRank);
    return SUCCESS;
}

} // namespace

int main(int argc, char* argv[])
{
    MpiSession mpiSession(&argc, &argv);
    if (!mpiSession.valid) {
        return FAIL;
    }

    int mpiRank = 0;
    int mpiRankNum = 0;
    if (MPI_Comm_rank(MPI_COMM_WORLD, &mpiRank) != MPI_SUCCESS ||
        MPI_Comm_size(MPI_COMM_WORLD, &mpiRankNum) != MPI_SUCCESS) {
        std::fprintf(stderr, "[ERROR] MPI_Comm_rank/MPI_Comm_size failed\n");
        return FAIL;
    }
    if (mpiRankNum < 2) {
        if (mpiRank == 0) {
            std::fprintf(stderr, "Usage: mpirun -n <nranks>=2 ... %s\n", argv[0]);
        }
        return FAIL;
    }

    const int localResult = RunRank(static_cast<uint32_t>(mpiRank), static_cast<uint32_t>(mpiRankNum));
    int globalResult = FAIL;
    if (MPI_Allreduce(&localResult, &globalResult, 1, MPI_INT, MPI_MIN, MPI_COMM_WORLD) != MPI_SUCCESS) {
        std::fprintf(stderr, "[ERROR] rank %d: MPI_Allreduce failed\n", mpiRank);
        return FAIL;
    }

    if (mpiRank == 0) {
        std::printf(
            "RESULT | Example=hcomm_roce_write_read_nbi | Status=%s\n", globalResult == SUCCESS ? "PASS" : "FAIL");
    }
    return globalResult == SUCCESS ? SUCCESS : 1;
}
