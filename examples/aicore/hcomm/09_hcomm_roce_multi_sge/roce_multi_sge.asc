/*!
 * \file roce_multi_sge.asc
 * \brief Host side of the Hcomm RoCE multi-SGE batch read/write example.
 */

#include <mpi.h>

#include <cstdint>
#include <cstdio>
#include <cstring>
#include <vector>

#include "acl/acl.h"
#include "hccl/hccl.h"
#include "hccl/hccl_comm.h"
#include "hccl/hccl_rank_graph.h"
#include "hccl/hccl_res.h"
#include "hccl/hccl_types.h"

#include "roce_multi_sge_def.h"

extern void LaunchHcommRoceMultiSge(void* stream, uint64_t context);

namespace {

using namespace HcommRoceMultiSge;

using HcommRoceMultiSge::FAIL;
using HcommRoceMultiSge::SUCCESS;

#define CHECK_EQ(expr, expected)                                                                              \
    do {                                                                                                      \
        const auto checkRet = static_cast<int64_t>(expr);                                                     \
        const auto checkExpected = static_cast<int64_t>(expected);                                            \
        if (checkRet != checkExpected) {                                                                      \
            std::fprintf(                                                                                     \
                stderr, "[ERROR] rank %u: %s failed, ret=%lld, expected=%lld, at %s:%d\n", rank, #expr,       \
                static_cast<long long>(checkRet), static_cast<long long>(checkExpected), __FILE__, __LINE__); \
            return FAIL;                                                                                      \
        }                                                                                                     \
    } while (0)

struct RankResources {
    RankResources(uint32_t rankId, uint32_t rankCount) : rank(rankId), rankNum(rankCount) {}

    ~RankResources()
    {
        if (deviceContext != nullptr) {
            (void)aclrtFree(deviceContext);
        }
        if (deviceBuffer != nullptr) {
            (void)aclrtFree(deviceBuffer);
        }
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (comm != nullptr) {
            (void)HcclCommDestroy(comm);
        }
        if (deviceSet) {
            (void)aclrtResetDevice(static_cast<int32_t>(rank));
        }
        if (aclInitialized) {
            (void)aclFinalize();
        }
    }

    RankResources(const RankResources&) = delete;
    RankResources& operator=(const RankResources&) = delete;

    uint32_t rank;
    uint32_t rankNum;
    bool aclInitialized{false};
    bool deviceSet{false};
    aclrtStream stream{nullptr};
    HcclComm comm{nullptr};
    void* deviceBuffer{nullptr};
    KernelContext* deviceContext{nullptr};
    HcclMemHandle memHandle{nullptr};
    ChannelHandle channel{0U};
    uint64_t remoteBuffer{0U};
};

struct MpiSession {
    MpiSession(int* argc, char*** argv)
    {
        if (MPI_Init(argc, argv) != MPI_SUCCESS) {
            std::fprintf(stderr, "[ERROR] MPI_Init failed\n");
            valid = false;
        }
    }

    ~MpiSession()
    {
        if (valid) {
            (void)MPI_Finalize();
        }
    }

    MpiSession(const MpiSession&) = delete;
    MpiSession& operator=(const MpiSession&) = delete;

    bool valid{true};
};

uint8_t ExpectedByte(uint32_t call, uint32_t segment, uint32_t byte)
{
    const uint64_t index = static_cast<uint64_t>(call) * SGE_COUNT * SEGMENT_SIZE + segment * SEGMENT_SIZE + byte;
    return static_cast<uint8_t>(index);
}

int32_t InitAcl(RankResources& resources)
{
    const uint32_t rank = resources.rank;
    CHECK_EQ(aclInit(nullptr), ACL_SUCCESS);
    resources.aclInitialized = true;

    uint32_t deviceCount = 0U;
    CHECK_EQ(aclrtGetDeviceCount(&deviceCount), ACL_SUCCESS);
    if (deviceCount < resources.rankNum) {
        std::fprintf(
            stderr, "[ERROR] rank %u: %u devices are required, found %u\n", resources.rank, resources.rankNum,
            deviceCount);
        return FAIL;
    }
    CHECK_EQ(aclrtSetDevice(static_cast<int32_t>(resources.rank)), ACL_SUCCESS);
    resources.deviceSet = true;
    CHECK_EQ(aclrtCreateStream(&resources.stream), ACL_SUCCESS);
    return SUCCESS;
}

int32_t InitCommunicator(RankResources& resources)
{
    const uint32_t rank = resources.rank;
    HcclRootInfo rootInfo = {};
    if (resources.rank == 0U) {
        CHECK_EQ(HcclGetRootInfo(&rootInfo), HCCL_SUCCESS);
    }
    if (MPI_Bcast(&rootInfo, sizeof(rootInfo), MPI_BYTE, 0, MPI_COMM_WORLD) != MPI_SUCCESS) {
        std::fprintf(stderr, "[ERROR] rank %u: MPI_Bcast root info failed\n", resources.rank);
        return FAIL;
    }

    HcclCommConfig config = {};
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = rank;
    CHECK_EQ(HcclCommInitRootInfoConfig(resources.rankNum, &rootInfo, rank, &config, &resources.comm), HCCL_SUCCESS);
    if (resources.comm == nullptr) {
        std::fprintf(stderr, "[ERROR] rank %u: HcclCommInitRootInfoConfig returned null comm\n", resources.rank);
        return FAIL;
    }
    return SUCCESS;
}

int32_t PrepareMemory(RankResources& resources)
{
    const uint32_t rank = resources.rank;
    CHECK_EQ(aclrtMalloc(&resources.deviceBuffer, COMM_BUFFER_SIZE, ACL_MEM_MALLOC_HUGE_FIRST), ACL_SUCCESS);

    std::vector<uint8_t> hostBuffer(static_cast<size_t>(COMM_BUFFER_SIZE), 0U);
    if (resources.rank == 0U) {
        for (uint32_t call = 0U; call < CALL_COUNT; ++call) {
            for (uint32_t segment = 0U; segment < SGE_COUNT; ++segment) {
                const uint64_t scatterOffset =
                    SOURCE_SCATTERED_OFFSET + call * SGE_COUNT * SEGMENT_STRIDE + segment * SEGMENT_STRIDE;
                for (uint32_t byte = 0U; byte < SEGMENT_SIZE; ++byte) {
                    hostBuffer[scatterOffset + byte] = ExpectedByte(call, segment, byte);
                }
            }
        }
        for (uint32_t call = 0U; call < CALL_COUNT; ++call) {
            for (uint32_t segment = 0U; segment < SGE_COUNT; ++segment) {
                const uint64_t offset = SOURCE_CONTIGUOUS_OFFSET + call * MESSAGE_SIZE + segment * SEGMENT_SIZE;
                for (uint32_t byte = 0U; byte < SEGMENT_SIZE; ++byte) {
                    hostBuffer[offset + byte] = ExpectedByte(call, segment, byte);
                }
            }
        }
    }
    CHECK_EQ(
        aclrtMemcpy(
            resources.deviceBuffer, COMM_BUFFER_SIZE, hostBuffer.data(), COMM_BUFFER_SIZE, ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS);

    CommMem memory{};
    memory.type = COMM_MEM_TYPE_DEVICE;
    memory.addr = resources.deviceBuffer;
    memory.size = COMM_BUFFER_SIZE;
    CHECK_EQ(HcclCommMemReg(resources.comm, MEMORY_TAG, &memory, &resources.memHandle), HCCL_SUCCESS);
    return SUCCESS;
}

int32_t AcquireChannel(RankResources& resources, uint32_t peerRank)
{
    const uint32_t rank = resources.rank;
    uint32_t* layers = nullptr;
    uint32_t layerCount = 0U;
    CHECK_EQ(HcclRankGraphGetLayers(resources.comm, &layers, &layerCount), HCCL_SUCCESS);
    if (layers == nullptr || layerCount == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: no rank graph layer found\n", resources.rank);
        return FAIL;
    }

    CommLink* links = nullptr;
    uint32_t linkCount = 0U;
    CHECK_EQ(
        HcclRankGraphGetLinks(
            resources.comm, layers[1], static_cast<uint32_t>(resources.rank), peerRank, &links, &linkCount),
        HCCL_SUCCESS);
    if (links == nullptr || linkCount == 0U) {
        std::fprintf(
            stderr, "[ERROR] rank %u: no link found from rank %u to rank %u\n", resources.rank, resources.rank,
            peerRank);
        return FAIL;
    }

    HcclChannelDesc channelDesc{};
    CHECK_EQ(HcclChannelDescInit(&channelDesc, 1U), HCCL_SUCCESS);
    channelDesc.remoteRank = peerRank;
    channelDesc.channelProtocol = COMM_PROTOCOL_ROCE;
    channelDesc.memHandles = &resources.memHandle;
    channelDesc.memHandleNum = 1U;

    bool linkFound = false;
    for (uint32_t index = 0U; index < linkCount; ++index) {
        if (links[index].linkAttr.linkProtocol != COMM_PROTOCOL_ROCE) {
            continue;
        }
        channelDesc.localEndpoint = links[index].srcEndpointDesc;
        channelDesc.remoteEndpoint = links[index].dstEndpointDesc;
        linkFound = true;
        break;
    }
    if (!linkFound) {
        std::fprintf(stderr, "[ERROR] rank %u: no COMM_PROTOCOL_ROCE link to rank %u\n", resources.rank, peerRank);
        return FAIL;
    }

    CHECK_EQ(HcclChannelAcquire(resources.comm, COMM_ENGINE_AIV, &channelDesc, 1U, &resources.channel), HCCL_SUCCESS);
    if (resources.channel == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: HcclChannelAcquire returned a null channel\n", resources.rank);
        return FAIL;
    }

    uint32_t memoryCount = 0U;
    CommMem* memories = nullptr;
    char** tags = nullptr;
    CHECK_EQ(HcclChannelGetRemoteMems(resources.comm, resources.channel, &memoryCount, &memories, &tags), HCCL_SUCCESS);
    if (memories == nullptr || memoryCount == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: no remote memory found\n", resources.rank);
        return FAIL;
    }
    for (uint32_t index = 0U; index < memoryCount; ++index) {
        if (tags != nullptr && tags[index] != nullptr && std::strcmp(tags[index], MEMORY_TAG) == 0) {
            resources.remoteBuffer = reinterpret_cast<uint64_t>(memories[index].addr);
            break;
        }
    }
    if (resources.remoteBuffer == 0U && memoryCount == 1U) {
        resources.remoteBuffer = reinterpret_cast<uint64_t>(memories[0].addr);
    }
    if (resources.remoteBuffer == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: remote communication buffer not found\n", resources.rank);
        return FAIL;
    }
    return SUCCESS;
}

const char* KernelError(KernelResult result)
{
    switch (result) {
        case KERNEL_MAKE_BATCH_HANDLE_FAILED:
            return "MakeBatchHandle failed";
        case KERNEL_WRITE_FAILED:
            return "WriteNbi failed";
        case KERNEL_READ_FAILED:
            return "ReadNbi failed";
        case KERNEL_COMMIT_FAILED:
            return "BatchCommit failed";
        case KERNEL_DRAIN_FAILED:
            return "Drain failed";
        default:
            return "unknown kernel error";
    }
}

int32_t RunKernel(RankResources& resources, KernelOperation operation)
{
    const uint32_t rank = resources.rank;
    if (resources.deviceContext == nullptr) {
        CHECK_EQ(
            aclrtMalloc(
                reinterpret_cast<void**>(&resources.deviceContext), sizeof(KernelContext), ACL_MEM_MALLOC_HUGE_FIRST),
            ACL_SUCCESS);
    }

    KernelContext context{};
    context.channel = static_cast<uint64_t>(resources.channel);
    context.localBuffer = reinterpret_cast<uint64_t>(resources.deviceBuffer);
    context.remoteBuffer = resources.remoteBuffer;
    context.operation = operation;
    context.result = KERNEL_SUCCESS;
    context.hcommResult = 0;
    CHECK_EQ(
        aclrtMemcpy(resources.deviceContext, sizeof(context), &context, sizeof(context), ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS);

    LaunchHcommRoceMultiSge(
        reinterpret_cast<void*>(resources.stream),
        static_cast<uint64_t>(reinterpret_cast<uintptr_t>(resources.deviceContext)));
    CHECK_EQ(aclrtSynchronizeStream(resources.stream), ACL_SUCCESS);

    KernelContext kernelResult{};
    CHECK_EQ(
        aclrtMemcpy(
            &kernelResult, sizeof(kernelResult), resources.deviceContext, sizeof(kernelResult),
            ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS);
    if (kernelResult.result != KERNEL_SUCCESS) {
        std::fprintf(
            stderr, "[ERROR] rank %u: %s, hcomm ret=%d\n", resources.rank, KernelError(kernelResult.result),
            kernelResult.hcommResult);
        return FAIL;
    }
    return SUCCESS;
}

int32_t ValidateWrite(RankResources& resources)
{
    const uint32_t rank = resources.rank;
    std::vector<uint8_t> hostBuffer(static_cast<size_t>(COMM_BUFFER_SIZE), 0U);
    CHECK_EQ(
        aclrtMemcpy(
            hostBuffer.data(), COMM_BUFFER_SIZE, resources.deviceBuffer, COMM_BUFFER_SIZE, ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS);

    for (uint32_t call = 0U; call < CALL_COUNT; ++call) {
        for (uint32_t segment = 0U; segment < SGE_COUNT; ++segment) {
            const uint64_t offset = WRITE_DST_OFFSET + call * MESSAGE_SIZE + segment * SEGMENT_SIZE;
            for (uint32_t byte = 0U; byte < SEGMENT_SIZE; ++byte) {
                if (hostBuffer[offset + byte] != ExpectedByte(call, segment, byte)) {
                    std::fprintf(
                        stderr,
                        "[ERROR] rank %u: WriteNbi result mismatch at call=%u segment=%u byte=%u, actual=0x%02x "
                        "expected=0x%02x\n",
                        resources.rank, call, segment, byte, hostBuffer[offset + byte],
                        ExpectedByte(call, segment, byte));
                    return FAIL;
                }
            }
        }
    }
    return SUCCESS;
}

int32_t ValidateRead(RankResources& resources)
{
    const uint32_t rank = resources.rank;
    std::vector<uint8_t> hostBuffer(static_cast<size_t>(COMM_BUFFER_SIZE), 0U);
    CHECK_EQ(
        aclrtMemcpy(
            hostBuffer.data(), COMM_BUFFER_SIZE, resources.deviceBuffer, COMM_BUFFER_SIZE, ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS);

    for (uint32_t call = 0U; call < CALL_COUNT; ++call) {
        for (uint32_t segment = 0U; segment < SGE_COUNT; ++segment) {
            const uint64_t offset = READ_DST_OFFSET + call * SGE_COUNT * SEGMENT_STRIDE + segment * SEGMENT_STRIDE;
            for (uint32_t byte = 0U; byte < SEGMENT_SIZE; ++byte) {
                if (hostBuffer[offset + byte] != ExpectedByte(call, segment, byte)) {
                    std::fprintf(
                        stderr,
                        "[ERROR] rank %u: ReadNbi result mismatch at call=%u segment=%u byte=%u, actual=0x%02x "
                        "expected=0x%02x\n",
                        resources.rank, call, segment, byte, hostBuffer[offset + byte],
                        ExpectedByte(call, segment, byte));
                    return FAIL;
                }
            }
        }
    }
    return SUCCESS;
}

int32_t RunRank(uint32_t rank, uint32_t rankNum)
{
    RankResources resources(rank, rankNum);
    const uint32_t peerRank = rank == 0U ? 1U : 0U;

    CHECK_EQ(InitAcl(resources), SUCCESS);
    CHECK_EQ(InitCommunicator(resources), SUCCESS);
    CHECK_EQ(PrepareMemory(resources), SUCCESS);

    if (rank < PARTICIPANT_RANK_NUM) {
        CHECK_EQ(AcquireChannel(resources, peerRank), SUCCESS);
    }

    CHECK_EQ(MPI_Barrier(MPI_COMM_WORLD), MPI_SUCCESS);
    if (rank == 0U) {
        CHECK_EQ(RunKernel(resources, KERNEL_WRITE), SUCCESS);
    }

    CHECK_EQ(MPI_Barrier(MPI_COMM_WORLD), MPI_SUCCESS);
    if (rank == 1U) {
        CHECK_EQ(ValidateWrite(resources), SUCCESS);
        std::printf(
            "[rank %u] hcomm_roce_multi_sge | WriteNbi=%u SGEs=%u | PASS\n", resources.rank, CALL_COUNT, SGE_COUNT);
        CHECK_EQ(RunKernel(resources, KERNEL_READ), SUCCESS);
    }

    CHECK_EQ(MPI_Barrier(MPI_COMM_WORLD), MPI_SUCCESS);
    if (rank == 1U) {
        CHECK_EQ(ValidateRead(resources), SUCCESS);
        std::printf(
            "[rank %u] hcomm_roce_multi_sge | ReadNbi=%u SGEs=%u | PASS\n", resources.rank, CALL_COUNT, SGE_COUNT);
    }
    return SUCCESS;
}

} // namespace

int main(int argc, char** argv)
{
    MpiSession mpiSession(&argc, &argv);
    if (!mpiSession.valid) {
        return FAIL;
    }

    int mpiRank = 0;
    int mpiRankNum = 0;
    if (MPI_Comm_rank(MPI_COMM_WORLD, &mpiRank) != MPI_SUCCESS ||
        MPI_Comm_size(MPI_COMM_WORLD, &mpiRankNum) != MPI_SUCCESS) {
        std::fprintf(stderr, "[ERROR] MPI_Comm_rank/MPI_Comm_size failed\n");
        return FAIL;
    }

    if (mpiRankNum < 2) {
        if (mpiRank == 0) {
            std::fprintf(stderr, "Usage: mpirun -np <2..N> %s\n", argv[0]);
        }
        return FAIL;
    }

    const int localResult = RunRank(static_cast<uint32_t>(mpiRank), static_cast<uint32_t>(mpiRankNum));
    int globalResult = FAIL;
    if (MPI_Allreduce(&localResult, &globalResult, 1, MPI_INT, MPI_MIN, MPI_COMM_WORLD) != MPI_SUCCESS) {
        std::fprintf(stderr, "[ERROR] rank %d: MPI_Allreduce failed\n", mpiRank);
        return FAIL;
    }

    if (mpiRank == 0) {
        std::printf("RESULT | Example=hcomm_roce_multi_sge | Status=%s\n", globalResult == SUCCESS ? "PASS" : "FAIL");
    }
    return globalResult == SUCCESS ? SUCCESS : 1;
}
