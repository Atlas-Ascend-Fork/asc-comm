extern void LaunchUrmaBatchApiPerf(void* stream, uint64_t context);

namespace {
using namespace UrmaBatchApiPerfExample;

constexpr const char* MEMORY_TAG = "urmaBatchApiPerfBuf";

// host 侧同步点的 tag（kTagPerfResult 由公共 utils/perf_result.h 预留）
constexpr uint32_t kTagReady = examples::kTagUserBase;
constexpr uint32_t kTagLaunched = kTagReady + 1U;
constexpr uint32_t kTagDrained = kTagLaunched + 1U;
constexpr uint32_t kTagCaseEnd = kTagDrained + 1U;

struct RunOptions {
    uint64_t minExp = DEFAULT_MIN_EXP;
    uint64_t maxExp = DEFAULT_MAX_EXP;
    uint32_t rounds = DEFAULT_ROUNDS;
    uint32_t minBatch = DEFAULT_MIN_BATCH;
    uint32_t maxBatch = DEFAULT_MAX_BATCH;
    uint32_t apiMask = API_ALL;
    uint32_t commitInWindow = 1; // 默认 true：每攒满一批即 BatchCommit（计入时延）
    uint32_t metricMask = METRIC_ALL;
    examples::PerfType perfType = examples::PerfType::P2P; // 拓扑：p2p（默认）/ ring
};

// ---------------- host 侧数据结构 ----------------

// 结果行 PerfRow 在公共 utils/perf_result.h；本样例有批维度，samples = 批轮次 rounds
using examples::PerfRow;

// rank 侧环境资源（RAII，析构按申请逆序释放）。
struct RankResources {
    ~RankResources()
    {
        if (comm != nullptr) {
            (void)HcclCommDestroy(comm);
        }
        if (deviceContext != nullptr) {
            (void)aclrtFree(deviceContext);
        }
        if (shareBuf != nullptr) {
            (void)aclrtFree(shareBuf);
        }
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (isDevSet) {
            (void)aclrtResetDevice(static_cast<int32_t>(rank));
        }
        if (aclInitialized) {
            (void)aclFinalize();
        }
    }

    RankResources(const RankResources&) = delete;
    RankResources& operator=(const RankResources&) = delete;
    RankResources() = default;

    uint32_t rank{0};
    bool aclInitialized{false};
    bool isDevSet{false};
    aclrtStream stream{nullptr};
    HcclComm comm{nullptr};
    void* shareBuf{nullptr};
    std::vector<int32_t> stage{}; // 批窗口 host 暂存区：铺初值下发 / 校验拷回共用
    KernelContext* deviceContext{nullptr};
    HcclMemHandle memHandle{nullptr};
    ChannelHandle channel{0};     // send 通道（write/notify）
    ChannelHandle recvChannel{0}; // recv 通道（read）
    uint64_t remoteBuf{0};        // send 对端基址（write/notify 落点、notify flag）
    uint64_t recvRemoteBuf{0};    // recv 对端基址（read 源）
};

// 单档校验的只读上下文（逐档不变）
struct CaseEnv {
    uint8_t* devBase{nullptr}; // 1GB 注册内存基址
    int32_t myPattern{0};      // 本卡 pattern（source 区应保持它）
    int32_t peerPattern{0};    // 上游卡的 pattern（各落点区应等于它）
};

// exp 上限 30：1GB 注册内存按 (len, batchCap) 划分，2^30 起单档放不下。

// 批大小范围 → 档位表（min 起每档 ×2 至 max，含两端）。批容量的真实上限在
// kernel 侧校验，host 只防翻倍溢出（封顶 1<<30）。
std::vector<uint32_t> BuildBatchLadder(uint32_t minBatch, uint32_t maxBatch)
{
    constexpr uint32_t kBatchOverflowGuard = 1U << 30;
    std::vector<uint32_t> batches;
    if (minBatch == 0U || maxBatch < minBatch || maxBatch > kBatchOverflowGuard) {
        return batches;
    }
    for (uint32_t b = minBatch; b <= maxBatch; b <<= 1) {
        batches.push_back(b);
        if (b > (kBatchOverflowGuard >> 1)) {
            break; // 防溢出：翻倍后超守卫值就停在最后一档
        }
    }
    if (batches.back() < maxBatch && batches.back() != maxBatch) {
        // max 不在 ×2 序列上（如 30）：补上该档
        batches.push_back(maxBatch);
    }
    return batches;
}

// 掩码 → 名字串（"write,read" 等，与命令行取值一一对应；全选显示 "all"）
std::string ApiMaskName(uint32_t apiMask)
{
    if (apiMask == API_ALL) {
        return "all";
    }
    std::string name;
    if ((apiMask & API_WRITE) != 0U) {
        name += "write";
    }
    if ((apiMask & API_READ) != 0U) {
        name += name.empty() ? "read" : ",read";
    }
    if ((apiMask & API_NOTIFY) != 0U) {
        name += name.empty() ? "notify" : ",notify";
    }
    return name;
}

const char* CommitName(uint32_t commitInWindow) { return commitInWindow != 0U ? "true" : "false"; }

std::string MetricMaskName(uint32_t metricMask)
{
    if (metricMask == METRIC_ALL) {
        return "all";
    }
    std::string name;
    if ((metricMask & METRIC_LAT) != 0U) {
        name += "lat";
    }
    if ((metricMask & METRIC_BW) != 0U) {
        name += name.empty() ? "bw" : ",bw";
    }
    return name;
}

// 每档 launch 前重铺初值：source 区（一个批窗口）重填 pattern，其后落点区一次清 0。
aclError RefillInitial(
    uint8_t* devBase, int32_t* stage, const CaseLayout& layout, uint64_t windowBytes, uint32_t myRank)
{
    const int32_t pattern = SRC_PATTERN_BASE + static_cast<int32_t>(myRank);
    const uint64_t words = windowBytes / sizeof(int32_t);
    for (uint64_t i = 0; i < words; ++i) {
        stage[i] = pattern;
    }
    EXAMPLES_ACLCHECK(aclrtMemcpy(devBase, windowBytes, stage, windowBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    const uint64_t clearBytes = layout.totalBytes - windowBytes;
    EXAMPLES_ACLCHECK(aclrtMemset(devBase + windowBytes, clearBytes, 0, clearBytes));
    return ACL_SUCCESS;
}

// 拷回落点区比对：全部元素应等于 expected（int32 粒度）
aclError CheckRegion(
    const uint8_t* devBase, int32_t* stage, uint64_t base, uint64_t bytes, int32_t expected, const char* name,
    uint32_t rank, bool& ok)
{
    EXAMPLES_ACLCHECK(aclrtMemcpy(stage, bytes, devBase + base, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    const int32_t* buf = stage;
    const uint64_t words = bytes / sizeof(int32_t);
    for (uint64_t i = 0; i < words; ++i) {
        if (buf[i] != expected) {
            std::fprintf(
                stderr,
                "[rank %u][FAIL] %s word[%llu]=0x%08x expect=0x%08x (values 0x64..0x6b are rank "
                "patterns 100+rank, i.e. data from that rank; 0x0 means never written)\n",
                rank, name, static_cast<unsigned long long>(i), buf[i], expected);
            ok = false;
            return ACL_SUCCESS;
        }
    }
    return ACL_SUCCESS;
}

// 校验 notify flag == 固定值（单槽被并发写、逐条值不可校验，原因见 def.h）。
aclError CheckFlag(const uint8_t* devBase, uint64_t flagsBase, uint64_t expected, uint32_t rank, bool& ok)
{
    uint64_t flag = 0;
    EXAMPLES_ACLCHECK(aclrtMemcpy(&flag, sizeof(flag), devBase + flagsBase, sizeof(flag), ACL_MEMCPY_DEVICE_TO_HOST));
    if (flag != expected) {
        std::fprintf(
            stderr, "[rank %u][FAIL] notify flag=%llu expect=%llu\n", rank, static_cast<unsigned long long>(flag),
            static_cast<unsigned long long>(expected));
        ok = false;
    }
    return ACL_SUCCESS;
}

// 幂数范围 → 档位表，逐档校验批窗口 ≤ 1GB 注册内存；失败返回空表由调用方退出
std::vector<uint64_t> BuildLadderChecked(uint32_t rank, const RunOptions& opt, const std::vector<uint32_t>& batches)
{
    const std::vector<uint64_t> lens = examples::BuildLenLadder(opt.minExp, opt.maxExp);
    if (lens.empty()) {
        std::cout << "[rank " << rank << "] invalid --exponent-range " << opt.minExp << " " << opt.maxExp
                  << " (expect 3 <= minExp <= maxExp <= 30, datasize = 2^exp)" << std::endl;
        return lens;
    }
    for (uint32_t batch : batches) {
        for (uint64_t len : lens) {
            const uint64_t totalBytes = CaseLayoutOf(len, batch).totalBytes;
            if (totalBytes > BUFFER_BYTES) {
                std::cout << "[rank " << rank << "] case=batch" << batch << "/" << len
                          << "B: batch window exceeds buffer (" << totalBytes << " > " << BUFFER_BYTES
                          << "B, reduce --batch-range or --exponent-range)" << std::endl;
                return {};
            }
        }
    }
    return lens;
}

// rank 侧一次性环境搭建：ACL / 通信域 / 1GB 注册内存 / AIV channel / kernel 上下文，
// 资源记进 res（RAII）。按拓扑角色建 send / recv 两条通道，对端相同时只建一条。
int32_t InitRankEnv(examples::RankSyncContext& sync, RankResources& res, const examples::RankTopology& topo)
{
    const uint32_t rank = res.rank;
    EXAMPLES_ACLCHECK(aclInit(nullptr));
    res.aclInitialized = true;
    EXAMPLES_ACLCHECK(aclrtSetDevice(rank));
    res.isDevSet = true;
    EXAMPLES_ACLCHECK(aclrtCreateStream(&res.stream));

    HcclCommConfig config;
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = rank;
    EXAMPLES_HCCLCHECK(examples::InitCommByRootInfoConfig(sync, &config, &res.comm));

    // ---- 申请并注册 1GB 共享内存（各档共用，每档重铺初值） ----
    EXAMPLES_ACLCHECK(aclrtMalloc(&res.shareBuf, BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_ONLY));

    CommMem regMem{COMM_MEM_TYPE_DEVICE, res.shareBuf, BUFFER_BYTES};
    res.memHandle = nullptr;
    EXAMPLES_HCCLCHECK(HcclCommMemReg(res.comm, MEMORY_TAG, &regMem, &res.memHandle));

    // ---- 建 AIV channel：按协议过滤本卡到 send/recv 对端的链路 ----
    uint32_t* layers = nullptr;
    uint32_t layerNum = 0U;
    EXAMPLES_HCCLCHECK(HcclRankGraphGetLayers(res.comm, &layers, &layerNum));
    if (layerNum == 0U || layers == nullptr) {
        std::cout << "[rank " << rank << "] HcclRankGraphGetLayers returned no layer"
                  << " (communicator was built on a topology without rank-graph layers; check that all ranks see the "
                     "same devices)"
                  << std::endl;
        return 1;
    }
    const uint32_t peers[2] = {topo.sendRank, topo.recvRank};
    HcclChannelDesc descs[2];
    uint32_t descCount = 0U;
    for (uint32_t side = 0U; side < 2U; ++side) {
        if (side == 1U && peers[1] == peers[0]) {
            break; // send/recv 同对端：一条通道两用
        }
        bool linkFound = false;
        for (uint32_t layer = 0U; layer < layerNum && !linkFound; ++layer) {
            CommLink* links = nullptr;
            uint32_t linkNum = 0U;
            EXAMPLES_HCCLCHECK(HcclRankGraphGetLinks(res.comm, layers[layer], rank, peers[side], &links, &linkNum));
            for (uint32_t i = 0U; i < linkNum; ++i) {
                if (links[i].linkAttr.linkProtocol == HOST_COMM_PROTOCOL) {
                    EXAMPLES_HCCLCHECK(HcclChannelDescInit(&descs[descCount], 1U));
                    descs[descCount].remoteRank = peers[side];
                    descs[descCount].channelProtocol = HOST_COMM_PROTOCOL;
                    descs[descCount].localEndpoint = links[i].srcEndpointDesc;
                    descs[descCount].remoteEndpoint = links[i].dstEndpointDesc;
                    linkFound = true;
                    break;
                }
            }
        }
        if (!linkFound) {
            std::cout << "[rank " << rank << "] no UB_CTP(" << static_cast<int32_t>(HOST_COMM_PROTOCOL)
                      << ")-protocol link to peer " << peers[side]
                      << " (peer not in the same HCCS/UB island, or device visibility mismatch; check npu-smi "
                         "topo and ASCEND_RT_VISIBLE_DEVICES)"
                      << std::endl;
            return 1;
        }
        ++descCount;
    }
    // 每条 desc 都挂同一块注册内存，对端按通道各自收到一份本卡内存表
    for (uint32_t d = 0U; d < descCount; ++d) {
        descs[d].notifyNum = 0;
        descs[d].memHandles = &res.memHandle;
        descs[d].memHandleNum = 1U;
    }
    ChannelHandle acquired[2] = {0, 0};
    EXAMPLES_HCCLCHECK(HcclChannelAcquire(res.comm, COMM_ENGINE_AIV, descs, descCount, acquired));
    res.channel = acquired[0];
    res.recvChannel = (descCount == 2U) ? acquired[1] : acquired[0];

    EXAMPLES_ACLCHECK(
        aclrtMalloc(reinterpret_cast<void**>(&res.deviceContext), sizeof(KernelContext), ACL_MEM_MALLOC_HUGE_FIRST));
    return 0;
}

// 从 channel 的远端注册内存表里按 tag 取对端 buffer 地址，找不到返回非 0
int32_t ResolveRemoteBuf(RankResources& res, ChannelHandle channel, uint32_t peerRank, uint64_t& remoteBuf)
{
    uint32_t memNum = 0U;
    CommMem* remoteMems = nullptr;
    char** tags = nullptr;
    remoteBuf = 0;
    EXAMPLES_HCCLCHECK(HcclChannelGetRemoteMems(res.comm, channel, &memNum, &remoteMems, &tags));
    for (uint32_t i = 0U; i < memNum; ++i) {
        if (tags[i] != nullptr && std::strcmp(tags[i], MEMORY_TAG) == 0) {
            remoteBuf = reinterpret_cast<uint64_t>(remoteMems[i].addr);
            break;
        }
    }
    if (remoteBuf == 0U && memNum == 1U) {
        remoteBuf = reinterpret_cast<uint64_t>(remoteMems[0].addr);
    }
    if (remoteBuf == 0U) {
        std::cout << "[rank " << res.rank << "] remote registered buffer of peer " << peerRank
                  << " not found (peer did not register memory with tag '" << MEMORY_TAG
                  << "', or the memory exchange over the channel was incomplete)" << std::endl;
        return 1;
    }
    return 0;
}

// 校验本档数据（kernel 失败时不会进来）：只查一个批窗口
// （writtenBytes = batch*len）。落点区数据全部来自上游卡（write/notify 由它
// 写入、read 从它拉回），pattern 都是 env.peerPattern。
aclError ValidateCase(
    const RunOptions& opt, const CaseEnv& env, int32_t* stage, const CaseLayout& layout, uint64_t windowBytes,
    uint32_t rank, bool& caseOk)
{
    if (opt.apiMask & API_WRITE) {
        EXAMPLES_ACLCHECK(
            CheckRegion(env.devBase, stage, layout.writeBase, windowBytes, env.peerPattern, "write", rank, caseOk));
    }
    if (opt.apiMask & API_READ) {
        EXAMPLES_ACLCHECK(
            CheckRegion(env.devBase, stage, layout.readBase, windowBytes, env.peerPattern, "read", rank, caseOk));
    }
    if (opt.apiMask & API_NOTIFY) {
        EXAMPLES_ACLCHECK(
            CheckRegion(env.devBase, stage, layout.notifyBase, windowBytes, env.peerPattern, "notify", rank, caseOk));
        // notify flag 期望值 = 固定值（单槽被一批请求并发写，落地顺序不可校验）
        EXAMPLES_ACLCHECK(CheckFlag(env.devBase, layout.flagsBase, NOTIFY_VAL_BASE, rank, caseOk));
    }
    return ACL_SUCCESS;
}

// 跑单档：重铺初值 → barrier → launch → sync → barrier → 拷回结果 →
// 打 PERF_DATA → 校验 → 全体合并判定
int32_t RunOneCase(
    examples::RankSyncContext& sync, RankResources& res, const RunOptions& opt, uint32_t nranks, uint64_t len,
    uint32_t batch, const CaseEnv& env, std::vector<PerfRow>& rows)
{
    constexpr int32_t CASE_OK = 0;
    constexpr int32_t CASE_FAILED = 1;
    const uint32_t rank = res.rank;
    const CaseLayout layout = CaseLayoutOf(len, batch);
    const uint64_t windowBytes = static_cast<uint64_t>(batch) * len; // 一个批窗口
    char caseName[48];
    std::snprintf(caseName, sizeof(caseName), "batch%u_%lluB", batch, static_cast<unsigned long long>(len));

    // stage 随窗口扩大
    if (res.stage.size() * sizeof(int32_t) < windowBytes) {
        res.stage.resize(static_cast<size_t>(windowBytes / sizeof(int32_t)));
    }

    // 重铺初值。所有参与方都铺完再放行，否则可能「对端已经写进来了，我才清 0」。
    EXAMPLES_ACLCHECK(RefillInitial(env.devBase, res.stage.data(), layout, windowBytes, rank));
    if (!sync.Barrier(kTagLaunched)) {
        std::cout << "[rank " << rank
                  << "] refill barrier failed (a peer rank process exited or the control channel is broken; check "
                     "other ranks' logs)"
                  << std::endl;
        return 1;
    }

    // launch 本档核函数
    std::cout << "[rank " << rank << "] case=" << caseName << ": len=" << len << "B rounds=" << opt.rounds
              << " batch=" << batch << " launching..." << std::endl;
    KernelContext context{};
    context.channelHandle = static_cast<uint64_t>(res.channel);
    context.recvChannelHandle = static_cast<uint64_t>(res.recvChannel);
    context.localBufferAddr = reinterpret_cast<uint64_t>(res.shareBuf);
    context.remoteBufferAddr = res.remoteBuf;
    context.recvRemoteBufferAddr = res.recvRemoteBuf;
    context.msgBytes = len;
    context.rounds = opt.rounds;
    context.batchCap = batch;
    context.apiMask = opt.apiMask;
    context.commitInWindow = opt.commitInWindow;
    context.metricMask = opt.metricMask;
    for (uint32_t apiIdx = 0U; apiIdx < API_IDX_COUNT; ++apiIdx) {
        for (uint32_t j = 0U; j < TIMING_WORDS; ++j) {
            context.timing[apiIdx][j] = 0U;
        }
    }
    context.drainRet = 0U;
    context.result = KERNEL_SUCCESS;
    EXAMPLES_ACLCHECK(
        aclrtMemcpy(res.deviceContext, sizeof(context), &context, sizeof(context), ACL_MEMCPY_HOST_TO_DEVICE));
    LaunchUrmaBatchApiPerf(res.stream, reinterpret_cast<uint64_t>(reinterpret_cast<uintptr_t>(res.deviceContext)));
    const aclError syncRet = aclrtSynchronizeStream(res.stream);
    if (syncRet != ACL_SUCCESS) {
        std::cout << "[rank " << rank << "][FAIL] case=" << caseName << " aclrtSynchronizeStream = " << syncRet
                  << " (507035 = vector core exception, kernel died on AIV; common causes: batch/len out of the "
                     "kernel-side budget, or a channel/memory address mismatch)"
                  << std::endl;
        return syncRet;
    }

    // 收尾同步：确保写本卡的卡也收尾完了，本卡再读落点区
    if (!sync.Barrier(kTagDrained)) {
        std::cout << "[rank " << rank
                  << "] drain barrier failed (a peer rank process exited or the control channel is broken; check other "
                     "ranks' logs)"
                  << std::endl;
        return 1;
    }

    // 拷回 kernel 结果
    EXAMPLES_ACLCHECK(
        aclrtMemcpy(&context, sizeof(context), res.deviceContext, sizeof(context), ACL_MEMCPY_DEVICE_TO_HOST));
    if (context.result != KERNEL_SUCCESS) {
        std::cout << "[rank " << rank << "][FAIL] case=" << caseName << " "
                  << KernelResultName(static_cast<KernelResult>(context.result))
                  << ", hcommRet=" << context.timing[0][WARMUP_METRIC_INDEX] << ", drainRet=" << context.drainRet
                  << std::endl;
        // 不直接 break：先走到档末同步（全体合并判定），否则对端会卡在同步点上
    }

    // 打性能结果行（公共 utils/perf_result.h）：每个「操作 × 口径」组合一行，
    // 样本数 = rounds × batch（一个样本 = 批内一条请求）；
    // timing 第一维按操作分槽，--api all 时各操作各取各的计时
    bool caseOk = context.result == KERNEL_SUCCESS;
    if (caseOk) {
        const uint32_t apiIdxBits[] = {API_WRITE, API_READ, API_NOTIFY};
        for (uint32_t apiIdx = 0U; apiIdx < API_IDX_COUNT; ++apiIdx) {
            if ((opt.apiMask & apiIdxBits[apiIdx]) == 0U) {
                continue;
            }
            examples::CollectPerfRows(
                context.timing[apiIdx], rank, apiIdxBits[apiIdx], opt.metricMask, opt.rounds, len, batch,
                CommitName(opt.commitInWindow), examples::PerfTypeName(opt.perfType), rows);
        }
    }

    // 校验（kernel 失败时 caseOk 已为 false，只补日志不读内存）
    if (caseOk) {
        EXAMPLES_ACLCHECK(ValidateCase(opt, env, res.stage.data(), layout, windowBytes, rank, caseOk));
    }

    std::cout << "[rank " << rank << "] case=" << caseName << " validation: " << (caseOk ? "PASS" : "FAIL")
              << " (checked " << (windowBytes >> 10) << "KB per region)" << std::endl;

    // 全体合并判定：一方失败就都停（单方 break 会让对端卡死在同步点上）
    const uint32_t flags = caseOk ? 1U : 0U;
    std::vector<uint32_t> allFlags(nranks, 0U);
    if (!sync.Allgather(kTagCaseEnd, &flags, sizeof(flags), allFlags.data())) {
        std::cout << "[rank " << rank
                  << "] case-end allgather failed (a peer rank process exited or the control channel is broken; check "
                     "other ranks' logs)"
                  << std::endl;
        return 1;
    }
    for (uint32_t r = 0U; r < nranks; ++r) {
        if (allFlags[r] == 0U) {
            if (caseOk) {
                std::cout << "[rank " << rank << "] peer rank " << r << " failed case=" << caseName
                          << ", skip the remaining cases" << std::endl;
            } else {
                std::cout << "[rank " << rank << "] case=" << caseName << " failed, skip the remaining cases"
                          << std::endl;
            }
            caseOk = false; // 防止「本卡过、对端挂」时继续进下一档
        }
    }
    return caseOk ? CASE_OK : CASE_FAILED;
}

// 通信 rank 的主流程：打印参数 → 环境搭建 → 取对端地址 → 逐档 RunOneCase → 汇总落盘。
// p2p 与 ring 都走本函数，差别只在 topo 里的对端角色。
int32_t RunCommRank(
    examples::RankSyncContext& sync, uint32_t rank, uint32_t nranks, const RunOptions& opt,
    const examples::RankTopology& topo)
{
    const std::vector<uint32_t> batches = BuildBatchLadder(opt.minBatch, opt.maxBatch);
    if (batches.empty()) {
        std::cout << "[rank " << rank << "] invalid --batch-range " << opt.minBatch << " " << opt.maxBatch
                  << " (expect 1 <= min <= max)" << std::endl;
        return 1;
    }
    const std::vector<uint64_t> lens = BuildLadderChecked(rank, opt, batches);
    if (lens.empty()) {
        return 1;
    }

    // 打印本次测试的参数组合
    std::cout << "[rank " << rank << "] config: lens=2^" << opt.minExp << "B..2^" << opt.maxExp << "B (x2 steps, "
              << lens.size() << " cases)";
    for (uint64_t len : lens) {
        std::cout << " " << len << "B";
    }
    std::cout << "\n[rank " << rank << "] config: batch=" << batches.front() << ".." << batches.back() << " (x2 steps, "
              << batches.size() << " cases)";
    for (uint32_t batch : batches) {
        std::cout << " " << batch;
    }
    std::cout << "\n[rank " << rank << "] config: perf_type=" << examples::PerfTypeName(opt.perfType)
              << ", nranks=" << nranks << ", send->rank " << topo.sendRank << ", read<-rank " << topo.recvRank
              << ", api=" << ApiMaskName(opt.apiMask) << ", commit=" << CommitName(opt.commitInWindow)
              << ", metric=" << MetricMaskName(opt.metricMask) << ", rounds=" << opt.rounds << std::endl;

    RankResources res;
    res.rank = rank;

    const int32_t envRet = InitRankEnv(sync, res, topo);
    if (envRet != 0) {
        return envRet;
    }

    const int32_t sendRet = ResolveRemoteBuf(res, res.channel, topo.sendRank, res.remoteBuf);
    if (sendRet != 0) {
        return sendRet;
    }
    const int32_t recvRet = ResolveRemoteBuf(res, res.recvChannel, topo.recvRank, res.recvRemoteBuf);
    if (recvRet != 0) {
        return recvRet;
    }

    // 建链 / 远端内存表就绪后再进档位循环
    if (!sync.Barrier(kTagReady)) {
        std::cout << "[rank " << rank
                  << "] ready barrier failed (a peer rank process exited or the control channel is broken; check other "
                     "ranks' logs)"
                  << std::endl;
        return 1;
    }

    std::vector<PerfRow> rows;
    bool ok = true;
    CaseEnv env;
    env.devBase = static_cast<uint8_t*>(res.shareBuf);
    env.myPattern = SRC_PATTERN_BASE + static_cast<int32_t>(rank);
    // 落点区数据都来自上游卡（ring 下 = recvRank）
    env.peerPattern = SRC_PATTERN_BASE + static_cast<int32_t>(topo.recvRank);

    for (uint32_t batch : batches) {
        if (!ok) {
            break;
        }
        for (uint64_t len : lens) {
            if (!ok) {
                break;
            }
            const int32_t caseRet = RunOneCase(sync, res, opt, nranks, len, batch, env, rows);
            if (caseRet != 0) {
                // 1 = 本档失败（走退出码 2），其他 = 错误码原样透传
                if (caseRet != 1) {
                    return caseRet;
                }
                ok = false;
            }
        }
    }

    std::cout << "\n[rank " << rank << "] ===== urma_batch_api_perf: " << (ok ? "PASS" : "FAIL")
              << " =====" << std::endl;

    // 终局结果交换（公共 utils/perf_result.h）：各 rank 的行经 allgather 汇聚到
    // rank 0 落盘；容量上界按同一命令行推出，各 rank 一致
    const size_t rowCapacity =
        batches.size() * lens.size() * examples::Popcount32(opt.apiMask) * examples::Popcount32(opt.metricMask);
    if (!examples::GatherPerfRowsToRoot(
            sync, rank, nranks, rowCapacity, CommitName(opt.commitInWindow), examples::PerfTypeName(opt.perfType),
            rows)) {
        std::cout << "[rank " << rank
                  << "] result exchange failed (a peer rank process exited or the control channel is broken; check "
                     "other ranks' logs), csv falls back to own rows only"
                  << std::endl;
    }

    // rank 0 落盘汇聚后的全量 CSV
    if (rank == 0U) {
        examples::WritePerfCsv(rows, "perf_data.csv");
        std::cout << "[rank 0] perf data written to perf_data.csv (" << rows.size() << " rows)" << std::endl;
    }

    return ok ? 0 : 2;
}

// 空闲 rank（p2p 且 rank >= 2）：不注册内存、不建链、不起核，
// 只应答各个集合点保证通信域与同步序列完整，无性能数据。
int32_t RunIdleRank(examples::RankSyncContext& sync, uint32_t rank, uint32_t nranks, const RunOptions& opt)
{
    const std::vector<uint32_t> batches = BuildBatchLadder(opt.minBatch, opt.maxBatch);
    const std::vector<uint64_t> lens = examples::BuildLenLadder(opt.minExp, opt.maxExp);
    const size_t caseCount = batches.size() * lens.size();
    const size_t rowCapacity = caseCount * examples::Popcount32(opt.apiMask) * examples::Popcount32(opt.metricMask);
    {
        // 通信域包含全体 rank，空闲 rank 也参加 root info 交换；
        // HcclCommInitRootInfo 内部查询设备，须先 aclInit + SetDevice。
        // 建出的通信域本 rank 不使用，立即销毁。
        EXAMPLES_ACLCHECK(aclInit(nullptr));
        EXAMPLES_ACLCHECK(aclrtSetDevice(rank));
        HcclComm idleComm = nullptr;
        (void)examples::InitCommByRootInfo(sync, &idleComm);
        if (idleComm != nullptr) {
            (void)HcclCommDestroy(idleComm);
        }
        (void)aclrtResetDevice(static_cast<int32_t>(rank));
        (void)aclFinalize();
    }
    if (!sync.Barrier(kTagReady)) {
        return 1;
    }
    // 档末投票与通信方同票停表：任一 rank 失败即跳出，两侧序列等长
    uint32_t idleFlag = 1U;
    std::vector<uint32_t> idleAllFlags(nranks, 0U);
    for (size_t i = 0; i < caseCount; ++i) {
        if (!sync.Barrier(kTagLaunched) || !sync.Barrier(kTagDrained) ||
            !sync.Allgather(kTagCaseEnd, &idleFlag, sizeof(idleFlag), idleAllFlags.data())) {
            return 1;
        }
        bool stop = false;
        for (uint32_t r = 0U; r < nranks; ++r) {
            stop = stop || (idleAllFlags[r] == 0U);
        }
        if (stop) {
            std::cout << "[rank " << rank << "] peer failed, skip the remaining cases" << std::endl;
            break;
        }
    }
    // 终局结果交换：空表到场即可；容量与通信方一致（Allgather 等长载荷）
    std::vector<PerfRow> noRows;
    if (!examples::GatherPerfRowsToRoot(
            sync, rank, nranks, rowCapacity, CommitName(opt.commitInWindow), examples::PerfTypeName(opt.perfType),
            noRows)) {
        return 1;
    }
    std::cout << "[rank " << rank << "] idle rank (p2p): finished without communication" << std::endl;
    return 0;
}

// rank 侧主入口：建同步通道 → 按拓扑分角色，通信 rank 跑测试、空闲 rank 只挂集合点。
int32_t RunUrmaBatchApiPerfRank(uint32_t rank, uint32_t nranks, const std::string& ctrlEndpoint, const RunOptions& opt)
{
    examples::RankSyncContext sync = rank == 0U ? examples::RankSyncContext::Listen(ctrlEndpoint, nranks) :
                                                  examples::RankSyncContext::Connect(rank, nranks, ctrlEndpoint);
    if (!sync.Ok()) {
        std::cout << "[rank " << rank
                  << "] control channel setup failed (endpoint occupied or unreachable; use a free port and check "
                     "tcp://ip:port)"
                  << std::endl;
        return 1;
    }

    const examples::RankTopology topo = examples::BuildRankTopology(rank, nranks, opt.perfType);
    return topo.active ? RunCommRank(sync, rank, nranks, opt, topo) : RunIdleRank(sync, rank, nranks, opt);
}

// 解析 main 的命令行，失败时打印 usage 并返回 false。
// rank 数由 --ranks 指定（默认 2）。
bool ParseCommandLine(int argc, char* argv[], std::string& endpoint, uint32_t& nranks, RunOptions& opt)
{
    if (argc < 2) {
        std::cout << "Usage: " << argv[0] << " <tcp://ip:port> [options]" << std::endl;
        std::cout << "Options:" << std::endl;
        std::cout << "  --ranks N                 Number of rank processes to launch, default: 2" << std::endl;
        std::cout << "  --perf_type p2p|ring      Communication topology, default: p2p" << std::endl;
        std::cout
            << "  --exponent-range min max  Data size exponent range (2^exp, inclusive), default: 3 17 (8B..128KB)"
            << std::endl;
        std::cout << "  --exponent exp            Single exponent (runs only 2^exp)" << std::endl;
        std::cout << "  --api all|write|read|notify[,..]  APIs to measure, default: all" << std::endl;
        std::cout << "  --metric all|lat|bw[,..]  lat = issue latency (no Drain in window) / bw = end-to-end (with "
                     "Drain), default: all"
                  << std::endl;
        std::cout << "  --commit true|false       Both fire BatchCommit per batch; true counts it in the latency "
                     "window, default: true"
                  << std::endl;
        std::cout << "  --rounds N                Batch-round repetitions per case, default: 1" << std::endl;
        std::cout << "  --batch-range min max     Batch sizes (x2 steps, inclusive), default: 1024 1024" << std::endl;
        std::cout << "  --batch N                 Single batch size (equivalent to --batch-range N N)" << std::endl;
        return false;
    }
    endpoint = argv[1];
    for (int i = 2; i < argc; ++i) {
        const std::string arg = argv[i];
        const char* val = (i + 1 < argc) ? argv[i + 1] : nullptr;
        if (arg == "--ranks" && val != nullptr) {
            if (!examples::ParseUint32(val, nranks, 2)) {
                std::cout << "invalid --ranks '" << val << "' (expect an integer >= 2)" << std::endl;
                return false;
            }
            ++i;
        } else if (arg == "--perf_type" && val != nullptr) {
            if (!examples::ParsePerfType(val, opt.perfType)) {
                std::cout << "invalid --perf_type '" << val << "' (expect p2p or ring)" << std::endl;
                return false;
            }
            ++i;
        } else if (arg == "--exponent" && val != nullptr) {
            if (!examples::ParseUint64(val, opt.minExp) || opt.minExp < 3 || opt.minExp > 30) {
                std::cout << "invalid --exponent '" << val << "' (expect 3 <= exp <= 30, datasize = 2^exp)"
                          << std::endl;
                return false;
            }
            opt.maxExp = opt.minExp;
            ++i;
        } else if (arg == "--exponent-range" && val != nullptr && (i + 2 < argc)) {
            if (!examples::ParseUint64(val, opt.minExp) || !examples::ParseUint64(argv[i + 2], opt.maxExp) ||
                opt.maxExp > 30) {
                std::cout << "invalid --exponent-range '" << val << " " << argv[i + 2]
                          << "' (expect minExp maxExp, datasize = 2^exp)" << std::endl;
                return false;
            }
            i += 2;
        } else if (arg == "--api" && val != nullptr) {
            static const char* const kApiNames[] = {"write", "read", "notify", nullptr};
            if (!examples::ParseMask(val, kApiNames, API_ALL, opt.apiMask) || opt.apiMask == 0U) {
                std::cout << "invalid --api '" << val << "' (expect all or write|read|notify, comma separated)"
                          << std::endl;
                return false;
            }
            ++i;
        } else if (arg == "--metric" && val != nullptr) {
            static const char* const kMetricNames[] = {"lat", "bw", nullptr};
            if (!examples::ParseMask(val, kMetricNames, METRIC_ALL, opt.metricMask) || opt.metricMask == 0U) {
                std::cout << "invalid --metric '" << val << "' (expect all or lat|bw, comma separated)" << std::endl;
                return false;
            }
            ++i;
        } else if (arg == "--commit" && val != nullptr) {
            const std::string commit = val;
            if (commit == "true") {
                opt.commitInWindow = 1;
            } else if (commit == "false") {
                opt.commitInWindow = 0;
            } else {
                std::cout << "invalid --commit '" << val << "' (expect true or false)" << std::endl;
                return false;
            }
            ++i;
        } else if (arg == "--rounds" && val != nullptr) {
            if (!examples::ParseUint32(val, opt.rounds, 1)) {
                std::cout << "invalid --rounds '" << val << "' (expect positive integer)" << std::endl;
                return false;
            }
            ++i;
        } else if (arg == "--batch" && val != nullptr) {
            uint32_t batch = 0;
            if (!examples::ParseUint32(val, batch, 1)) {
                std::cout << "invalid --batch '" << val << "' (expect 1.." << 0xFFFFFFFFULL << ")" << std::endl;
                return false;
            }
            opt.minBatch = opt.maxBatch = batch;
            ++i;
        } else if (arg == "--batch-range" && val != nullptr && (i + 2 < argc)) {
            uint32_t minB = 0;
            uint32_t maxB = 0;
            if (!examples::ParseUint32(val, minB, 1) || !examples::ParseUint32(argv[i + 2], maxB, 1) || maxB < minB) {
                std::cout << "invalid --batch-range '" << val << " " << argv[i + 2]
                          << "' (expect 1 <= min <= max <= " << 0xFFFFFFFFULL << ")" << std::endl;
                return false;
            }
            opt.minBatch = minB;
            opt.maxBatch = maxB;
            i += 2;
        } else {
            std::cout << "unknown or incomplete option '" << arg << "'" << std::endl;
            return false;
        }
    }
    return true;
}

} // namespace

int main(int argc, char* argv[])
{
    std::string endpoint;
    uint32_t nranks = 2;
    RunOptions opt;
    if (!ParseCommandLine(argc, argv, endpoint, nranks, opt)) {
        return 1;
    }

    std::vector<examples::ArgsOf<decltype(RunUrmaBatchApiPerfRank)>> perRankArgs;
    perRankArgs.reserve(nranks);
    for (uint32_t rank = 0; rank < nranks; ++rank) {
        perRankArgs.emplace_back(rank, nranks, endpoint, opt);
    }

    examples::ProcessGroup group;
    if (!group.Launch(nranks, RunUrmaBatchApiPerfRank, std::move(perRankArgs))) {
        return 1;
    }
    const bool pass = group.WaitAll();

    if (group.Interrupted()) {
        std::cout << "RESULT | Example=urma_batch_api_perf | Status=INTERRUPTED" << std::endl;
        return 1;
    }
    std::cout << "RESULT | Example=urma_batch_api_perf | Status=" << (pass ? "PASS" : "FAIL") << std::endl;
    return pass ? 0 : 1;
}
