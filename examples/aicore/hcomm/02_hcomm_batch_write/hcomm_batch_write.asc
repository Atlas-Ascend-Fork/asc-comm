extern "C" __vector__ __global__ __aicore__ void hcomm_batch_write_kernel(GM_ADDR context);

namespace {

// 本样例host侧同步点的tag：地址allgather与kernel前后两个barrier。
constexpr uint32_t kTagBuffers = examples::kTagUserBase;
constexpr uint32_t kTagChannelsReady = examples::kTagUserBase + 1U;
constexpr uint32_t kTagKernelDone = examples::kTagUserBase + 2U;

using namespace HcommBatchWriteExample;

constexpr int32_t SUCCESS = 0;
constexpr int32_t FAILURE = 1;
constexpr int64_t SOCKET_TIMEOUT_SECONDS = 60;

struct EndpointGroup {
    EndpointDesc localEndpoint{};
    std::vector<uint32_t> peerRanks;
    std::vector<HcclChannelDesc> channelDescs;
    MultiChannelHandle multiChannel{0U};
};

struct RankResources {
    RankResources() = default;

    ~RankResources()
    {
        if (comm != nullptr) {
            (void)HcclCommDestroy(comm);
        }
        if (deviceContext != nullptr) {
            (void)aclrtFree(deviceContext);
        }
        if (deviceBuffer != nullptr) {
            (void)aclrtFree(deviceBuffer);
        }
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (deviceSet) {
            (void)aclrtResetDevice(static_cast<int32_t>(rank));
        }
        if (aclInitialized) {
            (void)aclFinalize();
        }
    }

    RankResources(const RankResources&) = delete;
    RankResources& operator=(const RankResources&) = delete;

    uint32_t rank{0U};
    uint32_t rankNum{0U};
    bool aclInitialized{false};
    bool deviceSet{false};
    aclrtStream stream{nullptr};
    HcclComm comm{nullptr};
    void* deviceBuffer{nullptr};
    uint8_t* deviceContext{nullptr};
    HcclMemHandle memHandle{nullptr};
};

uint64_t GetCommBufferSize(uint32_t rankNum) { return RECV_BASE_OFFSET + static_cast<uint64_t>(rankNum) * DATA_SIZE; }

uint8_t GetDataValue(uint32_t rank, uint32_t offset) { return static_cast<uint8_t>(rank * 53U + offset); }

void FillSourceData(std::vector<uint8_t>& buffer, uint32_t rank)
{
    for (uint32_t offset = 0U; offset < DATA_SIZE; ++offset) {
        buffer[SEND_OFFSET + offset] = GetDataValue(rank, offset);
    }
}

const char* GetKernelError(KernelResult result)
{
    switch (result) {
        case KERNEL_WRITE_FAILED:
            return "WriteNbi failed";
        case KERNEL_COMMIT_FAILED:
            return "BatchCommit failed";
        case KERNEL_DRAIN_FAILED:
            return "Drain failed";
        default:
            return "unknown kernel error";
    }
}

int32_t InitAcl(RankResources& resources)
{
    EXAMPLES_CHECK(aclInit(nullptr), ACL_SUCCESS, resources.rank);
    resources.aclInitialized = true;

    uint32_t deviceCount = 0U;
    EXAMPLES_CHECK(aclrtGetDeviceCount(&deviceCount), ACL_SUCCESS, resources.rank);
    if (deviceCount < resources.rankNum) {
        std::fprintf(
            stderr, "[ERROR] rank %u: %u devices are required, found %u\n", resources.rank, resources.rankNum,
            deviceCount);
        return FAILURE;
    }
    EXAMPLES_CHECK(aclrtSetDevice(static_cast<int32_t>(resources.rank)), ACL_SUCCESS, resources.rank);
    resources.deviceSet = true;
    EXAMPLES_CHECK(aclrtCreateStream(&resources.stream), ACL_SUCCESS, resources.rank);
    return SUCCESS;
}

int32_t InitCommunicator(RankResources& resources, examples::RankSyncContext& sync)
{
    HcclCommConfig config{};
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = resources.rank;
    EXAMPLES_CHECK(examples::InitCommByRootInfoConfig(sync, &config, &resources.comm), HCCL_SUCCESS, resources.rank);
    return SUCCESS;
}

int32_t PrepareMemory(RankResources& resources, examples::RankSyncContext& sync, std::vector<uint64_t>& remoteBuffers)
{
    const uint64_t commBufferSize = GetCommBufferSize(resources.rankNum);
    EXAMPLES_CHECK(
        aclrtMalloc(&resources.deviceBuffer, commBufferSize, ACL_MEM_MALLOC_HUGE_FIRST), ACL_SUCCESS, resources.rank);
    EXAMPLES_CHECK(
        aclrtMalloc(
            reinterpret_cast<void**>(&resources.deviceContext), sizeof(BatchContext), ACL_MEM_MALLOC_HUGE_FIRST),
        ACL_SUCCESS, resources.rank);

    std::vector<uint8_t> hostBuffer(static_cast<size_t>(commBufferSize), 0U);
    FillSourceData(hostBuffer, resources.rank);
    EXAMPLES_CHECK(
        aclrtMemcpy(
            resources.deviceBuffer, commBufferSize, hostBuffer.data(), commBufferSize, ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, resources.rank);

    CommMem memory{};
    memory.type = COMM_MEM_TYPE_DEVICE;
    memory.addr = resources.deviceBuffer;
    memory.size = commBufferSize;
    EXAMPLES_CHECK(
        HcclCommMemReg(resources.comm, MEMORY_TAG, &memory, &resources.memHandle), HCCL_SUCCESS, resources.rank);

    // 各rank上报本端buffer地址，allgather后所有rank都拿到全表。
    const uint64_t localBuffer = reinterpret_cast<uint64_t>(resources.deviceBuffer);
    remoteBuffers.resize(resources.rankNum);
    if (!sync.Allgather(kTagBuffers, &localBuffer, sizeof(localBuffer), remoteBuffers.data())) {
        std::fprintf(stderr, "[ERROR] rank %u: buffer address allgather failed\n", resources.rank);
        return FAILURE;
    }
    for (uint32_t rank = 0U; rank < resources.rankNum; ++rank) {
        if (remoteBuffers[rank] == 0U) {
            std::fprintf(stderr, "[ERROR] rank %u: received null buffer for rank %u\n", resources.rank, rank);
            return FAILURE;
        }
    }
    return SUCCESS;
}

const CommLink* FindUbcCtpLink(const CommLink* links, uint32_t linkNum)
{
    for (uint32_t index = 0U; index < linkNum; ++index) {
        if (links[index].linkAttr.linkProtocol == COMM_PROTOCOL_UB_CTP) {
            return &links[index];
        }
    }
    return nullptr;
}

bool HasSameRaws(const EndpointDesc& lhs, const EndpointDesc& rhs)
{
    return std::memcmp(lhs.commAddr.raws, rhs.commAddr.raws, sizeof(lhs.commAddr.raws)) == 0;
}

EndpointGroup& FindOrAddGroup(const EndpointDesc& localEndpoint, std::vector<EndpointGroup>& groups)
{
    for (EndpointGroup& group : groups) {
        if (HasSameRaws(group.localEndpoint, localEndpoint)) {
            return group;
        }
    }
    groups.push_back(EndpointGroup{});
    groups.back().localEndpoint = localEndpoint;
    return groups.back();
}

int32_t AddPeerToGroup(
    RankResources& resources, uint32_t peerRank, const CommLink& link, std::vector<EndpointGroup>& groups)
{
    HcclChannelDesc desc{};
    EXAMPLES_CHECK(HcclChannelDescInit(&desc, 1U), HCCL_SUCCESS, resources.rank);
    desc.remoteRank = peerRank;
    desc.channelProtocol = COMM_PROTOCOL_UB_CTP;
    desc.localEndpoint = link.srcEndpointDesc;
    desc.remoteEndpoint = link.dstEndpointDesc;
    desc.memHandles = &resources.memHandle;
    desc.memHandleNum = 1U;

    EndpointGroup& group = FindOrAddGroup(desc.localEndpoint, groups);
    group.peerRanks.push_back(peerRank);
    group.channelDescs.push_back(desc);
    return SUCCESS;
}

int32_t BuildEndpointGroups(RankResources& resources, std::vector<EndpointGroup>& groups)
{
    uint32_t* layers = nullptr;
    uint32_t layerCount = 0U;
    EXAMPLES_CHECK(HcclRankGraphGetLayers(resources.comm, &layers, &layerCount), HCCL_SUCCESS, resources.rank);

    std::vector<uint32_t> peerRanks;
    if (resources.rank == 0U) {
        for (uint32_t peerRank = 1U; peerRank < resources.rankNum; ++peerRank) {
            peerRanks.push_back(peerRank);
        }
    } else {
        peerRanks.push_back(0U);
    }

    for (uint32_t peerRank : peerRanks) {
        bool found = false;
        for (uint32_t layerIndex = 0U; layerIndex < layerCount; ++layerIndex) {
            CommLink* links = nullptr;
            uint32_t linkCount = 0U;
            EXAMPLES_CHECK(
                HcclRankGraphGetLinks(resources.comm, layers[layerIndex], resources.rank, peerRank, &links, &linkCount),
                HCCL_SUCCESS, resources.rank);
            const CommLink* link = FindUbcCtpLink(links, linkCount);
            if (link == nullptr) {
                continue;
            }
            EXAMPLES_CHECK(AddPeerToGroup(resources, peerRank, *link, groups), SUCCESS, resources.rank);
            found = true;
            break;
        }
        if (!found) {
            std::fprintf(stderr, "[ERROR] rank %u: no UB_CTP link to rank %u\n", resources.rank, peerRank);
            return FAILURE;
        }
    }
    return SUCCESS;
}

int32_t CreateMultiChannelHandles(RankResources& resources, std::vector<EndpointGroup>& groups)
{
    for (size_t groupIndex = 0U; groupIndex < groups.size(); ++groupIndex) {
        EndpointGroup& group = groups[groupIndex];
        const std::string sharedQueueTag = std::string(SHARED_QUEUE_TAG_PREFIX) + "_" + std::to_string(resources.rank) +
                                           "_" + std::to_string(groupIndex);
        EXAMPLES_CHECK(
            MakeMultiChannelHandle(
                resources.comm, sharedQueueTag.c_str(), group.channelDescs.data(),
                static_cast<uint32_t>(group.channelDescs.size()), &group.multiChannel),
            HCCL_SUCCESS, resources.rank);
        std::printf(
            "[rank %u] endpoint group %zu has %zu peer(s)\n", resources.rank, groupIndex, group.peerRanks.size());
    }
    return SUCCESS;
}

int32_t RunGroupKernel(RankResources& resources, const EndpointGroup& group, const std::vector<uint64_t>& remoteBuffers)
{
    if (group.peerRanks.empty() || group.peerRanks.size() > MAX_CHANNEL_NUM) {
        return FAILURE;
    }

    BatchContext context{};
    context.multiChannel = group.multiChannel;
    context.localBuffer = reinterpret_cast<uint64_t>(resources.deviceBuffer);
    context.channelNum = static_cast<uint32_t>(group.peerRanks.size());
    context.result = KERNEL_SUCCESS;
    context.hcommResult = 0;
    for (size_t channelIndex = 0U; channelIndex < group.peerRanks.size(); ++channelIndex) {
        context.remoteBuffers[channelIndex] = remoteBuffers[group.peerRanks[channelIndex]];
    }

    EXAMPLES_CHECK(
        aclrtMemcpy(resources.deviceContext, sizeof(context), &context, sizeof(context), ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, resources.rank);
    hcomm_batch_write_kernel<<<1U, nullptr, resources.stream>>>(resources.deviceContext);
    EXAMPLES_CHECK(aclrtSynchronizeStream(resources.stream), ACL_SUCCESS, resources.rank);
    EXAMPLES_CHECK(
        aclrtMemcpy(&context, sizeof(context), resources.deviceContext, sizeof(context), ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, resources.rank);
    if (context.result != KERNEL_SUCCESS) {
        std::fprintf(
            stderr, "[ERROR] rank %u: %s, hcomm ret=%d\n", resources.rank, GetKernelError(context.result),
            context.hcommResult);
        return FAILURE;
    }
    return SUCCESS;
}

int32_t ValidateResults(const RankResources& resources)
{
    const uint64_t commBufferSize = GetCommBufferSize(resources.rankNum);
    std::vector<uint8_t> hostBuffer(static_cast<size_t>(commBufferSize), 0U);
    EXAMPLES_CHECK(
        aclrtMemcpy(
            hostBuffer.data(), commBufferSize, resources.deviceBuffer, commBufferSize, ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, resources.rank);

    const uint64_t receiveOffset = RECV_BASE_OFFSET;
    for (uint32_t offset = 0U; offset < DATA_SIZE; ++offset) {
        uint8_t actual = hostBuffer[receiveOffset + offset];
        uint8_t expected = GetDataValue(0U, offset);
        if (actual != expected) {
            std::fprintf(
                stderr, "[ERROR] rank %u: data from rank 0 mismatch at %u, actual=0x%02x, expected=0x%02x\n",
                resources.rank, offset, actual, expected);
            return FAILURE;
        }
    }
    std::printf("[rank %u] hcomm_batch_write | received and verified data from rank 0 | PASS\n", resources.rank);
    return SUCCESS;
}

int32_t RunRank(uint32_t rank, uint32_t rankNum, const std::string& ctrlEndpoint)
{
    RankResources resources{};
    resources.rank = rank;
    resources.rankNum = rankNum;

    examples::RankSyncContext sync = rank == 0U ? examples::RankSyncContext::Listen(ctrlEndpoint, rankNum) :
                                                  examples::RankSyncContext::Connect(rank, rankNum, ctrlEndpoint);
    if (!sync.Ok()) {
        std::fprintf(stderr, "[ERROR] rank %u: control channel setup failed\n", rank);
        return FAILURE;
    }

    EXAMPLES_CHECK(InitAcl(resources), SUCCESS, rank);
    EXAMPLES_CHECK(InitCommunicator(resources, sync), SUCCESS, rank);

    std::vector<uint64_t> remoteBuffers;
    EXAMPLES_CHECK(PrepareMemory(resources, sync, remoteBuffers), SUCCESS, rank);

    std::vector<EndpointGroup> groups;
    EXAMPLES_CHECK(BuildEndpointGroups(resources, groups), SUCCESS, rank);
    EXAMPLES_CHECK(CreateMultiChannelHandles(resources, groups), SUCCESS, rank);

    // 全体通道建好后再下发kernel：kernel读对端内存表，建链未完成时读到的是空表。
    if (!sync.Barrier(kTagChannelsReady)) {
        std::fprintf(stderr, "[ERROR] rank %u: channels-ready barrier failed\n", rank);
        return FAILURE;
    }
    if (rank == 0U) {
        for (const EndpointGroup& group : groups) {
            EXAMPLES_CHECK(RunGroupKernel(resources, group, remoteBuffers), SUCCESS, rank);
        }
    }
    // rank 0的写全部落地后其余rank才校验，否则校验的是未写完的buffer。
    if (!sync.Barrier(kTagKernelDone)) {
        std::fprintf(stderr, "[ERROR] rank %u: kernel-done barrier failed\n", rank);
        return FAILURE;
    }
    return rank == 0U ? SUCCESS : ValidateResults(resources);
}
} // namespace

int32_t main(int32_t argc, char** argv)
{
    if (argc != 3) {
        std::fprintf(stderr, "Usage: %s <tcp://ip:port> <rank_size>\n", argv[0]);
        return FAILURE;
    }
    uint32_t rankNum = 0;
    if (!examples::ParseUint32(argv[2], rankNum, 2) || rankNum > MAX_RANK_NUM) {
        std::fprintf(stderr, "invalid rank_size: %s, expected an integer in [2, %u]\n", argv[2], MAX_RANK_NUM);
        return FAILURE;
    }
    const std::string endpoint = argv[1];
    (void)signal(SIGPIPE, SIG_IGN);

    std::vector<examples::ArgsOf<decltype(RunRank)>> perRankArgs;
    perRankArgs.reserve(rankNum);
    for (uint32_t rank = 0U; rank < rankNum; ++rank) {
        perRankArgs.emplace_back(rank, rankNum, endpoint);
    }

    examples::ProcessGroup group;
    if (!group.Launch(rankNum, RunRank, std::move(perRankArgs))) {
        return FAILURE;
    }
    const bool passed = group.WaitAll();

    std::printf("RESULT | Example=hcomm_batch_write | Status=%s\n", passed ? "PASS" : "FAIL");
    return passed ? SUCCESS : FAILURE;
}
