/*!
 * \file roce_batch_api_perf.asc
 * \brief Host side of the Hcomm RoCE batch API performance example.
 */

#include <mpi.h>

#include <algorithm>
#include <chrono>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "hccl/hccl.h"
#include "hccl/hccl_comm.h"
#include "hccl/hccl_rank_graph.h"
#include "hccl/hccl_res.h"
#include "hccl/hccl_types.h"

#include "roce_batch_api_perf_def.h"

extern void LaunchHcommRoceBatchApiPerf(void* stream, uint64_t context);

namespace {

using namespace HcommRoceBatchApiPerfExample;

using HcommRoceBatchApiPerfExample::FAIL;
using HcommRoceBatchApiPerfExample::SUCCESS;

#define CHECK_EQ(expr, expected)                                                                                  \
    do {                                                                                                          \
        const auto checkRet = static_cast<int64_t>(expr);                                                         \
        const auto checkExpected = static_cast<int64_t>(expected);                                                \
        if (checkRet != checkExpected) {                                                                          \
            std::fprintf(                                                                                         \
                stderr, "[ERROR] rank %u: %s failed, ret=%lld, expected=%lld, at %s:%d\n", resources.rank, #expr, \
                static_cast<long long>(checkRet), static_cast<long long>(checkExpected), __FILE__, __LINE__);     \
            return FAIL;                                                                                          \
        }                                                                                                         \
    } while (0)

struct RankResources {
    RankResources(uint32_t rankId, uint32_t rankCount) : rank(rankId), rankNum(rankCount) {}

    ~RankResources()
    {
        if (comm != nullptr) {
            (void)HcclCommDestroy(comm);
        }
        if (deviceContext != nullptr) {
            (void)aclrtFree(deviceContext);
        }
        if (sendBuffer != nullptr) {
            (void)aclrtFree(sendBuffer);
        }
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (deviceSet) {
            (void)aclrtResetDevice(static_cast<int32_t>(rank));
        }
        if (aclInitialized) {
            (void)aclFinalize();
        }
    }

    RankResources(const RankResources&) = delete;
    RankResources& operator=(const RankResources&) = delete;

    uint32_t rank;
    uint32_t rankNum;
    bool aclInitialized{false};
    bool deviceSet{false};
    aclrtStream stream{nullptr};
    HcclComm comm{nullptr};
    void* sendBuffer{nullptr};
    void* recvBuffer{nullptr};
    KernelContext* deviceContext{nullptr};
    HcclMemHandle memHandle{nullptr};
    ChannelHandle channel{0U};
    uint64_t remoteSendBuffer{0U};
    uint64_t remoteRecvBuffer{0U};
    uint64_t memoryBytes{0U};
};

bool IsAligned64(uint64_t address) { return (address & (ROCE_ADDRESS_ALIGNMENT_BYTES - 1U)) == 0U; }

struct MpiSession {
    MpiSession(int* argc, char*** argv)
    {
        if (MPI_Init(argc, argv) != MPI_SUCCESS) {
            std::fprintf(stderr, "[ERROR] MPI_Init failed\n");
            valid = false;
        }
    }

    ~MpiSession()
    {
        if (valid) {
            (void)MPI_Finalize();
        }
    }

    MpiSession(const MpiSession&) = delete;
    MpiSession& operator=(const MpiSession&) = delete;

    bool valid{true};
};

struct Arguments {
    uint32_t batchSize{DEFAULT_BATCH_SIZE};
    uint64_t minBytes{MIN_DATA_BYTES};
    uint64_t maxBytes{MAX_DATA_BYTES};
    uint32_t api{PERF_API_WRITE};
    bool valid{true};
};

Arguments ParseArguments(int argc, char** argv)
{
    Arguments args;
    for (int i = 1; i < argc; ++i) {
        const std::string option = argv[i];
        if (option != "--batch-size" && option != "--min-bytes" && option != "--max-bytes" && option != "--api") {
            std::fprintf(stderr, "[ERROR] unknown option: %s\n", argv[i]);
            args.valid = false;
            return args;
        }
        if (i + 1 >= argc) {
            std::fprintf(stderr, "[ERROR] %s requires a value\n", option.c_str());
            args.valid = false;
            return args;
        }
        const std::string value = argv[++i];
        if (option == "--api") {
            if (value == "write") {
                args.api = PERF_API_WRITE;
            } else if (value == "read") {
                args.api = PERF_API_READ;
            } else {
                std::fprintf(stderr, "[ERROR] --api must be write or read: %s\n", value.c_str());
                args.valid = false;
                return args;
            }
            continue;
        }

        char* end = nullptr;
        const unsigned long long numericValue = std::strtoull(value.c_str(), &end, 10);
        if (end == nullptr || *end != '\0') {
            std::fprintf(stderr, "[ERROR] invalid value for %s: %s\n", option.c_str(), value.c_str());
            args.valid = false;
            return args;
        }
        if (option == "--batch-size") {
            args.batchSize = static_cast<uint32_t>(numericValue);
        } else if (option == "--min-bytes") {
            args.minBytes = numericValue;
        } else {
            args.maxBytes = numericValue;
        }
    }

    if (args.batchSize == 0U || args.batchSize > MAX_BATCH_SIZE) {
        std::fprintf(stderr, "[ERROR] --batch-size must be in [1, %u]\n", MAX_BATCH_SIZE);
        args.valid = false;
    }
    if (args.minBytes < MIN_DATA_BYTES || args.maxBytes > MAX_DATA_BYTES || args.maxBytes < args.minBytes) {
        std::fprintf(
            stderr, "[ERROR] require %llu <= --min-bytes <= --max-bytes <= %llu\n",
            static_cast<unsigned long long>(MIN_DATA_BYTES), static_cast<unsigned long long>(MAX_DATA_BYTES));
        args.valid = false;
    }
    return args;
}

int32_t InitAcl(RankResources& resources)
{
    const uint32_t rank = resources.rank;
    CHECK_EQ(aclInit(nullptr), ACL_SUCCESS);
    resources.aclInitialized = true;

    uint32_t deviceCount = 0U;
    CHECK_EQ(aclrtGetDeviceCount(&deviceCount), ACL_SUCCESS);
    if (deviceCount < resources.rankNum) {
        std::fprintf(
            stderr, "[ERROR] rank %u: %u devices are required, found %u\n", resources.rank, resources.rankNum,
            deviceCount);
        return FAIL;
    }
    CHECK_EQ(aclrtSetDevice(static_cast<int32_t>(resources.rank)), ACL_SUCCESS);
    resources.deviceSet = true;
    CHECK_EQ(aclrtCreateStream(&resources.stream), ACL_SUCCESS);
    return SUCCESS;
}

int32_t InitCommunicator(RankResources& resources)
{
    const uint32_t rank = resources.rank;
    HcclRootInfo rootInfo = {};
    if (resources.rank == 0U) {
        CHECK_EQ(HcclGetRootInfo(&rootInfo), HCCL_SUCCESS);
    }
    if (MPI_Bcast(&rootInfo, sizeof(rootInfo), MPI_BYTE, 0, MPI_COMM_WORLD) != MPI_SUCCESS) {
        std::fprintf(stderr, "[ERROR] rank %u: MPI_Bcast root info failed\n", resources.rank);
        return FAIL;
    }

    HcclCommConfig config = {};
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = rank;
    CHECK_EQ(HcclCommInitRootInfoConfig(resources.rankNum, &rootInfo, rank, &config, &resources.comm), HCCL_SUCCESS);
    if (resources.comm == nullptr) {
        std::fprintf(stderr, "[ERROR] rank %u: HcclCommInitRootInfoConfig returned null comm\n", resources.rank);
        return FAIL;
    }
    return SUCCESS;
}

int32_t PrepareMemory(RankResources& resources)
{
    const uint32_t rank = resources.rank;
    if (resources.sendBuffer == nullptr) {
        const uint64_t payloadSpanBytes = resources.memoryBytes;
        const uint64_t recvBufferOffset = GET_ROCE_ALIGNED_BYTES(payloadSpanBytes);
        const uint64_t communicationBytes = std::max(MIN_COMM_BUFFER_BYTES, recvBufferOffset + payloadSpanBytes);
        CHECK_EQ(aclrtMalloc(&resources.sendBuffer, communicationBytes, ACL_MEM_MALLOC_HUGE_FIRST), ACL_SUCCESS);
        if (!IsAligned64(reinterpret_cast<uint64_t>(resources.sendBuffer))) {
            std::fprintf(stderr, "[ERROR] rank %u: communication memory base is not 64-byte aligned\n", resources.rank);
            return FAIL;
        }
        resources.recvBuffer = static_cast<uint8_t*>(resources.sendBuffer) + recvBufferOffset;
        if (!IsAligned64(reinterpret_cast<uint64_t>(resources.recvBuffer))) {
            std::fprintf(stderr, "[ERROR] rank %u: receive memory base is not 64-byte aligned\n", resources.rank);
            return FAIL;
        }
        CHECK_EQ(aclrtMemset(resources.recvBuffer, payloadSpanBytes, 0, payloadSpanBytes), ACL_SUCCESS);

        constexpr uint64_t chunkBytes = 16U << 20U;
        std::vector<uint8_t> hostChunk;
        for (uint64_t offset = 0U; offset < payloadSpanBytes; offset += chunkBytes) {
            const uint64_t currentBytes = std::min(chunkBytes, payloadSpanBytes - offset);
            hostChunk.resize(static_cast<size_t>(currentBytes));
            for (uint64_t index = 0U; index < currentBytes; ++index) {
                hostChunk[static_cast<size_t>(index)] = DataValue(resources.rank, offset + index);
            }
            CHECK_EQ(
                aclrtMemcpy(
                    static_cast<uint8_t*>(resources.sendBuffer) + offset, currentBytes, hostChunk.data(), currentBytes,
                    ACL_MEMCPY_HOST_TO_DEVICE),
                ACL_SUCCESS);
        }

        CommMem sendMemory{};
        sendMemory.type = COMM_MEM_TYPE_DEVICE;
        sendMemory.addr = resources.sendBuffer;
        sendMemory.size = communicationBytes;
        CHECK_EQ(HcclCommMemReg(resources.comm, MEMORY_TAG, &sendMemory, &resources.memHandle), HCCL_SUCCESS);
    }
    return SUCCESS;
}

int32_t FindRemoteBuffer(RankResources& resources, ChannelHandle channel, uint64_t& remoteAddress)
{
    uint32_t memoryCount = 0U;
    CommMem* memories = nullptr;
    char** tags = nullptr;
    CHECK_EQ(HcclChannelGetRemoteMems(resources.comm, channel, &memoryCount, &memories, &tags), HCCL_SUCCESS);
    if (memories == nullptr || memoryCount == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: no remote memory found\n", resources.rank);
        return FAIL;
    }

    const uint64_t requiredBytes = GET_ROCE_ALIGNED_BYTES(resources.memoryBytes) + resources.memoryBytes;
    bool found = false;
    for (uint32_t index = 0U; index < memoryCount; ++index) {
        if (tags != nullptr && tags[index] != nullptr && std::strcmp(tags[index], MEMORY_TAG) == 0) {
            if (memories[index].size < requiredBytes) {
                std::fprintf(
                    stderr, "[ERROR] rank %u: remote memory size is insufficient, size=%llu required=%llu\n",
                    resources.rank, static_cast<unsigned long long>(memories[index].size),
                    static_cast<unsigned long long>(requiredBytes));
                return FAIL;
            }
            remoteAddress = reinterpret_cast<uint64_t>(memories[index].addr);
            found = true;
            break;
        }
    }
    if (!found && memoryCount == 1U) {
        remoteAddress = reinterpret_cast<uint64_t>(memories[0].addr);
        found = memories[0].size >= requiredBytes;
    }
    if (!found) {
        std::fprintf(
            stderr, "[ERROR] rank %u: remote communication buffer not found by tag %s\n", resources.rank, MEMORY_TAG);
        return FAIL;
    }
    return SUCCESS;
}

int32_t AcquireChannel(RankResources& resources, uint32_t peerRank)
{
    const uint32_t rank = resources.rank;
    uint32_t* layers = nullptr;
    uint32_t layerCount = 0U;
    CHECK_EQ(HcclRankGraphGetLayers(resources.comm, &layers, &layerCount), HCCL_SUCCESS);
    if (layers == nullptr || layerCount < 2U) {
        std::fprintf(stderr, "[ERROR] rank %u: rank graph layer 1 not found\n", resources.rank);
        return FAIL;
    }

    CommLink* links = nullptr;
    uint32_t linkCount = 0U;
    CHECK_EQ(
        HcclRankGraphGetLinks(
            resources.comm, layers[1], static_cast<uint32_t>(resources.rank), peerRank, &links, &linkCount),
        HCCL_SUCCESS);
    if (links == nullptr || linkCount == 0U) {
        std::fprintf(
            stderr, "[ERROR] rank %u: no link found from rank %u to rank %u\n", resources.rank, resources.rank,
            peerRank);
        return FAIL;
    }

    HcclMemHandle memHandles[1] = {resources.memHandle};
    HcclChannelDesc channelDesc{};
    CHECK_EQ(HcclChannelDescInit(&channelDesc, 1U), HCCL_SUCCESS);
    channelDesc.remoteRank = peerRank;
    channelDesc.channelProtocol = HOST_COMM_PROTOCOL;
    channelDesc.memHandles = memHandles;
    channelDesc.memHandleNum = 1U;

    bool linkFound = false;
    for (uint32_t index = 0U; index < linkCount; ++index) {
        if (links[index].linkAttr.linkProtocol != HOST_COMM_PROTOCOL) {
            continue;
        }
        channelDesc.localEndpoint = links[index].srcEndpointDesc;
        channelDesc.remoteEndpoint = links[index].dstEndpointDesc;
        linkFound = true;
        break;
    }
    if (!linkFound) {
        std::fprintf(stderr, "[ERROR] rank %u: no COMM_PROTOCOL_ROCE link to rank %u\n", resources.rank, peerRank);
        return FAIL;
    }

    CHECK_EQ(HcclChannelAcquire(resources.comm, COMM_ENGINE_AIV, &channelDesc, 1U, &resources.channel), HCCL_SUCCESS);
    if (resources.channel == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: HcclChannelAcquire returned a null channel\n", resources.rank);
        return FAIL;
    }

    CHECK_EQ(FindRemoteBuffer(resources, resources.channel, resources.remoteSendBuffer), SUCCESS);
    if (!IsAligned64(resources.remoteSendBuffer)) {
        std::fprintf(stderr, "[ERROR] rank %u: remote send memory base is not 64-byte aligned\n", resources.rank);
        return FAIL;
    }
    resources.remoteRecvBuffer = resources.remoteSendBuffer + GET_ROCE_ALIGNED_BYTES(resources.memoryBytes);
    if (!IsAligned64(resources.remoteRecvBuffer)) {
        std::fprintf(stderr, "[ERROR] rank %u: remote receive memory base is not 64-byte aligned\n", resources.rank);
        return FAIL;
    }
    return SUCCESS;
}

const char* KernelError(KernelResult result)
{
    switch (result) {
        case KERNEL_MAKE_HANDLE_FAILED:
            return "MakeBatchHandle failed";
        case KERNEL_ADDRESS_UNALIGNED:
            return "communication address is not 64-byte aligned";
        default:
            return "unknown kernel error";
    }
}

int32_t RunOneCase(RankResources& resources, uint32_t api, uint64_t dataSize, uint32_t batchSize)
{
    const uint32_t rank = resources.rank;

    if (resources.channel == 0U) {
        const uint32_t peerRank = (resources.rank + 1U) % resources.rankNum;
        CHECK_EQ(AcquireChannel(resources, peerRank), SUCCESS);
    }

    CHECK_EQ(
        aclrtMalloc(
            reinterpret_cast<void**>(&resources.deviceContext), sizeof(KernelContext), ACL_MEM_MALLOC_HUGE_FIRST),
        ACL_SUCCESS);
    KernelContext context{};
    context.channelHandle = static_cast<uint64_t>(resources.channel);
    context.localSendBuffer = reinterpret_cast<uint64_t>(resources.sendBuffer);
    context.localRecvBuffer = reinterpret_cast<uint64_t>(resources.recvBuffer);
    context.remoteSendBuffer = resources.remoteSendBuffer;
    context.remoteRecvBuffer = resources.remoteRecvBuffer;
    context.api = api;
    context.dataSize = static_cast<uint32_t>(dataSize);
    context.batchSize = batchSize;
    CHECK_EQ(
        aclrtMemcpy(resources.deviceContext, sizeof(context), &context, sizeof(context), ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS);

    const auto hostStart = std::chrono::steady_clock::now();
    LaunchHcommRoceBatchApiPerf(
        reinterpret_cast<void*>(resources.stream),
        static_cast<uint64_t>(reinterpret_cast<uintptr_t>(resources.deviceContext)));
    CHECK_EQ(aclrtSynchronizeStream(resources.stream), ACL_SUCCESS);
    const auto hostEnd = std::chrono::steady_clock::now();
    const double hostNanoseconds =
        std::chrono::duration_cast<std::chrono::duration<double, std::nano>>(hostEnd - hostStart).count();

    KernelContext result{};
    CHECK_EQ(
        aclrtMemcpy(&result, sizeof(result), resources.deviceContext, sizeof(result), ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS);
    if (result.result != KERNEL_SUCCESS) {
        std::fprintf(stderr, "[ERROR] rank %u: %s\n", resources.rank, KernelError(result.result));
        (void)aclrtFree(resources.deviceContext);
        resources.deviceContext = nullptr;
        return FAIL;
    }

    constexpr double cycleHz = 1000000000.0;
    constexpr double measuredRunCount = static_cast<double>(MEASURED_RUN_COUNT);
    const double issuePerRequestCycles =
        static_cast<double>(result.issueCycles) / measuredRunCount / static_cast<double>(batchSize);
    const double commitCycles = static_cast<double>(result.commitCycles) / measuredRunCount;
    const double drainCycles = static_cast<double>(result.drainCycles) / measuredRunCount;
    const double totalDeviceCycles = static_cast<double>(result.totalCycles) / measuredRunCount;
    const double totalBytes = static_cast<double>(dataSize) * static_cast<double>(batchSize);
    const double deviceSeconds = totalDeviceCycles / cycleHz;
    const double deviceGbps = totalBytes / deviceSeconds / 1000000000.0;

    std::printf(
        "PERF_DATA | Rank=%u | API=%s | DataBytes=%llu | BatchSize=%u | "
        "IssuePerRequest(Cycles)=%.3f | Commit(Cycles)=%.3f | Drain(Cycles)=%.3f | TotalDevice(Cycles)=%.3f | "
        "Host(Ns)=%.3f | DeviceGBps=%.3f\n",
        resources.rank, api == PERF_API_WRITE ? "WriteNbi" : "ReadNbi", static_cast<unsigned long long>(dataSize),
        batchSize, issuePerRequestCycles, commitCycles, drainCycles, totalDeviceCycles, hostNanoseconds, deviceGbps);

    (void)aclrtFree(resources.deviceContext);
    resources.deviceContext = nullptr;
    return SUCCESS;
}

int32_t ValidateBuffer(RankResources& resources, uint32_t peerRank, uint64_t dataSize, uint32_t batchSize)
{
    const uint64_t bytes = std::min(dataSize, VALIDATION_BYTES_PER_SLOT);
    std::vector<uint8_t> hostBuffer(static_cast<size_t>(bytes), 0U);
    for (uint32_t slot = 0U; slot < batchSize; ++slot) {
        const uint64_t slotOffset = static_cast<uint64_t>(slot) * GET_ROCE_SLOT_STRIDE(dataSize);
        CHECK_EQ(
            aclrtMemcpy(
                hostBuffer.data(), bytes, static_cast<uint8_t*>(resources.recvBuffer) + slotOffset, bytes,
                ACL_MEMCPY_DEVICE_TO_HOST),
            ACL_SUCCESS);
        for (uint32_t index = 0U; index < bytes; ++index) {
            const uint8_t expected = DataValue(peerRank, slotOffset + index);
            if (hostBuffer[index] != expected) {
                std::fprintf(
                    stderr, "[ERROR] rank %u: result mismatch at slot=%u byte=%u, actual=0x%02x expected=0x%02x\n",
                    resources.rank, slot, index, hostBuffer[index], expected);
                return FAIL;
            }
        }
    }
    return SUCCESS;
}

int32_t ClearReceiveSlots(RankResources& resources, uint64_t dataSize, uint32_t batchSize)
{
    const uint64_t slotStride = GET_ROCE_SLOT_STRIDE(dataSize);
    for (uint32_t slot = 0U; slot < batchSize; ++slot) {
        CHECK_EQ(
            aclrtMemset(
                static_cast<uint8_t*>(resources.recvBuffer) + static_cast<uint64_t>(slot) * slotStride, dataSize, 0,
                dataSize),
            ACL_SUCCESS);
    }
    return SUCCESS;
}

int32_t RunRank(uint32_t rank, uint32_t rankNum, const Arguments& args)
{
    RankResources resources(rank, rankNum);
    // Allocate once for the user-configured payload range. Smaller cases reuse the same registered memory.
    resources.memoryBytes = GET_ROCE_PAYLOAD_SPAN_BYTES(args.maxBytes, args.batchSize);
    CHECK_EQ(InitAcl(resources), SUCCESS);
    CHECK_EQ(InitCommunicator(resources), SUCCESS);
    // Allocate and register the maximum size once. Smaller cases reuse the same buffers.
    CHECK_EQ(PrepareMemory(resources), SUCCESS);

    bool allPass = true;
    for (uint64_t dataSize = args.minBytes; dataSize <= args.maxBytes; dataSize <<= 1U) {
        if (MPI_Barrier(MPI_COMM_WORLD) != MPI_SUCCESS) {
            std::fprintf(stderr, "[ERROR] rank %u: MPI_Barrier before cases failed\n", resources.rank);
            return FAIL;
        }
        if (args.api == PERF_API_READ) {
            CHECK_EQ(ClearReceiveSlots(resources, dataSize, args.batchSize), SUCCESS);
        }

        allPass = RunOneCase(resources, args.api, dataSize, args.batchSize) == SUCCESS && allPass;
        if (MPI_Barrier(MPI_COMM_WORLD) != MPI_SUCCESS) {
            std::fprintf(stderr, "[ERROR] rank %u: MPI_Barrier after case failed\n", resources.rank);
            return FAIL;
        }
        allPass = ValidateBuffer(resources, (rank + 1U) % rankNum, dataSize, args.batchSize) == SUCCESS && allPass;
        if (args.api == PERF_API_WRITE) {
            CHECK_EQ(ClearReceiveSlots(resources, dataSize, args.batchSize), SUCCESS);
        }
    }

    if (MPI_Barrier(MPI_COMM_WORLD) != MPI_SUCCESS) {
        std::fprintf(stderr, "[ERROR] rank %u: final MPI_Barrier failed\n", resources.rank);
        return FAIL;
    }
    return allPass ? SUCCESS : FAIL;
}

} // namespace

int main(int argc, char** argv)
{
    MpiSession mpiSession(&argc, &argv);
    if (!mpiSession.valid) {
        return FAIL;
    }

    int mpiRank = 0;
    int mpiRankNum = 0;
    if (MPI_Comm_rank(MPI_COMM_WORLD, &mpiRank) != MPI_SUCCESS ||
        MPI_Comm_size(MPI_COMM_WORLD, &mpiRankNum) != MPI_SUCCESS) {
        std::fprintf(stderr, "[ERROR] MPI_Comm_rank/MPI_Comm_size failed\n");
        return FAIL;
    }

    const Arguments args = ParseArguments(argc, argv);
    if (!args.valid) {
        if (mpiRank == 0) {
            std::fprintf(
                stderr, "Usage: mpirun -np <2..N> %s [--batch-size N] [--min-bytes N] [--max-bytes N]\n", argv[0]);
        }
        return FAIL;
    }

    if (mpiRankNum < 2) {
        if (mpiRank == 0) {
            std::fprintf(stderr, "Usage: mpirun -np <2..N> %s\n", argv[0]);
        }
        return FAIL;
    }

    const int localResult = RunRank(static_cast<uint32_t>(mpiRank), static_cast<uint32_t>(mpiRankNum), args);
    int globalResult = FAIL;
    if (MPI_Allreduce(&localResult, &globalResult, 1, MPI_INT, MPI_MIN, MPI_COMM_WORLD) != MPI_SUCCESS) {
        std::fprintf(stderr, "[ERROR] rank %d: MPI_Allreduce failed\n", mpiRank);
        return FAIL;
    }

    if (mpiRank == 0) {
        std::printf(
            "RESULT | Example=hcomm_roce_batch_api_perf | Status=%s\n", globalResult == SUCCESS ? "PASS" : "FAIL");
    }
    return globalResult == SUCCESS ? SUCCESS : 1;
}
