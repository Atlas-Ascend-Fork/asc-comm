// 将 ACL/HCCL/HCOMM 返回码统一转为异常，并保留失败调用名称；宏实参只求值一次。
template <typename Status>
void check(Status status, const char* expression)
{
    if (static_cast<int64_t>(status) != 0) {
        throw std::runtime_error(std::string(expression) + " returned " + std::to_string(status));
    }
}
#define CHECK_CALL(expr) check((expr), #expr)

// 检查 Host 协议和校验条件，失败后由进程管理器汇总为整个用例失败。
void require(bool pass, const char* message)
{
    if (!pass) {
        throw std::runtime_error(message);
    }
}

// 单个 rank 独占的资源。A/gathered 注册为通信 window，B/C 是本地计算内存。
// 按已成功创建的成员清理，支持初始化途中失败，也允许显式 close 后再析构。
struct rank_resources {
    uint32_t device;
    bool acl = false, device_set = false;
    aclrtStream stream = nullptr;
    aclrtEvent start = nullptr, end = nullptr;
    HcclComm comm = nullptr;
    HcommTeamHandle team = nullptr;
    HcclCommSymWindow src_win = nullptr, dst_win = nullptr;
    void *a = nullptr, *gathered = nullptr, *b = nullptr, *c = nullptr, *trace = nullptr;
    bool failed_cleanup = false;

    // 清理阶段不抛异常，记录失败并继续释放其他资源；正常返回路径据此给出失败退出码。
    void record(int64_t status)
    {
        if (status != 0) {
            failed_cleanup = true;
            std::fprintf(stderr, "cleanup failed: %lld\n", static_cast<long long>(status));
        }
    }
    // 先等待设备工作结束，再拆 team/window，最后释放内存、通信域和 ACL 环境。
    void close()
    {
        if (stream) {
            record(aclrtSynchronizeStream(stream));
        }
        if (team) {
            record(HcclTeamDestroy(team));
            team = nullptr;
        }
        if (dst_win) {
            record(HcclCommSymWinDeregister(dst_win));
            dst_win = nullptr;
        }
        if (src_win) {
            record(HcclCommSymWinDeregister(src_win));
            src_win = nullptr;
        }
        if (a) {
            record(HcommMemFree(a));
            a = nullptr;
        }
        if (gathered) {
            record(HcommMemFree(gathered));
            gathered = nullptr;
        }
        if (b) {
            record(aclrtFree(b));
            b = nullptr;
        }
        if (c) {
            record(aclrtFree(c));
            c = nullptr;
        }
        if (trace) {
            record(aclrtFree(trace));
            trace = nullptr;
        }
        if (comm) {
            record(HcclCommDestroy(comm));
            comm = nullptr;
        }
        if (start) {
            record(aclrtDestroyEvent(start));
            start = nullptr;
        }
        if (end) {
            record(aclrtDestroyEvent(end));
            end = nullptr;
        }
        if (stream) {
            record(aclrtDestroyStream(stream));
            stream = nullptr;
        }
        if (device_set) {
            record(aclrtResetDevice(device));
            device_set = false;
        }
        if (acl) {
            record(aclFinalize());
            acl = false;
        }
    }
    ~rank_resources() { close(); }
};

// 绑定 rank 对应的 ACL device，建立 HCCL 域，再创建供 AIV/UB_CTP 使用的对称 window 和 team。
void initialize(rank_resources& r, examples::rank_sync_context& sync, const options& o, uint32_t rank)
{
    CHECK_CALL(aclInit(nullptr));
    r.acl = true;
    uint32_t count = 0;
    CHECK_CALL(aclrtGetDeviceCount(&count));
    for (auto id : o.devices) {
        require(id < count, "requested ACL device ID is unavailable");
    }
    CHECK_CALL(aclrtSetDevice(r.device));
    r.device_set = true;
    CHECK_CALL(aclrtCreateStream(&r.stream));
    CHECK_CALL(aclrtCreateEvent(&r.start));
    CHECK_CALL(aclrtCreateEvent(&r.end));
    CHECK_CALL(examples::init_comm_by_root_info(sync, &r.comm));
    // A:[M,K]，gathered:[P,M,K]，B:[K,N]，C:[P*M,N]；FP16/BF16 均按 2 字节分配。
    const uint64_t a_bytes = static_cast<uint64_t>(o.m) * o.k * 2;
    CHECK_CALL(HcommMemAlloc(&r.a, a_bytes));
    CHECK_CALL(HcommMemAlloc(&r.gathered, a_bytes * o.ranks));
    CHECK_CALL(aclrtMalloc(&r.b, static_cast<uint64_t>(o.k) * o.n * 2, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_CALL(aclrtMalloc(&r.c, static_cast<uint64_t>(o.ranks) * o.m * o.n * 2, ACL_MEM_MALLOC_HUGE_FIRST));
    // 各 rank 以相同顺序、相同大小注册 window，AIN 通过 window 和 peer 定位远端内存。
    CHECK_CALL(HcclCommSymWinRegister(r.comm, r.a, a_bytes, &r.src_win, 1));
    CHECK_CALL(HcclCommSymWinRegister(r.comm, r.gathered, a_bytes * o.ranks, &r.dst_win, 1));
    HcclTeamCreateDesc desc;
    CHECK_CALL(HcclTeamCreateDescInit(&desc));
    std::vector<uint32_t> ids(o.ranks);
    for (uint32_t i = 0; i < o.ranks; ++i) {
        ids[i] = i;
    }
    desc.rankIds = ids.data();
    desc.rankNum = o.ranks;
    desc.selfRankId = rank;
    desc.netLayer = 0;
    desc.requirement.barrierCount = 1;
    desc.engine = COMM_ENGINE_AIV;
    desc.protocol = COMM_PROTOCOL_UB_CTP;
    // 每个 peer 使用一条 channel；kernel 按 peer 分配唯一 AIV owner，避免多核竞争同一 channel。
    desc.channelCnt = 1;
    CHECK_CALL(HcclTeamCreate(r.comm, &desc, &r.team));
}

// 根据 rank/坐标/seed 生成可复现输入；各 rank 的 B 可以不同。
// 默认 K 周期为 16，便于大 shape 全量校验；random 模式逐 K 生成，仅适合较小测试。
void fill_inputs(rank_resources& r, const options& o, uint32_t rank, uint32_t seed, bool fill_gathered)
{
    std::vector<uint16_t> a(static_cast<uint64_t>(o.m) * o.k);
    std::vector<uint16_t> b(static_cast<uint64_t>(o.k) * o.n);
    auto fill_a = [&](uint32_t peer) {
        for (uint32_t m = 0; m < o.m; ++m) {
            for (uint32_t k = 0; k < o.k; ++k) {
                a[static_cast<uint64_t>(m) * o.k + k] =
                    encode(input_value(peer, m, o.random ? k : k % 16, seed, false), o.bf16);
            }
        }
    };
    fill_a(rank);
    CHECK_CALL(aclrtMemcpy(r.a, a.size() * 2, a.data(), a.size() * 2, ACL_MEMCPY_HOST_TO_DEVICE));
    for (uint32_t k = 0; k < o.k; ++k) {
        for (uint32_t n = 0; n < o.n; ++n) {
            b[static_cast<uint64_t>(k) * o.n + n] =
                encode(input_value(rank, o.random ? k : k % 16, n, seed, true), o.bf16);
        }
    }
    CHECK_CALL(aclrtMemcpy(r.b, b.size() * 2, b.data(), b.size() * 2, ACL_MEMCPY_HOST_TO_DEVICE));
    // 独立 matmul 模式没有通信，由 Host 预填所有 peer 的 A，隔离计算侧问题。
    if (fill_gathered) {
        for (uint32_t peer = 0; peer < o.ranks; ++peer) {
            fill_a(peer);
            auto dst = static_cast<uint8_t*>(r.gathered) + peer * a.size() * 2;
            CHECK_CALL(aclrtMemcpy(dst, a.size() * 2, a.data(), a.size() * 2, ACL_MEMCPY_HOST_TO_DEVICE));
        }
    }
}

// 按模式向同一 stream 提交工作；serial/hccl 的通信排在计算前，融合模式只启动一个 MIX kernel。
template <typename T>
void launch(rank_resources& r, const options& o, const tiling& t, uint32_t rank, const std::string& mode, bool trace)
{
    auto a = static_cast<uint8_t*>(r.a);
    auto g = static_cast<uint8_t*>(r.gathered);
    auto b = static_cast<uint8_t*>(r.b);
    auto c = static_cast<uint8_t*>(r.c);
    auto team = reinterpret_cast<uint8_t*>(r.team);
    auto src_win = reinterpret_cast<uint8_t*>(r.src_win);
    auto dst_win = reinterpret_cast<uint8_t*>(r.dst_win);
    if (mode == "fused") {
        if (trace) {
            fused_kernel<T, true><<<t.cores, nullptr, r.stream>>>(
                team, src_win, dst_win, a, g, b, c, t, rank, static_cast<uint8_t*>(r.trace));
        } else {
            fused_kernel<T><<<t.cores, nullptr, r.stream>>>(team, src_win, dst_win, a, g, b, c, t, rank, nullptr);
        }
        return;
    }
    if (mode == "serial" || mode == "comm") {
        gather_kernel<<<t.cores, nullptr, r.stream>>>(team, src_win, dst_win, t, rank);
    } else if (mode == "hccl") {
        CHECK_CALL(HcclAllGather(
            r.a, r.gathered, static_cast<uint64_t>(o.m) * o.k, o.bf16 ? HCCL_DATA_TYPE_BFP16 : HCCL_DATA_TYPE_FP16,
            r.comm, r.stream));
    }
    if (mode != "comm") {
        matmul_kernel<T><<<t.cores, nullptr, r.stream>>>(a, g, b, c, t, rank);
    }
}

// 通信结果按位比对，矩阵输出与 CPU golden 全元素比较；golden 先舍入到输出 dtype。
// comm 只验接收 A，matmul 只验 C，其余模式两者都验；非有限值直接失败。
void verify(rank_resources& r, const options& o, uint32_t rank, uint32_t seed, const std::string& mode)
{
    uint64_t failures = 0;
    if (mode != "matmul") {
        std::vector<uint16_t> a(static_cast<uint64_t>(o.m) * o.k);
        for (uint32_t peer = 0; peer < o.ranks; ++peer) {
            if (peer == rank) {
                continue;
            } // Get 不填自身槽，本地 matmul 直接读原始 A。
            auto src = static_cast<uint8_t*>(r.gathered) + peer * a.size() * 2;
            CHECK_CALL(aclrtMemcpy(a.data(), a.size() * 2, src, a.size() * 2, ACL_MEMCPY_DEVICE_TO_HOST));
            for (uint32_t m = 0; m < o.m; ++m) {
                for (uint32_t k = 0; k < o.k; ++k) {
                    const auto expected = encode(input_value(peer, m, o.random ? k : k % 16, seed, false), o.bf16);
                    if (a[static_cast<uint64_t>(m) * o.k + k] != expected) {
                        ++failures;
                    }
                }
            }
        }
    }
    if (mode != "comm") {
        std::vector<uint16_t> c(static_cast<uint64_t>(o.ranks) * o.m * o.n);
        CHECK_CALL(aclrtMemcpy(c.data(), c.size() * 2, r.c, c.size() * 2, ACL_MEMCPY_DEVICE_TO_HOST));
        for (uint32_t peer = 0; peer < o.ranks; ++peer) {
            for (uint32_t m = 0; m < o.m; ++m) {
                for (uint32_t n = 0; n < o.n; ++n) {
                    const uint64_t offset = (static_cast<uint64_t>(peer) * o.m + m) * o.n + n;
                    const float expected =
                        decode(encode(golden(peer, rank, m, n, o.k, seed, o.random), o.bf16), o.bf16);
                    const float actual = decode(c[offset], o.bf16);
                    const float tolerance = (o.bf16 ? 0.008F : 0.001F) * std::fabs(expected) + 0.001F;
                    if (!std::isfinite(actual) || !std::isfinite(expected) ||
                        std::fabs(actual - expected) > tolerance) {
                        if (failures < 4) {
                            std::fprintf(
                                stderr, "rank=%u source=%u row=%u col=%u got=%g expected=%g\n", rank, peer, m, n,
                                actual, expected);
                        }
                        ++failures;
                    }
                }
            }
        }
    }
    std::printf(
        "CHECK rank=%u mode=%s seed=%u errors=%llu\n", rank, mode.c_str(), seed,
        static_cast<unsigned long long>(failures));
    require(failures == 0, "numerical or gathered-data verification failed");
}

// 执行一次并返回所有 rank 中最大的 device event 耗时（us）；输入准备/CPU 校验在调用外。
float run_once(
    rank_resources& r, examples::rank_sync_context& sync, const options& o, const tiling& t, uint32_t rank,
    const std::string& mode, bool trace = false, float* launch_skew = nullptr)
{
    // 各 rank 先完成输入准备再启动；结束后的 Allgather 确认所有 rank 已完成读取。
    // 这两个同步共同保护远端 A 的生命周期，防止快 rank 提前更新输入或释放 window。
    require(sync.barrier(examples::TAG_USER_BASE), "pre-launch barrier failed");
    if (rank == o.delay_rank) {
        std::this_thread::sleep_for(std::chrono::milliseconds(o.delay_ms));
    }
    struct sample {
        int64_t host_ns;
        float ms;
    };
    sample current_sample{};
    current_sample.host_ns =
        std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
            .count();
    // event 包住通信与计算提交；TCP 同步调用本身在外，但 rank 启动偏斜仍可能进入 collective 等待。
    CHECK_CALL(aclrtRecordEvent(r.start, r.stream));
    if (o.bf16) {
        launch<bfloat16_t>(r, o, t, rank, mode, trace);
    } else {
        launch<half>(r, o, t, rank, mode, trace);
    }
    CHECK_CALL(aclrtRecordEvent(r.end, r.stream));
    CHECK_CALL(aclrtSynchronizeStream(r.stream));
    CHECK_CALL(aclrtEventElapsedTime(&current_sample.ms, r.start, r.end));
    require(std::isfinite(current_sample.ms) && current_sample.ms > 0, "invalid event duration");
    std::vector<sample> all(o.ranks);
    require(
        sync.allgather(examples::TAG_USER_BASE + 1, &current_sample, sizeof(current_sample), all.data()),
        "timing allgather failed");
    float max_ms = 0;
    int64_t first = current_sample.host_ns, last = current_sample.host_ns;
    for (const auto& s : all) {
        max_ms = std::max(max_ms, s.ms);
        first = std::min(first, s.host_ns);
        last = std::max(last, s.host_ns);
    }
    // 本示例所有 rank 在同一 Host 上 fork，共享单调时钟；这里只量 Host 提交偏斜，
    // 不代表设备 kernel 启动偏斜，也不从 event 耗时中直接扣除。
    if (launch_skew) {
        *launch_skew = static_cast<float>(last - first) / 1000;
    }
    return max_ms * 1000;
}

// 额外运行一次采样版本，拷回并打印 AIV0/AIC0 的阶段区间；该次耗时不进入稳态统计。
void trace_once(rank_resources& r, examples::rank_sync_context& sync, const options& o, const tiling& t, uint32_t rank)
{
    // 布局与 kernel 的 trace_base 一致：Get 区、对齐填充、本地计算起止、各轮远端计算起止。
    const uint64_t base = ceil_div(static_cast<uint64_t>(t.rounds) * 2, 32) * 32;
    std::vector<uint64_t> ticks(base + 2 + static_cast<uint64_t>(t.rounds) * 2);
    CHECK_CALL(aclrtMalloc(&r.trace, ticks.size() * sizeof(uint64_t), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_CALL(aclrtMemset(r.trace, ticks.size() * sizeof(uint64_t), 0, ticks.size() * sizeof(uint64_t)));
    (void)run_once(r, sync, o, t, rank, "fused", true);
    CHECK_CALL(aclrtMemcpy(
        ticks.data(), ticks.size() * sizeof(uint64_t), r.trace, ticks.size() * sizeof(uint64_t),
        ACL_MEMCPY_DEVICE_TO_HOST));
    auto print = [&](const char* stage, uint32_t round, uint64_t index) {
        require(ticks[index] != 0 && ticks[index + 1] >= ticks[index], "invalid diagnostic timestamps");
        std::printf(
            "TRACE rank=%u core=0 stage=%s round=%u begin_cycle=%llu end_cycle=%llu\n", rank, stage, round,
            static_cast<unsigned long long>(ticks[index]), static_cast<unsigned long long>(ticks[index + 1]));
    };
    print("local_matmul", 0, base);
    for (uint32_t j = 0; j < t.rounds; ++j) {
        print("get", j, static_cast<uint64_t>(j) * 2);
        print("remote_matmul", j, base + 2 + static_cast<uint64_t>(j) * 2);
    }
    verify(r, o, rank, o.verify_iterations, "fused");
    CHECK_CALL(aclrtFree(r.trace));
    r.trace = nullptr;
}

// 单个子进程的完整流程：控制连接 -> 建域/分配 -> 校验 -> 可选采样 -> 预热/测量 -> 释放。
int run_rank(uint32_t rank, options o)
{
    // rank 是通信域内编号，devices[rank] 是 ACL device ID；两者不能混用。
    rank_resources r{o.devices[rank]};
    auto sync = rank == 0 ? examples::rank_sync_context::make_listen(o.endpoint, o.ranks) :
                            examples::rank_sync_context::make_connect(rank, o.ranks, o.endpoint);
    require(sync.ok(), "control channel initialization failed");
    initialize(r, sync, o, rank);
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    require(platform != nullptr, "platform query failed");
    const uint32_t available_cores = platform->GetCoreNumAic();
    require(o.cores == 0 || o.cores <= available_cores, "cores exceeds device AIC count");
    const tiling t = make_tiling(o.m, o.n, o.k, o.ranks, o.cores ? o.cores : available_cores, o.tile_m);
    std::printf(
        "CONFIG rank=%u device=%u M=%u K=%u N=%u dtype=%s cores=%u tile_m=%u rounds=%u\n", rank, r.device, t.m, t.k,
        t.n, o.bf16 ? "bf16" : "fp16", t.cores, t.tile_m, t.rounds);
    const std::vector<std::string> modes =
        o.mode == "both" ? std::vector<std::string>{"serial", "fused"} : std::vector<std::string>{o.mode};
    for (const auto& mode : modes) {
        // 保持同一套 window/team，改变 seed 后再次调用，不重建 channel 或额外重置 flag。
        // 用不同输入检查陈旧数据/通知；输出先填为非有限值，便于发现漏写。
        for (uint32_t v = 0; v < o.verify_iterations; ++v) {
            fill_inputs(r, o, rank, v + 1, mode == "matmul");
            const uint64_t c_bytes = static_cast<uint64_t>(o.ranks) * o.m * o.n * 2;
            CHECK_CALL(aclrtMemset(r.c, c_bytes, 0xff, c_bytes));
            (void)run_once(r, sync, o, t, rank, mode);
            verify(r, o, rank, v + 1, mode);
        }
        if (o.trace && mode == "fused") {
            trace_once(r, sync, o, t, rank);
        }
        for (uint32_t i = 0; i < o.warmup; ++i) {
            (void)run_once(r, sync, o, t, rank, mode);
        }
        std::vector<float> times;
        std::vector<float> skews;
        for (uint32_t i = 0; i < o.iterations; ++i) {
            float skew = 0;
            times.push_back(run_once(r, sync, o, t, rank, mode, false, &skew));
            skews.push_back(skew);
        }
        verify(r, o, rank, o.verify_iterations, mode);
        // 先逐轮取最大 rank 耗时，再统计 median/P95，不能先算各 rank 均值后取最大。
        if (rank == 0) {
            std::sort(times.begin(), times.end());
            std::sort(skews.begin(), skews.end());
            const float median = (times[(times.size() - 1) / 2] + times[times.size() / 2]) / 2;
            const size_t p95 = static_cast<size_t>(std::ceil(times.size() * 0.95)) - 1;
            std::printf(
                "PERF mode=%s ranks=%u M=%u K=%u N=%u dtype=%s tile_m=%u samples=%u "
                "max_rank_median_us=%.3f max_rank_p95_us=%.3f host_submit_skew_p95_us=%.3f\n",
                mode.c_str(), o.ranks, t.m, t.k, t.n, o.bf16 ? "bf16" : "fp16", t.tile_m, o.iterations, median,
                times[p95], skews[p95]);
        }
        require(sync.barrier(examples::TAG_USER_BASE + 2), "post-verification barrier failed");
    }
    r.close();
    return r.failed_cleanup ? 1 : 0;
}
} // namespace ain_agmm

// 父进程解析参数并 fork 各 rank，统一管理超时和退出状态；任一 rank 失败则整组失败。
int main(int argc, char** argv)
{
    try {
        const auto options = ain_agmm::parse_options(argc, argv);
        std::vector<examples::args_of<decltype(ain_agmm::run_rank)>> args;
        for (uint32_t rank = 0; rank < options.ranks; ++rank) {
            args.emplace_back(rank, options);
        }
        examples::process_group_options group_options;
        group_options.timeout_seconds = options.timeout;
        examples::process_group group(group_options);
        if (!group.launch(options.ranks, ain_agmm::run_rank, std::move(args))) {
            return 1;
        }
        const bool pass = group.wait_all();
        std::printf("RESULT | Example=ain_all_gather_matmul | Status=%s\n", pass ? "PASS" : "FAIL");
        return pass ? 0 : 1;
    } catch (const std::exception& e) {
        std::fprintf(stderr, "%s\n", e.what());
        return 1;
    }
}
