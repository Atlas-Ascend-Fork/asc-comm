/*!
 * \file basic_ring.asc
 * \brief AIN basic ring 样例.
 */

#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "hccl/hccl.h"
#include "hccl/hccl_comm.h"
#include "hccl/hccl_types.h"
#include "hccl/hccl_team.h"
#include "hcomm/hcomm_res.h"
#include "kernel_operator.h"
#include "ain/ain.h"

#include "utils/process_manager.h"
#include "utils/check.h"
#include "utils/hccl_comm_init.h"
#include "utils/rank_sync.h"
#include "utils/arg_parser.h"

namespace {

constexpr size_t COMM_BUF_SIZE = 2U * 1024U * 1024U;
constexpr uint32_t ASCCOMM_BUF_SIZE = 512;

} // namespace

// 设备侧环形拓扑读写：向环上next节点写数据（put）、从prev节点读数据（get）。
extern "C" [[bisheng::core_ratio(0, 1)]] __global__ __aicore__ void basic_ring_kernel(
    __gm__ void* ain_team, __gm__ void* send_window, __gm__ void* recv_window, int32_t rank_num, int32_t rank_id)
{
    // ain需要一块UB工作区暂存通信任务信息。
    __ubuf__ uint8_t asccomm_ubuf_data[ASCCOMM_BUF_SIZE];
    asc::ain_descriptor_ubuf asccomm_ubuf{asccomm_ubuf_data, ASCCOMM_BUF_SIZE, 0U};

    // 0是通信上下文索引，用于隔离通信资源，本样例只用一个通信上下文。
    asc::ain ain(0);

    // 环形拓扑结构：next是下一个rank，prev是上一个rank。
    uint32_t next = static_cast<uint32_t>((rank_id + 1) % rank_num);
    uint32_t prev = static_cast<uint32_t>((rank_id + rank_num - 1) % rank_num);

    // 从本端send_window写1字节数据到next节点的recv_window，写入地址偏移对应本端的rank_id。
    ain.put(
        ain_team, next, recv_window, static_cast<uint64_t>(rank_id), send_window, 0U, 1U, asc::ain_remote_none{},
        asccomm_ubuf);
    // flush阻塞直至put任务完成。
    ain.flush(ain_team);

    // 从prev节点的send_window读1字节数据到本端recv_window，读入地址偏移为rank_num + rank_id，rank_num用于与put段错开互不覆盖。
    uint64_t get_dst_offset = static_cast<uint64_t>(rank_num + rank_id);
    ain.get(ain_team, prev, recv_window, get_dst_offset, send_window, 0U, 1U, asccomm_ubuf);
    // flush阻塞直至get任务完成。
    ain.flush(ain_team);

    // 屏障同步资源索引0，与通信上下文索引号一致。
    asc::ain_barrier_session ain_barrier(&ain, ain_team, 0U);
    // team级屏障同步，阻塞直至环形拓扑上的所有节点都读写完成。
    ain_barrier.sync(asc::AIN_MEMORY_ORDER_RELAX, asccomm_ubuf);
}

int32_t run_basic_ring_rank(uint32_t rank, uint32_t nranks, const std::string& ctrl_endpoint);

int32_t main(int32_t argc, char* argv[])
{
    if (argc != 3) {
        std::fprintf(stderr, "Usage: %s <tcp://ip:port> <nranks>\n", argv[0]);
        return 1;
    }
    uint32_t nranks = 0;
    if (!examples::parse_uint32(argv[2], nranks, 2)) {
        std::fprintf(stderr, "invalid nranks: %s, expected an integer >= 2\n", argv[2]);
        return 1;
    }
    const std::string endpoint = argv[1];

    std::vector<examples::args_of<decltype(run_basic_ring_rank)>> per_rank_args;
    per_rank_args.reserve(nranks);
    for (uint32_t rank = 0; rank < nranks; ++rank) {
        per_rank_args.emplace_back(rank, nranks, endpoint);
    }

    examples::process_group group;
    if (!group.launch(nranks, run_basic_ring_rank, std::move(per_rank_args))) {
        return 1;
    }
    const bool pass = group.wait_all();

    if (group.interrupted()) {
        std::cout << "RESULT | Example=basic_ring | Status=INTERRUPTED" << std::endl;
        return 1;
    }
    std::cout << "RESULT | Example=basic_ring | Status=" << (pass ? "PASS" : "FAIL") << std::endl;
    return pass ? 0 : 1;
}

// 单个rank的完整流程。由process_group在每个子进程中调用。
int32_t run_basic_ring_rank(uint32_t rank, uint32_t nranks, const std::string& ctrl_endpoint)
{
    examples::rank_sync_context sync = rank == 0U ?
                                           examples::rank_sync_context::make_listen(ctrl_endpoint, nranks) :
                                           examples::rank_sync_context::make_connect(rank, nranks, ctrl_endpoint);
    if (!sync.ok()) {
        std::cout << "[rank " << rank << "] control channel setup failed" << std::endl;
        return 1;
    }

    EXAMPLES_ACLCHECK(aclInit(nullptr));
    uint32_t dev_count = 0;
    EXAMPLES_ACLCHECK(aclrtGetDeviceCount(&dev_count));
    EXAMPLES_ACLCHECK(aclrtSetDevice(static_cast<uint32_t>(rank)));
    aclrtStream stream = nullptr;
    EXAMPLES_ACLCHECK(aclrtCreateStream(&stream));

    HcclComm hccl_comm = nullptr;
    // 创建通信域
    EXAMPLES_HCCLCHECK(examples::init_comm_by_root_info(sync, &hccl_comm));

    // 初始化本地数据
    void* send_buf = nullptr;
    EXAMPLES_HCOMMCHECK(HcommMemAlloc(&send_buf, COMM_BUF_SIZE));
    std::vector<int8_t> send_host(COMM_BUF_SIZE, static_cast<int8_t>(rank));
    EXAMPLES_ACLCHECK(aclrtMemcpy(send_buf, COMM_BUF_SIZE, send_host.data(), COMM_BUF_SIZE, ACL_MEMCPY_HOST_TO_DEVICE));

    void* recv_buf = nullptr;
    EXAMPLES_HCOMMCHECK(HcommMemAlloc(&recv_buf, COMM_BUF_SIZE));
    EXAMPLES_ACLCHECK(aclrtMemset(recv_buf, COMM_BUF_SIZE, 0, COMM_BUF_SIZE));

    // 将本地内存注册为window
    HcclCommSymWindow send_win{nullptr};
    EXAMPLES_HCCLCHECK(HcclCommSymWinRegister(hccl_comm, send_buf, COMM_BUF_SIZE, &send_win, 1));

    HcclCommSymWindow recv_win{nullptr};
    EXAMPLES_HCCLCHECK(HcclCommSymWinRegister(hccl_comm, recv_buf, COMM_BUF_SIZE, &recv_win, 1));

    // 创建team
    HcclTeamCreateDesc desc;
    EXAMPLES_HCCLCHECK(HcclTeamCreateDescInit(&desc));
    std::vector<uint32_t> world_rank_ids;
    for (uint32_t idx = 0; idx < nranks; idx++) {
        world_rank_ids.emplace_back(idx);
    }
    desc.rankIds = world_rank_ids.data();
    desc.rankNum = nranks;
    desc.selfRankId = rank;
    desc.netLayer = 0;
    // 设备侧ain_barrier_session按索引取用barrier资源，本样例只用一个屏障。
    desc.requirement.barrierCount = 1;
    desc.engine = COMM_ENGINE_AIV;
    desc.protocol = COMM_PROTOCOL_UB_CTP;
    desc.channelCnt = 1;
    HcommTeamHandle team{nullptr};
    EXAMPLES_HCCLCHECK(HcclTeamCreate(hccl_comm, &desc, &team));

    // 下发通信kernel：kernel内完成环形拓扑读写。
    basic_ring_kernel<<<1U, nullptr, stream>>>(team, send_win, recv_win, nranks, rank);
    EXAMPLES_ACLCHECK(aclrtSynchronizeStream(stream));

    // recv_buf结果校验：[0, rank_num)接收prev写入的数据（put）；[rank_num, 2*rank_num)：存放读取prev的数据（get）。两段都应等于prev的rank值。
    int32_t prev = (rank - 1 + nranks) % nranks;
    int32_t get_offset = nranks + rank;
    int8_t* test_buf = nullptr;
    EXAMPLES_ACLCHECK(aclrtMallocHost(reinterpret_cast<void**>(&test_buf), COMM_BUF_SIZE));
    EXAMPLES_ACLCHECK(aclrtMemcpy(test_buf, COMM_BUF_SIZE, recv_buf, COMM_BUF_SIZE, ACL_MEMCPY_DEVICE_TO_HOST));
    bool pass = test_buf[prev] == static_cast<int8_t>(prev) && test_buf[get_offset] == static_cast<int8_t>(prev);
    std::cout << "[rank " << rank << "] basic_ring | PUT recv_buf[" << prev
              << "]=" << static_cast<int32_t>(test_buf[prev]) << ", GET recv_buf[" << get_offset
              << "]=" << static_cast<int32_t>(test_buf[get_offset]) << " | " << (pass ? "PASS" : "FAIL") << std::endl;

    // 销毁通信资源
    // 销毁team
    EXAMPLES_HCCLCHECK(HcclTeamDestroy(team));
    // 注销window
    EXAMPLES_HCCLCHECK(HcclCommSymWinDeregister(recv_win));
    EXAMPLES_HCCLCHECK(HcclCommSymWinDeregister(send_win));
    // 释放申请的内存
    EXAMPLES_ACLCHECK(aclrtFreeHost(test_buf));
    EXAMPLES_HCOMMCHECK(HcommMemFree(send_buf));
    EXAMPLES_HCOMMCHECK(HcommMemFree(recv_buf));
    // 销毁通信域
    EXAMPLES_HCCLCHECK(HcclCommDestroy(hccl_comm));
    // 去初始化
    EXAMPLES_ACLCHECK(aclrtDestroyStream(stream));
    EXAMPLES_ACLCHECK(aclrtResetDevice(static_cast<uint32_t>(rank)));
    EXAMPLES_ACLCHECK(aclFinalize());

    return pass ? 0 : 1;
}
