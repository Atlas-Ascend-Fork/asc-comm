/*!
 * \file basic_ring.asc
 * \brief AIN basic ring 样例.
 */

#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "hccl/hccl.h"
#include "hccl/hccl_comm.h"
#include "hccl/hccl_types.h"
#include "hccl/hccl_team.h"
#include "hcomm/hcomm_res.h"
#include "kernel_operator.h"
#include "ain/ain.h"

#include "utils/process_manager.h"
#include "utils/check.h"
#include "utils/hccl_comm_init.h"
#include "utils/rank_sync.h"
#include "utils/arg_parser.h"

namespace {

constexpr size_t COMM_BUF_SIZE = 2U * 1024U * 1024U;

} // namespace

extern "C" [[bisheng::core_ratio(0, 1)]] __global__ __aicore__ void basic_ring_kernel(
    __gm__ void* ainTeam, __gm__ void* sendWindow, __gm__ void* recvWindow, int32_t rankNum, int32_t rankId)
{
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECOUT> hcommBuf;
    pipe.InitBuffer(hcommBuf, AscendC::HCOMM_URMA_TMP_BUF_SIZE);
    AscendC::LocalTensor<uint8_t> hcommLocal = hcommBuf.Get<uint8_t>();
    AscendC::AinDescriptorUbuf hcommUbuf{
        reinterpret_cast<__ubuf__ uint8_t*>(hcommLocal.GetPhyAddr()), AscendC::HCOMM_URMA_TMP_BUF_SIZE, 0U};

    AscendC::Ain ain(0);
    uint32_t peer = static_cast<uint32_t>((rankId + 1) % rankNum);
    uint32_t prev = static_cast<uint32_t>((rankId + rankNum - 1) % rankNum);

    ain.Put(
        ainTeam, peer, recvWindow, static_cast<uint64_t>(rankId), sendWindow, 0U, 1U, AscendC::AinRemoteNone{},
        hcommUbuf);
    ain.Flush(ainTeam);

    uint64_t getDstOffset = static_cast<uint64_t>(rankNum + rankId);
    ain.Get(ainTeam, prev, recvWindow, getDstOffset, sendWindow, 0U, 1U, hcommUbuf);
    ain.Flush(ainTeam);

    AscendC::AinBarrierSession ainBarrier(&ain, ainTeam, 0U);
    ainBarrier.Sync(AscendC::AinMemoryOrder::AIN_MEMORY_ORDER_RELAX, hcommUbuf);
}

int32_t RunBasicRingRank(uint32_t rank, uint32_t nranks, const std::string& ctrlEndpoint);

int32_t main(int32_t argc, char* argv[])
{
    if (argc != 3) {
        std::fprintf(stderr, "Usage: %s <tcp://ip:port> <nranks>\n", argv[0]);
        return 1;
    }
    uint32_t nranks = 0;
    if (!examples::ParseUint32(argv[2], nranks, 2)) {
        std::fprintf(stderr, "invalid nranks: %s, expected an integer >= 2\n", argv[2]);
        return 1;
    }
    const std::string endpoint = argv[1];

    std::vector<examples::ArgsOf<decltype(RunBasicRingRank)>> perRankArgs;
    perRankArgs.reserve(nranks);
    for (uint32_t rank = 0; rank < nranks; ++rank) {
        perRankArgs.emplace_back(rank, nranks, endpoint);
    }

    examples::ProcessGroup group;
    if (!group.Launch(nranks, RunBasicRingRank, std::move(perRankArgs))) {
        return 1;
    }
    const bool pass = group.WaitAll();

    if (group.Interrupted()) {
        std::cout << "RESULT | Example=basic_ring | Status=INTERRUPTED" << std::endl;
        return 1;
    }
    std::cout << "RESULT | Example=basic_ring | Status=" << (pass ? "PASS" : "FAIL") << std::endl;
    return pass ? 0 : 1;
}

// 单个rank的完整流程。由ProcessGroup在每个子进程中调用。
// 本样例host侧无barrier（rank间同步由设备侧AinBarrierSession完成）。
int32_t RunBasicRingRank(uint32_t rank, uint32_t nranks, const std::string& ctrlEndpoint)
{
    examples::RankSyncContext sync = rank == 0U ? examples::RankSyncContext::Listen(ctrlEndpoint, nranks) :
                                                  examples::RankSyncContext::Connect(rank, nranks, ctrlEndpoint);
    if (!sync.Ok()) {
        std::cout << "[rank " << rank << "] control channel setup failed" << std::endl;
        return 1;
    }

    EXAMPLES_ACLCHECK(aclInit(nullptr));
    uint32_t devCount = 0;
    EXAMPLES_ACLCHECK(aclrtGetDeviceCount(&devCount));
    EXAMPLES_ACLCHECK(aclrtSetDevice(static_cast<uint32_t>(rank)));
    aclrtStream stream = nullptr;
    EXAMPLES_ACLCHECK(aclrtCreateStream(&stream));

    HcclComm hcclComm = nullptr;
    // 创建通信域
    EXAMPLES_HCCLCHECK(examples::InitCommByRootInfo(sync, &hcclComm));

    // 初始化本地数据
    void* sendBuf = nullptr;
    EXAMPLES_HCOMMCHECK(HcommMemAlloc(&sendBuf, COMM_BUF_SIZE));
    std::vector<int8_t> sendHost(COMM_BUF_SIZE, static_cast<int8_t>(rank));
    EXAMPLES_ACLCHECK(aclrtMemcpy(sendBuf, COMM_BUF_SIZE, sendHost.data(), COMM_BUF_SIZE, ACL_MEMCPY_HOST_TO_DEVICE));

    void* recvBuf = nullptr;
    EXAMPLES_HCOMMCHECK(HcommMemAlloc(&recvBuf, COMM_BUF_SIZE));
    EXAMPLES_ACLCHECK(aclrtMemset(recvBuf, COMM_BUF_SIZE, 0, COMM_BUF_SIZE));

    // 将本地内存注册为window
    HcclCommSymWindow sendWin{nullptr};
    EXAMPLES_HCCLCHECK(HcclCommSymWinRegister(hcclComm, sendBuf, COMM_BUF_SIZE, &sendWin, 1));

    HcclCommSymWindow recvWin{nullptr};
    EXAMPLES_HCCLCHECK(HcclCommSymWinRegister(hcclComm, recvBuf, COMM_BUF_SIZE, &recvWin, 1));

    // 创建team
    HcclTeamCreateDesc desc;
    EXAMPLES_HCCLCHECK(HcclTeamCreateDescInit(&desc));
    std::vector<uint32_t> worldRankIds;
    for (uint32_t idx = 0; idx < nranks; idx++) {
        worldRankIds.emplace_back(idx);
    }
    desc.rankIds = worldRankIds.data();
    desc.rankNum = nranks;
    desc.selfRankId = rank;
    desc.netLayer = 0;
    desc.requirement.barrierCount = 1;
    desc.engine = COMM_ENGINE_AIV;
    desc.protocol = COMM_PROTOCOL_UB_CTP;
    desc.channelCnt = 1;
    HcommTeamHandle team{nullptr};
    EXAMPLES_HCCLCHECK(HcclTeamCreate(hcclComm, &desc, &team));

    basic_ring_kernel<<<1U, nullptr, stream>>>(team, sendWin, recvWin, nranks, rank);
    EXAMPLES_ACLCHECK(aclrtSynchronizeStream(stream));

    // 结果校验
    int32_t prev = (rank - 1 + nranks) % nranks;
    int32_t getOffset = nranks + rank;
    int8_t* testBuf = nullptr;
    EXAMPLES_ACLCHECK(aclrtMallocHost(reinterpret_cast<void**>(&testBuf), COMM_BUF_SIZE));
    EXAMPLES_ACLCHECK(aclrtMemcpy(testBuf, COMM_BUF_SIZE, recvBuf, COMM_BUF_SIZE, ACL_MEMCPY_DEVICE_TO_HOST));
    bool pass = testBuf[prev] == static_cast<int8_t>(prev) && testBuf[getOffset] == static_cast<int8_t>(prev);
    std::cout << "[rank " << rank << "] basic_ring | PUT recvBuf[" << prev
              << "]=" << static_cast<int32_t>(testBuf[prev]) << ", GET recvBuf[" << getOffset
              << "]=" << static_cast<int32_t>(testBuf[getOffset]) << " | " << (pass ? "PASS" : "FAIL") << std::endl;

    EXAMPLES_HCCLCHECK(HcclTeamDestroy(team));
    EXAMPLES_HCCLCHECK(HcclCommSymWinDeregister(recvWin));
    EXAMPLES_HCCLCHECK(HcclCommSymWinDeregister(sendWin));
    EXAMPLES_ACLCHECK(aclrtFreeHost(testBuf));
    EXAMPLES_HCOMMCHECK(HcommMemFree(sendBuf));
    EXAMPLES_HCOMMCHECK(HcommMemFree(recvBuf));
    EXAMPLES_HCCLCHECK(HcclCommDestroy(hcclComm));
    EXAMPLES_ACLCHECK(aclrtDestroyStream(stream));
    EXAMPLES_ACLCHECK(aclrtResetDevice(static_cast<uint32_t>(rank)));
    EXAMPLES_ACLCHECK(aclFinalize());

    return pass ? 0 : 1;
}
