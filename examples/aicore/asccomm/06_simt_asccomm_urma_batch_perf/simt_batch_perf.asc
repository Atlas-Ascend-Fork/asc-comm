using simt_batch_perf::ChannelConfig;

extern void launch_simt_batch_perf(
    void* stream, const ChannelConfig& single_channel, const ChannelConfig* device_group_channels,
    uint32_t channel_count, uint32_t send_buf_idx, void* timing, uint32_t payload_bytes, uint32_t slot_bytes,
    uint32_t iterations, uint32_t warmup, uint32_t api, uint32_t group_lanes);

namespace {
using namespace simt_batch_perf;

constexpr uint32_t LOCAL_SEND_IDX = 1U;
constexpr CommProtocol TARGET_COMM_PROTOCOL = COMM_PROTOCOL_UB_CTP;
constexpr const char* SEND_BUF_TAG = "simtBatchPerfSendBuf";
constexpr const char* RECV_BUF_TAG = "simtBatchPerfRecvBuf";

// api名 -> 下标。
uint32_t api_index(const std::string& api)
{
    if (api == "write") {
        return API_WRITE;
    }
    if (api == "read") {
        return API_READ;
    }
    if (api == "notify") {
        return API_NOTIFY;
    }
    if (api == "write_value") {
        return API_WRITE_VALUE;
    }
    if (api == "faa") {
        return API_FAA;
    }
    return API_CAS;
}

// 校验api名合法。
bool valid_api(const std::string& api)
{
    return api == "write" || api == "read" || api == "notify" || api == "write_value" || api == "faa" || api == "cas";
}

bool uses_payload(uint32_t api) { return api == API_WRITE || api == API_READ || api == API_NOTIFY; }

// 返回当前批量形态标签。
const char* mode_label(const std::string& mode) { return mode == "group" ? "GroupBatch" : "ExplicitBatch"; }

// 向上对齐。
uint32_t align_up(uint32_t value, uint32_t alignment) { return (value + alignment - 1U) / alignment * alignment; }

// slot大小按8字节对齐，Notify另预留8字节。
uint32_t slot_bytes(uint32_t api, uint32_t payload_bytes)
{
    if (api == API_NOTIFY) {
        return align_up(payload_bytes, sizeof(uint64_t)) + sizeof(uint64_t);
    }
    if (api == API_WRITE || api == API_READ) {
        return align_up(payload_bytes, sizeof(uint64_t));
    }
    return sizeof(uint64_t);
}

uint8_t channel_payload_byte(uint32_t channel_idx) { return static_cast<uint8_t>(PAYLOAD_BYTE + channel_idx); }

// 各通道使用不同的发送数据，便于检测跨通道错写。原子接口预置远端初值。
aclError init_buffers(
    void* send_buf, void* recv_buf, size_t channel_bytes, uint32_t channel_count, uint32_t api, uint32_t slot_bytes)
{
    const size_t bytes = channel_bytes * channel_count;
    std::vector<uint8_t> send;
    send.reserve(bytes);
    for (uint32_t i = 0U; i < channel_count; ++i) {
        send.insert(send.end(), channel_bytes, channel_payload_byte(i));
    }
    std::vector<uint8_t> recv(bytes, REMOTE_INITIAL_BYTE);
    if (api == API_FAA || api == API_CAS) {
        const uint64_t initial = api == API_FAA ? FAA_INITIAL : CAS_INITIAL;
        for (size_t offset = 0U; offset < bytes; offset += slot_bytes) {
            std::memcpy(recv.data() + offset, &initial, sizeof(initial));
        }
    }
    aclError ret = aclrtMemcpy(send_buf, bytes, send.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    return ret == ACL_SUCCESS ? aclrtMemcpy(recv_buf, bytes, recv.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE) : ret;
}

HcclResult acquire_peer_channels(
    HcclComm comm, uint32_t rank, uint32_t peer_rank, HcclMemHandle* handles, std::vector<ChannelConfig>& channels)
{
    HcclChannelDesc desc;
    EXAMPLES_HCCLCHECK(examples::find_channel_desc(comm, rank, peer_rank, TARGET_COMM_PROTOCOL, handles, 2U, desc));
    // Acquire all channels together so the same endpoint pair gets a separate channel per descriptor.
    const uint32_t channel_count = static_cast<uint32_t>(channels.size());
    const std::vector<HcclChannelDesc> descs(channel_count, desc);
    std::vector<ChannelHandle> acquired(channel_count, 0U);
    EXAMPLES_HCCLCHECK(HcclChannelAcquire(comm, COMM_ENGINE_AIV, descs.data(), channel_count, acquired.data()));
    for (uint32_t channel_idx = 0U; channel_idx < channel_count; ++channel_idx) {
        const ChannelHandle channel = acquired[channel_idx];
        const auto previous_end = acquired.begin() + channel_idx;
        if (channel == 0U || std::find(acquired.begin(), previous_end, channel) != previous_end) {
            std::cerr << "[rank " << rank << "] invalid or reused channel at index " << channel_idx << std::endl;
            return HCCL_E_INTERNAL;
        }
        uint32_t recv_idx = 0U;
        EXAMPLES_HCCLCHECK(examples::get_remote_mem(comm, channel, RECV_BUF_TAG, &recv_idx, nullptr));
        channels[channel_idx] = {channel, recv_idx};
    }
    return HCCL_SUCCESS;
}

// 计时与预热轮转kSlotCount个slot：一次写入留下的字节与第一次相同，按slot而非按操作校验。
uint32_t operation_count(uint32_t total, uint32_t slot)
{
    return total <= slot ? 0U : (total - 1U - slot) / SLOT_COUNT + 1U;
}

// 回读buffer并按slot校验。
bool check_buffer(
    void* buffer, size_t bytes, uint32_t api, uint32_t payload_bytes, uint32_t slot_bytes, uint32_t iterations,
    uint32_t warmup, uint8_t expected_payload = PAYLOAD_BYTE)
{
    std::vector<uint8_t> actual(bytes);
    if (aclrtMemcpy(actual.data(), bytes, buffer, bytes, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        return false;
    }
    for (uint32_t slot = 0U; slot < SLOT_COUNT; ++slot) {
        const uint32_t count = operation_count(iterations, slot) + operation_count(warmup, slot);
        if (count == 0U) {
            continue;
        }
        uint8_t* value = actual.data() + static_cast<size_t>(slot) * slot_bytes;
        if (api == API_WRITE || api == API_READ || api == API_NOTIFY) {
            const uint8_t expected = api == API_READ ? REMOTE_INITIAL_BYTE : expected_payload;
            for (uint32_t i = 0U; i < payload_bytes; ++i) {
                if (value[i] != expected) {
                    return false;
                }
            }
            if (api == API_NOTIFY) {
                uint64_t notify = 0U;
                std::memcpy(&notify, value + slot_bytes - sizeof(uint64_t), sizeof(notify));
                if (notify != NOTIFY_VALUE) {
                    return false;
                }
            }
        } else {
            uint64_t result = 0U;
            std::memcpy(&result, value, sizeof(result));
            const uint64_t expected =
                api == API_WRITE_VALUE ?
                    INLINE_VALUE :
                    (api == API_FAA ? FAA_INITIAL + static_cast<uint64_t>(count) * FAA_ADD : CAS_SWAP);
            if (result != expected) {
                return false;
            }
        }
    }
    return true;
}

// 发送侧只回写fetch返回值：FAA返回加之前的旧值，CAS只在首轮发生真实交换。
bool check_atomic_fetch_buffer(
    void* buffer, size_t bytes, uint32_t api, uint32_t slot_bytes, uint32_t iterations, uint32_t warmup)
{
    std::vector<uint8_t> actual(bytes);
    if (aclrtMemcpy(actual.data(), bytes, buffer, bytes, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        return false;
    }
    for (uint32_t slot = 0U; slot < SLOT_COUNT; ++slot) {
        const uint32_t count = operation_count(iterations, slot) + operation_count(warmup, slot);
        if (count == 0U) {
            continue;
        }
        uint64_t result = 0U;
        std::memcpy(&result, actual.data() + static_cast<size_t>(slot) * slot_bytes, sizeof(result));
        const uint64_t expected = api == API_FAA ? FAA_INITIAL + static_cast<uint64_t>(count - 1U) * FAA_ADD :
                                                   (count == 1U ? CAS_INITIAL : CAS_SWAP);
        if (result != expected) {
            return false;
        }
    }
    return true;
}

// 解析逗号分隔的GroupBatch线程数列表。
bool parse_lane_list(const std::string& text, std::vector<uint32_t>& lanes)
{
    lanes.clear();
    size_t begin = 0U;
    while (true) {
        const size_t end = text.find(',', begin);
        const std::string token = text.substr(begin, end == std::string::npos ? std::string::npos : end - begin);
        uint32_t value = 0U;
        if (!examples::parse_uint32(token.c_str(), value, MIN_GROUP_LANES)) {
            return false;
        }
        lanes.push_back(value);
        if (end == std::string::npos) {
            break;
        }
        begin = end + 1U;
    }
    return !lanes.empty();
}
} // namespace

// 本样例三个host侧同步点的tag。
constexpr uint32_t TAG_READY = examples::TAG_USER_BASE;
constexpr uint32_t TAG_COMPLETED = TAG_READY + 1U;
constexpr uint32_t TAG_STATUS = TAG_COMPLETED + 1U;

// 单个rank的执行流程：建链、注册内存、执行kernel并校验，pair两端状态经控制通道汇聚后
// 由发送方输出RESULT行。由process_group在每个子进程中调用。
int32_t run_simt_batch_perf_rank(
    uint32_t rank, uint32_t nranks, const std::string& ctrl_endpoint, const std::string& api_name, uint32_t iterations,
    uint32_t warmup, uint32_t payload_bytes, uint32_t batch_size, const std::string& mode, uint32_t group_lanes,
    uint32_t channel_count)
{
    const uint32_t api = api_index(api_name);
    if ((nranks != 2U && nranks != 8U) || rank >= nranks || !valid_api(api_name) || iterations == 0U ||
        payload_bytes < 2U || (uses_payload(api) && payload_bytes > MAX_PAYLOAD_BYTES) ||
        (mode != "batch" && mode != "group") ||
        (mode == "group" && (group_lanes != batch_size || group_lanes < MIN_GROUP_LANES)) ||
        (mode != "group" && (group_lanes != 1U || batch_size != 1U))) {
        std::cerr << "[rank " << rank << "] invalid rank arguments" << std::endl;
        return 1;
    }
    const bool is_sender = (rank & 1U) == 0U;
    const uint32_t peer = rank ^ 1U;
    const uint32_t slot_size = slot_bytes(api, payload_bytes);
    const size_t phase_bytes = static_cast<size_t>(slot_size) * SLOT_COUNT;
    const bool group_batch = mode == "group";
    const size_t channel_bytes = group_batch ? 2U * phase_bytes : phase_bytes;
    const uint32_t shared_warmup = group_batch ? 0U : warmup;
    const size_t buffer_bytes = channel_bytes * channel_count;

    examples::rank_sync_context sync = rank == 0U ?
                                           examples::rank_sync_context::make_listen(ctrl_endpoint, nranks) :
                                           examples::rank_sync_context::make_connect(rank, nranks, ctrl_endpoint);
    if (!sync.ok()) {
        std::cerr << "[rank " << rank << "] control channel setup failed" << std::endl;
        return 1;
    }

    // 初始化ACL并创建stream。
    EXAMPLES_ACLCHECK(aclInit(nullptr));
    EXAMPLES_ACLCHECK(aclrtSetDevice(static_cast<int32_t>(rank)));
    aclrtStream stream = nullptr;
    EXAMPLES_ACLCHECK(aclrtCreateStream(&stream));
    // 创建通信域。
    HcclComm comm = nullptr;
    EXAMPLES_HCCLCHECK(examples::init_comm_by_root_info(sync, &comm));

    // 分配收发buffer并按api填充。
    void* send_buf = nullptr;
    void* recv_buf = nullptr;
    EXAMPLES_ACLCHECK(aclrtMalloc(&send_buf, buffer_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    EXAMPLES_ACLCHECK(aclrtMalloc(&recv_buf, buffer_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    EXAMPLES_ACLCHECK(init_buffers(send_buf, recv_buf, channel_bytes, channel_count, api, slot_size));

    CommMem send_mem{COMM_MEM_TYPE_DEVICE, send_buf, buffer_bytes};
    CommMem recv_mem{COMM_MEM_TYPE_DEVICE, recv_buf, buffer_bytes};
    HcclMemHandle handles[2] = {nullptr, nullptr};
    // 按tag注册收发buffer，供对端按下标访问。
    EXAMPLES_HCCLCHECK(HcclCommMemReg(comm, SEND_BUF_TAG, &send_mem, &handles[0]));
    EXAMPLES_HCCLCHECK(HcclCommMemReg(comm, RECV_BUF_TAG, &recv_mem, &handles[1]));

    std::vector<ChannelConfig> channels(channel_count);
    EXAMPLES_HCCLCHECK(acquire_peer_channels(comm, rank, peer, handles, channels));
    if (!sync.barrier(TAG_READY)) {
        std::cerr << "[rank " << rank << "] ready barrier failed" << std::endl;
        return 1;
    }

    bool pass = true;
    double issue_ticks = 0.0;
    uint64_t publish_count = 0U;
    if (is_sender) {
        void* device_channels = nullptr;
        if (group_batch) {
            const size_t config_bytes = channels.size() * sizeof(ChannelConfig);
            EXAMPLES_ACLCHECK(aclrtMalloc(&device_channels, config_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
            EXAMPLES_ACLCHECK(
                aclrtMemcpy(device_channels, config_bytes, channels.data(), config_bytes, ACL_MEMCPY_HOST_TO_DEVICE));
        }

        void* timing_buf = nullptr;
        const uint32_t timing_words = group_batch ? GROUP_TIMING_WORDS : BATCH_TIMING_WORDS;
        std::vector<uint64_t> timing(channel_count * timing_words);
        const size_t timing_bytes = timing.size() * sizeof(uint64_t);
        EXAMPLES_ACLCHECK(aclrtMalloc(&timing_buf, timing_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        EXAMPLES_ACLCHECK(aclrtMemset(timing_buf, timing_bytes, 0, timing_bytes));
        launch_simt_batch_perf(
            stream, channels.front(), static_cast<const ChannelConfig*>(device_channels), channel_count, LOCAL_SEND_IDX,
            timing_buf, payload_bytes, slot_size, iterations, warmup, api, group_lanes);
        EXAMPLES_ACLCHECK(aclrtSynchronizeStream(stream));
        EXAMPLES_ACLCHECK(
            aclrtMemcpy(timing.data(), timing_bytes, timing_buf, timing_bytes, ACL_MEMCPY_DEVICE_TO_HOST));
        EXAMPLES_ACLCHECK(aclrtFree(timing_buf));
        if (group_batch) {
            EXAMPLES_ACLCHECK(aclrtFree(device_channels));
        }

        bool device_pass = true;
        uint64_t first_issue_start = group_batch ? timing[ISSUE_START_INDEX] : 0U;
        uint64_t last_issue_end = 0U;
        for (uint32_t i = 0U; i < channel_count; ++i) {
            const uint64_t* result = timing.data() + i * timing_words;
            const uint64_t publishes = result[PUBLISH_COUNT_INDEX];
            const bool valid_publishes =
                group_batch ? publishes > 0U && publishes <= iterations / group_lanes : publishes == iterations;
            publish_count += publishes;
            if (result[STATUS_INDEX] != 0U || result[COMPLETED_INDEX] != iterations || !valid_publishes) {
                std::cerr << "[rank " << rank << "] channel " << i
                          << " failed, status=" << static_cast<int64_t>(result[STATUS_INDEX])
                          << ", completed=" << result[COMPLETED_INDEX] << "/" << iterations
                          << ", publishes=" << publishes << std::endl;
                device_pass = false;
            }
            if (group_batch) {
                first_issue_start = std::min(first_issue_start, result[ISSUE_START_INDEX]);
                last_issue_end = std::max(last_issue_end, result[ISSUE_START_INDEX] + result[ISSUE_CYCLES_INDEX]);
            }
        }
        bool local_check_pass = true;
        if (device_pass && api == API_READ) {
            local_check_pass =
                check_buffer(send_buf, phase_bytes, api, payload_bytes, slot_size, iterations, shared_warmup) &&
                (!group_batch || warmup == 0U ||
                 check_buffer(
                     static_cast<uint8_t*>(send_buf) + phase_bytes, phase_bytes, api, payload_bytes, slot_size, warmup,
                     0U));
        } else if (device_pass && (api == API_FAA || api == API_CAS)) {
            local_check_pass =
                check_atomic_fetch_buffer(send_buf, phase_bytes, api, slot_size, iterations, shared_warmup) &&
                (!group_batch || warmup == 0U ||
                 check_atomic_fetch_buffer(
                     static_cast<uint8_t*>(send_buf) + phase_bytes, phase_bytes, api, slot_size, warmup, 0U));
        }
        pass = device_pass && local_check_pass;
        if (device_pass) {
            const uint64_t issue_cycles = group_batch ? last_issue_end - first_issue_start : timing[ISSUE_CYCLES_INDEX];
            issue_ticks = static_cast<double>(issue_cycles) / (static_cast<uint64_t>(iterations) * channel_count);
        }
    }

    if (!sync.barrier(TAG_COMPLETED)) {
        std::cerr << "[rank " << rank << "] completed barrier failed" << std::endl;
        return 1;
    }
    if (!is_sender && api != API_READ) {
        for (uint32_t i = 0U; i < channel_count; ++i) {
            auto* channel_recv = static_cast<uint8_t*>(recv_buf) + i * channel_bytes;
            const uint8_t expected_payload = channel_payload_byte(i);
            if (!check_buffer(
                    channel_recv, phase_bytes, api, payload_bytes, slot_size, iterations, shared_warmup,
                    expected_payload) ||
                (group_batch && warmup != 0U &&
                 !check_buffer(
                     channel_recv + phase_bytes, phase_bytes, api, payload_bytes, slot_size, warmup, 0U,
                     expected_payload))) {
                std::cerr << "[rank " << rank << "] channel " << i << " data check failed" << std::endl;
                pass = false;
            }
        }
    }

    // pair两端校验结果经控制通道汇聚，由发送方输出RESULT行。
    const uint32_t flags = pass ? 1U : 0U;
    std::vector<uint32_t> all_flags(nranks, 0U);
    if (!sync.allgather(TAG_STATUS, &flags, sizeof(flags), all_flags.data())) {
        std::cerr << "[rank " << rank << "] status allgather failed" << std::endl;
        return 1;
    }
    const bool pair_pass = all_flags[rank] == 1U && all_flags[peer] == 1U;
    if (is_sender) {
        const uint32_t data_bytes = uses_payload(api) ? payload_bytes : 8U;
        const uint32_t batch_items = mode == "group" ? group_lanes : 1U;
        std::cout << std::fixed << std::setprecision(6) << "RESULT | API=" << api_name << " | Mode=" << mode_label(mode)
                  << " | DataSize/B=" << data_bytes << " | BatchSize=" << batch_items << " | Jettys=" << channel_count
                  << " | ConcurrentJettys=" << channel_count << " | IssueTicksPerRequest=" << issue_ticks
                  << " | Publishes=" << publish_count << " | Pair=" << rank << "-" << peer
                  << " | Status=" << (pair_pass ? "PASS" : "FAIL") << std::endl;
    }

    EXAMPLES_HCCLCHECK(HcclCommDestroy(comm));
    EXAMPLES_ACLCHECK(aclrtFree(send_buf));
    EXAMPLES_ACLCHECK(aclrtFree(recv_buf));
    EXAMPLES_ACLCHECK(aclrtDestroyStream(stream));
    EXAMPLES_ACLCHECK(aclFinalize());
    return pair_pass ? 0 : 2;
}

namespace {

// 一个用例的完整参数：api + 提交方式 + batch_size + lane数。
// ExplicitBatch的batch size固定为1，GroupBatch每轮任务数等于lane数，多轮累计为一批提交。
struct perf_case {
    std::string api;
    std::string mode;
    uint32_t batch_size;
    uint32_t lanes;
};

} // namespace

// 父进程流程：解析命令行，构造用例列表，逐个拉起全部rank进程并等待结果。
int main(int32_t argc, char* argv[])
{
    if (argc < 4) {
        std::cout << "Usage: " << argv[0]
                  << " <tcp://ip:port> <nranks> <write|read|notify|write_value|faa|cas|all> [options]" << std::endl;
        std::cout << "Options:" << std::endl;
        std::cout << "  --mode MODE         compare, batch, or group; default: compare (group with multiple channels)"
                  << std::endl;
        std::cout << "  --channels N        Channels per rank pair, default: 1; 2.." << MAX_CHANNELS
                  << " for write group mode" << std::endl;
        std::cout << "  --iterations N      Timed requests per channel, default: 1024" << std::endl;
        std::cout << "  --warmup N          Warmup requests per channel, default: 96" << std::endl;
        std::cout << "  --payload-bytes N   Write/Read/Notify payload, default: 64; range: 2.." << MAX_PAYLOAD_BYTES
                  << std::endl;
        std::cout << "  --group-lanes LIST  GroupBatch lane counts, default: 16,32,128" << std::endl;
        return 1;
    }
    const std::string endpoint = argv[1];
    uint32_t nranks = 0;
    if (!examples::parse_uint32(argv[2], nranks, 2) || (nranks != 2U && nranks != 8U)) {
        std::cout << "invalid nranks: " << argv[2] << ", expected 2 (one pair) or 8 (four pairs)" << std::endl;
        return 1;
    }
    const std::string api_arg = argv[3];
    std::vector<std::string> apis;
    if (api_arg == "all") {
        apis = {"write", "read", "notify", "write_value", "faa", "cas"};
    } else if (valid_api(api_arg)) {
        apis = {api_arg};
    } else {
        std::cout << "invalid api: " << api_arg << std::endl;
        return 1;
    }

    std::string mode;
    uint32_t channel_count = 1U;
    uint32_t iterations = 1024U;
    uint32_t warmup = 96U;
    uint32_t payload_bytes = 64U;
    std::vector<uint32_t> lane_counts;
    for (int i = 4; i < argc; ++i) {
        const std::string option = argv[i];
        const bool has_value = i + 1 < argc;
        if (option == "--mode" && has_value) {
            mode = argv[++i];
            if (mode != "compare" && mode != "batch" && mode != "group") {
                std::cout << "invalid mode: " << mode << ", expected compare, batch or group" << std::endl;
                return 1;
            }
        } else if (option == "--channels" && has_value) {
            if (!examples::parse_uint32(argv[++i], channel_count, 1) || channel_count > MAX_CHANNELS) {
                std::cout << "invalid --channels value, expected 1.." << MAX_CHANNELS << std::endl;
                return 1;
            }
        } else if (option == "--iterations" && has_value) {
            if (!examples::parse_uint32(argv[++i], iterations, 1) || iterations > MAX_ITERATIONS) {
                std::cout << "invalid --iterations value" << std::endl;
                return 1;
            }
        } else if (option == "--warmup" && has_value) {
            if (!examples::parse_uint32(argv[++i], warmup) || warmup > MAX_WARMUP) {
                std::cout << "invalid --warmup value" << std::endl;
                return 1;
            }
        } else if (option == "--payload-bytes" && has_value) {
            if (!examples::parse_uint32(argv[++i], payload_bytes, 2)) {
                std::cout << "invalid --payload-bytes value, expected an integer >= 2" << std::endl;
                return 1;
            }
        } else if (option == "--group-lanes" && has_value) {
            if (!parse_lane_list(argv[++i], lane_counts)) {
                std::cout << "invalid --group-lanes value, expected comma-separated integers >= " << MIN_GROUP_LANES
                          << std::endl;
                return 1;
            }
        } else {
            std::cout << "Unknown or incomplete option: " << option << std::endl;
            return 1;
        }
    }
    if (mode.empty()) {
        mode = channel_count == 1U ? "compare" : "group";
    }
    if (channel_count > 1U && (api_arg != "write" || mode != "group")) {
        std::cout << "multiple channels require the write API and group mode" << std::endl;
        return 1;
    }
    if ((api_arg == "all" || uses_payload(api_index(api_arg))) && payload_bytes > MAX_PAYLOAD_BYTES) {
        std::cout << "invalid --payload-bytes value, maximum for write/read/notify is " << MAX_PAYLOAD_BYTES
                  << std::endl;
        return 1;
    }
    if (lane_counts.empty()) {
        // Limit the default sweep to 1024 threads across all channels.
        constexpr uint32_t default_thread_limit = 1024U;
        for (uint32_t lanes : {16U, 32U, 128U}) {
            if (lanes <= default_thread_limit / channel_count) {
                lane_counts.push_back(lanes);
            }
        }
    }

    // compare模式对照ExplicitBatch与GroupBatch；ExplicitBatch仅--mode batch时执行。
    std::vector<perf_case> cases;
    for (const std::string& api : apis) {
        if (mode == "batch") {
            cases.push_back({api, mode, 1U, 1U});
        } else {
            if (mode == "compare") {
                cases.push_back({api, "batch", 1U, 1U});
            }
            for (uint32_t lanes : lane_counts) {
                cases.push_back({api, "group", lanes, lanes});
            }
        }
    }
    for (const perf_case& cur_case : cases) {
        if (cur_case.lanes > MAX_GROUP_LANES || iterations % cur_case.lanes != 0U) {
            std::cout << "GroupBatch lanes must be in " << MIN_GROUP_LANES << ".." << MAX_GROUP_LANES
                      << " and divide iterations " << iterations << std::endl;
            return 1;
        }
        if (channel_count > 1U &&
            ((cur_case.lanes & (cur_case.lanes - 1U)) != 0U || cur_case.lanes > MAX_GROUP_LANES / channel_count)) {
            std::cout << "with multiple channels, GroupBatch lanes must be a power of two and channels * lanes <= "
                      << MAX_GROUP_LANES << " (lanes=" << cur_case.lanes << ")" << std::endl;
            return 1;
        }
    }

    bool all_passed = true;
    bool interrupted = false;
    for (const perf_case& cur_case : cases) {
        // GroupBatch预热请求数向上取整到完整的追加轮次。
        const uint32_t case_warmup = cur_case.mode == "group" ? align_up(warmup, cur_case.lanes) : warmup;
        std::vector<examples::args_of<decltype(run_simt_batch_perf_rank)>> per_rank_args;
        per_rank_args.reserve(nranks);
        for (uint32_t rank = 0; rank < nranks; ++rank) {
            per_rank_args.emplace_back(
                rank, nranks, endpoint, cur_case.api, iterations, case_warmup, payload_bytes, cur_case.batch_size,
                cur_case.mode, cur_case.lanes, channel_count);
        }
        examples::process_group group;
        if (!group.launch(nranks, run_simt_batch_perf_rank, std::move(per_rank_args))) {
            return 1;
        }
        const bool case_passed = group.wait_all();
        if (group.interrupted()) {
            interrupted = true;
            break;
        }
        if (!case_passed) {
            std::cout << "CASE_FAILED | API=" << cur_case.api << " | Mode=" << mode_label(cur_case.mode)
                      << " | BatchSize=" << cur_case.batch_size << " | Jettys=" << channel_count << " | ExitCodes=";
            for (int code : group.exit_codes()) {
                std::cout << code << ",";
            }
            std::cout << std::endl;
        }
        all_passed = case_passed && all_passed;
    }

    if (interrupted) {
        std::cout << "RESULT | Example=simt_batch_perf | Status=INTERRUPTED" << std::endl;
        return 1;
    }
    std::cout << "RESULT | Example=simt_batch_perf | Status=" << (all_passed ? "PASS" : "FAIL") << std::endl;
    return all_passed ? 0 : 1;
}
