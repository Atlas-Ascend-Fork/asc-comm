#include <cstdio>
#include <cstring>
#include <vector>

#include "acl/acl.h"
#include "asccomm/asccomm.h"
#include "hccl/hccl.h"
#include "hccl/hccl_comm.h"
#include "hccl/hccl_rank_graph.h"
#include "hccl/hccl_res.h"
#include "hccl/hccl_types.h"
#include "kernel_operator.h"

#include "utils/check.h"
#include "utils/hccl_comm_init.h"
#include "utils/process_manager.h"
#include "utils/rank_sync.h"
#include "utils/arg_parser.h"
#include "utils/hccl_channel_util.h"

#include "asccomm_rw_def.h"

namespace {

constexpr const char* MEMORY_TAG = "shareBuf";

// host侧两个同步点tag。
constexpr uint32_t TAG_READY = examples::TAG_USER_BASE;
constexpr uint32_t TAG_SENT = examples::TAG_USER_BASE + 1U;

// 第0字节为rank_id，其余为rank_id + index，用于逐字节校验。
uint8_t get_data_value(uint32_t rank, uint32_t index)
{
    return index == 0U ? static_cast<uint8_t>(rank) : static_cast<uint8_t>(rank + index);
}

// rank入口函数，由process_group在每个子进程中调用，返回值即进程退出码（0=成功，1=失败）。
// 完整流程：初始化ACL与通信域、注册内存、与prev/next建链、下发读写kernel并校验。
int32_t run_asccomm_write_read_nbi_rank(uint32_t rank, uint32_t nranks, const std::string& ctrl_endpoint)
{
    // 环形拓扑：向next写、从next读；nranks==2时prev与next相同，环退化为点对点。
    const uint32_t prev_rank = (rank + nranks - 1U) % nranks;
    const uint32_t next_rank = (rank + 1U) % nranks;

    // 搭建以rank 0为中心的TCP控制通道，用于通信域root info交换与host侧barrier同步。
    examples::rank_sync_context sync = rank == 0U ?
                                           examples::rank_sync_context::make_listen(ctrl_endpoint, nranks) :
                                           examples::rank_sync_context::make_connect(rank, nranks, ctrl_endpoint);
    if (!sync.ok()) {
        return 1;
    }

    // 初始化ACL并创建stream。
    EXAMPLES_ACLCHECK(aclInit(nullptr));
    EXAMPLES_ACLCHECK(aclrtSetDevice(rank));
    aclrtStream stream = nullptr;
    EXAMPLES_ACLCHECK(aclrtCreateStream(&stream));

    // 创建通信域。
    HcclComm comm = nullptr;
    HcclCommConfig config;
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = rank;
    EXAMPLES_HCCLCHECK(examples::init_comm_by_root_info_config(sync, &config, &comm));

    // 分配通信buffer，填充发送数据并从host拷入device。
    void* dev_buf = nullptr;
    EXAMPLES_ACLCHECK(aclrtMalloc(&dev_buf, COMM_BUF_SIZE, ACL_MEM_MALLOC_HUGE_ONLY));
    std::vector<uint8_t> host_buffer(static_cast<size_t>(COMM_BUF_SIZE), 0U);
    for (uint32_t i = 0U; i < DATA_SIZE; ++i) {
        host_buffer[SEND_DATA_OFFSET + i] = get_data_value(rank, i);
    }
    EXAMPLES_ACLCHECK(
        aclrtMemcpy(dev_buf, COMM_BUF_SIZE, host_buffer.data(), COMM_BUF_SIZE, ACL_MEMCPY_HOST_TO_DEVICE));

    // 将通信buffer按MEMORY_TAG注册，供对端按tag查回。
    CommMem registered_memory = {};
    registered_memory.type = COMM_MEM_TYPE_DEVICE;
    registered_memory.addr = dev_buf;
    registered_memory.size = COMM_BUF_SIZE;
    HcclMemHandle mem_handle = nullptr;
    EXAMPLES_HCCLCHECK(HcclCommMemReg(comm, MEMORY_TAG, &registered_memory, &mem_handle));

    // 逐peer：建链、查回对端buffer并填写kernel上下文；nranks==2时两个方向复用同一条通道与上下文。
    ChannelHandle peer_channels[2] = {0U, 0U};
    uint64_t peer_remote_bufs[2] = {0U, 0U};
    // context指针按uint8_t*存放，与kernel入口GM_ADDR（__gm__ uint8_t*）参数类型匹配；
    // 用void*存放时无法隐式转换为__gm__限定指针，kernel下发处会编译报错。
    uint8_t* peer_contexts[2] = {nullptr, nullptr};
    const uint32_t peer_ranks[2] = {prev_rank, next_rank};
    for (uint32_t i = 0U; i < 2U; ++i) {
        if (i == 1U && prev_rank == next_rank) {
            peer_channels[i] = peer_channels[0];
            peer_remote_bufs[i] = peer_remote_bufs[0];
            peer_contexts[i] = peer_contexts[0];
            continue;
        }
        // 与对端建链。
        EXAMPLES_HCCLCHECK(examples::acquire_channel(
            comm, rank, peer_ranks[i], HOST_COMM_PROTOCOL, &mem_handle, 1U, peer_channels[i]));
        // 按tag查回对端注册的通信buffer地址。
        EXAMPLES_HCCLCHECK(examples::get_remote_mem(comm, peer_channels[i], MEMORY_TAG, nullptr, &peer_remote_bufs[i]));

        EXAMPLES_ACLCHECK(aclrtMalloc(
            reinterpret_cast<void**>(&peer_contexts[i]), sizeof(asccomm_example::comm_context),
            ACL_MEM_MALLOC_HUGE_ONLY));
        asccomm_example::comm_context context = {};
        context.channel_handle = peer_channels[i];
        context.local_buffer_addr = reinterpret_cast<uint64_t>(dev_buf);
        context.remote_buffer_addr = peer_remote_bufs[i];
        context.test_result = KERNEL_SUCCESS;
        EXAMPLES_ACLCHECK(
            aclrtMemcpy(peer_contexts[i], sizeof(context), &context, sizeof(context), ACL_MEMCPY_HOST_TO_DEVICE));
    }

    // 全体rank的通道与内存就绪后，才允许下发kernel。
    if (!sync.barrier(TAG_READY)) {
        return 1;
    }
    // 下发读写kernel：对next做一次write_nbi与一次read_nbi。
    kernel_asccomm_write_read_nbi<<<1, nullptr, stream>>>(peer_contexts[1]);
    EXAMPLES_ACLCHECK(aclrtSynchronizeStream(stream));
    // 本端kernel完成后等对端也完成，双方写入均已落地才进入校验。
    if (!sync.barrier(TAG_SENT)) {
        return 1;
    }

    // 校验kernel执行结果与buffer中写/读两个区间的数据。
    asccomm_example::comm_context context = {};
    EXAMPLES_ACLCHECK(
        aclrtMemcpy(&context, sizeof(context), peer_contexts[1], sizeof(context), ACL_MEMCPY_DEVICE_TO_HOST));
    if (context.test_result != KERNEL_SUCCESS) {
        fprintf(stderr, "[ERROR] rank %u: kernel failed, test_result=%u\n", rank, context.test_result);
        return 1;
    }
    EXAMPLES_ACLCHECK(
        aclrtMemcpy(host_buffer.data(), COMM_BUF_SIZE, dev_buf, COMM_BUF_SIZE, ACL_MEMCPY_DEVICE_TO_HOST));
    for (uint32_t i = 0U; i < DATA_SIZE; ++i) {
        if (host_buffer[WRITE_RESULT_OFFSET + i] != get_data_value(prev_rank, i) ||
            host_buffer[READ_RESULT_OFFSET + i] != get_data_value(next_rank, i)) {
            fprintf(stderr, "[ERROR] rank %u: data mismatch at %u\n", rank, i);
            return 1;
        }
    }
    printf("[rank %u] write_read_nbi | sent to rank %u, received from rank %u | PASS\n", rank, next_rank, prev_rank);

    // 按申请顺序释放资源；点对点复用的上下文仅释放一次。
    for (uint32_t i = 0U; i < 2U; ++i) {
        if (peer_contexts[i] != nullptr && (i == 0U || peer_contexts[i] != peer_contexts[0])) {
            EXAMPLES_ACLCHECK(aclrtFree(peer_contexts[i]));
        }
    }
    EXAMPLES_ACLCHECK(aclrtFree(dev_buf));
    // 销毁通信域：通道与注册内存随通信域统一释放。
    EXAMPLES_HCCLCHECK(HcclCommDestroy(comm));
    EXAMPLES_ACLCHECK(aclrtDestroyStream(stream));
    EXAMPLES_ACLCHECK(aclrtResetDevice(rank));
    EXAMPLES_ACLCHECK(aclFinalize());
    return SUCCESS;
}

} // namespace

// 父进程：解析命令行，拉起全部rank子进程并汇总结果。
int32_t main(int32_t argc, char* argv[])
{
    if (argc != 3) {
        fprintf(stderr, "Usage: %s <tcp://ip:port> <nranks>\n", argv[0]);
        return FAIL;
    }
    uint32_t nranks = 0;
    if (!examples::parse_uint32(argv[2], nranks, 2)) {
        fprintf(stderr, "invalid nranks: %s, expected an integer >= 2\n", argv[2]);
        return FAIL;
    }
    const std::string endpoint = argv[1];

    // 构造每个rank子进程的入参：(rank, nranks, endpoint)
    std::vector<examples::args_of<decltype(run_asccomm_write_read_nbi_rank)>> per_rank_args;
    per_rank_args.reserve(nranks);
    for (uint32_t rank = 0; rank < nranks; ++rank) {
        per_rank_args.emplace_back(rank, nranks, endpoint);
    }

    examples::process_group group;
    if (!group.launch(nranks, run_asccomm_write_read_nbi_rank, std::move(per_rank_args))) {
        return FAIL;
    }
    const bool pass = group.wait_all();

    if (group.interrupted()) {
        fprintf(stderr, "RESULT | Example=write_read_nbi | Status=INTERRUPTED\n");
        return FAIL;
    }
    fprintf(stderr, "RESULT | Example=write_read_nbi | Status=%s\n", pass ? "PASS" : "FAIL");
    return pass ? SUCCESS : FAIL;
}
