/*!
 * \file simt_urma.asc
 * \brief Asccomm SIMT URMA功能样例Host侧流程：通信域创建、内存注册、P2P通道创建与结果校验
 */

#include <chrono>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <iostream>
#include <string>
#include <thread>
#include <vector>

#include "hccl/hccl.h"
#include "hccl/hccl_res.h"
#include "hccl/hccl_types.h"
#include "hccl/hccl_rank_graph.h"

#include "utils/check.h"
#include "utils/hccl_comm_init.h"
#include "utils/process_manager.h"
#include "utils/rank_sync.h"
#include "utils/arg_parser.h"
#include "utils/hccl_channel_util.h"

#include "simt_urma_common.h"

extern void launch_simt_urma(
    void* stream, uint64_t channel, uint32_t send_buf_idx, uint32_t recv_buf_idx, uint32_t mode);

namespace {

using namespace simt_urma;

// 相邻节点相关资源（用于环形拓扑）
// 单个对端的通道与远端内存表下标。
struct peer_rank_ctx {
    uint32_t rank_id{0};         // 对端rankId
    ChannelHandle channel{0};    // 与对端的通道
    uint32_t remote_recv_idx{0}; // 对端接收buffer在远端内存表中的下标
};

// SIMT接口只在UB_CTP/URMA协议上实现，其余链路协议无对应实现。
constexpr CommProtocol TARGET_COMM_PROTOCOL = COMM_PROTOCOL_UB_CTP;

// 两块内存注册到通信域时使用的tag。两个rank使用相同tag，远端内存才能按tag查回。
constexpr const char* SEND_BUF_TAG = "simtUrmaSendBuf";
constexpr const char* RECV_BUF_TAG = "simtUrmaRecvBuf";

// 一张表同时驱动解析和打印，避免某个 mode 能被解析、却打印成另一个名字。
struct mode_entry {
    const char* name;
    uint32_t mode;
};

constexpr mode_entry MODES[] = {
    {"write_single", MODE_WRITE_SINGLE},
    {"write_batch_last", MODE_WRITE_BATCH_LAST},
    {"write_value_single", MODE_WRITE_VALUE_SINGLE},
    {"write_value_batch_last", MODE_WRITE_VALUE_BATCH_LAST},
    {"notify", MODE_NOTIFY},
    {"faa", MODE_FAA},
    {"cas", MODE_CAS},
    {"single", MODE_NOTIFY_ATOMIC_SINGLE},
    {"batch_last", MODE_NOTIFY_ATOMIC_BATCH_LAST},
    {"notify_immediate_repeat", MODE_NOTIFY_IMMEDIATE_REPEAT},
};

constexpr uint32_t DEFAULT_MODE = MODE_NOTIFY_ATOMIC_SINGLE;

// 显式传入却不匹配任何 mode 是笔误而非取默认值，因此直接拒绝。
bool parse_mode(const char* arg, uint32_t& mode)
{
    const std::string name(arg);
    for (const mode_entry& entry : MODES) {
        if (name == entry.name) {
            mode = entry.mode;
            return true;
        }
    }
    return false;
}

// 模式枚举 -> 名称。
const char* mode_name(uint32_t mode)
{
    for (const mode_entry& entry : MODES) {
        if (mode == entry.mode) {
            return entry.name;
        }
    }
    return "unknown";
}

// 打印全部模式名。
void print_modes()
{
    std::cout << "  mode: write_single | write_batch_last | write_value_single | write_value_batch_last" << std::endl;
    std::cout << "        notify | faa | cas | single (default) | batch_last | notify_immediate_repeat" << std::endl;
}

// write 系列需要递增序列的发送 payload 和清零的接收 buffer；notify/atomic 系列需要一个
// 数据字和接收侧预置的 FAA/CAS 初值（这两个操作定义在已知初值之上）。
aclError init_buffers(void* send_buf, void* recv_buf, uint32_t mode)
{
    uint64_t send[SLOT_COUNT] = {};
    uint64_t recv[SLOT_COUNT] = {};
    if (is_write_mode(mode)) {
        for (uint32_t i = 0; i < WRITE_SLOT_COUNT; ++i) {
            send[i] = slot_value(i);
        }
    } else {
        send[NOTIFY_DATA_SLOT] = NOTIFY_DATA;
        recv[FAA_TARGET_SLOT] = FAA_INITIAL;
        recv[CAS_TARGET_SLOT] = CAS_INITIAL;
    }
    aclError ret = aclrtMemcpy(send_buf, BUFFER_BYTES, send, BUFFER_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        return ret;
    }
    return aclrtMemcpy(recv_buf, BUFFER_BYTES, recv, BUFFER_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);
}

// 与对端建链，并按 RECV_BUF_TAG 查出对端接收 buffer 在远端内存表中的索引。
// kernel 通过 asccomm_local_buffer_addr/asccomm_remote_buffer_addr 按索引解析 buffer 基地址；本地表
// index 0 保留给 CCL buffer，显式注册的内存从 1 开始。
HcclResult acquire_peer_channel(
    HcclComm comm, uint32_t rank, peer_rank_ctx& peer, HcclMemHandle* mem_handles, uint32_t mem_handle_num)
{
    EXAMPLES_HCCLCHECK(examples::acquire_channel(
        comm, rank, peer.rank_id, TARGET_COMM_PROTOCOL, mem_handles, mem_handle_num, peer.channel));
    EXAMPLES_HCCLCHECK(examples::get_remote_mem(comm, peer.channel, RECV_BUF_TAG, &peer.remote_recv_idx, nullptr));
    return HCCL_SUCCESS;
}

// 回读device buffer并逐slot与期望表比对。
bool check_words(void* device_buf, const uint64_t expected[SLOT_COUNT], const char* side)
{
    uint64_t actual[SLOT_COUNT] = {};
    if (aclrtMemcpy(actual, BUFFER_BYTES, device_buf, BUFFER_BYTES, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        return false;
    }
    bool pass = true;
    for (uint32_t slot = 0; slot < SLOT_COUNT; ++slot) {
        if (actual[slot] != expected[slot]) {
            pass = false;
            std::cout << side << " slot " << slot << " actual=" << actual[slot] << " expected=" << expected[slot]
                      << std::endl;
        }
    }
    return pass;
}

// 环上每个 recv_buf 只有一个写者（它的 prev），FAA/CAS 取回的旧值仍精确等于 host 播种的
// 初值，因此环形拓扑下 fetch 值校验依然成立。write 系列只把 send_buf 当数据源，不校验。
bool check_sender(void* send_buf, uint32_t mode)
{
    if (is_write_mode(mode)) {
        return true;
    }
    uint64_t expected[SLOT_COUNT] = {};
    expected[NOTIFY_DATA_SLOT] = NOTIFY_DATA;
    if (mode == MODE_FAA) {
        expected[FAA_FETCH_SLOT] = FAA_INITIAL;
    } else if (mode == MODE_CAS) {
        expected[CAS_FETCH_SLOT] = CAS_INITIAL;
    } else if (mode == MODE_NOTIFY_ATOMIC_SINGLE || mode == MODE_NOTIFY_ATOMIC_BATCH_LAST) {
        expected[FAA_FETCH_SLOT] = FAA_INITIAL;
        expected[CAS_FETCH_SLOT] = CAS_INITIAL;
    }
    return check_words(send_buf, expected, "sender fetch/drain");
}

// 校验接收buffer：write系列为递增序列，notify/atomic系列按各自终态期望表。
bool check_receiver(void* recv_buf, uint32_t mode)
{
    uint64_t expected[SLOT_COUNT] = {};

    // 四种 write 模式落地相同的递增序列（payload 无论走 SGE 还是 WQE 内联），一张期望表通用。
    if (is_write_mode(mode)) {
        for (uint32_t i = 0; i < WRITE_SLOT_COUNT; ++i) {
            expected[i] = slot_value(i);
        }
        return check_words(recv_buf, expected, "receiver target");
    }

    // notify_immediate_repeat 重复投递同一个 Notify，落地状态与单次 Notify 相同。
    if (mode == MODE_NOTIFY || mode == MODE_NOTIFY_IMMEDIATE_REPEAT) {
        expected[NOTIFY_DATA_SLOT] = NOTIFY_DATA;
        expected[NOTIFY_SIGNAL_SLOT] = NOTIFY_SIGNAL;
        expected[FAA_TARGET_SLOT] = FAA_INITIAL;
        expected[CAS_TARGET_SLOT] = CAS_INITIAL;
    } else if (mode == MODE_FAA) {
        expected[FAA_TARGET_SLOT] = FAA_INITIAL + FAA_ADD;
        expected[CAS_TARGET_SLOT] = CAS_INITIAL;
    } else if (mode == MODE_CAS) {
        expected[FAA_TARGET_SLOT] = FAA_INITIAL;
        expected[CAS_TARGET_SLOT] = CAS_SWAP;
    } else {
        // single 与 batch_last 都跑全部三种操作，终态相同。
        expected[NOTIFY_DATA_SLOT] = NOTIFY_DATA;
        expected[NOTIFY_SIGNAL_SLOT] = NOTIFY_SIGNAL;
        expected[FAA_TARGET_SLOT] = FAA_INITIAL + FAA_ADD;
        expected[CAS_TARGET_SLOT] = CAS_SWAP;
    }
    return check_words(recv_buf, expected, "receiver target");
}

} // namespace

// 本样例两个host侧同步点的tag。
constexpr uint32_t TAG_READY = examples::TAG_USER_BASE;
constexpr uint32_t TAG_SENT = examples::TAG_USER_BASE + 1U;

// 单个rank的完整流程。由process_group在每个子进程中调用。
int run_simt_urma_rank(uint32_t rank, uint32_t nranks, const std::string& ctrl_endpoint, const std::string& mode_arg)
{
    uint32_t mode = DEFAULT_MODE;
    if (!mode_arg.empty() && !parse_mode(mode_arg.c_str(), mode)) {
        std::cout << "Unknown mode: " << mode_arg << std::endl;
        print_modes();
        return 1;
    }

    examples::rank_sync_context sync = rank == 0U ?
                                           examples::rank_sync_context::make_listen(ctrl_endpoint, nranks) :
                                           examples::rank_sync_context::make_connect(rank, nranks, ctrl_endpoint);
    if (!sync.ok()) {
        std::cout << "[rank " << rank << "] control channel setup failed" << std::endl;
        return 1;
    }

    // 初始化ACL并创建stream。
    EXAMPLES_ACLCHECK(aclInit(nullptr));
    EXAMPLES_ACLCHECK(aclrtSetDevice(rank));
    aclrtStream stream = nullptr;
    EXAMPLES_ACLCHECK(aclrtCreateStream(&stream));

    // 创建通信域。
    HcclComm hccl_comm = nullptr;
    EXAMPLES_HCCLCHECK(examples::init_comm_by_root_info(sync, &hccl_comm));

    // 分配收发buffer并按模式填充。
    void* send_buf = nullptr;
    EXAMPLES_ACLCHECK(aclrtMalloc(&send_buf, BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    void* recv_buf = nullptr;
    EXAMPLES_ACLCHECK(aclrtMalloc(&recv_buf, BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    EXAMPLES_ACLCHECK(init_buffers(send_buf, recv_buf, mode));

    CommMem send_mem{COMM_MEM_TYPE_DEVICE, send_buf, BUFFER_BYTES};
    CommMem recv_mem{COMM_MEM_TYPE_DEVICE, recv_buf, BUFFER_BYTES};
    HcclMemHandle mem_handles[2] = {nullptr, nullptr};
    constexpr uint32_t SEND_MEM_HANDLE_IDX = 0U;
    constexpr uint32_t RECV_MEM_HANDLE_IDX = 1U;
    // 本地 buffer 表 index 0 是 CCL buffer，注册内存从 1 开始，见 acquire_peer_channel 的注释。
    constexpr uint32_t LOCAL_SEND_IDX = SEND_MEM_HANDLE_IDX + 1U;
    // 按tag注册收发buffer，供对端按下标访问。
    EXAMPLES_HCCLCHECK(HcclCommMemReg(hccl_comm, SEND_BUF_TAG, &send_mem, &mem_handles[SEND_MEM_HANDLE_IDX]));
    EXAMPLES_HCCLCHECK(HcclCommMemReg(hccl_comm, RECV_BUF_TAG, &recv_mem, &mem_handles[RECV_MEM_HANDLE_IDX]));

    // 环形拓扑：每个 rank 向 next 发送，并校验从 prev 收到的数据。
    peer_rank_ctx prev;
    peer_rank_ctx next;
    prev.rank_id = (rank + nranks - 1U) % nranks;
    next.rank_id = (rank + 1U) % nranks;

    // nranks==2 时 prev 与 next 是同一个对端：环形退化为点对点，两个方向复用同一条通道。
    // 对同一对端用相同的desc重复建链，通道握手无法区分两条通道的配对关系。
    if (prev.rank_id == next.rank_id) {
        std::cout << "[rank " << rank << "] ring degenerates to point-to-point, reusing one channel" << std::endl;
        EXAMPLES_HCCLCHECK(acquire_peer_channel(hccl_comm, rank, next, mem_handles, 2U));
        prev.channel = next.channel;
        prev.remote_recv_idx = next.remote_recv_idx;
    } else if (rank % 2 == 0) {
        // 建链顺序按 rank 奇偶错开，避免环上循环等待。
        EXAMPLES_HCCLCHECK(acquire_peer_channel(hccl_comm, rank, prev, mem_handles, 2U));
        EXAMPLES_HCCLCHECK(acquire_peer_channel(hccl_comm, rank, next, mem_handles, 2U));
    } else {
        EXAMPLES_HCCLCHECK(acquire_peer_channel(hccl_comm, rank, next, mem_handles, 2U));
        EXAMPLES_HCCLCHECK(acquire_peer_channel(hccl_comm, rank, prev, mem_handles, 2U));
    }

    // 全体rank的通道与内存就绪后，才允许下发kernel。
    if (!sync.barrier(TAG_READY)) {
        std::cout << "[rank " << rank << "] ready barrier failed" << std::endl;
        return HCCL_E_INTERNAL;
    }

    // 下发kernel执行所选模式的通信操作。
    launch_simt_urma(stream, next.channel, LOCAL_SEND_IDX, next.remote_recv_idx, mode);
    EXAMPLES_ACLCHECK(aclrtSynchronizeStream(stream));

    // 本 rank 的 kernel 已同步完成，此 barrier 保证读到 prev 写入时所有 WQE 都已落地。
    if (!sync.barrier(TAG_SENT)) {
        std::cout << "[rank " << rank << "] sent barrier failed" << std::endl;
        return HCCL_E_INTERNAL;
    }

    // send_buf 是本 rank 取回的 fetch 值，recv_buf 是 prev 写进来的数据，两侧都要校验。
    const bool sender_pass = check_sender(send_buf, mode);
    const bool receiver_pass = check_receiver(recv_buf, mode);
    const bool pass = sender_pass && receiver_pass;
    if (!sender_pass) {
        std::cout << "[rank " << rank << "] " << mode_name(mode) << " FAIL (sender fetch check)" << std::endl;
    }
    if (!receiver_pass) {
        std::cout << "[rank " << rank << "] " << mode_name(mode) << " FAIL (receiver check) | received from rank "
                  << prev.rank_id << std::endl;
    }
    if (pass) {
        std::cout << "[rank " << rank << "] simt_urma " << mode_name(mode) << " | sent to rank " << next.rank_id
                  << ", received from rank " << prev.rank_id << " | PASS" << std::endl;
    }

    EXAMPLES_ACLCHECK(aclrtFree(send_buf));
    EXAMPLES_ACLCHECK(aclrtFree(recv_buf));
    EXAMPLES_HCCLCHECK(HcclCommDestroy(hccl_comm));
    EXAMPLES_ACLCHECK(aclrtDestroyStream(stream));
    EXAMPLES_ACLCHECK(aclFinalize());
    return pass ? 0 : 2;
}

// 父进程流程：解析命令行（<tcp://ip:port> <nranks> [mode]），拉起全部rank进程并等待结果。
int main(int argc, char* argv[])
{
    if (argc > 4) {
        std::cout << "Usage: " << argv[0] << " <tcp://ip:port> <nranks> [mode]" << std::endl;
        print_modes();
        return 1;
    }
    if (argc < 3) {
        std::cout << "Usage: " << argv[0] << " <tcp://ip:port> <nranks> [mode]" << std::endl;
        print_modes();
        return 1;
    }
    uint32_t nranks = 0;
    if (!examples::parse_uint32(argv[2], nranks, 2)) {
        std::cout << "invalid nranks: " << argv[2] << ", expected an integer >= 2" << std::endl;
        return 1;
    }
    const std::string endpoint = argv[1];
    const std::string mode_name = argc > 3 ? argv[3] : "";

    std::vector<examples::args_of<decltype(run_simt_urma_rank)>> per_rank_args;
    per_rank_args.reserve(nranks);
    for (uint32_t rank = 0; rank < nranks; ++rank) {
        per_rank_args.emplace_back(rank, nranks, endpoint, mode_name);
    }

    examples::process_group group;
    if (!group.launch(nranks, run_simt_urma_rank, std::move(per_rank_args))) {
        return 1;
    }
    const bool pass = group.wait_all();

    if (group.interrupted()) {
        std::cout << "RESULT | Example=simt_urma Mode=" << (mode_name.empty() ? "single" : mode_name)
                  << " | Status=INTERRUPTED" << std::endl;
        return 1;
    }
    std::cout << "RESULT | Example=simt_urma Mode=" << (mode_name.empty() ? "single" : mode_name)
              << " | Status=" << (pass ? "PASS" : "FAIL") << std::endl;
    return pass ? 0 : 1;
}
