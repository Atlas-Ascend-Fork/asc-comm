#include "urma_normal_api_perf_def.h"

extern void launch_urma_normal_api_perf(void* stream, uint64_t context);

namespace {
using namespace urma_normal_api_perf_example;

constexpr const char* MEMORY_TAG = "urma_normal_api_perf_buf";

// host 暂存区（= source 区大小）：铺初值下发 / 校验拷回共用
constexpr uint64_t STAGE_BYTES = SOURCE_BYTES;
// 大块 memset 分片下发
constexpr uint64_t MEMSET_CHUNK = 1ULL << 30;

// host 侧同步点的 tag（TAG_PERF_RESULT 由公共 utils/perf_result.h 预留）
constexpr uint32_t TAG_READY = examples::TAG_USER_BASE;
constexpr uint32_t TAG_LAUNCHED = TAG_READY + 1U;
constexpr uint32_t TAG_DRAINED = TAG_LAUNCHED + 1U;
constexpr uint32_t TAG_CASE_END = TAG_DRAINED + 1U;

struct run_options {
    uint64_t min_exp = DEFAULT_MIN_EXP;
    uint64_t max_exp = DEFAULT_MAX_EXP;
    uint32_t rounds = DEFAULT_ROUNDS;
    uint32_t api_mask = API_ALL;
    uint32_t commit_inline = 1; // 默认 inline：接口入参 commit=true
    uint32_t metric_mask = METRIC_ALL;
    examples::perf_type topo_type = examples::perf_type::P2P; // 拓扑：p2p（默认）/ ring
};

// ---------------- host 侧数据结构 ----------------

// 结果行 perf_row 在公共 utils/perf_result.h；本样例无批维度，batch 恒填 1 占位
using examples::perf_row;

// rank 侧环境资源（RAII，析构按申请逆序释放）。
struct rank_resources {
    ~rank_resources()
    {
        if (comm != nullptr) {
            (void)HcclCommDestroy(comm);
        }
        if (stage != nullptr) {
            (void)aclrtFreeHost(stage);
        }
        if (device_context != nullptr) {
            (void)aclrtFree(device_context);
        }
        if (share_buf != nullptr) {
            (void)aclrtFree(share_buf);
        }
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (is_dev_set) {
            (void)aclrtResetDevice(static_cast<int32_t>(rank));
        }
        if (acl_initialized) {
            (void)aclFinalize();
        }
    }

    rank_resources(const rank_resources&) = delete;
    rank_resources& operator=(const rank_resources&) = delete;
    rank_resources() = default;

    uint32_t rank{0};
    bool acl_initialized{false};
    bool is_dev_set{false};
    aclrtStream stream{nullptr};
    HcclComm comm{nullptr};
    void* share_buf{nullptr};
    int32_t* stage{nullptr};
    kernel_context* device_context{nullptr};
    HcclMemHandle mem_handle{nullptr};
    ChannelHandle channel{0};      // send 通道（write/notify）
    ChannelHandle recv_channel{0}; // recv 通道（read）
    uint64_t remote_buf{0};        // send 对端基址（write/notify 落点）
    uint64_t recv_remote_buf{0};   // recv 对端基址（read 源）
};

// 单档校验的只读上下文（逐档不变）
struct case_env {
    uint8_t* dev_base{nullptr}; // 2GB 注册内存基址
    int32_t peer_pattern{0};    // 上游卡的 pattern（各落点区应等于它）
    int32_t my_pattern{0};      // 本卡 pattern（source 区应保持它）
};

// 掩码 → 名字串（"write,read" 等，与命令行取值一一对应；全选显示 "all"）
std::string api_mask_name(uint32_t api_mask)
{
    if (api_mask == API_ALL) {
        return "all";
    }
    std::string name;
    if ((api_mask & API_WRITE) != 0U) {
        name += "write";
    }
    if ((api_mask & API_READ) != 0U) {
        name += name.empty() ? "read" : ",read";
    }
    if ((api_mask & API_NOTIFY) != 0U) {
        name += name.empty() ? "notify" : ",notify";
    }
    return name;
}

const char* commit_name(uint32_t commit_inline) { return commit_inline != 0U ? "inline" : "final"; }

std::string metric_mask_name(uint32_t metric_mask)
{
    if (metric_mask == METRIC_ALL) {
        return "all";
    }
    std::string name;
    if ((metric_mask & METRIC_LAT) != 0U) {
        name += "lat";
    }
    if ((metric_mask & METRIC_BW) != 0U) {
        name += name.empty() ? "bw" : ",bw";
    }
    return name;
}

// 把 [base, base+bytes) 分片清 0
aclError clear_device_range(uint8_t* dev_base, uint64_t base, uint64_t bytes)
{
    for (uint64_t done = 0; done < bytes;) {
        const uint64_t chunk = (bytes - done) < MEMSET_CHUNK ? (bytes - done) : MEMSET_CHUNK;
        EXAMPLES_ACLCHECK(aclrtMemset(dev_base + base + done, chunk, 0, chunk));
        done += chunk;
    }
    return ACL_SUCCESS;
}

// 每档 launch 前重铺初值：落点区清 0，source 区重填 pattern。
aclError refill_initial(uint8_t* dev_base, int32_t* stage, uint32_t my_rank)
{
    EXAMPLES_ACLCHECK(clear_device_range(dev_base, WRITE_BASE, BUFFER_BYTES - WRITE_BASE));

    const int32_t pattern = SRC_PATTERN_BASE + static_cast<int32_t>(my_rank);
    for (uint64_t i = 0; i < STAGE_BYTES / sizeof(int32_t); ++i) {
        stage[i] = pattern;
    }
    EXAMPLES_ACLCHECK(
        aclrtMemcpy(dev_base + SOURCE_BASE, SOURCE_BYTES, stage, SOURCE_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
    return ACL_SUCCESS;
}

// 分片拷回比对（int32 粒度），不符则打印现场并置 ok = false（仍返回 ACL_SUCCESS）
aclError check_device_range(
    const uint8_t* dev_base, int32_t* stage, uint64_t base, uint64_t bytes, int32_t expected, const char* name,
    uint32_t rank, bool& ok)
{
    for (uint64_t done = 0; done < bytes;) {
        const uint64_t chunk = (bytes - done) < STAGE_BYTES ? (bytes - done) : STAGE_BYTES;
        EXAMPLES_ACLCHECK(aclrtMemcpy(stage, chunk, dev_base + base + done, chunk, ACL_MEMCPY_DEVICE_TO_HOST));
        const int32_t* buf = stage;
        const uint64_t words = chunk / sizeof(int32_t);
        for (uint64_t i = 0; i < words; ++i) {
            if (buf[i] != expected) {
                const uint64_t global_word = (done / sizeof(int32_t)) + i;
                std::fprintf(
                    stderr,
                    "[rank %u][FAIL] %s word[%llu]=0x%08x expect=0x%08x (values 0x64..0x6b are rank "
                    "patterns 100+rank, i.e. data from that rank; 0x0 means never written)\n",
                    rank, name, static_cast<unsigned long long>(global_word), buf[i], expected);
                const uint64_t start = i > 16 ? i - 16 : 0;
                std::fprintf(stderr, "[rank %u] error words:", rank);
                for (uint64_t j = start; j < (i + 16 < words ? i + 16 : words); ++j) {
                    std::fprintf(stderr, " %08x", buf[j]);
                }
                std::fprintf(stderr, "\n");
                ok = false;
                return ACL_SUCCESS;
            }
        }
        done += chunk;
    }
    return ACL_SUCCESS;
}

// 校验 notify flag == 固定值（单槽被并发写、逐条值不可校验，原因见 def.h）。
aclError check_flag(const uint8_t* dev_base, uint64_t expected, uint32_t rank, bool& ok)
{
    uint64_t flag = 0;
    EXAMPLES_ACLCHECK(aclrtMemcpy(&flag, sizeof(flag), dev_base + FLAG_BASE, sizeof(flag), ACL_MEMCPY_DEVICE_TO_HOST));
    if (flag != expected) {
        std::fprintf(
            stderr, "[rank %u][FAIL] notify flag=%llu expect=%llu\n", rank, static_cast<unsigned long long>(flag),
            static_cast<unsigned long long>(expected));
        ok = false;
    }
    return ACL_SUCCESS;
}

// 幂数范围 → 档位表（exp 范围 3~28）。
std::vector<uint64_t> build_ladder_checked(uint32_t rank, const run_options& opt)
{
    const std::vector<uint64_t> lens = examples::build_len_ladder(opt.min_exp, opt.max_exp);
    if (lens.empty()) {
        std::cout << "[rank " << rank << "] invalid exponent range " << opt.min_exp << "-" << opt.max_exp
                  << " (expect 3 <= minExp <= maxExp <= 28)" << std::endl;
        return lens;
    }
    return lens;
}

// rank 侧一次性环境搭建：ACL / 通信域 / 2GB 注册内存 / AIV channel / kernel 上下文，
// 资源记进 res（RAII）。按拓扑角色建 send / recv 两条通道，对端相同时只建一条。
int32_t init_rank_env(examples::rank_sync_context& sync, rank_resources& res, const examples::rank_topology& topo)
{
    const uint32_t rank = res.rank;
    EXAMPLES_ACLCHECK(aclInit(nullptr));
    res.acl_initialized = true;
    EXAMPLES_ACLCHECK(aclrtSetDevice(rank));
    res.is_dev_set = true;
    EXAMPLES_ACLCHECK(aclrtCreateStream(&res.stream));

    HcclCommConfig config;
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = rank;
    EXAMPLES_HCCLCHECK(examples::init_comm_by_root_info_config(sync, &config, &res.comm));

    EXAMPLES_ACLCHECK(aclrtMalloc(&res.share_buf, BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_ONLY));
    EXAMPLES_ACLCHECK(aclrtMallocHost(reinterpret_cast<void**>(&res.stage), STAGE_BYTES));

    CommMem reg_mem{COMM_MEM_TYPE_DEVICE, res.share_buf, BUFFER_BYTES};
    res.mem_handle = nullptr;
    EXAMPLES_HCCLCHECK(HcclCommMemReg(res.comm, MEMORY_TAG, &reg_mem, &res.mem_handle));

    // ---- 建 AIV channel：按协议过滤本卡到 send/recv 对端的链路 ----
    uint32_t* layers = nullptr;
    uint32_t layer_num = 0U;
    EXAMPLES_HCCLCHECK(HcclRankGraphGetLayers(res.comm, &layers, &layer_num));
    if (layer_num == 0U || layers == nullptr) {
        std::cout << "[rank " << rank << "] HcclRankGraphGetLayers returned no layer"
                  << " (communicator was built on a topology without rank-graph layers; check that all ranks see the "
                     "same devices)"
                  << std::endl;
        return 1;
    }
    const uint32_t peers[2] = {topo.send_rank, topo.recv_rank};
    HcclChannelDesc descs[2];
    uint32_t desc_count = 0U;
    for (uint32_t side = 0U; side < 2U; ++side) {
        if (side == 1U && peers[1] == peers[0]) {
            break; // send/recv 同对端：一条通道两用
        }
        bool link_found = false;
        for (uint32_t layer = 0U; layer < layer_num && !link_found; ++layer) {
            CommLink* links = nullptr;
            uint32_t link_num = 0U;
            EXAMPLES_HCCLCHECK(HcclRankGraphGetLinks(res.comm, layers[layer], rank, peers[side], &links, &link_num));
            for (uint32_t i = 0U; i < link_num; ++i) {
                if (links[i].linkAttr.linkProtocol == HOST_COMM_PROTOCOL) {
                    EXAMPLES_HCCLCHECK(HcclChannelDescInit(&descs[desc_count], 1U));
                    descs[desc_count].remoteRank = peers[side];
                    descs[desc_count].channelProtocol = HOST_COMM_PROTOCOL;
                    descs[desc_count].localEndpoint = links[i].srcEndpointDesc;
                    descs[desc_count].remoteEndpoint = links[i].dstEndpointDesc;
                    link_found = true;
                    break;
                }
            }
        }
        if (!link_found) {
            std::cout << "[rank " << rank << "] no UB_CTP(" << static_cast<int32_t>(HOST_COMM_PROTOCOL)
                      << ")-protocol link to peer " << peers[side]
                      << " (peer not in the same HCCS/UB island, or device visibility mismatch; check npu-smi "
                         "topo and ASCEND_RT_VISIBLE_DEVICES)"
                      << std::endl;
            return 1;
        }
        ++desc_count;
    }
    // 每条 desc 都挂同一块注册内存，对端按通道各自收到一份本卡内存表
    for (uint32_t d = 0U; d < desc_count; ++d) {
        descs[d].notifyNum = 0;
        descs[d].memHandles = &res.mem_handle;
        descs[d].memHandleNum = 1U;
    }
    ChannelHandle acquired[2] = {0, 0};
    EXAMPLES_HCCLCHECK(HcclChannelAcquire(res.comm, COMM_ENGINE_AIV, descs, desc_count, acquired));
    res.channel = acquired[0];
    res.recv_channel = (desc_count == 2U) ? acquired[1] : acquired[0];

    EXAMPLES_ACLCHECK(
        aclrtMalloc(reinterpret_cast<void**>(&res.device_context), sizeof(kernel_context), ACL_MEM_MALLOC_HUGE_FIRST));
    return 0;
}

// 从 channel 的远端注册内存表里按 tag 取对端 buffer 地址，找不到返回非 0
int32_t resolve_remote_buf(rank_resources& res, ChannelHandle channel, uint32_t peer_rank, uint64_t& remote_buf)
{
    uint32_t mem_num = 0U;
    CommMem* remote_mems = nullptr;
    char** tags = nullptr;
    remote_buf = 0;
    EXAMPLES_HCCLCHECK(HcclChannelGetRemoteMems(res.comm, channel, &mem_num, &remote_mems, &tags));
    for (uint32_t i = 0U; i < mem_num; ++i) {
        if (tags[i] != nullptr && std::strcmp(tags[i], MEMORY_TAG) == 0) {
            remote_buf = reinterpret_cast<uint64_t>(remote_mems[i].addr);
            break;
        }
    }
    if (remote_buf == 0U && mem_num == 1U) {
        remote_buf = reinterpret_cast<uint64_t>(remote_mems[0].addr);
    }
    if (remote_buf == 0U) {
        std::cout << "[rank " << res.rank << "] remote registered buffer of peer " << peer_rank
                  << " not found (peer did not register memory with tag '" << MEMORY_TAG
                  << "', or the memory exchange over the channel was incomplete)" << std::endl;
        return 1;
    }
    return 0;
}

// 校验本档数据（kernel 失败时不会进来）：source 区保持本卡 pattern；落点区只查
// 本次选中的接口的 len 字节，数据全部来自上游卡（write/notify 由它写入、
// read 从它拉回），pattern 都是 env.peer_pattern。
aclError validate_case(
    const run_options& opt, const case_env& env, int32_t* stage, uint32_t rank, uint64_t len, bool& case_ok)
{
    // source 区不该被动过
    EXAMPLES_ACLCHECK(
        check_device_range(env.dev_base, stage, SOURCE_BASE, SOURCE_BYTES, env.my_pattern, "source", rank, case_ok));
    // 只校验本次选中的接口的落点
    if (opt.api_mask & API_WRITE) {
        EXAMPLES_ACLCHECK(
            check_device_range(env.dev_base, stage, WRITE_BASE, len, env.peer_pattern, "write", rank, case_ok));
    }
    if (opt.api_mask & API_READ) {
        EXAMPLES_ACLCHECK(
            check_device_range(env.dev_base, stage, READ_BASE, len, env.peer_pattern, "read", rank, case_ok));
    }
    if (opt.api_mask & API_NOTIFY) {
        EXAMPLES_ACLCHECK(
            check_device_range(env.dev_base, stage, NOTIFY_BASE, len, env.peer_pattern, "notify", rank, case_ok));
        EXAMPLES_ACLCHECK(check_flag(env.dev_base, NOTIFY_VAL_BASE, rank, case_ok));
    }
    return ACL_SUCCESS;
}

// 跑单档：重铺初值 → barrier → launch → sync → barrier → 拷回结果 →
// 打 PERF_DATA → 校验 → 全体合并判定。
// 返回值三态：0=本档通过；1=本档或对端失败（主循环停止，退出码走 2）；
// 其他=环境/ACL/HCCL 错误码，原样透传。
int32_t run_one_case(
    examples::rank_sync_context& sync, rank_resources& res, const run_options& opt, uint32_t nranks, uint64_t len,
    const case_env& env, std::vector<perf_row>& rows)
{
    constexpr int32_t CASE_OK = 0;
    constexpr int32_t CASE_FAILED = 1;
    const uint32_t rank = res.rank;
    char case_name[32];
    std::snprintf(case_name, sizeof(case_name), "%lluB", static_cast<unsigned long long>(len));

    // 重铺初值。所有参与方都铺完再放行，否则可能「对端已经写进来了，我才清 0」。
    EXAMPLES_ACLCHECK(refill_initial(env.dev_base, res.stage, rank));
    if (!sync.barrier(TAG_LAUNCHED)) {
        std::cout << "[rank " << rank
                  << "] refill barrier failed (a peer rank process exited or the control channel is broken; check "
                     "other ranks' logs)"
                  << std::endl;
        return 1;
    }

    // launch 本档核函数
    std::cout << "[rank " << rank << "] case=" << case_name << ": len=" << len << "B rounds=" << opt.rounds
              << " launching..." << std::endl;
    kernel_context context{};
    context.channel_handle = static_cast<uint64_t>(res.channel);
    context.recv_channel_handle = static_cast<uint64_t>(res.recv_channel);
    context.local_buffer_addr = reinterpret_cast<uint64_t>(res.share_buf);
    context.remote_buffer_addr = res.remote_buf;
    context.recv_remote_buffer_addr = res.recv_remote_buf;
    context.msg_bytes = len;
    context.rounds = opt.rounds;
    context.api_mask = opt.api_mask;
    context.commit_inline = opt.commit_inline;
    context.metric_mask = opt.metric_mask;
    for (uint32_t api_idx = 0U; api_idx < API_IDX_COUNT; ++api_idx) {
        for (uint32_t j = 0U; j < TIMING_WORDS; ++j) {
            context.timing[api_idx][j] = 0U;
        }
    }
    context.drain_ret = 0U;
    context.result = KERNEL_SUCCESS;
    EXAMPLES_ACLCHECK(
        aclrtMemcpy(res.device_context, sizeof(context), &context, sizeof(context), ACL_MEMCPY_HOST_TO_DEVICE));
    launch_urma_normal_api_perf(
        res.stream, reinterpret_cast<uint64_t>(reinterpret_cast<uintptr_t>(res.device_context)));
    const aclError sync_ret = aclrtSynchronizeStream(res.stream);
    if (sync_ret != ACL_SUCCESS) {
        std::cout << "[rank " << rank << "][FAIL] case=" << case_name << " aclrtSynchronizeStream = " << sync_ret
                  << " (507035 = vector core exception, kernel died on AIV)" << std::endl;
        return sync_ret;
    }

    // 收尾同步：等写本卡的卡也收尾完，本卡再读落点区
    if (!sync.barrier(TAG_DRAINED)) {
        std::cout << "[rank " << rank
                  << "] drain barrier failed (a peer rank process exited or the control channel is broken; check other "
                     "ranks' logs)"
                  << std::endl;
        return 1;
    }

    // 拷回 kernel 结果
    EXAMPLES_ACLCHECK(
        aclrtMemcpy(&context, sizeof(context), res.device_context, sizeof(context), ACL_MEMCPY_DEVICE_TO_HOST));
    if (context.result != KERNEL_SUCCESS) {
        std::cout << "[rank " << rank << "][FAIL] case=" << case_name << " "
                  << kernel_result_name(static_cast<kernel_result>(context.result))
                  << ", asccommRet=" << context.timing[0][WARMUP_METRIC_INDEX] << ", drainRet=" << context.drain_ret
                  << std::endl;
        // 不直接 break：先走到档末同步（全体合并判定），否则对端会卡在同步点上
    }

    // 打性能结果行（公共 utils/perf_result.h）：每个「接口 × 口径」组合一行，
    // 样本数 = rounds；timing 第一维按接口分槽，--api all 时各接口各取各的计时
    bool case_ok = context.result == KERNEL_SUCCESS;
    if (case_ok) {
        const uint32_t api_idx_bits[] = {API_WRITE, API_READ, API_NOTIFY};
        for (uint32_t api_idx = 0U; api_idx < API_IDX_COUNT; ++api_idx) {
            if ((opt.api_mask & api_idx_bits[api_idx]) == 0U) {
                continue;
            }
            examples::collect_perf_rows(
                context.timing[api_idx], rank, api_idx_bits[api_idx], opt.metric_mask, opt.rounds, len, 1U,
                commit_name(opt.commit_inline), examples::perf_type_name(opt.topo_type), rows);
        }
    }

    // 校验（kernel 失败时 case_ok 已为 false，只补日志不读内存）
    if (case_ok) {
        EXAMPLES_ACLCHECK(validate_case(opt, env, res.stage, rank, len, case_ok));
    }

    std::cout << "[rank " << rank << "] case=" << case_name << " validation: " << (case_ok ? "PASS" : "FAIL")
              << " (checked " << (len >> 20) << "MB per region)" << std::endl;

    // 全体合并判定：一方失败就都停（单方 break 会让对端卡死在同步点上）
    const uint32_t flags = case_ok ? 1U : 0U;
    std::vector<uint32_t> all_flags(nranks, 0U);
    if (!sync.allgather(TAG_CASE_END, &flags, sizeof(flags), all_flags.data())) {
        std::cout << "[rank " << rank
                  << "] case-end allgather failed (a peer rank process exited or the control channel is broken; check "
                     "other ranks' logs)"
                  << std::endl;
        return 1;
    }
    for (uint32_t r = 0U; r < nranks; ++r) {
        if (all_flags[r] == 0U) {
            if (case_ok) {
                std::cout << "[rank " << rank << "] peer rank " << r << " failed case=" << case_name
                          << ", skip the remaining cases" << std::endl;
            } else {
                std::cout << "[rank " << rank << "] case=" << case_name << " failed, skip the remaining cases"
                          << std::endl;
            }
            case_ok = false; // 防止「本卡过、对端挂」时继续进下一档
        }
    }
    return case_ok ? CASE_OK : CASE_FAILED;
}

// 通信 rank 的主流程：打印参数 → 环境搭建 → 取对端地址 → 逐档 run_one_case → 汇总落盘。
// p2p 与 ring 都走本函数，差别只在 topo 里的对端角色。
int32_t run_comm_rank(
    examples::rank_sync_context& sync, uint32_t rank, uint32_t nranks, const run_options& opt,
    const examples::rank_topology& topo)
{
    const std::vector<uint64_t> lens = build_ladder_checked(rank, opt);
    if (lens.empty()) {
        return 1;
    }

    // 打印本次测试的参数组合
    std::cout << "[rank " << rank << "] config: exponent=" << opt.min_exp << ".." << opt.max_exp << " (" << lens.size()
              << " cases)";
    for (uint64_t len : lens) {
        std::cout << " " << len << "B";
    }
    std::cout << "\n[rank " << rank << "] config: perf_type=" << examples::perf_type_name(opt.topo_type)
              << ", nranks=" << nranks << ", send->rank " << topo.send_rank << ", read<-rank " << topo.recv_rank
              << ", api=" << api_mask_name(opt.api_mask) << ", commit=" << commit_name(opt.commit_inline)
              << ", metric=" << metric_mask_name(opt.metric_mask) << ", rounds=" << opt.rounds << std::endl;

    rank_resources res;
    res.rank = rank;

    const int32_t env_ret = init_rank_env(sync, res, topo);
    if (env_ret != 0) {
        return env_ret;
    }

    const int32_t send_ret = resolve_remote_buf(res, res.channel, topo.send_rank, res.remote_buf);
    if (send_ret != 0) {
        return send_ret;
    }
    const int32_t recv_ret = resolve_remote_buf(res, res.recv_channel, topo.recv_rank, res.recv_remote_buf);
    if (recv_ret != 0) {
        return recv_ret;
    }

    // 建链 / 远端内存表就绪后再进档位循环
    if (!sync.barrier(TAG_READY)) {
        std::cout << "[rank " << rank
                  << "] ready barrier failed (a peer rank process exited or the control channel is broken; check other "
                     "ranks' logs)"
                  << std::endl;
        return 1;
    }

    std::vector<perf_row> rows;
    bool ok = true;
    case_env env;
    env.dev_base = static_cast<uint8_t*>(res.share_buf);
    // 落点区数据都来自上游卡（ring 下 = recv_rank）
    env.peer_pattern = SRC_PATTERN_BASE + static_cast<int32_t>(topo.recv_rank);
    env.my_pattern = SRC_PATTERN_BASE + static_cast<int32_t>(rank);
    for (uint64_t len : lens) {
        if (!ok) {
            break;
        }
        const int32_t case_ret = run_one_case(sync, res, opt, nranks, len, env, rows);
        if (case_ret != 0) {
            // 1 = 本档失败（走退出码 2），其他 = 错误码原样透传
            if (case_ret != 1) {
                return case_ret;
            }
            ok = false;
        }
    }

    std::cout << "\n[rank " << rank << "] ===== urma_normal_api_perf: " << (ok ? "PASS" : "FAIL")
              << " =====" << std::endl;

    // 终局结果交换（公共 utils/perf_result.h）：各 rank 的行经 allgather 汇聚到
    // rank 0 落盘；容量上界按同一命令行推出，各 rank 一致
    const size_t row_capacity =
        lens.size() * examples::popcount32(opt.api_mask) * examples::popcount32(opt.metric_mask);
    if (!examples::gather_perf_rows_to_root(
            sync, rank, nranks, row_capacity, commit_name(opt.commit_inline), examples::perf_type_name(opt.topo_type),
            rows)) {
        std::cout << "[rank " << rank
                  << "] result exchange failed (a peer rank process exited or the control channel is broken; check "
                     "other ranks' logs), csv falls back to own rows only"
                  << std::endl;
    }

    // rank 0 落盘汇聚后的全量 CSV
    if (rank == 0U) {
        examples::write_perf_csv(rows, "perf_data.csv");
        std::cout << "[rank 0] perf data written to perf_data.csv (" << rows.size() << " rows)" << std::endl;
    }

    return ok ? 0 : 2;
}

// 空闲 rank（p2p 且 rank >= 2）：不注册内存、不建链、不起核，
// 只应答各个集合点保证通信域与同步序列完整，无性能数据。
int32_t run_idle_rank(examples::rank_sync_context& sync, uint32_t rank, uint32_t nranks, const run_options& opt)
{
    const std::vector<uint64_t> lens = examples::build_len_ladder(opt.min_exp, opt.max_exp);
    const size_t row_capacity =
        lens.size() * examples::popcount32(opt.api_mask) * examples::popcount32(opt.metric_mask);
    {
        // 通信域包含全体 rank，空闲 rank 也参加 root info 交换；
        // HcclCommInitRootInfo 内部查询设备，须先 aclInit + SetDevice。
        // 建出的通信域本 rank 不使用，立即销毁。
        EXAMPLES_ACLCHECK(aclInit(nullptr));
        EXAMPLES_ACLCHECK(aclrtSetDevice(rank));
        HcclComm idle_comm = nullptr;
        (void)examples::init_comm_by_root_info(sync, &idle_comm);
        if (idle_comm != nullptr) {
            (void)HcclCommDestroy(idle_comm);
        }
        (void)aclrtResetDevice(static_cast<int32_t>(rank));
        (void)aclFinalize();
    }
    if (!sync.barrier(TAG_READY)) {
        return 1;
    }
    // 档末投票与通信方同票停表：任一 rank 失败即跳出，两侧序列等长
    uint32_t idle_flag = 1U;
    std::vector<uint32_t> idle_all_flags(nranks, 0U);
    for (size_t i = 0; i < lens.size(); ++i) {
        if (!sync.barrier(TAG_LAUNCHED) || !sync.barrier(TAG_DRAINED) ||
            !sync.allgather(TAG_CASE_END, &idle_flag, sizeof(idle_flag), idle_all_flags.data())) {
            return 1;
        }
        bool stop = false;
        for (uint32_t r = 0U; r < nranks; ++r) {
            stop = stop || (idle_all_flags[r] == 0U);
        }
        if (stop) {
            std::cout << "[rank " << rank << "] peer failed, skip the remaining cases" << std::endl;
            break;
        }
    }
    // 终局结果交换：空表到场即可；容量与通信方一致（Allgather 等长载荷）
    std::vector<perf_row> no_rows;
    if (!examples::gather_perf_rows_to_root(
            sync, rank, nranks, row_capacity, commit_name(opt.commit_inline), examples::perf_type_name(opt.topo_type),
            no_rows)) {
        return 1;
    }
    std::cout << "[rank " << rank << "] idle rank (p2p): finished without communication" << std::endl;
    return 0;
}

// rank 侧主入口：建同步通道 → 按拓扑分角色，通信 rank 跑测试、空闲 rank 只挂集合点。
int32_t run_urma_normal_api_perf_rank(
    uint32_t rank, uint32_t nranks, const std::string& ctrl_endpoint, const run_options& opt)
{
    examples::rank_sync_context sync = rank == 0U ?
                                           examples::rank_sync_context::make_listen(ctrl_endpoint, nranks) :
                                           examples::rank_sync_context::make_connect(rank, nranks, ctrl_endpoint);
    if (!sync.ok()) {
        std::cout << "[rank " << rank
                  << "] control channel setup failed (endpoint occupied or unreachable; use a free port and check "
                     "tcp://ip:port)"
                  << std::endl;
        return 1;
    }

    const examples::rank_topology topo = examples::build_rank_topology(rank, nranks, opt.topo_type);
    return topo.active ? run_comm_rank(sync, rank, nranks, opt, topo) : run_idle_rank(sync, rank, nranks, opt);
}

// 解析 main 的命令行，失败时打印 usage 并返回 false。
// rank 数由 --ranks 指定（默认 2）。
bool parse_command_line(int argc, char* argv[], std::string& endpoint, uint32_t& nranks, run_options& opt)
{
    if (argc < 2) {
        std::cout << "Usage: " << argv[0] << " <tcp://ip:port> [options]" << std::endl;
        std::cout << "Options:" << std::endl;
        std::cout << "  --ranks N                 Number of rank processes to launch, default: 2" << std::endl;
        std::cout << "  --perf_type p2p|ring      Communication topology, default: p2p" << std::endl;
        std::cout << "  --exponent-range min max  Data size exponent range (2^exp, supported 3-28, default 8B..128KB)"
                  << std::endl;
        std::cout << "  --exponent exp            Single exponent (runs only 2^exp)" << std::endl;
        std::cout << "  --api all|write|read|notify[,..]  APIs to measure, default: all" << std::endl;
        std::cout << "  --metric all|lat|bw[,..]  lat = issue latency (no drain in window) / bw = end-to-end (with "
                     "drain), default: all"
                  << std::endl;
        std::cout << "  --commit inline|final     inline = commit=true per call / final = commit=false + one commit "
                     "per window, default: inline"
                  << std::endl;
        std::cout << "  --rounds N                Timed iterations per case, default: 1000" << std::endl;
        return false;
    }
    endpoint = argv[1];
    for (int i = 2; i < argc; ++i) {
        const std::string arg = argv[i];
        const char* val = (i + 1 < argc) ? argv[i + 1] : nullptr;
        if (arg == "--ranks" && val != nullptr) {
            if (!examples::parse_uint32(val, nranks, 2)) {
                std::cout << "invalid --ranks '" << val << "' (expect an integer >= 2)" << std::endl;
                return false;
            }
            ++i;
        } else if (arg == "--perf_type" && val != nullptr) {
            if (!examples::parse_perf_type(val, opt.topo_type)) {
                std::cout << "invalid --perf_type '" << val << "' (expect p2p or ring)" << std::endl;
                return false;
            }
            ++i;
        } else if (arg == "--exponent" && val != nullptr) {
            if (!examples::parse_uint64(val, opt.min_exp) || opt.min_exp < 3 || opt.min_exp > 28) {
                std::cout << "invalid --exponent '" << val << "' (expect 3 <= exp <= 28, datasize = 2^exp)"
                          << std::endl;
                return false;
            }
            opt.max_exp = opt.min_exp;
            ++i;
        } else if (arg == "--exponent-range" && val != nullptr && (i + 2 < argc)) {
            if (!examples::parse_uint64(val, opt.min_exp) || !examples::parse_uint64(argv[i + 2], opt.max_exp) ||
                opt.min_exp < 3 || opt.max_exp > 28) {
                std::cout << "invalid --exponent-range '" << val << " " << argv[i + 2]
                          << "' (expect minExp maxExp, datasize = 2^exp)" << std::endl;
                return false;
            }
            i += 2;
        } else if (arg == "--api" && val != nullptr) {
            static const char* const API_NAMES[] = {"write", "read", "notify", nullptr};
            if (!examples::parse_mask(val, API_NAMES, API_ALL, opt.api_mask) || opt.api_mask == 0U) {
                std::cout << "invalid --api '" << val << "' (expect all or write|read|notify, comma separated)"
                          << std::endl;
                return false;
            }
            ++i;
        } else if (arg == "--metric" && val != nullptr) {
            static const char* const METRIC_NAMES[] = {"lat", "bw", nullptr};
            if (!examples::parse_mask(val, METRIC_NAMES, METRIC_ALL, opt.metric_mask) || opt.metric_mask == 0U) {
                std::cout << "invalid --metric '" << val << "' (expect all or lat|bw, comma separated)" << std::endl;
                return false;
            }
            ++i;
        } else if (arg == "--commit" && val != nullptr) {
            const std::string commit = val;
            if (commit == "inline") {
                opt.commit_inline = 1;
            } else if (commit == "final") {
                opt.commit_inline = 0;
            } else {
                std::cout << "invalid --commit '" << val << "' (expect inline or final)" << std::endl;
                return false;
            }
            ++i;
        } else if (arg == "--rounds" && val != nullptr) {
            if (!examples::parse_uint32(val, opt.rounds, 1)) {
                std::cout << "invalid --rounds '" << val << "' (expect positive integer)" << std::endl;
                return false;
            }
            ++i;
        } else {
            std::cout << "unknown or incomplete option '" << arg << "'" << std::endl;
            return false;
        }
    }
    return true;
}

} // namespace

int main(int argc, char* argv[])
{
    std::string endpoint;
    run_options opt;
    uint32_t nranks = 2;
    if (!parse_command_line(argc, argv, endpoint, nranks, opt)) {
        return 1;
    }

    std::vector<examples::args_of<decltype(run_urma_normal_api_perf_rank)>> per_rank_args;
    per_rank_args.reserve(nranks);
    for (uint32_t rank = 0; rank < nranks; ++rank) {
        per_rank_args.emplace_back(rank, nranks, endpoint, opt);
    }

    examples::process_group group;
    if (!group.launch(nranks, run_urma_normal_api_perf_rank, std::move(per_rank_args))) {
        return 1;
    }
    const bool pass = group.wait_all();

    if (group.interrupted()) {
        std::cout << "RESULT | Example=urma_normal_api_perf | Status=INTERRUPTED" << std::endl;
        return 1;
    }
    std::cout << "RESULT | Example=urma_normal_api_perf | Status=" << (pass ? "PASS" : "FAIL") << std::endl;
    return pass ? 0 : 1;
}
