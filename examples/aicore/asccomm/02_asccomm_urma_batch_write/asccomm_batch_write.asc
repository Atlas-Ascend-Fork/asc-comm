extern "C" __vector__ __global__ __aicore__ void asccomm_batch_write_kernel(GM_ADDR context);

namespace {

// 本样例host侧同步点的tag：地址allgather与kernel前后两个barrier。
constexpr uint32_t TAG_BUFFERS = examples::TAG_USER_BASE;
constexpr uint32_t TAG_CHANNELS_READY = examples::TAG_USER_BASE + 1U;
constexpr uint32_t TAG_KERNEL_DONE = examples::TAG_USER_BASE + 2U;

using namespace asccomm_batch_write_example;

constexpr int32_t SUCCESS = 0;
constexpr int32_t FAILURE = 1;
constexpr int64_t SOCKET_TIMEOUT_SECONDS = 60;

// 按本端endpoint分组的peer集合：组内共享一条多通道提交队列。
struct endpoint_group {
    EndpointDesc local_endpoint{};               // 组内共享的本端endpoint
    std::vector<uint32_t> peer_ranks;            // 组内对端rank列表
    std::vector<HcclChannelDesc> channel_descs;  // 组内各peer的channel描述
    asc::multi_channel_handle multi_channel{0U}; // 组的多通道句柄
};

// 单rank的运行期资源，析构时按申请逆序自动释放。
struct rank_resources {
    rank_resources() = default;

    ~rank_resources()
    {
        if (comm != nullptr) {
            (void)HcclCommDestroy(comm);
        }
        if (device_context != nullptr) {
            (void)aclrtFree(device_context);
        }
        if (device_buffer != nullptr) {
            (void)aclrtFree(device_buffer);
        }
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (device_set) {
            (void)aclrtResetDevice(static_cast<int32_t>(rank));
        }
        if (acl_initialized) {
            (void)aclFinalize();
        }
    }

    rank_resources(const rank_resources&) = delete;
    rank_resources& operator=(const rank_resources&) = delete;

    uint32_t rank{0U};                 // 当前rankId
    uint32_t rank_num{0U};             // rank总数
    bool acl_initialized{false};       // ACL初始化标志
    bool device_set{false};            // 设备绑定标志
    aclrtStream stream{nullptr};       // 执行流
    HcclComm comm{nullptr};            // 通信域
    void* device_buffer{nullptr};      // 通信buffer
    uint8_t* device_context{nullptr};  // kernel上下文device副本
    HcclMemHandle mem_handle{nullptr}; // 注册内存句柄
};

// 通信buffer大小：接收基址 + rank_num个分片。
uint64_t get_comm_buffer_size(uint32_t rank_num)
{
    return RECV_BASE_OFFSET + static_cast<uint64_t>(rank_num) * DATA_SIZE;
}

uint8_t get_data_value(uint32_t rank, uint32_t offset) { return static_cast<uint8_t>(rank * 53U + offset); }

// 按rank填充本端分片数据（第0字节为rank_id，其余递增）。
void fill_source_data(std::vector<uint8_t>& buffer, uint32_t rank)
{
    for (uint32_t offset = 0U; offset < DATA_SIZE; ++offset) {
        buffer[SEND_OFFSET + offset] = get_data_value(rank, offset);
    }
}

// kernel错误码 -> 可读信息。
const char* get_kernel_error(kernel_result result)
{
    switch (result) {
        case KERNEL_WRITE_FAILED:
            return "asccomm_write_nbi failed";
        case KERNEL_COMMIT_FAILED:
            return "asccomm_batch_commit failed";
        case KERNEL_DRAIN_FAILED:
            return "asccomm_drain failed";
        default:
            return "unknown kernel error";
    }
}

// 初始化ACL并创建stream。
int32_t init_acl(rank_resources& resources)
{
    EXAMPLES_CHECK(aclInit(nullptr), ACL_SUCCESS, resources.rank);
    resources.acl_initialized = true;

    uint32_t device_count = 0U;
    EXAMPLES_CHECK(aclrtGetDeviceCount(&device_count), ACL_SUCCESS, resources.rank);
    if (device_count < resources.rank_num) {
        std::fprintf(
            stderr, "[ERROR] rank %u: %u devices are required, found %u\n", resources.rank, resources.rank_num,
            device_count);
        return FAILURE;
    }
    EXAMPLES_CHECK(aclrtSetDevice(static_cast<int32_t>(resources.rank)), ACL_SUCCESS, resources.rank);
    resources.device_set = true;
    EXAMPLES_CHECK(aclrtCreateStream(&resources.stream), ACL_SUCCESS, resources.rank);
    return SUCCESS;
}

// 创建通信域：root info经控制通道allgather对齐，经HcclCommConfig设置hcclWorldRankID。
int32_t init_communicator(rank_resources& resources, examples::rank_sync_context& sync)
{
    HcclCommConfig config{};
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = resources.rank;
    EXAMPLES_CHECK(
        examples::init_comm_by_root_info_config(sync, &config, &resources.comm), HCCL_SUCCESS, resources.rank);
    return SUCCESS;
}

// 分配通信buffer、按tag注册，并经allgather交换各rank的buffer地址。
int32_t prepare_memory(
    rank_resources& resources, examples::rank_sync_context& sync, std::vector<uint64_t>& remote_buffers)
{
    const uint64_t comm_buffer_size = get_comm_buffer_size(resources.rank_num);
    EXAMPLES_CHECK(
        aclrtMalloc(&resources.device_buffer, comm_buffer_size, ACL_MEM_MALLOC_HUGE_FIRST), ACL_SUCCESS,
        resources.rank);
    EXAMPLES_CHECK(
        aclrtMalloc(
            reinterpret_cast<void**>(&resources.device_context), sizeof(batch_context), ACL_MEM_MALLOC_HUGE_FIRST),
        ACL_SUCCESS, resources.rank);

    std::vector<uint8_t> host_buffer(static_cast<size_t>(comm_buffer_size), 0U);
    fill_source_data(host_buffer, resources.rank);
    EXAMPLES_CHECK(
        aclrtMemcpy(
            resources.device_buffer, comm_buffer_size, host_buffer.data(), comm_buffer_size, ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, resources.rank);

    CommMem memory{};
    memory.type = COMM_MEM_TYPE_DEVICE;
    memory.addr = resources.device_buffer;
    memory.size = comm_buffer_size;
    EXAMPLES_CHECK(
        HcclCommMemReg(resources.comm, MEMORY_TAG, &memory, &resources.mem_handle), HCCL_SUCCESS, resources.rank);

    // 各rank上报本端buffer地址，allgather后所有rank都拿到全表。
    const uint64_t local_buffer = reinterpret_cast<uint64_t>(resources.device_buffer);
    remote_buffers.resize(resources.rank_num);
    if (!sync.allgather(TAG_BUFFERS, &local_buffer, sizeof(local_buffer), remote_buffers.data())) {
        std::fprintf(stderr, "[ERROR] rank %u: buffer address allgather failed\n", resources.rank);
        return FAILURE;
    }
    for (uint32_t rank = 0U; rank < resources.rank_num; ++rank) {
        if (remote_buffers[rank] == 0U) {
            std::fprintf(stderr, "[ERROR] rank %u: received null buffer for rank %u\n", resources.rank, rank);
            return FAILURE;
        }
    }
    return SUCCESS;
}

// 比较两个endpoint描述的原始字段是否一致（用于peer按本端endpoint分组）。
bool has_same_raws(const EndpointDesc& lhs, const EndpointDesc& rhs)
{
    return std::memcmp(lhs.commAddr.raws, rhs.commAddr.raws, sizeof(lhs.commAddr.raws)) == 0;
}

endpoint_group& find_or_add_group(const EndpointDesc& local_endpoint, std::vector<endpoint_group>& groups)
{
    for (endpoint_group& group : groups) {
        if (has_same_raws(group.local_endpoint, local_endpoint)) {
            return group;
        }
    }
    groups.push_back(endpoint_group{});
    groups.back().local_endpoint = local_endpoint;
    return groups.back();
}

// 将peer的channel描述加入其本端endpoint对应的分组。
int32_t add_peer_to_group(
    rank_resources& resources, uint32_t peer_rank, const HcclChannelDesc& desc, std::vector<endpoint_group>& groups)
{
    endpoint_group& group = find_or_add_group(desc.localEndpoint, groups);
    group.peer_ranks.push_back(peer_rank);
    group.channel_descs.push_back(desc);
    return SUCCESS;
}

// 与各peer建链并按本端endpoint分组。
int32_t build_endpoint_groups(rank_resources& resources, std::vector<endpoint_group>& groups)
{
    std::vector<uint32_t> peer_ranks;
    if (resources.rank == 0U) {
        for (uint32_t peer_rank = 1U; peer_rank < resources.rank_num; ++peer_rank) {
            peer_ranks.push_back(peer_rank);
        }
    } else {
        peer_ranks.push_back(0U);
    }

    for (uint32_t peer_rank : peer_ranks) {
        // 与对端建链并填充channel描述，随后按本端endpoint将peer分入同一通道组。
        HcclChannelDesc desc{};
        EXAMPLES_CHECK(
            examples::find_channel_desc(
                resources.comm, resources.rank, peer_rank, COMM_PROTOCOL_UB_CTP, &resources.mem_handle, 1U, desc),
            HCCL_SUCCESS, resources.rank);
        EXAMPLES_CHECK(add_peer_to_group(resources, peer_rank, desc, groups), SUCCESS, resources.rank);
    }
    return SUCCESS;
}

// 为每个分组创建多通道句柄（组内共享提交队列）。
int32_t create_multi_channel_handles(rank_resources& resources, std::vector<endpoint_group>& groups)
{
    // 采用通信域重载创建多通道句柄：通道资源随通信域销毁自动释放；
    // 同一本端endpoint的peer分入同一组，组内共享提交队列。
    for (size_t group_index = 0U; group_index < groups.size(); ++group_index) {
        endpoint_group& group = groups[group_index];
        const std::string shared_queue_tag = std::string(SHARED_QUEUE_TAG_PREFIX) + "_" +
                                             std::to_string(resources.rank) + "_" + std::to_string(group_index);
        EXAMPLES_CHECK(
            asc::asccomm_make_multi_channel_handle(
                resources.comm, shared_queue_tag.c_str(), group.channel_descs.data(),
                static_cast<uint32_t>(group.channel_descs.size()), &group.multi_channel),
            HCCL_SUCCESS, resources.rank);
        std::printf(
            "[rank %u] endpoint group %zu has %zu peer(s)\n", resources.rank, group_index, group.peer_ranks.size());
    }
    return SUCCESS;
}

// 单分组批量写：绑定多通道批量句柄，逐逻辑通道下发写任务，统一提交并asccomm_drain。
int32_t run_group_kernel(
    rank_resources& resources, const endpoint_group& group, const std::vector<uint64_t>& remote_buffers)
{
    if (group.peer_ranks.empty() || group.peer_ranks.size() > MAX_CHANNEL_NUM) {
        return FAILURE;
    }

    batch_context context{};
    context.multi_channel = group.multi_channel;
    context.local_buffer = reinterpret_cast<uint64_t>(resources.device_buffer);
    context.channel_num = static_cast<uint32_t>(group.peer_ranks.size());
    context.result = KERNEL_SUCCESS;
    context.asccomm_result = 0;
    for (size_t channel_index = 0U; channel_index < group.peer_ranks.size(); ++channel_index) {
        context.remote_buffers[channel_index] = remote_buffers[group.peer_ranks[channel_index]];
    }

    EXAMPLES_CHECK(
        aclrtMemcpy(resources.device_context, sizeof(context), &context, sizeof(context), ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, resources.rank);
    asccomm_batch_write_kernel<<<1U, nullptr, resources.stream>>>(resources.device_context);
    EXAMPLES_CHECK(aclrtSynchronizeStream(resources.stream), ACL_SUCCESS, resources.rank);
    EXAMPLES_CHECK(
        aclrtMemcpy(&context, sizeof(context), resources.device_context, sizeof(context), ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, resources.rank);
    if (context.result != KERNEL_SUCCESS) {
        std::fprintf(
            stderr, "[ERROR] rank %u: %s, asccomm ret=%d\n", resources.rank, get_kernel_error(context.result),
            context.asccomm_result);
        return FAILURE;
    }
    return SUCCESS;
}

// 回读通信buffer，校验收到的全部分片数据。
int32_t validate_results(const rank_resources& resources)
{
    const uint64_t comm_buffer_size = get_comm_buffer_size(resources.rank_num);
    std::vector<uint8_t> host_buffer(static_cast<size_t>(comm_buffer_size), 0U);
    EXAMPLES_CHECK(
        aclrtMemcpy(
            host_buffer.data(), comm_buffer_size, resources.device_buffer, comm_buffer_size, ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, resources.rank);

    const uint64_t receive_offset = RECV_BASE_OFFSET;
    for (uint32_t offset = 0U; offset < DATA_SIZE; ++offset) {
        uint8_t actual = host_buffer[receive_offset + offset];
        uint8_t expected = get_data_value(0U, offset);
        if (actual != expected) {
            std::fprintf(
                stderr, "[ERROR] rank %u: data from rank 0 mismatch at %u, actual=0x%02x, expected=0x%02x\n",
                resources.rank, offset, actual, expected);
            return FAILURE;
        }
    }
    std::printf("[rank %u] asccomm_batch_write | received and verified data from rank 0 | PASS\n", resources.rank);
    return SUCCESS;
}

// rank入口函数，由process_group在每个子进程中调用；返回值即进程退出码。
int32_t run_rank(uint32_t rank, uint32_t rank_num, const std::string& ctrl_endpoint)
{
    rank_resources resources{};
    resources.rank = rank;
    resources.rank_num = rank_num;

    examples::rank_sync_context sync = rank == 0U ?
                                           examples::rank_sync_context::make_listen(ctrl_endpoint, rank_num) :
                                           examples::rank_sync_context::make_connect(rank, rank_num, ctrl_endpoint);
    if (!sync.ok()) {
        std::fprintf(stderr, "[ERROR] rank %u: control channel setup failed\n", rank);
        return FAILURE;
    }

    // 初始化ACL并创建stream。
    EXAMPLES_CHECK(init_acl(resources), SUCCESS, rank);
    // 创建通信域。
    EXAMPLES_CHECK(init_communicator(resources, sync), SUCCESS, rank);

    std::vector<uint64_t> remote_buffers;
    // 分配通信buffer、按tag注册，并经allgather交换各rank的buffer地址。
    EXAMPLES_CHECK(prepare_memory(resources, sync, remote_buffers), SUCCESS, rank);

    std::vector<endpoint_group> groups;
    EXAMPLES_CHECK(build_endpoint_groups(resources, groups), SUCCESS, rank);
    // 为每个分组创建多通道句柄（组内共享提交队列）。
    EXAMPLES_CHECK(create_multi_channel_handles(resources, groups), SUCCESS, rank);

    // 全体通道建好后再下发kernel：kernel读对端内存表，建链未完成时读到的是空表。
    if (!sync.barrier(TAG_CHANNELS_READY)) {
        std::fprintf(stderr, "[ERROR] rank %u: channels-ready barrier failed\n", rank);
        return FAILURE;
    }
    if (rank == 0U) {
        // rank 0逐分组批量下发跨peer写任务。
        for (const endpoint_group& group : groups) {
            EXAMPLES_CHECK(run_group_kernel(resources, group, remote_buffers), SUCCESS, rank);
        }
    }
    // rank 0的写全部落地后其余rank才校验，否则校验的是未写完的buffer。
    if (!sync.barrier(TAG_KERNEL_DONE)) {
        std::fprintf(stderr, "[ERROR] rank %u: kernel-done barrier failed\n", rank);
        return FAILURE;
    }
    return rank == 0U ? SUCCESS : validate_results(resources);
}
} // namespace

// 父进程：解析命令行，拉起全部rank子进程并汇总结果。
int32_t main(int32_t argc, char** argv)
{
    if (argc != 3) {
        std::fprintf(stderr, "Usage: %s <tcp://ip:port> <rank_size>\n", argv[0]);
        return FAILURE;
    }
    uint32_t rank_num = 0;
    if (!examples::parse_uint32(argv[2], rank_num, 2) || rank_num > MAX_RANK_NUM) {
        std::fprintf(stderr, "invalid rank_size: %s, expected an integer in [2, %u]\n", argv[2], MAX_RANK_NUM);
        return FAILURE;
    }
    const std::string endpoint = argv[1];
    (void)signal(SIGPIPE, SIG_IGN);

    std::vector<examples::args_of<decltype(run_rank)>> per_rank_args;
    per_rank_args.reserve(rank_num);
    for (uint32_t rank = 0U; rank < rank_num; ++rank) {
        per_rank_args.emplace_back(rank, rank_num, endpoint);
    }

    examples::process_group group;
    if (!group.launch(rank_num, run_rank, std::move(per_rank_args))) {
        return FAILURE;
    }
    const bool passed = group.wait_all();

    std::printf("RESULT | Example=asccomm_batch_write | Status=%s\n", passed ? "PASS" : "FAIL");
    return passed ? SUCCESS : FAILURE;
}
