/*!
 * \file simt_jetty.asc
 * \brief SIMT Jetty WRITE样例Host侧流程：通信域创建、内存注册、P2P通道创建与结果校验
 */

#include <cstdint>
#include <csignal>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <iomanip>
#include <iostream>
#include <string>
#include <vector>

#include "hccl/hccl.h"
#include "hccl/hccl_res.h"
#include "hccl/hccl_types.h"
#include "hccl/hccl_rank_graph.h"
#include "jetty/asccomm_jetty.h"

#include "utils/check.h"
#include "utils/hccl_comm_init.h"
#include "utils/process_manager.h"
#include "utils/rank_sync.h"
#include "utils/arg_parser.h"

#include "simt_jetty_common.h"

extern void launch_simt_jetty(
    void* stream, uint64_t channel, void* jetty_ptr_table, uint32_t send_buf_idx, uint32_t recv_buf_idx, uint32_t mode,
    void* timing, uint32_t iterations, uint32_t warmup);

namespace {

using namespace simt_jetty;

// Jetty的SIMT路径只在UBC_CTP协议上实现，其余链路协议无对应实现。
constexpr CommProtocol TARGET_COMM_PROTOCOL = COMM_PROTOCOL_UBC_CTP;

// 两块内存注册到通信域时使用的tag。两个rank使用相同tag，远端内存才能按tag查回。
constexpr const char* SEND_BUF_TAG = "simtJettySendBuf";
constexpr const char* RECV_BUF_TAG = "simtJettyRecvBuf";

// 一张表同时驱动解析和打印，避免某个mode能被解析、却打印成另一个名字。
struct mode_entry {
    const char* name;
    uint32_t mode;
};

constexpr mode_entry MODES[] = {
    {"thread", MODE_THREAD},     {"warp-pad", MODE_WARP_PAD}, {"group", MODE_GROUP},
    {"dispatch", MODE_DISPATCH}, {"warp", MODE_WARP},         {"mixed", MODE_MIXED},
};

// 显式传入却不匹配任何mode是笔误而非取默认值，因此直接拒绝。
bool parse_mode(const std::string& name, uint32_t& mode)
{
    for (const mode_entry& entry : MODES) {
        if (name == entry.name) {
            mode = entry.mode;
            return true;
        }
    }
    return false;
}

const char* mode_to_name(uint32_t mode)
{
    for (const mode_entry& entry : MODES) {
        if (mode == entry.mode) {
            return entry.name;
        }
    }
    return "unknown";
}

void print_modes() { std::cout << "  mode: all | thread | warp | warp-pad | group | dispatch | mixed" << std::endl; }

// 与对端建链，并按kRecvBufTag查出对端接收buffer在远端内存表中的索引。kernel侧通过
// jettyPtrTable按索引解析队列信息；本地表index 0保留给CCL buffer，显式注册的内存从1开始。
HcclResult acquire_peer_channel(
    HcclComm comm, uint32_t rank, uint32_t peer_rank, HcclMemHandle* mem_handles, ChannelHandle& channel,
    uint32_t& remote_recv_idx)
{
    HcclChannelDesc desc;
    EXAMPLES_HCCLCHECK(HcclChannelDescInit(&desc, 1));
    desc.remoteRank = peer_rank;
    desc.channelProtocol = TARGET_COMM_PROTOCOL;
    desc.notifyNum = 0;
    desc.memHandles = mem_handles;
    desc.memHandleNum = 2U;

    uint32_t* layers = nullptr;
    uint32_t layer_num = 0U;
    EXAMPLES_HCCLCHECK(HcclRankGraphGetLayers(comm, &layers, &layer_num));
    if (layer_num == 0U || layers == nullptr) {
        std::cout << "[rank " << rank << "] no net layer reported" << std::endl;
        return HCCL_E_INTERNAL;
    }

    CommLink* links = nullptr;
    uint32_t link_num = 0U;
    EXAMPLES_HCCLCHECK(HcclRankGraphGetLinks(comm, layers[0], rank, peer_rank, &links, &link_num));
    bool found = false;
    for (uint32_t i = 0U; i < link_num; ++i) {
        if (links[i].linkAttr.linkProtocol == TARGET_COMM_PROTOCOL) {
            desc.localEndpoint = links[i].srcEndpointDesc;
            desc.remoteEndpoint = links[i].dstEndpointDesc;
            found = true;
            break;
        }
    }
    if (!found) {
        std::cout << "[rank " << rank << "] no UBC_CTP link to peer " << peer_rank << std::endl;
        return HCCL_E_NOT_SUPPORT;
    }

    EXAMPLES_HCCLCHECK(HcclChannelAcquire(comm, COMM_ENGINE_AIV, &desc, 1U, &channel));

    uint32_t mem_num = 0U;
    CommMem* remote_mems = nullptr;
    char** tags = nullptr;
    EXAMPLES_HCCLCHECK(HcclChannelGetRemoteMems(comm, channel, &mem_num, &remote_mems, &tags));
    for (uint32_t i = 0U; i < mem_num; ++i) {
        if (tags[i] != nullptr && std::strcmp(tags[i], RECV_BUF_TAG) == 0) {
            remote_recv_idx = i;
            return HCCL_SUCCESS;
        }
    }
    std::cout << "[rank " << rank << "] remote memory " << RECV_BUF_TAG << " not found on the channel" << std::endl;
    return HCCL_E_INTERNAL;
}

// 期望表覆盖全部slot：写入范围之外的slot应保持清零，一并校验，可发现越界写入。
bool check_words(void* device_buf, const uint64_t expected[SLOT_COUNT])
{
    uint64_t actual[SLOT_COUNT] = {};
    if (aclrtMemcpy(actual, BUFFER_BYTES, device_buf, BUFFER_BYTES, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        return false;
    }
    for (uint32_t slot = 0U; slot < SLOT_COUNT; ++slot) {
        if (actual[slot] != expected[slot]) {
            std::cout << "slot " << slot << " actual=" << actual[slot] << " expected=" << expected[slot] << std::endl;
            return false;
        }
    }
    return true;
}

} // namespace

// 本样例host侧同步点的tag：建链完成、每轮写入落地、接收侧校验完成、计时结束。
constexpr uint32_t TAG_READY = examples::TAG_USER_BASE;
constexpr uint32_t TAG_WRITTEN = TAG_READY + 1U;
constexpr uint32_t TAG_CHECKED = TAG_WRITTEN + 1U;
constexpr uint32_t TAG_TIMED = TAG_CHECKED + 1U;

// 单个rank的执行流程：建链、注册内存、下发kernel并校验。由process_group在每个子进程中调用，
// 只有rank 0（发送方）和rank 1（接收方）建链并执行，其余rank打印SKIP后直接退出。
int run_simt_jetty_rank(
    uint32_t rank, uint32_t nranks, const std::string& ctrl_endpoint, const std::string& mode_name, uint32_t iterations,
    uint32_t warmup, bool device_timing)
{
    if (nranks < 2U) {
        std::cout << "nranks must be at least 2" << std::endl;
        return 1;
    }
    if (rank >= 2U) {
        std::cout << "SKIP | Rank=" << rank << " | Only rank 0 and rank 1 run simt_jetty." << std::endl;
        return 0;
    }

    uint32_t mode = 0U;
    if (!parse_mode(mode_name, mode)) {
        std::cout << "Unknown mode: " << mode_name << std::endl;
        print_modes();
        return 1;
    }
    if (device_timing && mode == MODE_MIXED) {
        std::cout << "mixed mode does not support device timing" << std::endl;
        return 1;
    }

    // 只有rank 0/1参与：控制通道与通信域都只包含这两个rank，其余rank已提前退出。
    // 控制通道与通信域只包含参与测试的前两个rank，其余rank已SKIP退出。
    examples::rank_sync_context sync = rank == 0U ? examples::rank_sync_context::make_listen(ctrl_endpoint, 2U) :
                                                    examples::rank_sync_context::make_connect(rank, 2U, ctrl_endpoint);
    if (!sync.ok()) {
        std::cout << "[rank " << rank << "] control channel setup failed" << std::endl;
        return 1;
    }

    // 初始化ACL并创建stream。
    EXAMPLES_ACLCHECK(aclInit(nullptr));
    EXAMPLES_ACLCHECK(aclrtSetDevice(rank));
    aclrtStream stream = nullptr;
    EXAMPLES_ACLCHECK(aclrtCreateStream(&stream));

    // 创建通信域。
    HcclComm comm = nullptr;
    EXAMPLES_HCCLCHECK(examples::init_comm_by_root_info(sync, &comm));

    // 分配收发buffer并按slot填充初始数据。
    void* send_buf = nullptr;
    void* recv_buf = nullptr;
    EXAMPLES_ACLCHECK(aclrtMalloc(&send_buf, BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    EXAMPLES_ACLCHECK(aclrtMalloc(&recv_buf, BUFFER_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    uint64_t send_init[SLOT_COUNT] = {};
    for (uint32_t slot = 0U; slot < SLOT_COUNT; ++slot) {
        send_init[slot] = slot_value(slot);
    }
    uint64_t recv_init[SLOT_COUNT] = {};
    EXAMPLES_ACLCHECK(aclrtMemcpy(send_buf, BUFFER_BYTES, send_init, BUFFER_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
    EXAMPLES_ACLCHECK(aclrtMemcpy(recv_buf, BUFFER_BYTES, recv_init, BUFFER_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));

    CommMem send_mem{COMM_MEM_TYPE_DEVICE, send_buf, BUFFER_BYTES};
    CommMem recv_mem{COMM_MEM_TYPE_DEVICE, recv_buf, BUFFER_BYTES};
    HcclMemHandle mem_handles[2] = {nullptr, nullptr};
    // 按tag注册收发buffer，供对端按下标访问。
    EXAMPLES_HCCLCHECK(HcclCommMemReg(comm, SEND_BUF_TAG, &send_mem, &mem_handles[0]));
    EXAMPLES_HCCLCHECK(HcclCommMemReg(comm, RECV_BUF_TAG, &recv_mem, &mem_handles[1]));

    const uint32_t peer_rank = rank == 0U ? 1U : 0U;
    ChannelHandle channel = 0U;
    uint32_t remote_recv_idx = 0U;
    EXAMPLES_HCCLCHECK(acquire_peer_channel(comm, rank, peer_rank, mem_handles, channel, remote_recv_idx));

    void* jetty_ptr_table = nullptr;
    EXAMPLES_ACLCHECK(aclrtMalloc(&jetty_ptr_table, sizeof(uint64_t), ACL_MEM_MALLOC_HUGE_FIRST));
    const uint64_t channel_value = static_cast<uint64_t>(channel);
    EXAMPLES_ACLCHECK(aclrtMemcpy(
        jetty_ptr_table, sizeof(channel_value), &channel_value, sizeof(channel_value), ACL_MEMCPY_HOST_TO_DEVICE));

    // 全体建链后再下发kernel：kernel按jetty表提交WQE，建链未完成时表项无效。
    if (!sync.barrier(TAG_READY)) {
        std::cout << "[rank " << rank << "] ready barrier failed" << std::endl;
        return 1;
    }

    // 本地buffer表index 0是CCL buffer，显式注册的内存从1开始。
    constexpr uint32_t LOCAL_SEND_IDX = 1U;
    bool pass = true;
    void* timing_buf = nullptr;
    uint64_t timing[TIMING_WORDS] = {};
    if (rank == 0U) {
        if (device_timing) {
            // warmup与全部计时轮在单次kernel内完成，每轮都会Drain，确保SQ tail持续推进。
            EXAMPLES_ACLCHECK(aclrtMalloc(&timing_buf, sizeof(timing), ACL_MEM_MALLOC_HUGE_FIRST));
            EXAMPLES_ACLCHECK(aclrtMemset(timing_buf, sizeof(timing), 0, sizeof(timing)));
            launch_simt_jetty(
                stream, channel, jetty_ptr_table, LOCAL_SEND_IDX, remote_recv_idx, mode, timing_buf, iterations,
                warmup);
            EXAMPLES_ACLCHECK(aclrtSynchronizeStream(stream));
            EXAMPLES_ACLCHECK(
                aclrtMemcpy(timing, sizeof(timing), timing_buf, sizeof(timing), ACL_MEMCPY_DEVICE_TO_HOST));

            pass = timing[COMPLETED_INDEX] == iterations;
            const double average_write_cycles = static_cast<double>(timing[WRITE_CYCLES_INDEX]) / iterations;
            const double average_commit_cycles = static_cast<double>(timing[COMMIT_CYCLES_INDEX]) / iterations;
            const double average_completion_cycles = static_cast<double>(timing[COMPLETION_CYCLES_INDEX]) / iterations;
            std::cout << std::fixed << std::setprecision(3) << "PERF | mode=" << mode_to_name(mode)
                      << " | iterations=" << iterations << " | warmup=" << warmup
                      << " | write_cycles=" << timing[WRITE_CYCLES_INDEX]
                      << " | average_write_cycles=" << average_write_cycles
                      << " | average_write_us=" << average_write_cycles / 1000.0
                      << " | commit_cycles=" << timing[COMMIT_CYCLES_INDEX]
                      << " | average_commit_cycles=" << average_commit_cycles
                      << " | average_commit_us=" << average_commit_cycles / 1000.0
                      << " | completion_cycles=" << timing[COMPLETION_CYCLES_INDEX]
                      << " | average_completion_cycles=" << average_completion_cycles
                      << " | average_completion_us=" << average_completion_cycles / 1000.0
                      << " | completed=" << timing[COMPLETED_INDEX] << std::endl;
        } else {
            for (uint32_t iteration = 0U; iteration < iterations; ++iteration) {
                launch_simt_jetty(
                    stream, channel, jetty_ptr_table, LOCAL_SEND_IDX, remote_recv_idx, mode, nullptr, 1U, 0U);
                EXAMPLES_ACLCHECK(aclrtSynchronizeStream(stream));
                // 写入落地与接收侧校验各一个barrier：接收侧校验后会清零目标缓冲区，下一轮
                // 写入必须等清零完成，否则可能被清零覆盖。
                if (!sync.barrier(TAG_WRITTEN) || !sync.barrier(TAG_CHECKED)) {
                    std::cout << "[rank 0] iteration barrier failed" << std::endl;
                    return 1;
                }
            }
        }
    }

    if (device_timing && !sync.barrier(TAG_TIMED)) {
        std::cout << "[rank " << rank << "] timed barrier failed" << std::endl;
        return 1;
    }

    if (rank == 1U) {
        uint64_t expected[SLOT_COUNT] = {};
        for (uint32_t slot = 0U; slot < expected_slot_count(mode); ++slot) {
            expected[slot] = slot_value(slot);
        }
        // 计时模式全部轮次写同一份镜像，只校验一次；正确性模式逐轮校验。
        const uint32_t checks = device_timing ? 1U : iterations;
        for (uint32_t iteration = 0U; iteration < checks; ++iteration) {
            if (!device_timing && !sync.barrier(TAG_WRITTEN)) {
                std::cout << "[rank 1] written barrier failed" << std::endl;
                return 1;
            }
            const bool iteration_pass = check_words(recv_buf, expected);
            pass = pass && iteration_pass;
            if (!iteration_pass) {
                std::cout << "[rank 1] simt_jetty " << mode_to_name(mode) << " iteration " << iteration << " FAIL"
                          << " checks=" << expected_slot_count(mode) << std::endl;
            }
            if (!device_timing) {
                if (iteration + 1U < checks) {
                    EXAMPLES_ACLCHECK(aclrtMemset(recv_buf, BUFFER_BYTES, 0, BUFFER_BYTES));
                }
                if (!sync.barrier(TAG_CHECKED)) {
                    std::cout << "[rank 1] checked barrier failed" << std::endl;
                    return 1;
                }
            }
        }
        std::cout << "[rank 1] simt_jetty " << mode_to_name(mode) << " iterations " << checks
                  << (pass ? " PASS" : " FAIL") << std::endl;
    }

    if (timing_buf != nullptr) {
        EXAMPLES_ACLCHECK(aclrtFree(timing_buf));
    }
    EXAMPLES_ACLCHECK(aclrtFree(jetty_ptr_table));
    EXAMPLES_ACLCHECK(aclrtFree(send_buf));
    EXAMPLES_ACLCHECK(aclrtFree(recv_buf));
    EXAMPLES_HCCLCHECK(HcclCommDestroy(comm));
    EXAMPLES_ACLCHECK(aclrtDestroyStream(stream));
    EXAMPLES_ACLCHECK(aclFinalize());
    return pass ? 0 : 2;
}

// 父进程流程：解析命令行（<tcp://ip:port> <nranks> [mode] [options]），逐个模式拉起全部rank
// 进程并汇总结果；每个模式使用独立的进程组，模式间SQ/CQ状态互不影响。
int main(int argc, char* argv[])
{
    if (argc < 3) {
        std::cout << "Usage: " << argv[0]
                  << " <tcp://ip:port> <nranks> [all|thread|warp|warp-pad|group|dispatch|mixed] [options]" << std::endl;
        std::cout << "Options:" << std::endl;
        std::cout << "  --iterations N  Correctness iterations per mode, default: 1" << std::endl;
        std::cout << "  --warmup N      Warmup iterations for --timing, default: 0" << std::endl;
        std::cout << "  --timing        Run all iterations of a mode in one kernel and report device clock cycles"
                  << std::endl;
        print_modes();
        return 1;
    }
    const std::string endpoint = argv[1];
    uint32_t nranks = 0U;
    if (!examples::parse_uint32(argv[2], nranks, 2)) {
        std::cout << "invalid nranks: " << argv[2] << ", expected an integer >= 2" << std::endl;
        return 1;
    }

    std::string mode_name = "all";
    int option_start = 3;
    if (argc > 3 && std::strncmp(argv[3], "--", 2) != 0) {
        mode_name = argv[3];
        option_start = 4;
    }

    uint32_t iterations = 1U;
    uint32_t warmup = 0U;
    bool device_timing = false;
    for (int i = option_start; i < argc; ++i) {
        const std::string option = argv[i];
        const bool has_value = i + 1 < argc;
        if (option == "--iterations" && has_value) {
            if (!examples::parse_uint32(argv[++i], iterations, 1)) {
                std::cout << "invalid --iterations value (minimum 1)" << std::endl;
                return 1;
            }
        } else if (option == "--warmup" && has_value) {
            if (!examples::parse_uint32(argv[++i], warmup)) {
                std::cout << "invalid --warmup value" << std::endl;
                return 1;
            }
        } else if (option == "--timing") {
            device_timing = true;
        } else {
            std::cout << "Unknown or incomplete option: " << option << std::endl;
            return 1;
        }
    }
    if (!device_timing && warmup != 0U) {
        std::cout << "--warmup requires --timing" << std::endl;
        return 1;
    }

    // all模式顺序执行全部模式；计时模式排除mixed（mixed无设备计时路径）。
    std::vector<std::string> modes;
    if (mode_name == "all") {
        modes = {"thread", "warp", "warp-pad", "group", "dispatch"};
        if (!device_timing) {
            modes.push_back("mixed");
        }
    } else {
        uint32_t mode = 0U;
        if (!parse_mode(mode_name, mode)) {
            std::cout << "invalid mode: " << mode_name << std::endl;
            print_modes();
            return 1;
        }
        if (device_timing && mode == MODE_MIXED) {
            std::cout << "mixed mode does not support device timing" << std::endl;
            return 1;
        }
        modes = {mode_name};
    }

    // rank间控制通道基于TCP，对端先退出时写操作不应让本进程直接死于SIGPIPE。
    (void)signal(SIGPIPE, SIG_IGN);

    bool all_passed = true;
    bool interrupted = false;
    for (const std::string& mode : modes) {
        std::vector<examples::args_of<decltype(run_simt_jetty_rank)>> per_rank_args;
        per_rank_args.reserve(nranks);
        for (uint32_t rank = 0U; rank < nranks; ++rank) {
            per_rank_args.emplace_back(rank, nranks, endpoint, mode, iterations, warmup, device_timing);
        }
        examples::process_group group;
        if (!group.launch(nranks, run_simt_jetty_rank, std::move(per_rank_args))) {
            return 1;
        }
        const bool mode_passed = group.wait_all();
        if (group.interrupted()) {
            interrupted = true;
            break;
        }
        if (!mode_passed) {
            std::cout << "CASE_FAILED | Mode=" << mode << " | exit_codes=";
            for (int code : group.exit_codes()) {
                std::cout << code << ",";
            }
            std::cout << std::endl;
        }
        all_passed = mode_passed && all_passed;
    }

    if (interrupted) {
        std::cout << "RESULT | Example=simt_jetty Mode=" << mode_name << " | Status=INTERRUPTED" << std::endl;
        return 1;
    }
    std::cout << "RESULT | Example=simt_jetty Mode=" << mode_name << " | Status=" << (all_passed ? "PASS" : "FAIL")
              << std::endl;
    return all_passed ? 0 : 1;
}
