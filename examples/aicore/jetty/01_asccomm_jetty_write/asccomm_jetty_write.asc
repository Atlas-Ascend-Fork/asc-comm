#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>

#include <csignal>

#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "hccl/hccl.h"
#include "hccl/hccl_rank_graph.h"
#include "kernel_operator.h"
#include "jetty/asccomm_work_queue.h"

#include "utils/check.h"
#include "utils/hccl_comm_init.h"
#include "utils/process_manager.h"
#include "utils/rank_sync.h"
#include "utils/arg_parser.h"

constexpr uint32_t DATA_SIZE = 256U;
constexpr uint64_t COMM_BUF_SIZE = 64U * 1024U;
// 样例声明支持的rank数上限。通信buffer本身可容纳更多槽位，实际上限由本机NPU数量决定。
constexpr uint32_t MAX_RANK_NUM = 16U;
constexpr uint64_t WRITE_RESULT_OFFSET = DATA_SIZE;
constexpr uint64_t WRITE_VALUE_SIZE = sizeof(uint64_t);
constexpr uint64_t WRITE_VALUE_MAGIC = 0xA5A5000000000000ULL;
constexpr ::CommProtocol HOST_COMM_PROTOCOL = ::COMM_PROTOCOL_UBC_CTP;
// 建channel时申请的notify数量。jetty路径的write/write_value/drain各占用一个notify，
// 少于此值建链后在notify分配上会失败。
constexpr uint32_t CHANNEL_NOTIFY_NUM = 3U;
// kernel侧轮询CQE等待完成的超时周期数，超时后硬件trap。按AIV主频折算约1ms量级。
constexpr int64_t CQE_POLL_TIMEOUT_CYCLES = 1000000;

enum test_result : uint32_t {
    TEST_SUCCESS = 0U,
    TEST_WRITE_FAILED = 1U,
    TEST_DRAIN_FAILED = 2U,
};
static_assert(sizeof(test_result) == sizeof(uint32_t), "test_result must remain uint32_t-sized");

namespace asccomm_example {

// host与设备侧的每peer上下文：host按peers顺序填充下发，设备侧同序遍历并回写test_result。
struct comm_context {
    uint64_t local_buffer_addr; // 本端通信buffer基址，write的数据源
    uint64_t jetty_table;       // 设备侧jetty表基址，jetty_idx为表内下标
    uint64_t dst_ptr;           // 对端buffer上的数据槽地址，按来源rank编号
    uint64_t value_dst_ptr;     // 对端buffer上的write_value marker槽地址
    uint64_t value;             // write_value写入的8字节marker（WRITE_VALUE_MAGIC | 来源rank）
    uint32_t jetty_idx;         // 本peer的jetty在jetty_table中的下标
    test_result test_result;    // 设备侧回写的执行结果，host回读后逐peer判定
};

} // namespace asccomm_example

extern "C" aclError launch_asccomm_jetty_write(void* contexts, uint32_t peer_count, aclrtStream stream);

namespace {

constexpr const char* MEMORY_TAG = "shareBuf";

// 本样例host侧同步点的tag：kernel下发前的建链完成barrier，以及kernel完成后的落地barrier。
constexpr uint32_t TAG_CHANNELS_READY = examples::TAG_USER_BASE;
constexpr uint32_t TAG_KERNEL_DONE = examples::TAG_USER_BASE + 1U;

constexpr int32_t SUCCESS = 0;
constexpr int32_t FAILURE = 1;

struct peer_rank_ctx {
    uint32_t rank_id = 0U;
    ChannelHandle channel = 0U;
    void* remote_buffer_addr = nullptr;
};

// 资源按RAII释放：EXAMPLES_CHECK在任意一步失败时直接return，析构保证已申请的资源都被回收。
struct comm_resources {
    comm_resources() = default;

    ~comm_resources()
    {
        peers.clear();
        if (comm != nullptr) {
            (void)HcclCommDestroy(comm);
        }
        if (dev_contexts != nullptr) {
            (void)aclrtFree(dev_contexts);
        }
        if (dev_jetty_table != nullptr) {
            (void)aclrtFree(dev_jetty_table);
        }
        if (dev_buf != nullptr) {
            (void)aclrtFree(dev_buf);
        }
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (device_set) {
            (void)aclrtResetDevice(static_cast<int32_t>(rank));
        }
        if (acl_initialized) {
            (void)aclFinalize();
        }
    }

    comm_resources(const comm_resources&) = delete;
    comm_resources& operator=(const comm_resources&) = delete;

    uint32_t rank{0U};
    uint32_t rank_size{0U};
    bool acl_initialized{false};
    bool device_set{false};
    HcclComm comm{nullptr};
    HcclMemHandle mem_handle{nullptr};
    void* dev_buf{nullptr};
    void* dev_contexts{nullptr};
    void* dev_jetty_table{nullptr};
    aclrtStream stream{nullptr};
    std::vector<peer_rank_ctx> peers;
};

int32_t build_channel_desc(
    HcclComm comm, uint32_t rank, uint32_t peer_rank, HcclMemHandle* mem_handle, HcclChannelDesc& desc)
{
    uint32_t* layers = nullptr;
    uint32_t layer_count = 0U;
    EXAMPLES_CHECK(HcclRankGraphGetLayers(comm, &layers, &layer_count), HCCL_SUCCESS, rank);
    for (uint32_t layer = 0U; layer < layer_count; ++layer) {
        CommLink* links = nullptr;
        uint32_t link_count = 0U;
        EXAMPLES_CHECK(
            HcclRankGraphGetLinks(comm, layers[layer], rank, peer_rank, &links, &link_count), HCCL_SUCCESS, rank);
        for (uint32_t link = 0U; link < link_count; ++link) {
            if (links[link].linkAttr.linkProtocol != HOST_COMM_PROTOCOL) {
                continue;
            }
            EXAMPLES_CHECK(HcclChannelDescInit(&desc, 1U), HCCL_SUCCESS, rank);
            desc.remoteRank = peer_rank;
            desc.localEndpoint = links[link].srcEndpointDesc;
            desc.remoteEndpoint = links[link].dstEndpointDesc;
            desc.channelProtocol = HOST_COMM_PROTOCOL;
            desc.notifyNum = CHANNEL_NOTIFY_NUM;
            desc.memHandles = mem_handle;
            desc.memHandleNum = 1U;
            return 0;
        }
    }
    std::fprintf(stderr, "[ERROR] rank %u: no UBC_CTP link found to peer %u\n", rank, peer_rank);
    return FAILURE;
}

int32_t get_remote_memory(HcclComm comm, uint32_t rank, peer_rank_ctx& peer)
{
    uint32_t count = 0U;
    CommMem* memories = nullptr;
    char** tags = nullptr;
    EXAMPLES_CHECK(HcclChannelGetRemoteMems(comm, peer.channel, &count, &memories, &tags), HCCL_SUCCESS, rank);
    if (memories == nullptr || count == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: peer %u reported no remote memory\n", rank, peer.rank_id);
        return FAILURE;
    }
    for (uint32_t index = 0U; index < count; ++index) {
        if (tags != nullptr && tags[index] != nullptr && std::strcmp(tags[index], MEMORY_TAG) == 0) {
            if (memories[index].type != COMM_MEM_TYPE_DEVICE || memories[index].addr == nullptr ||
                memories[index].size < COMM_BUF_SIZE) {
                std::fprintf(stderr, "[ERROR] rank %u: peer %u remote buffer is not usable\n", rank, peer.rank_id);
                return FAILURE;
            }
            peer.remote_buffer_addr = memories[index].addr;
            return SUCCESS;
        }
    }
    if (count == 1U && memories[0].type == COMM_MEM_TYPE_DEVICE && memories[0].addr != nullptr &&
        memories[0].size >= COMM_BUF_SIZE) {
        peer.remote_buffer_addr = memories[0].addr;
        return SUCCESS;
    }
    std::fprintf(stderr, "[ERROR] rank %u: remote buffer for peer %u not found\n", rank, peer.rank_id);
    return FAILURE;
}

void fill_send_data(std::vector<uint8_t>& buffer, uint32_t rank)
{
    for (uint32_t index = 0U; index < DATA_SIZE; ++index) {
        buffer[index] = index == 0U ? static_cast<uint8_t>(rank) : static_cast<uint8_t>(rank + index);
    }
}

int32_t validate_slot(const std::vector<uint8_t>& buffer, uint64_t offset, uint32_t source_rank, uint32_t rank)
{
    for (uint32_t index = 0U; index < DATA_SIZE; ++index) {
        const uint8_t expected =
            index == 0U ? static_cast<uint8_t>(source_rank) : static_cast<uint8_t>(source_rank + index);
        const uint8_t actual = buffer[offset + index];
        if (actual != expected) {
            std::fprintf(
                stderr, "[ERROR] rank %u: data from rank %u mismatch at %u, actual=0x%02x, expected=0x%02x\n", rank,
                source_rank, index, actual, expected);
            return FAILURE;
        }
    }
    return SUCCESS;
}

int32_t validate_write_value(const std::vector<uint8_t>& buffer, uint64_t offset, uint32_t source_rank, uint32_t rank)
{
    uint64_t actual = 0U;
    std::memcpy(&actual, buffer.data() + offset, sizeof(actual));
    const uint64_t expected = WRITE_VALUE_MAGIC | static_cast<uint64_t>(source_rank);
    if (actual != expected) {
        std::fprintf(
            stderr, "[ERROR] rank %u: write_value marker from rank %u mismatch, actual=0x%016llx, expected=0x%016llx\n",
            rank, source_rank, static_cast<unsigned long long>(actual), static_cast<unsigned long long>(expected));
        return FAILURE;
    }
    return SUCCESS;
}

const char* get_kernel_error(test_result result)
{
    switch (result) {
        case TEST_WRITE_FAILED:
            return "write or write_value failed";
        case TEST_DRAIN_FAILED:
            return "asccomm_drain failed";
        default:
            return "unknown kernel error";
    }
}

int32_t check_kernel_results(const comm_resources& resources, uint32_t rank)
{
    for (size_t index = 0U; index < resources.peers.size(); ++index) {
        const peer_rank_ctx& peer = resources.peers[index];
        asccomm_example::comm_context context{};
        auto* device_context = static_cast<uint8_t*>(resources.dev_contexts) + index * sizeof(context);
        EXAMPLES_CHECK(
            aclrtMemcpy(&context, sizeof(context), device_context, sizeof(context), ACL_MEMCPY_DEVICE_TO_HOST),
            ACL_SUCCESS, rank);
        if (context.test_result != TEST_SUCCESS) {
            std::fprintf(
                stderr, "[ERROR] rank %u: peer %u kernel failed, %s\n", rank, peer.rank_id,
                get_kernel_error(context.test_result));
            return FAILURE;
        }
    }
    return SUCCESS;
}

int32_t init_acl(comm_resources& resources)
{
    EXAMPLES_CHECK(aclInit(nullptr), ACL_SUCCESS, resources.rank);
    resources.acl_initialized = true;

    uint32_t device_count = 0U;
    EXAMPLES_CHECK(aclrtGetDeviceCount(&device_count), ACL_SUCCESS, resources.rank);
    if (device_count < resources.rank_size) {
        std::fprintf(
            stderr, "[ERROR] rank %u: %u devices are required, found %u\n", resources.rank, resources.rank_size,
            device_count);
        return FAILURE;
    }
    EXAMPLES_CHECK(aclrtSetDevice(static_cast<int32_t>(resources.rank)), ACL_SUCCESS, resources.rank);
    resources.device_set = true;
    EXAMPLES_CHECK(aclrtCreateStream(&resources.stream), ACL_SUCCESS, resources.rank);
    return SUCCESS;
}

int32_t prepare_memory(comm_resources& resources, std::vector<uint8_t>& host_buffer)
{
    EXAMPLES_CHECK(
        aclrtMalloc(&resources.dev_buf, COMM_BUF_SIZE, ACL_MEM_MALLOC_HUGE_ONLY), ACL_SUCCESS, resources.rank);
    fill_send_data(host_buffer, resources.rank);
    EXAMPLES_CHECK(
        aclrtMemcpy(resources.dev_buf, COMM_BUF_SIZE, host_buffer.data(), COMM_BUF_SIZE, ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, resources.rank);

    CommMem memory{COMM_MEM_TYPE_DEVICE, resources.dev_buf, COMM_BUF_SIZE};
    EXAMPLES_CHECK(
        HcclCommMemReg(resources.comm, MEMORY_TAG, &memory, &resources.mem_handle), HCCL_SUCCESS, resources.rank);
    return SUCCESS;
}

// 为每个peer建立UBC_CTP Channel，并把全部Jetty handle放进一张device侧表。
int32_t setup_channels(comm_resources& resources)
{
    const uint32_t rank = resources.rank;
    resources.peers.reserve(resources.rank_size - 1U);
    std::vector<HcclChannelDesc> descs;
    descs.reserve(resources.rank_size - 1U);
    for (uint32_t peer_rank = 0U; peer_rank < resources.rank_size; ++peer_rank) {
        if (peer_rank == rank) {
            continue;
        }
        peer_rank_ctx peer;
        peer.rank_id = peer_rank;
        HcclChannelDesc desc{};
        EXAMPLES_CHECK(build_channel_desc(resources.comm, rank, peer_rank, &resources.mem_handle, desc), SUCCESS, rank);
        resources.peers.push_back(peer);
        descs.push_back(desc);
    }

    std::vector<ChannelHandle> channels(descs.size(), 0U);
    EXAMPLES_CHECK(
        HcclChannelAcquire(
            resources.comm, COMM_ENGINE_AIV, descs.data(), static_cast<uint32_t>(descs.size()), channels.data()),
        HCCL_SUCCESS, rank);
    // 每个peer一个Jetty，全部handle放进一张device侧表，kernel按jettyIdx索引取用。
    const size_t num_jetties = channels.size();
    std::vector<uint64_t> jetty_table_host(num_jetties, 0U);
    for (size_t index = 0U; index < num_jetties; ++index) {
        jetty_table_host[index] = static_cast<uint64_t>(channels[index]);
        resources.peers[index].channel = channels[index];
    }
    const size_t jetty_table_bytes = num_jetties * sizeof(uint64_t);
    EXAMPLES_CHECK(
        aclrtMalloc(&resources.dev_jetty_table, jetty_table_bytes, ACL_MEM_MALLOC_HUGE_ONLY), ACL_SUCCESS, rank);
    EXAMPLES_CHECK(
        aclrtMemcpy(
            resources.dev_jetty_table, jetty_table_bytes, jetty_table_host.data(), jetty_table_bytes,
            ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, rank);
    return SUCCESS;
}

// 填充每个peer的kernel context：本端buffer、jetty table、远端数据槽与marker地址。
int32_t prepare_contexts(comm_resources& resources, uint64_t value_result_offset)
{
    const uint32_t rank = resources.rank;
    std::vector<asccomm_example::comm_context> contexts(resources.peers.size());
    for (size_t index = 0U; index < resources.peers.size(); ++index) {
        EXAMPLES_CHECK(get_remote_memory(resources.comm, rank, resources.peers[index]), SUCCESS, rank);
        const uint64_t remote_base = reinterpret_cast<uint64_t>(resources.peers[index].remote_buffer_addr);
        asccomm_example::comm_context& context = contexts[index];
        context.local_buffer_addr = reinterpret_cast<uint64_t>(resources.dev_buf);
        context.jetty_table = reinterpret_cast<uint64_t>(resources.dev_jetty_table);
        // 数据槽按来源rank编号排布：多个peer并发写对端时各占独立槽位互不覆盖；
        // rank_size==2时全互连退化为点对点，布局不变。
        context.dst_ptr = remote_base + WRITE_RESULT_OFFSET + rank * DATA_SIZE;
        context.value_dst_ptr = remote_base + value_result_offset + rank * WRITE_VALUE_SIZE;
        context.value = WRITE_VALUE_MAGIC | static_cast<uint64_t>(rank);
        context.jetty_idx = static_cast<uint32_t>(index);
        context.test_result = TEST_SUCCESS;
    }
    const size_t contexts_bytes = contexts.size() * sizeof(asccomm_example::comm_context);
    EXAMPLES_CHECK(aclrtMalloc(&resources.dev_contexts, contexts_bytes, ACL_MEM_MALLOC_HUGE_ONLY), ACL_SUCCESS, rank);
    EXAMPLES_CHECK(
        aclrtMemcpy(resources.dev_contexts, contexts_bytes, contexts.data(), contexts_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, rank);
    return SUCCESS;
}

// 回读通信buffer，校验每个peer写入的数据槽与write_value marker。
int32_t validate_results(comm_resources& resources, std::vector<uint8_t>& host_buffer, uint64_t value_result_offset)
{
    const uint32_t rank = resources.rank;
    EXAMPLES_CHECK(
        aclrtMemcpy(host_buffer.data(), COMM_BUF_SIZE, resources.dev_buf, COMM_BUF_SIZE, ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, rank);
    for (const peer_rank_ctx& peer : resources.peers) {
        const uint64_t offset = WRITE_RESULT_OFFSET + static_cast<uint64_t>(peer.rank_id) * DATA_SIZE;
        EXAMPLES_CHECK(validate_slot(host_buffer, offset, peer.rank_id, rank), SUCCESS, rank);
        const uint64_t value_offset = value_result_offset + static_cast<uint64_t>(peer.rank_id) * WRITE_VALUE_SIZE;
        EXAMPLES_CHECK(validate_write_value(host_buffer, value_offset, peer.rank_id, rank), SUCCESS, rank);
    }
    std::printf(
        "[rank %u] asccomm_jetty_write | write and write_value verified for %zu peer(s) | PASS\n", rank,
        resources.peers.size());
    return SUCCESS;
}

// 单个rank的完整流程：控制通道、ACL与通信域初始化、建链、下发kernel、校验结果。
int32_t run_rank(uint32_t rank, uint32_t rank_size, const std::string& ctrl_endpoint)
{
    comm_resources resources;
    resources.rank = rank;
    resources.rank_size = rank_size;

    // 数据槽与marker都按rank编号排布在同一块通信buffer里，rank数过多会越界。
    const uint64_t value_result_offset = WRITE_RESULT_OFFSET + static_cast<uint64_t>(rank_size) * DATA_SIZE;
    if (value_result_offset + static_cast<uint64_t>(rank_size) * WRITE_VALUE_SIZE > COMM_BUF_SIZE) {
        std::fprintf(stderr, "[ERROR] rank %u: rank size %u is too large for communication buffer\n", rank, rank_size);
        return FAILURE;
    }

    examples::rank_sync_context sync = rank == 0U ?
                                           examples::rank_sync_context::make_listen(ctrl_endpoint, rank_size) :
                                           examples::rank_sync_context::make_connect(rank, rank_size, ctrl_endpoint);
    if (!sync.ok()) {
        std::fprintf(stderr, "[ERROR] rank %u: control channel setup failed\n", rank);
        return FAILURE;
    }

    EXAMPLES_CHECK(init_acl(resources), SUCCESS, rank);
    EXAMPLES_CHECK(examples::init_comm_by_root_info(sync, &resources.comm), HCCL_SUCCESS, rank);

    std::vector<uint8_t> host_buffer(static_cast<size_t>(COMM_BUF_SIZE), 0U);
    EXAMPLES_CHECK(prepare_memory(resources, host_buffer), SUCCESS, rank);
    EXAMPLES_CHECK(setup_channels(resources), SUCCESS, rank);
    EXAMPLES_CHECK(prepare_contexts(resources, value_result_offset), SUCCESS, rank);

    // WQE提交依赖对端jetty的notify/token等通道资源，barrier保证下发kernel时
    // 所有rank的jetty表项都已建好有效。
    if (!sync.barrier(TAG_CHANNELS_READY)) {
        std::fprintf(stderr, "[ERROR] rank %u: channels-ready barrier failed\n", rank);
        return FAILURE;
    }

    EXAMPLES_CHECK(
        launch_asccomm_jetty_write(
            resources.dev_contexts, static_cast<uint32_t>(resources.peers.size()), resources.stream),
        ACL_SUCCESS, rank);
    EXAMPLES_CHECK(aclrtSynchronizeStream(resources.stream), ACL_SUCCESS, rank);
    EXAMPLES_CHECK(check_kernel_results(resources, rank), SUCCESS, rank);

    // 本rank的kernel已同步完成，此barrier保证回读时其他rank写入的WQE都已落地。
    if (!sync.barrier(TAG_KERNEL_DONE)) {
        std::fprintf(stderr, "[ERROR] rank %u: kernel-done barrier failed\n", rank);
        return FAILURE;
    }
    return validate_results(resources, host_buffer, value_result_offset);
}

} // namespace

// 父进程流程：解析命令行（<tcp://ip:port> <rank_size>），拉起全部rank进程并汇总结果。
int32_t main(int32_t argc, char** argv)
{
    if (argc != 3) {
        std::fprintf(stderr, "Usage: %s <tcp://ip:port> <rank_size>\n", argv[0]);
        return FAILURE;
    }
    uint32_t rank_size = 0U;
    if (!examples::parse_uint32(argv[2], rank_size, 2) || rank_size > MAX_RANK_NUM) {
        std::fprintf(stderr, "invalid rank_size: %s, expected an integer in [2, %u]\n", argv[2], MAX_RANK_NUM);
        return FAILURE;
    }
    const std::string endpoint = argv[1];
    // rank间控制通道基于TCP，对端先退出时写操作不应让本进程直接死于SIGPIPE。
    (void)signal(SIGPIPE, SIG_IGN);

    std::vector<examples::args_of<decltype(run_rank)>> per_rank_args;
    per_rank_args.reserve(rank_size);
    for (uint32_t rank = 0U; rank < rank_size; ++rank) {
        per_rank_args.emplace_back(rank, rank_size, endpoint);
    }

    examples::process_group group;
    if (!group.launch(rank_size, run_rank, std::move(per_rank_args))) {
        return FAILURE;
    }
    const bool passed = group.wait_all();

    if (group.interrupted()) {
        std::printf("RESULT | Example=asccomm_jetty_write | Status=INTERRUPTED\n");
        return FAILURE;
    }
    std::printf("RESULT | Example=asccomm_jetty_write | Status=%s\n", passed ? "PASS" : "FAIL");
    return passed ? SUCCESS : FAILURE;
}

namespace asccomm_example {

// 设备侧：单AIV串行遍历per-peer上下文，每个peer做一次write+一次write_value（marker内联
// 在WQE里）再drain等CQE；失败码记入上下文，host回读后按peer定位失败环节。
class kernel_asccomm_jetty_write {
public:
    __aicore__ inline void init(GM_ADDR contexts, uint32_t peer_count)
    {
        this->contexts = reinterpret_cast<__gm__ comm_context*>(contexts);
        this->peer_count = peer_count;
    }

    __aicore__ inline void process()
    {
        // 三块UB工作区跨peer复用：peer_info/jettyInfo每轮由构造函数重新解析填充，
        // sqe仅本轮组包有效且逐peerDrain收尾，不会残留上一peer状态。
        using work_queue = asc::asccomm_work_queue<asc::COMM_PROTOCOL_UB_CTP>;
        using peer_info = work_queue::peer_info;
        using peer_entity = peer_info::peer_entity;
        using work_queue_info = work_queue::work_queue;

        __ubuf__ uint8_t peer_buf[sizeof(peer_entity)];
        __ubuf__ uint8_t work_queue_buf[sizeof(work_queue_info)];
        __ubuf__ uint8_t wqe_buf[128U];
        for (uint32_t index = 0U; index < peer_count; ++index) {
            __gm__ comm_context* context = contexts + index;
            context->test_result = TEST_SUCCESS;
            GM_ADDR local_buffer = reinterpret_cast<GM_ADDR>(context->local_buffer_addr);
            GM_ADDR jetty_table = reinterpret_cast<GM_ADDR>(context->jetty_table);
            auto peer_entity_ptr = reinterpret_cast<__ubuf__ peer_entity*>(peer_buf);
            auto work_queue_info_ptr = reinterpret_cast<__ubuf__ work_queue_info*>(work_queue_buf);
            // 按同一jettyIdx从jettyTable解析本peer通道：Peer封装对端元数据，Jetty封装
            // 本端元数据与WQE暂存区，二者配对使用。
            const asc::asccomm_peer<asc::COMM_PROTOCOL_UB_CTP> peer(peer_entity_ptr, jetty_table, context->jetty_idx);
            work_queue work_queue(work_queue_info_ptr, wqe_buf, jetty_table, context->jetty_idx);
            // 模板参数为CQE轮询超时周期数（见文件头），入队本身不等完成。
            if (work_queue.template write_nbi<CQE_POLL_TIMEOUT_CYCLES>(
                    peer, reinterpret_cast<GM_ADDR>(context->dst_ptr), local_buffer, DATA_SIZE) !=
                asc::ASCCOMM_SUCCESS) {
                context->test_result = TEST_WRITE_FAILED;
                continue;
            }
            // write_value不读本地数据缓冲，8字节marker直接内联在WQE中下发。
            if (work_queue.template write_value_nbi<CQE_POLL_TIMEOUT_CYCLES>(
                    peer, reinterpret_cast<GM_ADDR>(context->value_dst_ptr), context->value) != asc::ASCCOMM_SUCCESS) {
                context->test_result = TEST_WRITE_FAILED;
                continue;
            }
            // 等本peer全部CQE返回，两笔写落地后才处理下一个peer。
            if (work_queue.template drain<CQE_POLL_TIMEOUT_CYCLES>() != asc::ASCCOMM_SUCCESS) {
                context->test_result = TEST_DRAIN_FAILED;
            }
        }
    }

private:
    __gm__ comm_context* contexts{nullptr};
    uint32_t peer_count{0U};
};

__aicore__ inline void run_asccomm_kernel(GM_ADDR contexts, uint32_t peer_count)
{
    kernel_asccomm_jetty_write op;
    op.init(contexts, peer_count);
    op.process();
}

} // namespace asccomm_example

// kernel入口：单block下发即可，peer遍历在kernel内部串行完成，无需按peer分block。
extern "C" __vector__ __global__ __aicore__ void kernel_asccomm_jetty_write(GM_ADDR contexts, uint32_t peer_count)
{
    asccomm_example::run_asccomm_kernel(contexts, peer_count);
}

extern "C" aclError launch_asccomm_jetty_write(void* contexts, uint32_t peer_count, aclrtStream stream)
{
    if (contexts == nullptr || peer_count == 0U || stream == nullptr) {
        return ACL_ERROR_INVALID_PARAM;
    }
    // 单block下发：peer遍历在kernel内部串行完成，无需按peer分block并行。
    kernel_asccomm_jetty_write<<<1, 0, stream>>>(static_cast<uint8_t*>(contexts), peer_count);
    return ACL_SUCCESS;
}
