#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>

#include <csignal>

#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "hccl/hccl.h"
#include "hccl/hccl_rank_graph.h"
#include "kernel_operator.h"
#include "jetty/hcomm_jetty.h"

#include "utils/check.h"
#include "utils/hccl_comm_init.h"
#include "utils/process_manager.h"
#include "utils/rank_sync.h"
#include "utils/arg_parser.h"

constexpr uint32_t DATA_SIZE = 256U;
constexpr uint64_t COMM_BUF_SIZE = 64U * 1024U;
// 样例声明支持的rank数上限。通信buffer本身可容纳更多槽位，实际上限由本机NPU数量决定。
constexpr uint32_t MAX_RANK_NUM = 16U;
constexpr uint64_t WRITE_RESULT_OFFSET = DATA_SIZE;
constexpr uint64_t WRITE_VALUE_SIZE = sizeof(uint64_t);
constexpr uint64_t WRITE_VALUE_MAGIC = 0xA5A5000000000000ULL;
constexpr CommProtocol HOST_COMM_PROTOCOL = COMM_PROTOCOL_UBC_CTP;
// 建channel时申请的notify数量。Jetty路径的Write/WriteValue/Drain各占用一个notify，
// 少于此值建链后在notify分配上会失败。
constexpr uint32_t CHANNEL_NOTIFY_NUM = 3U;
// kernel侧轮询CQE等待完成的超时周期数，超时后硬件trap。按AIV主频折算约1ms量级。
constexpr int64_t CQE_POLL_TIMEOUT_CYCLES = 1000000;

enum TestResult : uint32_t {
    TEST_SUCCESS = 0U,
    TEST_WRITE_FAILED = 1U,
    TEST_DRAIN_FAILED = 2U,
};
static_assert(sizeof(TestResult) == sizeof(uint32_t), "TestResult must remain uint32_t-sized");

namespace HcommExample {

struct CommContext {
    uint64_t localBufferAddr;
    uint64_t jettyTable;
    uint64_t dstPtr;
    uint64_t valueDstPtr;
    uint64_t value;
    uint32_t jettyIdx;
    TestResult testResult;
};

} // namespace HcommExample

extern "C" aclError LaunchHcommJettyWrite(void* contexts, uint32_t peerCount, aclrtStream stream);

namespace {

constexpr const char* MEMORY_TAG = "shareBuf";

// 本样例host侧同步点的tag：kernel下发前的建链完成barrier，以及kernel完成后的落地barrier。
constexpr uint32_t kTagChannelsReady = examples::kTagUserBase;
constexpr uint32_t kTagKernelDone = examples::kTagUserBase + 1U;

constexpr int32_t SUCCESS = 0;
constexpr int32_t FAILURE = 1;

struct PeerRankCtx {
    uint32_t rankId = 0U;
    ChannelHandle channel = 0U;
    void* remoteBufferAddr = nullptr;
};

// 资源按RAII释放：EXAMPLES_CHECK在任意一步失败时直接return，析构保证已申请的资源都被回收。
struct CommResources {
    CommResources() = default;

    ~CommResources()
    {
        peers.clear();
        if (comm != nullptr) {
            (void)HcclCommDestroy(comm);
        }
        if (devContexts != nullptr) {
            (void)aclrtFree(devContexts);
        }
        if (devJettyTable != nullptr) {
            (void)aclrtFree(devJettyTable);
        }
        if (devBuf != nullptr) {
            (void)aclrtFree(devBuf);
        }
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (deviceSet) {
            (void)aclrtResetDevice(static_cast<int32_t>(rank));
        }
        if (aclInitialized) {
            (void)aclFinalize();
        }
    }

    CommResources(const CommResources&) = delete;
    CommResources& operator=(const CommResources&) = delete;

    uint32_t rank{0U};
    uint32_t rankSize{0U};
    bool aclInitialized{false};
    bool deviceSet{false};
    HcclComm comm{nullptr};
    HcclMemHandle memHandle{nullptr};
    void* devBuf{nullptr};
    void* devContexts{nullptr};
    void* devJettyTable{nullptr};
    aclrtStream stream{nullptr};
    std::vector<PeerRankCtx> peers;
};

int32_t BuildChannelDesc(
    HcclComm comm, uint32_t rank, uint32_t peerRank, HcclMemHandle* memHandle, HcclChannelDesc& desc)
{
    uint32_t* layers = nullptr;
    uint32_t layerCount = 0U;
    EXAMPLES_CHECK(HcclRankGraphGetLayers(comm, &layers, &layerCount), HCCL_SUCCESS, rank);
    for (uint32_t layer = 0U; layer < layerCount; ++layer) {
        CommLink* links = nullptr;
        uint32_t linkCount = 0U;
        EXAMPLES_CHECK(
            HcclRankGraphGetLinks(comm, layers[layer], rank, peerRank, &links, &linkCount), HCCL_SUCCESS, rank);
        for (uint32_t link = 0U; link < linkCount; ++link) {
            if (links[link].linkAttr.linkProtocol != HOST_COMM_PROTOCOL) {
                continue;
            }
            EXAMPLES_CHECK(HcclChannelDescInit(&desc, 1U), HCCL_SUCCESS, rank);
            desc.remoteRank = peerRank;
            desc.localEndpoint = links[link].srcEndpointDesc;
            desc.remoteEndpoint = links[link].dstEndpointDesc;
            desc.channelProtocol = HOST_COMM_PROTOCOL;
            desc.notifyNum = CHANNEL_NOTIFY_NUM;
            desc.memHandles = memHandle;
            desc.memHandleNum = 1U;
            return 0;
        }
    }
    std::fprintf(stderr, "[ERROR] rank %u: no UBC_CTP link found to peer %u\n", rank, peerRank);
    return FAILURE;
}

int32_t GetRemoteMemory(HcclComm comm, uint32_t rank, PeerRankCtx& peer)
{
    uint32_t count = 0U;
    CommMem* memories = nullptr;
    char** tags = nullptr;
    EXAMPLES_CHECK(HcclChannelGetRemoteMems(comm, peer.channel, &count, &memories, &tags), HCCL_SUCCESS, rank);
    if (memories == nullptr || count == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: peer %u reported no remote memory\n", rank, peer.rankId);
        return FAILURE;
    }
    for (uint32_t index = 0U; index < count; ++index) {
        if (tags != nullptr && tags[index] != nullptr && std::strcmp(tags[index], MEMORY_TAG) == 0) {
            if (memories[index].type != COMM_MEM_TYPE_DEVICE || memories[index].addr == nullptr ||
                memories[index].size < COMM_BUF_SIZE) {
                std::fprintf(stderr, "[ERROR] rank %u: peer %u remote buffer is not usable\n", rank, peer.rankId);
                return FAILURE;
            }
            peer.remoteBufferAddr = memories[index].addr;
            return SUCCESS;
        }
    }
    if (count == 1U && memories[0].type == COMM_MEM_TYPE_DEVICE && memories[0].addr != nullptr &&
        memories[0].size >= COMM_BUF_SIZE) {
        peer.remoteBufferAddr = memories[0].addr;
        return SUCCESS;
    }
    std::fprintf(stderr, "[ERROR] rank %u: remote buffer for peer %u not found\n", rank, peer.rankId);
    return FAILURE;
}

void FillSendData(std::vector<uint8_t>& buffer, uint32_t rank)
{
    for (uint32_t index = 0U; index < DATA_SIZE; ++index) {
        buffer[index] = index == 0U ? static_cast<uint8_t>(rank) : static_cast<uint8_t>(rank + index);
    }
}

int32_t ValidateSlot(const std::vector<uint8_t>& buffer, uint64_t offset, uint32_t sourceRank, uint32_t rank)
{
    for (uint32_t index = 0U; index < DATA_SIZE; ++index) {
        const uint8_t expected =
            index == 0U ? static_cast<uint8_t>(sourceRank) : static_cast<uint8_t>(sourceRank + index);
        const uint8_t actual = buffer[offset + index];
        if (actual != expected) {
            std::fprintf(
                stderr, "[ERROR] rank %u: data from rank %u mismatch at %u, actual=0x%02x, expected=0x%02x\n", rank,
                sourceRank, index, actual, expected);
            return FAILURE;
        }
    }
    return SUCCESS;
}

int32_t ValidateWriteValue(const std::vector<uint8_t>& buffer, uint64_t offset, uint32_t sourceRank, uint32_t rank)
{
    uint64_t actual = 0U;
    std::memcpy(&actual, buffer.data() + offset, sizeof(actual));
    const uint64_t expected = WRITE_VALUE_MAGIC | static_cast<uint64_t>(sourceRank);
    if (actual != expected) {
        std::fprintf(
            stderr, "[ERROR] rank %u: WriteValue marker from rank %u mismatch, actual=0x%016llx, expected=0x%016llx\n",
            rank, sourceRank, static_cast<unsigned long long>(actual), static_cast<unsigned long long>(expected));
        return FAILURE;
    }
    return SUCCESS;
}

const char* GetKernelError(TestResult result)
{
    switch (result) {
        case TEST_WRITE_FAILED:
            return "Write or WriteValue failed";
        case TEST_DRAIN_FAILED:
            return "Drain failed";
        default:
            return "unknown kernel error";
    }
}

int32_t CheckKernelResults(const CommResources& resources, uint32_t rank)
{
    for (size_t index = 0U; index < resources.peers.size(); ++index) {
        const PeerRankCtx& peer = resources.peers[index];
        HcommExample::CommContext context{};
        auto* deviceContext = static_cast<uint8_t*>(resources.devContexts) + index * sizeof(context);
        EXAMPLES_CHECK(
            aclrtMemcpy(&context, sizeof(context), deviceContext, sizeof(context), ACL_MEMCPY_DEVICE_TO_HOST),
            ACL_SUCCESS, rank);
        if (context.testResult != TEST_SUCCESS) {
            std::fprintf(
                stderr, "[ERROR] rank %u: peer %u kernel failed, %s\n", rank, peer.rankId,
                GetKernelError(context.testResult));
            return FAILURE;
        }
    }
    return SUCCESS;
}

int32_t InitAcl(CommResources& resources)
{
    EXAMPLES_CHECK(aclInit(nullptr), ACL_SUCCESS, resources.rank);
    resources.aclInitialized = true;

    uint32_t deviceCount = 0U;
    EXAMPLES_CHECK(aclrtGetDeviceCount(&deviceCount), ACL_SUCCESS, resources.rank);
    if (deviceCount < resources.rankSize) {
        std::fprintf(
            stderr, "[ERROR] rank %u: %u devices are required, found %u\n", resources.rank, resources.rankSize,
            deviceCount);
        return FAILURE;
    }
    EXAMPLES_CHECK(aclrtSetDevice(static_cast<int32_t>(resources.rank)), ACL_SUCCESS, resources.rank);
    resources.deviceSet = true;
    EXAMPLES_CHECK(aclrtCreateStream(&resources.stream), ACL_SUCCESS, resources.rank);
    return SUCCESS;
}

int32_t PrepareMemory(CommResources& resources, std::vector<uint8_t>& hostBuffer)
{
    EXAMPLES_CHECK(
        aclrtMalloc(&resources.devBuf, COMM_BUF_SIZE, ACL_MEM_MALLOC_HUGE_ONLY), ACL_SUCCESS, resources.rank);
    FillSendData(hostBuffer, resources.rank);
    EXAMPLES_CHECK(
        aclrtMemcpy(resources.devBuf, COMM_BUF_SIZE, hostBuffer.data(), COMM_BUF_SIZE, ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, resources.rank);

    CommMem memory{COMM_MEM_TYPE_DEVICE, resources.devBuf, COMM_BUF_SIZE};
    EXAMPLES_CHECK(
        HcclCommMemReg(resources.comm, MEMORY_TAG, &memory, &resources.memHandle), HCCL_SUCCESS, resources.rank);
    return SUCCESS;
}

// 为每个peer建立UBC_CTP Channel，并把全部Jetty handle放进一张device侧表。
int32_t SetupChannels(CommResources& resources)
{
    const uint32_t rank = resources.rank;
    resources.peers.reserve(resources.rankSize - 1U);
    std::vector<HcclChannelDesc> descs;
    descs.reserve(resources.rankSize - 1U);
    for (uint32_t peerRank = 0U; peerRank < resources.rankSize; ++peerRank) {
        if (peerRank == rank) {
            continue;
        }
        PeerRankCtx peer;
        peer.rankId = peerRank;
        HcclChannelDesc desc{};
        EXAMPLES_CHECK(BuildChannelDesc(resources.comm, rank, peerRank, &resources.memHandle, desc), SUCCESS, rank);
        resources.peers.push_back(peer);
        descs.push_back(desc);
    }

    std::vector<ChannelHandle> channels(descs.size(), 0U);
    EXAMPLES_CHECK(
        HcclChannelAcquire(
            resources.comm, COMM_ENGINE_AIV, descs.data(), static_cast<uint32_t>(descs.size()), channels.data()),
        HCCL_SUCCESS, rank);
    // 每个peer一个Jetty，全部handle放进一张device侧表，kernel按jettyIdx索引取用。
    const size_t numJetties = channels.size();
    std::vector<uint64_t> jettyTableHost(numJetties, 0U);
    for (size_t index = 0U; index < numJetties; ++index) {
        jettyTableHost[index] = static_cast<uint64_t>(channels[index]);
        resources.peers[index].channel = channels[index];
    }
    const size_t jettyTableBytes = numJetties * sizeof(uint64_t);
    EXAMPLES_CHECK(aclrtMalloc(&resources.devJettyTable, jettyTableBytes, ACL_MEM_MALLOC_HUGE_ONLY), ACL_SUCCESS, rank);
    EXAMPLES_CHECK(
        aclrtMemcpy(
            resources.devJettyTable, jettyTableBytes, jettyTableHost.data(), jettyTableBytes,
            ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, rank);
    return SUCCESS;
}

// 填充每个peer的kernel context：本端buffer、jetty table、远端数据槽与marker地址。
int32_t PrepareContexts(CommResources& resources, uint64_t valueResultOffset)
{
    const uint32_t rank = resources.rank;
    std::vector<HcommExample::CommContext> contexts(resources.peers.size());
    for (size_t index = 0U; index < resources.peers.size(); ++index) {
        EXAMPLES_CHECK(GetRemoteMemory(resources.comm, rank, resources.peers[index]), SUCCESS, rank);
        const uint64_t remoteBase = reinterpret_cast<uint64_t>(resources.peers[index].remoteBufferAddr);
        HcommExample::CommContext& context = contexts[index];
        context.localBufferAddr = reinterpret_cast<uint64_t>(resources.devBuf);
        context.jettyTable = reinterpret_cast<uint64_t>(resources.devJettyTable);
        context.dstPtr = remoteBase + WRITE_RESULT_OFFSET + rank * DATA_SIZE;
        context.valueDstPtr = remoteBase + valueResultOffset + rank * WRITE_VALUE_SIZE;
        context.value = WRITE_VALUE_MAGIC | static_cast<uint64_t>(rank);
        context.jettyIdx = static_cast<uint32_t>(index);
        context.testResult = TEST_SUCCESS;
    }
    const size_t contextsBytes = contexts.size() * sizeof(HcommExample::CommContext);
    EXAMPLES_CHECK(aclrtMalloc(&resources.devContexts, contextsBytes, ACL_MEM_MALLOC_HUGE_ONLY), ACL_SUCCESS, rank);
    EXAMPLES_CHECK(
        aclrtMemcpy(resources.devContexts, contextsBytes, contexts.data(), contextsBytes, ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, rank);
    return SUCCESS;
}

// 回读通信buffer，校验每个peer写入的数据槽与WriteValue marker。
int32_t ValidateResults(CommResources& resources, std::vector<uint8_t>& hostBuffer, uint64_t valueResultOffset)
{
    const uint32_t rank = resources.rank;
    EXAMPLES_CHECK(
        aclrtMemcpy(hostBuffer.data(), COMM_BUF_SIZE, resources.devBuf, COMM_BUF_SIZE, ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, rank);
    for (const PeerRankCtx& peer : resources.peers) {
        const uint64_t offset = WRITE_RESULT_OFFSET + static_cast<uint64_t>(peer.rankId) * DATA_SIZE;
        EXAMPLES_CHECK(ValidateSlot(hostBuffer, offset, peer.rankId, rank), SUCCESS, rank);
        const uint64_t valueOffset = valueResultOffset + static_cast<uint64_t>(peer.rankId) * WRITE_VALUE_SIZE;
        EXAMPLES_CHECK(ValidateWriteValue(hostBuffer, valueOffset, peer.rankId, rank), SUCCESS, rank);
    }
    std::printf(
        "[rank %u] hcomm_jetty_write | Write and WriteValue verified for %zu peer(s) | PASS\n", rank,
        resources.peers.size());
    return SUCCESS;
}

// 单个rank的完整流程：控制通道、ACL与通信域初始化、建链、下发kernel、校验结果。
int32_t RunRank(uint32_t rank, uint32_t rankSize, const std::string& ctrlEndpoint)
{
    CommResources resources;
    resources.rank = rank;
    resources.rankSize = rankSize;

    // 数据槽与marker都按rank编号排布在同一块通信buffer里，rank数过多会越界。
    const uint64_t valueResultOffset = WRITE_RESULT_OFFSET + static_cast<uint64_t>(rankSize) * DATA_SIZE;
    if (valueResultOffset + static_cast<uint64_t>(rankSize) * WRITE_VALUE_SIZE > COMM_BUF_SIZE) {
        std::fprintf(stderr, "[ERROR] rank %u: rank size %u is too large for communication buffer\n", rank, rankSize);
        return FAILURE;
    }

    examples::RankSyncContext sync = rank == 0U ? examples::RankSyncContext::Listen(ctrlEndpoint, rankSize) :
                                                  examples::RankSyncContext::Connect(rank, rankSize, ctrlEndpoint);
    if (!sync.Ok()) {
        std::fprintf(stderr, "[ERROR] rank %u: control channel setup failed\n", rank);
        return FAILURE;
    }

    EXAMPLES_CHECK(InitAcl(resources), SUCCESS, rank);
    EXAMPLES_CHECK(examples::InitCommByRootInfo(sync, &resources.comm), HCCL_SUCCESS, rank);

    std::vector<uint8_t> hostBuffer(static_cast<size_t>(COMM_BUF_SIZE), 0U);
    EXAMPLES_CHECK(PrepareMemory(resources, hostBuffer), SUCCESS, rank);
    EXAMPLES_CHECK(SetupChannels(resources), SUCCESS, rank);
    EXAMPLES_CHECK(PrepareContexts(resources, valueResultOffset), SUCCESS, rank);

    // 全体通道建好后再下发kernel：kernel按jetty table提交WQE，建链未完成时表项无效。
    if (!sync.Barrier(kTagChannelsReady)) {
        std::fprintf(stderr, "[ERROR] rank %u: channels-ready barrier failed\n", rank);
        return FAILURE;
    }

    EXAMPLES_CHECK(
        LaunchHcommJettyWrite(resources.devContexts, static_cast<uint32_t>(resources.peers.size()), resources.stream),
        ACL_SUCCESS, rank);
    EXAMPLES_CHECK(aclrtSynchronizeStream(resources.stream), ACL_SUCCESS, rank);
    EXAMPLES_CHECK(CheckKernelResults(resources, rank), SUCCESS, rank);

    // 本rank的kernel已同步完成，此barrier保证回读时其他rank写入的WQE都已落地。
    if (!sync.Barrier(kTagKernelDone)) {
        std::fprintf(stderr, "[ERROR] rank %u: kernel-done barrier failed\n", rank);
        return FAILURE;
    }
    return ValidateResults(resources, hostBuffer, valueResultOffset);
}

} // namespace

// 父进程流程：解析命令行（<tcp://ip:port> <rank_size>），拉起全部rank进程并汇总结果。
int32_t main(int32_t argc, char** argv)
{
    if (argc != 3) {
        std::fprintf(stderr, "Usage: %s <tcp://ip:port> <rank_size>\n", argv[0]);
        return FAILURE;
    }
    uint32_t rankSize = 0U;
    if (!examples::ParseUint32(argv[2], rankSize, 2) || rankSize > MAX_RANK_NUM) {
        std::fprintf(stderr, "invalid rank_size: %s, expected an integer in [2, %u]\n", argv[2], MAX_RANK_NUM);
        return FAILURE;
    }
    const std::string endpoint = argv[1];
    // rank间控制通道基于TCP，对端先退出时写操作不应让本进程直接死于SIGPIPE。
    (void)signal(SIGPIPE, SIG_IGN);

    std::vector<examples::ArgsOf<decltype(RunRank)>> perRankArgs;
    perRankArgs.reserve(rankSize);
    for (uint32_t rank = 0U; rank < rankSize; ++rank) {
        perRankArgs.emplace_back(rank, rankSize, endpoint);
    }

    examples::ProcessGroup group;
    if (!group.Launch(rankSize, RunRank, std::move(perRankArgs))) {
        return FAILURE;
    }
    const bool passed = group.WaitAll();

    if (group.Interrupted()) {
        std::printf("RESULT | Example=hcomm_jetty_write | Status=INTERRUPTED\n");
        return FAILURE;
    }
    std::printf("RESULT | Example=hcomm_jetty_write | Status=%s\n", passed ? "PASS" : "FAIL");
    return passed ? SUCCESS : FAILURE;
}

namespace HcommExample {

class KernelHcommJettyWrite {
public:
    __aicore__ inline void Init(GM_ADDR contexts, uint32_t peerCount, AscendC::TPipe* pipe)
    {
        contexts_ = reinterpret_cast<__gm__ CommContext*>(contexts);
        peerCount_ = peerCount;
        pipe->InitBuffer(peerBuffer_, sizeof(AscendC::HcommJettyPeerInfo));
        pipe->InitBuffer(jettyInfoBuffer_, sizeof(AscendC::HcommJettyInfo));
        pipe->InitBuffer(sqeBuffer_, AscendC::HcommJetty::kNumMaxSqeBytes);
        peerTensor_ = peerBuffer_.Get<uint8_t>();
        jettyInfoTensor_ = jettyInfoBuffer_.Get<uint8_t>();
        sqeTensor_ = sqeBuffer_.Get<uint8_t>();
    }

    __aicore__ inline void Process()
    {
        for (uint32_t index = 0U; index < peerCount_; ++index) {
            __gm__ CommContext* context = contexts_ + index;
            context->testResult = TEST_SUCCESS;
            GM_ADDR localBuffer = reinterpret_cast<GM_ADDR>(context->localBufferAddr);
            GM_ADDR jettyTable = reinterpret_cast<GM_ADDR>(context->jettyTable);
            auto peerInfo = reinterpret_cast<__ubuf__ AscendC::HcommJettyPeerInfo*>(peerTensor_.GetPhyAddr());
            auto jettyInfo = reinterpret_cast<__ubuf__ AscendC::HcommJettyInfo*>(jettyInfoTensor_.GetPhyAddr());
            auto sqe = reinterpret_cast<__ubuf__ uint8_t*>(sqeTensor_.GetPhyAddr());
            const AscendC::HcommPeer peer(peerInfo, jettyTable, context->jettyIdx);
            AscendC::HcommJetty jetty(jettyInfo, sqe, jettyTable, context->jettyIdx);
            if (jetty.template Write<CQE_POLL_TIMEOUT_CYCLES>(
                    peer, reinterpret_cast<GM_ADDR>(context->dstPtr), localBuffer, DATA_SIZE) !=
                AscendC::HCOMM_SUCCESS) {
                context->testResult = TEST_WRITE_FAILED;
                continue;
            }
            if (jetty.template WriteValue<CQE_POLL_TIMEOUT_CYCLES>(
                    peer, reinterpret_cast<GM_ADDR>(context->valueDstPtr), context->value) != AscendC::HCOMM_SUCCESS) {
                context->testResult = TEST_WRITE_FAILED;
                continue;
            }
            if (jetty.template Drain<CQE_POLL_TIMEOUT_CYCLES>() != AscendC::HCOMM_SUCCESS) {
                context->testResult = TEST_DRAIN_FAILED;
            }
        }
    }

private:
    AscendC::TBuf<AscendC::TPosition::VECOUT> peerBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> jettyInfoBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> sqeBuffer_;
    AscendC::LocalTensor<uint8_t> peerTensor_;
    AscendC::LocalTensor<uint8_t> jettyInfoTensor_;
    AscendC::LocalTensor<uint8_t> sqeTensor_;
    __gm__ CommContext* contexts_{nullptr};
    uint32_t peerCount_{0U};
};

__aicore__ inline void RunHcommKernel(GM_ADDR contexts, uint32_t peerCount)
{
    AscendC::TPipe pipe;
    KernelHcommJettyWrite op;
    op.Init(contexts, peerCount, &pipe);
    op.Process();
}

} // namespace HcommExample

extern "C" __vector__ __global__ __aicore__ void kernel_hcomm_jetty_write(GM_ADDR contexts, uint32_t peerCount)
{
    HcommExample::RunHcommKernel(contexts, peerCount);
}

extern "C" aclError LaunchHcommJettyWrite(void* contexts, uint32_t peerCount, aclrtStream stream)
{
    if (contexts == nullptr || peerCount == 0U || stream == nullptr) {
        return ACL_ERROR_INVALID_PARAM;
    }
    kernel_hcomm_jetty_write<<<1, 0, stream>>>(static_cast<uint8_t*>(contexts), peerCount);
    return ACL_SUCCESS;
}
