/*!
 * \file simt_jetty.asc
 * \brief SIMT Jetty WRITE样例Host侧流程：通信域创建、内存注册、P2P通道创建与结果校验
 */

#include <cstdint>
#include <csignal>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <iomanip>
#include <iostream>
#include <string>
#include <vector>

#include "hccl/hccl.h"
#include "hccl/hccl_res.h"
#include "hccl/hccl_types.h"
#include "hccl/hccl_rank_graph.h"

#include "utils/check.h"
#include "utils/hccl_comm_init.h"
#include "utils/process_manager.h"
#include "utils/rank_sync.h"
#include "utils/arg_parser.h"

#include "simt_jetty_common.h"

extern void LaunchSimtJetty(
    void* stream, uint64_t channel, void* jettyPtrTable, uint32_t sendBufIdx, uint32_t recvBufIdx, uint32_t mode,
    void* timing, uint32_t iterations, uint32_t warmup);

namespace {

using namespace simt_jetty;

// Jetty的SIMT路径只在UBC_CTP协议上实现，其余链路协议无对应实现。
constexpr CommProtocol kTargetCommProtocol = COMM_PROTOCOL_UBC_CTP;

// 两块内存注册到通信域时使用的tag。两个rank使用相同tag，远端内存才能按tag查回。
constexpr const char* kSendBufTag = "simtJettySendBuf";
constexpr const char* kRecvBufTag = "simtJettyRecvBuf";

// 一张表同时驱动解析和打印，避免某个mode能被解析、却打印成另一个名字。
struct ModeEntry {
    const char* name;
    uint32_t mode;
};

constexpr ModeEntry kModes[] = {
    {"thread", kModeThread},     {"warp-pad", kModeWarpPad}, {"group", kModeGroup},
    {"dispatch", kModeDispatch}, {"warp", kModeWarp},        {"mixed", kModeMixed},
};

// 显式传入却不匹配任何mode是笔误而非取默认值，因此直接拒绝。
bool ParseMode(const std::string& name, uint32_t& mode)
{
    for (const ModeEntry& entry : kModes) {
        if (name == entry.name) {
            mode = entry.mode;
            return true;
        }
    }
    return false;
}

const char* ModeName(uint32_t mode)
{
    for (const ModeEntry& entry : kModes) {
        if (mode == entry.mode) {
            return entry.name;
        }
    }
    return "unknown";
}

void PrintModes() { std::cout << "  mode: all | thread | warp | warp-pad | group | dispatch | mixed" << std::endl; }

// 与对端建链，并按kRecvBufTag查出对端接收buffer在远端内存表中的索引。kernel侧通过
// jettyPtrTable按索引解析队列信息；本地表index 0保留给CCL buffer，显式注册的内存从1开始。
HcclResult AcquirePeerChannel(
    HcclComm comm, uint32_t rank, uint32_t peerRank, HcclMemHandle* memHandles, ChannelHandle& channel,
    uint32_t& remoteRecvIdx)
{
    HcclChannelDesc desc;
    EXAMPLES_HCCLCHECK(HcclChannelDescInit(&desc, 1));
    desc.remoteRank = peerRank;
    desc.channelProtocol = kTargetCommProtocol;
    desc.notifyNum = 0;
    desc.memHandles = memHandles;
    desc.memHandleNum = 2U;

    uint32_t* layers = nullptr;
    uint32_t layerNum = 0U;
    EXAMPLES_HCCLCHECK(HcclRankGraphGetLayers(comm, &layers, &layerNum));
    if (layerNum == 0U || layers == nullptr) {
        std::cout << "[rank " << rank << "] no net layer reported" << std::endl;
        return HCCL_E_INTERNAL;
    }

    CommLink* links = nullptr;
    uint32_t linkNum = 0U;
    EXAMPLES_HCCLCHECK(HcclRankGraphGetLinks(comm, layers[0], rank, peerRank, &links, &linkNum));
    bool found = false;
    for (uint32_t i = 0U; i < linkNum; ++i) {
        if (links[i].linkAttr.linkProtocol == kTargetCommProtocol) {
            desc.localEndpoint = links[i].srcEndpointDesc;
            desc.remoteEndpoint = links[i].dstEndpointDesc;
            found = true;
            break;
        }
    }
    if (!found) {
        std::cout << "[rank " << rank << "] no UBC_CTP link to peer " << peerRank << std::endl;
        return HCCL_E_NOT_SUPPORT;
    }

    EXAMPLES_HCCLCHECK(HcclChannelAcquire(comm, COMM_ENGINE_AIV, &desc, 1U, &channel));

    uint32_t memNum = 0U;
    CommMem* remoteMems = nullptr;
    char** tags = nullptr;
    EXAMPLES_HCCLCHECK(HcclChannelGetRemoteMems(comm, channel, &memNum, &remoteMems, &tags));
    for (uint32_t i = 0U; i < memNum; ++i) {
        if (tags[i] != nullptr && std::strcmp(tags[i], kRecvBufTag) == 0) {
            remoteRecvIdx = i;
            return HCCL_SUCCESS;
        }
    }
    std::cout << "[rank " << rank << "] remote memory " << kRecvBufTag << " not found on the channel" << std::endl;
    return HCCL_E_INTERNAL;
}

// 期望表覆盖全部slot：写入范围之外的slot应保持清零，一并校验，可发现越界写入。
bool CheckWords(void* deviceBuf, const uint64_t expected[kSlotCount])
{
    uint64_t actual[kSlotCount] = {};
    if (aclrtMemcpy(actual, kBufferBytes, deviceBuf, kBufferBytes, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        return false;
    }
    for (uint32_t slot = 0U; slot < kSlotCount; ++slot) {
        if (actual[slot] != expected[slot]) {
            std::cout << "slot " << slot << " actual=" << actual[slot] << " expected=" << expected[slot] << std::endl;
            return false;
        }
    }
    return true;
}

} // namespace

// 本样例host侧同步点的tag：建链完成、每轮写入落地、接收侧校验完成、计时结束。
constexpr uint32_t kTagReady = examples::kTagUserBase;
constexpr uint32_t kTagWritten = kTagReady + 1U;
constexpr uint32_t kTagChecked = kTagWritten + 1U;
constexpr uint32_t kTagTimed = kTagChecked + 1U;

// 单个rank的执行流程：建链、注册内存、下发kernel并校验。由ProcessGroup在每个子进程中调用，
// 只有rank 0（发送方）和rank 1（接收方）建链并执行，其余rank打印SKIP后直接退出。
int RunSimtJettyRank(
    uint32_t rank, uint32_t nranks, const std::string& ctrlEndpoint, const std::string& modeName, uint32_t iterations,
    uint32_t warmup, bool deviceTiming)
{
    if (nranks < 2U) {
        std::cout << "nranks must be at least 2" << std::endl;
        return 1;
    }
    if (rank >= 2U) {
        std::cout << "SKIP | Rank=" << rank << " | Only rank 0 and rank 1 run simt_jetty." << std::endl;
        return 0;
    }

    uint32_t mode = 0U;
    if (!ParseMode(modeName, mode)) {
        std::cout << "Unknown mode: " << modeName << std::endl;
        PrintModes();
        return 1;
    }
    if (deviceTiming && mode == kModeMixed) {
        std::cout << "mixed mode does not support device timing" << std::endl;
        return 1;
    }

    // 只有rank 0/1参与：控制通道与通信域都只包含这两个rank，其余rank已提前退出。
    examples::RankSyncContext sync = rank == 0U ? examples::RankSyncContext::Listen(ctrlEndpoint, 2U) :
                                                  examples::RankSyncContext::Connect(rank, 2U, ctrlEndpoint);
    if (!sync.Ok()) {
        std::cout << "[rank " << rank << "] control channel setup failed" << std::endl;
        return 1;
    }

    EXAMPLES_ACLCHECK(aclInit(nullptr));
    EXAMPLES_ACLCHECK(aclrtSetDevice(rank));
    aclrtStream stream = nullptr;
    EXAMPLES_ACLCHECK(aclrtCreateStream(&stream));

    HcclComm comm = nullptr;
    EXAMPLES_HCCLCHECK(examples::InitCommByRootInfo(sync, &comm));

    void* sendBuf = nullptr;
    void* recvBuf = nullptr;
    EXAMPLES_ACLCHECK(aclrtMalloc(&sendBuf, kBufferBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    EXAMPLES_ACLCHECK(aclrtMalloc(&recvBuf, kBufferBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    uint64_t sendInit[kSlotCount] = {};
    for (uint32_t slot = 0U; slot < kSlotCount; ++slot) {
        sendInit[slot] = SlotValue(slot);
    }
    uint64_t recvInit[kSlotCount] = {};
    EXAMPLES_ACLCHECK(aclrtMemcpy(sendBuf, kBufferBytes, sendInit, kBufferBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    EXAMPLES_ACLCHECK(aclrtMemcpy(recvBuf, kBufferBytes, recvInit, kBufferBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    CommMem sendMem{COMM_MEM_TYPE_DEVICE, sendBuf, kBufferBytes};
    CommMem recvMem{COMM_MEM_TYPE_DEVICE, recvBuf, kBufferBytes};
    HcclMemHandle memHandles[2] = {nullptr, nullptr};
    EXAMPLES_HCCLCHECK(HcclCommMemReg(comm, kSendBufTag, &sendMem, &memHandles[0]));
    EXAMPLES_HCCLCHECK(HcclCommMemReg(comm, kRecvBufTag, &recvMem, &memHandles[1]));

    const uint32_t peerRank = rank == 0U ? 1U : 0U;
    ChannelHandle channel = 0U;
    uint32_t remoteRecvIdx = 0U;
    EXAMPLES_HCCLCHECK(AcquirePeerChannel(comm, rank, peerRank, memHandles, channel, remoteRecvIdx));

    void* jettyPtrTable = nullptr;
    EXAMPLES_ACLCHECK(aclrtMalloc(&jettyPtrTable, sizeof(uint64_t), ACL_MEM_MALLOC_HUGE_FIRST));
    const uint64_t channelValue = static_cast<uint64_t>(channel);
    EXAMPLES_ACLCHECK(aclrtMemcpy(
        jettyPtrTable, sizeof(channelValue), &channelValue, sizeof(channelValue), ACL_MEMCPY_HOST_TO_DEVICE));

    // 全体建链后再下发kernel：kernel按jetty表提交WQE，建链未完成时表项无效。
    if (!sync.Barrier(kTagReady)) {
        std::cout << "[rank " << rank << "] ready barrier failed" << std::endl;
        return 1;
    }

    // 本地buffer表index 0是CCL buffer，显式注册的内存从1开始。
    constexpr uint32_t kLocalSendIdx = 1U;
    bool pass = true;
    void* timingBuf = nullptr;
    uint64_t timing[kTimingWords] = {};
    if (rank == 0U) {
        if (deviceTiming) {
            // warmup与全部计时轮在单次kernel内完成，每轮都会Drain，确保SQ tail持续推进。
            EXAMPLES_ACLCHECK(aclrtMalloc(&timingBuf, sizeof(timing), ACL_MEM_MALLOC_HUGE_FIRST));
            EXAMPLES_ACLCHECK(aclrtMemset(timingBuf, sizeof(timing), 0, sizeof(timing)));
            LaunchSimtJetty(
                stream, channel, jettyPtrTable, kLocalSendIdx, remoteRecvIdx, mode, timingBuf, iterations, warmup);
            EXAMPLES_ACLCHECK(aclrtSynchronizeStream(stream));
            EXAMPLES_ACLCHECK(
                aclrtMemcpy(timing, sizeof(timing), timingBuf, sizeof(timing), ACL_MEMCPY_DEVICE_TO_HOST));

            pass = timing[kCompletedIndex] == iterations;
            const double averageWriteCycles = static_cast<double>(timing[kWriteCyclesIndex]) / iterations;
            const double averageCommitCycles = static_cast<double>(timing[kCommitCyclesIndex]) / iterations;
            const double averageCompletionCycles = static_cast<double>(timing[kCompletionCyclesIndex]) / iterations;
            std::cout << std::fixed << std::setprecision(3) << "PERF | mode=" << ModeName(mode)
                      << " | iterations=" << iterations << " | warmup=" << warmup
                      << " | write_cycles=" << timing[kWriteCyclesIndex]
                      << " | average_write_cycles=" << averageWriteCycles
                      << " | average_write_us=" << averageWriteCycles / 1000.0
                      << " | commit_cycles=" << timing[kCommitCyclesIndex]
                      << " | average_commit_cycles=" << averageCommitCycles
                      << " | average_commit_us=" << averageCommitCycles / 1000.0
                      << " | completion_cycles=" << timing[kCompletionCyclesIndex]
                      << " | average_completion_cycles=" << averageCompletionCycles
                      << " | average_completion_us=" << averageCompletionCycles / 1000.0
                      << " | completed=" << timing[kCompletedIndex] << std::endl;
        } else {
            for (uint32_t iteration = 0U; iteration < iterations; ++iteration) {
                LaunchSimtJetty(stream, channel, jettyPtrTable, kLocalSendIdx, remoteRecvIdx, mode, nullptr, 1U, 0U);
                EXAMPLES_ACLCHECK(aclrtSynchronizeStream(stream));
                // 写入落地与接收侧校验各一个barrier：接收侧校验后会清零目标缓冲区，下一轮
                // 写入必须等清零完成，否则可能被清零覆盖。
                if (!sync.Barrier(kTagWritten) || !sync.Barrier(kTagChecked)) {
                    std::cout << "[rank 0] iteration barrier failed" << std::endl;
                    return 1;
                }
            }
        }
    }

    if (deviceTiming && !sync.Barrier(kTagTimed)) {
        std::cout << "[rank " << rank << "] timed barrier failed" << std::endl;
        return 1;
    }

    if (rank == 1U) {
        uint64_t expected[kSlotCount] = {};
        for (uint32_t slot = 0U; slot < ExpectedSlotCount(mode); ++slot) {
            expected[slot] = SlotValue(slot);
        }
        // 计时模式全部轮次写同一份镜像，只校验一次；正确性模式逐轮校验。
        const uint32_t checks = deviceTiming ? 1U : iterations;
        for (uint32_t iteration = 0U; iteration < checks; ++iteration) {
            if (!deviceTiming && !sync.Barrier(kTagWritten)) {
                std::cout << "[rank 1] written barrier failed" << std::endl;
                return 1;
            }
            const bool iterationPass = CheckWords(recvBuf, expected);
            pass = pass && iterationPass;
            if (!iterationPass) {
                std::cout << "[rank 1] simt_jetty " << ModeName(mode) << " iteration " << iteration << " FAIL"
                          << " checks=" << ExpectedSlotCount(mode) << std::endl;
            }
            if (!deviceTiming) {
                if (iteration + 1U < checks) {
                    EXAMPLES_ACLCHECK(aclrtMemset(recvBuf, kBufferBytes, 0, kBufferBytes));
                }
                if (!sync.Barrier(kTagChecked)) {
                    std::cout << "[rank 1] checked barrier failed" << std::endl;
                    return 1;
                }
            }
        }
        std::cout << "[rank 1] simt_jetty " << ModeName(mode) << " iterations " << checks << (pass ? " PASS" : " FAIL")
                  << std::endl;
    }

    if (timingBuf != nullptr) {
        EXAMPLES_ACLCHECK(aclrtFree(timingBuf));
    }
    EXAMPLES_ACLCHECK(aclrtFree(jettyPtrTable));
    EXAMPLES_ACLCHECK(aclrtFree(sendBuf));
    EXAMPLES_ACLCHECK(aclrtFree(recvBuf));
    EXAMPLES_HCCLCHECK(HcclCommDestroy(comm));
    EXAMPLES_ACLCHECK(aclrtDestroyStream(stream));
    EXAMPLES_ACLCHECK(aclFinalize());
    return pass ? 0 : 2;
}

// 父进程流程：解析命令行（<tcp://ip:port> <nranks> [mode] [options]），逐个模式拉起全部rank
// 进程并汇总结果；每个模式使用独立的进程组，模式间SQ/CQ状态互不影响。
int main(int argc, char* argv[])
{
    if (argc < 3) {
        std::cout << "Usage: " << argv[0]
                  << " <tcp://ip:port> <nranks> [all|thread|warp|warp-pad|group|dispatch|mixed] [options]" << std::endl;
        std::cout << "Options:" << std::endl;
        std::cout << "  --iterations N  Correctness iterations per mode, default: 1" << std::endl;
        std::cout << "  --warmup N      Warmup iterations for --timing, default: 0" << std::endl;
        std::cout << "  --timing        Run all iterations of a mode in one kernel and report device clock cycles"
                  << std::endl;
        PrintModes();
        return 1;
    }
    const std::string endpoint = argv[1];
    uint32_t nranks = 0U;
    if (!examples::ParseUint32(argv[2], nranks, 2)) {
        std::cout << "invalid nranks: " << argv[2] << ", expected an integer >= 2" << std::endl;
        return 1;
    }

    std::string modeName = "all";
    int optionStart = 3;
    if (argc > 3 && std::strncmp(argv[3], "--", 2) != 0) {
        modeName = argv[3];
        optionStart = 4;
    }

    uint32_t iterations = 1U;
    uint32_t warmup = 0U;
    bool deviceTiming = false;
    for (int i = optionStart; i < argc; ++i) {
        const std::string option = argv[i];
        const bool hasValue = i + 1 < argc;
        if (option == "--iterations" && hasValue) {
            if (!examples::ParseUint32(argv[++i], iterations, 1)) {
                std::cout << "invalid --iterations value (minimum 1)" << std::endl;
                return 1;
            }
        } else if (option == "--warmup" && hasValue) {
            if (!examples::ParseUint32(argv[++i], warmup)) {
                std::cout << "invalid --warmup value" << std::endl;
                return 1;
            }
        } else if (option == "--timing") {
            deviceTiming = true;
        } else {
            std::cout << "Unknown or incomplete option: " << option << std::endl;
            return 1;
        }
    }
    if (!deviceTiming && warmup != 0U) {
        std::cout << "--warmup requires --timing" << std::endl;
        return 1;
    }

    // all模式顺序执行全部模式；计时模式排除mixed（mixed无设备计时路径）。
    std::vector<std::string> modes;
    if (modeName == "all") {
        modes = {"thread", "warp", "warp-pad", "group", "dispatch"};
        if (!deviceTiming) {
            modes.push_back("mixed");
        }
    } else {
        uint32_t mode = 0U;
        if (!ParseMode(modeName, mode)) {
            std::cout << "invalid mode: " << modeName << std::endl;
            PrintModes();
            return 1;
        }
        if (deviceTiming && mode == kModeMixed) {
            std::cout << "mixed mode does not support device timing" << std::endl;
            return 1;
        }
        modes = {modeName};
    }

    // rank间控制通道基于TCP，对端先退出时写操作不应让本进程直接死于SIGPIPE。
    (void)signal(SIGPIPE, SIG_IGN);

    bool allPassed = true;
    bool interrupted = false;
    for (const std::string& mode : modes) {
        std::vector<examples::ArgsOf<decltype(RunSimtJettyRank)>> perRankArgs;
        perRankArgs.reserve(nranks);
        for (uint32_t rank = 0U; rank < nranks; ++rank) {
            perRankArgs.emplace_back(rank, nranks, endpoint, mode, iterations, warmup, deviceTiming);
        }
        examples::ProcessGroup group;
        if (!group.Launch(nranks, RunSimtJettyRank, std::move(perRankArgs))) {
            return 1;
        }
        const bool modePassed = group.WaitAll();
        if (group.Interrupted()) {
            interrupted = true;
            break;
        }
        if (!modePassed) {
            std::cout << "CASE_FAILED | Mode=" << mode << " | ExitCodes=";
            for (int code : group.ExitCodes()) {
                std::cout << code << ",";
            }
            std::cout << std::endl;
        }
        allPassed = modePassed && allPassed;
    }

    if (interrupted) {
        std::cout << "RESULT | Example=simt_jetty Mode=" << modeName << " | Status=INTERRUPTED" << std::endl;
        return 1;
    }
    std::cout << "RESULT | Example=simt_jetty Mode=" << modeName << " | Status=" << (allPassed ? "PASS" : "FAIL")
              << std::endl;
    return allPassed ? 0 : 1;
}
