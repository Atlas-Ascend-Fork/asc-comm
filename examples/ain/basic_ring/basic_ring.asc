/*!
 * \file basic_ring.asc
 * \brief AIN basic ring 样例.
 */

#include <chrono>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <iostream>
#include <string>
#include <thread>
#include <vector>
#include <sys/stat.h>

#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "hccl/hccl.h"
#include "hccl/hccl_comm.h"
#include "hccl/hccl_types.h"
#include "hccl/hccl_team.h"
#include "kernel_operator.h"
#include "ain/ain.h"

#define ACL_CHECK(expr)                                                                                      \
    do {                                                                                                     \
        aclError ret = (expr);                                                                               \
        if (ret != ACL_SUCCESS) {                                                                            \
            std::cout << "acl error " << __FILE__ << ":" << __LINE__ << " ret=" << static_cast<int32_t>(ret) \
                      << std::endl;                                                                          \
            return ret;                                                                                      \
        }                                                                                                    \
    } while (0)

#define HCCL_CHECK(expr)                                                                                      \
    do {                                                                                                      \
        HcclResult ret = (expr);                                                                              \
        if (ret != HCCL_SUCCESS) {                                                                            \
            std::cout << "hccl error " << __FILE__ << ":" << __LINE__ << " ret=" << static_cast<int32_t>(ret) \
                      << std::endl;                                                                           \
            return ret;                                                                                       \
        }                                                                                                     \
    } while (0)

namespace {

constexpr size_t COMM_BUF_SIZE = 2U * 1024U * 1024U;
constexpr uint32_t ROOT_INFO_WAIT_SECONDS = 60U;
constexpr uint32_t ROOT_INFO_POLL_MS = 100U;

bool IsRootInfoFileReady(const std::string& path)
{
    struct stat st {};
    return stat(path.c_str(), &st) == 0 && st.st_size >= static_cast<off_t>(sizeof(HcclRootInfo));
}

HcclResult WriteRootInfoFile(const std::string& path, const HcclRootInfo& rootInfo)
{
    const std::string tmpPath = path + ".tmp";
    std::ofstream ofs(tmpPath, std::ios::binary | std::ios::trunc);
    if (!ofs.is_open()) {
        std::cout << "open root info tmp file failed: " << tmpPath << std::endl;
        return HCCL_E_OPEN_FILE_FAILURE;
    }
    ofs.write(reinterpret_cast<const char*>(&rootInfo), sizeof(rootInfo));
    ofs.close();
    if (!ofs) {
        std::cout << "write root info file failed: " << tmpPath << std::endl;
        return HCCL_E_SYSCALL;
    }
    if (std::rename(tmpPath.c_str(), path.c_str()) != 0) {
        std::cout << "rename root info file failed: " << tmpPath << " -> " << path << std::endl;
        return HCCL_E_SYSCALL;
    }
    return ::HCCL_SUCCESS;
}

HcclResult ReadRootInfoFile(const std::string& path, HcclRootInfo* rootInfo)
{
    const uint32_t maxPollTimes = ROOT_INFO_WAIT_SECONDS * 1000U / ROOT_INFO_POLL_MS;
    for (uint32_t i = 0; i < maxPollTimes; ++i) {
        if (!IsRootInfoFileReady(path)) {
            std::this_thread::sleep_for(std::chrono::milliseconds(ROOT_INFO_POLL_MS));
            continue;
        }
        std::ifstream ifs(path, std::ios::binary);
        if (!ifs.is_open()) {
            return HCCL_E_OPEN_FILE_FAILURE;
        }
        ifs.read(reinterpret_cast<char*>(rootInfo), sizeof(*rootInfo));
        if (ifs.gcount() == static_cast<std::streamsize>(sizeof(*rootInfo))) {
            return ::HCCL_SUCCESS;
        }
        std::this_thread::sleep_for(std::chrono::milliseconds(ROOT_INFO_POLL_MS));
    }
    std::cout << "wait root info file timeout: " << path << std::endl;
    return HCCL_E_TIMEOUT;
}

HcclResult InitCommByRootInfo(uint32_t rank, uint32_t nranks, const std::string& rootInfoFile, HcclComm* comm)
{
    HcclRootInfo rootInfo{};
    HcclResult ret = HCCL_SUCCESS;
    if (rank == 0U) {
        HCCL_CHECK(HcclGetRootInfo(&rootInfo));
        ret = WriteRootInfoFile(rootInfoFile, rootInfo);
        if (ret != HCCL_SUCCESS) {
            return ret;
        }
    } else {
        ret = ReadRootInfoFile(rootInfoFile, &rootInfo);
        if (ret != HCCL_SUCCESS) {
            return ret;
        }
    }
    HCCL_CHECK(HcclCommInitRootInfo(nranks, &rootInfo, rank, comm));
    return HCCL_SUCCESS;
}

int32_t ParseInt32(const char* arg)
{
    if (arg == nullptr) {
        return -1;
    }
    char* end = nullptr;
    long value = std::strtol(arg, &end, 10);
    if (end == arg || *end != '\0') {
        return -1;
    }
    return static_cast<int32_t>(value);
}

} // namespace

extern "C" [[bisheng::core_ratio(0, 1)]] __global__ __aicore__ void basic_ring_kernel(
    __gm__ void* ainTeam, __gm__ void* sendWindow, __gm__ void* recvWindow, int32_t rankNum, int32_t rankId)
{
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECOUT> hcommBuf;
    pipe.InitBuffer(hcommBuf, AscendC::HCOMM_URMA_TMP_BUF_SIZE);
    AscendC::LocalTensor<uint8_t> hcommLocal = hcommBuf.Get<uint8_t>();
    AscendC::AinDescriptorUbuf hcommUbuf{
        reinterpret_cast<__ubuf__ uint8_t*>(hcommLocal.GetPhyAddr()), AscendC::HCOMM_URMA_TMP_BUF_SIZE, 0U};

    AscendC::Ain ain(0);
    uint32_t peer = static_cast<uint32_t>((rankId + 1) % rankNum);
    uint32_t prev = static_cast<uint32_t>((rankId + rankNum - 1) % rankNum);

    ain.Put(
        ainTeam, peer, recvWindow, static_cast<uint64_t>(rankId), sendWindow, 0U, 1U, AscendC::AinRemoteNone{},
        hcommUbuf);
    ain.Flush(ainTeam);

    uint64_t getDstOffset = static_cast<uint64_t>(rankNum + rankId);
    ain.Get(ainTeam, prev, recvWindow, getDstOffset, sendWindow, 0U, 1U, hcommUbuf);
    ain.Flush(ainTeam);

    AscendC::AinBarrierSession ainBarrier(&ain, ainTeam, 0U);
    ainBarrier.Sync(AscendC::AinMemoryOrder::AIN_MEMORY_ORDER_RELAX, hcommUbuf);
}

int32_t main(int32_t argc, char* argv[])
{
    if (argc < 4) {
        std::cout << "Usage: " << argv[0] << " <rank> <nranks> <root_info_file>" << std::endl;
        return 1;
    }

    int32_t rank = ParseInt32(argv[1]);
    int32_t nranks = ParseInt32(argv[2]);
    std::string rootInfoFile = argv[3];
    if (rank < 0 || nranks < 2 || rank >= nranks) {
        std::cout << "Invalid rank arguments: rank=" << argv[1] << " nranks=" << argv[2] << std::endl;
        return 1;
    }

    ACL_CHECK(aclInit(nullptr));
    uint32_t devCount = 0;
    ACL_CHECK(aclrtGetDeviceCount(&devCount));
    std::cout << "Found " << devCount << " NPU device(s), rank=" << rank << "/" << nranks << std::endl;
    ACL_CHECK(aclrtSetDevice(static_cast<uint32_t>(rank)));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));

    HcclComm hcclComm = nullptr;
    // 创建通信域
    HCCL_CHECK(InitCommByRootInfo(static_cast<uint32_t>(rank), static_cast<uint32_t>(nranks), rootInfoFile, &hcclComm));

    // 初始化本地数据
    void* sendBuf = nullptr;
    ACL_CHECK(aclrtMalloc(&sendBuf, COMM_BUF_SIZE, ACL_MEM_MALLOC_HUGE_FIRST));
    std::vector<int8_t> sendHost(COMM_BUF_SIZE, static_cast<int8_t>(rank));
    ACL_CHECK(aclrtMemcpy(sendBuf, COMM_BUF_SIZE, sendHost.data(), COMM_BUF_SIZE, ACL_MEMCPY_HOST_TO_DEVICE));

    void* recvBuf = nullptr;
    ACL_CHECK(aclrtMalloc(&recvBuf, COMM_BUF_SIZE, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemset(recvBuf, COMM_BUF_SIZE, 0, COMM_BUF_SIZE));

    // 创建worldTeam
    HcclTeamCreateDesc desc;
    HCCL_CHECK(HcclTeamCreateDescInit(&desc));
    std::vector<uint32_t> worldRankIds;
    for (uint32_t idx = 0; idx < nranks; idx++) {
        worldRankIds.emplace_back(idx);
    }
    desc.rankIds = worldRankIds.data();
    desc.rankNum = nranks;
    desc.selfRankId = rank;
    desc.netLayer = 0;
    desc.requirement.barrierCount = 1;
    HcommTeamHandle worldTeam{nullptr};
    HCCL_CHECK(HcclWorldTeamCreate(hcclComm, &desc, &worldTeam));

    // 将本地内存注册为window
    CommMem sendMem{COMM_MEM_TYPE_DEVICE, sendBuf, COMM_BUF_SIZE};
    HcommWindowHandle sendWin{nullptr};
    HCCL_CHECK(HcclTeamWindowRegister(hcclComm, worldTeam, &sendMem, &sendWin, 0));

    CommMem recvMem{COMM_MEM_TYPE_DEVICE, recvBuf, COMM_BUF_SIZE};
    HcommWindowHandle recvWin{nullptr};
    HCCL_CHECK(HcclTeamWindowRegister(hcclComm, worldTeam, &recvMem, &recvWin, 0));

    // team进行channel的创建和连接
    HcclTeamCreateChannelsDesc channelsDesc;
    HCCL_CHECK(HcclTeamCreateChannelsDescInit(&channelsDesc));
    channelsDesc.engine = COMM_ENGINE_AIV;
    channelsDesc.protocol = COMM_PROTOCOL_UBC_CTP;
    channelsDesc.channelCnt = 1;
    HCCL_CHECK(HcclTeamChannelsCreate(hcclComm, worldTeam, &channelsDesc));

    basic_ring_kernel<<<1U, nullptr, stream>>>(worldTeam, sendWin, recvWin, nranks, rank);
    ACL_CHECK(aclrtSynchronizeStream(stream));

    // 结果校验
    int32_t prev = (rank - 1 + nranks) % nranks;
    int32_t getOffset = nranks + rank;
    int8_t* testBuf = nullptr;
    ACL_CHECK(aclrtMallocHost(reinterpret_cast<void**>(&testBuf), COMM_BUF_SIZE));
    ACL_CHECK(aclrtMemcpy(testBuf, COMM_BUF_SIZE, recvBuf, COMM_BUF_SIZE, ACL_MEMCPY_DEVICE_TO_HOST));
    std::cout << "PUT RES rank " << rank << " recvBuf[" << prev << "]=" << static_cast<int32_t>(testBuf[prev])
              << " expect=" << prev << std::endl;
    std::cout << "GET RES rank " << rank << " recvBuf[" << getOffset << "]=" << static_cast<int32_t>(testBuf[getOffset])
              << " expect=" << prev << std::endl;

    bool pass = testBuf[prev] == static_cast<int8_t>(prev) && testBuf[getOffset] == static_cast<int8_t>(prev);
    std::cout << "rank " << rank << " test " << (pass ? "pass" : "failed") << std::endl;

    HCCL_CHECK(HcclTeamWindowDeregister(worldTeam, recvWin));
    HCCL_CHECK(HcclTeamWindowDeregister(worldTeam, sendWin));
    HCCL_CHECK(HcclTeamDestroy(worldTeam));
    ACL_CHECK(aclrtFreeHost(testBuf));
    ACL_CHECK(aclrtFree(sendBuf));
    ACL_CHECK(aclrtFree(recvBuf));
    HCCL_CHECK(HcclCommDestroy(hcclComm));
    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(static_cast<uint32_t>(rank)));
    ACL_CHECK(aclFinalize());

    return 0;
}
