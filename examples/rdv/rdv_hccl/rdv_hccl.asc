namespace {

using namespace RdvHcclExample;

constexpr int32_t SUCCESS = 0;
constexpr int32_t FAILURE = 1;
constexpr uint32_t BARRIER_FLAG = 1U;
constexpr int32_t BOOTSTRAP_TIMEOUT_SECONDS = 120;

#define CHECK_RESULT(call, expected, rank)                                                                           \
    do {                                                                                                             \
        auto checkResult = (call);                                                                                   \
        if (checkResult != (expected)) {                                                                             \
            std::fprintf(                                                                                            \
                stderr, "[ERROR] rank %u: %s failed, ret=%lld, expected=%lld\n", static_cast<unsigned>(rank), #call, \
                static_cast<long long>(checkResult), static_cast<long long>(expected));                              \
            return FAILURE;                                                                                          \
        }                                                                                                            \
    } while (0)

struct EndpointGroup {
    EndpointDesc localEndpoint{};
    std::vector<uint32_t> peerRanks;
    std::vector<EndpointDesc> remoteEndpoints;
    std::vector<MultiChannelHandle> multiChannels;
};

struct RankResources {
    RankResources() = default;

    ~RankResources()
    {
        // Channels and the registered memory created through the HcclComm overload of MakeMultiChannelHandle are
        // owned by the communicator and released together with HcclCommDestroy.
        if (comm != nullptr) {
            (void)HcclCommDestroy(comm);
        }
        if (deviceContext != nullptr) {
            (void)aclrtFree(deviceContext);
        }
        if (deviceBuffer != nullptr) {
            (void)aclrtFree(deviceBuffer);
        }
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        for (int32_t socket : bootstrapSockets) {
            if (socket >= 0) {
                (void)close(socket);
            }
        }
        if (deviceSet) {
            (void)aclrtResetDevice(deviceId);
        }
        if (aclInitialized) {
            (void)aclFinalize();
        }
    }

    RankResources(const RankResources&) = delete;
    RankResources& operator=(const RankResources&) = delete;

    uint32_t rank{0U};
    uint32_t rankNum{0U};
    int32_t deviceId{0};
    bool aclInitialized{false};
    bool deviceSet{false};
    std::string bootstrapHost;
    uint16_t bootstrapPort{0U};
    std::vector<int32_t> bootstrapSockets;
    aclrtStream stream{nullptr};
    HcclComm comm{nullptr};
    uint64_t commBufferSize{0U};
    void* deviceBuffer{nullptr};
    uint8_t* deviceContext{nullptr};
    HcclMemHandle memHandle{nullptr};
};

int32_t SendAll(int32_t socket, const void* buffer, size_t length)
{
    size_t sent = 0U;
    while (sent < length) {
        ssize_t result = send(socket, static_cast<const uint8_t*>(buffer) + sent, length - sent, 0);
        if (result < 0 && errno == EINTR) {
            continue;
        }
        if (result <= 0) {
            std::fprintf(stderr, "[ERROR] send failed: %s\n", std::strerror(errno));
            return FAILURE;
        }
        sent += static_cast<size_t>(result);
    }
    return SUCCESS;
}

int32_t RecvAll(int32_t socket, void* buffer, size_t length)
{
    size_t received = 0U;
    while (received < length) {
        ssize_t result = recv(socket, static_cast<uint8_t*>(buffer) + received, length - received, 0);
        if (result < 0 && errno == EINTR) {
            continue;
        }
        if (result <= 0) {
            std::fprintf(stderr, "[ERROR] recv failed: %s\n", result == 0 ? "peer closed" : std::strerror(errno));
            return FAILURE;
        }
        received += static_cast<size_t>(result);
    }
    return SUCCESS;
}

bool ParseIpPort(const char* value, std::string& host, uint16_t& port)
{
    if (value == nullptr || *value == '\0') {
        return false;
    }

    constexpr const char* TCP_PREFIX = "tcp://";
    std::string endpoint(value);
    if (endpoint.compare(0U, std::strlen(TCP_PREFIX), TCP_PREFIX) == 0) {
        endpoint.erase(0U, std::strlen(TCP_PREFIX));
    }
    const size_t separator = endpoint.rfind(':');
    if (separator == std::string::npos || separator == 0U || separator + 1U >= endpoint.size()) {
        return false;
    }

    const std::string portText = endpoint.substr(separator + 1U);
    char* end = nullptr;
    errno = 0;
    const unsigned long parsedPort = std::strtoul(portText.c_str(), &end, 10);
    if (errno != 0 || end == portText.c_str() || *end != '\0' || parsedPort == 0UL || parsedPort > UINT16_MAX) {
        return false;
    }

    host = endpoint.substr(0U, separator);
    if (host.front() == '[') {
        if (host.size() < 3U || host.back() != ']') {
            return false;
        }
        host = host.substr(1U, host.size() - 2U);
    }
    port = static_cast<uint16_t>(parsedPort);
    return !host.empty();
}

bool SetSocketTimeouts(int32_t socket)
{
    timeval timeout{};
    timeout.tv_sec = BOOTSTRAP_TIMEOUT_SECONDS;
    if (setsockopt(socket, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) != 0 ||
        setsockopt(socket, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout)) != 0) {
        return false;
    }
    return true;
}

int32_t CreateListenSocket(const std::string& host, uint16_t port)
{
    addrinfo hints{};
    hints.ai_family = AF_UNSPEC;
    hints.ai_socktype = SOCK_STREAM;
    hints.ai_flags = AI_PASSIVE;
    const std::string portText = std::to_string(port);
    addrinfo* addresses = nullptr;
    if (getaddrinfo(host.c_str(), portText.c_str(), &hints, &addresses) != 0) {
        return -1;
    }

    int32_t listenSocket = -1;
    for (const addrinfo* address = addresses; address != nullptr; address = address->ai_next) {
        const int32_t socket = ::socket(address->ai_family, address->ai_socktype, address->ai_protocol);
        if (socket < 0) {
            continue;
        }
        int32_t reuseAddress = 1;
        if (setsockopt(socket, SOL_SOCKET, SO_REUSEADDR, &reuseAddress, sizeof(reuseAddress)) != 0 ||
            bind(socket, address->ai_addr, address->ai_addrlen) != 0 || listen(socket, 64) != 0 ||
            !SetSocketTimeouts(socket)) {
            (void)close(socket);
            continue;
        }
        listenSocket = socket;
        break;
    }
    freeaddrinfo(addresses);
    return listenSocket;
}

int32_t ConnectWithRetry(const std::string& host, uint16_t port)
{
    constexpr uint32_t RETRY_COUNT = 1200U;
    constexpr auto RETRY_INTERVAL = std::chrono::milliseconds(100);
    addrinfo hints{};
    hints.ai_family = AF_UNSPEC;
    hints.ai_socktype = SOCK_STREAM;
    const std::string portText = std::to_string(port);
    addrinfo* addresses = nullptr;
    if (getaddrinfo(host.c_str(), portText.c_str(), &hints, &addresses) != 0) {
        return -1;
    }

    for (uint32_t retry = 0U; retry < RETRY_COUNT; ++retry) {
        for (const addrinfo* address = addresses; address != nullptr; address = address->ai_next) {
            const int32_t socket = ::socket(address->ai_family, address->ai_socktype, address->ai_protocol);
            if (socket < 0) {
                continue;
            }
            if (connect(socket, address->ai_addr, address->ai_addrlen) == 0 && SetSocketTimeouts(socket)) {
                freeaddrinfo(addresses);
                return socket;
            }
            (void)close(socket);
        }
        std::this_thread::sleep_for(RETRY_INTERVAL);
    }
    freeaddrinfo(addresses);
    return -1;
}

int32_t SetupBootstrap(RankResources& resources)
{
    resources.bootstrapSockets.assign(resources.rankNum, -1);
    if (resources.rank == 0U) {
        const int32_t listenSocket = CreateListenSocket(resources.bootstrapHost, resources.bootstrapPort);
        if (listenSocket < 0) {
            std::fprintf(
                stderr, "[ERROR] rank 0: bootstrap listen failed on %s:%u\n", resources.bootstrapHost.c_str(),
                resources.bootstrapPort);
            return FAILURE;
        }
        std::vector<bool> rankConnected(resources.rankNum, false);
        for (uint32_t connected = 0U; connected < resources.rankNum - 1U; ++connected) {
            int32_t socket = -1;
            do {
                socket = accept(listenSocket, nullptr, nullptr);
            } while (socket < 0 && errno == EINTR);
            if (socket < 0 || !SetSocketTimeouts(socket)) {
                if (socket >= 0) {
                    (void)close(socket);
                }
                (void)close(listenSocket);
                return FAILURE;
            }
            uint32_t peerRank = resources.rankNum;
            if (RecvAll(socket, &peerRank, sizeof(peerRank)) != SUCCESS || peerRank == 0U ||
                peerRank >= resources.rankNum || rankConnected[peerRank]) {
                (void)close(socket);
                (void)close(listenSocket);
                return FAILURE;
            }
            rankConnected[peerRank] = true;
            resources.bootstrapSockets[peerRank] = socket;
        }
        (void)close(listenSocket);
        return SUCCESS;
    }

    const int32_t socket = ConnectWithRetry(resources.bootstrapHost, resources.bootstrapPort);
    if (socket < 0 || SendAll(socket, &resources.rank, sizeof(resources.rank)) != SUCCESS) {
        if (socket >= 0) {
            (void)close(socket);
        }
        std::fprintf(
            stderr, "[ERROR] rank %u: connect to bootstrap %s:%u failed\n", resources.rank,
            resources.bootstrapHost.c_str(), resources.bootstrapPort);
        return FAILURE;
    }
    resources.bootstrapSockets[0] = socket;
    return SUCCESS;
}

int32_t BootstrapBarrier(RankResources& resources, const char* phase)
{
    if (resources.rank == 0U) {
        uint32_t flag = 0U;
        for (uint32_t rank = 1U; rank < resources.rankNum; ++rank) {
            if (RecvAll(resources.bootstrapSockets[rank], &flag, sizeof(flag)) != SUCCESS) {
                std::fprintf(
                    stderr, "[ERROR] rank 0: bootstrap barrier (%s) receive failed from rank %u\n", phase, rank);
                return FAILURE;
            }
            if (flag != BARRIER_FLAG) {
                std::fprintf(
                    stderr, "[ERROR] rank 0: bootstrap barrier (%s) received invalid flag %u from rank %u\n", phase,
                    flag, rank);
                return FAILURE;
            }
        }
        for (uint32_t rank = 1U; rank < resources.rankNum; ++rank) {
            if (SendAll(resources.bootstrapSockets[rank], &BARRIER_FLAG, sizeof(BARRIER_FLAG)) != SUCCESS) {
                std::fprintf(
                    stderr, "[ERROR] rank 0: bootstrap barrier (%s) release failed for rank %u\n", phase, rank);
                return FAILURE;
            }
        }
        return SUCCESS;
    }

    uint32_t release = 0U;
    if (SendAll(resources.bootstrapSockets[0], &BARRIER_FLAG, sizeof(BARRIER_FLAG)) != SUCCESS) {
        std::fprintf(
            stderr, "[ERROR] rank %u: bootstrap barrier (%s) notify failed to rank 0\n", resources.rank, phase);
        return FAILURE;
    }
    if (RecvAll(resources.bootstrapSockets[0], &release, sizeof(release)) != SUCCESS) {
        std::fprintf(stderr, "[ERROR] rank %u: bootstrap barrier (%s) release receive failed\n", resources.rank, phase);
        return FAILURE;
    }
    if (release != BARRIER_FLAG) {
        std::fprintf(
            stderr, "[ERROR] rank %u: bootstrap barrier (%s) received invalid release flag %u\n", resources.rank, phase,
            release);
        return FAILURE;
    }
    return SUCCESS;
}

uint8_t GetDataValue(uint32_t rank, uint32_t coreIndex, uint32_t offset)
{
    return static_cast<uint8_t>(rank * 53U + coreIndex * 97U + offset);
}

void FillSourceData(std::vector<uint8_t>& buffer, uint32_t rank)
{
    for (uint32_t coreIndex = 0U; coreIndex < AIV_CORE_NUM; ++coreIndex) {
        uint64_t sendOffset = SEND_BASE_OFFSET + static_cast<uint64_t>(coreIndex) * DATA_SIZE;
        for (uint32_t offset = 0U; offset < DATA_SIZE; ++offset) {
            buffer[sendOffset + offset] = GetDataValue(rank, coreIndex, offset);
        }
    }
}

const char* GetKernelError(KernelResult result)
{
    switch (result) {
        case KERNEL_MAKE_BATCH_HANDLE_FAILED:
            return "MakeBatchHandle failed";
        case KERNEL_GET_HANDLE_REF_FAILED:
            return "GetHandleRef failed";
        case KERNEL_WRITE_FAILED:
            return "WriteNbi failed";
        case KERNEL_COMMIT_FAILED:
            return "BatchCommit failed";
        case KERNEL_DRAIN_FAILED:
            return "Drain failed";
        default:
            return "unknown kernel error";
    }
}

int32_t InitAcl(RankResources& resources)
{
    CHECK_RESULT(aclInit(nullptr), ACL_SUCCESS, resources.rank);
    resources.aclInitialized = true;

    uint32_t deviceCount = 0U;
    CHECK_RESULT(aclrtGetDeviceCount(&deviceCount), ACL_SUCCESS, resources.rank);
    if (resources.deviceId < 0 || static_cast<uint32_t>(resources.deviceId) >= deviceCount) {
        std::fprintf(
            stderr, "[ERROR] rank %u: device %d is unavailable, found %u device(s)\n", resources.rank,
            resources.deviceId, deviceCount);
        return FAILURE;
    }
    CHECK_RESULT(aclrtSetDevice(resources.deviceId), ACL_SUCCESS, resources.rank);
    resources.deviceSet = true;
    CHECK_RESULT(aclrtCreateStream(&resources.stream), ACL_SUCCESS, resources.rank);
    return SUCCESS;
}

int32_t InitCommunicator(RankResources& resources)
{
    HcclRootInfo rootInfo{};
    if (resources.rank == 0U) {
        CHECK_RESULT(HcclGetRootInfo(&rootInfo), HCCL_SUCCESS, resources.rank);
        for (uint32_t rank = 1U; rank < resources.rankNum; ++rank) {
            CHECK_RESULT(
                SendAll(resources.bootstrapSockets[rank], &rootInfo, sizeof(rootInfo)), SUCCESS, resources.rank);
        }
    } else {
        CHECK_RESULT(RecvAll(resources.bootstrapSockets[0], &rootInfo, sizeof(rootInfo)), SUCCESS, resources.rank);
    }

    HcclCommConfig config{};
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = resources.rank;
    CHECK_RESULT(
        HcclCommInitRootInfoConfig(resources.rankNum, &rootInfo, resources.rank, &config, &resources.comm),
        HCCL_SUCCESS, resources.rank);
    return SUCCESS;
}

int32_t PrepareMemory(RankResources& resources, std::vector<uint64_t>& remoteBuffers)
{
    const uint64_t commBufferSize = resources.commBufferSize;
    CHECK_RESULT(
        aclrtMalloc(&resources.deviceBuffer, commBufferSize, ACL_MEM_MALLOC_HUGE_FIRST), ACL_SUCCESS, resources.rank);
    CHECK_RESULT(
        aclrtMalloc(
            reinterpret_cast<void**>(&resources.deviceContext), sizeof(BatchContext) * AIV_CORE_NUM,
            ACL_MEM_MALLOC_HUGE_FIRST),
        ACL_SUCCESS, resources.rank);

    std::vector<uint8_t> hostBuffer(static_cast<size_t>(commBufferSize), 0U);
    FillSourceData(hostBuffer, resources.rank);
    CHECK_RESULT(
        aclrtMemcpy(
            resources.deviceBuffer, commBufferSize, hostBuffer.data(), commBufferSize, ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, resources.rank);

    CommMem memory{};
    memory.type = COMM_MEM_TYPE_DEVICE;
    memory.addr = resources.deviceBuffer;
    memory.size = commBufferSize;
    CHECK_RESULT(
        HcclCommMemReg(resources.comm, MEMORY_TAG, &memory, &resources.memHandle), HCCL_SUCCESS, resources.rank);

    remoteBuffers.resize(resources.rankNum);
    const uint64_t localBuffer = reinterpret_cast<uint64_t>(resources.deviceBuffer);
    if (resources.rank == 0U) {
        remoteBuffers[0] = localBuffer;
        for (uint32_t rank = 1U; rank < resources.rankNum; ++rank) {
            CHECK_RESULT(
                RecvAll(resources.bootstrapSockets[rank], &remoteBuffers[rank], sizeof(remoteBuffers[rank])), SUCCESS,
                resources.rank);
        }
        for (uint32_t rank = 1U; rank < resources.rankNum; ++rank) {
            CHECK_RESULT(
                SendAll(
                    resources.bootstrapSockets[rank], remoteBuffers.data(),
                    remoteBuffers.size() * sizeof(remoteBuffers.front())),
                SUCCESS, resources.rank);
        }
    } else {
        CHECK_RESULT(
            SendAll(resources.bootstrapSockets[0], &localBuffer, sizeof(localBuffer)), SUCCESS, resources.rank);
        CHECK_RESULT(
            RecvAll(
                resources.bootstrapSockets[0], remoteBuffers.data(),
                remoteBuffers.size() * sizeof(remoteBuffers.front())),
            SUCCESS, resources.rank);
    }
    for (uint32_t rank = 0U; rank < resources.rankNum; ++rank) {
        if (remoteBuffers[rank] == 0U) {
            std::fprintf(stderr, "[ERROR] rank %u: received null buffer for rank %u\n", resources.rank, rank);
            return FAILURE;
        }
    }
    return SUCCESS;
}

const CommLink* FindUbcCtpLink(const CommLink* links, uint32_t linkNum)
{
    for (uint32_t index = 0U; index < linkNum; ++index) {
        if (links[index].linkAttr.linkProtocol == COMM_PROTOCOL_UB_CTP) {
            return &links[index];
        }
    }
    return nullptr;
}

bool HasSameEndpoint(const EndpointDesc& lhs, const EndpointDesc& rhs)
{
    return std::memcmp(lhs.commAddr.raws, rhs.commAddr.raws, sizeof(lhs.commAddr.raws)) == 0;
}

EndpointGroup& FindOrAddGroup(const EndpointDesc& localEndpoint, std::vector<EndpointGroup>& groups)
{
    for (EndpointGroup& group : groups) {
        if (HasSameEndpoint(group.localEndpoint, localEndpoint)) {
            return group;
        }
    }
    groups.push_back(EndpointGroup{});
    groups.back().localEndpoint = localEndpoint;
    return groups.back();
}

void AddPeerLink(uint32_t peerRank, const CommLink& link, EndpointGroup& group)
{
    group.peerRanks.push_back(peerRank);
    group.remoteEndpoints.push_back(link.dstEndpointDesc);
}

int32_t BuildEndpointGroups(RankResources& resources, std::vector<EndpointGroup>& groups)
{
    uint32_t* layers = nullptr;
    uint32_t layerCount = 0U;
    CHECK_RESULT(HcclRankGraphGetLayers(resources.comm, &layers, &layerCount), HCCL_SUCCESS, resources.rank);
    std::printf("[INFO] rank %u: rank graph has %u layer(s)\n", resources.rank, layerCount);
    for (uint32_t layerIndex = 0U; layerIndex < layerCount; ++layerIndex) {
        std::printf("[INFO] rank %u: layer[%u] id=%u\n", resources.rank, layerIndex, layers[layerIndex]);
    }

    // RDV_NET_LAYER sets the first rank-graph layer index scanned for each peer: unset scans from layer 0; "1"
    // starts from layer 1, skipping layer 0. Links of every layer are printed regardless of the starting index.
    uint32_t netLayerStart = 0U;
    const char* netLayerEnv = std::getenv("RDV_NET_LAYER");
    if (netLayerEnv != nullptr && netLayerEnv[0] != '\0') {
        char* end = nullptr;
        const long parsedLayer = std::strtol(netLayerEnv, &end, 10);
        if (end != netLayerEnv && *end == '\0' && parsedLayer >= 0 && parsedLayer < static_cast<long>(layerCount)) {
            netLayerStart = static_cast<uint32_t>(parsedLayer);
        } else {
            std::fprintf(
                stderr, "[WARN] rank %u: invalid RDV_NET_LAYER '%s', scanning from layer 0\n", resources.rank,
                netLayerEnv);
        }
    }

    for (uint32_t peerRank = 0U; peerRank < resources.rankNum; ++peerRank) {
        if (peerRank == resources.rank) {
            continue;
        }
        bool found = false;
        for (uint32_t layerIndex = 0U; layerIndex < layerCount; ++layerIndex) {
            CommLink* links = nullptr;
            uint32_t linkCount = 0U;
            CHECK_RESULT(
                HcclRankGraphGetLinks(resources.comm, layers[layerIndex], resources.rank, peerRank, &links, &linkCount),
                HCCL_SUCCESS, resources.rank);
            uint32_t ubctpCount = 0U;
            for (uint32_t linkIndex = 0U; linkIndex < linkCount; ++linkIndex) {
                if (links[linkIndex].linkAttr.linkProtocol == COMM_PROTOCOL_UB_CTP) {
                    ubctpCount++;
                }
            }
            std::printf(
                "[INFO] rank %u: peer %u layer[%u] id=%u links=%u ubctp=%u\n", resources.rank, peerRank, layerIndex,
                layers[layerIndex], linkCount, ubctpCount);
            if (layerIndex < netLayerStart) {
                continue;
            }
            const CommLink* link = FindUbcCtpLink(links, linkCount);
            if (link == nullptr) {
                continue;
            }
            AddPeerLink(peerRank, *link, FindOrAddGroup(link->srcEndpointDesc, groups));
            found = true;
            break;
        }
        if (!found) {
            std::fprintf(
                stderr, "[ERROR] rank %u: no UB_CTP link to rank %u (netLayerStart=%u, layerCount=%u)\n",
                resources.rank, peerRank, netLayerStart, layerCount);
            return FAILURE;
        }
    }
    return groups.empty() ? FAILURE : SUCCESS;
}

int32_t CreateCoreMultiChannel(
    RankResources& resources, const EndpointGroup& group, size_t groupIndex, uint32_t coreIndex,
    MultiChannelHandle& multiChannel)
{
    // Use the HcclComm overload of MakeMultiChannelHandle: the communicator negotiates connections internally, so no
    // manual SERVER/CLIENT role or listen port is required, and the created resources are owned by the communicator.
    // The SQ depth uses the library default because HcclChannelDesc has no depth field.
    std::vector<HcclChannelDesc> descs(group.remoteEndpoints.size());
    CHECK_RESULT(HcclChannelDescInit(descs.data(), static_cast<uint32_t>(descs.size())), HCCL_SUCCESS, resources.rank);
    for (size_t i = 0U; i < descs.size(); ++i) {
        descs[i].remoteRank = group.peerRanks[i];
        descs[i].channelProtocol = COMM_PROTOCOL_UB_CTP;
        descs[i].localEndpoint = group.localEndpoint;
        descs[i].remoteEndpoint = group.remoteEndpoints[i];
        descs[i].memHandles = &resources.memHandle;
        descs[i].memHandleNum = 1U;
    }

    // The tag must be unique per successful call inside one communicator, so it carries both the endpoint group index
    // and the AIV core index.
    const std::string sharedQueueTag = std::string(SHARED_QUEUE_TAG_PREFIX) + "_" + std::to_string(resources.rank) +
                                       "_" + std::to_string(groupIndex) + "_" + std::to_string(coreIndex);
    CHECK_RESULT(
        MakeMultiChannelHandle(
            resources.comm, sharedQueueTag.c_str(), descs.data(), static_cast<uint32_t>(descs.size()), &multiChannel),
        HCCL_SUCCESS, resources.rank);
    return SUCCESS;
}

int32_t CreateMultiChannelHandles(RankResources& resources, std::vector<EndpointGroup>& groups)
{
    for (size_t groupIndex = 0U; groupIndex < groups.size(); ++groupIndex) {
        EndpointGroup& group = groups[groupIndex];
        group.multiChannels.resize(AIV_CORE_NUM, 0U);
        for (uint32_t coreIndex = 0U; coreIndex < AIV_CORE_NUM; ++coreIndex) {
            CHECK_RESULT(
                CreateCoreMultiChannel(resources, group, groupIndex, coreIndex, group.multiChannels[coreIndex]),
                SUCCESS, resources.rank);
        }
    }
    return SUCCESS;
}

int32_t LaunchBatchKernel(RankResources& resources, std::vector<BatchContext>& contexts)
{
    const size_t contextSize = contexts.size() * sizeof(contexts.front());
    CHECK_RESULT(
        aclrtMemcpy(resources.deviceContext, contextSize, contexts.data(), contextSize, ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, resources.rank);
    rdv_hccl_kernel<<<AIV_CORE_NUM, nullptr, resources.stream>>>(resources.deviceContext);
    CHECK_RESULT(aclrtSynchronizeStream(resources.stream), ACL_SUCCESS, resources.rank);
    CHECK_RESULT(
        aclrtMemcpy(contexts.data(), contextSize, resources.deviceContext, contextSize, ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, resources.rank);
    for (uint32_t coreIndex = 0U; coreIndex < AIV_CORE_NUM; ++coreIndex) {
        const BatchContext& context = contexts[coreIndex];
        if (context.result != KERNEL_SUCCESS) {
            std::fprintf(
                stderr, "[ERROR] rank %u core %u: %s, hcomm ret=%d\n", resources.rank, coreIndex,
                GetKernelError(context.result), context.hcommResult);
            return FAILURE;
        }
    }
    return SUCCESS;
}

int32_t RunGroupKernel(RankResources& resources, const EndpointGroup& group, const std::vector<uint64_t>& remoteBuffers)
{
    if (group.peerRanks.empty() || group.peerRanks.size() > MAX_CHANNEL_NUM) {
        return FAILURE;
    }

    const uint32_t channelNum = static_cast<uint32_t>(group.peerRanks.size());
    const uint32_t batchLimitedWqes = BATCH_CAPACITY_BB / (channelNum * WQE_BB_NUM);
    const uint32_t wqesPerPeerPerCommit =
        batchLimitedWqes < WQES_PER_PEER_PER_ITERATION ? batchLimitedWqes : WQES_PER_PEER_PER_ITERATION;
    if (wqesPerPeerPerCommit == 0U) {
        std::fprintf(
            stderr, "[ERROR] rank %u: channel count %u cannot fit one WQE in the batch buffer\n", resources.rank,
            channelNum);
        return FAILURE;
    }

    std::vector<BatchContext> contexts(AIV_CORE_NUM);
    for (uint32_t coreIndex = 0U; coreIndex < AIV_CORE_NUM; ++coreIndex) {
        BatchContext& context = contexts[coreIndex];
        context.multiChannel = group.multiChannels[coreIndex];
        context.localBuffer = reinterpret_cast<uint64_t>(resources.deviceBuffer);
        context.myRank = resources.rank;
        context.channelNum = channelNum;
        context.wqesPerPeerPerCommit = wqesPerPeerPerCommit;
        context.sqDepth = 0U;
        context.cqDepth = 0U;
        context.result = KERNEL_SUCCESS;
        context.hcommResult = 0;
        for (size_t channelIndex = 0U; channelIndex < group.peerRanks.size(); ++channelIndex) {
            context.remoteBuffers[channelIndex] = remoteBuffers[group.peerRanks[channelIndex]];
            context.peerRanks[channelIndex] = group.peerRanks[channelIndex];
        }
    }

    CHECK_RESULT(LaunchBatchKernel(resources, contexts), SUCCESS, resources.rank);
    std::printf(
        "[INFO] rank %u: shared Jetty SQ depth = %u, CQ depth = %u\n", resources.rank, contexts.front().sqDepth,
        contexts.front().cqDepth);

    return SUCCESS;
}

int32_t ValidateResults(const RankResources& resources)
{
    const uint64_t commBufferSize = resources.commBufferSize;
    std::vector<uint8_t> hostBuffer(static_cast<size_t>(commBufferSize), 0U);
    CHECK_RESULT(
        aclrtMemcpy(
            hostBuffer.data(), commBufferSize, resources.deviceBuffer, commBufferSize, ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, resources.rank);

    for (uint32_t peerRank = 0U; peerRank < resources.rankNum; ++peerRank) {
        if (peerRank == resources.rank) {
            continue;
        }
        for (uint32_t coreIndex = 0U; coreIndex < AIV_CORE_NUM; ++coreIndex) {
            uint64_t receiveOffset =
                RECV_BASE_OFFSET + (static_cast<uint64_t>(peerRank) * AIV_CORE_NUM + coreIndex) * DATA_SIZE;
            for (uint32_t offset = 0U; offset < DATA_SIZE; ++offset) {
                uint8_t actual = hostBuffer[receiveOffset + offset];
                uint8_t expected = GetDataValue(peerRank, coreIndex, offset);
                if (actual != expected) {
                    std::fprintf(
                        stderr,
                        "[ERROR] rank %u: core %u data from rank %u mismatch at %u, actual=0x%02x, "
                        "expected=0x%02x\n",
                        resources.rank, coreIndex, peerRank, offset, actual, expected);
                    return FAILURE;
                }
            }
        }
    }
    return SUCCESS;
}

int32_t RunRank(
    uint32_t rank, uint32_t rankNum, const std::string& bootstrapHost, uint16_t bootstrapPort, int32_t deviceId)
{
    RankResources resources{};
    resources.rank = rank;
    resources.rankNum = rankNum;
    resources.bootstrapHost = bootstrapHost;
    resources.bootstrapPort = bootstrapPort;
    resources.deviceId = deviceId;
    resources.commBufferSize = RECV_BASE_OFFSET + static_cast<uint64_t>(rankNum) * AIV_CORE_NUM * DATA_SIZE;

    CHECK_RESULT(InitAcl(resources), SUCCESS, rank);
    CHECK_RESULT(SetupBootstrap(resources), SUCCESS, rank);
    CHECK_RESULT(InitCommunicator(resources), SUCCESS, rank);

    std::vector<uint64_t> remoteBuffers;
    CHECK_RESULT(PrepareMemory(resources, remoteBuffers), SUCCESS, rank);

    std::vector<EndpointGroup> groups;
    CHECK_RESULT(BuildEndpointGroups(resources, groups), SUCCESS, rank);
    CHECK_RESULT(CreateMultiChannelHandles(resources, groups), SUCCESS, rank);

    CHECK_RESULT(BootstrapBarrier(resources, "before kernel"), SUCCESS, rank);
    for (const EndpointGroup& group : groups) {
        CHECK_RESULT(RunGroupKernel(resources, group, remoteBuffers), SUCCESS, rank);
    }
    CHECK_RESULT(BootstrapBarrier(resources, "after kernel"), SUCCESS, rank);
    CHECK_RESULT(ValidateResults(resources), SUCCESS, rank);
    std::printf("rank=%u, rdv write verified\n", resources.rank);
    return SUCCESS;
}

bool ParseUnsigned(const char* value, unsigned long& parsed)
{
    if (value == nullptr || std::strlen(value) == 0U || value[0] == '-') {
        return false;
    }
    const size_t valueLength = std::strlen(value);
    char* end = nullptr;
    errno = 0;
    parsed = std::strtoul(value, &end, 10);
    return errno == 0 && end != value && static_cast<size_t>(end - value) == valueLength;
}

bool ParseOptions(
    int32_t argc, char** argv, uint32_t& rankNum, uint32_t& rank, std::string& host, uint16_t& port, int32_t& deviceId)
{
    if (argc != 5) {
        return false;
    }
    unsigned long parsedRankNum = 0UL;
    unsigned long parsedRank = 0UL;
    unsigned long parsedDevice = 0UL;
    if (!ParseUnsigned(argv[1], parsedRankNum) || !ParseUnsigned(argv[2], parsedRank) ||
        !ParseUnsigned(argv[4], parsedDevice) || parsedRankNum < 2UL || parsedRankNum > MAX_RANK_NUM ||
        parsedRank >= parsedRankNum || parsedDevice > static_cast<unsigned long>(std::numeric_limits<int32_t>::max())) {
        return false;
    }
    if (!ParseIpPort(argv[3], host, port)) {
        return false;
    }
    rankNum = static_cast<uint32_t>(parsedRankNum);
    rank = static_cast<uint32_t>(parsedRank);
    deviceId = static_cast<int32_t>(parsedDevice);
    return true;
}

} // namespace

int32_t main(int32_t argc, char** argv)
{
    (void)signal(SIGPIPE, SIG_IGN);
    uint32_t rankNum = DEFAULT_RANK_NUM;
    uint32_t rank = 0U;
    std::string bootstrapHost;
    uint16_t bootstrapPort = 0U;
    int32_t deviceId = 0;
    if (!ParseOptions(argc, argv, rankNum, rank, bootstrapHost, bootstrapPort, deviceId)) {
        std::fprintf(stderr, "Usage: %s <rank_size> <rank> <ipport> <device_id>\n", argv[0]);
        return FAILURE;
    }
    return RunRank(rank, rankNum, bootstrapHost, bootstrapPort, deviceId);
}
