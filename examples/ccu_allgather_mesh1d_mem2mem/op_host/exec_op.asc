/**
 * @brief 实现 Mesh1D Mem2Mem AllGather 的参数计算和 CCU 任务下发。
 *
 * CCU Thread、Channel、Kernel 及 EngineCtx 由 alg_resource.cc 管理。本文件
 * 负责检查算子参数、计算 GroupCopy 参数并按 10 参数任务 ABI 下发 Kernel。
 */
#include "exec_op.h"

#include <cstdint>
#include <iostream>
#include <string>
#include <vector>

#include <acl/acl.h>
#include <hccl/hccl.h>
#include <hccl/hcomm_primitives.h>

#include "alg_resource.h"
#include "ccu_kernel.h"
#include <ccu/hcomm/ccu_launch.h>
#include <ccu/hcomm/ccu_res.h>

namespace CcuAgMem2mem {
namespace {

constexpr uint64_t MAX_RANKS = 16;

bool IsAscend950()
{
    const char* soc = aclrtGetSocName();
    return soc != nullptr && std::string(soc).find("Ascend950") != std::string::npos;
}

constexpr uint64_t SetBitsHost(uint16_t end) { return ((uint64_t(1) << (end + 1)) - uint64_t(1)); }

uint64_t GetMaxLoopIterNumHost()
{
    constexpr uint16_t loopNumBitNum = 12;
    return SetBitsHost(loopNumBitNum);
}

uint64_t GetParallelParamHost(uint64_t repeatNum, uint64_t repeatLoopIndex, uint64_t totalLoopNum)
{
    constexpr uint16_t repeatBitNum = 7;
    constexpr uint16_t repeatNumShiftBit = 55;
    constexpr uint16_t repeatLoopBitNum = 7;
    constexpr uint16_t repeatLoopShiftBit = 48;
    constexpr uint16_t totalLoopBitNum = 7;
    constexpr uint16_t totalLoopShiftBit = 41;
    return ((repeatNum & SetBitsHost(repeatBitNum)) << repeatNumShiftBit) |
           ((repeatLoopIndex & SetBitsHost(repeatLoopBitNum)) << repeatLoopShiftBit) |
           ((totalLoopNum & SetBitsHost(totalLoopBitNum)) << totalLoopShiftBit);
}

std::vector<uint64_t> CalGoSize(uint64_t size, const LoopGroupConfig& config)
{
    const uint64_t loopSize = config.loopCount * config.memSlice;
    const uint64_t maxSize = loopSize * (GetMaxLoopIterNumHost() + 1);

    uint64_t loopCount = size / loopSize;
    uint64_t sliceCount = (size - loopCount * loopSize) / config.memSlice;
    uint64_t residual = size - loopCount * loopSize - sliceCount * config.memSlice;

    if (size == maxSize) {
        loopCount = GetMaxLoopIterNumHost();
        sliceCount = config.loopCount - 1;
        residual = config.memSlice;
    }

    const uint64_t offset = config.memSlice * config.loopCount * loopCount;
    uint64_t parallelParam = 0;
    uint64_t tailSize = 0;
    constexpr uint64_t twoLoops = 2;

    if (sliceCount != 0 && residual == 0) {
        parallelParam = GetParallelParamHost(sliceCount - 1, 0, 1);
        tailSize = config.memSlice;
    } else if (sliceCount == 0 && residual != 0) {
        parallelParam = GetParallelParamHost(0, 0, 1);
        tailSize = residual;
    } else if (sliceCount != 0) {
        parallelParam = GetParallelParamHost(sliceCount - 1, 1, twoLoops);
        tailSize = residual;
    }
    return {offset, loopCount, parallelParam, tailSize};
}

} // namespace

HcclResult AllGatherMesh1D(void* sendBuf, void* recvBuf, uint64_t count, HcclComm comm, aclrtStream stream)
{
    if (comm == nullptr || sendBuf == nullptr || recvBuf == nullptr) {
        return HCCL_E_PTR;
    }

    uint32_t myRank = 0;
    uint32_t rankSize = 0;
    RETURN_IF_HCCL_FAIL(HcclGetRankId(comm, &myRank));
    RETURN_IF_HCCL_FAIL(HcclGetRankSize(comm, &rankSize));
    if (rankSize == 0 || rankSize > MAX_RANKS) {
        return HCCL_E_PARA;
    }
    if (!IsAscend950()) {
        std::cerr << "AllGatherMesh1D only supports Ascend950 "
                  << "(dav-3510)\n";
        return HCCL_E_NOT_SUPPORT;
    }
    if (count == 0) {
        return HCCL_SUCCESS;
    }

    constexpr char tag[] = "CcuAgMem2mem";
    AlgResourceCtx resCtx;
    RETURN_IF_HCCL_FAIL(InitAlgResourceCtx(comm, tag, myRank, rankSize, stream, resCtx));

    const uint64_t dataSize = count * sizeof(float);
    if (rankSize == 1) {
        RETURN_IF_HCCL_FAIL(
            static_cast<HcclResult>(HcommLocalCopyOnThread(resCtx.threads[0], recvBuf, sendBuf, dataSize)));
        return HCCL_SUCCESS;
    }

    uint64_t token = 0;
    RETURN_IF_HCCL_FAIL(ConvertCcuToHccl(hcomm_ccu_get_mem_token(reinterpret_cast<uint64_t>(sendBuf), dataSize, &token)));

    LoopGroupConfig config{};
    config.msInterleave = CCU_MS_INTERLEAVE;
    config.loopCount = CCU_MS_LOCAL_COPY_LOOP_COUNT;
    config.memSlice = CCU_MS_SIZE * CCU_LOCAL_COPY_MS_PER_LOOP;
    const std::vector<uint64_t> goSize = CalGoSize(dataSize, config);

    uint64_t taskArgs[TASK_ARG_NUM]{};
    taskArgs[TASK_INPUT_ADDR] = reinterpret_cast<uint64_t>(sendBuf);
    taskArgs[TASK_OUTPUT_ADDR] = reinterpret_cast<uint64_t>(recvBuf);
    taskArgs[TASK_TOKEN] = token;
    taskArgs[TASK_INPUT_SLICE_STRIDE] = 0;
    taskArgs[TASK_OUTPUT_SLICE_STRIDE] = dataSize;
    taskArgs[TASK_CHUNK_SIZE] = dataSize;
    taskArgs[TASK_GO_ADDR_OFFSET] = goSize[0];
    taskArgs[TASK_GO_LOOP_PARAM] = goSize[1];
    taskArgs[TASK_GO_PARALLEL_PARAM] = goSize[2];
    taskArgs[TASK_GO_RESIDUAL] = goSize[3];

    RETURN_IF_HCCL_FAIL(
        ConvertCcuToHccl(hcomm_ccu_kernel_launch(resCtx.threads[0], resCtx.ccuKernels[0], taskArgs, TASK_ARG_NUM)));
    return HCCL_SUCCESS;
}

} // namespace CcuAgMem2mem
