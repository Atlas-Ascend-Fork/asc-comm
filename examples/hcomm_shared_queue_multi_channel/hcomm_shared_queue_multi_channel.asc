/*!
 * \file hcomm_shared_queue_multi_channel.asc
 * \brief Hcomm multi-channel shared-queue device kernel sample
 */

#include "acl/acl.h"
#include "adv_api/hcomm/hcomm.h"
#include "kernel_operator.h"

constexpr uint32_t HCOMM_WORKSPACE_BYTES = 512;
constexpr uint64_t HCOMM_NOTIFY_VALUE = 1;

__vector__ __global__ void hcomm_shared_queue_multi_channel(
    AscendC::ChannelHandle channel, __gm__ uint8_t* localAddr, __gm__ uint8_t* remoteAddr,
    __gm__ uint8_t* remoteNotifyAddr, uint64_t bytes)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<uint8_t> workspace = ubAllocator.Alloc<uint8_t, HCOMM_WORKSPACE_BYTES>();

    AscendC::Hcomm<AscendC::COMM_PROTOCOL_UBC_CTP> hcomm;
    int32_t ret = hcomm.Init(reinterpret_cast<__ubuf__ uint8_t*>(workspace.GetPhyAddr()), HCOMM_WORKSPACE_BYTES);
    if (ret != AscendC::HCOMM_SUCCESS) {
        return;
    }

    ret = hcomm.Lock(channel);
    if (ret != AscendC::HCOMM_SUCCESS) {
        return;
    }

    ret = hcomm.WriteWithNotifyNbi<false>(channel, remoteAddr, localAddr, bytes, remoteNotifyAddr, HCOMM_NOTIFY_VALUE);
    if (ret == AscendC::HCOMM_SUCCESS) {
        ret = hcomm.Commit(channel);
    }
    if (ret == AscendC::HCOMM_SUCCESS) {
        ret = hcomm.Drain(channel);
    }

    (void)hcomm.Unlock(channel);
}

extern "C" void run_hcomm_shared_queue_multi_channel(
    AscendC::ChannelHandle channel, uint8_t* localAddr, uint8_t* remoteAddr, uint8_t* remoteNotifyAddr, uint64_t bytes,
    aclrtStream stream)
{
    hcomm_shared_queue_multi_channel<<<1, 0, stream>>>(channel, localAddr, remoteAddr, remoteNotifyAddr, bytes);
}
