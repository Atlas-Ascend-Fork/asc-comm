+HcclResult TcpBarrier(uint32_t rank, uint32_t rankSize, const std::string& ipPort)
+{
+    std::string host;
+    uint16_t rootPort = 0;
+    if (!ParseIpPort(ipPort, &host, &rootPort)) {
+        return HCCL_E_PARA;
+    }
+
+    const uint16_t barrierPort = static_cast<uint16_t>(rootPort + 1);
+    char token = 1;
+    if (rank == 0) {
+        const int listenFd = CreateListenSocket(host, barrierPort);
+        if (listenFd < 0) {
+            return HCCL_E_INTERNAL;
+        }
+
+        std::vector<int> peerFds;
+        bool success = true;
+        for (uint32_t peer = 1; peer < rankSize; ++peer) {
+            const int fd = accept(listenFd, nullptr, nullptr);
+            if (fd < 0 || !RecvAll(fd, &token, sizeof(token))) {
+                if (fd >= 0) {
+                    close(fd);
+                }
+                success = false;
+                break;
+            }
+            peerFds.push_back(fd);
+        }
+
+        if (success) {
+            for (int fd : peerFds) {
+                if (!SendAll(fd, &token, sizeof(token))) {
+                    success = false;
+                    break;
+                }
+            }
+        }
+        for (int fd : peerFds) {
+            close(fd);
+        }
+        close(listenFd);
+        return success ? HCCL_SUCCESS : HCCL_E_INTERNAL;
+    }
+
+    const int fd = ConnectToServer(host, barrierPort);
+    if (fd < 0) {
+        return HCCL_E_TIMEOUT;
+    }
+    const bool success = SendAll(fd, &token, sizeof(token)) && RecvAll(fd, &token, sizeof(token));
+    close(fd);
+    return success ? HCCL_SUCCESS : HCCL_E_INTERNAL;
+}
