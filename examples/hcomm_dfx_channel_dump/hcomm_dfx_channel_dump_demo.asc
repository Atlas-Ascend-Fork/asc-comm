extern void run_sample_allgather_custom(SampleAllGatherContext *ctx, aclrtStream stream);
extern void run_sample_allgather_callback_fault(SampleAllGatherContext *ctx, aclrtStream stream);
extern "C" void SampleAllGatherCustomKernel(SampleAllGatherContext *ctx);
extern "C" void SampleAllGatherCallbackFaultKernel(SampleAllGatherContext *ctx);
extern "C" aclError aclrtGetFuncBySymbol(const void *symbol, aclrtFuncHandle *funcHandle);
extern "C" aclError aclrtFunctionGetBinary(aclrtFuncHandle funcHandle, aclrtBinHandle *binHandle);

namespace {
constexpr const char *DEFAULT_ENDPOINT = "tcp://127.0.0.1:29631";
constexpr CommProtocol TARGET_COMM_PROTOCOL = COMM_PROTOCOL_UBC_CTP;

struct ExceptionRecord {
    std::atomic<bool> pending{false};
    std::atomic<uint64_t> count{0};
    uint32_t taskId = 0xFFFFFFFFU;
    uint32_t streamId = 0xFFFFFFFFU;
    uint32_t deviceId = 0xFFFFFFFFU;
    uint64_t deviceContextAddr = 0;
};

ExceptionRecord g_exception;
void *g_boundDeviceContext = nullptr;

#define ACL_CHECK(expr)                                                                                \
    do {                                                                                               \
        aclError ret = (expr);                                                                         \
        if (ret != ACL_SUCCESS) {                                                                      \
            std::printf("[hcomm_dfx_demo] ACL failed %s:%d ret=%d\n", __FILE__, __LINE__, ret);        \
            return static_cast<int>(ret);                                                              \
        }                                                                                              \
    } while (0)

#define HCCL_CHECK(expr)                                                                               \
    do {                                                                                               \
        HcclResult ret = (expr);                                                                       \
        if (ret != HCCL_SUCCESS) {                                                                     \
            std::printf("[hcomm_dfx_demo] HCCL failed %s:%d ret=%d\n", __FILE__, __LINE__, ret);       \
            return static_cast<int>(ret);                                                              \
        }                                                                                              \
    } while (0)

bool CopyDeviceToHost(uint64_t deviceAddr, void *hostBuf, size_t size)
{
    if (deviceAddr == 0 || hostBuf == nullptr || size == 0) {
        return false;
    }
    aclError ret = aclrtMemcpy(hostBuf, size, reinterpret_cast<void *>(deviceAddr), size, ACL_MEMCPY_DEVICE_TO_HOST);
    return ret == ACL_SUCCESS;
}

void RecordException(aclrtExceptionInfo *exceptionInfo, void *deviceContext)
{
    if (exceptionInfo == nullptr) {
        return;
    }

    g_exception.taskId = aclrtGetTaskIdFromExceptionInfo(exceptionInfo);
    g_exception.streamId = aclrtGetStreamIdFromExceptionInfo(exceptionInfo);
    g_exception.deviceId = aclrtGetDeviceIdFromExceptionInfo(exceptionInfo);
    g_exception.deviceContextAddr = reinterpret_cast<uint64_t>(deviceContext);
    uint64_t count = g_exception.count.fetch_add(1) + 1U;
    g_exception.pending.store(true, std::memory_order_release);
    std::printf("[hcomm_dfx_demo] CustomCallback entered count=%llu task=%u stream=%u device=%u deviceContext=0x%llx\n",
        static_cast<unsigned long long>(count), g_exception.taskId, g_exception.streamId, g_exception.deviceId,
        static_cast<unsigned long long>(g_exception.deviceContextAddr));
    std::fflush(stdout);
}

void CustomCallback(aclrtExceptionInfo *exceptionInfo)
{
    RecordException(exceptionInfo, g_boundDeviceContext);
}

void CustomBinaryCallback(aclrtExceptionInfo *exceptionInfo, void *userData)
{
    RecordException(exceptionInfo, userData);
}

bool ResolveExceptionContext(SampleAllGatherContext &ctx)
{
    std::memset(&ctx, 0, sizeof(ctx));
    if (g_exception.deviceContextAddr == 0) {
        return false;
    }

    if (!CopyDeviceToHost(g_exception.deviceContextAddr, &ctx, sizeof(ctx))) {
        std::printf("[hcomm_dfx_demo] copy CommContext failed ctx=0x%llx\n",
            static_cast<unsigned long long>(g_exception.deviceContextAddr));
        return false;
    }
    std::printf("[hcomm_dfx_demo] exception ctx channel=0x%llx local=0x%llx remote=0x%llx len=%llu "
                "writeRet=%d drainRet=%d rank=%u\n",
        static_cast<unsigned long long>(ctx.channelHandle), static_cast<unsigned long long>(ctx.localBufferAddr),
        static_cast<unsigned long long>(ctx.remoteBufferAddr), static_cast<unsigned long long>(ctx.len), ctx.writeRet,
        ctx.drainRet, ctx.rankId);
    return ctx.channelHandle != 0;
}

bool BindExceptionArgs(void *deviceContext)
{
    g_boundDeviceContext = deviceContext;
    aclrtFuncHandle funcHandle = nullptr;
    aclrtBinHandle binHandle = nullptr;
    const void *kernelSymbol = reinterpret_cast<const void *>(SampleAllGatherCallbackFaultKernel);
    if (aclrtGetFuncBySymbol(kernelSymbol, &funcHandle) != ACL_SUCCESS ||
        aclrtFunctionGetBinary(funcHandle, &binHandle) != ACL_SUCCESS ||
        aclrtBinarySetExceptionCallback(binHandle, CustomBinaryCallback, deviceContext) != ACL_SUCCESS) {
        std::printf("[hcomm_dfx_demo] bind exception args failed\n");
        return false;
    }
    std::printf("[hcomm_dfx_demo] exception args bound devContext=%p\n", deviceContext);
    std::fflush(stdout);
    return true;
}

class HcclManager {
public:
    HcclManager(uint32_t rank, uint32_t nranks) : rank_(rank), nranks_(nranks) {}
    ~HcclManager()
    {
        if (comm_ != nullptr) {
            HcclCommDestroy(comm_);
        }
        if (devContext_ != nullptr) {
            aclrtFree(devContext_);
        }
        if (devBuf_ != nullptr) {
            aclrtFree(devBuf_);
        }
        if (sock_ >= 0) {
            close(sock_);
        }
        if (stream_ != nullptr) {
            aclrtDestroyStream(stream_);
        }
        if (initialized_) {
            aclrtResetDevice(rank_);
            aclFinalize();
        }
    }

    int Init(const std::string &endpoint)
    {
        ACL_CHECK(aclInit(nullptr));
        initialized_ = true;
        ACL_CHECK(aclrtSetDevice(rank_));
        ACL_CHECK(aclrtCreateStream(&stream_));

        std::string ip;
        uint16_t port = 0;
        if (!ParseEndpoint(endpoint, ip, port) || ConnectPeer(rank_, ip, port, sock_) != 0) {
            std::printf("[hcomm_dfx_demo] rank=%u connect peer failed\n", rank_);
            return -1;
        }

        HcclRootInfo rootInfo;
        if (rank_ == 0) {
            HCCL_CHECK(HcclGetRootInfo(&rootInfo));
            if (SendAll(sock_, &rootInfo, sizeof(rootInfo)) != 0) {
                return -1;
            }
        } else if (RecvAll(sock_, &rootInfo, sizeof(rootInfo)) != 0) {
            return -1;
        }

        HcclCommConfig config;
        HcclCommConfigInit(&config);
        config.hcclWorldRankID = rank_;
        HCCL_CHECK(HcclCommInitRootInfoConfig(nranks_, &rootInfo, rank_, &config, &comm_));

        ACL_CHECK(aclrtMalloc(&devBuf_, HCOMM_DFX_COMM_BUF_SIZE, ACL_MEM_MALLOC_HUGE_ONLY));
        ACL_CHECK(aclrtMalloc(reinterpret_cast<void **>(&devContext_), sizeof(SampleAllGatherContext),
            ACL_MEM_MALLOC_HUGE_ONLY));

        CommMem regMem = {};
        regMem.type = COMM_MEM_TYPE_DEVICE;
        regMem.addr = devBuf_;
        regMem.size = HCOMM_DFX_COMM_BUF_SIZE;
        HcclMemHandle memHandle = nullptr;
        HCCL_CHECK(HcclCommMemReg(comm_, "shareBuf", &regMem, &memHandle));

        uint32_t peerRank = (rank_ + 1U) % nranks_;
        HcclChannelDesc channelDesc;
        HcclChannelDescInit(&channelDesc, 1);
        channelDesc.remoteRank = peerRank;
        channelDesc.channelProtocol = TARGET_COMM_PROTOCOL;
        channelDesc.memHandles = &memHandle;
        channelDesc.memHandleNum = 1;

        uint32_t *netLayers = nullptr;
        uint32_t netLayerNum = 0;
        HCCL_CHECK(HcclRankGraphGetLayers(comm_, &netLayers, &netLayerNum));
        if (netLayerNum == 0) {
            return -1;
        }
        CommLink *links = nullptr;
        uint32_t linkNum = 0;
        HCCL_CHECK(HcclRankGraphGetLinks(comm_, netLayers[0], rank_, peerRank, &links, &linkNum));
        bool linkFound = false;
        for (uint32_t idx = 0; idx < linkNum; ++idx) {
            if (links[idx].linkAttr.linkProtocol == TARGET_COMM_PROTOCOL) {
                channelDesc.localEndpoint = links[idx].srcEndpointDesc;
                channelDesc.remoteEndpoint = links[idx].dstEndpointDesc;
                linkFound = true;
                break;
            }
        }
        if (!linkFound) {
            return -1;
        }
        HCCL_CHECK(HcclChannelAcquire(comm_, COMM_ENGINE_AIV, &channelDesc, 1, &channel_));

        uint32_t memNum = 0;
        CommMem *remoteMems = nullptr;
        char **memTags = nullptr;
        HCCL_CHECK(HcclChannelGetRemoteMems(comm_, channel_, &memNum, &remoteMems, &memTags));
        for (uint32_t idx = 0; idx < memNum; ++idx) {
            if ((memTags != nullptr && memTags[idx] != nullptr && std::strcmp(memTags[idx], "shareBuf") == 0) ||
                memNum == 1) {
                remoteBufAddr_ = reinterpret_cast<uint64_t>(remoteMems[idx].addr);
                break;
            }
        }
        if (remoteBufAddr_ == 0) {
            return -1;
        }

        SampleAllGatherContext hostCtx = {};
        hostCtx.channelHandle = channel_;
        hostCtx.localBufferAddr = reinterpret_cast<uint64_t>(devBuf_);
        hostCtx.remoteBufferAddr = remoteBufAddr_;
        hostCtx.len = SAMPLE_ALLGATHER_NORMAL_LEN;
        hostCtx.writeRet = -9999;
        hostCtx.drainRet = -9999;
        hostCtx.rankId = rank_;
        ACL_CHECK(aclrtMemcpy(devContext_, sizeof(hostCtx), &hostCtx, sizeof(hostCtx), ACL_MEMCPY_HOST_TO_DEVICE));

        std::printf("[hcomm_dfx_demo] rank=%u channel=0x%llx local=0x%llx remote=0x%llx size=%llu\n", rank_,
            static_cast<unsigned long long>(channel_), static_cast<unsigned long long>(hostCtx.localBufferAddr),
            static_cast<unsigned long long>(remoteBufAddr_), static_cast<unsigned long long>(HCOMM_DFX_COMM_BUF_SIZE));
        std::fflush(stdout);
        return 0;
    }

    int Run()
    {
        aclrtSetExceptionInfoCallback(CustomCallback);
        BindExceptionArgs(devContext_);
        if (TcpBarrier(sock_) != 0) {
            return -1;
        }
        if (rank_ == 0) {
            std::printf("[hcomm_dfx_demo] launch sample allgather len=%llu\n",
                static_cast<unsigned long long>(SAMPLE_ALLGATHER_NORMAL_LEN));
            std::fflush(stdout);
            run_sample_allgather_custom(devContext_, stream_);
            aclError prefillRet = aclrtSynchronizeStream(stream_);
            std::printf("[hcomm_dfx_demo] rank=%u prefill aclrtSynchronizeStream ret=%d callbackCount=%llu\n",
                rank_, prefillRet, static_cast<unsigned long long>(g_exception.count.load()));
            std::fflush(stdout);
            std::printf("[hcomm_dfx_demo] launch callback fault trigger kernel\n");
            std::fflush(stdout);
            run_sample_allgather_callback_fault(devContext_, stream_);
            aclError syncRet = aclrtSynchronizeStream(stream_);
            std::printf("[hcomm_dfx_demo] rank=%u aclrtSynchronizeStream ret=%d callbackCount=%llu\n", rank_,
                syncRet, static_cast<unsigned long long>(g_exception.count.load()));
            std::fflush(stdout);
            ChannelHandle dumpChannel = channel_;
            SampleAllGatherContext deviceCtx = {};
            if (aclrtMemcpy(&deviceCtx, sizeof(deviceCtx), devContext_, sizeof(deviceCtx),
                    ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS) {
                std::printf("[hcomm_dfx_demo] post-kernel ctx channel=0x%llx local=0x%llx remote=0x%llx "
                            "len=%llu writeRet=%d drainRet=%d rank=%u\n",
                    static_cast<unsigned long long>(deviceCtx.channelHandle),
                    static_cast<unsigned long long>(deviceCtx.localBufferAddr),
                    static_cast<unsigned long long>(deviceCtx.remoteBufferAddr),
                    static_cast<unsigned long long>(deviceCtx.len), deviceCtx.writeRet, deviceCtx.drainRet,
                    deviceCtx.rankId);
                if (deviceCtx.channelHandle != 0) {
                    dumpChannel = static_cast<ChannelHandle>(deviceCtx.channelHandle);
                }
            } else {
                std::printf("[hcomm_dfx_demo] post-kernel ctx copy failed\n");
            }
            std::fflush(stdout);
            if (g_exception.pending.load(std::memory_order_acquire)) {
                SampleAllGatherContext ctx = {};
                if (ResolveExceptionContext(ctx)) {
                    dumpChannel = static_cast<ChannelHandle>(ctx.channelHandle);
                }
            }
            uint32_t len = 0;
            int32_t dumpRet = AscendC::HcommDfxGetChannelDumpInfoSize(1, &dumpChannel, &len);
            if (dumpRet != AscendC::HCOMM_SUCCESS || len == 0) {
                std::printf("[hcomm_dfx_demo] HcommDfxGetChannelDumpInfoSize failed ret=%d len=%u\n", dumpRet, len);
                std::fflush(stdout);
            } else {
                std::vector<uint8_t> buffer(len, 0);
                dumpRet = AscendC::HcommDfxDumpChannelInfo(1, &dumpChannel, buffer.data(), len);
                std::printf("[hcomm_dfx_demo] HcommDfxDumpChannelInfo ret=%d len=%u\n", dumpRet, len);
                std::fflush(stdout);
                if (dumpRet == AscendC::HCOMM_SUCCESS) {
                    (void)AscendC::HcommDfxParseAndPrintChannelInfo(buffer.data(), len);
                    std::fflush(stdout);
                }
            }
        }
        if (TcpBarrier(sock_) != 0) {
            return -1;
        }
        return 0;
    }

private:
    uint32_t rank_ = 0;
    uint32_t nranks_ = 0;
    int32_t sock_ = -1;
    bool initialized_ = false;
    aclrtStream stream_ = nullptr;
    HcclComm comm_ = nullptr;
    ChannelHandle channel_ = 0;
    void *devBuf_ = nullptr;
    SampleAllGatherContext *devContext_ = nullptr;
    uint64_t remoteBufAddr_ = 0;
};

int RunRank(uint32_t rank, uint32_t nranks, const std::string &endpoint)
{
    HcclManager manager(rank, nranks);
    if (manager.Init(endpoint) != 0) {
        return -1;
    }
    return manager.Run();
}

void ExitChild(int32_t ret)
{
    std::fflush(nullptr);
    _exit(ret);
}

} // namespace

int32_t main(int32_t argc, char *argv[])
{
    if (argc == 1) {
        std::string endpoint = DEFAULT_ENDPOINT;
        pid_t pid0 = fork();
        if (pid0 < 0) {
            return -1;
        }
        if (pid0 == 0) {
            ExitChild(RunRank(0, HCOMM_DFX_NRANKS, endpoint));
        }
        usleep(200000);
        pid_t pid1 = fork();
        if (pid1 < 0) {
            kill(pid0, SIGKILL);
            waitpid(pid0, nullptr, 0);
            return -1;
        }
        if (pid1 == 0) {
            ExitChild(RunRank(1, HCOMM_DFX_NRANKS, endpoint));
        }
        int32_t status0 = 0;
        int32_t status1 = 0;
        waitpid(pid0, &status0, 0);
        waitpid(pid1, &status1, 0);
        int32_t ret0 = WIFEXITED(status0) ? WEXITSTATUS(status0) : -1;
        int32_t ret1 = WIFEXITED(status1) ? WEXITSTATUS(status1) : -1;
        std::printf("[hcomm_dfx_demo] done rank0=%d rank1=%d\n", ret0, ret1);
        std::fflush(stdout);
        return ret0 == 0 && ret1 == 0 ? 0 : -1;
    }

    if (argc != 4) {
        std::fprintf(stderr, "Usage: %s or %s <rank> <nranks> <endpoint>\n", argv[0], argv[0]);
        return -1;
    }
    uint32_t rank = static_cast<uint32_t>(std::atoi(argv[1]));
    uint32_t nranks = static_cast<uint32_t>(std::atoi(argv[2]));
    if (nranks != HCOMM_DFX_NRANKS || rank >= HCOMM_DFX_NRANKS) {
        return -1;
    }
    return RunRank(rank, nranks, argv[3]);
}
