#define ACLCHECK(ret)                                                                          \
    do {                                                                                       \
        if (ret != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                        \
        }                                                                                      \
    } while (0)

#define HCCLCHECK(ret)                                                                          \
    do {                                                                                        \
        if (ret != HCCL_SUCCESS) {                                                              \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                         \
        }                                                                                       \
    } while (0)

namespace ops_comm_ag {
constexpr uint32_t CHANNEL_NOTIFY_NUM = 3;
constexpr uint32_t HCOMM_HOST_TASK_ARG_NUM = 10;
constexpr uint32_t HCOMM_ALG_TAG_LENGTH = 288;

struct HcclDfxOpInfo {
    CommAbiHeader header;
    uint64_t begin_time = 0;
    uint64_t end_time = 0;
    uint32_t opMode = 0;
    uint32_t op_type_ = 0;
    uint32_t reduce_op = 0;
    uint32_t data_type_ = 0;
    uint32_t outputType = 0;
    uint64_t dataCount = 0;
    uint32_t root = ~0U;
    char algTag[HCOMM_ALG_TAG_LENGTH];
    CommEngine engine = COMM_ENGINE_RESERVED;
    uint64_t cpuTsThread = 0;
    uint32_t cpuWaitAicpuNotifyIdx = ~0U;
    uint32_t cpuWaitAicpuNotifyId = ~0U;
    uint64_t inputMemAddr = 0;
    uint64_t inputMemSize = 0;
    uint64_t outputMemAddr = 0;
    uint64_t outputMemSize = 0;
    int8_t reserve[96];
};

extern "C" HcclResult HcclDfxRegOpInfoByCommId(char* commId, void* hcclDfxOpInfo);

struct PreparedCommArgs {
    ccu_kernel_info kernelInfo;
    CcuInsHandle ins_handle = 0;
    uint64_t task_args[HCOMM_HOST_TASK_ARG_NUM] = {};
    bool needLaunch = false;
};

static HcclResult GetDeviceType(DeviceType* deviceType)
{
    const char* socNamePtr = aclrtGetSocName();
    if (socNamePtr == nullptr) {
        HCCL_ERROR("[GetDeviceType] Failed to get soc name");
        return HCCL_E_RUNTIME;
    }

    std::string socName(socNamePtr);
    if (socName.find("Ascend910B") != std::string::npos) {
        *deviceType = DEVICE_TYPE_A2;
        return HCCL_SUCCESS;
    }
    if (socName.find("Ascend910_93") != std::string::npos) {
        *deviceType = DEVICE_TYPE_A3;
        return HCCL_SUCCESS;
    }
    if (socName.find("Ascend950") != std::string::npos) {
        *deviceType = DEVICE_TYPE_A5;
        return HCCL_SUCCESS;
    }
    HCCL_ERROR("[GetDeviceType] Unsupported soc name: %s", socName.c_str());
    return HCCL_E_NOT_SUPPORT;
}

static HcclResult GetThreadForCcu(HcclComm comm, const OpParam& param_, AlgResourceCtxSerializable& resCtxHost)
{
    constexpr uint32_t threadNum = 1;
    ThreadHandle thread;
    CHK_RET(HcclThreadAcquire(comm, param_.engine, threadNum, resCtxHost.notifyNumOnMainThread, &thread));
    resCtxHost.threads.push_back(thread);
    return HCCL_SUCCESS;
}

static HcclResult GetChannelForCcu(
    HcclComm comm, const OpParam& param_, std::vector<ChannelHandle>& kernelChannels, uint32_t& kernelDie)
{
    uint32_t channel_num = param_.rankSize - 1;
    kernelChannels.resize(channel_num);

    HcclDfxOpInfo hcclDfxOpInfo{};
    hcclDfxOpInfo.inputMemAddr = reinterpret_cast<uint64_t>(param_.inputPtr);
    hcclDfxOpInfo.inputMemSize = param_.inputSize;
    hcclDfxOpInfo.outputMemAddr = reinterpret_cast<uint64_t>(param_.outputPtr);
    hcclDfxOpInfo.outputMemSize = param_.outputSize;
    CHK_RET(HcclDfxRegOpInfoByCommId(const_cast<char*>(param_.commName), reinterpret_cast<void*>(&hcclDfxOpInfo)));

    uint32_t channelIndex = 0;
    bool hasKernelDie = false;
    for (uint32_t remoteRank = 0; remoteRank < param_.rankSize; remoteRank++) {
        if (remoteRank == param_.myRank) {
            continue;
        }

        uint32_t netLayer = 0;
        uint32_t listSize = 0;
        CommLink* linkList = nullptr;
        CHK_RET(HcclRankGraphGetLinks(comm, netLayer, param_.myRank, remoteRank, &linkList, &listSize));

        HcclChannelDesc desc;
        CHK_RET(HcclChannelDescInit(&desc, 1));
        CommProtocol protocol = CommProtocol::COMM_PROTOCOL_UBC_CTP;
        bool protocolExists = false;
        for (uint32_t idx = 0; idx < listSize; idx++) {
            CommLink link = linkList[idx];
            if (link.linkAttr.linkProtocol == protocol) {
                desc.remoteRank = remoteRank;
                desc.notifyNum = CHANNEL_NOTIFY_NUM;
                desc.channelProtocol = link.linkAttr.linkProtocol;
                desc.localEndpoint.protocol = link.srcEndpointDesc.protocol;
                desc.localEndpoint.commAddr = link.srcEndpointDesc.commAddr;
                desc.localEndpoint.loc = link.srcEndpointDesc.loc;
                desc.remoteEndpoint.protocol = link.dstEndpointDesc.protocol;
                desc.remoteEndpoint.commAddr = link.dstEndpointDesc.commAddr;
                desc.remoteEndpoint.loc = link.dstEndpointDesc.loc;
                uint32_t channelDie = 0;
                CHK_RET(asccomm_examples::QueryEndpointDie(comm, param_.myRank, link.srcEndpointDesc, channelDie));
                CHK_RET(asccomm_examples::MergeKernelDie(channelDie, hasKernelDie, kernelDie));
                protocolExists = true;
                break;
            }
        }
        if (!protocolExists) {
            HCCL_ERROR(
                "[GetChannelForCcu] Protocol %d not found between rank %u and rank %u", protocol, param_.myRank,
                remoteRank);
            return HCCL_E_NOT_FOUND;
        }
        CHK_RET(HcclChannelAcquire(comm, param_.engine, &desc, 1, &kernelChannels[channelIndex]));
        channelIndex++;
    }

    return HCCL_SUCCESS;
}

static HcclResult AllocAlgResource(HcclComm comm, const OpParam& param_, AlgResourceCtxSerializable& resCtxHost)
{
    HCCL_INFO("Start to execute AllocAlgResourceCCU.");
    void* cclBufferAddr = nullptr;
    uint64_t cclBufferSize = 0;
    CHK_RET(HcclGetHcclBuffer(comm, &cclBufferAddr, &cclBufferSize));
    resCtxHost.cclMem = CommBuffer{cclBufferAddr, cclBufferSize};
    resCtxHost.notifyNumOnMainThread = 0;

    CHK_RET(GetThreadForCcu(comm, param_, resCtxHost));
    CHK_RET(GetChannelForCcu(comm, param_, resCtxHost.kernelChannels, resCtxHost.kernelDie));

    HCCL_INFO("End to execute AllocAlgResourceCCU success.");
    return HCCL_SUCCESS;
}

static constexpr uint64_t set_bits(uint16_t end) { return ((uint64_t(1) << (end + 1)) - uint64_t(1)); }

static uint64_t GetMaxLoopIterNum()
{
    constexpr uint16_t loop_num_bit_num = 12;
    return set_bits(loop_num_bit_num);
}

static uint64_t GetParallelParamForHost(uint64_t repeat_num, uint64_t repeat_loop_index, uint64_t total_loop_num)
{
    constexpr uint16_t repeat_bit_num = 7;
    constexpr uint16_t repeat_num_shift_bit = 55;
    constexpr uint16_t repeat_loop_bit_num = 7;
    constexpr uint16_t repeat_loop_shift_bit = 48;
    constexpr uint16_t total_loop_bit_num = 7;
    constexpr uint16_t total_loop_shift_bit = 41;
    return ((repeat_num & set_bits(repeat_bit_num)) << repeat_num_shift_bit) |
           ((repeat_loop_index & set_bits(repeat_loop_bit_num)) << repeat_loop_shift_bit) |
           ((total_loop_num & set_bits(total_loop_bit_num)) << total_loop_shift_bit);
}

static std::vector<uint64_t> CalGoSize(uint64_t size, const loop_group_config& config)
{
    uint64_t loopSize = config.loop_count * config.mem_slice;
    uint64_t maxSize = loopSize * (GetMaxLoopIterNum() + 1);

    uint64_t m = size / loopSize;
    uint64_t n = (size - m * loopSize) / config.mem_slice;
    uint64_t p = size - m * loopSize - n * config.mem_slice;

    if (size == maxSize) {
        m = GetMaxLoopIterNum();
        n = config.loop_count - 1;
        p = config.mem_slice;
    }

    uint64_t offset = config.mem_slice * config.loop_count * m;
    uint64_t loop_iter_num_ = m;

    uint64_t loopExtendNum = 0;
    uint64_t tailSize = 0;
    constexpr uint64_t loopNumTwo = 2;

    if (n == 0 && p == 0) {
        loopExtendNum = 0;
        tailSize = 0;
    } else if (n != 0 && p == 0) {
        loopExtendNum = GetParallelParamForHost(n - 1, 0, 1);
        tailSize = config.mem_slice;
    } else if (n == 0 && p != 0) {
        loopExtendNum = GetParallelParamForHost(0, 0, 1);
        tailSize = p;
    } else {
        loopExtendNum = GetParallelParamForHost(n - 1, 1, loopNumTwo);
        tailSize = p;
    }

    return {offset, loop_iter_num_, loopExtendNum, tailSize};
}

static HcclResult PrepareCommArgs(
    const OpParam& param_, AlgResourceCtxSerializable& resCtx, PreparedCommArgs& preparedArgs)
{
    HCCL_INFO("[PrepareCommArgs] start");

    uint32_t dataTypeSize = SIZE_TABLE[param_.data_type_];
    uint64_t dataSize = param_.count_ * dataTypeSize;
    uint64_t count_ = param_.count_;

    if (count_ == 0) {
        HCCL_INFO("[PrepareCommArgs] DataCount == 0, ExecOp run Ends.");
        preparedArgs.needLaunch = false;
        return HCCL_SUCCESS;
    }

    if (param_.rankSize == 1) {
        CHK_RET(static_cast<HcclResult>(
            HcommLocalCopyOnThread(resCtx.threads[0], param_.outputPtr, param_.inputPtr, dataSize)));
        HCCL_INFO("[PrepareCommArgs] RankSize == 1, ExecOp run Ends.");
        preparedArgs.needLaunch = false;
        return HCCL_SUCCESS;
    }

    uint64_t token = 0;
    uint64_t baseInputAddr = reinterpret_cast<uint64_t>(param_.inputPtr);
    uint64_t baseOutputAddr = reinterpret_cast<uint64_t>(param_.outputPtr);
    if (param_.inputPtr != nullptr) {
        CHK_RET(ConvertCcuToHccl(asccomm_ccu_get_mem_token(baseInputAddr, dataSize, &token)));
    } else if (param_.outputPtr != nullptr) {
        CHK_RET(ConvertCcuToHccl(asccomm_ccu_get_mem_token(baseOutputAddr, dataSize, &token)));
    }

    HcclComm comm = static_cast<HcclComm>(param_.hcclComm);
    CHK_PTR_NULL(comm);

    preparedArgs.needLaunch = true;

    auto kernel_arg = std::make_shared<CcuKernelArgAllGatherMesh1DMem2Mem>();
    kernel_arg->rankSize = param_.rankSize;
    kernel_arg->rankId = param_.myRank;
    preparedArgs.kernelInfo.setKernelArg(kernel_arg);

    auto* kernelArgBase = static_cast<CcuKernelArgBase*>(preparedArgs.kernelInfo.kernel_arg);
    if (kernelArgBase == nullptr) {
        HCCL_ERROR("[PrepareCommArgs] kernel_arg ptr is err.");
        return HCCL_E_INTERNAL;
    }

    for (uint32_t i = 0; i < resCtx.kernelChannels.size(); ++i) {
        kernelArgBase->channels[i] = resCtx.kernelChannels[i];
    }
    kernelArgBase->channelCount = static_cast<uint32_t>(resCtx.kernelChannels.size());

    CcuInsHandle ins_handle{0};
    CHK_RET(asccomm_examples::QueryCcuInstance(comm, ins_handle));
    preparedArgs.ins_handle = ins_handle;

    uint64_t sliceSize = count_ * dataTypeSize;
    uint64_t currentRankSliceInputOffset = 0;
    uint64_t currentRankSliceOutputOffset = dataSize * param_.myRank;

    loop_group_config config{};
    config.ms_interleave = ccu_ms_interleave;
    config.loop_count = CCU_MS_LOCAL_COPY_LOOP_COUNT;
    config.mem_slice = ccu_ms_size * CCU_LOCAL_COPY_MS_PER_LOOP;
    auto goSize = CalGoSize(sliceSize, config);

    preparedArgs.task_args[0] = baseInputAddr;
    preparedArgs.task_args[1] = baseOutputAddr;
    preparedArgs.task_args[2] = token;
    preparedArgs.task_args[3] = currentRankSliceInputOffset;
    preparedArgs.task_args[4] = currentRankSliceOutputOffset;
    preparedArgs.task_args[5] = sliceSize;
    preparedArgs.task_args[6] = goSize[0];
    preparedArgs.task_args[7] = goSize[1];
    preparedArgs.task_args[8] = goSize[2];
    preparedArgs.task_args[9] = goSize[3];

    HCCL_INFO("[PrepareCommArgs] end");
    return HCCL_SUCCESS;
}

static HcclResult InitAlgResourceCtx(
    HcclComm comm, OpParam& param_, std::unique_ptr<AlgResourceCtxSerializable>& resCtxHost)
{
    void* ctx = nullptr;
    uint64_t size = 0;

    if (HcclEngineCtxGet(comm, param_.tag, param_.engine, &ctx, &size) == HCCL_SUCCESS) {
        HCCL_INFO("[HcclAllGatherCustom] Engine context_ already exists, reuse it");
        param_.ctxSize = size;
        char* resCtxSequence = static_cast<char*>(ctx);
        std::vector<char> ctxData(resCtxSequence, resCtxSequence + param_.ctxSize);
        resCtxHost->DeSerialize(ctxData);
    } else {
        HCCL_INFO("[HcclAllGatherCustom] Creating engine context_");
        HcclResult ret = AllocAlgResource(comm, param_, *resCtxHost);
        if (ret != HCCL_SUCCESS) {
            HCCL_ERROR("failed to alloc alg resource.");
            return ret;
        }
        std::vector<char> seq = resCtxHost->Serialize();
        uint64_t ctxSize = seq.size();

        void* newCtx = nullptr;
        CHK_RET(HcclEngineCtxCreate(comm, param_.tag, param_.engine, ctxSize, &newCtx));
        if (memcpy_s(newCtx, ctxSize, seq.data(), ctxSize) != EOK) {
            return HCCL_E_INTERNAL;
        }
        param_.ctxSize = ctxSize;
        HCCL_INFO("Execute GetAlgResCCU success.");
    }

    return HCCL_SUCCESS;
}
} // namespace ops_comm_ag

using namespace ops_comm_ag;

template <typename t, uint64_t count_>
__global__ __vector__ void vector_add(__gm__ void* recvBuf, __gm__ void* dstGm)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<t> srcGlobal;
    AscendC::GlobalTensor<t> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ t*)recvBuf); // 通信后的数据为计算输入数据
    dstGlobal.SetGlobalBuffer((__gm__ t*)dstGm);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<t> srcLocal = ubAllocator.Alloc<t, count_>();
    AscendC::LocalTensor<t> dstLocal = ubAllocator.Alloc<t, count_>();

    AscendC::DataCopy(srcLocal, srcGlobal, count_);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    t scalar = 8.0;
    AscendC::Adds(dstLocal, srcLocal, scalar, count_);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(dstGlobal, dstLocal, count_);
    AscendC::PipeBarrier<PIPE_ALL>();
}

HcclResult AllGatherAddCustom(
    void* computeBuf, void* sendBuf, void* recvBuf, uint64_t sendCount, HcclDataType data_type_, HcclComm comm,
    aclrtStream stream)
{
    HCCL_INFO("Start to execute AllGatherAddCustom");

    CHK_PTR_NULL(stream);
    CHK_PTR_NULL(comm);
    CHK_PTR_NULL(computeBuf);
    CHK_PTR_NULL(sendBuf);
    CHK_PTR_NULL(recvBuf);

    if (data_type_ != HCCL_DATA_TYPE_FP32 || sendCount != 256) {
        HCCL_ERROR("[AllGatherAddCustom] only support FP32 sendCount 256 in current vector_add kernel");
        return HCCL_E_PARA;
    }

    OpParam param_;

    CHK_RET(HcclGetRankId(comm, &param_.myRank));
    CHK_RET(HcclGetRankSize(comm, &param_.rankSize));

    uint32_t perDataSize = SIZE_TABLE[data_type_];
    uint64_t inputSize = sendCount * perDataSize;
    uint64_t outputSize = inputSize * param_.rankSize;
    int ret = sprintf_s(param_.tag, sizeof(param_.tag), "%s", "hccl_custom_allgather");
    if (ret <= 0) {
        HCCL_ERROR("[AllGatherAddCustom] Failed to fill param_.tag");
        return HCCL_E_INTERNAL;
    }
    CHK_RET(GetDeviceType(&param_.devType));
    if (param_.devType != DEVICE_TYPE_A5) {
        HCCL_ERROR("[AllGatherAddCustom] not Support Device type [%u]", param_.devType);
        return HCCL_E_INTERNAL;
    }

    param_.stream = stream;
    param_.hcclComm = comm;
    CHK_RET(HcclGetCommName(comm, param_.commName));
    HCCL_INFO("[AllGatherAddCustom] commName: %s", param_.commName);

    param_.opMode = OpMode::OPBASE;
    param_.engine = CommEngine::COMM_ENGINE_CCU;

    param_.inputPtr = sendBuf;
    param_.inputSize = inputSize;
    param_.outputPtr = recvBuf;
    param_.outputSize = outputSize;
    param_.count_ = sendCount;
    param_.data_type_ = data_type_;
    param_.op_type_ = HcclCMDType::HCCL_CMD_ALLGATHER;
    param_.algType = AlgType::ALG_TYPE_MESH_1D;

    // 创建ccu资源 部署通信算法
    std::unique_ptr<AlgResourceCtxSerializable> resCtxHost = std::make_unique<AlgResourceCtxSerializable>();
    CHK_RET(InitAlgResourceCtx(comm, param_, resCtxHost));

    // 准备通信参数
    PreparedCommArgs preparedArgs;
    CHK_RET(PrepareCommArgs(param_, *resCtxHost, preparedArgs));
    if (!preparedArgs.needLaunch) {
        CHK_RET(static_cast<HcclResult>(HcommThreadSynchronize(resCtxHost->threads[0])));
        vector_add<float, 512><<<1, nullptr, stream>>>(recvBuf, computeBuf);
        HCCL_INFO("AllGatherAddCustom executed successfully");
        return HCCL_SUCCESS;
    }

    // 下发ccu任务 <<<>>> 第一阶段
    /*********************************<<<>>> 第一阶段*************************************** */
    HcommCcuRegisterContextHandle context_{nullptr};
    CHK_RET(asccomm_examples::QueryCcuRegisterContext(comm, context_));
    HcommCcuLaunchContextPod launch_context{};
    CHK_RET(static_cast<HcclResult>(HcommCcuGetLaunchContext(resCtxHost->threads[0], &launch_context)));
    asccomm_ccu_host_kernel_launch_cfg cfg;
    cfg.ccu_schd = {1, 0, uint64_t{1} << resCtxHost->kernelDie};
    cfg.ccu_ins = preparedArgs.ins_handle;
    cfg.launch_context = &launch_context;
    cfg.attrs = nullptr;
    cfg.kernel_name = "CcuAllGatherMesh1DMem2MemKernel";
    cfg.register_context = context_;

    const void* kernel_args[] = {preparedArgs.kernelInfo.kernel_arg};
    asccomm_ccu_host_kernel_args launchArgs = {
        kernel_args,
        1,
        preparedArgs.task_args,
        HCOMM_HOST_TASK_ARG_NUM,
    };

    CHK_RET(ConvertCcuToHccl(
        asccomm_ccu_host_kernel_launch(reinterpret_cast<const void*>(CcuAllGatherMesh1DMem2MemKernel), &cfg, &launchArgs)));
    /*********************************************************************************************************** */
    CHK_RET(static_cast<HcclResult>(HcommThreadSynchronize(resCtxHost->threads[0])));

    // AllGather 完成后，下发 AICore add 任务。
    vector_add<float, 512><<<1, nullptr, stream>>>(recvBuf, computeBuf);

    HCCL_INFO("AllGatherAddCustom executed successfully");
    return HCCL_SUCCESS;
}

struct ThreadContext {
    HcclRootInfo* rootInfo;
    uint32_t device;
    uint32_t devCount;
};

int Sample(void* arg)
{
    ThreadContext* ctx = (ThreadContext*)arg;
    void* computeBuf = nullptr;
    void* sendBuf = nullptr;
    void* recvBuf = nullptr;
    uint32_t device = ctx->device;
    constexpr uint64_t sendCount = 256; // 发送方每个卡1K数据量
    constexpr uint64_t recvCount = 512; // 接受2K数据量
    size_t sendSize = sendCount * sizeof(float);
    size_t recvSize = recvCount * sizeof(float);
    // 设置当前线程操作的设备
    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(device)));

    // 初始化集合通信域
    HcclComm hcclComm;
    HCCLCHECK(HcclCommInitRootInfo(ctx->devCount, ctx->rootInfo, device, &hcclComm));

    // 创建任务流
    aclrtStream stream;
    ACLCHECK(aclrtCreateStream(&stream));

    // 申请集合通信操作的 Device 内存
    ACLCHECK(aclrtMalloc(&computeBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&sendBuf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&recvBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));

    // 申请 Host 内存用于存放输入数据，并将内容初始化为 Device ID
    void* hostBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&hostBuf, sendSize));
    float* tmpHostBuff = static_cast<float*>(hostBuf);
    for (uint64_t i = 0; i < sendCount; ++i) {
        tmpHostBuff[i] = static_cast<float>(device) + 1;
    }
    std::cout << "rankId: " << device << ", input: [";
    for (uint64_t i = 0; i < sendCount; ++i) {
        std::cout << " " << tmpHostBuff[i];
    }
    std::cout << " ]" << std::endl;

    // 将 Host 侧输入数据拷贝到 Device 侧
    ACLCHECK(aclrtMemcpy(sendBuf, sendSize, hostBuf, sendSize, ACL_MEMCPY_HOST_TO_DEVICE));
    // 释放 Host 侧内存
    ACLCHECK(aclrtFreeHost(hostBuf));

    // 执行 AllGatherAdd，先将通信域内所有 rank 的 sendBuf 按照 rank_id 顺序拼接到 recvBuf，再计算输出到 computeBuf
    HCCLCHECK(AllGatherAddCustom(computeBuf, sendBuf, recvBuf, sendCount, HCCL_DATA_TYPE_FP32, hcclComm, stream));

    // 阻塞等待任务流中的集合通信任务执行完成
    ACLCHECK(aclrtSynchronizeStream(stream));

    // 将 Device 侧集合通信任务结果拷贝到 Host，并打印结果
    std::this_thread::sleep_for(std::chrono::seconds(ctx->device));
    void* resultBuff;
    ACLCHECK(aclrtMallocHost(&resultBuff, recvSize));
    ACLCHECK(aclrtMemcpy(resultBuff, recvSize, computeBuf, recvSize, ACL_MEMCPY_DEVICE_TO_HOST));
    float* tmpResBuff = static_cast<float*>(resultBuff);
    std::cout << "rankId: " << ctx->device << ", computeBuf: [";
    for (uint32_t i = 0; i < recvCount; ++i) {
        std::cout << " " << tmpResBuff[i];
    }
    std::cout << " ]" << std::endl;

    ACLCHECK(aclrtFreeHost(resultBuff));

    // 释放资源
    HCCLCHECK(HcclCommDestroy(hcclComm)); // 销毁通信域
    if (computeBuf) {
        ACLCHECK(aclrtFree(computeBuf)); // 释放 Device 侧内存
    }
    if (sendBuf) {
        ACLCHECK(aclrtFree(sendBuf)); // 释放 Device 侧内存
    }
    if (recvBuf) {
        ACLCHECK(aclrtFree(recvBuf)); // 释放 Device 侧内存
    }
    ACLCHECK(aclrtDestroyStream(stream)); // 销毁任务流
    ACLCHECK(aclrtResetDevice(device));   // 重置设备
    return 0;
}

int main()
{
    // 设备资源初始化
    ACLCHECK(aclInit(NULL));
    // 查询设备数量
    uint32_t devCount;
    ACLCHECK(aclrtGetDeviceCount(&devCount));
    std::cout << "Found " << devCount << " NPU device(s) available" << std::endl;

    int32_t rootRank = 0;
    ACLCHECK(aclrtSetDevice(rootRank));
    // 生成 Root 节点信息，各线程使用同一份 RootInfo
    void* rootInfoBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoBuf, sizeof(HcclRootInfo)));
    HcclRootInfo* rootInfo = (HcclRootInfo*)rootInfoBuf;
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    // 启动线程执行集合通信操作
    std::vector<std::thread> threads(devCount);
    std::vector<ThreadContext> args_(devCount);
    for (uint32_t i = 0; i < devCount; i++) {
        args_[i].rootInfo = rootInfo;
        args_[i].device = i;
        args_[i].devCount = devCount;
        threads[i] = std::thread(Sample, (void*)&args_[i]);
    }
    for (uint32_t i = 0; i < devCount; i++) {
        threads[i].join();
    }

    // 释放资源
    ACLCHECK(aclrtFreeHost(rootInfoBuf)); // 释放 Host 内存
    ACLCHECK(aclFinalize());              // 设备去初始化
    return 0;
}
