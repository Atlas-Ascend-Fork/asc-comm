#define ACLCHECK(ret)                                                                          \
    do {                                                                                       \
        if (ret != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                        \
        }                                                                                      \
    } while (0)

#define HCCLCHECK(ret)                                                                          \
    do {                                                                                        \
        if (ret != HCCL_SUCCESS) {                                                              \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                         \
        }                                                                                       \
    } while (0)

namespace ops_comm_ag {
constexpr uint32_t CHANNEL_NOTIFY_NUM = 3;
constexpr uint32_t HCOMM_HOST_TASK_ARG_NUM = 10;
constexpr uint32_t HCOMM_ALG_TAG_LENGTH = 288;
constexpr uint8_t DIE_ID = 1;
constexpr uint32_t CKE_NUM = 2;

struct CcuMappedAddrs {
    uint64_t eventVa[CKE_NUM];
    uint64_t startVa[HCOMM_HOST_TASK_ARG_NUM];
};

struct HcclDfxOpInfo {
    CommAbiHeader header;
    uint64_t beginTime = 0;
    uint64_t endTime = 0;
    uint32_t opMode = 0;
    uint32_t opType = 0;
    uint32_t reduceOp = 0;
    uint32_t dataType = 0;
    uint32_t outputType = 0;
    uint64_t dataCount = 0;
    uint32_t root = ~0U;
    char algTag[HCOMM_ALG_TAG_LENGTH];
    CommEngine engine = COMM_ENGINE_RESERVED;
    uint64_t cpuTsThread = 0;
    uint32_t cpuWaitAicpuNotifyIdx = ~0U;
    uint32_t cpuWaitAicpuNotifyId = ~0U;
    uint64_t inputMemAddr = 0;
    uint64_t inputMemSize = 0;
    uint64_t outputMemAddr = 0;
    uint64_t outputMemSize = 0;
    int8_t reserve[96];
};

extern "C" HcclResult HcclDfxRegOpInfoByCommId(char *commId, void *hcclDfxOpInfo);

struct PreparedCommArgs {
    CcuKernelInfo kernelInfo;
    CcuInsHandle insHandle = 0;
    CcuMappedAddrs mappedAddrs{};
    uint64_t taskArgs[HCOMM_HOST_TASK_ARG_NUM] = {};
    bool needLaunch = false;
};

static HcclResult GetDeviceType(DeviceType *deviceType)
{
    const char *socNamePtr = aclrtGetSocName();
    if (socNamePtr == nullptr) {
        HCCL_ERROR("[GetDeviceType] Failed to get soc name");
        return HCCL_E_RUNTIME;
    }

    std::string socName(socNamePtr);
    if (socName.find("Ascend910B") != std::string::npos) {
        *deviceType = DEVICE_TYPE_A2;
        return HCCL_SUCCESS;
    }
    if (socName.find("Ascend910_93") != std::string::npos) {
        *deviceType = DEVICE_TYPE_A3;
        return HCCL_SUCCESS;
    }
    if (socName.find("Ascend950") != std::string::npos) {
        *deviceType = DEVICE_TYPE_A5;
        return HCCL_SUCCESS;
    }
    HCCL_ERROR("[GetDeviceType] Unsupported soc name: %s", socName.c_str());
    return HCCL_E_NOT_SUPPORT;
}

static HcclResult GetThreadForCcu(HcclComm comm, const OpParam &param, AlgResourceCtxSerializable &resCtxHost)
{
    constexpr uint32_t threadNum = 1;
    ThreadHandle thread;
    CHK_RET(HcclThreadAcquire(comm, param.engine, threadNum, resCtxHost.notifyNumOnMainThread, &thread));
    resCtxHost.threads.push_back(thread);
    return HCCL_SUCCESS;
}

static HcclResult GetChannelForCcu(HcclComm comm, const OpParam &param, std::vector<ChannelHandle> &kernelChannels)
{
    uint32_t channelNum = param.rankSize - 1;
    kernelChannels.resize(channelNum);

    HcclDfxOpInfo hcclDfxOpInfo{};
    hcclDfxOpInfo.inputMemAddr = reinterpret_cast<uint64_t>(param.inputPtr);
    hcclDfxOpInfo.inputMemSize = param.inputSize;
    hcclDfxOpInfo.outputMemAddr = reinterpret_cast<uint64_t>(param.outputPtr);
    hcclDfxOpInfo.outputMemSize = param.outputSize;
    CHK_RET(HcclDfxRegOpInfoByCommId(const_cast<char *>(param.commName),
        reinterpret_cast<void *>(&hcclDfxOpInfo)));

    uint32_t channelIndex = 0;
    for (uint32_t remoteRank = 0; remoteRank < param.rankSize; remoteRank++) {
        if (remoteRank == param.myRank) {
            continue;
        }

        uint32_t netLayer = 0;
        uint32_t listSize = 0;
        CommLink *linkList = nullptr;
        CHK_RET(HcclRankGraphGetLinks(comm, netLayer, param.myRank, remoteRank, &linkList, &listSize));

        HcclChannelDesc desc;
        CHK_RET(HcclChannelDescInit(&desc, 1));
        CommProtocol protocol = CommProtocol::COMM_PROTOCOL_UBC_CTP;
        bool protocolExists = false;
        for (uint32_t idx = 0; idx < listSize; idx++) {
            CommLink link = linkList[idx];
            if (link.linkAttr.linkProtocol == protocol) {
                desc.remoteRank = remoteRank;
                desc.notifyNum = CHANNEL_NOTIFY_NUM;
                desc.channelProtocol = link.linkAttr.linkProtocol;
                desc.localEndpoint.protocol = link.srcEndpointDesc.protocol;
                desc.localEndpoint.commAddr = link.srcEndpointDesc.commAddr;
                desc.localEndpoint.loc = link.srcEndpointDesc.loc;
                desc.remoteEndpoint.protocol = link.dstEndpointDesc.protocol;
                desc.remoteEndpoint.commAddr = link.dstEndpointDesc.commAddr;
                desc.remoteEndpoint.loc = link.dstEndpointDesc.loc;
                protocolExists = true;
                break;
            }
        }
        if (!protocolExists) {
            HCCL_ERROR("[GetChannelForCcu] Protocol %d not found between rank %u and rank %u",
                protocol, param.myRank, remoteRank);
            return HCCL_E_NOT_FOUND;
        }
        CHK_RET(HcclChannelAcquire(comm, param.engine, &desc, 1, &kernelChannels[channelIndex]));
        channelIndex++;
    }

    return HCCL_SUCCESS;
}

static HcclResult AllocAlgResource(HcclComm comm, const OpParam &param, AlgResourceCtxSerializable &resCtxHost)
{
    HCCL_INFO("Start to execute AllocAlgResourceCCU.");
    void *cclBufferAddr = nullptr;
    uint64_t cclBufferSize = 0;
    CHK_RET(HcclGetHcclBuffer(comm, &cclBufferAddr, &cclBufferSize));
    resCtxHost.cclMem = CommBuffer{cclBufferAddr, cclBufferSize};
    resCtxHost.notifyNumOnMainThread = 0;

    CHK_RET(GetThreadForCcu(comm, param, resCtxHost));
    CHK_RET(GetChannelForCcu(comm, param, resCtxHost.kernelChannels));

    HCCL_INFO("End to execute AllocAlgResourceCCU success.");
    return HCCL_SUCCESS;
}

static constexpr uint64_t SetBits(uint16_t end)
{
    return ((uint64_t(1) << (end + 1)) - uint64_t(1));
}

static uint64_t GetMaxLoopIterNum()
{
    constexpr uint16_t loopNumBitNum = 12;
    return SetBits(loopNumBitNum);
}

static uint64_t GetParallelParamForHost(uint64_t repeatNum, uint64_t repeatLoopIndex, uint64_t totalLoopNum)
{
    constexpr uint16_t repeatBitNum = 7;
    constexpr uint16_t repeatNumShiftBit = 55;
    constexpr uint16_t repeatLoopBitNum = 7;
    constexpr uint16_t repeatLoopShiftBit = 48;
    constexpr uint16_t totalLoopBitNum = 7;
    constexpr uint16_t totalLoopShiftBit = 41;
    return ((repeatNum & SetBits(repeatBitNum)) << repeatNumShiftBit)
           | ((repeatLoopIndex & SetBits(repeatLoopBitNum)) << repeatLoopShiftBit)
           | ((totalLoopNum & SetBits(totalLoopBitNum)) << totalLoopShiftBit);
}

static std::vector<uint64_t> CalGoSize(uint64_t size, const LoopGroupConfig &config)
{
    uint64_t loopSize = config.loopCount * config.memSlice;
    uint64_t maxSize = loopSize * (GetMaxLoopIterNum() + 1);

    uint64_t m = size / loopSize;
    uint64_t n = (size - m * loopSize) / config.memSlice;
    uint64_t p = size - m * loopSize - n * config.memSlice;

    if (size == maxSize) {
        m = GetMaxLoopIterNum();
        n = config.loopCount - 1;
        p = config.memSlice;
    }

    uint64_t offset = config.memSlice * config.loopCount * m;
    uint64_t loopIterNum = m;

    uint64_t loopExtendNum = 0;
    uint64_t tailSize = 0;
    constexpr uint64_t loopNumTwo = 2;

    if (n == 0 && p == 0) {
        loopExtendNum = 0;
        tailSize = 0;
    } else if (n != 0 && p == 0) {
        loopExtendNum = GetParallelParamForHost(n - 1, 0, 1);
        tailSize = config.memSlice;
    } else if (n == 0 && p != 0) {
        loopExtendNum = GetParallelParamForHost(0, 0, 1);
        tailSize = p;
    } else {
        loopExtendNum = GetParallelParamForHost(n - 1, 1, loopNumTwo);
        tailSize = p;
    }

    return {offset, loopIterNum, loopExtendNum, tailSize};
}

static HcclResult PrepareCommArgs(const OpParam &param, AlgResourceCtxSerializable &resCtx,
    PreparedCommArgs &preparedArgs)
{
    HCCL_INFO("[PrepareCommArgs] start");

    uint32_t dataTypeSize = SIZE_TABLE[param.dataType];
    uint64_t dataSize = param.count * dataTypeSize;
    uint64_t count = param.count;

    if (count == 0) {
        HCCL_INFO("[PrepareCommArgs] DataCount == 0, ExecOp Run Ends.");
        preparedArgs.needLaunch = false;
        return HCCL_SUCCESS;
    }

    if (param.rankSize == 1) {
        CHK_RET(static_cast<HcclResult>(HcommLocalCopyOnThread(resCtx.threads[0], param.outputPtr,
            param.inputPtr, dataSize)));
        HCCL_INFO("[PrepareCommArgs] RankSize == 1, ExecOp Run Ends.");
        preparedArgs.needLaunch = false;
        return HCCL_SUCCESS;
    }

    uint64_t token = 0;
    uint64_t baseInputAddr = reinterpret_cast<uint64_t>(param.inputPtr);
    uint64_t baseOutputAddr = reinterpret_cast<uint64_t>(param.outputPtr);
    if (param.inputPtr != nullptr) {
        HcommCcuGetMemToken(baseInputAddr, dataSize, &token);
    } else if (param.outputPtr != nullptr) {
        HcommCcuGetMemToken(baseOutputAddr, dataSize, &token);
    }

    HcclComm comm = static_cast<HcclComm>(param.hcclComm);
    CHK_PTR_NULL(comm);

    preparedArgs.needLaunch = true;

    auto kernelArg = std::make_shared<CcuKernelArgAllGatherMesh1DMem2Mem>();
    kernelArg->rankSize = param.rankSize;
    kernelArg->rankId = param.myRank;
    preparedArgs.kernelInfo.setKernelArg(kernelArg);

    auto *kernelArgBase = static_cast<CcuKernelArgBase *>(preparedArgs.kernelInfo.kernelArg);
    if (kernelArgBase == nullptr) {
        HCCL_ERROR("[PrepareCommArgs] kernelArg ptr is err.");
        return HCCL_E_INTERNAL;
    }

    for (uint32_t i = 0; i < resCtx.kernelChannels.size(); ++i) {
        kernelArgBase->channels[i] = resCtx.kernelChannels[i];
    }
    kernelArgBase->channelCount = static_cast<uint32_t>(resCtx.kernelChannels.size());

    CcuInsHandle insHandle{0};
    uint32_t insNum = 0;
    CHK_RET(HcclCommQueryCcuIns(comm, &insHandle, &insNum));
    CHK_PRT_RET(insNum != 1,
        HCCL_ERROR("[PrepareCommArgs] HcclCommQueryCcuIns fail! insNum is [%u]", insNum),
        HCCL_E_INTERNAL);
    preparedArgs.insHandle = insHandle;

    CcuResult ccuRet = CcuResult::CCU_E_RESERVED;
    CcuVariableHandle varHandle{0};
    ccuRet = HcommCcuVariableAlloc(insHandle, DIE_ID, HCOMM_HOST_TASK_ARG_NUM, &varHandle);
    CHK_RET(ConvertCcuToHccl(ccuRet));

    for (uint32_t i = 0; i < HCOMM_HOST_TASK_ARG_NUM; i++) {
        ccuRet = HcommCcuVariableAddrGet(varHandle, i, &preparedArgs.mappedAddrs.startVa[i]);
        CHK_RET(ConvertCcuToHccl(ccuRet));
        HCCL_INFO("[HcommCcuVariableAddrGet] startVa[%u] is [%lu]", i, preparedArgs.mappedAddrs.startVa[i]);
    }

    CcuEventHandle eventHandle{0};
    ccuRet = HcommCcuEventAlloc(insHandle, DIE_ID, CKE_NUM, &eventHandle);
    CHK_RET(ConvertCcuToHccl(ccuRet));

    for (uint32_t i = 0; i < CKE_NUM; i++) {
        ccuRet = HcommCcuEventAddrGet(eventHandle, i, &preparedArgs.mappedAddrs.eventVa[i]);
        CHK_RET(ConvertCcuToHccl(ccuRet));
        HCCL_INFO("[HcommCcuEventAddrGet] eventVa[%u] is [%lu]", i, preparedArgs.mappedAddrs.eventVa[i]);
    }

    kernelArg->varHandle = varHandle;
    kernelArg->varNum = HCOMM_HOST_TASK_ARG_NUM;
    kernelArg->eventHandle = eventHandle;
    kernelArg->eventNum = CKE_NUM;

    uint64_t sliceSize = count * dataTypeSize;
    uint64_t currentRankSliceInputOffset = 0;
    uint64_t currentRankSliceOutputOffset = dataSize * param.myRank;

    LoopGroupConfig config{};
    config.msInterleave = CCU_MS_INTERLEAVE;
    config.loopCount = CCU_MS_LOCAL_COPY_LOOP_COUNT;
    config.memSlice = CCU_MS_SIZE * CCU_LOCAL_COPY_MS_PER_LOOP;
    auto goSize = CalGoSize(sliceSize, config);

    preparedArgs.taskArgs[0] = baseInputAddr;
    preparedArgs.taskArgs[1] = baseOutputAddr;
    preparedArgs.taskArgs[2] = token;
    preparedArgs.taskArgs[3] = currentRankSliceInputOffset;
    preparedArgs.taskArgs[4] = currentRankSliceOutputOffset;
    preparedArgs.taskArgs[5] = sliceSize;
    preparedArgs.taskArgs[6] = goSize[0];
    preparedArgs.taskArgs[7] = goSize[1];
    preparedArgs.taskArgs[8] = goSize[2];
    preparedArgs.taskArgs[9] = goSize[3];

    HCCL_INFO("[PrepareCommArgs] end");
    return HCCL_SUCCESS;
}

static HcclResult InitAlgResourceCtx(HcclComm comm, OpParam &param,
                                      std::unique_ptr<AlgResourceCtxSerializable> &resCtxHost)
{
    void *ctx = nullptr;
    uint64_t size = 0;

    if (HcclEngineCtxGet(comm, param.tag, param.engine, &ctx, &size) == HCCL_SUCCESS) {
        HCCL_INFO("[HcclAllGatherCustom] Engine context already exists, reuse it");
        param.ctxSize = size;
        char *resCtxSequence = static_cast<char *>(ctx);
        std::vector<char> ctxData(resCtxSequence, resCtxSequence + param.ctxSize);
        resCtxHost->DeSerialize(ctxData);
    } else {
        HCCL_INFO("[HcclAllGatherCustom] Creating engine context");
        HcclResult ret = AllocAlgResource(comm, param, *resCtxHost);
        if (ret != HCCL_SUCCESS) {
            HCCL_ERROR("failed to alloc alg resource.");
            return ret;
        }
        std::vector<char> seq = resCtxHost->Serialize();
        uint64_t ctxSize = seq.size();

        void *newCtx = nullptr;
        CHK_RET(HcclEngineCtxCreate(comm, param.tag, param.engine, ctxSize, &newCtx));
        memcpy_s(newCtx, ctxSize, seq.data(), ctxSize);
        param.ctxSize = ctxSize;
        HCCL_INFO("Execute GetAlgResCCU success.");
    }

    return HCCL_SUCCESS;
}
} // namespace ops_comm_ag

using namespace ops_comm_ag;


template <typename T, uint64_t count>
__global__ __vector__ void vector_add(__gm__ void* src, __gm__ void* recvBuf, __gm__ void* dstGm,
                                      CcuMappedAddrs mappedAddrs, uint64_t token,
                                      uint64_t currentRankSliceInputOffset,
                                      uint64_t currentRankSliceOutputOffset, uint64_t sliceSize,
                                      uint64_t goSize0, uint64_t goSize1, uint64_t goSize2,
                                      uint64_t goSize3)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)recvBuf);// 通信后的数据为计算输入数据
    dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<T> srcLocal = ubAllocator.Alloc<T, count>();
    AscendC::LocalTensor<T> dstLocal = ubAllocator.Alloc<T, count>();

    __gm__ uint64_t *taskArgs0 = reinterpret_cast<__gm__ uint64_t *>(mappedAddrs.startVa[0]);
    __gm__ uint64_t *taskArgs1 = reinterpret_cast<__gm__ uint64_t *>(mappedAddrs.startVa[1]);
    __gm__ uint64_t *taskArgs2 = reinterpret_cast<__gm__ uint64_t *>(mappedAddrs.startVa[2]);
    __gm__ uint64_t *taskArgs3 = reinterpret_cast<__gm__ uint64_t *>(mappedAddrs.startVa[3]);
    __gm__ uint64_t *taskArgs4 = reinterpret_cast<__gm__ uint64_t *>(mappedAddrs.startVa[4]);
    __gm__ uint64_t *taskArgs5 = reinterpret_cast<__gm__ uint64_t *>(mappedAddrs.startVa[5]);
    __gm__ uint64_t *taskArgs6 = reinterpret_cast<__gm__ uint64_t *>(mappedAddrs.startVa[6]);
    __gm__ uint64_t *taskArgs7 = reinterpret_cast<__gm__ uint64_t *>(mappedAddrs.startVa[7]);
    __gm__ uint64_t *taskArgs8 = reinterpret_cast<__gm__ uint64_t *>(mappedAddrs.startVa[8]);
    __gm__ uint64_t *taskArgs9 = reinterpret_cast<__gm__ uint64_t *>(mappedAddrs.startVa[9]);

    AscendC::WriteGmByPassDCache<uint64_t>(taskArgs0, reinterpret_cast<uint64_t>(src));
    AscendC::WriteGmByPassDCache<uint64_t>(taskArgs1, reinterpret_cast<uint64_t>(recvBuf));
    AscendC::WriteGmByPassDCache<uint64_t>(taskArgs2, token);
    AscendC::WriteGmByPassDCache<uint64_t>(taskArgs3, currentRankSliceInputOffset);
    AscendC::WriteGmByPassDCache<uint64_t>(taskArgs4, currentRankSliceOutputOffset);
    AscendC::WriteGmByPassDCache<uint64_t>(taskArgs5, sliceSize);
    AscendC::WriteGmByPassDCache<uint64_t>(taskArgs6, goSize0);
    AscendC::WriteGmByPassDCache<uint64_t>(taskArgs7, goSize1);
    AscendC::WriteGmByPassDCache<uint64_t>(taskArgs8, goSize2);
    AscendC::WriteGmByPassDCache<uint64_t>(taskArgs9, goSize3);
    AscendC::DataSyncBarrier<AscendC::MemDsbT::ALL>();

    // taskargs参数设置后，通知ccu通信任务启动 使用event[0]
    __gm__ uint64_t *ckeAddr0 = reinterpret_cast<__gm__ uint64_t *>(mappedAddrs.eventVa[0]);
    __gm__ uint64_t *ckeAddr1 = reinterpret_cast<__gm__ uint64_t *>(mappedAddrs.eventVa[1]);
    AscendC::WriteGmByPassDCache<uint64_t>(ckeAddr0, 1);
    AscendC::DataSyncBarrier<AscendC::MemDsbT::ALL>();

    while(1) {
        // 轮询通信任务是否结束，使用event[1]
        uint64_t waitCke = AscendC::ReadGmByPassDCache(ckeAddr1);
        AscendC::DataSyncBarrier<AscendC::MemDsbT::ALL>();
        AscendC::Nop<800>();
        if (waitCke == 1) {
            break;
        }
    }

    AscendC::DataCopy(srcLocal, srcGlobal, count);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    T scalar = 8.0;
    AscendC::Adds(dstLocal, srcLocal, scalar, count);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(dstGlobal, dstLocal, count);
    AscendC::PipeBarrier<PIPE_ALL>();
}


HcclResult AllGatherAddCustom(void *computeBuf, void *sendBuf, void *recvBuf, uint64_t sendCount,
                              HcclDataType dataType, HcclComm comm, aclrtStream stream)
{
    HCCL_INFO("Start to execute AllGatherAddCustom");

    CHK_PTR_NULL(stream);
    CHK_PTR_NULL(comm);
    CHK_PTR_NULL(computeBuf);
    CHK_PTR_NULL(sendBuf);
    CHK_PTR_NULL(recvBuf);

    if (dataType != HCCL_DATA_TYPE_FP32 || sendCount != 256) {
        HCCL_ERROR("[AllGatherAddCustom] only support FP32 sendCount 256 in current vector_add kernel");
        return HCCL_E_PARA;
    }

    OpParam param;

    CHK_RET(HcclGetRankId(comm, &param.myRank));
    CHK_RET(HcclGetRankSize(comm, &param.rankSize));

    uint32_t perDataSize = SIZE_TABLE[dataType];
    uint64_t inputSize = sendCount * perDataSize;
    uint64_t outputSize = inputSize * param.rankSize;
    int ret = sprintf_s(param.tag, sizeof(param.tag), "%s", "hccl_custom_allgather");
    if (ret <= 0) {
        HCCL_ERROR("[AllGatherAddCustom] Failed to fill param.tag");
        return HCCL_E_INTERNAL;
    }
    CHK_RET(GetDeviceType(&param.devType));
    if (param.devType != DEVICE_TYPE_A5) {
        HCCL_ERROR("[AllGatherAddCustom] Not Support Device Type [%u]", param.devType);
        return HCCL_E_INTERNAL;
    }

    param.stream = stream;
    param.hcclComm = comm;
    CHK_RET(HcclGetCommName(comm, param.commName));
    HCCL_INFO("[AllGatherAddCustom] commName: %s", param.commName);

    param.opMode = OpMode::OPBASE;
    param.engine = CommEngine::COMM_ENGINE_CCU;

    param.inputPtr = sendBuf;
    param.inputSize = inputSize;
    param.outputPtr = recvBuf;
    param.outputSize = outputSize;
    param.count = sendCount;
    param.dataType = dataType;
    param.opType = HcclCMDType::HCCL_CMD_ALLGATHER;
    param.algType = AlgType::ALG_TYPE_MESH_1D;

    // 创建ccu资源 部署通信算法
    std::unique_ptr<AlgResourceCtxSerializable> resCtxHost = std::make_unique<AlgResourceCtxSerializable>();
    CHK_RET(InitAlgResourceCtx(comm, param, resCtxHost));

    // 准备通信参数
    PreparedCommArgs preparedArgs;
    CHK_RET(PrepareCommArgs(param, *resCtxHost, preparedArgs));
    if (!preparedArgs.needLaunch) {
        HCCL_INFO("AllGatherAddCustom executed successfully");
        return HCCL_SUCCESS;
    }

    // 下发ccu任务 <<<>>> 第一阶段
/*********************************<<<>>> 第一阶段*************************************** */
    HcommCcuHostKernelLaunchCfg cfg;
    cfg.ccuSchd = {1, 0, 0x01};
    cfg.ccuIns = preparedArgs.insHandle;
    cfg.stream = param.stream;
    cfg.thread = resCtxHost->threads[0];
    cfg.kernelName = "CcuAllGatherMesh1DMem2MemKernel";

    const void *kernelArgs[] = {preparedArgs.kernelInfo.kernelArg};
    HcommCcuHostKernelArgs launchArgs = {
        kernelArgs, 1,
        {}, 0,
    };

    CHK_RET(HcommCcuHostKernelLaunch(reinterpret_cast<const void*>(CcuAllGatherMesh1DMem2MemKernel), &cfg,
        &launchArgs));
/*********************************************************************************************************** */
    // Todo: 后续用 <<<>>> 替代
    // CcuAllGatherMesh1DMem2MemKernel<<<{1, 0, 0x01}, insHandle, param.stream>>>(kernelArg);


    // 下发 aicore 任务，将CCU通信需要的taskArgs按写入XN映射的startVa，使用CKE映射的eventVa控制
    vector_add<float, 512><<<1, nullptr, stream>>>(sendBuf, recvBuf, computeBuf, preparedArgs.mappedAddrs,
        preparedArgs.taskArgs[2], preparedArgs.taskArgs[3], preparedArgs.taskArgs[4], preparedArgs.taskArgs[5],
        preparedArgs.taskArgs[6], preparedArgs.taskArgs[7], preparedArgs.taskArgs[8], preparedArgs.taskArgs[9]);


    HCCL_INFO("AllGatherAddCustom executed successfully");
    return HCCL_SUCCESS;
}


struct ThreadContext {
    HcclRootInfo *rootInfo;
    uint32_t device;
    uint32_t devCount;
};

int Sample(void *arg)
{
    ThreadContext *ctx = (ThreadContext *)arg;
    void *computeBuf = nullptr;
    void *sendBuf = nullptr;
    void *recvBuf = nullptr;
    uint32_t device = ctx->device;
    constexpr uint64_t sendCount = 256; // 发送方每个卡1K数据量
    constexpr uint64_t recvCount = 512; // 接受2K数据量
    size_t sendSize = sendCount * sizeof(float);
    size_t recvSize = recvCount * sizeof(float);
    // 设置当前线程操作的设备
    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(device)));

    // 初始化集合通信域
    HcclComm hcclComm;
    HCCLCHECK(HcclCommInitRootInfo(ctx->devCount, ctx->rootInfo, device, &hcclComm));

    // 创建任务流
    aclrtStream stream;
    ACLCHECK(aclrtCreateStream(&stream));

    // 申请集合通信操作的 Device 内存
    ACLCHECK(aclrtMalloc(&computeBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&sendBuf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&recvBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));

    // 申请 Host 内存用于存放输入数据，并将内容初始化为 Device ID
    void *hostBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&hostBuf, sendSize));
    float *tmpHostBuff = static_cast<float *>(hostBuf);
    for (uint64_t i = 0; i < sendCount; ++i) {
        tmpHostBuff[i] = static_cast<float>(device) + 1;
    }
    std::cout << "rankId: " << device << ", input: [";
    for (uint64_t i = 0; i < sendCount; ++i) {
        std::cout << " " << tmpHostBuff[i];
    }
    std::cout << " ]" << std::endl;

    // 将 Host 侧输入数据拷贝到 Device 侧
    ACLCHECK(aclrtMemcpy(sendBuf, sendSize, hostBuf, sendSize, ACL_MEMCPY_HOST_TO_DEVICE));
    // 释放 Host 侧内存
    ACLCHECK(aclrtFreeHost(hostBuf));

    // 执行 AllGatherAdd，先将通信域内所有 rank 的 sendBuf 按照 rank_id 顺序拼接到 recvBuf，再计算输出到 computeBuf
    HCCLCHECK(AllGatherAddCustom(computeBuf, sendBuf, recvBuf, sendCount, HCCL_DATA_TYPE_FP32, hcclComm, stream));

    // 阻塞等待任务流中的集合通信任务执行完成
    ACLCHECK(aclrtSynchronizeStream(stream));

    // 将 Device 侧集合通信任务结果拷贝到 Host，并打印结果
    std::this_thread::sleep_for(std::chrono::seconds(ctx->device));
    void *resultBuff;
    ACLCHECK(aclrtMallocHost(&resultBuff, recvSize));
    ACLCHECK(aclrtMemcpy(resultBuff, recvSize, computeBuf, recvSize, ACL_MEMCPY_DEVICE_TO_HOST));
    float *tmpResBuff = static_cast<float *>(resultBuff);
    std::cout << "rankId: " << ctx->device << ", computeBuf: [";
    for (uint32_t i = 0; i < recvCount; ++i) {
        std::cout << " " << tmpResBuff[i];
    }
    std::cout << " ]" << std::endl;

    ACLCHECK(aclrtFreeHost(resultBuff));

    // 释放资源
    HCCLCHECK(HcclCommDestroy(hcclComm));  // 销毁通信域
    if (computeBuf) {
        ACLCHECK(aclrtFree(computeBuf));   // 释放 Device 侧内存
    }
    if (sendBuf) {
        ACLCHECK(aclrtFree(sendBuf));      // 释放 Device 侧内存
    }
    if (recvBuf) {
        ACLCHECK(aclrtFree(recvBuf));      // 释放 Device 侧内存
    }
    ACLCHECK(aclrtDestroyStream(stream));  // 销毁任务流
    ACLCHECK(aclrtResetDevice(device));    // 重置设备
    return 0;
}

int main()
{
    // 设备资源初始化
    ACLCHECK(aclInit(NULL));
    // 查询设备数量
    uint32_t devCount;
    ACLCHECK(aclrtGetDeviceCount(&devCount));
    std::cout << "Found " << devCount << " NPU device(s) available" << std::endl;

    int32_t rootRank = 0;
    ACLCHECK(aclrtSetDevice(rootRank));
    // 生成 Root 节点信息，各线程使用同一份 RootInfo
    void *rootInfoBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoBuf, sizeof(HcclRootInfo)));
    HcclRootInfo *rootInfo = (HcclRootInfo *)rootInfoBuf;
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    // 启动线程执行集合通信操作
    std::vector<std::thread> threads(devCount);
    std::vector<ThreadContext> args(devCount);
    for (uint32_t i = 0; i < devCount; i++) {
        args[i].rootInfo = rootInfo;
        args[i].device = i;
        args[i].devCount = devCount;
        threads[i] = std::thread(Sample, (void *)&args[i]);
    }
    for (uint32_t i = 0; i < devCount; i++) {
        threads[i].join();
    }

    // 释放资源
    ACLCHECK(aclrtFreeHost(rootInfoBuf));  // 释放 Host 内存
    ACLCHECK(aclFinalize());               // 设备去初始化
    return 0;
}
