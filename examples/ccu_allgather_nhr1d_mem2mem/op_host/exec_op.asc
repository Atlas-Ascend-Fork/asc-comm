namespace CcuAgNhr1dMem2mem {

constexpr uint32_t CHANNEL_NOTIFY_NUM = 3;
constexpr uint64_t MAX_RANKS = 16;

static bool IsAscend950()
{
    const char *soc = aclrtGetSocName();
    return soc != nullptr && std::string(soc).find("Ascend950") != std::string::npos;
}

static uint32_t GetNhrStepNum(uint32_t rankSize)
{
    uint32_t stepNum = 0;
    for (uint32_t value = rankSize - 1; value != 0; value >>= 1, stepNum++) {
    }
    return stepNum;
}

static void AddPeer(uint32_t peerRank, std::vector<uint32_t> &peerRanks,
    std::map<uint32_t, uint32_t> &rank2ChannelIdx)
{
    if (rank2ChannelIdx.count(peerRank) != 0) {
        return;
    }
    rank2ChannelIdx[peerRank] = static_cast<uint32_t>(peerRanks.size());
    peerRanks.push_back(peerRank);
}

// Virtual sub-communicator ranks are identical to HCCL ranks in this sample.
static HcclResult BuildNhrSchedule(uint32_t myRank, uint32_t rankSize,
    std::vector<NhrStepInfo> &steps, std::vector<uint32_t> &peerRanks,
    std::map<uint32_t, uint32_t> &rank2ChannelIdx)
{
    if (rankSize < 2 || myRank >= rankSize) {
        return HCCL_E_PARA;
    }

    const uint32_t stepNum = GetNhrStepNum(rankSize);
    for (uint32_t step = 0; step < stepNum; step++) {
        NhrStepInfo stepInfo;
        stepInfo.step = step;

        const uint32_t deltaRank = 1U << (stepNum - 1 - step);
        stepInfo.toRank = (myRank + deltaRank) % rankSize;
        stepInfo.fromRank = (myRank + rankSize - deltaRank) % rankSize;

        const uint32_t sliceNumerator = rankSize - 1 + deltaRank;
        const uint32_t sliceDenominator = 1U << (stepNum - step);
        const uint32_t sliceNum = sliceNumerator / sliceDenominator;
        const uint32_t deltaSliceIndex = 1U << (stepNum - step);
        uint32_t txSliceIdx = myRank;
        for (uint32_t i = 0; i < sliceNum; i++) {
            stepInfo.txSliceIdxs.push_back(txSliceIdx);
            txSliceIdx = (txSliceIdx + rankSize - deltaSliceIndex) % rankSize;
        }
        steps.push_back(stepInfo);

        AddPeer(stepInfo.fromRank, peerRanks, rank2ChannelIdx);
        AddPeer(stepInfo.toRank, peerRanks, rank2ChannelIdx);
    }

    std::ostringstream os;
    os << "rank " << myRank << " NHR schedule:";
    for (const auto &step : steps) {
        os << " step" << step.step << "(to=" << step.toRank
           << ",from=" << step.fromRank << ",tx=[";
        for (uint32_t i = 0; i < step.txSliceIdxs.size(); i++) {
            if (i != 0) {
                os << ",";
            }
            os << step.txSliceIdxs[i];
        }
        os << "])";
    }
    std::cout << os.str() << std::endl;
    return HCCL_SUCCESS;
}

static HcclResult GetChannelForCcu(HcclComm comm, uint32_t myRank,
    const std::vector<uint32_t> &peerRanks,
    std::vector<ChannelHandle> &kernelChannels)
{
    const uint32_t channelNum = static_cast<uint32_t>(peerRanks.size());
    if (channelNum == 0) {
        return HCCL_SUCCESS;
    }

    std::vector<HcclChannelDesc> channelDescs(channelNum);
    kernelChannels.resize(channelNum);

    uint32_t *netLayers = nullptr;
    uint32_t netLayerNum = 0;
    CHK_RET(HcclRankGraphGetLayers(comm, &netLayers, &netLayerNum));

    for (uint32_t channelIndex = 0; channelIndex < channelNum; channelIndex++) {
        const uint32_t remoteRank = peerRanks[channelIndex];
        HcclChannelDesc &desc = channelDescs[channelIndex];
        CHK_RET(HcclChannelDescInit(&desc, 1));
        bool found = false;
        for (uint32_t layerIdx = 0; layerIdx < netLayerNum && !found; layerIdx++) {
            uint32_t listSize = 0;
            CommLink *linkList = nullptr;
            CHK_RET(HcclRankGraphGetLinks(
                comm, netLayers[layerIdx], myRank, remoteRank, &linkList, &listSize));
            for (uint32_t idx = 0; idx < listSize; idx++) {
                const CommLink &link = linkList[idx];
                if (link.linkAttr.linkProtocol == CommProtocol::COMM_PROTOCOL_UBC_CTP) {
                    desc.remoteRank = remoteRank;
                    desc.notifyNum = CHANNEL_NOTIFY_NUM;
                    desc.channelProtocol = link.linkAttr.linkProtocol;
                    desc.localEndpoint.protocol = link.srcEndpointDesc.protocol;
                    desc.localEndpoint.commAddr = link.srcEndpointDesc.commAddr;
                    desc.localEndpoint.loc = link.srcEndpointDesc.loc;
                    desc.remoteEndpoint.protocol = link.dstEndpointDesc.protocol;
                    desc.remoteEndpoint.commAddr = link.dstEndpointDesc.commAddr;
                    desc.remoteEndpoint.loc = link.dstEndpointDesc.loc;
                    found = true;
                    break;
                }
            }
        }
        if (!found) {
            HCCL_ERROR("[GetChannelForCcu] no UBC_CTP link rank %u -> %u", myRank, remoteRank);
            return HCCL_E_NOT_FOUND;
        }
    }

    CHK_RET(HcclChannelAcquire(
        comm, CommEngine::COMM_ENGINE_CCU, channelDescs.data(), channelNum,
        kernelChannels.data()));
    return HCCL_SUCCESS;
}

static constexpr uint64_t SetBitsHost(uint16_t end)
{
    return ((uint64_t(1) << (end + 1)) - uint64_t(1));
}

static uint64_t GetMaxLoopIterNumHost()
{
    constexpr uint16_t loopNumBitNum = 12;
    return SetBitsHost(loopNumBitNum);
}

static uint64_t GetParallelParamHost(uint64_t repeatNum, uint64_t repeatLoopIndex, uint64_t totalLoopNum)
{
    constexpr uint16_t repeatBitNum = 7;
    constexpr uint16_t repeatNumShiftBit = 55;
    constexpr uint16_t repeatLoopBitNum = 7;
    constexpr uint16_t repeatLoopShiftBit = 48;
    constexpr uint16_t totalLoopBitNum = 7;
    constexpr uint16_t totalLoopShiftBit = 41;
    return ((repeatNum & SetBitsHost(repeatBitNum)) << repeatNumShiftBit)
           | ((repeatLoopIndex & SetBitsHost(repeatLoopBitNum)) << repeatLoopShiftBit)
           | ((totalLoopNum & SetBitsHost(totalLoopBitNum)) << totalLoopShiftBit);
}

// The configuration must match the kernel-side GroupCopy resources.
static std::vector<uint64_t> CalGoSize(uint64_t size, const LoopGroupConfig &config)
{
    uint64_t loopSize = config.loopCount * config.memSlice;
    uint64_t maxSize = loopSize * (GetMaxLoopIterNumHost() + 1);

    uint64_t m = size / loopSize;
    uint64_t n = (size - m * loopSize) / config.memSlice;
    uint64_t p = size - m * loopSize - n * config.memSlice;

    if (size == maxSize) {
        m = GetMaxLoopIterNumHost();
        n = config.loopCount - 1;
        p = config.memSlice;
    }

    uint64_t offset = config.memSlice * config.loopCount * m;
    uint64_t loopIterNum = m;
    uint64_t loopExtendNum = 0;
    uint64_t tailSize = 0;
    constexpr uint64_t loopNumTwo = 2;

    if (n == 0 && p == 0) {
        loopExtendNum = 0;
        tailSize = 0;
    } else if (n != 0 && p == 0) {
        loopExtendNum = GetParallelParamHost(n - 1, 0, 1);
        tailSize = config.memSlice;
    } else if (n == 0 && p != 0) {
        loopExtendNum = GetParallelParamHost(0, 0, 1);
        tailSize = p;
    } else {
        loopExtendNum = GetParallelParamHost(n - 1, 1, loopNumTwo);
        tailSize = p;
    }
    return {offset, loopIterNum, loopExtendNum, tailSize};
}
// Register the CCU kernel into the instance; store the handle in resCtx.
// Mirrors custom_ccu_allgather GetCcuKernel.
static HcclResult GetCcuKernel(HcclComm comm, uint32_t myRank, uint32_t rankSize,
    const std::vector<ChannelHandle> &channels, const std::vector<NhrStepInfo> &steps,
    const std::map<uint32_t, uint32_t> &rank2ChannelIdx,
    AlgResourceCtxSerializable &resCtx)
{
    auto kernelArg = std::make_shared<CcuKernelArgAllGatherNhr1DMem2Mem>();
    kernelArg->rankSize = rankSize;
    kernelArg->rankId = myRank;
    kernelArg->stepInfoVector = steps;
    kernelArg->rank2ChannelIdx = rank2ChannelIdx;
    for (uint32_t i = 0; i < channels.size(); ++i) {
        kernelArg->channels[i] = channels[i];
    }
    kernelArg->channelCount = static_cast<uint32_t>(channels.size());

    CcuInsHandle insHandle = 0;
    uint32_t insNum = 0;
    CHK_RET(HcclCommQueryCcuIns(comm, &insHandle, &insNum));
    CHK_PRT_RET(insNum != 1,
        HCCL_ERROR("[GetCcuKernel] HcclCommQueryCcuIns fail! insNum is [%u]", insNum),
        HCCL_E_INTERNAL);

    resCtx.ccuKernels.resize(1);
    CHK_RET(ConvertCcuToHccl(HcommCcuKernelRegisterStart(insHandle)));

    CcuKernelHandle kernelHandle = 0;
    const void *regArgs[] = {kernelArg.get()};
    constexpr uint32_t dieId = 0;
    constexpr uint32_t kernelArgNum = 1;
    CHK_RET(ConvertCcuToHccl(HcommCcuKernelRegister(
        insHandle, dieId, "CcuAllGatherNhr1DMem2MemKernel",
        reinterpret_cast<void *>(CcuAllGatherNhr1DMem2MemKernel),
        regArgs, kernelArgNum, &kernelHandle)));
    resCtx.ccuKernels[0] = kernelHandle;

    CHK_RET(ConvertCcuToHccl(HcommCcuKernelRegisterEnd(insHandle)));
    resCtx.ccuKernelNum = {1};
    return HCCL_SUCCESS;
}

// Buffer + thread + channels + kernel registration. Mirrors custom AllocAlgResource.
static HcclResult AllocAlgResource(HcclComm comm, uint32_t myRank, uint32_t rankSize,
    aclrtStream stream, AlgResourceCtxSerializable &resCtx)
{
    void *cclBufferAddr = nullptr;
    uint64_t cclBufferSize = 0;
    CHK_RET(HcclGetHcclBuffer(comm, &cclBufferAddr, &cclBufferSize));
    resCtx.cclMem = CommBuffer{cclBufferAddr, cclBufferSize};
    resCtx.notifyNumOnMainThread = 0;

    ThreadHandle thread = 0;
    CHK_RET(HcclThreadAcquireWithStream(comm, CommEngine::COMM_ENGINE_CCU, stream,
        resCtx.notifyNumOnMainThread, &thread));
    resCtx.threads.push_back(thread);

    if (rankSize == 1) {
        resCtx.ccuKernelNum = {0};
        return HCCL_SUCCESS;
    }

    std::vector<NhrStepInfo> steps;
    std::vector<uint32_t> peerRanks;
    std::map<uint32_t, uint32_t> rank2ChannelIdx;
    CHK_RET(BuildNhrSchedule(myRank, rankSize, steps, peerRanks, rank2ChannelIdx));

    std::vector<ChannelHandle> channels;
    CHK_RET(GetChannelForCcu(comm, myRank, peerRanks, channels));
    resCtx.kernelChannels = channels;
    CHK_RET(GetCcuKernel(
        comm, myRank, rankSize, channels, steps, rank2ChannelIdx, resCtx));
    return HCCL_SUCCESS;
}

// Engine-context get-or-create (+ serialize). Mirrors custom InitAlgResourceCtx.
// This registers the resource context into the comm engine; omitting it left
// one write direction non-functional.
static HcclResult InitAlgResourceCtx(HcclComm comm, const char *tag, uint32_t myRank,
    uint32_t rankSize, aclrtStream stream, AlgResourceCtxSerializable &resCtx)
{
    void *ctx = nullptr;
    uint64_t size = 0;
    if (HcclEngineCtxGet(comm, tag, CommEngine::COMM_ENGINE_CCU, &ctx, &size) == HCCL_SUCCESS) {
        std::vector<char> ctxData(static_cast<char *>(ctx), static_cast<char *>(ctx) + size);
        resCtx.DeSerialize(ctxData);
        return HCCL_SUCCESS;
    }
    CHK_RET(AllocAlgResource(comm, myRank, rankSize, stream, resCtx));
    std::vector<char> seq = resCtx.Serialize();
    uint64_t ctxSize = seq.size();
    void *newCtx = nullptr;
    CHK_RET(HcclEngineCtxCreate(comm, tag, CommEngine::COMM_ENGINE_CCU, ctxSize, &newCtx));
    memcpy(newCtx, seq.data(), ctxSize);
    return HCCL_SUCCESS;
}

HcclResult AllGatherNhr1D(void *sendBuf, void *recvBuf, uint64_t count,
    HcclComm comm, aclrtStream stream)
{
    CHK_PTR_NULL(comm);
    CHK_PTR_NULL(sendBuf);
    CHK_PTR_NULL(recvBuf);

    uint32_t myRank = 0;
    uint32_t rankSize = 0;
    CHK_RET(HcclGetRankId(comm, &myRank));
    CHK_RET(HcclGetRankSize(comm, &rankSize));

    if (!IsAscend950()) {
        HCCL_ERROR("[AllGatherNhr1D] only Ascend950 (dav-3510) is supported");
        return HCCL_E_NOT_SUPPORT;
    }

    const uint64_t dataTypeSize = sizeof(float);
    const uint64_t dataSize = count * dataTypeSize;
    if (count == 0) {
        HCCL_INFO("[AllGatherNhr1D] count == 0, nothing to do");
        return HCCL_SUCCESS;
    }

    char tag[64] = "CcuAgNhr1dMem2mem";
    AlgResourceCtxSerializable resCtx;
    CHK_RET(InitAlgResourceCtx(comm, tag, myRank, rankSize, stream, resCtx));

    if (rankSize == 1) {
        CHK_RET(static_cast<HcclResult>(
            HcommLocalCopyOnThread(resCtx.threads[0], recvBuf, sendBuf, dataSize)));
        return HCCL_SUCCESS;
    }

    // Memory token over the CCL buffer window.
    uint64_t token = 0;
    CHK_RET(ConvertCcuToHccl(HcommCcuGetMemToken(
        reinterpret_cast<uint64_t>(sendBuf), dataSize, &token)));

    // The NHR topology is stored in the registration-time arguments.
    const uint64_t baseInputAddr = reinterpret_cast<uint64_t>(sendBuf);
    const uint64_t baseOutputAddr = reinterpret_cast<uint64_t>(recvBuf);

    LoopGroupConfig config{};
    config.msInterleave = CCU_MS_INTERLEAVE;
    config.loopCount = CCU_MS_LOCAL_COPY_LOOP_COUNT;
    config.memSlice = CCU_MS_SIZE * CCU_LOCAL_COPY_MS_PER_LOOP;
    const auto goSize = CalGoSize(dataSize, config);

    uint64_t taskArgs[TASK_ARG_NUM]{};
    taskArgs[TASK_INPUT_ADDR] = baseInputAddr;
    taskArgs[TASK_OUTPUT_ADDR] = baseOutputAddr;
    taskArgs[TASK_TOKEN] = token;
    taskArgs[TASK_INPUT_SLICE_STRIDE] = 0;  // Each rank owns a separate input buffer.
    taskArgs[TASK_OUTPUT_SLICE_STRIDE] = dataSize;
    taskArgs[TASK_CHUNK_SIZE] = dataSize;
    taskArgs[TASK_GO_ADDR_OFFSET] = goSize[0];
    taskArgs[TASK_GO_LOOP_PARAM] = goSize[1];
    taskArgs[TASK_GO_PARALLEL_PARAM] = goSize[2];
    taskArgs[TASK_GO_RESIDUAL] = goSize[3];

    CHK_RET(ConvertCcuToHccl(HcommCcuKernelLaunch(
        resCtx.threads[0], resCtx.ccuKernels[0], taskArgs, TASK_ARG_NUM)));
    return HCCL_SUCCESS;
}

}  // namespace CcuAgNhr1dMem2mem
