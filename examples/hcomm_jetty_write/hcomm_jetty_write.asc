#include <chrono>
#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <fstream>
#include <iostream>
#include <string>
#include <thread>
#include <vector>

#include <sys/stat.h>

#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "hccl/hccl.h"
#include "hccl/hccl_rank_graph.h"
#include "kernel_operator.h"
#include "jetty/hcomm_jetty.h"

constexpr uint32_t DATA_SIZE = 256U;
constexpr uint64_t COMM_BUF_SIZE = 64U * 1024U;
constexpr uint64_t WRITE_RESULT_OFFSET = DATA_SIZE;
constexpr uint64_t WRITE_VALUE_SIZE = sizeof(uint64_t);
constexpr uint64_t WRITE_VALUE_MAGIC = 0xA5A5000000000000ULL;
constexpr CommProtocol HOST_COMM_PROTOCOL = COMM_PROTOCOL_UBC_CTP;

enum TestResult : uint32_t {
    TEST_SUCCESS = 0U,
    TEST_WRITE_FAILED = 1U,
    TEST_DRAIN_FAILED = 2U,
};
static_assert(sizeof(TestResult) == sizeof(uint32_t), "TestResult must remain uint32_t-sized");

namespace HcommExample {

struct CommContext {
    uint64_t localBufferAddr;
    uint64_t jettyTable;
    uint64_t dstPtr;
    uint64_t valueDstPtr;
    uint64_t value;
    uint32_t writeOffset;
    uint32_t jettyIdx;
    TestResult testResult;
};

} // namespace HcommExample

extern "C" aclError LaunchHcommJettyWrite(void* contexts, uint32_t peerCount, aclrtStream stream);

namespace {

constexpr const char* MEMORY_TAG = "shareBuf";
constexpr uint32_t ROOT_INFO_WAIT_SECONDS = 60U;
constexpr uint32_t ROOT_INFO_POLL_MS = 100U;

struct Options {
    uint32_t rankSize = 0U;
    uint32_t rank = 0U;
    std::string rootInfoFile;
};

struct PeerRankCtx {
    uint32_t rankId = 0U;
    ChannelHandle channel = 0U;
    void* remoteBufferAddr = nullptr;
};

struct CommResources {
    HcclComm comm = nullptr;
    HcclMemHandle memHandle = nullptr;
    void* devBuf = nullptr;
    void* devContexts = nullptr;
    void* devJettyTable = nullptr;
    aclrtStream stream = nullptr;
    std::vector<PeerRankCtx> peers;
};

bool IsRootInfoFileReady(const std::string& path)
{
    struct stat st {};
    return stat(path.c_str(), &st) == 0 && st.st_size >= static_cast<off_t>(sizeof(HcclRootInfo));
}

HcclResult WriteRootInfoFile(const std::string& path, const HcclRootInfo& rootInfo)
{
    const std::string tmpPath = path + ".tmp";
    std::ofstream ofs(tmpPath, std::ios::binary | std::ios::trunc);
    if (!ofs.is_open()) {
        std::cout << "open root info tmp file failed: " << tmpPath << std::endl;
        return HCCL_E_OPEN_FILE_FAILURE;
    }
    ofs.write(reinterpret_cast<const char*>(&rootInfo), sizeof(rootInfo));
    ofs.close();
    if (!ofs) {
        return HCCL_E_SYSCALL;
    }
    if (std::rename(tmpPath.c_str(), path.c_str()) != 0) {
        return HCCL_E_SYSCALL;
    }
    return HCCL_SUCCESS;
}

HcclResult ReadRootInfoFile(const std::string& path, HcclRootInfo* rootInfo)
{
    const uint32_t maxPollTimes = ROOT_INFO_WAIT_SECONDS * 1000U / ROOT_INFO_POLL_MS;
    for (uint32_t i = 0U; i < maxPollTimes; ++i) {
        if (!IsRootInfoFileReady(path)) {
            std::this_thread::sleep_for(std::chrono::milliseconds(ROOT_INFO_POLL_MS));
            continue;
        }
        std::ifstream ifs(path, std::ios::binary);
        if (!ifs.is_open()) {
            return HCCL_E_OPEN_FILE_FAILURE;
        }
        ifs.read(reinterpret_cast<char*>(rootInfo), sizeof(*rootInfo));
        if (ifs.gcount() == static_cast<std::streamsize>(sizeof(*rootInfo))) {
            return HCCL_SUCCESS;
        }
        std::this_thread::sleep_for(std::chrono::milliseconds(ROOT_INFO_POLL_MS));
    }
    return HCCL_E_TIMEOUT;
}

HcclResult LoadRootInfo(uint32_t rank, const std::string& rootInfoFile, HcclRootInfo* rootInfo)
{
    HcclResult ret = HCCL_SUCCESS;
    if (rank == 0U) {
        ret = HcclGetRootInfo(rootInfo);
        if (ret == HCCL_SUCCESS) {
            ret = WriteRootInfoFile(rootInfoFile, *rootInfo);
        }
    } else {
        ret = ReadRootInfoFile(rootInfoFile, rootInfo);
    }
    return ret;
}

int32_t ParseInt32(const char* arg)
{
    if (arg == nullptr) {
        return -1;
    }
    char* end = nullptr;
    const long value = std::strtol(arg, &end, 10);
    if (end == arg || *end != '\0') {
        return -1;
    }
    return static_cast<int32_t>(value);
}

int BuildChannelDesc(HcclComm comm, uint32_t rank, uint32_t peerRank, HcclMemHandle* memHandle, HcclChannelDesc& desc)
{
    uint32_t* layers = nullptr;
    uint32_t layerCount = 0U;
    if (HcclRankGraphGetLayers(comm, &layers, &layerCount) != HCCL_SUCCESS) {
        return -1;
    }
    for (uint32_t layer = 0U; layer < layerCount; ++layer) {
        CommLink* links = nullptr;
        uint32_t linkCount = 0U;
        if (HcclRankGraphGetLinks(comm, layers[layer], rank, peerRank, &links, &linkCount) != HCCL_SUCCESS) {
            return -1;
        }
        for (uint32_t link = 0U; link < linkCount; ++link) {
            if (links[link].linkAttr.linkProtocol != HOST_COMM_PROTOCOL) {
                continue;
            }
            if (HcclChannelDescInit(&desc, 1U) != HCCL_SUCCESS) {
                return -1;
            }
            desc.remoteRank = peerRank;
            desc.localEndpoint = links[link].srcEndpointDesc;
            desc.remoteEndpoint = links[link].dstEndpointDesc;
            desc.channelProtocol = HOST_COMM_PROTOCOL;
            desc.notifyNum = 3U;
            desc.memHandles = memHandle;
            desc.memHandleNum = 1U;
            return 0;
        }
    }
    std::fprintf(stderr, "rank %u: no UBC_CTP link found to peer %u\n", rank, peerRank);
    return -1;
}

int GetRemoteMemory(HcclComm comm, uint32_t rank, PeerRankCtx& peer)
{
    uint32_t count = 0U;
    CommMem* memories = nullptr;
    char** tags = nullptr;
    if (HcclChannelGetRemoteMems(comm, peer.channel, &count, &memories, &tags) != HCCL_SUCCESS || memories == nullptr ||
        count == 0U) {
        return -1;
    }
    for (uint32_t index = 0U; index < count; ++index) {
        if (tags != nullptr && tags[index] != nullptr && std::strcmp(tags[index], MEMORY_TAG) == 0) {
            if (memories[index].type != COMM_MEM_TYPE_DEVICE || memories[index].addr == nullptr ||
                memories[index].size < COMM_BUF_SIZE) {
                return -1;
            }
            if (index + 1U != count) {
                std::fprintf(stderr, "rank %u: user buffer must be the last remote buffer\n", rank);
                return -1;
            }
            peer.remoteBufferAddr = memories[index].addr;
            return 0;
        }
    }
    if (count == 1U && memories[0].type == COMM_MEM_TYPE_DEVICE && memories[0].addr != nullptr &&
        memories[0].size >= COMM_BUF_SIZE) {
        peer.remoteBufferAddr = memories[0].addr;
        return 0;
    }
    std::fprintf(stderr, "rank %u: remote buffer for peer %u not found\n", rank, peer.rankId);
    return -1;
}

void FillSendData(std::vector<uint8_t>& buffer, uint32_t rank)
{
    for (uint32_t index = 0U; index < DATA_SIZE; ++index) {
        buffer[index] = index == 0U ? static_cast<uint8_t>(rank) : static_cast<uint8_t>(rank + index);
    }
}

int ValidateSlot(const std::vector<uint8_t>& buffer, uint64_t offset, uint32_t sourceRank, uint32_t rank)
{
    for (uint32_t index = 0U; index < DATA_SIZE; ++index) {
        const uint8_t expected =
            index == 0U ? static_cast<uint8_t>(sourceRank) : static_cast<uint8_t>(sourceRank + index);
        if (buffer[offset + index] != expected) {
            std::fprintf(stderr, "rank %u: peer %u data mismatch at byte %u\n", rank, sourceRank, index);
            return -1;
        }
    }
    return 0;
}

int ValidateWriteValue(const std::vector<uint8_t>& buffer, uint64_t offset, uint32_t sourceRank, uint32_t rank)
{
    uint64_t actual = 0U;
    std::memcpy(&actual, buffer.data() + offset, sizeof(actual));
    const uint64_t expected = WRITE_VALUE_MAGIC | static_cast<uint64_t>(sourceRank);
    if (actual != expected) {
        std::fprintf(stderr, "rank %u: peer %u WriteValue marker mismatch\n", rank, sourceRank);
        return -1;
    }
    return 0;
}

int CheckKernelResults(const CommResources& resources, uint32_t rank)
{
    for (size_t index = 0U; index < resources.peers.size(); ++index) {
        const PeerRankCtx& peer = resources.peers[index];
        HcommExample::CommContext context{};
        auto* deviceContext = static_cast<uint8_t*>(resources.devContexts) + index * sizeof(context);
        if (aclrtMemcpy(&context, sizeof(context), deviceContext, sizeof(context), ACL_MEMCPY_DEVICE_TO_HOST) !=
            ACL_SUCCESS) {
            return -1;
        }
        if (context.testResult != TEST_SUCCESS) {
            std::fprintf(
                stderr, "rank %u: peer %u kernel failed, result=%u\n", rank, peer.rankId,
                static_cast<unsigned>(context.testResult));
            return -1;
        }
    }
    return 0;
}

void Cleanup(CommResources& resources)
{
    resources.peers.clear();
    if (resources.comm != nullptr) {
        HcclCommDestroy(resources.comm);
        resources.comm = nullptr;
    }
    if (resources.devBuf != nullptr) {
        aclrtFree(resources.devBuf);
        resources.devBuf = nullptr;
    }
    if (resources.devContexts != nullptr) {
        aclrtFree(resources.devContexts);
        resources.devContexts = nullptr;
    }
    if (resources.devJettyTable != nullptr) {
        aclrtFree(resources.devJettyTable);
        resources.devJettyTable = nullptr;
    }
    if (resources.stream != nullptr) {
        aclrtDestroyStream(resources.stream);
        resources.stream = nullptr;
    }
}

int RunRank(const Options& options, const HcclRootInfo& rootInfo)
{
    CommResources resources;
    int result = HcclCommInitRootInfo(options.rankSize, &rootInfo, options.rank, &resources.comm);
    if (result != HCCL_SUCCESS) {
        return result;
    }
    const uint64_t valueResultOffset = WRITE_RESULT_OFFSET + static_cast<uint64_t>(options.rankSize) * DATA_SIZE;
    if (valueResultOffset + static_cast<uint64_t>(options.rankSize) * WRITE_VALUE_SIZE > COMM_BUF_SIZE) {
        std::fprintf(stderr, "rank %u: rank size is too large for communication buffer\n", options.rank);
        Cleanup(resources);
        return -1;
    }
    if (aclrtMalloc(&resources.devBuf, COMM_BUF_SIZE, ACL_MEM_MALLOC_HUGE_ONLY) != ACL_SUCCESS) {
        Cleanup(resources);
        return -1;
    }
    std::vector<uint8_t> hostBuffer(static_cast<size_t>(COMM_BUF_SIZE), 0U);
    FillSendData(hostBuffer, options.rank);
    if (aclrtMemcpy(resources.devBuf, COMM_BUF_SIZE, hostBuffer.data(), COMM_BUF_SIZE, ACL_MEMCPY_HOST_TO_DEVICE) !=
        ACL_SUCCESS) {
        Cleanup(resources);
        return -1;
    }
    CommMem memory{COMM_MEM_TYPE_DEVICE, resources.devBuf, COMM_BUF_SIZE};
    if (HcclCommMemReg(resources.comm, MEMORY_TAG, &memory, &resources.memHandle) != HCCL_SUCCESS) {
        Cleanup(resources);
        return -1;
    }

    resources.peers.reserve(options.rankSize - 1U);
    std::vector<HcclChannelDesc> descs;
    descs.reserve(options.rankSize - 1U);
    for (uint32_t peerRank = 0U; peerRank < options.rankSize; ++peerRank) {
        if (peerRank == options.rank) {
            continue;
        }
        PeerRankCtx peer;
        peer.rankId = peerRank;
        HcclChannelDesc desc{};
        if (BuildChannelDesc(resources.comm, options.rank, peerRank, &resources.memHandle, desc) != 0) {
            Cleanup(resources);
            return -1;
        }
        resources.peers.push_back(peer);
        descs.push_back(desc);
    }
    std::vector<ChannelHandle> channels(descs.size(), 0U);
    result = HcclChannelAcquire(
        resources.comm, COMM_ENGINE_AIV, descs.data(), static_cast<uint32_t>(descs.size()), channels.data());
    if (result != HCCL_SUCCESS) {
        Cleanup(resources);
        return result;
    }
    // Park all Jetty handles in a single device table (one Jetty per peer, nranks - 1 entries).
    const size_t numJetties = channels.size();
    std::vector<uint64_t> jettyTableHost(numJetties, 0U);
    for (size_t index = 0U; index < numJetties; ++index) {
        jettyTableHost[index] = static_cast<uint64_t>(channels[index]);
    }
    const size_t jettyTableBytes = numJetties * sizeof(uint64_t);
    if (aclrtMalloc(&resources.devJettyTable, jettyTableBytes, ACL_MEM_MALLOC_HUGE_ONLY) != ACL_SUCCESS ||
        aclrtMemcpy(
            resources.devJettyTable, jettyTableBytes, jettyTableHost.data(), jettyTableBytes,
            ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        Cleanup(resources);
        return -1;
    }
    std::vector<HcommExample::CommContext> contexts(resources.peers.size());
    for (size_t index = 0U; index < resources.peers.size(); ++index) {
        resources.peers[index].channel = channels[index];
        if (GetRemoteMemory(resources.comm, options.rank, resources.peers[index]) != 0) {
            Cleanup(resources);
            return -1;
        }
        HcommExample::CommContext context{};
        context.localBufferAddr = reinterpret_cast<uint64_t>(resources.devBuf);
        context.jettyTable = reinterpret_cast<uint64_t>(resources.devJettyTable);
        context.dstPtr = reinterpret_cast<uint64_t>(resources.peers[index].remoteBufferAddr) + WRITE_RESULT_OFFSET +
                         options.rank * DATA_SIZE;
        context.valueDstPtr = reinterpret_cast<uint64_t>(resources.peers[index].remoteBufferAddr) + valueResultOffset +
                              options.rank * WRITE_VALUE_SIZE;
        context.value = WRITE_VALUE_MAGIC | static_cast<uint64_t>(options.rank);
        context.writeOffset = static_cast<uint32_t>(WRITE_RESULT_OFFSET + options.rank * DATA_SIZE);
        context.jettyIdx = static_cast<uint32_t>(index);
        context.testResult = TEST_SUCCESS;
        contexts[index] = context;
    }
    const size_t contextsBytes = contexts.size() * sizeof(HcommExample::CommContext);
    if (aclrtMalloc(&resources.devContexts, contextsBytes, ACL_MEM_MALLOC_HUGE_ONLY) != ACL_SUCCESS ||
        aclrtMemcpy(resources.devContexts, contextsBytes, contexts.data(), contextsBytes, ACL_MEMCPY_HOST_TO_DEVICE) !=
            ACL_SUCCESS) {
        Cleanup(resources);
        return -1;
    }
    if (aclrtCreateStream(&resources.stream) != ACL_SUCCESS) {
        Cleanup(resources);
        return -1;
    }
    if (LaunchHcommJettyWrite(resources.devContexts, static_cast<uint32_t>(resources.peers.size()), resources.stream) !=
        ACL_SUCCESS) {
        Cleanup(resources);
        return -1;
    }
    if (aclrtSynchronizeStream(resources.stream) != ACL_SUCCESS || CheckKernelResults(resources, options.rank) != 0) {
        Cleanup(resources);
        return -1;
    }
    if (HcclBarrier(resources.comm, resources.stream) != HCCL_SUCCESS) {
        Cleanup(resources);
        return -1;
    }
    if (aclrtSynchronizeStream(resources.stream) != ACL_SUCCESS) {
        Cleanup(resources);
        return -1;
    }
    if (aclrtMemcpy(hostBuffer.data(), COMM_BUF_SIZE, resources.devBuf, COMM_BUF_SIZE, ACL_MEMCPY_DEVICE_TO_HOST) !=
        ACL_SUCCESS) {
        Cleanup(resources);
        return -1;
    }
    for (const PeerRankCtx& peer : resources.peers) {
        const uint64_t offset = WRITE_RESULT_OFFSET + static_cast<uint64_t>(peer.rankId) * DATA_SIZE;
        if (ValidateSlot(hostBuffer, offset, peer.rankId, options.rank) != 0) {
            Cleanup(resources);
            return -1;
        }
        const uint64_t valueOffset = valueResultOffset + static_cast<uint64_t>(peer.rankId) * WRITE_VALUE_SIZE;
        if (ValidateWriteValue(hostBuffer, valueOffset, peer.rankId, options.rank) != 0) {
            Cleanup(resources);
            return -1;
        }
    }
    std::printf(
        "rank %u/%u: Jetty WRITE and WriteValue validation passed for %zu peers\n", options.rank, options.rankSize,
        resources.peers.size());
    Cleanup(resources);
    return HCCL_SUCCESS;
}

} // namespace

int main(int argc, char* argv[])
{
    if (argc < 4) {
        std::fprintf(stderr, "Usage: %s <rank> <nranks> <root_info_file>\n", argv[0]);
        return 1;
    }
    const int32_t rank = ParseInt32(argv[1]);
    const int32_t rankSize = ParseInt32(argv[2]);
    const std::string rootInfoFile = argv[3];
    if (rank < 0 || rankSize < 2 || rank >= rankSize ||
        WRITE_RESULT_OFFSET + static_cast<uint64_t>(rankSize) * DATA_SIZE +
                static_cast<uint64_t>(rankSize) * WRITE_VALUE_SIZE >
            COMM_BUF_SIZE) {
        return 1;
    }
    Options options{static_cast<uint32_t>(rankSize), static_cast<uint32_t>(rank), rootInfoFile};
    if (aclInit(nullptr) != ACL_SUCCESS) {
        return 1;
    }
    uint32_t deviceCount = 0U;
    if (aclrtGetDeviceCount(&deviceCount) != ACL_SUCCESS || options.rank >= deviceCount ||
        aclrtSetDevice(static_cast<int32_t>(options.rank)) != ACL_SUCCESS) {
        aclFinalize();
        return 1;
    }
    HcclRootInfo rootInfo{};
    HcclResult status = LoadRootInfo(options.rank, options.rootInfoFile, &rootInfo);
    if (status == HCCL_SUCCESS) {
        status = static_cast<HcclResult>(RunRank(options, rootInfo));
    }
    aclrtResetDevice(static_cast<int32_t>(options.rank));
    aclFinalize();
    return status == HCCL_SUCCESS ? 0 : 1;
}

namespace HcommExample {

class KernelHcommJettyWrite {
public:
    __aicore__ inline void Init(GM_ADDR contexts, uint32_t peerCount, AscendC::TPipe* pipe)
    {
        contexts_ = reinterpret_cast<__gm__ CommContext*>(contexts);
        peerCount_ = peerCount;
        pipe->InitBuffer(peerBuffer_, sizeof(AscendC::HcommJettyPeerInfo));
        pipe->InitBuffer(jettyInfoBuffer_, sizeof(AscendC::HcommJettyInfo));
        pipe->InitBuffer(sqeBuffer_, AscendC::HcommJetty::kNumMaxSqeBytes);
        peerTensor_ = peerBuffer_.Get<uint8_t>();
        jettyInfoTensor_ = jettyInfoBuffer_.Get<uint8_t>();
        sqeTensor_ = sqeBuffer_.Get<uint8_t>();
    }

    __aicore__ inline void Process()
    {
        for (uint32_t index = 0U; index < peerCount_; ++index) {
            __gm__ CommContext* context = contexts_ + index;
            context->testResult = TEST_SUCCESS;
            GM_ADDR localBuffer = reinterpret_cast<GM_ADDR>(context->localBufferAddr);
            GM_ADDR jettyTable = reinterpret_cast<GM_ADDR>(context->jettyTable);
            auto peerInfo = reinterpret_cast<__ubuf__ AscendC::HcommJettyPeerInfo*>(peerTensor_.GetPhyAddr());
            auto jettyInfo = reinterpret_cast<__ubuf__ AscendC::HcommJettyInfo*>(jettyInfoTensor_.GetPhyAddr());
            auto sqe = reinterpret_cast<__ubuf__ uint8_t*>(sqeTensor_.GetPhyAddr());
            const AscendC::HcommPeer peer(peerInfo, jettyTable, context->jettyIdx);
            AscendC::HcommJetty jetty(jettyInfo, sqe, jettyTable, context->jettyIdx);
            if (jetty.template Write<1000000>(
                    peer, reinterpret_cast<GM_ADDR>(context->dstPtr), localBuffer, DATA_SIZE) !=
                AscendC::HCOMM_SUCCESS) {
                context->testResult = TEST_WRITE_FAILED;
                continue;
            }
            if (jetty.template WriteValue<1000000>(
                    peer, reinterpret_cast<GM_ADDR>(context->valueDstPtr), context->value) != AscendC::HCOMM_SUCCESS) {
                context->testResult = TEST_WRITE_FAILED;
                continue;
            }
            if (jetty.template Drain<1000000>() != AscendC::HCOMM_SUCCESS) {
                context->testResult = TEST_DRAIN_FAILED;
            }
        }
    }

private:
    AscendC::TBuf<AscendC::TPosition::VECOUT> peerBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> jettyInfoBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECOUT> sqeBuffer_;
    AscendC::LocalTensor<uint8_t> peerTensor_;
    AscendC::LocalTensor<uint8_t> jettyInfoTensor_;
    AscendC::LocalTensor<uint8_t> sqeTensor_;
    __gm__ CommContext* contexts_{nullptr};
    uint32_t peerCount_{0U};
};

__aicore__ inline void RunHcommKernel(GM_ADDR contexts, uint32_t peerCount)
{
    AscendC::TPipe pipe;
    KernelHcommJettyWrite op;
    op.Init(contexts, peerCount, &pipe);
    op.Process();
}

} // namespace HcommExample

extern "C" __vector__ __global__ __aicore__ void kernel_hcomm_jetty_write(GM_ADDR contexts, uint32_t peerCount)
{
    HcommExample::RunHcommKernel(contexts, peerCount);
}

extern "C" aclError LaunchHcommJettyWrite(void* contexts, uint32_t peerCount, aclrtStream stream)
{
    if (contexts == nullptr || peerCount == 0U || stream == nullptr) {
        return ACL_ERROR_INVALID_PARAM;
    }
    kernel_hcomm_jetty_write<<<1, 0, stream>>>(static_cast<uint8_t*>(contexts), peerCount);
    return ACL_SUCCESS;
}
