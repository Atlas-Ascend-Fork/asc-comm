/*
 * CheckOpResSufficient(comm, ccType, ccArgs) 错误码验证样例。
 * 用例按 ccArgs 版调用链的触发条件设计（见 hccl_mc2.cc 的 HcclAllocCcResByArgsImpl）：
 * 入口空指针 -> HCCL_E_PTR(2)；
 * 单 rank / 非 CCU_SCHED 引擎 -> HCCL_SUCCESS(0) 提前返回；
 * opType 不在支持集 -> HCCL_E_NOT_SUPPORT(5)；
 * algConfig 未注册或非纯算法名 -> HCCL_E_ALG_NOT_SUPPORTED(1042)；
 * 资源链探测不足 -> HCCL_E_RES_NOT_SUFFICIENT(1043)。
 * 1043 需要 950 真机上的真实资源竞争环境（channel/CcuIns 容量不足），本样例提供
 * 该用例的观察入口（--stress-reuse），默认不启用。
 */

#include <cstdio>
#include <cstring>
#include <iostream>
#include <vector>
#include <thread>

#include <acl/acl_rt.h>
#include <hccl/hccl_comm.h>
#include <hccl/hccl_types.h>

#include "adv_api/hccl/hccl.h"
#include "adv_api/hccl/hccl_mc2.h"
#include "kernel_operator.h"

#ifdef ACLCHECK
#undef ACLCHECK
#endif

#define ACLCHECK(ret)                                                                          \
    do {                                                                                       \
        if (ret != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                        \
        }                                                                                      \
    } while (0)

#define HCCLCHECK(call)                                                                                    \
    do {                                                                                                   \
        auto ret = (call);                                                                                 \
        int retCode = static_cast<int>(ret);                                                               \
        HcclResult hcclRet = static_cast<HcclResult>(ret);                                                 \
        if (retCode >= static_cast<int>(CCU_E_DRV_START) && retCode <= static_cast<int>(CCU_E_RESERVED)) { \
            hcclRet = HCCL_E_INTERNAL;                                                                     \
        }                                                                                                  \
        if (hcclRet != HCCL_SUCCESS) {                                                                     \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, retCode);        \
            return hcclRet;                                                                                \
        }                                                                                                  \
    } while (0)

// 非致命版：错误只打印，不中断流程（用例驱动主循环自行判定期望值）
#define ACLCHECK_NRT(ret)                                                                  \
    do {                                                                                   \
        if (ret != ACL_SUCCESS) {                                                          \
            printf("[ACL][non-fatal] err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
        }                                                                                  \
    } while (0)

constexpr uint64_t CCU_MAX_RANK_SIZE = 16;
// 与 asc-devkit impl 侧 OpExecuteConfig 对齐（alg_param.h）
constexpr uint8_t kOpExecCcuSched = 6U; // CCU_SCHED
constexpr uint8_t kOpExecAicpuTs = 2U;  // AICPU_TS
constexpr uint8_t kOpExecAiv = 3U;      // AIV
// 部分新增错误码（1042/1043）在旧安装包的 hccl_types.h 中不存在，
// 样例直接用数值比较，不引用枚举名，避免编译报错。
constexpr int kErrAlgNotSupported = 1042; // HCCL_E_ALG_NOT_SUPPORTED
constexpr int kErrResNotSufficient = 1043; // HCCL_E_RES_NOT_SUFFICIENT

struct CaseResult {
    const char* name;
    int expect; // 期望的HcclResult
    int actual; // 实际的HcclResult
};

// ---------------------------------------------------------------------------
// 辅助：构造一份合法的ccArgs（CCU_SCHED + FP32 + 注册算法），供用例做局部篡改
// ---------------------------------------------------------------------------
static int BuildValidCcArgs(void** ccArgs, uint8_t commEngine = kOpExecCcuSched)
{
    char validAlg[] = "CcuSchedAllGatherSoleMesh";
    Mc2Result ret = Mc2GetCcArgs(ccArgs);
    if (ret != HCCL_SUCCESS) {
        return static_cast<int>(ret);
    }
    ret = Mc2SetCcCommEngine(*ccArgs, commEngine);
    if (ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(*ccArgs);
        return static_cast<int>(ret);
    }
    ret = Mc2SetCcSrcDataType(*ccArgs, HCCL_DATA_TYPE_FP32);
    if (ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(*ccArgs);
        return static_cast<int>(ret);
    }
    ret = Mc2SetCcDstDataType(*ccArgs, HCCL_DATA_TYPE_FP32);
    if (ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(*ccArgs);
        return static_cast<int>(ret);
    }
    ret = Mc2SetCcAlgConfig(*ccArgs, validAlg);
    if (ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(*ccArgs);
        return static_cast<int>(ret);
    }
    return HCCL_SUCCESS;
}

// ---------------------------------------------------------------------------
// 用例1：空指针校验 -> HCCL_E_PTR(2)
// 触发点：hccl_mc2.cc CheckOpResSufficient 入口 CHK_PTR_NULL
// ---------------------------------------------------------------------------
static int CaseNullComm(HcclComm validComm, void* validArgs)
{
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLGATHER);
    return static_cast<int>(CheckOpResSufficient(nullptr, ccType, validArgs));
}

static int CaseNullCcArgs(HcclComm validComm, void* validArgs)
{
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLGATHER);
    return static_cast<int>(CheckOpResSufficient(validComm, ccType, nullptr));
}

// ---------------------------------------------------------------------------
// 用例2：非 CCU_SCHED 引擎（AICPU_TS）-> HCCL_SUCCESS(0)
// 触发点：checkOnly 提前返回（与老版mc2Tiling接口行为一致，非CCU路径不探测）
// ---------------------------------------------------------------------------
static int CaseAicpuTsEngineEarlySuccess(HcclComm validComm)
{
    void* ccArgs = nullptr;
    int ret = BuildValidCcArgs(&ccArgs, kOpExecAicpuTs);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLGATHER);
    ret = static_cast<int>(CheckOpResSufficient(validComm, ccType, ccArgs));
    (void)Mc2FreeCcArgs(ccArgs);
    return ret;
}

// ---------------------------------------------------------------------------
// 用例3：Mc2SetCcCommEngine 传非法引擎（AIV）-> HCCL_E_NOT_SUPPORT(5)
// 触发点：Mc2SetCcCommEngine 白名单（CCU_MS/CCU_SCHED/AICPU/AICPU_TS）
// 说明：ccArgs由Mc2*接口构造，非法引擎在Set阶段即被拦截，无法带进check接口，
//       该用例验证的是"非法引擎构造不出合法参数"这一前置防线。
// ---------------------------------------------------------------------------
static int CaseSetEngineUnsupported(HcclComm validComm)
{
    void* ccArgs = nullptr;
    int ret = BuildValidCcArgs(&ccArgs);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }
    const Mc2Result setRet = Mc2SetCcCommEngine(ccArgs, kOpExecAiv);
    (void)Mc2FreeCcArgs(ccArgs);
    return static_cast<int>(setRet);
}

// ---------------------------------------------------------------------------
// 用例4：非法数据类型 -> HCCL_E_NOT_SUPPORT(5)
// 触发点：Mc2SetCcSrcDataType -> HcomCheckDataType（HCCL_DATA_TYPE_RESERVED不在白名单）
// ---------------------------------------------------------------------------
static int CaseSetBadDataType(HcclComm validComm)
{
    void* ccArgs = nullptr;
    int ret = BuildValidCcArgs(&ccArgs);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }
    const Mc2Result setRet = Mc2SetCcSrcDataType(ccArgs, HCCL_DATA_TYPE_RESERVED);
    (void)Mc2FreeCcArgs(ccArgs);
    return static_cast<int>(setRet);
}

// ---------------------------------------------------------------------------
// 用例5：opType 不在 CCU 支持集 -> HCCL_E_NOT_SUPPORT(5)
// 触发点：HcclAllocCcResByArgsImpl -> BuildMc2CcTiling 中 IsSupportedMc2OpType 白名单
// （HCCL_CMD_GATHER 不在 ALLGATHER/ALLREDUCE/REDUCE_SCATTER/ALLTOALL/ALLTOALLV 内）
// ---------------------------------------------------------------------------
static int CaseUnsupportedOpType(HcclComm validComm)
{
    void* ccArgs = nullptr;
    int ret = BuildValidCcArgs(&ccArgs);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }
    // 先把algConfig换成注册表中GATHER可用的算法为空（GATHER无注册算法，留空走selector语义）
    const Mc2Result setRet = Mc2SetCcAlgConfig(ccArgs, "");
    if (setRet != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<int>(setRet);
    }
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_GATHER);
    ret = static_cast<int>(CheckOpResSufficient(validComm, ccType, ccArgs));
    (void)Mc2FreeCcArgs(ccArgs);
    return ret;
}

// ---------------------------------------------------------------------------
// 用例6：algConfig 未注册 -> HCCL_E_ALG_NOT_SUPPORTED(1042)
// 触发点：HcclAllocCcResByArgsImpl 中 HcclIsCcuAlgorithmRegistered 校验
// （"NoSuchAlgName"格式合法但不在mc2_client注册表中）
// ---------------------------------------------------------------------------
static int CaseUnregisteredAlg(HcclComm validComm)
{
    void* ccArgs = nullptr;
    int ret = BuildValidCcArgs(&ccArgs);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }
    const Mc2Result setRet = Mc2SetCcAlgConfig(ccArgs, "NoSuchAlgName");
    if (setRet != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<int>(setRet);
    }
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLGATHER);
    ret = static_cast<int>(CheckOpResSufficient(validComm, ccType, ccArgs));
    (void)Mc2FreeCcArgs(ccArgs);
    return ret;
}

// ---------------------------------------------------------------------------
// 用例7：legacy格式algConfig（含'='）-> 非纯算法名，预期 HCCL_E_ALG_NOT_SUPPORTED(1042)
// 触发点：HcclAllocCcResByArgsImpl -> DispatchAllocByCommEngine 中 CheckCcuAlgorithmsRegistered
// （GetForcedAlgName 拒绝空/含'='的algConfig，与mc2Tiling版契约一致）
// ---------------------------------------------------------------------------
static int CaseLegacyAlgConfig(HcclComm validComm)
{
    void* ccArgs = nullptr;
    int ret = BuildValidCcArgs(&ccArgs);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }
    const Mc2Result setRet = Mc2SetCcAlgConfig(ccArgs, "level_graph=0");
    if (setRet != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<int>(setRet);
    }
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLGATHER);
    ret = static_cast<int>(CheckOpResSufficient(validComm, ccType, ccArgs));
    (void)Mc2FreeCcArgs(ccArgs);
    return ret;
}

// ---------------------------------------------------------------------------
// 用例8：资源充足基线（空载950 + 合法参数）-> HCCL_SUCCESS(0)
// 是1043用例的对照基线
// ---------------------------------------------------------------------------
static int CaseResourceSufficient(HcclComm validComm)
{
    void* ccArgs = nullptr;
    int ret = BuildValidCcArgs(&ccArgs);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLGATHER);
    ret = static_cast<int>(CheckOpResSufficient(validComm, ccType, ccArgs));
    (void)Mc2FreeCcArgs(ccArgs);
    return ret;
}

// ---------------------------------------------------------------------------
// 用例9：单rank守卫 -> HCCL_SUCCESS(0)
// 触发点：HcclAllocCcResByArgsImpl 中 rankSize==1 提前返回
// 通过单卡环境（devCount==1）运行样例覆盖
// ---------------------------------------------------------------------------
static int CaseSingleRankGuard(HcclComm validComm) { return CaseResourceSufficient(validComm); }

// ---------------------------------------------------------------------------
// 用例10（可选，--stress-reuse）：观察资源不足 -> HCCL_E_RES_NOT_SUFFICIENT(1043)
//   同一comm先走一次真实Mc2AcquireCcResCtx（绑定一次CcuIns），再check一次并打印结果。
// 触发点：资源链中HcclGetAlgRes返回HCCL_E_UNAVAIL，checkOnly下翻译为1043。
// 注意：checkOnly不注册kernel、不占用资源，同一进程内反复check结果幂等、不会累积需求；
//   只有设备上已有其它comm/实例占用CCU资源时才可能返回1043，故本用例仅观察、不做断言。
// ---------------------------------------------------------------------------
static int CaseReuseInsInsufficient(HcclComm validComm)
{
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLGATHER);

    // 步骤1：真实分配一次，绑定一个CcuIns
    void* ccArgs = nullptr;
    int ret = BuildValidCcArgs(&ccArgs);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }
    void* ccResCtx = nullptr;
    uint32_t ccResCtxSize = 0U;
    const Mc2Result acquireRet = Mc2AcquireCcResCtx(validComm, ccType, ccArgs, &ccResCtx, &ccResCtxSize);
    if (acquireRet != HCCL_SUCCESS) {
        printf("[stress] Mc2AcquireCcResCtx failed, ret=%d, skip stress check\n", static_cast<int>(acquireRet));
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<int>(acquireRet);
    }
    printf("[stress] first acquire ok, ccResCtx=%p size=%u\n", ccResCtx, ccResCtxSize);

    // 步骤2：check一次并打印结果，观察是否为1043
    const int checkRet = static_cast<int>(CheckOpResSufficient(validComm, ccType, ccArgs));
    if (checkRet == kErrResNotSufficient) {
        printf("[stress] resource insufficient observed: ret=%d is 1043\n", checkRet);
    } else {
        printf("[stress] check ret=%d, 1043 not observed (device CCU resource not contended)\n", checkRet);
    }
    (void)Mc2FreeCcArgs(ccArgs);
    // ccResCtx由通信域管理，随HcclCommDestroy释放，不单独释放
    return checkRet;
}

struct ThreadContext {
    HcclRootInfo* rootInfo;
    uint32_t device;
    uint32_t devCount;
    bool stressReuse;
};

// expect为-1表示仅观察，不计入判定
static bool CasePassed(const CaseResult& r) { return (r.expect == -1) || (r.expect == r.actual); }

static int CountFailures(const std::vector<CaseResult>& results)
{
    int fail = 0;
    for (const auto& r : results) {
        if (!CasePassed(r)) {
            ++fail;
        }
    }
    return fail;
}

static void PrintSummary(const std::vector<CaseResult>& results)
{
    printf("\n================ CheckOpResSufficient errcode cases ================\n");
    printf("%-38s %-10s %-10s %-6s\n", "case", "expect", "actual", "result");
    for (const auto& r : results) {
        printf("%-38s %-10d %-10d %-6s\n", r.name, r.expect, r.actual, CasePassed(r) ? "PASS" : "FAIL");
    }
    printf("=====================================================================\n");
    const size_t fail = static_cast<size_t>(CountFailures(results));
    printf("total=%zu pass=%zu fail=%zu\n", results.size(), results.size() - fail, fail);
}

int Sample(void* arg)
{
    ThreadContext* ctx = (ThreadContext*)arg;
    const uint32_t device = ctx->device;
    if (ctx->devCount > CCU_MAX_RANK_SIZE) {
        std::cout << "devCount " << ctx->devCount << " exceeds CCU_MAX_RANK_SIZE " << CCU_MAX_RANK_SIZE << std::endl;
        return HCCL_E_PARA;
    }
    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(device)));

    HcclComm hcclComm;
    HCCLCHECK(HcclCommInitRootInfo(ctx->devCount, ctx->rootInfo, device, &hcclComm));

    // 构造一份合法参数供空指针用例做对照
    void* validArgs = nullptr;
    int buildRet = BuildValidCcArgs(&validArgs);
    if (buildRet != HCCL_SUCCESS) {
        (void)HcclCommDestroy(hcclComm);
        return buildRet;
    }

    std::vector<CaseResult> results;
    const bool singleRank = (ctx->devCount == 1U);

    results.push_back({"NullComm (expect PTR=2)", HCCL_E_PTR, CaseNullComm(hcclComm, validArgs)});
    results.push_back({"NullCcArgs (expect PTR=2)", HCCL_E_PTR, CaseNullCcArgs(hcclComm, validArgs)});
    results.push_back({"SetEngine=AIV (expect NOT_SUPPORT=5)", HCCL_E_NOT_SUPPORT, CaseSetEngineUnsupported(hcclComm)});
    results.push_back({"SetSrcDataType=RESERVED (expect 5)", HCCL_E_NOT_SUPPORT, CaseSetBadDataType(hcclComm)});
    results.push_back({"UnregisteredAlg (expect 1042)", kErrAlgNotSupported, CaseUnregisteredAlg(hcclComm)});

    if (singleRank) {
        // 单卡：rankSize==1守卫在引擎判断之前，任何引擎直接SUCCESS
        results.push_back({"SingleRankGuard (expect SUCCESS=0)", HCCL_SUCCESS, CaseSingleRankGuard(hcclComm)});
    } else {
        results.push_back({"AicpuTsEngine (expect SUCCESS=0)", HCCL_SUCCESS, CaseAicpuTsEngineEarlySuccess(hcclComm)});
        results.push_back({"UnsupportedOpType=GATHER (expect 5)", HCCL_E_NOT_SUPPORT, CaseUnsupportedOpType(hcclComm)});
        results.push_back({"LegacyAlgConfig (expect 1042)", kErrAlgNotSupported, CaseLegacyAlgConfig(hcclComm)});
        results.push_back({"ResourceSufficient (expect 0)", HCCL_SUCCESS, CaseResourceSufficient(hcclComm)});
    }

    (void)Mc2FreeCcArgs(validArgs);

    if (ctx->stressReuse && !singleRank) {
        results.push_back({"ReuseInsInsufficient (observe 1043)", -1, CaseReuseInsInsufficient(hcclComm)});
    }

    if (device == 0U) {
        PrintSummary(results);
    }

    HCCLCHECK(HcclCommDestroy(hcclComm));
    ACLCHECK_NRT(aclrtResetDevice(device));
    // 有用例失败时以非0退出码返回，便于脚本/CI判定
    return (CountFailures(results) == 0) ? 0 : HCCL_E_INTERNAL;
}

int main(int argc, char* argv[])
{
    // --stress-reuse: 启用1043资源竞争观察用例（需空载950真机，见用例10说明）
    bool stressReuse = false;
    for (int i = 1; i < argc; ++i) {
        if (strcmp(argv[i], "--stress-reuse") == 0) {
            stressReuse = true;
        }
    }

    ACLCHECK(aclInit(NULL));
    uint32_t devCount;
    ACLCHECK(aclrtGetDeviceCount(&devCount));
    std::cout << "Found " << devCount << " NPU device(s) available" << std::endl;

    int32_t rootRank = 0;
    ACLCHECK(aclrtSetDevice(rootRank));
    void* rootInfoBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoBuf, sizeof(HcclRootInfo)));
    HcclRootInfo* rootInfo = (HcclRootInfo*)rootInfoBuf;
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    std::vector<std::thread> threads(devCount);
    std::vector<ThreadContext> args(devCount);
    std::vector<int> results(devCount, 0);
    for (uint32_t i = 0; i < devCount; i++) {
        args[i].rootInfo = rootInfo;
        args[i].device = i;
        args[i].devCount = devCount;
        args[i].stressReuse = stressReuse;
        threads[i] = std::thread([&args, &results, i]() { results[i] = Sample((void*)&args[i]); });
    }
    int exitCode = 0;
    for (uint32_t i = 0; i < devCount; i++) {
        threads[i].join();
        if (results[i] != 0) {
            printf(">>> device: %u, sample failed, retcode: %d\n", i, results[i]);
            exitCode = 1;
        }
    }

    ACLCHECK(aclrtFreeHost(rootInfoBuf));
    ACLCHECK(aclFinalize());
    return exitCode;
}
