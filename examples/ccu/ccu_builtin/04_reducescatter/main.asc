#include <cstdio>
#include <iostream>
#include <vector>
#include <thread>

#include <acl/acl_rt.h>
#include <hccl/hccl_comm.h>
#include <hccl/hccl_types.h>

#include "adv_api/hccl/hccl.h"
#include "adv_api/hccl/hccl_mc2.h"
#include "kernel_operator.h"

#ifdef ACLCHECK
#undef ACLCHECK
#endif

#define ACLCHECK(ret)                                                                          \
    do {                                                                                       \
        if (ret != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                        \
        }                                                                                      \
    } while (0)

#define HCCLCHECK(call)                                                                                    \
    do {                                                                                                   \
        auto ret = (call);                                                                                 \
        int retCode = static_cast<int>(ret);                                                               \
        HcclResult hcclRet = static_cast<HcclResult>(ret);                                                 \
        if (retCode >= static_cast<int>(CCU_E_DRV_START) && retCode <= static_cast<int>(CCU_E_RESERVED)) { \
            hcclRet = HCCL_E_INTERNAL;                                                                     \
        }                                                                                                  \
        if (hcclRet != HCCL_SUCCESS) {                                                                     \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, retCode);        \
            return hcclRet;                                                                                \
        }                                                                                                  \
    } while (0)

#define CHK_PTR_NULL(ptr)       \
    do {                        \
        if ((ptr) == nullptr) { \
            return HCCL_E_PTR;  \
        }                       \
    } while (0)

constexpr uint64_t CCU_MAX_RANK_SIZE = 8;
constexpr int32_t kErrResNotSufficient = 1043;

// Sample configuration: change these values to test another payload shape or data type.
using SampleDataType = float;
constexpr HcclDataType SAMPLE_DATA_TYPE = HCCL_DATA_TYPE_FP32;
constexpr AscendC::HcclDataType SAMPLE_DEVICE_DATA_TYPE = AscendC::HcclDataType::HCCL_DATA_TYPE_FP32;
constexpr uint64_t SAMPLE_ELEMENTS_PER_RANK = 256U;
constexpr size_t SAMPLE_ELEMENT_SIZE = sizeof(SampleDataType);
constexpr uint64_t SAMPLE_PRINT_COUNT = 100U;

// Mc2CcKernelLaunch starts the CCU server. The AICore client below submits the
// actual ReduceScatter request through the HCCL high-level API.
__global__ __vector__ void reduce_scatter_kernel(
    __gm__ void* sendBuf, __gm__ void* recvBuf, __gm__ void* contextGM, uint64_t recvCount)
{
    AscendC::InitSocState();
    AscendC::Hccl<AscendC::HcclServerType::HCCL_SERVER_TYPE_CCU> hccl;
    hccl.InitV2((GM_ADDR)contextGM);
    AscendC::HcclHandle handleId = hccl.ReduceScatter<true>(
        (GM_ADDR)sendBuf, (GM_ADDR)recvBuf, recvCount, SAMPLE_DEVICE_DATA_TYPE, AscendC::HcclReduceOp::HCCL_REDUCE_SUM,
        0);
    hccl.Wait(handleId);
    AscendC::SyncAll<true>();
    hccl.Finalize();
    AscendC::PipeBarrier<PIPE_ALL>();
}

HcclResult ReduceScatterCustom(
    void* sendBuf, void* recvBuf, uint64_t recvCount, HcclDataType dataType, HcclReduceOp reduceOp, HcclComm comm,
    aclrtStream streamAiv)
{
    CHK_PTR_NULL(streamAiv);
    CHK_PTR_NULL(comm);
    CHK_PTR_NULL(sendBuf);
    CHK_PTR_NULL(recvBuf);

    void* ccArgs = nullptr;
    void* ccResCtx = nullptr;
    constexpr uint8_t kCcuSchedEngine = 6U; // OpExecuteConfig::CCU_SCHED
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_REDUCE_SCATTER);
    char reduceScatterAlg[] = "CcuSchedReduceScatterSoleMesh";
    uint32_t ccResCtxSize = 0U;
    Mc2Result mc2Ret = HCCL_SUCCESS;

    mc2Ret = Mc2GetCcArgs(&ccArgs);
    if (mc2Ret != HCCL_SUCCESS) {
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcCommEngine(ccArgs, kCcuSchedEngine);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcSrcDataType(ccArgs, dataType);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcDstDataType(ccArgs, dataType);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcReduceType(ccArgs, static_cast<uint8_t>(reduceOp));
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcAlgConfig(ccArgs, reduceScatterAlg);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }

    // 在申请资源上下文前预检查CCU资源是否充足。
    const HcclResult checkRet = CheckOpResSufficient(comm, ccType, ccArgs);
    if (static_cast<int32_t>(checkRet) == kErrResNotSufficient) {
        // 错误码1043表示CCU资源暂时不足，可以选择非CCU算法逻辑自行处理，当前示例仅返回。
        (void)Mc2FreeCcArgs(ccArgs);
        return checkRet;
    } else if (checkRet != HCCL_SUCCESS) {
        // 其他错误码表示参数错误或HCCL内部异常，可进行异常处理，例如记录错误码或触发故障恢复，再返回。
        (void)Mc2FreeCcArgs(ccArgs);
        return checkRet;
    }
    mc2Ret = Mc2AcquireCcResCtx(comm, ccType, ccArgs, &ccResCtx, &ccResCtxSize);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    HCCLCHECK(Mc2FreeCcArgs(ccArgs));
    mc2Ret = Mc2CcKernelLaunch(nullptr, ccResCtx, ccResCtxSize);
    if (mc2Ret != HCCL_SUCCESS) {
        return static_cast<HcclResult>(mc2Ret);
    }

    reduce_scatter_kernel<<<1, nullptr, streamAiv>>>(sendBuf, recvBuf, ccResCtx, recvCount);
    return HCCL_SUCCESS;
}

struct ThreadContext {
    HcclRootInfo* rootInfo;
    uint32_t device;
    uint32_t devCount;
};

int Sample(void* arg)
{
    ThreadContext* ctx = static_cast<ThreadContext*>(arg);
    void* sendBuf = nullptr;
    void* recvBuf = nullptr;
    uint32_t device = ctx->device;
    if (ctx->devCount > CCU_MAX_RANK_SIZE) {
        std::cout << "devCount " << ctx->devCount << " exceeds CCU_MAX_RANK_SIZE " << CCU_MAX_RANK_SIZE << std::endl;
        return HCCL_E_PARA;
    }

    constexpr uint64_t recvCount = SAMPLE_ELEMENTS_PER_RANK;
    const uint64_t sendCount = recvCount * ctx->devCount;
    const size_t sendSize = sendCount * SAMPLE_ELEMENT_SIZE;
    const size_t recvSize = recvCount * SAMPLE_ELEMENT_SIZE;

    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(device)));

    HcclComm hcclComm;
    HCCLCHECK(HcclCommInitRootInfo(ctx->devCount, ctx->rootInfo, device, &hcclComm));

    aclrtStream streamAiv;
    ACLCHECK(aclrtCreateStream(&streamAiv));

    ACLCHECK(aclrtMalloc(&sendBuf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&recvBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));

    void* hostBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&hostBuf, sendSize));
    SampleDataType* inputHost = static_cast<SampleDataType*>(hostBuf);
    for (uint64_t i = 0; i < sendCount; ++i) {
        inputHost[i] = static_cast<SampleDataType>(device + 1U);
    }
    const uint64_t inputPrintCount = (sendCount < SAMPLE_PRINT_COUNT) ? sendCount : SAMPLE_PRINT_COUNT;
    std::cout << "rankId: " << device << ", input(first " << inputPrintCount << "): [";
    for (uint64_t i = 0; i < inputPrintCount; ++i) {
        std::cout << " " << static_cast<float>(inputHost[i]);
    }
    std::cout << " ]" << std::endl;

    ACLCHECK(aclrtMemcpy(sendBuf, sendSize, hostBuf, sendSize, ACL_MEMCPY_HOST_TO_DEVICE));
    ACLCHECK(aclrtFreeHost(hostBuf));

    HCCLCHECK(ReduceScatterCustom(sendBuf, recvBuf, recvCount, SAMPLE_DATA_TYPE, HCCL_REDUCE_SUM, hcclComm, streamAiv));
    ACLCHECK(aclrtSynchronizeStream(streamAiv));

    void* resultBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&resultBuf, recvSize));
    ACLCHECK(aclrtMemcpy(resultBuf, recvSize, recvBuf, recvSize, ACL_MEMCPY_DEVICE_TO_HOST));
    SampleDataType* resultHost = static_cast<SampleDataType*>(resultBuf);
    const uint64_t outputPrintCount = (recvCount < SAMPLE_PRINT_COUNT) ? recvCount : SAMPLE_PRINT_COUNT;
    std::cout << "rankId: " << device << ", recvBuf(first " << outputPrintCount << "): [";
    for (uint64_t i = 0; i < outputPrintCount; ++i) {
        std::cout << " " << static_cast<float>(resultHost[i]);
    }
    std::cout << " ]" << std::endl;

    const SampleDataType expected = static_cast<SampleDataType>(ctx->devCount * (ctx->devCount + 1) / 2);
    bool valid = true;
    for (uint64_t i = 0; i < recvCount; ++i) {
        if (resultHost[i] != expected) {
            valid = false;
            break;
        }
    }
    std::cout << "rankId: " << device << ", expected: " << expected << ", validation: " << (valid ? "PASS" : "FAIL")
              << std::endl;

    ACLCHECK(aclrtFreeHost(resultBuf));
    HCCLCHECK(HcclCommDestroy(hcclComm));
    if (sendBuf != nullptr) {
        ACLCHECK(aclrtFree(sendBuf));
    }
    if (recvBuf != nullptr) {
        ACLCHECK(aclrtFree(recvBuf));
    }
    ACLCHECK(aclrtDestroyStream(streamAiv));
    ACLCHECK(aclrtResetDevice(device));
    return valid ? 0 : HCCL_E_INTERNAL;
}

int main()
{
    ACLCHECK(aclInit(NULL));

    uint32_t devCount;
    ACLCHECK(aclrtGetDeviceCount(&devCount));
    std::cout << "Found " << devCount << " NPU device(s) available" << std::endl;

    int32_t rootRank = 0;
    ACLCHECK(aclrtSetDevice(rootRank));
    void* rootInfoBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoBuf, sizeof(HcclRootInfo)));
    HcclRootInfo* rootInfo = static_cast<HcclRootInfo*>(rootInfoBuf);
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    std::vector<std::thread> threads(devCount);
    std::vector<ThreadContext> args(devCount);
    for (uint32_t i = 0; i < devCount; ++i) {
        args[i].rootInfo = rootInfo;
        args[i].device = i;
        args[i].devCount = devCount;
        threads[i] = std::thread(Sample, static_cast<void*>(&args[i]));
    }
    for (uint32_t i = 0; i < devCount; ++i) {
        threads[i].join();
    }

    ACLCHECK(aclrtFreeHost(rootInfoBuf));
    ACLCHECK(aclFinalize());
    return 0;
}
