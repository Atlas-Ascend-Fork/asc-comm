#include <cstdio>
#include <iostream>
#include <vector>
#include <thread>

#include <acl/acl_rt.h>
#include <hccl/hccl_comm.h>
#include <hccl/hccl_types.h>

#include "adv_api/hccl/hccl.h"
#include "adv_api/hccl/hccl_mc2.h"
#include "kernel_operator.h"

#ifdef ACLCHECK
#undef ACLCHECK
#endif

#define ACLCHECK(ret)                                                                          \
    do {                                                                                       \
        if (ret != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                        \
        }                                                                                      \
    } while (0)

#define HCCLCHECK(call)                                                                                    \
    do {                                                                                                   \
        auto ret = (call);                                                                                 \
        int retCode = static_cast<int>(ret);                                                               \
        HcclResult hcclRet = static_cast<HcclResult>(ret);                                                 \
        if (retCode >= static_cast<int>(CCU_E_DRV_START) && retCode <= static_cast<int>(CCU_E_RESERVED)) { \
            hcclRet = HCCL_E_INTERNAL;                                                                     \
        }                                                                                                  \
        if (hcclRet != HCCL_SUCCESS) {                                                                     \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, retCode);        \
            return hcclRet;                                                                                \
        }                                                                                                  \
    } while (0)

#define CHK_PTR_NULL(ptr)       \
    do {                        \
        if ((ptr) == nullptr) { \
            return HCCL_E_PTR;  \
        }                       \
    } while (0)

constexpr uint64_t CCU_MAX_RANK_SIZE = 16;
// 与 impl 侧 OpExecuteConfig 对齐（alg_param.h）
constexpr uint8_t kOpExecCcuSched = 6U;    // CCU_SCHED
constexpr int kErrResNotSufficient = 1043; // HCCL_E_RES_NOT_SUFFICIENT

// Mc2CcKernelLaunch 启动 CCU Server，AICore 侧通过 HCCL 高阶 API 提交真实的 AllGather 请求
__global__ __vector__ void all_gather_kernel(
    __gm__ void* sendBuf, __gm__ void* recvBuf, __gm__ void* contextGM, uint64_t sendCount)
{
    AscendC::InitSocState();
    AscendC::Hccl<AscendC::HcclServerType::HCCL_SERVER_TYPE_CCU> hccl;
    hccl.InitV2((GM_ADDR)contextGM);
    AscendC::HcclHandle handleId = hccl.AllGather<true>(
        (GM_ADDR)sendBuf, (GM_ADDR)recvBuf, sendCount, AscendC::HcclDataType::HCCL_DATA_TYPE_FP32, 0);
    hccl.Wait(handleId);
    AscendC::SyncAll<true>();
    hccl.Finalize();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ---------------------------------------------------------------------------
// 构造与后续Acquire完全一致的ccArgs（CCU_SCHED + FP32 + 注册算法），
// ---------------------------------------------------------------------------
static HcclResult BuildAllGatherCcArgs(void** ccArgs)
{
    char allGatherAlg[] = "CcuSchedAllGatherSoleMesh";
    Mc2Result ret = Mc2GetCcArgs(ccArgs);
    if (ret != HCCL_SUCCESS) {
        return (HcclResult)ret;
    }
    ret = Mc2SetCcCommEngine(*ccArgs, kOpExecCcuSched);
    if (ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(*ccArgs);
        return (HcclResult)ret;
    }
    ret = Mc2SetCcSrcDataType(*ccArgs, HCCL_DATA_TYPE_FP32);
    if (ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(*ccArgs);
        return (HcclResult)ret;
    }
    ret = Mc2SetCcDstDataType(*ccArgs, HCCL_DATA_TYPE_FP32);
    if (ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(*ccArgs);
        return (HcclResult)ret;
    }
    ret = Mc2SetCcAlgConfig(*ccArgs, allGatherAlg);
    if (ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(*ccArgs);
        return (HcclResult)ret;
    }
    return HCCL_SUCCESS;
}

HcclResult CheckThenAllGather(
    void* sendBuf, void* recvBuf, uint64_t sendCount, HcclDataType dataType, HcclComm comm, aclrtStream streamAiv)
{
    CHK_PTR_NULL(streamAiv);
    CHK_PTR_NULL(comm);
    CHK_PTR_NULL(sendBuf);
    CHK_PTR_NULL(recvBuf);

    void* ccArgs = nullptr;
    void* ccResCtx = nullptr;
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLGATHER);
    uint32_t ccResCtxSize = 0U;

    HCCLCHECK(BuildAllGatherCcArgs(&ccArgs));

    // 步骤1：发起真实AllGather前先check资源是否充足
    const HcclResult checkRet = CheckOpResSufficient(comm, ccType, ccArgs);
    if (static_cast<int>(checkRet) == kErrResNotSufficient) {
        // 资源不足（1043）时的处理
        printf("CheckOpResSufficient ret=%d, resource not sufficient, skip AllGather\n", static_cast<int>(checkRet));
        (void)Mc2FreeCcArgs(ccArgs);
        return checkRet;
    } else if (checkRet != HCCL_SUCCESS) {
        // 其他异常报错时的处理
        printf("CheckOpResSufficient ret=%d, check failed, skip AllGather\n", static_cast<int>(checkRet));
        (void)Mc2FreeCcArgs(ccArgs);
        return checkRet;
    }
    printf("CheckOpResSufficient ret=0, resource sufficient, start AllGather\n");

    // 步骤2：check通过后真实申请资源并启动CCU Server
    const Mc2Result acqRet = Mc2AcquireCcResCtx(comm, ccType, ccArgs, &ccResCtx, &ccResCtxSize);
    if (acqRet != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return (HcclResult)acqRet;
    }
    HCCLCHECK(Mc2FreeCcArgs(ccArgs));
    Mc2CcKernelLaunch(nullptr, ccResCtx, ccResCtxSize);

    // 步骤3：AICore侧提交真实AllGather任务
    all_gather_kernel<<<1, nullptr, streamAiv>>>(sendBuf, recvBuf, ccResCtx, sendCount);
    (void)dataType;

    return HCCL_SUCCESS;
}

struct ThreadContext {
    HcclRootInfo* rootInfo;
    uint32_t device;
    uint32_t devCount;
};

int Sample(void* arg)
{
    ThreadContext* ctx = (ThreadContext*)arg;
    void* sendBuf = nullptr;
    void* recvBuf = nullptr;
    uint32_t device = ctx->device;
    if (ctx->devCount > CCU_MAX_RANK_SIZE) {
        std::cout << "devCount " << ctx->devCount << " exceeds CCU_MAX_RANK_SIZE " << CCU_MAX_RANK_SIZE << std::endl;
        return HCCL_E_PARA;
    }
    constexpr uint64_t sendCount = 256; // 每个 rank 输入 256 个 FP32 元素
    const uint64_t recvCount = sendCount * ctx->devCount;
    size_t sendSize = sendCount * sizeof(float);
    size_t recvSize = recvCount * sizeof(float);
    // 设置当前线程操作的设备
    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(device)));

    // 初始化集合通信域
    HcclComm hcclComm;
    HCCLCHECK(HcclCommInitRootInfo(ctx->devCount, ctx->rootInfo, device, &hcclComm));

    // 创建任务流
    aclrtStream streamAiv;
    ACLCHECK(aclrtCreateStream(&streamAiv));

    // 申请集合通信操作的 Device 内存
    ACLCHECK(aclrtMalloc(&sendBuf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&recvBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));

    // 申请 Host 内存用于存放输入数据，并将内容初始化为 Device ID + 1
    void* hostBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&hostBuf, sendSize));
    float* tmpHostBuff = static_cast<float*>(hostBuf);
    for (uint64_t i = 0; i < sendCount; ++i) {
        tmpHostBuff[i] = static_cast<float>(device) + 1;
    }
    std::cout << "rankId: " << device << ", input: [";
    for (uint64_t i = 0; i < sendCount; ++i) {
        std::cout << " " << tmpHostBuff[i];
    }
    std::cout << " ]" << std::endl;

    // 将 Host 侧输入数据拷贝到 Device 侧
    ACLCHECK(aclrtMemcpy(sendBuf, sendSize, hostBuf, sendSize, ACL_MEMCPY_HOST_TO_DEVICE));
    // 释放 Host 侧内存
    ACLCHECK(aclrtFreeHost(hostBuf));

    // 先check资源充足，再执行 AllGather
    HCCLCHECK(CheckThenAllGather(sendBuf, recvBuf, sendCount, HCCL_DATA_TYPE_FP32, hcclComm, streamAiv));

    // 阻塞等待任务流中的集合通信任务执行完成
    ACLCHECK(aclrtSynchronizeStream(streamAiv));

    // 将 Device 侧集合通信任务结果拷贝到 Host，校验并打印结果
    void* resultBuff;
    ACLCHECK(aclrtMallocHost(&resultBuff, recvSize));
    ACLCHECK(aclrtMemcpy(resultBuff, recvSize, recvBuf, recvSize, ACL_MEMCPY_DEVICE_TO_HOST));
    float* tmpResBuff = static_cast<float*>(resultBuff);
    std::cout << "rankId: " << ctx->device << ", recvBuf: [";
    for (uint32_t i = 0; i < recvCount; ++i) {
        std::cout << " " << tmpResBuff[i];
    }
    std::cout << " ]" << std::endl;

    // 逐元素校验：第 rank 段应等于 rank+1（check通过后通信结果的正确性）
    bool checkOk = true;
    for (uint32_t rank = 0; rank < ctx->devCount; rank++) {
        const float expect = static_cast<float>(rank) + 1;
        for (uint64_t i = 0; i < sendCount; ++i) {
            if (tmpResBuff[rank * sendCount + i] != expect) {
                checkOk = false;
                break;
            }
        }
    }
    std::cout << "rankId: " << ctx->device << ", result check: " << (checkOk ? "PASS" : "FAIL") << std::endl;
    if (!checkOk) {
        ACLCHECK(aclrtFreeHost(resultBuff));
        (void)HcclCommDestroy(hcclComm);
        (void)aclrtFree(sendBuf);
        (void)aclrtFree(recvBuf);
        (void)aclrtDestroyStream(streamAiv);
        (void)aclrtResetDevice(device);
        return HCCL_E_INTERNAL;
    }

    ACLCHECK(aclrtFreeHost(resultBuff));

    // 释放资源
    HCCLCHECK(HcclCommDestroy(hcclComm)); // 销毁通信域
    if (sendBuf) {
        ACLCHECK(aclrtFree(sendBuf)); // 释放 Device 侧内存
    }
    if (recvBuf) {
        ACLCHECK(aclrtFree(recvBuf)); // 释放 Device 侧内存
    }
    ACLCHECK(aclrtDestroyStream(streamAiv)); // 销毁任务流
    ACLCHECK(aclrtResetDevice(device));      // 重置设备
    return 0;
}

int main()
{
    // 设备资源初始化
    ACLCHECK(aclInit(NULL));
    // 查询设备数量
    uint32_t devCount;
    ACLCHECK(aclrtGetDeviceCount(&devCount));
    std::cout << "Found " << devCount << " NPU device(s) available" << std::endl;

    int32_t rootRank = 0;
    ACLCHECK(aclrtSetDevice(rootRank));
    // 生成 Root 节点信息，各线程使用同一份 RootInfo
    void* rootInfoBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoBuf, sizeof(HcclRootInfo)));
    HcclRootInfo* rootInfo = (HcclRootInfo*)rootInfoBuf;
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    // 启动线程执行集合通信操作
    std::vector<std::thread> threads(devCount);
    std::vector<ThreadContext> args(devCount);
    for (uint32_t i = 0; i < devCount; i++) {
        args[i].rootInfo = rootInfo;
        args[i].device = i;
        args[i].devCount = devCount;
        threads[i] = std::thread(Sample, (void*)&args[i]);
    }
    int exitCode = 0;
    for (uint32_t i = 0; i < devCount; i++) {
        threads[i].join();
    }

    // 释放资源
    ACLCHECK(aclrtFreeHost(rootInfoBuf)); // 释放 Host 内存
    ACLCHECK(aclFinalize());              // 设备去初始化
    return exitCode;
}
