#include <cstdio>
#include <iostream>
#include <vector>
#include <thread>

#include <acl/acl_rt.h>
#include <hccl/hccl_comm.h>
#include <hccl/hccl_rank_graph.h>
#include <hccl/hccl_res.h>
#include <hccl/hccl_types.h>

#include "adv_api/hccl/hccl.h"
#include "adv_api/hccl/hccl_mc2.h"
#include "kernel_operator.h"
#include "utils/debug/asc_dump.h"
#include "utils/debug/asc_printf.h"

#ifdef ACLCHECK
#undef ACLCHECK
#endif

#define ACLCHECK(ret)                                                                          \
    do {                                                                                       \
        if (ret != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                        \
        }                                                                                      \
    } while (0)

#define HCCLCHECK(call)                                                                                    \
    do {                                                                                                   \
        auto ret = (call);                                                                                 \
        int retCode = static_cast<int>(ret);                                                               \
        HcclResult hcclRet = static_cast<HcclResult>(ret);                                                 \
        if (retCode >= static_cast<int>(CCU_E_DRV_START) && retCode <= static_cast<int>(CCU_E_RESERVED)) { \
            hcclRet = HCCL_E_INTERNAL;                                                                     \
        }                                                                                                  \
        if (hcclRet != HCCL_SUCCESS) {                                                                     \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, retCode);        \
            return hcclRet;                                                                                \
        }                                                                                                  \
    } while (0)

#define CHK_PTR_NULL(ptr)       \
    do {                        \
        if ((ptr) == nullptr) { \
            return HCCL_E_PTR;  \
        }                       \
    } while (0)

// namespace ccu = ::AscendC::ccu;

constexpr uint64_t CCU_MAX_RANK_SIZE = 16;
constexpr int32_t kErrResNotSufficient = 1043;

// Sample configuration: change these values to test another payload shape or data type.
using SampleDataType = float;
constexpr HcclDataType SAMPLE_DATA_TYPE = HCCL_DATA_TYPE_FP32;
constexpr AscendC::HcclDataType SAMPLE_DEVICE_DATA_TYPE = AscendC::HcclDataType::HCCL_DATA_TYPE_FP32;
constexpr uint64_t SAMPLE_ELEMENT_COUNT = 256U;
constexpr uint64_t SAMPLE_MAX_ELEMENT_COUNT = SAMPLE_ELEMENT_COUNT * CCU_MAX_RANK_SIZE;
constexpr size_t SAMPLE_ELEMENT_SIZE = sizeof(SampleDataType);
constexpr float SAMPLE_ADD_VALUE = 8.0F;
constexpr uint64_t SAMPLE_PRINT_COUNT = 100U;

// Mc2CcuCcKernel starts the CCU server. The AICore client below submits the
// actual AllGather request through the HCCL high-level API.
template <typename T, uint64_t maxCount>
__global__ __vector__ void vector_add(
    __gm__ void* sendBuf, __gm__ void* yGM, __gm__ void* dstGM, __gm__ void* contextGM, uint64_t sendCount,
    uint64_t recvCount)
{
    AscendC::InitSocState();
    AscendC::Hccl<AscendC::HcclServerType::HCCL_SERVER_TYPE_CCU> hccl;
    hccl.InitV2((GM_ADDR)contextGM);
    AscendC::HcclHandle handleId =
        hccl.AllGather<true>((GM_ADDR)sendBuf, (GM_ADDR)yGM, sendCount, SAMPLE_DEVICE_DATA_TYPE, 0);
    hccl.Wait(handleId);
    AscendC::SyncAll<true>();
    hccl.Finalize();

    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    srcGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(yGM));
    dstGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(dstGM));

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<T> srcLocal = ubAllocator.Alloc<T, maxCount>();
    AscendC::LocalTensor<T> dstLocal = ubAllocator.Alloc<T, maxCount>();

    AscendC::DataCopy(srcLocal, srcGlobal, recvCount);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::printf("[AIV][vector_add] srcLocal before Adds:\n");
    AscendC::DumpTensor(srcLocal, 11, 16);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Adds(dstLocal, srcLocal, static_cast<T>(SAMPLE_ADD_VALUE), recvCount);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::printf("[AIV][vector_add] dstLocal after Adds:\n");
    AscendC::DumpTensor(dstLocal, 12, 16);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(dstGlobal, dstLocal, recvCount);
    AscendC::PipeBarrier<PIPE_ALL>();
}

HcclResult AllGatherAddCustom(
    void* computeBuf, void* sendBuf, void* recvBuf, uint64_t sendCount, HcclDataType dataType, HcclComm comm,
    aclrtStream streamAiv)
{
    CHK_PTR_NULL(streamAiv);
    CHK_PTR_NULL(comm);
    CHK_PTR_NULL(computeBuf);
    CHK_PTR_NULL(sendBuf);
    CHK_PTR_NULL(recvBuf);

    uint32_t rankSize = 0;
    HCCLCHECK(HcclGetRankSize(comm, &rankSize));

    if (sendCount == 0) {
        return HCCL_SUCCESS;
    }
    if (rankSize == 0 || rankSize > CCU_MAX_RANK_SIZE) {
        return HCCL_E_PARA;
    }

    void* ccArgs = nullptr;
    void* ccResCtx = nullptr;
    constexpr uint8_t kCcuSchedEngine = 6U; // OpExecuteConfig::CCU_SCHED
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLGATHER);
    char allGatherAlg[] = "sole[mesh]";
    uint32_t ccResCtxSize = 0U;
    Mc2Result mc2Ret = HCCL_SUCCESS;

    mc2Ret = Mc2GetCcArgs(&ccArgs);
    if (mc2Ret != HCCL_SUCCESS) {
        return (HcclResult)mc2Ret;
    }
    mc2Ret = Mc2SetCcCommEngine(ccArgs, kCcuSchedEngine);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return (HcclResult)mc2Ret;
    }
    mc2Ret = Mc2SetCcSrcDataType(ccArgs, SAMPLE_DATA_TYPE);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return (HcclResult)mc2Ret;
    }
    mc2Ret = Mc2SetCcDstDataType(ccArgs, SAMPLE_DATA_TYPE);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return (HcclResult)mc2Ret;
    }
    mc2Ret = Mc2SetCcAlgConfig(ccArgs, allGatherAlg);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return (HcclResult)mc2Ret;
    }

    // 在申请资源上下文前预检查CCU资源是否充足。
    const HcclResult checkRet = CheckOpResSufficient(comm, ccType, ccArgs);
    if (static_cast<int32_t>(checkRet) == kErrResNotSufficient) {
        // 错误码1043表示CCU资源暂时不足，可以选择非CCU算法逻辑自行处理，当前示例仅返回。
        (void)Mc2FreeCcArgs(ccArgs);
        return checkRet;
    } else if (checkRet != HCCL_SUCCESS) {
        // 其他错误码表示参数错误或HCCL内部异常，可进行异常处理，例如记录错误码或触发故障恢复，再返回。
        (void)Mc2FreeCcArgs(ccArgs);
        return checkRet;
    }
    mc2Ret = Mc2AcquireCcResCtx(comm, ccType, ccArgs, &ccResCtx, &ccResCtxSize);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return (HcclResult)mc2Ret;
    }
    HCCLCHECK(Mc2FreeCcArgs(ccArgs));
    ccArgs = nullptr;
    mc2Ret = Mc2CcKernelLaunch(nullptr, ccResCtx, ccResCtxSize);
    if (mc2Ret != HCCL_SUCCESS) {
        return (HcclResult)mc2Ret;
    }

    const uint64_t recvCount = sendCount * rankSize;
    vector_add<SampleDataType, SAMPLE_MAX_ELEMENT_COUNT>
        <<<1, nullptr, streamAiv>>>(sendBuf, recvBuf, computeBuf, ccResCtx, sendCount, recvCount);

    return HCCL_SUCCESS;
}

struct ThreadContext {
    HcclRootInfo* rootInfo;
    uint32_t device;
    uint32_t devCount;
};

int Sample(void* arg)
{
    ThreadContext* ctx = (ThreadContext*)arg;
    void* computeBuf = nullptr;
    void* sendBuf = nullptr;
    void* recvBuf = nullptr;
    uint32_t device = ctx->device;
    if (ctx->devCount > CCU_MAX_RANK_SIZE) {
        std::cout << "devCount " << ctx->devCount << " exceeds CCU_MAX_RANK_SIZE " << CCU_MAX_RANK_SIZE << std::endl;
        return HCCL_E_PARA;
    }
    constexpr uint64_t sendCount = SAMPLE_ELEMENT_COUNT;
    const uint64_t recvCount = sendCount * ctx->devCount;
    size_t sendSize = sendCount * SAMPLE_ELEMENT_SIZE;
    size_t recvSize = recvCount * SAMPLE_ELEMENT_SIZE;
    // 设置当前线程操作的设备
    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(device)));

    // 初始化集合通信域
    HcclComm hcclComm;
    HCCLCHECK(HcclCommInitRootInfo(ctx->devCount, ctx->rootInfo, device, &hcclComm));

    // 创建任务流
    aclrtStream streamAiv;
    ACLCHECK(aclrtCreateStream(&streamAiv));

    // 申请集合通信操作的 Device 内存
    ACLCHECK(aclrtMalloc(&computeBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&sendBuf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&recvBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));

    // 申请 Host 内存用于存放输入数据，并将内容初始化为 Device ID
    void* hostBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&hostBuf, sendSize));
    SampleDataType* tmpHostBuff = static_cast<SampleDataType*>(hostBuf);
    for (uint64_t i = 0; i < sendCount; ++i) {
        tmpHostBuff[i] = static_cast<SampleDataType>(device + 1U);
    }
    const uint64_t inputPrintCount = (sendCount < SAMPLE_PRINT_COUNT) ? sendCount : SAMPLE_PRINT_COUNT;
    std::cout << "rankId: " << device << ", input(first " << inputPrintCount << "): [";
    for (uint64_t i = 0; i < inputPrintCount; ++i) {
        std::cout << " " << static_cast<float>(tmpHostBuff[i]);
    }
    std::cout << " ]" << std::endl;

    // 将 Host 侧输入数据拷贝到 Device 侧
    ACLCHECK(aclrtMemcpy(sendBuf, sendSize, hostBuf, sendSize, ACL_MEMCPY_HOST_TO_DEVICE));
    // 释放 Host 侧内存
    ACLCHECK(aclrtFreeHost(hostBuf));

    // 执行 AllGatherAdd，先将通信域内所有 rank 的 sendBuf 按照 rank_id 顺序拼接到 recvBuf，再计算输出到 computeBuf
    HCCLCHECK(AllGatherAddCustom(computeBuf, sendBuf, recvBuf, sendCount, SAMPLE_DATA_TYPE, hcclComm, streamAiv));

    // 阻塞等待任务流中的集合通信任务执行完成
    ACLCHECK(aclrtSynchronizeStream(streamAiv));

    // 将 Device 侧集合通信任务结果拷贝到 Host，并打印结果
    void* resultBuff;
    ACLCHECK(aclrtMallocHost(&resultBuff, recvSize));
    ACLCHECK(aclrtMemcpy(resultBuff, recvSize, computeBuf, recvSize, ACL_MEMCPY_DEVICE_TO_HOST));
    SampleDataType* tmpResBuff = static_cast<SampleDataType*>(resultBuff);
    const uint64_t outputPrintCount = (recvCount < SAMPLE_PRINT_COUNT) ? recvCount : SAMPLE_PRINT_COUNT;
    std::cout << "rankId: " << ctx->device << ", computeBuf(first " << outputPrintCount << "): [";
    for (uint64_t i = 0; i < outputPrintCount; ++i) {
        std::cout << " " << static_cast<float>(tmpResBuff[i]);
    }
    std::cout << " ]" << std::endl;

    bool valid = true;
    for (uint32_t rank = 0; rank < ctx->devCount; ++rank) {
        const SampleDataType expected = static_cast<SampleDataType>(rank + 1U + SAMPLE_ADD_VALUE);
        const uint64_t offset = rank * sendCount;
        for (uint64_t i = 0; i < sendCount; ++i) {
            if (tmpResBuff[offset + i] != expected) {
                valid = false;
                break;
            }
        }
        if (!valid) {
            break;
        }
    }
    std::cout << "rankId: " << ctx->device << ", expected: [";
    for (uint32_t rank = 0; rank < ctx->devCount; ++rank) {
        std::cout << " " << static_cast<float>(rank + 1U + SAMPLE_ADD_VALUE);
    }
    std::cout << " ], validation: " << (valid ? "PASS" : "FAIL") << std::endl;

    ACLCHECK(aclrtFreeHost(resultBuff));

    // 释放资源
    HCCLCHECK(HcclCommDestroy(hcclComm)); // 销毁通信域
    if (computeBuf) {
        ACLCHECK(aclrtFree(computeBuf)); // 释放 Device 侧内存
    }
    if (sendBuf) {
        ACLCHECK(aclrtFree(sendBuf)); // 释放 Device 侧内存
    }
    if (recvBuf) {
        ACLCHECK(aclrtFree(recvBuf)); // 释放 Device 侧内存
    }
    ACLCHECK(aclrtDestroyStream(streamAiv)); // 销毁任务流
    ACLCHECK(aclrtResetDevice(device));      // 重置设备
    return valid ? 0 : HCCL_E_INTERNAL;
}

int main()
{
    // 设备资源初始化
    ACLCHECK(aclInit(NULL));
    // 查询设备数量
    uint32_t devCount;
    ACLCHECK(aclrtGetDeviceCount(&devCount));
    std::cout << "Found " << devCount << " NPU device(s) available" << std::endl;

    int32_t rootRank = 0;
    ACLCHECK(aclrtSetDevice(rootRank));
    // 生成 Root 节点信息，各线程使用同一份 RootInfo
    void* rootInfoBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoBuf, sizeof(HcclRootInfo)));
    HcclRootInfo* rootInfo = (HcclRootInfo*)rootInfoBuf;
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    // 启动线程执行集合通信操作
    std::vector<std::thread> threads(devCount);
    std::vector<ThreadContext> args(devCount);
    for (uint32_t i = 0; i < devCount; i++) {
        args[i].rootInfo = rootInfo;
        args[i].device = i;
        args[i].devCount = devCount;
        threads[i] = std::thread(Sample, (void*)&args[i]);
    }
    for (uint32_t i = 0; i < devCount; i++) {
        threads[i].join();
    }

    // 释放资源
    ACLCHECK(aclrtFreeHost(rootInfoBuf)); // 释放 Host 内存
    ACLCHECK(aclFinalize());              // 设备去初始化
    return 0;
}
