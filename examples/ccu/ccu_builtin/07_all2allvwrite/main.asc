#include <cstdio>
#include <iostream>
#include <thread>
#include <vector>

#include <acl/acl_rt.h>
#include <hccl/hccl_comm.h>
#include <hccl/hccl_types.h>

#include "adv_api/hccl/hccl.h"
#include "adv_api/hccl/hccl_mc2.h"
#include "adv_api/hccl/internal/hccl_msg.h"
#include "kernel_operator.h"

#ifdef ACLCHECK
#undef ACLCHECK
#endif

#define ACLCHECK(ret)                                                                          \
    do {                                                                                       \
        if (ret != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                        \
        }                                                                                      \
    } while (0)

#define HCCLCHECK(call)                                                                                    \
    do {                                                                                                   \
        auto ret = (call);                                                                                 \
        int retCode = static_cast<int>(ret);                                                               \
        HcclResult hcclRet = static_cast<HcclResult>(ret);                                                 \
        if (retCode >= static_cast<int>(CCU_E_DRV_START) && retCode <= static_cast<int>(CCU_E_RESERVED)) { \
            hcclRet = HCCL_E_INTERNAL;                                                                     \
        }                                                                                                  \
        if (hcclRet != HCCL_SUCCESS) {                                                                     \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, retCode);        \
            return hcclRet;                                                                                \
        }                                                                                                  \
    } while (0)

#define CHK_PTR_NULL(ptr)       \
    do {                        \
        if ((ptr) == nullptr) { \
            return HCCL_E_PTR;  \
        }                       \
    } while (0)

constexpr uint32_t CCU_MAX_RANK_SIZE = 8U;

// Sample configuration: change these values to test another payload shape or data type.
using SampleDataType = float;
constexpr uint64_t SAMPLE_ELEMENTS_PER_PEER = 256U;
constexpr size_t SAMPLE_ELEMENT_SIZE = sizeof(SampleDataType);
constexpr uint64_t PER_RANK_DATA_SIZE = SAMPLE_ELEMENTS_PER_PEER * SAMPLE_ELEMENT_SIZE;
constexpr uint64_t DUAL_DIE_COUNT = 2U;

template <typename T>
T GenerateSampleValue(uint32_t srcRank, uint32_t dstRank)
{
    // Keep values in [0, CCU_MAX_RANK_SIZE * CCU_MAX_RANK_SIZE - 1] for int8/uint8 payloads.
    return static_cast<T>(srcRank * CCU_MAX_RANK_SIZE + dstRank);
}

// Mc2CcKernelLaunch starts the CCU server. AlltoAllvWrite writes each source-rank
// block into the destination rank's CCU scratch buffer.
__global__ __vector__ void all_to_all_v_write_kernel(
    __gm__ void* sendBuf, __gm__ void* launchArgsGM, __gm__ void* contextGM, uint64_t perRankDataSize)
{
    AscendC::InitSocState();
    AscendC::Hccl<AscendC::HcclServerType::HCCL_SERVER_TYPE_CCU> hccl;
    hccl.InitV2((GM_ADDR)contextGM);

    const uint32_t rankId = hccl.GetRankId();
    const uint32_t rankDim = hccl.GetRankDim();
    GM_ADDR sendSizeGM = (GM_ADDR)launchArgsGM;
    GM_ADDR sendOffsetGM = sendSizeGM + rankDim * sizeof(uint64_t) * DUAL_DIE_COUNT;
    const uint64_t remoteWinOffset = static_cast<uint64_t>(rankId) * perRankDataSize;

    AscendC::HcclHandle handleId =
        hccl.AlltoAllvWrite<true>((GM_ADDR)sendBuf, sendOffsetGM, sendSizeGM, remoteWinOffset, perRankDataSize);
    hccl.Wait(handleId);
    AscendC::SyncAll<true>();
    hccl.Finalize();
    AscendC::PipeBarrier<PIPE_ALL>();
}

HcclResult AllToAllVWriteCustom(
    void* sendBuf, void* launchArgsGM, uint64_t perRankDataSize, HcclComm comm, aclrtStream streamAiv,
    void** ccResCtxOut, uint32_t* ccResCtxSizeOut)
{
    CHK_PTR_NULL(streamAiv);
    CHK_PTR_NULL(comm);
    CHK_PTR_NULL(sendBuf);
    CHK_PTR_NULL(launchArgsGM);
    CHK_PTR_NULL(ccResCtxOut);
    CHK_PTR_NULL(ccResCtxSizeOut);

    void* ccArgs = nullptr;
    void* ccResCtx = nullptr;
    constexpr uint8_t kCcuSchedEngine = 6U; // OpExecuteConfig::CCU_SCHED
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_HALF_ALLTOALLV);
    char allToAllVWriteAlg[] = "CcuHalfAll2AllVMesh1D";
    uint32_t ccResCtxSize = 0U;
    Mc2Result mc2Ret = HCCL_SUCCESS;

    mc2Ret = Mc2GetCcArgs(&ccArgs);
    if (mc2Ret != HCCL_SUCCESS) {
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcCommEngine(ccArgs, kCcuSchedEngine);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    // AlltoAllvWrite uses byte counts and offsets. The payload below is FP32,
    // but the communication metadata is intentionally expressed as INT8 bytes.
    mc2Ret = Mc2SetCcSrcDataType(ccArgs, HCCL_DATA_TYPE_INT8);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcDstDataType(ccArgs, HCCL_DATA_TYPE_INT8);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcAlgConfig(ccArgs, allToAllVWriteAlg);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }

    mc2Ret = Mc2AcquireCcResCtx(comm, ccType, ccArgs, &ccResCtx, &ccResCtxSize);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    HCCLCHECK(Mc2FreeCcArgs(ccArgs));
    Mc2CcKernelLaunch(nullptr, ccResCtx, ccResCtxSize);
    *ccResCtxOut = ccResCtx;
    *ccResCtxSizeOut = ccResCtxSize;

    all_to_all_v_write_kernel<<<1, nullptr, streamAiv>>>(sendBuf, launchArgsGM, ccResCtx, perRankDataSize);
    return HCCL_SUCCESS;
}

struct ThreadContext {
    HcclRootInfo* rootInfo;
    uint32_t device;
    uint32_t devCount;
};

int Sample(void* arg)
{
    ThreadContext* ctx = static_cast<ThreadContext*>(arg);
    void* sendBuf = nullptr;
    void* launchArgsGM = nullptr;
    void* ccResCtx = nullptr;
    uint32_t ccResCtxSize = 0U;
    const uint32_t device = ctx->device;
    if (ctx->devCount == 0U || ctx->devCount > CCU_MAX_RANK_SIZE) {
        std::cout << "devCount " << ctx->devCount << " is outside the supported range [1, " << CCU_MAX_RANK_SIZE << "]"
                  << std::endl;
        return HCCL_E_PARA;
    }

    const uint64_t sendSize = static_cast<uint64_t>(ctx->devCount) * PER_RANK_DATA_SIZE;
    const uint64_t launchArgsCount = static_cast<uint64_t>(ctx->devCount) * DUAL_DIE_COUNT * DUAL_DIE_COUNT;
    const size_t sendBufferSize = static_cast<size_t>(sendSize);
    const size_t launchArgsSize = static_cast<size_t>(launchArgsCount * sizeof(uint64_t));

    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(device)));

    HcclComm hcclComm;
    HCCLCHECK(HcclCommInitRootInfo(ctx->devCount, ctx->rootInfo, device, &hcclComm));

    aclrtStream streamAiv;
    ACLCHECK(aclrtCreateStream(&streamAiv));

    ACLCHECK(aclrtMalloc(&sendBuf, sendBufferSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&launchArgsGM, launchArgsSize, ACL_MEM_MALLOC_HUGE_ONLY));

    std::vector<SampleDataType> inputHost(static_cast<size_t>(ctx->devCount) * SAMPLE_ELEMENTS_PER_PEER);
    std::vector<uint64_t> launchArgsHost(static_cast<size_t>(launchArgsCount), 0U);
    uint64_t* sendSizes = launchArgsHost.data();
    uint64_t* sendOffsets = sendSizes + ctx->devCount * DUAL_DIE_COUNT;
    const uint64_t halfDataSize = PER_RANK_DATA_SIZE / DUAL_DIE_COUNT;
    for (uint32_t dstRank = 0U; dstRank < ctx->devCount; ++dstRank) {
        sendSizes[dstRank] = halfDataSize;
        sendSizes[dstRank + ctx->devCount] = PER_RANK_DATA_SIZE - halfDataSize;
        sendOffsets[dstRank] = static_cast<uint64_t>(dstRank) * PER_RANK_DATA_SIZE;
        sendOffsets[dstRank + ctx->devCount] = static_cast<uint64_t>(dstRank) * PER_RANK_DATA_SIZE + sendSizes[dstRank];
        for (uint64_t i = 0U; i < SAMPLE_ELEMENTS_PER_PEER; ++i) {
            inputHost[static_cast<size_t>(dstRank) * SAMPLE_ELEMENTS_PER_PEER + i] =
                GenerateSampleValue<SampleDataType>(device, dstRank);
        }
    }

    std::cout << "rankId: " << device << ", send blocks:";
    for (uint32_t dstRank = 0U; dstRank < ctx->devCount; ++dstRank) {
        std::cout << " [" << static_cast<float>(GenerateSampleValue<SampleDataType>(device, dstRank)) << " x "
                  << SAMPLE_ELEMENTS_PER_PEER << "]";
    }
    std::cout << std::endl;

    ACLCHECK(aclrtMemcpy(sendBuf, sendBufferSize, inputHost.data(), sendBufferSize, ACL_MEMCPY_HOST_TO_DEVICE));
    ACLCHECK(
        aclrtMemcpy(launchArgsGM, launchArgsSize, launchArgsHost.data(), launchArgsSize, ACL_MEMCPY_HOST_TO_DEVICE));

    HCCLCHECK(
        AllToAllVWriteCustom(sendBuf, launchArgsGM, PER_RANK_DATA_SIZE, hcclComm, streamAiv, &ccResCtx, &ccResCtxSize));
    ACLCHECK(aclrtSynchronizeStream(streamAiv));

    if (ccResCtxSize < sizeof(HcclApi::OpResCtx)) {
        std::cout << "unexpected MC2 context size: " << ccResCtxSize << std::endl;
        return HCCL_E_INTERNAL;
    }
    HcclApi::OpResCtx opResCtxHost{};
    ACLCHECK(
        aclrtMemcpy(&opResCtxHost, sizeof(opResCtxHost), ccResCtx, sizeof(opResCtxHost), ACL_MEMCPY_DEVICE_TO_HOST));

    bool valid = true;
    std::vector<SampleDataType> resultHost(
        static_cast<size_t>(ctx->devCount) * SAMPLE_ELEMENTS_PER_PEER, static_cast<SampleDataType>(0));
    if (opResCtxHost.res[0] == 0U) {
        std::cout << "rankId: " << device << ", CCU scratch address is null" << std::endl;
        valid = false;
    } else {
        ACLCHECK(aclrtMemcpy(
            resultHost.data(), sendBufferSize, reinterpret_cast<void*>(opResCtxHost.res[0]), sendBufferSize,
            ACL_MEMCPY_DEVICE_TO_HOST));
    }

    if (valid) {
        std::cout << "rankId: " << device << ", recv blocks:";
        for (uint32_t srcRank = 0U; srcRank < ctx->devCount; ++srcRank) {
            const SampleDataType expected = GenerateSampleValue<SampleDataType>(srcRank, device);
            std::cout << " [" << static_cast<float>(resultHost[static_cast<size_t>(srcRank) * SAMPLE_ELEMENTS_PER_PEER])
                      << " x " << SAMPLE_ELEMENTS_PER_PEER << "]";
            for (uint64_t i = 0U; i < SAMPLE_ELEMENTS_PER_PEER; ++i) {
                const SampleDataType actual = resultHost[static_cast<size_t>(srcRank) * SAMPLE_ELEMENTS_PER_PEER + i];
                if (actual != expected) {
                    valid = false;
                    break;
                }
            }
        }
        std::cout << std::endl;
    }
    std::cout << "rankId: " << device << ", validation: " << (valid ? "PASS" : "FAIL") << std::endl;

    HCCLCHECK(HcclCommDestroy(hcclComm));
    if (sendBuf != nullptr) {
        ACLCHECK(aclrtFree(sendBuf));
    }
    if (launchArgsGM != nullptr) {
        ACLCHECK(aclrtFree(launchArgsGM));
    }
    ACLCHECK(aclrtDestroyStream(streamAiv));
    ACLCHECK(aclrtResetDevice(device));
    return valid ? 0 : HCCL_E_INTERNAL;
}

int main()
{
    ACLCHECK(aclInit(NULL));

    uint32_t devCount;
    ACLCHECK(aclrtGetDeviceCount(&devCount));
    std::cout << "Found " << devCount << " NPU device(s) available" << std::endl;

    const int32_t rootRank = 0;
    ACLCHECK(aclrtSetDevice(rootRank));
    void* rootInfoBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoBuf, sizeof(HcclRootInfo)));
    HcclRootInfo* rootInfo = static_cast<HcclRootInfo*>(rootInfoBuf);
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    std::vector<std::thread> threads(devCount);
    std::vector<ThreadContext> args(devCount);
    for (uint32_t i = 0U; i < devCount; ++i) {
        args[i].rootInfo = rootInfo;
        args[i].device = i;
        args[i].devCount = devCount;
        threads[i] = std::thread(Sample, static_cast<void*>(&args[i]));
    }
    for (uint32_t i = 0U; i < devCount; ++i) {
        threads[i].join();
    }

    ACLCHECK(aclrtFreeHost(rootInfoBuf));
    ACLCHECK(aclFinalize());
    return 0;
}
