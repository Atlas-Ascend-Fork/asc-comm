/**
 * @brief 实现 Mesh1D Mem2Mem AllGather 的参数计算和 CCU 任务下发。
 *
 * CCU Thread、Channel、Kernel 及 EngineCtx 由 alg_resource.cc 管理。本文件
 * 负责检查算子参数、计算 GroupCopy 参数并按 10 参数任务 ABI 下发 Kernel。
 */
#include "exec_op.h"

#include <cstdint>
#include <iostream>
#include <string>
#include <vector>

#include <acl/acl.h>
#include <hccl/hccl.h>
#include <hccl/hcomm_primitives.h>
#include <hcomm/hcomm_ccu_launch_api.h>

#include "alg_resource.h"
#include "ccu_kernel.h"
#include <ccu/hcomm/ccu_launch.h>
#include <ccu/hcomm/ccu_resource_api.h>

namespace CcuAgMem2mem {
namespace {

constexpr uint64_t MAX_RANKS = 16;

bool IsAscend950()
{
    const char* soc = aclrtGetSocName();
    return soc != nullptr && std::string(soc).find("Ascend950") != std::string::npos;
}

constexpr uint64_t SetBitsHost(uint16_t end) { return ((uint64_t(1) << (end + 1)) - uint64_t(1)); }

uint64_t GetMaxLoopIterNumHost()
{
    constexpr uint16_t loop_num_bit_num = 12;
    return SetBitsHost(loop_num_bit_num);
}

uint64_t GetParallelParamHost(uint64_t repeat_num, uint64_t repeat_loop_index, uint64_t total_loop_num)
{
    constexpr uint16_t repeat_bit_num = 7;
    constexpr uint16_t repeat_num_shift_bit = 55;
    constexpr uint16_t repeat_loop_bit_num = 7;
    constexpr uint16_t repeat_loop_shift_bit = 48;
    constexpr uint16_t total_loop_bit_num = 7;
    constexpr uint16_t total_loop_shift_bit = 41;
    return ((repeat_num & SetBitsHost(repeat_bit_num)) << repeat_num_shift_bit) |
           ((repeat_loop_index & SetBitsHost(repeat_loop_bit_num)) << repeat_loop_shift_bit) |
           ((total_loop_num & SetBitsHost(total_loop_bit_num)) << total_loop_shift_bit);
}

std::vector<uint64_t> CalGoSize(uint64_t size, const loop_group_config& config)
{
    const uint64_t loopSize = config.loop_count * config.mem_slice;
    const uint64_t maxSize = loopSize * (GetMaxLoopIterNumHost() + 1);

    uint64_t loop_count = size / loopSize;
    uint64_t sliceCount = (size - loop_count * loopSize) / config.mem_slice;
    uint64_t residual = size - loop_count * loopSize - sliceCount * config.mem_slice;

    if (size == maxSize) {
        loop_count = GetMaxLoopIterNumHost();
        sliceCount = config.loop_count - 1;
        residual = config.mem_slice;
    }

    const uint64_t offset = config.mem_slice * config.loop_count * loop_count;
    uint64_t parallel_param = 0;
    uint64_t tailSize = 0;
    constexpr uint64_t twoLoops = 2;

    if (sliceCount != 0 && residual == 0) {
        parallel_param = GetParallelParamHost(sliceCount - 1, 0, 1);
        tailSize = config.mem_slice;
    } else if (sliceCount == 0 && residual != 0) {
        parallel_param = GetParallelParamHost(0, 0, 1);
        tailSize = residual;
    } else if (sliceCount != 0) {
        parallel_param = GetParallelParamHost(sliceCount - 1, 1, twoLoops);
        tailSize = residual;
    }
    return {offset, loop_count, parallel_param, tailSize};
}

} // namespace

HcclResult AllGatherMesh1D(void* sendBuf, void* recvBuf, uint64_t count_, HcclComm comm, aclrtStream stream)
{
    if (comm == nullptr || sendBuf == nullptr || recvBuf == nullptr) {
        return HCCL_E_PTR;
    }

    uint32_t myRank = 0;
    uint32_t rankSize = 0;
    RETURN_IF_HCCL_FAIL(HcclGetRankId(comm, &myRank));
    RETURN_IF_HCCL_FAIL(HcclGetRankSize(comm, &rankSize));
    if (rankSize == 0 || rankSize > MAX_RANKS) {
        return HCCL_E_PARA;
    }
    if (!IsAscend950()) {
        std::cerr << "AllGatherMesh1D only supports Ascend950 "
                  << "(dav-3510)\n";
        return HCCL_E_NOT_SUPPORT;
    }
    if (count_ == 0) {
        return HCCL_SUCCESS;
    }

    constexpr char tag[] = "CcuAgMem2mem";
    AlgResourceCtx resCtx;
    RETURN_IF_HCCL_FAIL(InitAlgResourceCtx(comm, tag, myRank, rankSize, stream, resCtx));

    const uint64_t dataSize = count_ * sizeof(float);
    if (rankSize == 1) {
        RETURN_IF_HCCL_FAIL(
            static_cast<HcclResult>(HcommLocalCopyOnThread(resCtx.threads[0], recvBuf, sendBuf, dataSize)));
        return HCCL_SUCCESS;
    }

    uint64_t token = 0;
    RETURN_IF_HCCL_FAIL(
        ConvertCcuToHccl(asccomm_ccu_get_mem_token(reinterpret_cast<uint64_t>(sendBuf), dataSize, &token)));

    loop_group_config config{};
    config.ms_interleave = ccu_ms_interleave;
    config.loop_count = CCU_MS_LOCAL_COPY_LOOP_COUNT;
    config.mem_slice = ccu_ms_size * CCU_LOCAL_COPY_MS_PER_LOOP;
    const std::vector<uint64_t> goSize = CalGoSize(dataSize, config);

    uint64_t task_args[TASK_ARG_NUM]{};
    task_args[TASK_INPUT_ADDR] = reinterpret_cast<uint64_t>(sendBuf);
    task_args[TASK_OUTPUT_ADDR] = reinterpret_cast<uint64_t>(recvBuf);
    task_args[TASK_TOKEN] = token;
    task_args[TASK_INPUT_SLICE_STRIDE] = 0;
    task_args[TASK_OUTPUT_SLICE_STRIDE] = dataSize;
    task_args[TASK_CHUNK_SIZE] = dataSize;
    task_args[TASK_GO_ADDR_OFFSET] = goSize[0];
    task_args[TASK_GO_LOOP_PARAM] = goSize[1];
    task_args[TASK_GO_PARALLEL_PARAM] = goSize[2];
    task_args[TASK_GO_RESIDUAL] = goSize[3];

    HcommCcuLaunchContextPod launch_context{};
    RETURN_IF_HCCL_FAIL(HcommCcuGetLaunchContext(resCtx.threads[0], &launch_context));
    RETURN_IF_HCCL_FAIL(
        ConvertCcuToHccl(asccomm_ccu_kernel_launch(&launch_context, resCtx.ccuKernels[0], task_args, TASK_ARG_NUM)));
    return HCCL_SUCCESS;
}

} // namespace CcuAgMem2mem
