#include "../../../common/ccu_instance.h"

namespace ccu = ::AscendC::ccu;

#define RETURN_IF_HCCL_FAIL(call)                       \
    do {                                                \
        HcclResult ret = static_cast<HcclResult>(call); \
        if (ret != HCCL_SUCCESS) {                      \
            return ret;                                 \
        }                                               \
    } while (0)

#define RETURN_IF_CCU_FAIL(call)  \
    do {                          \
        CcuResult ret = (call);   \
        if (ret != CCU_SUCCESS) { \
            return ret;           \
        }                         \
    } while (0)

#define CCU_CHK_VOID_RET(call)    \
    do {                          \
        CcuResult ret = (call);   \
        if (ret != CCU_SUCCESS) { \
            return;               \
        }                         \
    } while (0)

constexpr uint64_t ELEMENT_COUNT = 4;
constexpr uint32_t CHANNEL_NOTIFY_NUM = 3;
constexpr uint32_t CCU_DIE_NUM = 2;

struct CcuTransferKernelArg {
    ChannelHandle channels[2]{};
    uint32_t channelCount{0};
    uint32_t rankId{0};
    uint32_t rankSize{0};
};

struct TransferContext {
    const CcuTransferKernelArg* arg = nullptr;
    ccu::variable input;
    ccu::variable inputToken;
    ccu::variable output;
    ccu::variable outputToken;
    ccu::variable dataSize;
    ccu::variable remoteOutput;
    ccu::variable remoteOutputToken;
    ccu::event event;
};

#define ACLCHECK(ret)                                                                          \
    do {                                                                                       \
        if (ret != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                        \
        }                                                                                      \
    } while (0)

#define HCCLCHECK(ret)                                                                          \
    do {                                                                                        \
        if (ret != HCCL_SUCCESS) {                                                              \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                         \
        }                                                                                       \
    } while (0)

namespace {

constexpr uint32_t RANK_SIZE = 2;

constexpr uint32_t OUTPUT_XN_ID = 1;
constexpr uint32_t TOKEN_XN_ID = 2;
constexpr uint32_t CKE_IDX_0 = 0;
constexpr uint32_t INIT_SYNC_ID = 4;
constexpr uint32_t POST_SYNC_ID = 3;
constexpr uint16_t EVENT_MASK = 1;

struct ThreadContext {
    HcclRootInfo* rootInfo = nullptr;
    uint32_t rank = 0;
};

void PrintVector(const std::string& name, uint32_t rank, const std::vector<float>& values)
{
    std::cout << "rank " << rank << " " << name << ": [";
    for (uint32_t i = 0; i < values.size(); i++) {
        std::cout << (i == 0 ? "" : ", ") << values[i];
    }
    std::cout << "]" << std::endl;
}

bool IsEqual(const std::vector<float>& actual, const std::vector<float>& expected)
{
    if (actual.size() != expected.size()) {
        return false;
    }
    for (uint32_t i = 0; i < actual.size(); i++) {
        if (std::fabs(actual[i] - expected[i]) > 1e-6F) {
            return false;
        }
    }
    return true;
}

std::vector<float> GetInput(uint32_t rank)
{
    return {1.0F + rank * 4.0F, 2.0F + rank * 4.0F, 3.0F + rank * 4.0F, 4.0F + rank * 4.0F};
}

std::vector<float> GetExpected(uint32_t rank)
{
#if SCENARIO_NUM == 1
    return GetInput(rank);
#elif SCENARIO_NUM == 2
    return GetInput(1U - rank);
#else
    return {6.0F, 8.0F, 10.0F, 12.0F};
#endif
}

ccu::local_addr MakeLocalAddr(const ccu::variable& address, const ccu::variable& token)
{
    ccu::local_addr addr;
    addr.addr_ = address;
    addr.token = token;
    return addr;
}

ccu::remote_addr MakeRemoteAddr(const ccu::variable& address, const ccu::variable& token)
{
    ccu::remote_addr addr;
    addr.addr_ = address;
    addr.token = token;
    return addr;
}

CcuResult ExchangeRemoteOutput(TransferContext& ctx)
{
    RETURN_IF_CCU_FAIL(
        ccu::write_variable_with_notify(ctx.arg->channels[0], ctx.output, OUTPUT_XN_ID, CKE_IDX_0, 1U << OUTPUT_XN_ID));
    RETURN_IF_CCU_FAIL(ccu::write_variable_with_notify(
        ctx.arg->channels[0], ctx.outputToken, TOKEN_XN_ID, CKE_IDX_0, 1U << TOKEN_XN_ID));

    const uint32_t allBits = (1U << OUTPUT_XN_ID) | (1U << TOKEN_XN_ID);
    RETURN_IF_CCU_FAIL(ccu::notify_wait(ctx.arg->channels[0], CKE_IDX_0, allBits));
    return CCU_SUCCESS;
}

CcuResult ExecuteLocalCopy(TransferContext& ctx)
{
    ccu::ccu_buffer stagingBuffer;

    const ccu::local_addr input = MakeLocalAddr(ctx.input, ctx.inputToken);
    const ccu::local_addr output = MakeLocalAddr(ctx.output, ctx.outputToken);

    RETURN_IF_CCU_FAIL(ccu::local_copy(output, input, ctx.dataSize, ctx.event, EVENT_MASK));
    RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, EVENT_MASK));
    RETURN_IF_CCU_FAIL(ccu::local_copy(stagingBuffer, input, ctx.dataSize, ctx.event, EVENT_MASK));
    RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, EVENT_MASK));
    RETURN_IF_CCU_FAIL(ccu::local_copy(output, stagingBuffer, ctx.dataSize, ctx.event, EVENT_MASK));
    RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, EVENT_MASK));
    return CCU_SUCCESS;
}

CcuResult ExecuteWrite(TransferContext& ctx)
{
    ccu::ccu_buffer stagingBuffer;

    const ccu::local_addr input = MakeLocalAddr(ctx.input, ctx.inputToken);
    const ccu::remote_addr output = MakeRemoteAddr(ctx.remoteOutput, ctx.remoteOutputToken);

    RETURN_IF_CCU_FAIL(ccu::write(ctx.arg->channels[0], output, input, ctx.dataSize, ctx.event, EVENT_MASK));
    RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, EVENT_MASK));
    RETURN_IF_CCU_FAIL(ccu::local_copy(stagingBuffer, input, ctx.dataSize, ctx.event, EVENT_MASK));
    RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, EVENT_MASK));
    RETURN_IF_CCU_FAIL(ccu::write(ctx.arg->channels[0], output, stagingBuffer, ctx.dataSize, ctx.event, EVENT_MASK));
    RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, EVENT_MASK));
    return CCU_SUCCESS;
}

CcuResult ExecuteWriteReduce(TransferContext& ctx)
{
    const ccu::local_addr input = MakeLocalAddr(ctx.input, ctx.inputToken);
    const ccu::local_addr output = MakeLocalAddr(ctx.output, ctx.outputToken);
    const ccu::remote_addr remoteOutput = MakeRemoteAddr(ctx.remoteOutput, ctx.remoteOutputToken);

    RETURN_IF_CCU_FAIL(ccu::local_copy(output, input, ctx.dataSize, ctx.event, EVENT_MASK));
    RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, EVENT_MASK));
    RETURN_IF_CCU_FAIL(ccu::notify_record(ctx.arg->channels[0], CKE_IDX_0, 1U << INIT_SYNC_ID));
    RETURN_IF_CCU_FAIL(ccu::notify_wait(ctx.arg->channels[0], CKE_IDX_0, 1U << INIT_SYNC_ID));
    RETURN_IF_CCU_FAIL(ccu::write_reduce(
        ctx.arg->channels[0], remoteOutput, input, ctx.dataSize, HCCL_DATA_TYPE_FP32, HCCL_REDUCE_SUM, ctx.event,
        EVENT_MASK));
    RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, EVENT_MASK));
    return CCU_SUCCESS;
}

__ccu_host__ void CcuTransferKernel(
    uint64_t sqeArgs1, uint64_t sqeArgs2, uint64_t sqeArgs3, uint64_t sqeArgs4, uint64_t sqeArgs5, ccu_kernel_arg arg)
{
    auto* kernelArg = static_cast<CcuTransferKernelArg*>(arg);
    if (kernelArg == nullptr || kernelArg->rankSize != 2U || kernelArg->channelCount != 1U) {
        return;
    }

    TransferContext ctx{};
    ctx.arg = kernelArg;
    ctx.remoteOutput = ccu::get_res_by_channel<ccu::variable>(kernelArg->channels[0], OUTPUT_XN_ID);
    ctx.remoteOutputToken = ccu::get_res_by_channel<ccu::variable>(kernelArg->channels[0], TOKEN_XN_ID);

    uint32_t argId = 0;
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.input, argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.output, argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.inputToken, argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.outputToken, argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.dataSize, argId++));

    CCU_CHK_VOID_RET(ExchangeRemoteOutput(ctx));

#if SCENARIO_NUM == 1
    CCU_CHK_VOID_RET(ExecuteLocalCopy(ctx));
#elif SCENARIO_NUM == 2
    CCU_CHK_VOID_RET(ExecuteWrite(ctx));
#elif SCENARIO_NUM == 3
    CCU_CHK_VOID_RET(ExecuteWriteReduce(ctx));
#else
#error "SCENARIO_NUM must be 1, 2, or 3"
#endif

    CCU_CHK_VOID_RET(ccu::notify_record(kernelArg->channels[0], CKE_IDX_0, 1U << POST_SYNC_ID));
    CCU_CHK_VOID_RET(ccu::notify_wait(kernelArg->channels[0], CKE_IDX_0, 1U << POST_SYNC_ID));
}

int RunSample(ThreadContext* context)
{
    const uint32_t rank = context->rank;
    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(rank)));

    HcclComm comm{};
    HCCLCHECK(HcclCommInitRootInfo(RANK_SIZE, context->rootInfo, rank, &comm));

    aclrtStream stream{};
    ACLCHECK(aclrtCreateStream(&stream));

    void* inputPtr = nullptr;
    void* outputPtr = nullptr;
    const size_t bufferSize = ELEMENT_COUNT * sizeof(float);
    ACLCHECK(aclrtMalloc(&inputPtr, bufferSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&outputPtr, bufferSize, ACL_MEM_MALLOC_HUGE_ONLY));

    const std::vector<float> input = GetInput(rank);
    const std::vector<float> expected = GetExpected(rank);
    ACLCHECK(aclrtMemcpy(inputPtr, bufferSize, input.data(), bufferSize, ACL_MEMCPY_HOST_TO_DEVICE));
    ACLCHECK(aclrtMemset(outputPtr, bufferSize, 0, bufferSize));
    PrintVector("input", rank, input);

    uint32_t myRank = 0;
    uint32_t rankSize = 0;
    HCCLCHECK(HcclGetRankId(comm, &myRank));
    HCCLCHECK(HcclGetRankSize(comm, &rankSize));
    if (myRank != rank || rankSize != RANK_SIZE) {
        std::cerr << "rank id or rank size is unexpected" << std::endl;
        return HCCL_E_INTERNAL;
    }

    if (rankSize != 2U) {
        return HCCL_E_PARA;
    }

    std::vector<ChannelHandle> channels;
    uint32_t kernelDie = 0;
    bool hasKernelDie = false;
    for (uint32_t remoteRank = 0; remoteRank < rankSize; remoteRank++) {
        if (remoteRank == myRank) {
            continue;
        }

        uint32_t netLayer = 0;
        uint32_t listSize = 0;
        CommLink* linkList = nullptr;
        RETURN_IF_HCCL_FAIL(HcclRankGraphGetLinks(comm, netLayer, myRank, remoteRank, &linkList, &listSize));

        HcclChannelDesc desc;
        RETURN_IF_HCCL_FAIL(HcclChannelDescInit(&desc, 1));
        bool protocolExists = false;
        for (uint32_t i = 0; i < listSize; i++) {
            const CommLink& link = linkList[i];
            if (link.linkAttr.linkProtocol != CommProtocol::COMM_PROTOCOL_UBC_CTP) {
                continue;
            }

            desc.remoteRank = remoteRank;
            desc.notifyNum = CHANNEL_NOTIFY_NUM;
            desc.channelProtocol = link.linkAttr.linkProtocol;
            desc.localEndpoint.protocol = link.srcEndpointDesc.protocol;
            desc.localEndpoint.commAddr = link.srcEndpointDesc.commAddr;
            desc.localEndpoint.loc = link.srcEndpointDesc.loc;
            desc.remoteEndpoint.protocol = link.dstEndpointDesc.protocol;
            desc.remoteEndpoint.commAddr = link.dstEndpointDesc.commAddr;
            desc.remoteEndpoint.loc = link.dstEndpointDesc.loc;

            uint32_t channelDie = 0;
            RETURN_IF_HCCL_FAIL(asccomm_examples::QueryEndpointDie(comm, myRank, link.srcEndpointDesc, channelDie));
            RETURN_IF_HCCL_FAIL(asccomm_examples::MergeKernelDie(channelDie, hasKernelDie, kernelDie));
            protocolExists = true;
            break;
        }
        if (!protocolExists) {
            return HCCL_E_NOT_FOUND;
        }

        channels.resize(1);
        RETURN_IF_HCCL_FAIL(HcclChannelAcquire(comm, CommEngine::COMM_ENGINE_CCU, &desc, 1, &channels[0]));
    }
    if (kernelDie >= CCU_DIE_NUM) {
        return HCCL_E_PARA;
    }

    void* instanceHandle = nullptr;
    RETURN_IF_HCCL_FAIL(asccomm_examples::QueryCcuInstance(comm, instanceHandle));

    const uint64_t dataSize = ELEMENT_COUNT * sizeof(float);
    const uint64_t inputAddr = reinterpret_cast<uint64_t>(inputPtr);
    const uint64_t outputAddr = reinterpret_cast<uint64_t>(outputPtr);
    uint64_t inputToken = 0;
    uint64_t outputToken = 0;
    if (asccomm_ccu_get_mem_token(inputAddr, dataSize, &inputToken) != CCU_SUCCESS ||
        asccomm_ccu_get_mem_token(outputAddr, dataSize, &outputToken) != CCU_SUCCESS) {
        return HCCL_E_INTERNAL;
    }

    auto kernelArg = std::make_shared<CcuTransferKernelArg>();
    kernelArg->rankSize = rankSize;
    kernelArg->rankId = myRank;
    kernelArg->channelCount = static_cast<uint32_t>(channels.size());
    for (uint32_t i = 0; i < channels.size(); i++) {
        kernelArg->channels[i] = channels[i];
    }

    const uint64_t dieMask = 1ULL << kernelDie;
    asccomm_ccu_schd schd = {1, 0, dieMask, 0};
    CcuTransferKernel<<<schd, instanceHandle, stream>>>(
        inputAddr, outputAddr, inputToken, outputToken, dataSize, kernelArg.get());
    ACLCHECK(aclrtSynchronizeStream(stream));

    std::vector<float> output(input.size(), 0.0F);
    ACLCHECK(aclrtMemcpy(output.data(), bufferSize, outputPtr, bufferSize, ACL_MEMCPY_DEVICE_TO_HOST));
    PrintVector("output", rank, output);

    const bool pass = IsEqual(output, expected);
    std::cout << "rank " << rank << " check: " << (pass ? "PASS" : "FAIL") << std::endl;
    if (!pass) {
        return HCCL_E_INTERNAL;
    }

    HCCLCHECK(HcclCommDestroy(comm));
    ACLCHECK(aclrtFree(inputPtr));
    ACLCHECK(aclrtFree(outputPtr));
    ACLCHECK(aclrtDestroyStream(stream));
    ACLCHECK(aclrtResetDevice(static_cast<int32_t>(rank)));
    return HCCL_SUCCESS;
}

} // namespace

int main()
{
    ACLCHECK(aclInit(nullptr));

    uint32_t deviceCount = 0;
    ACLCHECK(aclrtGetDeviceCount(&deviceCount));
    if (deviceCount < RANK_SIZE) {
        std::cerr << "this sample requires at least 2 NPU devices" << std::endl;
        ACLCHECK(aclFinalize());
        return 1;
    }

    ACLCHECK(aclrtSetDevice(0));
    void* rootInfoPtr = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoPtr, sizeof(HcclRootInfo)));
    auto* rootInfo = static_cast<HcclRootInfo*>(rootInfoPtr);
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    std::vector<ThreadContext> contexts(RANK_SIZE);
    std::vector<std::thread> threads;
    for (uint32_t rank = 0; rank < RANK_SIZE; rank++) {
        contexts[rank].rootInfo = rootInfo;
        contexts[rank].rank = rank;
        threads.emplace_back(RunSample, &contexts[rank]);
    }
    for (auto& thread : threads) {
        thread.join();
    }

    ACLCHECK(aclrtFreeHost(rootInfoPtr));
    ACLCHECK(aclFinalize());
    return 0;
}
