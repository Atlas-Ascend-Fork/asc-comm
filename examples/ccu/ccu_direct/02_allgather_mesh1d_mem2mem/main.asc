// 各 rank 先把本 rank 的 slice 写入所有对端，再做一次本地拷贝，最后统一同步收尾。
namespace CcuAgMem2mem {

// 单次运行允许的最大 rank 数
constexpr uint64_t MAX_RANKS = 16;

namespace ccu = ::AscendC::ccu;

// 错误处理宏：HCCL/CCU 调用失败时提前返回对应错误码，避免层层手写 if 判断
#define RETURN_IF_HCCL_FAIL(call)                                \
    do {                                                         \
        const HcclResult result = static_cast<HcclResult>(call); \
        if (result != HCCL_SUCCESS) {                            \
            return result;                                       \
        }                                                        \
    } while (0)

#define RETURN_IF_CCU_FAIL(call)     \
    do {                             \
        CcuResult result = (call);   \
        if (result != CCU_SUCCESS) { \
            return result;           \
        }                            \
    } while (0)

#define CCU_CHK_VOID_RET(call)       \
    do {                             \
        CcuResult result = (call);   \
        if (result != CCU_SUCCESS) { \
            return;                  \
        }                            \
    } while (0)

constexpr uint32_t CCU_MAX_RANK_SIZE = 16;
// 每条 CCU Channel 上协商的 notify 槽位数（前/后同步共用同一槽位 CKE_IDX_0 的不同位）
constexpr uint32_t CHANNEL_NOTIFY_NUM = 3;
constexpr uint32_t CCU_DIE_NUM = 2;

// 本地拷贝的规模常量：ms_interleave 为单个 Loop 的并发分片数，mem_slice 为分片大小 × 单 Loop 分片数得出的单轮搬运量
constexpr uint64_t ccu_ms_interleave = 8;
constexpr uint64_t ccu_ms_size = 4096;
constexpr uint32_t CCU_LOCAL_COPY_MS_PER_LOOP = 8;
constexpr uint32_t CCU_MS_LOCAL_COPY_LOOP_COUNT = 8;

// Kernel 编排上下文：由 Host 侧下发，携带每条对端 Channel 句柄与 rank 信息
struct CcuKernelArgAllGatherMesh1DMem2Mem {
    ChannelHandle channels[CCU_MAX_RANK_SIZE]{};
    uint32_t channelCount{0};
    uint32_t rankSize{0};
    uint32_t rankId{0};
};

// 本地拷贝 LoopGroup 的配置：并发分片数、Loop 数、每分片字节数
struct loop_group_config {
    uint32_t ms_interleave;
    uint32_t loop_count;
    uint64_t mem_slice;
};

// 本地拷贝 LoopGroup 的运行期资源：完成事件与中转用 CcuBuffer 数组
struct LoopGroupResource {
    ccu::array<ccu::event> completed_event{0};
    ccu::array<ccu::ccu_buffer> ccuBuf{0};
};

// CalGoSize 的拆分结果：已搬偏移、Loop 循环参数、尾部并行参数、尾部残余字节数
struct GroupOpSizeVars {
    ccu::variable addr_offset;
    ccu::variable loop_param_;
    ccu::variable parallel_param;
    ccu::variable residual;
};

// 按 Loop 类型缓存的编程实体（执行体、Loop、循环参数），避免每次拷贝重复注册
struct CcuLoopEntity {
    std::unique_ptr<ccu::func> body[2];
    std::unique_ptr<ccu::loop> loops[2];
    ccu::variable loop_param_[2];
};

// Kernel 侧运行期状态：输入/输出/token 变量、卡间偏移、分片大小、切分参数与本地拷贝资源
struct AllGatherMesh1DMem2MemContext {
    const CcuKernelArgAllGatherMesh1DMem2Mem* arg;

    ccu::variable input;
    std::vector<ccu::variable> output;
    std::vector<ccu::variable> token;
    ccu::variable inputSliceStride;
    ccu::variable outputSliceStride;
    ccu::variable chunkSize;
    std::vector<ccu::event> events;

    GroupOpSizeVars goSize;
    loop_group_config moConfig;
    LoopGroupResource moRes;
    bool resourceAllocated = false;

    std::map<std::string, CcuLoopEntity> loopMap;

    void CreateLoopEntity(const std::string& loopStr) { loopMap.emplace(loopStr, CcuLoopEntity()); }

    bool IsLoopEntityRegistered(const std::string& loopStr) const { return loopMap.count(loopStr) != 0; }
};

// 命令行选项：参与的 Device 列表、每 rank 元素数、输入/输出目录
struct Options {
    std::vector<uint32_t> devices{0, 1};
    uint64_t count_{256};
    std::string inputDir{"./input"};
    std::string outputDir{"./output"};
};

// 校验并计算输入/输出缓冲字节数：输入为 count_ 个 float，输出为各 rank 输入拼接后的总大小
static bool CalculateBufferSizes(uint64_t count_, uint32_t rankSize, uint64_t& inputBytes, uint64_t& outputBytes)
{
    inputBytes = 0;
    outputBytes = 0;
    if (rankSize == 0 || count_ > std::numeric_limits<uint64_t>::max() / sizeof(float)) {
        return false;
    }
    inputBytes = count_ * sizeof(float);
    if (inputBytes != 0 && rankSize > std::numeric_limits<uint64_t>::max() / inputBytes) {
        inputBytes = 0;
        return false;
    }
    outputBytes = inputBytes * rankSize;
    return outputBytes <= std::numeric_limits<size_t>::max();
}

// 从二进制文件读取本 rank 的输入数据，并校验文件大小与预期一致
static bool ReadFloatData(const std::string& filePath, uint64_t count_, std::vector<float>& data)
{
    if (count_ > std::numeric_limits<size_t>::max() / sizeof(float) ||
        count_ > static_cast<uint64_t>(std::numeric_limits<std::streamsize>::max()) / sizeof(float)) {
        std::cerr << "input data is too large: " << filePath << "\n";
        return false;
    }

    std::ifstream input(filePath, std::ios::binary | std::ios::ate);
    if (!input.is_open()) {
        std::cerr << "failed to open input file: " << filePath << "\n";
        return false;
    }

    const uint64_t expectedBytes = count_ * sizeof(float);
    const std::streampos fileSize = input.tellg();
    if (fileSize < 0 || static_cast<uint64_t>(fileSize) != expectedBytes) {
        std::cerr << "input file size mismatch: " << filePath << ", expected_ " << expectedBytes << " bytes, got "
                  << fileSize << " bytes\n";
        return false;
    }

    input.seekg(0, std::ios::beg);
    data.resize(static_cast<size_t>(count_));
    if (expectedBytes != 0 &&
        !input.read(reinterpret_cast<char*>(data.data()), static_cast<std::streamsize>(expectedBytes))) {
        std::cerr << "failed to read input file: " << filePath << "\n";
        return false;
    }
    return input.good() || input.eof();
}

// 把本 rank 的结果以二进制写入输出文件，供校验脚本比对
static bool WriteFloatData(const std::string& filePath, const std::vector<float>& data)
{
    if (data.size() > static_cast<size_t>(std::numeric_limits<std::streamsize>::max()) / sizeof(float)) {
        std::cerr << "output data is too large: " << filePath << "\n";
        return false;
    }

    std::ofstream output(filePath, std::ios::binary | std::ios::trunc);
    if (!output.is_open()) {
        std::cerr << "failed to open output file: " << filePath << "\n";
        return false;
    }

    const auto bytes = static_cast<std::streamsize>(data.size() * sizeof(float));
    if (bytes != 0) {
        output.write(reinterpret_cast<const char*>(data.data()), bytes);
    }
    if (!output.good()) {
        std::cerr << "failed to write output file: " << filePath << "\n";
        return false;
    }
    return true;
}

// 解析 --devices 命令行参数（逗号分隔的 Device ID 列表）
static std::vector<uint32_t> ParseDevices(const std::string& value)
{
    std::vector<uint32_t> result;
    std::stringstream ss(value);
    std::string item;
    while (std::getline(ss, item, ',')) {
        if (!item.empty()) {
            result.push_back(static_cast<uint32_t>(std::stoul(item)));
        }
    }
    return result;
}

// 生成低 end+1 位全 1 的掩码，用于把多个字段按位宽拼接进同一个 64 位参数
static constexpr uint64_t SetBitsHost(uint16_t end) { return ((uint64_t(1) << (end + 1)) - uint64_t(1)); }

static constexpr uint64_t SetBitsKernel(uint16_t end) { return ((uint64_t(1) << (end + 1)) - uint64_t(1)); }

// 把 Loop 循环参数打包成硬件约定的 64 位格式：高位为上下文 ID，中段为偏移，低位为循环次数
static uint64_t GetLoopParam(uint64_t loop_ctx_id, uint64_t gsa_offset, uint64_t loop_iter_num_)
{
    constexpr uint16_t ctx_id_bit_num = 8;
    constexpr uint16_t ctx_id_shift_bit = 45;
    constexpr uint16_t gsa_bit_num = 32;
    constexpr uint16_t gsa_shift_bit = 13;
    constexpr uint16_t loop_num_bit_num = 13;
    return ((loop_ctx_id & SetBitsKernel(ctx_id_bit_num)) << ctx_id_shift_bit) |
           ((gsa_offset & SetBitsKernel(gsa_bit_num)) << gsa_shift_bit) |
           (loop_iter_num_ & SetBitsKernel(loop_num_bit_num));
}

// 把并行参数打包成 64 位格式：重复次数、当前重复轮次、总轮次，供 LoopGroup 按偏移复制多份 Loop 使用
static uint64_t GetParallelParam(uint64_t repeat_num, uint64_t repeat_loop_index, uint64_t total_loop_num)
{
    constexpr uint16_t repeat_bit_num = 7;
    constexpr uint16_t repeat_num_shift_bit = 55;
    constexpr uint16_t repeat_loop_bit_num = 7;
    constexpr uint16_t repeat_loop_shift_bit = 48;
    constexpr uint16_t total_loop_bit_num = 7;
    constexpr uint16_t total_loop_shift_bit = 41;
    return ((repeat_num & SetBitsKernel(repeat_bit_num)) << repeat_num_shift_bit) |
           ((repeat_loop_index & SetBitsKernel(repeat_loop_bit_num)) << repeat_loop_shift_bit) |
           ((total_loop_num & SetBitsKernel(total_loop_bit_num)) << total_loop_shift_bit);
}

// 把偏移参数打包成 64 位格式：全局偏移、分片偏移、分片内偏移，供 LoopGroup 定位每份 Loop 的搬移地址
static uint64_t GetOffsetParam(uint64_t gsa_offset, uint64_t ms_offset, uint64_t cke_offset)
{
    constexpr uint16_t gsa_bit_num = 32;
    constexpr uint16_t gsa_shift_bit = 21;
    constexpr uint16_t ms_bit_num = 11;
    constexpr uint16_t ms_shift_bit = 10;
    constexpr uint16_t cke_bit_num = 10;
    return ((gsa_offset & SetBitsKernel(gsa_bit_num)) << gsa_shift_bit) |
           ((ms_offset & SetBitsKernel(ms_bit_num)) << ms_shift_bit) | (cke_offset & SetBitsKernel(cke_bit_num));
}

// 单条 Loop 的最大循环次数上限（Host 侧计算切分时用）
static uint64_t GetMaxLoopIterNumHost()
{
    constexpr uint16_t loop_num_bit_num = 12;
    return SetBitsHost(loop_num_bit_num);
}

// Host 侧组装尾块的并行参数：重复次数、当前重复轮次、总轮次按位宽拼接
static uint64_t GetParallelParamHost(uint64_t repeat_num, uint64_t repeat_loop_index, uint64_t total_loop_num)
{
    constexpr uint16_t repeat_bit_num = 7;
    constexpr uint16_t repeat_num_shift_bit = 55;
    constexpr uint16_t repeat_loop_bit_num = 7;
    constexpr uint16_t repeat_loop_shift_bit = 48;
    constexpr uint16_t total_loop_bit_num = 7;
    constexpr uint16_t total_loop_shift_bit = 41;
    return ((repeat_num & SetBitsHost(repeat_bit_num)) << repeat_num_shift_bit) |
           ((repeat_loop_index & SetBitsHost(repeat_loop_bit_num)) << repeat_loop_shift_bit) |
           ((total_loop_num & SetBitsHost(total_loop_bit_num)) << total_loop_shift_bit);
}

// 将总字节数拆为 LoopGroup 调度参数：整轮循环 + 尾部残余。
// 返回 {已搬偏移, 循环轮数, 尾部并行参数, 尾部字节数}。
static std::vector<uint64_t> CalGoSize(uint64_t size, const loop_group_config& config)
{
    const uint64_t loopSize = config.loop_count * config.mem_slice;
    const uint64_t maxSize = loopSize * (GetMaxLoopIterNumHost() + 1);

    uint64_t loop_count = size / loopSize;
    uint64_t sliceCount = (size - loop_count * loopSize) / config.mem_slice;
    uint64_t residual = size - loop_count * loopSize - sliceCount * config.mem_slice;

    if (size == maxSize) {
        loop_count = GetMaxLoopIterNumHost();
        sliceCount = config.loop_count - 1;
        residual = config.mem_slice;
    }

    const uint64_t offset = config.mem_slice * config.loop_count * loop_count;
    uint64_t parallel_param = 0;
    uint64_t tailSize = 0;
    constexpr uint64_t twoLoops = 2;

    if (sliceCount != 0 && residual == 0) {
        parallel_param = GetParallelParamHost(sliceCount - 1, 0, 1);
        tailSize = config.mem_slice;
    } else if (sliceCount == 0 && residual != 0) {
        parallel_param = GetParallelParamHost(0, 0, 1);
        tailSize = residual;
    } else if (sliceCount != 0) {
        parallel_param = GetParallelParamHost(sliceCount - 1, 1, twoLoops);
        tailSize = residual;
    }
    return {offset, loop_count, parallel_param, tailSize};
}

// 把 CCU 接口返回的 CcuResult 归一化为 HCCL 错误码，便于统一用 HCCLCHECK 检查
static HcclResult ConvertCcuToHccl(CcuResult result)
{
    switch (result) {
        case CCU_SUCCESS:
            return HCCL_SUCCESS;
        case CCU_E_PARA:
            return HCCL_E_PARA;
        case CCU_E_PTR:
            return HCCL_E_PTR;
        case CCU_E_INTERNAL:
            return HCCL_E_INTERNAL;
        case CCU_E_NOT_SUPPORT:
            return HCCL_E_NOT_SUPPORT;
        case CCU_E_NOT_FOUND:
            return HCCL_E_NOT_FOUND;
        case CCU_E_UNAVAIL:
            return HCCL_E_UNAVAIL;
        default:
            return HCCL_E_INTERNAL;
    }
}

// 为每个对端 rank 申请一条 CCU Channel：查询 rank 间链路、选取 UB_CTP 协议链路填充描述符，
// 并在 CCU 引擎上完成建链；建链时顺带查询各端点所属 IO Die 并合并出 Kernel 可用的 dieId。
static HcclResult AcquireCcuChannels(
    HcclComm comm, uint32_t rankId, uint32_t rankSize, std::vector<ChannelHandle>& kernelChannels, uint32_t& dieId)
{
    kernelChannels.resize(rankSize - 1);
    dieId = 0;

    uint32_t channelIndex = 0;
    bool hasDieId = false;
    for (uint32_t remoteRank = 0; remoteRank < rankSize; remoteRank++) {
        if (remoteRank == rankId) {
            continue;
        }

        uint32_t netLayer = 0;
        uint32_t listSize = 0;
        CommLink* linkList = nullptr;
        // 查询本 rank 到对端 rank 的链路列表
        RETURN_IF_HCCL_FAIL(HcclRankGraphGetLinks(comm, netLayer, rankId, remoteRank, &linkList, &listSize));

        HcclChannelDesc desc;
        RETURN_IF_HCCL_FAIL(HcclChannelDescInit(&desc, 1));
        bool protocolExists = false;
        for (uint32_t index = 0; index < listSize; index++) {
            const CommLink& link = linkList[index];
            // 只选 UB_CTP 协议链路（CCU 数据面依赖该协议）
            if (link.linkAttr.linkProtocol != CommProtocol::COMM_PROTOCOL_UBC_CTP) {
                continue;
            }

            desc.remoteRank = remoteRank;
            desc.notifyNum = CHANNEL_NOTIFY_NUM;
            desc.channelProtocol = link.linkAttr.linkProtocol;
            desc.localEndpoint.protocol = link.srcEndpointDesc.protocol;
            desc.localEndpoint.commAddr = link.srcEndpointDesc.commAddr;
            desc.localEndpoint.loc = link.srcEndpointDesc.loc;
            desc.remoteEndpoint.protocol = link.dstEndpointDesc.protocol;
            desc.remoteEndpoint.commAddr = link.dstEndpointDesc.commAddr;
            desc.remoteEndpoint.loc = link.dstEndpointDesc.loc;

            // 查询该链路本端端点所属 IO Die，并入本端可用 Die 集合，供 Kernel 调度
            uint32_t channelDieId = 0;
            RETURN_IF_HCCL_FAIL(asccomm_examples::QueryEndpointDie(comm, rankId, link.srcEndpointDesc, channelDieId));
            RETURN_IF_HCCL_FAIL(asccomm_examples::MergeKernelDie(channelDieId, hasDieId, dieId));
            protocolExists = true;
            break;
        }
        if (!protocolExists) {
            return HCCL_E_NOT_FOUND;
        }

        // 在 CCU 引擎上申请 Channel，Kernel 之后通过该句柄读写对端内存
        RETURN_IF_HCCL_FAIL(
            HcclChannelAcquire(comm, CommEngine::COMM_ENGINE_CCU, &desc, 1, &kernelChannels[channelIndex]));
        channelIndex++;
    }

    return HCCL_SUCCESS;
}

// 判断当前 SoC 是否为 Ascend950：CCU 直调仅在其上支持
static bool IsAscend950()
{
    const char* soc = aclrtGetSocName();
    return soc != nullptr && std::string(soc).find("Ascend950") != std::string::npos;
}

static void InitGroupCopyResources(
    AllGatherMesh1DMem2MemContext& ctx, ccu::local_addr* loopSrc, ccu::local_addr* loopDst, ccu::variable* loopLen)
{
    if (!ctx.resourceAllocated) {
        ctx.moConfig.ms_interleave = ccu_ms_interleave;
        ctx.moConfig.loop_count = CCU_MS_LOCAL_COPY_LOOP_COUNT;
        ctx.moConfig.mem_slice = CCU_LOCAL_COPY_MS_PER_LOOP * ccu_ms_size;

        ctx.moRes.completed_event = ccu::array<ccu::event>(ctx.moConfig.loop_count);
        ctx.moRes.ccuBuf = ccu::array<ccu::ccu_buffer>(ctx.moConfig.loop_count * ctx.moConfig.ms_interleave);
        ctx.resourceAllocated = true;
    }

    const std::string loopType = "localcopy";
    if (!ctx.IsLoopEntityRegistered(loopType)) {
        ctx.CreateLoopEntity(loopType);
        auto& entity = ctx.loopMap[loopType];
        for (uint32_t index = 0; index < 2; index++) {
            uint32_t bufBase = index * ctx.moConfig.ms_interleave;
            ccu::event loopEvt = ctx.moRes.completed_event[index];
            // Loop 执行体：本端内存 -> CcuBuffer -> 本端内存，两段搬运间用 event_wait 确认完成
            entity.body[index].reset(new ccu::func([&ctx, index, bufBase, loopEvt, loopSrc, loopDst, loopLen]() {
                ccu::local_copy(ctx.moRes.ccuBuf[bufBase], loopSrc[index], loopLen[index], loopEvt, 1);
                ccu::event_wait(loopEvt, 1);
                ccu::local_copy(loopDst[index], ctx.moRes.ccuBuf[bufBase], loopLen[index], loopEvt, 1);
                ccu::event_wait(loopEvt, 1);
            }));
            entity.loops[index].reset(new ccu::loop(entity.loop_param_[index], *entity.body[index]));
        }
    }
}

// 按 CalGoSize 的切分结果组织本地拷贝：addr_offset 非 0 时先整体循环搬运已切分的部分，
// parallel_param 非 0 时再单独搬运尾块（尾分片 + 尾残余），两部分经 CcuBuffer 中转。
static CcuResult GroupCopy(
    AllGatherMesh1DMem2MemContext& ctx, ccu::local_addr dst_, ccu::local_addr src_, GroupOpSizeVars goSize)
{
    ccu::local_addr loopSrc[2];
    ccu::local_addr loopDst[2];
    ccu::variable loopLen[2];

    InitGroupCopyResources(ctx, loopSrc, loopDst, loopLen);
    auto& loops = ctx.loopMap["localcopy"];

    // 已切分的整块：单个 Loop 循环搬运，地址按分片递增
    CCU_IF(goSize.addr_offset != 0)
    {
        ccu::variable loop_param_;
        loop_param_ = GetLoopParam(0, ctx.moConfig.mem_slice * ctx.moConfig.loop_count, 0);
        loop_param_ += goSize.loop_param_;

        ccu::variable sliceSize;
        sliceSize = ctx.moConfig.mem_slice;

        loopSrc[0].addr = src_.addr;
        loopSrc[0].token = src_.token;
        loopDst[0].addr = dst_.addr;
        loopDst[0].token = dst_.token;
        loopLen[0] = sliceSize;

        loops.loop_param_[0] = loop_param_;
        ccu::variable paraCfg;
        paraCfg = GetParallelParam(ctx.moConfig.loop_count - 1, 0, 1);

        ccu::variable offsetCfg;
        offsetCfg = GetOffsetParam(ctx.moConfig.mem_slice, ctx.moConfig.ms_interleave, 1);
        std::vector<ccu::loop> grpLoops{*loops.loops[0]};
        // 构造 loop_group 即完成提交：LoopGroup 按偏移复制出多份 Loop 并发执行，无独立的提交调用
        ccu::loop_group group(paraCfg, offsetCfg, ctx.moConfig.loop_count, grpLoops);
    }

    // 尾块：loop[0] 搬残余字节，loop[1] 搬一个整分片，二者并行
    CCU_IF(goSize.parallel_param != 0)
    {
        src_.addr += goSize.addr_offset;
        dst_.addr += goSize.addr_offset;

        loopSrc[0].addr = src_.addr;
        loopSrc[0].token = src_.token;
        loopDst[0].addr = dst_.addr;
        loopDst[0].token = dst_.token;
        loopLen[0] = goSize.residual;

        src_.addr += goSize.residual;
        dst_.addr += goSize.residual;

        ccu::variable sliceSize;
        sliceSize = ctx.moConfig.mem_slice;

        loopSrc[1].addr = src_.addr;
        loopSrc[1].token = src_.token;
        loopDst[1].addr = dst_.addr;
        loopDst[1].token = dst_.token;
        loopLen[1] = sliceSize;

        ccu::variable loopCfg0;
        loopCfg0 = GetLoopParam(0, 0, 1);
        ccu::variable loopCfg1;
        loopCfg1 = GetLoopParam(0, 0, 1);
        ccu::variable offsetCfg;
        offsetCfg = GetOffsetParam(ctx.moConfig.mem_slice, ctx.moConfig.ms_interleave, 1);

        loops.loop_param_[0] = loopCfg0;
        loops.loop_param_[1] = loopCfg1;
        std::vector<ccu::loop> grpLoops{*loops.loops[0], *loops.loops[1]};
        // 构造 loop_group 即完成提交：LoopGroup 按偏移复制出多份 Loop 并发执行，无独立的提交调用
        ccu::loop_group group(goSize.parallel_param, offsetCfg, ctx.moConfig.loop_count, grpLoops);
    }

    return CCU_SUCCESS;
}

// AllGather 的同步与事件约定：每 16 个 rank 共用一个 event（BITS_PER_EVENT 位），
// 每个 rank 占用其中一位；同一 notify 槽 CKE_IDX_0 上以不同位区分 output 地址、token 写入与后同步完成。
constexpr uint32_t BITS_PER_EVENT = 16;
constexpr int OUTPUT_XN_ID = 1;
constexpr int TOKEN_XN_ID = 2;
constexpr int CKE_IDX_0 = 0;
constexpr int POST_SYNC_ID = 3;

// Kernel 内资源准备：把各对端 output 地址与 token 绑定到对应 Channel 的 Variable 单元，
// 并按 rank 数分配事件数组
static CcuResult InitResource(AllGatherMesh1DMem2MemContext& ctx)
{
    if (ctx.arg->rankSize < 2 || ctx.arg->rankId >= ctx.arg->rankSize ||
        ctx.arg->channelCount != ctx.arg->rankSize - 1) {
        return CCU_E_PARA;
    }

    ctx.output.resize(ctx.arg->rankSize);
    ctx.token.resize(ctx.arg->rankSize);

    uint32_t channelIdx = 0;
    for (uint32_t peerId = 0; peerId < ctx.arg->rankSize; peerId++) {
        if (peerId != ctx.arg->rankId) {
            ctx.output[peerId] = ccu::get_res_by_channel<ccu::variable>(ctx.arg->channels[channelIdx], OUTPUT_XN_ID);
            ctx.token[peerId] = ccu::get_res_by_channel<ccu::variable>(ctx.arg->channels[channelIdx], TOKEN_XN_ID);
            channelIdx++;
        }
    }

    const uint32_t eventNum = (ctx.arg->rankSize + BITS_PER_EVENT - 1) / BITS_PER_EVENT;
    ctx.events.resize(eventNum);
    return CCU_SUCCESS;
}

// 前同步：本端 output 地址与 token 写入对端并置位对端 notify，
// 再等待对端把其地址与 token 写回本端，避免读到旧值
static void PreSync(AllGatherMesh1DMem2MemContext& ctx)
{
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::write_variable_with_notify(
            ctx.arg->channels[i], ctx.output[ctx.arg->rankId], OUTPUT_XN_ID, CKE_IDX_0, 1U << OUTPUT_XN_ID));
        CCU_CHK_VOID_RET(ccu::write_variable_with_notify(
            ctx.arg->channels[i], ctx.token[ctx.arg->rankId], TOKEN_XN_ID, CKE_IDX_0, 1U << TOKEN_XN_ID));
    }

    // 等对端把 output 地址与 token 都写回本端后才可组装远端地址
    const uint32_t allBits = (1U << OUTPUT_XN_ID) | (1U << TOKEN_XN_ID);
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::notify_wait(ctx.arg->channels[i], CKE_IDX_0, allBits));
    }
}

// 后同步：告知所有对端本 rank 搬运完成，并等所有对端完成，AllGather 才算结束
static void PostSync(AllGatherMesh1DMem2MemContext& ctx)
{
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::notify_record(ctx.arg->channels[i], CKE_IDX_0, 1U << POST_SYNC_ID));
    }
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::notify_wait(ctx.arg->channels[i], CKE_IDX_0, 1U << POST_SYNC_ID));
    }
}

// 提交跨 rank 写任务：把本 rank 分片异步写入其余 rank，mask 位标记搬运完成后置位的 event 标志；
// 本 rank 位用 event_record 补齐（本地拷贝分支不会自动置位）
static CcuResult DoAllGatherWrite(
    AllGatherMesh1DMem2MemContext& ctx, const ccu::local_addr& src_, const std::vector<ccu::remote_addr>& dst_)
{
    uint32_t channelIdx = 0;
    for (uint32_t rankIdx = 0; rankIdx < ctx.arg->rankSize; rankIdx++) {
        const uint32_t eventIdx = rankIdx / BITS_PER_EVENT;
        const uint16_t rankMask = 1U << (rankIdx % BITS_PER_EVENT);
        if (rankIdx == ctx.arg->rankId) {
            RETURN_IF_CCU_FAIL(ccu::event_record(ctx.events[eventIdx], rankMask));
            continue;
        }
        RETURN_IF_CCU_FAIL(ccu::write(
            ctx.arg->channels[channelIdx], dst_[rankIdx], src_, ctx.chunkSize, ctx.events[eventIdx], rankMask));
        channelIdx++;
    }
    return CCU_SUCCESS;
}

// 等待所有搬运分支完成：逐个 event 等待其覆盖的 rank 位全部置位
static CcuResult DoAllGatherWait(AllGatherMesh1DMem2MemContext& ctx)
{
    const uint32_t eventNum = static_cast<uint32_t>(ctx.events.size());
    for (uint32_t eventIdx = 0; eventIdx < eventNum; eventIdx++) {
        const uint32_t remainingRanks = ctx.arg->rankSize - eventIdx * BITS_PER_EVENT;
        const uint32_t bitCount = std::min<uint32_t>(remainingRanks, BITS_PER_EVENT);
        const uint16_t eventMask = bitCount == BITS_PER_EVENT ? static_cast<uint16_t>(UINT16_MAX) :
                                                                static_cast<uint16_t>((1U << bitCount) - 1);
        RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.events[eventIdx], eventMask));
    }
    return CCU_SUCCESS;
}

// AllGather 执行：组装源/目的地址后，先向其余 rank 写本 rank 分片，再做本 rank 分片的本地拷贝，最后统一等待
static CcuResult DoAllGather(AllGatherMesh1DMem2MemContext& ctx)
{
    // 源地址：本 rank 输入缓冲中偏移 rankId 个 stride 的位置（本 rank 要发送的分片）
    ccu::local_addr src_;
    src_.addr = ctx.input;
    for (uint32_t i = 0; i < ctx.arg->rankId; i++) {
        src_.addr += ctx.inputSliceStride;
    }
    src_.token = ctx.token[ctx.arg->rankId];

    // 本地目的地址：本 rank 输出缓冲中属于本 rank 的那一段，直接取本端变量
    ccu::local_addr localDst;
    localDst.addr = ctx.output[ctx.arg->rankId];
    for (uint32_t i = 0; i < ctx.arg->rankId; i++) {
        localDst.addr += ctx.outputSliceStride;
    }
    localDst.token = ctx.token[ctx.arg->rankId];

    // 远端目的地址：由前同步换来的对端 output 地址、token 加同一卡间偏移构成
    std::vector<ccu::remote_addr> dst_(ctx.arg->rankSize);
    for (uint32_t rankIdx = 0; rankIdx < ctx.arg->rankSize; rankIdx++) {
        if (rankIdx == ctx.arg->rankId) {
            continue;
        }
        dst_[rankIdx].addr = ctx.output[rankIdx];
        for (uint32_t i = 0; i < ctx.arg->rankId; i++) {
            dst_[rankIdx].addr += ctx.outputSliceStride;
        }
        dst_[rankIdx].token = ctx.token[rankIdx];
    }

    RETURN_IF_CCU_FAIL(DoAllGatherWrite(ctx, src_, dst_));
    RETURN_IF_CCU_FAIL(GroupCopy(ctx, localDst, src_, ctx.goSize));
    RETURN_IF_CCU_FAIL(DoAllGatherWait(ctx));
    return CCU_SUCCESS;
}

// Host 侧 CCU Kernel：通过 SQE 下发 CCU 编排指令。
// 编排三阶段：前同步互换地址 -> 执行 AllGather -> 后同步确认完成。
__ccu_host__ void CcuAllGatherMesh1DMem2MemKernel(
    uint64_t sqeArgs1, uint64_t sqeArgs2, uint64_t sqeArgs3, uint64_t sqeArgs4, uint64_t sqeArgs5, uint64_t sqeArgs6,
    uint64_t sqeArgs7, uint64_t sqeArgs8, uint64_t sqeArgs9, uint64_t sqeArgs10, ccu_kernel_arg arg)
{
    auto* kernelArg = static_cast<CcuKernelArgAllGatherMesh1DMem2Mem*>(arg);
    AllGatherMesh1DMem2MemContext ctx;
    ctx.arg = kernelArg;

    // 绑定各对端 Variable 单元并分配事件数组
    CCU_CHK_VOID_RET(InitResource(ctx));

    // 按 SQE 声明顺序加载任务参数，load_arg 必须在程序最开始时调用
    uint32_t argId = 0;
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.input, argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.output[ctx.arg->rankId], argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.token[ctx.arg->rankId], argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.inputSliceStride, argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.outputSliceStride, argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.chunkSize, argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.goSize.addr_offset, argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.goSize.loop_param_, argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.goSize.parallel_param, argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.goSize.residual, argId++));

    PreSync(ctx);
    CCU_IF(ctx.chunkSize != 0) { CCU_CHK_VOID_RET(DoAllGather(ctx)); }
    PostSync(ctx);
}

// 通信入口：完成资源申请与参数准备后，通过 <<<>>> 把 AllGather 任务直调下发到 Stream
static HcclResult AllGatherMesh1D(
    void* sendBuf, void* recvBuf, uint64_t count_, uint32_t rankId, uint32_t rankSize, HcclComm comm,
    aclrtStream stream)
{
    if (comm == nullptr || sendBuf == nullptr || recvBuf == nullptr || stream == nullptr) {
        return HCCL_E_PTR;
    }
    if (rankSize == 0 || rankSize > MAX_RANKS) {
        return HCCL_E_PARA;
    }
    if (!IsAscend950()) {
        return HCCL_E_NOT_SUPPORT;
    }
    if (count_ == 0) {
        return HCCL_SUCCESS;
    }

    const uint64_t dataSize = count_ * sizeof(float);
    // 单 rank 场景无需跨卡通信，直接在 CCU 线程上做一次本地拷贝即可
    if (rankSize == 1) {
        ThreadHandle thread;
        uint32_t notifyNumOnMainThread = 0;
        RETURN_IF_HCCL_FAIL(
            HcclThreadAcquireWithStream(comm, CommEngine::COMM_ENGINE_CCU, stream, notifyNumOnMainThread, &thread));
        return static_cast<HcclResult>(HcommLocalCopyOnThread(thread, recvBuf, sendBuf, dataSize));
    }

    // 申请对端 Channel 并确定本端所在 IO Die，Kernel 调度仅允许使用该 Die
    std::vector<ChannelHandle> kernelChannels;
    uint32_t dieId = 0;
    RETURN_IF_HCCL_FAIL(AcquireCcuChannels(comm, rankId, rankSize, kernelChannels, dieId));
    if (dieId >= CCU_DIE_NUM) {
        return HCCL_E_PARA;
    }

    // 查询通信域绑定的 CCU 实例：Kernel 翻译出的指令空间、寄存器、片上缓存都挂载在其上
    void* insHandle{};
    RETURN_IF_HCCL_FAIL(asccomm_examples::QueryCcuInstance(comm, insHandle));

    // CCU 硬件不直接用虚拟地址，须把 (虚拟地址, 大小) 换成驱动颁发的 64 位内存 token
    uint64_t token = 0;
    RETURN_IF_HCCL_FAIL(
        ConvertCcuToHccl(asccomm_ccu_get_mem_token(reinterpret_cast<uint64_t>(sendBuf), dataSize, &token)));

    // 本地拷贝的切分配置：确定单轮搬运规模后，算出 Kernel 侧要用的切分参数
    loop_group_config config{};
    config.ms_interleave = ccu_ms_interleave;
    config.loop_count = CCU_MS_LOCAL_COPY_LOOP_COUNT;
    config.mem_slice = ccu_ms_size * CCU_LOCAL_COPY_MS_PER_LOOP;
    const std::vector<uint64_t> goSize = CalGoSize(dataSize, config);

    // Kernel 编排上下文：随 Kernel 注册一次性下发，携带 Channel 句柄与 rank 信息
    auto kernelArg = std::make_shared<CcuKernelArgAllGatherMesh1DMem2Mem>();
    kernelArg->rankSize = rankSize;
    kernelArg->rankId = rankId;
    kernelArg->channelCount = static_cast<uint32_t>(kernelChannels.size());
    for (uint32_t i = 0; i < kernelChannels.size(); ++i) {
        kernelArg->channels[i] = kernelChannels[i];
    }

    // 直调下发：单 mission，限定本端所在 IO Die，dieMask 决定任务投递到哪个 CCU；
    // 后面 10 个参数与 Kernel 的 SQE 一一对应
    const uint64_t dieMask = 1ULL << dieId;
    asccomm_ccu_schd schd = {1, 0, dieMask, 0};
    CcuAllGatherMesh1DMem2MemKernel<<<schd, insHandle, stream>>>(
        reinterpret_cast<uint64_t>(sendBuf), reinterpret_cast<uint64_t>(recvBuf), token, 0, dataSize, dataSize,
        goSize[0], goSize[1], goSize[2], goSize[3], kernelArg.get());

    return HCCL_SUCCESS;
}

// 单个 rank 的完整流程：建通信域与任务流、准备输入、下发 AllGather、同步后回读并写出结果
static int RunRank(
    HcclRootInfo* rootInfo, uint32_t rankId, uint32_t rankSize, uint32_t device, uint64_t count_,
    const std::string& inputDir, const std::string& outputDir)
{
    int ret = 1;
    HcclComm comm = nullptr;
    aclrtStream stream = nullptr;
    void* input = nullptr;
    void* output = nullptr;

    if (aclrtSetDevice(static_cast<int32_t>(device)) != ACL_SUCCESS) {
        return 1;
    }

    if (HcclCommInitRootInfo(rankSize, rootInfo, rankId, &comm) != HCCL_SUCCESS) {
        goto cleanup;
    }

    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        goto cleanup;
    }

    {
        uint64_t inputBytes = 0;
        uint64_t outputBytes = 0;
        if (!CalculateBufferSizes(count_, rankSize, inputBytes, outputBytes)) {
            std::cerr << "count_ too large for rankSize " << rankSize << "\n";
            goto cleanup;
        }
        // 申请 Device 内存；count_ 为 0 时仍保留最小分配避免空指针
        const uint64_t inputAlloc = std::max<uint64_t>(inputBytes, sizeof(float));
        const uint64_t outputAlloc = std::max<uint64_t>(outputBytes, sizeof(float));
        if (aclrtMalloc(&input, inputAlloc, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
            goto cleanup;
        }
        if (aclrtMalloc(&output, outputAlloc, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
            goto cleanup;
        }

        // 从文件读入本 rank 输入并拷到 Device，输出缓冲清零
        std::vector<float> hostInput;
        const std::string inputPath = inputDir + "/input_rank_" + std::to_string(rankId) + ".bin";
        if (!ReadFloatData(inputPath, count_, hostInput)) {
            goto cleanup;
        }
        if (count_ != 0 &&
            aclrtMemcpy(input, inputBytes, hostInput.data(), inputBytes, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
            goto cleanup;
        }
        if (aclrtMemset(output, outputAlloc, 0, outputAlloc) != ACL_SUCCESS) {
            goto cleanup;
        }

        // 下发 AllGather 并阻塞等待任务流完成
        if (AllGatherMesh1D(input, output, count_, rankId, rankSize, comm, stream) != HCCL_SUCCESS) {
            std::cerr << "rank " << rankId << " AllGatherMesh1D failed\n";
            goto cleanup;
        }
        std::cout << "rank " << rankId << ": launched, waiting for stream" << std::endl;
        if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
            std::cerr << "rank " << rankId << " stream sync failed\n";
            goto cleanup;
        }
        std::cout << "rank " << rankId << ": stream completed" << std::endl;

        // 回读 Device 结果并打印前若干元素，最终写出到输出文件
        std::vector<float> result(count_ * rankSize);
        if (!result.empty() &&
            aclrtMemcpy(result.data(), outputBytes, output, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
            goto cleanup;
        }

        constexpr uint64_t dumpCount = 16;
        std::ostringstream os;
        os << std::setprecision(9);
        os << "rank " << rankId << " input : [";
        for (uint64_t i = 0; i < count_ && i < dumpCount; ++i) {
            os << " " << hostInput[i];
        }
        if (count_ > dumpCount) {
            os << " ...(" << count_ << ")";
        }
        os << " ]\n";
        os << "rank " << rankId << " output: [";
        for (uint64_t i = 0; i < result.size() && i < dumpCount; ++i) {
            os << " " << result[i];
        }
        if (result.size() > dumpCount) {
            os << " ...(" << result.size() << ")";
        }
        os << " ]";
        std::cout << os.str() << std::endl;

        const std::string outputPath = outputDir + "/output_rank_" + std::to_string(rankId) + ".bin";
        if (!WriteFloatData(outputPath, result)) {
            goto cleanup;
        }
        std::cout << "rank " << rankId << ": output saved to " << outputPath << "\n";
        ret = 0;
    }

cleanup:
    if (output) {
        (void)aclrtFree(output);
    }
    if (input) {
        (void)aclrtFree(input);
    }
    if (stream) {
        (void)aclrtDestroyStream(stream);
    }
    if (comm) {
        (void)HcclCommDestroy(comm);
    }
    (void)aclrtResetDevice(static_cast<int32_t>(device));
    return ret;
}

// 解析命令行参数，非法参数抛 usage（由 run 捕获打印）
static Options ParseOptions(int argc, char** argv)
{
    Options options;
    for (int i = 1; i < argc; ++i) {
        const std::string arg(argv[i]);
        if (arg == "--devices" && i + 1 < argc) {
            options.devices = ParseDevices(argv[++i]);
        } else if (arg == "--count" && i + 1 < argc) {
            options.count_ = std::stoull(argv[++i]);
        } else if (arg == "--input-dir" && i + 1 < argc) {
            options.inputDir = argv[++i];
        } else if (arg == "--output-dir" && i + 1 < argc) {
            options.outputDir = argv[++i];
        } else {
            throw std::invalid_argument("usage: ccu_allgather_mesh1d_mem2mem [--devices 0,1] "
                                        "[--count 256] [--input-dir ./input] "
                                        "[--output-dir ./output]");
        }
    }
    return options;
}

// 程序主流程：校验参数、生成 Root 信息，为每个 rank 起一个线程并发执行
static int run(int argc, char** argv)
{
    Options options;
    try {
        options = ParseOptions(argc, argv);
    } catch (const std::exception& e) {
        std::cerr << e.what() << "\n";
        return 2;
    }
    if (options.devices.empty() || options.devices.size() > MAX_RANKS) {
        std::cerr << "rank count must be in [1, " << MAX_RANKS << "]\n";
        return 1;
    }
    const std::set<uint32_t> uniqueDevices(options.devices.begin(), options.devices.end());
    if (uniqueDevices.size() != options.devices.size()) {
        std::cerr << "device list contains duplicate device IDs\n";
        return 1;
    }

    if (aclInit(nullptr) != ACL_SUCCESS) {
        return 1;
    }
    if (aclrtSetDevice(static_cast<int32_t>(options.devices.front())) != ACL_SUCCESS) {
        (void)aclFinalize();
        return 1;
    }

    void* rootStorage = nullptr;
    if (aclrtMallocHost(&rootStorage, sizeof(HcclRootInfo)) != ACL_SUCCESS) {
        (void)aclFinalize();
        return 1;
    }
    auto* rootInfo = static_cast<HcclRootInfo*>(rootStorage);
    if (HcclGetRootInfo(rootInfo) != HCCL_SUCCESS) {
        (void)aclrtFreeHost(rootStorage);
        (void)aclFinalize();
        return 1;
    }

    const uint32_t rankSize = static_cast<uint32_t>(options.devices.size());
    std::vector<std::thread> workers;
    std::vector<int> status(rankSize, 1);
    for (uint32_t rank = 0; rank < rankSize; ++rank) {
        workers.emplace_back([&, rank]() {
            status[rank] = RunRank(
                rootInfo, rank, rankSize, options.devices[rank], options.count_, options.inputDir, options.outputDir);
        });
    }
    for (auto& worker : workers) {
        worker.join();
    }

    (void)aclrtFreeHost(rootStorage);
    (void)aclFinalize();
    return std::any_of(status.begin(), status.end(), [](int value) { return value != 0; }) ? 1 : 0;
}

} // namespace CcuAgMem2mem

int main(int argc, char** argv) { return CcuAgMem2mem::run(argc, argv); }
