#include <chrono>
#include <algorithm>
#include <memory>
#include <cstdio>
#include <iostream>
#include <thread>
#include <vector>

#include <acl/acl_rt.h>
#include <hccl/hccl_comm.h>
#include <hccl/hccl_rank_graph.h>

#include <ccu_res.h>
