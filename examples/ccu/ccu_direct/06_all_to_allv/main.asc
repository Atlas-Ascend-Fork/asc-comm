namespace ccu = ::AscendC::ccu;

// 错误处理宏：HCCL/CCU 调用失败时提前返回对应错误码，避免层层手写 if 判断
#define RETURN_IF_HCCL_FAIL(call)                       \
    do {                                                \
        HcclResult ret = static_cast<HcclResult>(call); \
        if (ret != HCCL_SUCCESS) {                      \
            return ret;                                 \
        }                                               \
    } while (0)

#define RETURN_IF_CCU_FAIL(call)  \
    do {                          \
        CcuResult ret = (call);   \
        if (ret != CCU_SUCCESS) { \
            return ret;           \
        }                         \
    } while (0)

#define CCU_CHK_VOID_RET(call)    \
    do {                          \
        CcuResult ret = (call);   \
        if (ret != CCU_SUCCESS) { \
            return;               \
        }                         \
    } while (0)

// 规模上限与每链路 notify 数；最大单次传输 256MB，超出即拒绝
constexpr uint64_t CCU_MAX_RANK_SIZE = 16;
constexpr uint32_t CHANNEL_NOTIFY_NUM = 3;
constexpr uint32_t CCU_DIE_NUM = 2;
constexpr uint64_t MAX_TRANSFER_BYTES = 256ULL * 1024 * 1024;

// 传给 CCU Kernel 的编排上下文：链路句柄、rank 信息、本端收发地址/token，
// 以及按目的 rank 组织的发送字节数、发送偏移、接收偏移
struct CcuKernelArgAllToAllVMesh1D {
    ChannelHandle channels[CCU_MAX_RANK_SIZE]{};
    uint32_t channelCount{0};
    uint64_t rankSize{0};
    uint32_t rankId{0};

    uint64_t inputAddr{0};
    uint64_t outputAddr{0};
    uint64_t inputToken{0};
    uint64_t outputToken{0};
    std::vector<uint64_t> sendBytes;
    std::vector<uint64_t> sendOffsets;
    std::vector<uint64_t> recvOffsets;
};

// Kernel 运行期上下文：把 arg 里的收发地址与偏移登记为 CCU Variable，
// 并保存各对端登记的输出地址与 token
struct AllToAllVMesh1DContext {
    const CcuKernelArgAllToAllVMesh1D* arg;
    ccu::variable input;
    ccu::variable inputToken;
    ccu::variable localOutput;
    ccu::variable localOutputToken;
    std::vector<ccu::variable> remoteOutput;
    std::vector<ccu::variable> remoteOutputToken;
    std::vector<ccu::variable> sendBytes;
    std::vector<ccu::variable> sendOffsets;
    std::vector<ccu::variable> recvOffsets;
    ccu::event event;
};

// 测试程序的错误检查宏：ACLCHECK / HCCLCHECK 失败时打印文件行号与返回码后提前返回
#define ACLCHECK(call)                                                    \
    do {                                                                  \
        auto ret = (call);                                                \
        if (ret != ACL_SUCCESS) {                                         \
            printf("ACL error %s:%d, ret=%d\n", __FILE__, __LINE__, ret); \
            return ret;                                                   \
        }                                                                 \
    } while (0)
#define HCCLCHECK(call)                                                    \
    do {                                                                   \
        auto ret = (call);                                                 \
        if (ret != HCCL_SUCCESS) {                                         \
            printf("HCCL error %s:%d, ret=%d\n", __FILE__, __LINE__, ret); \
            return ret;                                                    \
        }                                                                  \
    } while (0)

// 每个 rank 线程的入参：通信域 Root 信息、本 rank 对应的 Device、参与设备数
struct ThreadContext {
    HcclRootInfo* rootInfo;
    uint32_t device;
    uint32_t devCount;
};

// notify 标识：OUTPUT_XN_ID/TOKEN_XN_ID 用于与对端互换输出地址与 token，POST_SYNC_ID 用于后同步
static constexpr int OUTPUT_XN_ID = 1;
static constexpr int TOKEN_XN_ID = 2;
static constexpr int CKE_IDX_0 = 0;
static constexpr int POST_SYNC_ID = 3;

// 把上下文中的常量（收发地址、token、各 rank 收发偏移）登记为 Kernel 可读的 CCU Variable
static CcuResult InitVariables(AllToAllVMesh1DContext& ctx)
{
    ctx.input = ctx.arg->inputAddr;
    ctx.localOutput = ctx.arg->outputAddr;
    ctx.inputToken = ctx.arg->inputToken;
    ctx.localOutputToken = ctx.arg->outputToken;

    for (uint32_t rankIdx = 0; rankIdx < ctx.arg->rankSize; rankIdx++) {
        ctx.sendBytes[rankIdx] = ctx.arg->sendBytes[rankIdx];
        ctx.sendOffsets[rankIdx] = ctx.arg->sendOffsets[rankIdx];
        ctx.recvOffsets[rankIdx] = ctx.arg->recvOffsets[rankIdx];
    }
    return CCU_SUCCESS;
}

// 与所有对端互换接收区地址与 token：把本端对应接收偏移处的地址告知对端，
// 再等所有对端把它们的地址写回，为后续直接 write 到对端接收区做准备
static CcuResult ExchangeOutput(AllToAllVMesh1DContext& ctx)
{
    uint32_t channelId = 0;
    for (uint32_t peerId = 0; peerId < ctx.arg->rankSize; peerId++) {
        if (peerId == ctx.arg->rankId) {
            continue;
        }

        ccu::variable peerDst;
        peerDst = ctx.localOutput;
        peerDst += ctx.recvOffsets[peerId];
        RETURN_IF_CCU_FAIL(ccu::write_variable_with_notify(
            ctx.arg->channels[channelId], peerDst, OUTPUT_XN_ID, CKE_IDX_0, 1U << OUTPUT_XN_ID));
        RETURN_IF_CCU_FAIL(ccu::write_variable_with_notify(
            ctx.arg->channels[channelId], ctx.localOutputToken, TOKEN_XN_ID, CKE_IDX_0, 1U << TOKEN_XN_ID));
        channelId++;
    }

    const uint32_t allBits = (1U << OUTPUT_XN_ID) | (1U << TOKEN_XN_ID);
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        RETURN_IF_CCU_FAIL(ccu::notify_wait(ctx.arg->channels[i], CKE_IDX_0, allBits));
    }
    return CCU_SUCCESS;
}

// 逐目的 rank 搬运发送数据：本 rank 的数据走本地拷贝，其余走跨 rank write；
// 每段各记一个事件位，最后按全量掩码等待所有搬运完成
static CcuResult ExecuteTransfer(AllToAllVMesh1DContext& ctx)
{
    uint32_t channelId = 0;
    for (uint32_t rankIdx = 0; rankIdx < ctx.arg->rankSize; rankIdx++) {
        const uint16_t mask = 1U << rankIdx;
        ccu::local_addr src;
        src.addr_ = ctx.input;
        src.addr_ += ctx.sendOffsets[rankIdx];
        src.token = ctx.inputToken;

        CCU_IF(ctx.sendBytes[rankIdx] != 0)
        {
            if (rankIdx == ctx.arg->rankId) {
                ccu::local_addr dst;
                dst.addr_ = ctx.localOutput;
                dst.addr_ += ctx.recvOffsets[rankIdx];
                dst.token = ctx.localOutputToken;
                RETURN_IF_CCU_FAIL(ccu::local_copy(dst, src, ctx.sendBytes[rankIdx], ctx.event, mask));
            } else {
                ccu::remote_addr dst;
                dst.addr_ = ctx.remoteOutput[rankIdx];
                dst.token = ctx.remoteOutputToken[rankIdx];
                RETURN_IF_CCU_FAIL(
                    ccu::write(ctx.arg->channels[channelId], dst, src, ctx.sendBytes[rankIdx], ctx.event, mask));
            }
        }
        CCU_IF(ctx.sendBytes[rankIdx] == 0) { RETURN_IF_CCU_FAIL(ccu::event_record(ctx.event, mask)); }
        if (rankIdx != ctx.arg->rankId) {
            channelId++;
        }
    }

    const uint16_t allRanksMask = (1U << ctx.arg->rankSize) - 1;
    RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, allRanksMask));
    return CCU_SUCCESS;
}

// Host 侧 CCU Kernel：通过 SQE 下发 CCU 编排指令。
// 编排为：读取对端输出 Variable -> 登记常量 -> 互换接收地址 -> 逐 rank 搬运 -> 后同步
__ccu_host__ void CcuAllToAllVMesh1DKernel(ccu_kernel_arg arg)
{
    auto* kernelArg = static_cast<CcuKernelArgAllToAllVMesh1D*>(arg);
    if (kernelArg == nullptr || kernelArg->channelCount == 0) {
        return;
    }

    AllToAllVMesh1DContext ctx;
    ctx.arg = kernelArg;
    ctx.remoteOutput.resize(kernelArg->rankSize);
    ctx.remoteOutputToken.resize(kernelArg->rankSize);
    ctx.sendBytes.resize(kernelArg->rankSize);
    ctx.sendOffsets.resize(kernelArg->rankSize);
    ctx.recvOffsets.resize(kernelArg->rankSize);

    uint32_t channelId = 0;
    // 读取各对端通道上登记的接收地址与 token
    for (uint32_t peerId = 0; peerId < kernelArg->rankSize; peerId++) {
        if (peerId != kernelArg->rankId) {
            ctx.remoteOutput[peerId] =
                ccu::get_res_by_channel<ccu::variable>(kernelArg->channels[channelId], OUTPUT_XN_ID);
            ctx.remoteOutputToken[peerId] =
                ccu::get_res_by_channel<ccu::variable>(kernelArg->channels[channelId], TOKEN_XN_ID);
            channelId++;
        }
    }

    // 执行编排：登记常量 -> 互换接收地址 -> 逐 rank 搬运
    CCU_CHK_VOID_RET(InitVariables(ctx));
    CCU_CHK_VOID_RET(ExchangeOutput(ctx));
    CCU_CHK_VOID_RET(ExecuteTransfer(ctx));

    // 后同步：通知所有对端本 rank 已搬完，并等所有对端完成
    for (uint32_t i = 0; i < kernelArg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::notify_record(kernelArg->channels[i], CKE_IDX_0, 1U << POST_SYNC_ID));
    }
    for (uint32_t i = 0; i < kernelArg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::notify_wait(kernelArg->channels[i], CKE_IDX_0, 1U << POST_SYNC_ID));
    }
}

// AllToAllV 通信入口：按 sendCounts/sendDispls/recvCounts/recvDispls 描述的变长收发，
// 完成链路申请与参数准备后，通过 <<<>>> 把任务直调下发到 Stream
static HcclResult HcclAllToAllVCustom(
    void* sendBuf, const uint64_t* sendCounts, const uint64_t* sendDispls, HcclDataType sendType, void* recvBuf,
    const uint64_t* recvCounts, const uint64_t* recvDispls, HcclDataType recvType, HcclComm comm, aclrtStream stream)
{
    if (sendBuf == nullptr || recvBuf == nullptr || sendCounts == nullptr || sendDispls == nullptr ||
        recvCounts == nullptr || recvDispls == nullptr || comm == nullptr || stream == nullptr) {
        return HCCL_E_PTR;
    }
    // 数据类型暂只覆盖 FP32，其余组合直接判为不支持
    if (sendType != HCCL_DATA_TYPE_FP32 || recvType != HCCL_DATA_TYPE_FP32) {
        return HCCL_E_NOT_SUPPORT;
    }

    uint32_t myRank = 0;
    uint32_t rankSize = 0;
    RETURN_IF_HCCL_FAIL(HcclGetRankId(comm, &myRank));
    RETURN_IF_HCCL_FAIL(HcclGetRankSize(comm, &rankSize));
    if (rankSize == 0 || rankSize > CCU_MAX_RANK_SIZE || sendCounts[myRank] != recvCounts[myRank]) {
        return HCCL_E_NOT_SUPPORT;
    }

    // 变长收发的每段长度不一，取所有段"偏移+长度"的最大值作为缓冲区大小
    constexpr uint64_t dataTypeSize = sizeof(float);
    uint64_t sendElements = 0;
    uint64_t recvElements = 0;
    for (uint32_t rankIdx = 0; rankIdx < rankSize; rankIdx++) {
        if (sendCounts[rankIdx] != 0) {
            sendElements = std::max(sendElements, sendDispls[rankIdx] + sendCounts[rankIdx]);
        }
        if (recvCounts[rankIdx] != 0) {
            recvElements = std::max(recvElements, recvDispls[rankIdx] + recvCounts[rankIdx]);
        }
    }
    const uint64_t inputSize = sendElements * dataTypeSize;
    const uint64_t outputSize = recvElements * dataTypeSize;

    // 单 rank 场景无需跨卡通信，直接在 CCU 线程上拷贝一段
    if (rankSize == 1) {
        if (sendCounts[0] != recvCounts[0]) {
            return HCCL_E_PARA;
        }
        if (sendCounts[0] == 0) {
            return HCCL_SUCCESS;
        }
        ThreadHandle thread;
        constexpr uint32_t notifyNumOnMainThread = 0;
        RETURN_IF_HCCL_FAIL(
            HcclThreadAcquireWithStream(comm, CommEngine::COMM_ENGINE_CCU, stream, notifyNumOnMainThread, &thread));
        auto* src = static_cast<char*>(sendBuf) + sendDispls[0] * dataTypeSize;
        auto* dst = static_cast<char*>(recvBuf) + recvDispls[0] * dataTypeSize;
        return static_cast<HcclResult>(HcommLocalCopyOnThread(thread, dst, src, sendCounts[0] * dataTypeSize));
    }

    // 为其余每个 rank 建一条满足 UB_CTP 协议的链路，并收敛到同一 IO Die
    std::vector<ChannelHandle> channels;
    uint32_t kernelDie = 0;
    bool hasKernelDie = false;
    for (uint32_t remoteRank = 0; remoteRank < rankSize; remoteRank++) {
        if (remoteRank == myRank) {
            continue;
        }
        uint32_t netLayer = 0;
        uint32_t listSize = 0;
        CommLink* linkList = nullptr;
        RETURN_IF_HCCL_FAIL(HcclRankGraphGetLinks(comm, netLayer, myRank, remoteRank, &linkList, &listSize));
        HcclChannelDesc desc;
        RETURN_IF_HCCL_FAIL(HcclChannelDescInit(&desc, 1));
        bool protocolExists = false;
        for (uint32_t idx = 0; idx < listSize; idx++) {
            const CommLink& link = linkList[idx];
            if (link.linkAttr.linkProtocol != CommProtocol::COMM_PROTOCOL_UBC_CTP) {
                continue;
            }
            desc.remoteRank = remoteRank;
            desc.notifyNum = CHANNEL_NOTIFY_NUM;
            desc.channelProtocol = link.linkAttr.linkProtocol;
            desc.localEndpoint.protocol = link.srcEndpointDesc.protocol;
            desc.localEndpoint.commAddr = link.srcEndpointDesc.commAddr;
            desc.localEndpoint.loc = link.srcEndpointDesc.loc;
            desc.remoteEndpoint.protocol = link.dstEndpointDesc.protocol;
            desc.remoteEndpoint.commAddr = link.dstEndpointDesc.commAddr;
            desc.remoteEndpoint.loc = link.dstEndpointDesc.loc;
            uint32_t channelDie = 0;
            RETURN_IF_HCCL_FAIL(asccomm_examples::QueryEndpointDie(comm, myRank, link.srcEndpointDesc, channelDie));
            RETURN_IF_HCCL_FAIL(asccomm_examples::MergeKernelDie(channelDie, hasKernelDie, kernelDie));
            protocolExists = true;
            break;
        }
        if (!protocolExists) {
            return HCCL_E_NOT_FOUND;
        }
        channels.resize(channels.size() + 1);
        RETURN_IF_HCCL_FAIL(HcclChannelAcquire(comm, CommEngine::COMM_ENGINE_CCU, &desc, 1, &channels.back()));
    }
    if (kernelDie >= CCU_DIE_NUM) {
        return HCCL_E_PARA;
    }

    // 查询通信域绑定的 CCU 实例：Kernel 翻译出的指令空间、寄存器、片上缓存都挂载在其上
    void* instanceHandle = nullptr;
    RETURN_IF_HCCL_FAIL(asccomm_examples::QueryCcuInstance(comm, instanceHandle));

    // CCU 硬件不直接用虚拟地址，须把收发缓冲换成驱动颁发的 64 位内存 token
    const uint64_t inputAddr = reinterpret_cast<uint64_t>(sendBuf);
    const uint64_t outputAddr = reinterpret_cast<uint64_t>(recvBuf);
    uint64_t inputToken = 0;
    uint64_t outputToken = 0;
    if ((inputSize != 0 && asccomm_ccu_get_mem_token(inputAddr, inputSize, &inputToken) != CCU_SUCCESS) ||
        (outputSize != 0 && asccomm_ccu_get_mem_token(outputAddr, outputSize, &outputToken) != CCU_SUCCESS)) {
        return HCCL_E_INTERNAL;
    }

    // 组装 Kernel 编排上下文：链路句柄、rank 信息、收发地址/token 及逐 rank 收发偏移
    auto kernelArg = std::make_shared<CcuKernelArgAllToAllVMesh1D>();
    kernelArg->rankSize = rankSize;
    kernelArg->rankId = myRank;
    kernelArg->channelCount = static_cast<uint32_t>(channels.size());
    kernelArg->inputAddr = inputAddr;
    kernelArg->outputAddr = outputAddr;
    kernelArg->inputToken = inputToken;
    kernelArg->outputToken = outputToken;
    kernelArg->sendBytes.resize(rankSize);
    kernelArg->sendOffsets.resize(rankSize);
    kernelArg->recvOffsets.resize(rankSize);
    for (uint32_t i = 0; i < channels.size(); i++) {
        kernelArg->channels[i] = channels[i];
    }
    // 把逐 rank 的发送元素数/偏移换算为字节，并校验单段不超过上限
    for (uint32_t rankIdx = 0; rankIdx < rankSize; rankIdx++) {
        const uint64_t sendBytes = sendCounts[rankIdx] * dataTypeSize;
        if (sendBytes > MAX_TRANSFER_BYTES) {
            return HCCL_E_NOT_SUPPORT;
        }
        kernelArg->sendBytes[rankIdx] = sendBytes;
        kernelArg->sendOffsets[rankIdx] = sendDispls[rankIdx] * dataTypeSize;
        kernelArg->recvOffsets[rankIdx] = recvDispls[rankIdx] * dataTypeSize;
    }

    // 直调下发：单 mission，限定本端所在 IO Die
    const uint64_t dieMask = 1ULL << kernelDie;
    asccomm_ccu_schd schd = {1, 0, dieMask, 0};
    CcuAllToAllVMesh1DKernel<<<schd, instanceHandle, stream>>>(kernelArg.get());

    return HCCL_SUCCESS;
}

// 单 rank 线程：建通信域与任务流、造变长收发数据、下发 AllToAllV、回读并校验结果
static int Sample(void* arg)
{
    auto* ctx = static_cast<ThreadContext*>(arg);
    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(ctx->device)));

    HcclComm comm;
    HCCLCHECK(HcclCommInitRootInfo(ctx->devCount, ctx->rootInfo, ctx->device, &comm));
    aclrtStream stream;
    ACLCHECK(aclrtCreateStream(&stream));

    std::vector<uint64_t> sendCounts(ctx->devCount);
    std::vector<uint64_t> recvCounts(ctx->devCount);
    std::vector<uint64_t> sendDispls(ctx->devCount);
    std::vector<uint64_t> recvDispls(ctx->devCount);
    uint64_t sendTotal = 0;
    uint64_t recvTotal = 0;
    for (uint32_t peer = 0; peer < ctx->devCount; peer++) {
        sendCounts[peer] = ctx->device + peer + 1;
        recvCounts[peer] = peer + ctx->device + 1;
        sendDispls[peer] = sendTotal;
        recvDispls[peer] = recvTotal;
        sendTotal += sendCounts[peer];
        recvTotal += recvCounts[peer];
    }

    void* sendBuf = nullptr;
    void* recvBuf = nullptr;
    const size_t sendSize = sendTotal * sizeof(float);
    const size_t recvSize = recvTotal * sizeof(float);
    ACLCHECK(aclrtMalloc(&sendBuf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&recvBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));

    void* hostBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&hostBuf, sendSize));
    auto* input = static_cast<float*>(hostBuf);
    for (uint32_t dst_ = 0; dst_ < ctx->devCount; dst_++) {
        for (uint64_t i = 0; i < sendCounts[dst_]; i++) {
            input[sendDispls[dst_] + i] = static_cast<float>(ctx->device * 1000 + dst_ * 100 + i);
        }
    }
    ACLCHECK(aclrtMemcpy(sendBuf, sendSize, hostBuf, sendSize, ACL_MEMCPY_HOST_TO_DEVICE));
    ACLCHECK(aclrtFreeHost(hostBuf));

    HCCLCHECK(HcclAllToAllVCustom(
        sendBuf, sendCounts.data(), sendDispls.data(), HCCL_DATA_TYPE_FP32, recvBuf, recvCounts.data(),
        recvDispls.data(), HCCL_DATA_TYPE_FP32, comm, stream));
    ACLCHECK(aclrtSynchronizeStream(stream));

    std::this_thread::sleep_for(std::chrono::seconds(ctx->device));
    void* resultHost = nullptr;
    ACLCHECK(aclrtMallocHost(&resultHost, recvSize));
    ACLCHECK(aclrtMemcpy(resultHost, recvSize, recvBuf, recvSize, ACL_MEMCPY_DEVICE_TO_HOST));
    auto* output = static_cast<float*>(resultHost);
    bool passed = true;
    std::cout << "rankId: " << ctx->device << ", output: [";
    for (uint32_t src_ = 0; src_ < ctx->devCount; src_++) {
        for (uint64_t i = 0; i < recvCounts[src_]; i++) {
            const float expected_ = static_cast<float>(src_ * 1000 + ctx->device * 100 + i);
            const float actual = output[recvDispls[src_] + i];
            std::cout << " " << actual;
            passed = passed && (actual == expected_);
        }
    }
    std::cout << " ]" << std::endl;
    std::cout << "rankId: " << ctx->device << (passed ? " PASS" : " FAIL") << std::endl;

    ACLCHECK(aclrtFreeHost(resultHost));
    HCCLCHECK(HcclCommDestroy(comm));
    ACLCHECK(aclrtFree(sendBuf));
    ACLCHECK(aclrtFree(recvBuf));
    ACLCHECK(aclrtDestroyStream(stream));
    ACLCHECK(aclrtResetDevice(ctx->device));
    return passed ? 0 : 1;
}

// 主流程：初始化 ACL、获取 Root 信息，为每个 Device 起一个线程并发执行 AllToAllV
int main()
{
    ACLCHECK(aclInit(nullptr));
    uint32_t deviceCount = 0;
    ACLCHECK(aclrtGetDeviceCount(&deviceCount));
    std::cout << "Found " << deviceCount << " NPU device(s) available" << std::endl;

    ACLCHECK(aclrtSetDevice(0));
    void* rootInfoBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoBuf, sizeof(HcclRootInfo)));
    auto* rootInfo = static_cast<HcclRootInfo*>(rootInfoBuf);
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    std::vector<std::thread> threads(deviceCount);
    std::vector<ThreadContext> contexts(deviceCount);
    std::vector<int> results(deviceCount, 1);
    for (uint32_t rank = 0; rank < deviceCount; rank++) {
        contexts[rank] = {rootInfo, rank, deviceCount};
        threads[rank] = std::thread([&contexts, &results, rank]() { results[rank] = Sample(&contexts[rank]); });
    }
    for (auto& thread : threads) {
        thread.join();
    }

    ACLCHECK(aclrtFreeHost(rootInfoBuf));
    ACLCHECK(aclFinalize());
    for (int result : results) {
        if (result != 0) {
            return 1;
        }
    }
    return 0;
}
