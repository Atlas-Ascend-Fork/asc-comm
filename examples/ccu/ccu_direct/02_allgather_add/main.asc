#define ACLCHECK(ret)                                                                          \
    do {                                                                                       \
        if (ret != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                        \
        }                                                                                      \
    } while (0)

#define HCCLCHECK(call)                                                                                    \
    do {                                                                                                   \
        auto ret = (call);                                                                                 \
        int retCode = static_cast<int>(ret);                                                               \
        HcclResult hcclRet = static_cast<HcclResult>(ret);                                                 \
        if (retCode >= static_cast<int>(CCU_E_DRV_START) && retCode <= static_cast<int>(CCU_E_RESERVED)) { \
            hcclRet = HCCL_E_INTERNAL;                                                                     \
        }                                                                                                  \
        if (hcclRet != HCCL_SUCCESS) {                                                                     \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, retCode);        \
            return hcclRet;                                                                                \
        }                                                                                                  \
    } while (0)

#define CHK_PTR_NULL(ptr)       \
    do {                        \
        if ((ptr) == nullptr) { \
            return HCCL_E_PTR;  \
        }                       \
    } while (0)

namespace ccu = ::AscendC::ccu;

namespace ops_comm_ag {
#define CCU_CHK_RET(call)                                \
    do {                                                 \
        CcuResult ccuRet = static_cast<CcuResult>(call); \
        if (ccuRet != CCU_SUCCESS) {                     \
            return ccuRet;                               \
        }                                                \
    } while (0)

#define CCU_CHK_VOID_RET(call)                           \
    do {                                                 \
        CcuResult ccuRet = static_cast<CcuResult>(call); \
        if (ccuRet != CCU_SUCCESS) {                     \
            return;                                      \
        }                                                \
    } while (0)

constexpr uint64_t CCU_BUF_INTERLEAVE = 8;
constexpr uint64_t CCU_BUF_SIZE = 4096;
constexpr uint32_t CCU_LOCAL_COPY_BUF_PER_LOOP = 8;
constexpr uint32_t CCU_BUF_LOCAL_COPY_LOOP_COUNT = 8;
constexpr uint64_t CCU_MAX_RANK_SIZE = 16;
constexpr uint32_t CHANNEL_NOTIFY_NUM = 3;
constexpr uint32_t CCU_DIRECT_TASK_ARG_NUM = 10;
constexpr uint32_t EVENT_NUM = 2;
constexpr uint32_t CCU_DIE_NUM = 2;

constexpr uint32_t SIZE_TABLE[HCCL_DATA_TYPE_RESERVED] = {
    sizeof(int8_t),
    sizeof(int16_t),
    sizeof(int32_t),
    2,
    sizeof(float),
    sizeof(int64_t),
    sizeof(uint64_t),
    sizeof(uint8_t),
    sizeof(uint16_t),
    sizeof(uint32_t),
    8,
    2,
    16,
    2,
    1,
    1,
    1,
    1};

struct LoopGroupConfig {
    uint32_t ccuBufInterleave;
    uint32_t loopCount;
    uint64_t ccuBuf;
};

struct LoopGroupResource {
    ccu::array<ccu::event> completedEvent{0};
    ccu::array<ccu::ccu_buffer> ccuBuf{0};
    uint32_t eventCount;
    uint32_t bufCount;
};

struct GroupOpSizeVars {
    ccu::variable addrOffset;
    ccu::variable loopParam;
    ccu::variable parallelParam;
    ccu::variable residual;
};

struct CcuLoopEntity {
    std::unique_ptr<ccu::func> body[2];
    std::unique_ptr<ccu::loop> loops[2];
    ccu::variable loopParam[2];
};

struct CcuKernelArgAllGatherMesh1DMem2Mem {
    ChannelHandle channels[CCU_MAX_RANK_SIZE];
    uint32_t channelCount;
    uint64_t rankSize;
    uint32_t rankId;
    ccu_variable_handle varHandle;
    uint32_t varNum;
    ccu_event_handle eventHandle;
    uint32_t eventNum;
};

struct CcuMappedAddrs {
    uint64_t eventVa[EVENT_NUM];
    uint64_t startVa[CCU_DIRECT_TASK_ARG_NUM];
};

struct AllGatherMesh1DMem2MemContext {
    const CcuKernelArgAllGatherMesh1DMem2Mem* arg;

    ccu::variable input;
    std::vector<ccu::variable> output;
    std::vector<ccu::variable> token;
    ccu::variable currentRankSliceInputOffset;
    ccu::variable currentRankSliceOutputOffset;
    ccu::variable sliceSize;
    ccu::event event;

    GroupOpSizeVars goSize;
    LoopGroupConfig moConfig;
    LoopGroupResource moRes;
    bool resourceAllocated = false;

    std::map<std::string, CcuLoopEntity> loopMap;

    void CreateLoopEntity(std::string loopStr) { loopMap.emplace(loopStr, CcuLoopEntity()); }

    bool IsLoopEntityRegistered(std::string loopStr) { return loopMap.count(loopStr) != 0; }
};

static HcclResult ConvertCcuToHccl(CcuResult ccuResult)
{
    switch (ccuResult) {
        case CCU_SUCCESS:
            return HCCL_SUCCESS;
        case CCU_E_PARA:
            return HCCL_E_PARA;
        case CCU_E_PTR:
            return HCCL_E_PTR;
        case CCU_E_INTERNAL:
            return HCCL_E_INTERNAL;
        case CCU_E_NOT_SUPPORT:
            return HCCL_E_NOT_SUPPORT;
        case CCU_E_NOT_FOUND:
            return HCCL_E_NOT_FOUND;
        case CCU_E_UNAVAIL:
            return HCCL_E_UNAVAIL;
        default:
            return HCCL_E_INTERNAL;
    }
}

static HcclResult AcquireCcuChannels(
    HcclComm comm, uint32_t rankId, uint32_t rankSize, std::vector<ChannelHandle>& kernelChannels, uint32_t& dieId)
{
    kernelChannels.resize(rankSize - 1);
    dieId = 0;

    uint32_t channelIndex = 0;
    for (uint32_t remoteRank = 0; remoteRank < rankSize; remoteRank++) {
        if (remoteRank == rankId) {
            continue;
        }

        uint32_t netLayer = 0;
        uint32_t listSize = 0;
        CommLink* linkList = nullptr;
        HCCLCHECK(HcclRankGraphGetLinks(comm, netLayer, rankId, remoteRank, &linkList, &listSize));

        HcclChannelDesc desc;
        HCCLCHECK(HcclChannelDescInit(&desc, 1));
        CommProtocol protocol = CommProtocol::COMM_PROTOCOL_UBC_CTP;
        bool protocolExists = false;
        for (uint32_t idx = 0; idx < listSize; idx++) {
            CommLink link = linkList[idx];
            if (link.linkAttr.linkProtocol == protocol) {
                desc.remoteRank = remoteRank;
                desc.notifyNum = CHANNEL_NOTIFY_NUM;
                desc.channelProtocol = link.linkAttr.linkProtocol;
                desc.localEndpoint.protocol = link.srcEndpointDesc.protocol;
                desc.localEndpoint.commAddr = link.srcEndpointDesc.commAddr;
                desc.localEndpoint.loc = link.srcEndpointDesc.loc;
                desc.remoteEndpoint.protocol = link.dstEndpointDesc.protocol;
                desc.remoteEndpoint.commAddr = link.dstEndpointDesc.commAddr;
                desc.remoteEndpoint.loc = link.dstEndpointDesc.loc;
                protocolExists = true;
                break;
            }
        }
        if (!protocolExists) {
            return HCCL_E_NOT_FOUND;
        }
        HCCLCHECK(HcclChannelAcquire(comm, CommEngine::COMM_ENGINE_CCU, &desc, 1, &kernelChannels[channelIndex]));
        if (channelIndex == 0) {
            EndpointAttrDieId dieIdValue = 0;
            HCCLCHECK(HcclRankGraphGetEndpointInfo(
                comm, rankId, &desc.localEndpoint, ENDPOINT_ATTR_DIE_ID, sizeof(EndpointAttrDieId), &dieIdValue));
            dieId = dieIdValue;
        }
        channelIndex++;
    }

    return HCCL_SUCCESS;
}

static constexpr uint64_t SetBits(uint16_t end) { return ((uint64_t(1) << (end + 1)) - uint64_t(1)); }

static uint64_t GetMaxLoopIterNum()
{
    constexpr uint16_t loopNumBitNum = 12;
    return SetBits(loopNumBitNum);
}

static uint64_t GetParallelParamForHost(uint64_t repeatNum, uint64_t repeatLoopIndex, uint64_t totalLoopNum)
{
    constexpr uint16_t repeatBitNum = 7;
    constexpr uint16_t repeatNumShiftBit = 55;
    constexpr uint16_t repeatLoopBitNum = 7;
    constexpr uint16_t repeatLoopShiftBit = 48;
    constexpr uint16_t totalLoopBitNum = 7;
    constexpr uint16_t totalLoopShiftBit = 41;
    return ((repeatNum & SetBits(repeatBitNum)) << repeatNumShiftBit) |
           ((repeatLoopIndex & SetBits(repeatLoopBitNum)) << repeatLoopShiftBit) |
           ((totalLoopNum & SetBits(totalLoopBitNum)) << totalLoopShiftBit);
}

static std::vector<uint64_t> CalGoSize(uint64_t size, const LoopGroupConfig& config)
{
    uint64_t loopSize = config.loopCount * config.ccuBuf;
    uint64_t maxSize = loopSize * (GetMaxLoopIterNum() + 1);

    uint64_t m = size / loopSize;
    uint64_t n = (size - m * loopSize) / config.ccuBuf;
    uint64_t p = size - m * loopSize - n * config.ccuBuf;

    if (size == maxSize) {
        m = GetMaxLoopIterNum();
        n = config.loopCount - 1;
        p = config.ccuBuf;
    }

    uint64_t offset = config.ccuBuf * config.loopCount * m;
    uint64_t loopIterNum = m;

    uint64_t loopExtendNum = 0;
    uint64_t tailSize = 0;
    constexpr uint64_t loopNumTwo = 2;

    if (n == 0 && p == 0) {
        loopExtendNum = 0;
        tailSize = 0;
    } else if (n != 0 && p == 0) {
        loopExtendNum = GetParallelParamForHost(n - 1, 0, 1);
        tailSize = config.ccuBuf;
    } else if (n == 0 && p != 0) {
        loopExtendNum = GetParallelParamForHost(0, 0, 1);
        tailSize = p;
    } else {
        loopExtendNum = GetParallelParamForHost(n - 1, 1, loopNumTwo);
        tailSize = p;
    }

    return {offset, loopIterNum, loopExtendNum, tailSize};
}

constexpr int OUTPUT_VAR_ID = 1;
constexpr int TOKEN_VAR_ID = 2;
constexpr int EVENT_IDX_0 = 0;
constexpr int POST_SYNC_ID = 3;

static uint64_t GetLoopParam(uint64_t loopCtxId, uint64_t addrOffset, uint64_t loopIterNum)
{
    constexpr uint16_t ctxIdBitNum = 8;
    constexpr uint16_t ctxIdShiftBit = 45;
    constexpr uint16_t addrBitNum = 32;
    constexpr uint16_t addrShiftBit = 13;
    constexpr uint16_t loopNumBitNum = 13;
    constexpr uint16_t loopNumShiftBit = 0;
    return ((loopCtxId & SetBits(ctxIdBitNum)) << ctxIdShiftBit) |
           ((addrOffset & SetBits(addrBitNum)) << addrShiftBit) |
           ((loopIterNum & SetBits(loopNumBitNum)) << loopNumShiftBit);
}

static uint64_t GetParallelParam(uint64_t repeatNum, uint64_t repeatLoopIndex, uint64_t totalLoopNum)
{
    constexpr uint16_t repeatBitNum = 7;
    constexpr uint16_t repeatNumShiftBit = 55;
    constexpr uint16_t repeatLoopBitNum = 7;
    constexpr uint16_t repeatLoopShiftBit = 48;
    constexpr uint16_t totalLoopBitNum = 7;
    constexpr uint16_t totalLoopShiftBit = 41;
    return ((repeatNum & SetBits(repeatBitNum)) << repeatNumShiftBit) |
           ((repeatLoopIndex & SetBits(repeatLoopBitNum)) << repeatLoopShiftBit) |
           ((totalLoopNum & SetBits(totalLoopBitNum)) << totalLoopShiftBit);
}

static uint64_t GetOffsetParam(uint64_t addrOffset, uint64_t ccuBufOffset, uint64_t eventOffset)
{
    constexpr uint16_t addrBitNum = 32;
    constexpr uint16_t addrShiftBit = 21;
    constexpr uint16_t ccuBufBitNum = 11;
    constexpr uint16_t ccuBufShiftBit = 10;
    constexpr uint16_t eventBitNum = 10;
    constexpr uint16_t eventShiftBit = 0;
    return ((addrOffset & SetBits(addrBitNum)) << addrShiftBit) |
           ((ccuBufOffset & SetBits(ccuBufBitNum)) << ccuBufShiftBit) |
           ((eventOffset & SetBits(eventBitNum)) << eventShiftBit);
}

static void InitGroupCopyResources(
    AllGatherMesh1DMem2MemContext& ctx, ccu::local_addr* loopSrc, ccu::local_addr* loopDst, ccu::variable* loopLen)
{
    if (!ctx.resourceAllocated) {
        ctx.moConfig.ccuBufInterleave = CCU_BUF_INTERLEAVE;
        ctx.moConfig.loopCount = CCU_BUF_LOCAL_COPY_LOOP_COUNT;
        ctx.moConfig.ccuBuf = CCU_LOCAL_COPY_BUF_PER_LOOP * CCU_BUF_SIZE;

        ctx.moRes.eventCount = ctx.moConfig.loopCount;
        ctx.moRes.completedEvent = ccu::array<ccu::event>(ctx.moRes.eventCount);

        ctx.moRes.bufCount = ctx.moConfig.loopCount * ctx.moConfig.ccuBufInterleave;
        ctx.moRes.ccuBuf = ccu::array<ccu::ccu_buffer>(ctx.moRes.bufCount);

        ctx.resourceAllocated = true;
    }

    std::string loopType = "localcopy";
    if (!ctx.IsLoopEntityRegistered(loopType)) {
        ctx.CreateLoopEntity(loopType);
        auto& entity = ctx.loopMap[loopType];
        for (uint32_t index = 0; index < 2; index++) {
            uint32_t bufBase = index * ctx.moConfig.ccuBufInterleave;
            ccu::event loopEvt = ctx.moRes.completedEvent[index];
            entity.body[index].reset(new ccu::func([&ctx, index, bufBase, loopEvt, loopSrc, loopDst, loopLen]() {
                ccu::LocalCopy(ctx.moRes.ccuBuf[bufBase], loopSrc[index], loopLen[index], loopEvt, 1);
                ccu::event_wait(loopEvt, 1);
                ccu::LocalCopy(loopDst[index], ctx.moRes.ccuBuf[bufBase], loopLen[index], loopEvt, 1);
                ccu::event_wait(loopEvt, 1);
            }));
            entity.loops[index].reset(new ccu::loop(entity.loopParam[index], *entity.body[index]));
        }
    }
}

static CcuResult GroupCopy(
    AllGatherMesh1DMem2MemContext& ctx, ccu::local_addr dst, ccu::local_addr src, GroupOpSizeVars goSize)
{
    ccu::local_addr loopSrc[2];
    ccu::local_addr loopDst[2];
    ccu::variable loopLen[2];

    InitGroupCopyResources(ctx, loopSrc, loopDst, loopLen);

    auto& loops = ctx.loopMap["localcopy"];

    CCU_IF(goSize.addrOffset != 0)
    {
        ccu::variable loopParam;
        loopParam = GetLoopParam(0, ctx.moConfig.ccuBuf * ctx.moConfig.loopCount, 0);
        loopParam += goSize.loopParam;

        ccu::variable sliceSize;
        sliceSize = ctx.moConfig.ccuBuf;

        loopSrc[0].addr_ = src.addr_;
        loopSrc[0].token = src.token;
        loopDst[0].addr_ = dst.addr_;
        loopDst[0].token = dst.token;
        loopLen[0] = sliceSize;

        loops.loopParam[0] = loopParam;
        ccu::variable paraCfg;
        paraCfg = GetParallelParam(ctx.moConfig.loopCount - 1, 0, 1);

        ccu::variable offsetCfg;
        offsetCfg = GetOffsetParam(ctx.moConfig.ccuBuf, ctx.moConfig.ccuBufInterleave, 1);
        std::vector<ccu::loop> grpLoops{*loops.loops[0]};
        ccu::loop_group group(paraCfg, offsetCfg, ctx.moConfig.loopCount, grpLoops);
    }

    CCU_IF(goSize.parallelParam != 0)
    {
        src.addr_ += goSize.addrOffset;
        dst.addr_ += goSize.addrOffset;

        loopSrc[0].addr_ = src.addr_;
        loopSrc[0].token = src.token;
        loopDst[0].addr_ = dst.addr_;
        loopDst[0].token = dst.token;
        loopLen[0] = goSize.residual;

        src.addr_ += goSize.residual;
        dst.addr_ += goSize.residual;

        ccu::variable sliceSize;
        sliceSize = ctx.moConfig.ccuBuf;

        loopSrc[1].addr_ = src.addr_;
        loopSrc[1].token = src.token;
        loopDst[1].addr_ = dst.addr_;
        loopDst[1].token = dst.token;
        loopLen[1] = sliceSize;

        ccu::variable loopCfg0;
        loopCfg0 = GetLoopParam(0, 0, 1);
        ccu::variable loopCfg1;
        loopCfg1 = GetLoopParam(0, 0, 1);
        ccu::variable offsetCfg;
        offsetCfg = GetOffsetParam(ctx.moConfig.ccuBuf, ctx.moConfig.ccuBufInterleave, 1);

        loops.loopParam[0] = loopCfg0;
        loops.loopParam[1] = loopCfg1;
        std::vector<ccu::loop> grpLoops{*loops.loops[0], *loops.loops[1]};
        ccu::loop_group group(goSize.parallelParam, offsetCfg, ctx.moConfig.loopCount, grpLoops);
    }

    return CCU_SUCCESS;
}

static CcuResult ExecuteAllGatherTransfer(AllGatherMesh1DMem2MemContext& ctx)
{
    ccu::local_addr src;
    ccu::local_addr localDst;
    std::vector<ccu::remote_addr> dst;

    dst.resize(ctx.arg->rankSize);

    src.addr_ = ctx.input;
    src.addr_ += ctx.currentRankSliceInputOffset;
    src.token = ctx.token[ctx.arg->rankId];

    for (uint32_t rankIdx = 0; rankIdx < ctx.arg->rankSize; rankIdx++) {
        if (rankIdx == ctx.arg->rankId) {
            localDst.addr_ = ctx.output[rankIdx];
            localDst.addr_ += ctx.currentRankSliceOutputOffset;
            localDst.token = ctx.token[rankIdx];
        } else {
            dst[rankIdx].addr_ = ctx.output[rankIdx];
            dst[rankIdx].addr_ += ctx.currentRankSliceOutputOffset;
            dst[rankIdx].token = ctx.token[rankIdx];
        }
    }

    CCU_IF(ctx.sliceSize != 0)
    {
        uint32_t channelId = 0;
        for (uint64_t rankIdx = 0; rankIdx < ctx.arg->rankSize; rankIdx++) {
            const uint16_t mask = 1 << rankIdx;
            if (rankIdx != ctx.arg->rankId) {
                CCU_CHK_RET(
                    ccu::Write(ctx.arg->channels[channelId], dst[rankIdx], src, ctx.sliceSize, ctx.event, mask));
                channelId++;
            }
        }
    }

    CCU_CHK_RET(GroupCopy(ctx, localDst, src, ctx.goSize));
    CCU_CHK_RET(ccu::event_record(ctx.event, 1 << ctx.arg->rankId));

    const uint16_t totalMask = (1 << ctx.arg->rankSize) - 1;
    CCU_CHK_RET(ccu::event_wait(ctx.event, totalMask));

    return CcuResult::CCU_SUCCESS;
}

__ccu_host__ void CcuAllGatherMesh1DMem2MemKernel(ccu_kernel_arg arg)
{
    auto* kernelArg = static_cast<CcuKernelArgAllGatherMesh1DMem2Mem*>(arg);

    AllGatherMesh1DMem2MemContext ctx;
    ctx.arg = kernelArg;

    if (ctx.arg->channelCount == 0) {
        return;
    }

    ctx.output.resize(ctx.arg->rankSize);
    ctx.token.resize(ctx.arg->rankSize);

    uint32_t channelIdx = 0;
    for (uint64_t peerId = 0; peerId < ctx.arg->rankSize; peerId++) {
        if (peerId != ctx.arg->rankId) {
            ctx.output[peerId] = ccu::GetResByChannel<ccu::variable>(ctx.arg->channels[channelIdx], OUTPUT_VAR_ID);
            ctx.token[peerId] = ccu::GetResByChannel<ccu::variable>(ctx.arg->channels[channelIdx], TOKEN_VAR_ID);
            channelIdx++;
        }
    }

    ccu::array<ccu::event> events(ctx.arg->eventHandle, ctx.arg->eventNum);
    ccu::event_wait(events[0]);

    ccu::array<ccu::variable> vars(ctx.arg->varHandle, ctx.arg->varNum);
    ctx.input = vars[0];
    ctx.output[ctx.arg->rankId] = vars[1];
    ctx.token[ctx.arg->rankId] = vars[2];
    ctx.currentRankSliceInputOffset = vars[3];
    ctx.currentRankSliceOutputOffset = vars[4];
    ctx.sliceSize = vars[5];
    ctx.goSize.addrOffset = vars[6];
    ctx.goSize.loopParam = vars[7];
    ctx.goSize.parallelParam = vars[8];
    ctx.goSize.residual = vars[9];

    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::write_variable_with_notify(
            ctx.arg->channels[i], ctx.output[ctx.arg->rankId], OUTPUT_VAR_ID, EVENT_IDX_0, 1 << OUTPUT_VAR_ID));
        CCU_CHK_VOID_RET(ccu::write_variable_with_notify(
            ctx.arg->channels[i], ctx.token[ctx.arg->rankId], TOKEN_VAR_ID, EVENT_IDX_0, 1 << TOKEN_VAR_ID));
    }

    uint32_t allBit = (1 << OUTPUT_VAR_ID) | (1 << TOKEN_VAR_ID);
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::notify_wait(ctx.arg->channels[i], EVENT_IDX_0, allBit));
    }

    CCU_CHK_VOID_RET(ExecuteAllGatherTransfer(ctx));

    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::notify_record(ctx.arg->channels[i], EVENT_IDX_0, 1 << POST_SYNC_ID));
    }
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::notify_wait(ctx.arg->channels[i], EVENT_IDX_0, 1 << POST_SYNC_ID));
    }
    ccu::event_record(events[1]);
}

} // namespace ops_comm_ag

using namespace ops_comm_ag;

template <typename T, uint64_t maxCount>
__global__ __vector__ void vector_add(
    __gm__ void* src, __gm__ void* recvBuf, __gm__ void* dstGm, CcuMappedAddrs mappedAddrs, uint64_t token,
    uint64_t currentRankSliceInputOffset, uint64_t currentRankSliceOutputOffset, uint64_t sliceSize, uint64_t goSize0,
    uint64_t goSize1, uint64_t goSize2, uint64_t goSize3, uint64_t count)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
    srcGlobal.SetGlobalBuffer((__gm__ T*)recvBuf); // 通信后的数据为计算输入数据
    dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<T> srcLocal = ubAllocator.Alloc<T, maxCount>();
    AscendC::LocalTensor<T> dstLocal = ubAllocator.Alloc<T, maxCount>();

    __gm__ uint64_t* taskArgs0 = reinterpret_cast<__gm__ uint64_t*>(mappedAddrs.startVa[0]);
    __gm__ uint64_t* taskArgs1 = reinterpret_cast<__gm__ uint64_t*>(mappedAddrs.startVa[1]);
    __gm__ uint64_t* taskArgs2 = reinterpret_cast<__gm__ uint64_t*>(mappedAddrs.startVa[2]);
    __gm__ uint64_t* taskArgs3 = reinterpret_cast<__gm__ uint64_t*>(mappedAddrs.startVa[3]);
    __gm__ uint64_t* taskArgs4 = reinterpret_cast<__gm__ uint64_t*>(mappedAddrs.startVa[4]);
    __gm__ uint64_t* taskArgs5 = reinterpret_cast<__gm__ uint64_t*>(mappedAddrs.startVa[5]);
    __gm__ uint64_t* taskArgs6 = reinterpret_cast<__gm__ uint64_t*>(mappedAddrs.startVa[6]);
    __gm__ uint64_t* taskArgs7 = reinterpret_cast<__gm__ uint64_t*>(mappedAddrs.startVa[7]);
    __gm__ uint64_t* taskArgs8 = reinterpret_cast<__gm__ uint64_t*>(mappedAddrs.startVa[8]);
    __gm__ uint64_t* taskArgs9 = reinterpret_cast<__gm__ uint64_t*>(mappedAddrs.startVa[9]);

    AscendC::WriteGmBypassDCache<uint64_t>(taskArgs0, reinterpret_cast<uint64_t>(src));
    AscendC::WriteGmBypassDCache<uint64_t>(taskArgs1, reinterpret_cast<uint64_t>(recvBuf));
    AscendC::WriteGmBypassDCache<uint64_t>(taskArgs2, token);
    AscendC::WriteGmBypassDCache<uint64_t>(taskArgs3, currentRankSliceInputOffset);
    AscendC::WriteGmBypassDCache<uint64_t>(taskArgs4, currentRankSliceOutputOffset);
    AscendC::WriteGmBypassDCache<uint64_t>(taskArgs5, sliceSize);
    AscendC::WriteGmBypassDCache<uint64_t>(taskArgs6, goSize0);
    AscendC::WriteGmBypassDCache<uint64_t>(taskArgs7, goSize1);
    AscendC::WriteGmBypassDCache<uint64_t>(taskArgs8, goSize2);
    AscendC::WriteGmBypassDCache<uint64_t>(taskArgs9, goSize3);
    AscendC::DataSyncBarrier<AscendC::MemDsbT::ALL>();

    __gm__ uint64_t* eventAddr0 = reinterpret_cast<__gm__ uint64_t*>(mappedAddrs.eventVa[0]);
    __gm__ uint64_t* eventAddr1 = reinterpret_cast<__gm__ uint64_t*>(mappedAddrs.eventVa[1]);
    AscendC::WriteGmBypassDCache<uint64_t>(eventAddr0, 1);
    AscendC::DataSyncBarrier<AscendC::MemDsbT::ALL>();

    while (1) {
        uint64_t waitEvent = AscendC::ReadGmBypassDCache(eventAddr1);
        AscendC::DataSyncBarrier<AscendC::MemDsbT::ALL>();
        AscendC::Nop<800>();
        if (waitEvent == 1) {
            break;
        }
    }

    AscendC::DataCopy(srcLocal, srcGlobal, count);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    T scalar = 8.0;
    AscendC::Adds(dstLocal, srcLocal, scalar, count);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(dstGlobal, dstLocal, count);
    AscendC::PipeBarrier<PIPE_ALL>();
}

HcclResult AllGatherAddCustom(
    void* computeBuf, void* sendBuf, void* recvBuf, uint64_t sendCount, HcclDataType dataType, HcclComm comm,
    aclrtStream streamAiv, aclrtStream streamCcu)
{
    CHK_PTR_NULL(streamAiv);
    CHK_PTR_NULL(streamCcu);
    CHK_PTR_NULL(comm);
    CHK_PTR_NULL(computeBuf);
    CHK_PTR_NULL(sendBuf);
    CHK_PTR_NULL(recvBuf);

    if (dataType != HCCL_DATA_TYPE_FP32 || sendCount != 256) {
        return HCCL_E_PARA;
    }

    uint32_t rankId = 0;
    uint32_t rankSize = 0;
    HCCLCHECK(HcclGetRankId(comm, &rankId));
    HCCLCHECK(HcclGetRankSize(comm, &rankSize));

    uint32_t perDataSize = SIZE_TABLE[dataType];
    uint64_t inputSize = sendCount * perDataSize;
    if (sendCount == 0) {
        return HCCL_SUCCESS;
    }

    if (rankSize == 1) {
        ThreadHandle thread;
        uint32_t notifyNumOnMainThread = 0;
        uint32_t threadNum = 1;
        // 调整thread获取方法，不绑定主流，一旦绑定会导致stream 串行执行
        HCCLCHECK(HcclThreadAcquire(comm, CommEngine::COMM_ENGINE_CCU, threadNum, notifyNumOnMainThread, &thread));
        HCCLCHECK(static_cast<HcclResult>(HcommLocalCopyOnThread(thread, recvBuf, sendBuf, inputSize)));
        return HCCL_SUCCESS;
    }

    std::vector<ChannelHandle> kernelChannels;
    uint32_t dieId = 0;
    HCCLCHECK(AcquireCcuChannels(comm, rankId, rankSize, kernelChannels, dieId));
    if (dieId >= CCU_DIE_NUM) {
        return HCCL_E_PARA;
    }
    const uint8_t ccuDieId = static_cast<uint8_t>(dieId);
    CcuInsHandle insHandle{};
    HCCLCHECK(asccomm_examples::QueryCcuInstance(comm, insHandle));

    CcuMappedAddrs mappedAddrs{};
    ccu_variable_handle varHandle{};
    HCCLCHECK(ConvertCcuToHccl(asccomm_ccu_variable_alloc(insHandle, ccuDieId, CCU_DIRECT_TASK_ARG_NUM, &varHandle)));
    for (uint32_t i = 0; i < CCU_DIRECT_TASK_ARG_NUM; i++) {
        HCCLCHECK(ConvertCcuToHccl(asccomm_ccu_variable_get_addr(varHandle, i, &mappedAddrs.startVa[i])));
    }

    ccu_event_handle eventHandle{};
    HCCLCHECK(ConvertCcuToHccl(asccomm_ccu_event_alloc(insHandle, ccuDieId, EVENT_NUM, &eventHandle)));
    for (uint32_t i = 0; i < EVENT_NUM; i++) {
        HCCLCHECK(ConvertCcuToHccl(asccomm_ccu_event_get_addr(eventHandle, i, &mappedAddrs.eventVa[i])));
    }

    auto kernelArg = std::make_shared<CcuKernelArgAllGatherMesh1DMem2Mem>();
    kernelArg->rankSize = rankSize;
    kernelArg->rankId = rankId;
    kernelArg->channelCount = static_cast<uint32_t>(kernelChannels.size());
    kernelArg->varHandle = varHandle;
    kernelArg->varNum = CCU_DIRECT_TASK_ARG_NUM;
    kernelArg->eventHandle = eventHandle;
    kernelArg->eventNum = EVENT_NUM;
    for (uint32_t i = 0; i < kernelChannels.size(); ++i) {
        kernelArg->channels[i] = kernelChannels[i];
    }

    uint64_t token = 0;
    HCCLCHECK(ConvertCcuToHccl(asccomm_ccu_get_mem_token(reinterpret_cast<uint64_t>(sendBuf), inputSize, &token)));

    LoopGroupConfig config{};
    config.ccuBufInterleave = CCU_BUF_INTERLEAVE;
    config.loopCount = CCU_BUF_LOCAL_COPY_LOOP_COUNT;
    config.ccuBuf = CCU_BUF_SIZE * CCU_LOCAL_COPY_BUF_PER_LOOP;
    auto goSize = CalGoSize(inputSize, config);

    uint64_t taskArgs[CCU_DIRECT_TASK_ARG_NUM] = {
        reinterpret_cast<uint64_t>(sendBuf),
        reinterpret_cast<uint64_t>(recvBuf),
        token,
        0,
        inputSize * rankId,
        inputSize,
        goSize[0],
        goSize[1],
        goSize[2],
        goSize[3],
    };

    const uint64_t dieMask = 1ULL << dieId;
    asccomm_ccu_schd schd = {1, 0, dieMask, 0};
    CcuAllGatherMesh1DMem2MemKernel<<<schd, insHandle, streamCcu>>>(kernelArg.get());

    const uint64_t recvCount = sendCount * rankSize;
    if (recvCount > sendCount * CCU_MAX_RANK_SIZE) {
        return HCCL_E_PARA;
    }
    vector_add<float, 256 * CCU_MAX_RANK_SIZE><<<1, nullptr, streamAiv>>>(
        sendBuf, recvBuf, computeBuf, mappedAddrs, taskArgs[2], taskArgs[3], taskArgs[4], taskArgs[5], taskArgs[6],
        taskArgs[7], taskArgs[8], taskArgs[9], recvCount);

    return HCCL_SUCCESS;
}

struct ThreadContext {
    HcclRootInfo* rootInfo;
    uint32_t device;
    uint32_t devCount;
};

int Sample(void* arg)
{
    ThreadContext* ctx = (ThreadContext*)arg;
    void* computeBuf = nullptr;
    void* sendBuf = nullptr;
    void* recvBuf = nullptr;
    uint32_t device = ctx->device;
    if (ctx->devCount > CCU_MAX_RANK_SIZE) {
        std::cout << "devCount " << ctx->devCount << " exceeds CCU_MAX_RANK_SIZE " << CCU_MAX_RANK_SIZE << std::endl;
        return HCCL_E_PARA;
    }
    constexpr uint64_t sendCount = 256; // 每个 rank 输入 256 个 FP32 元素
    const uint64_t recvCount = sendCount * ctx->devCount;
    size_t sendSize = sendCount * sizeof(float);
    size_t recvSize = recvCount * sizeof(float);
    // 设置当前线程操作的设备
    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(device)));

    // 初始化集合通信域
    HcclComm hcclComm;
    HCCLCHECK(HcclCommInitRootInfo(ctx->devCount, ctx->rootInfo, device, &hcclComm));

    // 创建任务流
    aclrtStream streamAiv;
    ACLCHECK(aclrtCreateStream(&streamAiv));

    aclrtStream streamCcu;
    ACLCHECK(aclrtCreateStream(&streamCcu));

    // 申请集合通信操作的 Device 内存
    ACLCHECK(aclrtMalloc(&computeBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&sendBuf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&recvBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));

    // 申请 Host 内存用于存放输入数据，并将内容初始化为 Device ID
    void* hostBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&hostBuf, sendSize));
    float* tmpHostBuff = static_cast<float*>(hostBuf);
    for (uint64_t i = 0; i < sendCount; ++i) {
        tmpHostBuff[i] = static_cast<float>(device) + 1;
    }
    std::cout << "rankId: " << device << ", input: [";
    for (uint64_t i = 0; i < sendCount; ++i) {
        std::cout << " " << tmpHostBuff[i];
    }
    std::cout << " ]" << std::endl;

    // 将 Host 侧输入数据拷贝到 Device 侧
    ACLCHECK(aclrtMemcpy(sendBuf, sendSize, hostBuf, sendSize, ACL_MEMCPY_HOST_TO_DEVICE));
    // 释放 Host 侧内存
    ACLCHECK(aclrtFreeHost(hostBuf));

    // 执行 AllGatherAdd，先将通信域内所有 rank 的 sendBuf 按照 rank_id 顺序拼接到 recvBuf，再计算输出到 computeBuf
    HCCLCHECK(AllGatherAddCustom(
        computeBuf, sendBuf, recvBuf, sendCount, HCCL_DATA_TYPE_FP32, hcclComm, streamAiv, streamCcu));

    // 阻塞等待任务流中的集合通信任务执行完成
    ACLCHECK(aclrtSynchronizeStream(streamAiv));
    ACLCHECK(aclrtSynchronizeStream(streamCcu));

    // 将 Device 侧集合通信任务结果拷贝到 Host，并打印结果
    std::this_thread::sleep_for(std::chrono::seconds(ctx->device));
    void* resultBuff;
    ACLCHECK(aclrtMallocHost(&resultBuff, recvSize));
    ACLCHECK(aclrtMemcpy(resultBuff, recvSize, computeBuf, recvSize, ACL_MEMCPY_DEVICE_TO_HOST));
    float* tmpResBuff = static_cast<float*>(resultBuff);
    std::cout << "rankId: " << ctx->device << ", computeBuf: [";
    for (uint32_t i = 0; i < recvCount; ++i) {
        std::cout << " " << tmpResBuff[i];
    }
    std::cout << " ]" << std::endl;

    ACLCHECK(aclrtFreeHost(resultBuff));

    // 释放资源
    HCCLCHECK(HcclCommDestroy(hcclComm)); // 销毁通信域
    if (computeBuf) {
        ACLCHECK(aclrtFree(computeBuf)); // 释放 Device 侧内存
    }
    if (sendBuf) {
        ACLCHECK(aclrtFree(sendBuf)); // 释放 Device 侧内存
    }
    if (recvBuf) {
        ACLCHECK(aclrtFree(recvBuf)); // 释放 Device 侧内存
    }
    ACLCHECK(aclrtDestroyStream(streamCcu)); // 销毁任务流
    ACLCHECK(aclrtDestroyStream(streamAiv)); // 销毁任务流
    ACLCHECK(aclrtResetDevice(device));      // 重置设备
    return 0;
}

int main()
{
    // 设备资源初始化
    ACLCHECK(aclInit(NULL));
    // 查询设备数量
    uint32_t devCount;
    ACLCHECK(aclrtGetDeviceCount(&devCount));
    std::cout << "Found " << devCount << " NPU device(s) available" << std::endl;

    int32_t rootRank = 0;
    ACLCHECK(aclrtSetDevice(rootRank));
    // 生成 Root 节点信息，各线程使用同一份 RootInfo
    void* rootInfoBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoBuf, sizeof(HcclRootInfo)));
    HcclRootInfo* rootInfo = (HcclRootInfo*)rootInfoBuf;
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    // 启动线程执行集合通信操作
    std::vector<std::thread> threads(devCount);
    std::vector<ThreadContext> args(devCount);
    for (uint32_t i = 0; i < devCount; i++) {
        args[i].rootInfo = rootInfo;
        args[i].device = i;
        args[i].devCount = devCount;
        threads[i] = std::thread(Sample, (void*)&args[i]);
    }
    for (uint32_t i = 0; i < devCount; i++) {
        threads[i].join();
    }

    // 释放资源
    ACLCHECK(aclrtFreeHost(rootInfoBuf)); // 释放 Host 内存
    ACLCHECK(aclFinalize());              // 设备去初始化
    return 0;
}
