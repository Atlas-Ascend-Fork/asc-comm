namespace ccu = ::AscendC::ccu;

#define RETURN_IF_HCCL_FAIL(call)                       \
    do {                                                \
        HcclResult ret = static_cast<HcclResult>(call); \
        if (ret != HCCL_SUCCESS) {                      \
            return ret;                                 \
        }                                               \
    } while (0)

#define RETURN_IF_CCU_FAIL(call)  \
    do {                          \
        CcuResult ret = (call);   \
        if (ret != CCU_SUCCESS) { \
            return ret;           \
        }                         \
    } while (0)

#define CCU_CHK_VOID_RET(call)    \
    do {                          \
        CcuResult ret = (call);   \
        if (ret != CCU_SUCCESS) { \
            return;               \
        }                         \
    } while (0)

// CCU 本地拷贝与调度的规模常量：最大 rank 数、Channel notify 槽位数、Die 数等
constexpr uint64_t CCU_MAX_RANK_SIZE = 16;
constexpr uint32_t CHANNEL_NOTIFY_NUM = 3;
constexpr uint32_t CCU_DIE_NUM = 2;

// Host 向 Kernel 传入的 CCU 通信参数：对端 Channel 句柄、rank 数量与本 rankId
struct CcuKernelArgAllReduceMesh1DMem2Mem {
    ChannelHandle channels[CCU_MAX_RANK_SIZE]{};
    uint32_t channelCount{0};
    uint64_t rankSize{0};
    uint32_t rankId{0};
};

// Kernel 侧运行期状态：输入/输出/token 变量、切分大小与完成事件
struct AllReduceMesh1DMem2MemContext {
    const CcuKernelArgAllReduceMesh1DMem2Mem* arg;

    ccu::variable input;
    std::vector<ccu::variable> output;
    std::vector<ccu::variable> token;
    // SC2：各对端经通道登记的输入地址与 token（gather 读取对端输入用）
    std::vector<ccu::variable> remoteInput;
    std::vector<ccu::variable> remoteInputToken;
    ccu::variable sliceSize;
    ccu::event event;
};

#define ACLCHECK(ret)                                                                          \
    do {                                                                                       \
        if (ret != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                        \
        }                                                                                      \
    } while (0)

#define HCCLCHECK(ret)                                                                          \
    do {                                                                                        \
        if (ret != HCCL_SUCCESS) {                                                              \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                         \
        }                                                                                       \
    } while (0)

// 线程上下文：RootInfo、设备信息等
struct ThreadContext {
    HcclRootInfo* rootInfo;
    uint32_t device;
    uint32_t devCount;
};

// 把 CCU 接口返回的 CcuResult 归一化为 HCCL 错误码，便于统一用 HCCLCHECK 检查
static HcclResult ConvertCcuToHccl(CcuResult result)
{
    switch (result) {
        case CCU_SUCCESS:
            return HCCL_SUCCESS;
        case CCU_E_PARA:
            return HCCL_E_PARA;
        case CCU_E_PTR:
            return HCCL_E_PTR;
        case CCU_E_INTERNAL:
            return HCCL_E_INTERNAL;
        case CCU_E_NOT_SUPPORT:
            return HCCL_E_NOT_SUPPORT;
        case CCU_E_NOT_FOUND:
            return HCCL_E_NOT_FOUND;
        case CCU_E_UNAVAIL:
            return HCCL_E_UNAVAIL;
        default:
            return HCCL_E_INTERNAL;
    }
}

// 给每个对端 rank 各申请一条 CCU Channel：查 rank 间链路、挑 UB_CTP 协议链路填描述符，
// 再在 CCU 引擎上建链；第一条建链后顺带查出本端端点所属 IO Die，给 Kernel 调度用。
static HcclResult AcquireCcuChannels(
    HcclComm comm, uint32_t rankId, uint32_t rankSize, std::vector<ChannelHandle>& kernelChannels, uint32_t& dieId)
{
    kernelChannels.resize(rankSize - 1);
    dieId = 0;

    uint32_t channelIndex = 0;
    bool hasDieId = false;
    for (uint32_t remoteRank = 0; remoteRank < rankSize; remoteRank++) {
        if (remoteRank == rankId) {
            continue;
        }

        // 查询本 rank 到对端 rank 的链路列表
        uint32_t netLayer = 0;
        uint32_t listSize = 0;
        CommLink* linkList = nullptr;
        RETURN_IF_HCCL_FAIL(HcclRankGraphGetLinks(comm, netLayer, rankId, remoteRank, &linkList, &listSize));

        HcclChannelDesc desc;
        RETURN_IF_HCCL_FAIL(HcclChannelDescInit(&desc, 1));
        bool protocolExists = false;
        for (uint32_t index = 0; index < listSize; index++) {
            const CommLink& link = linkList[index];
            // 只选 UB_CTP 协议链路（CCU 数据面依赖该协议），notifyNum 为 Channel 上协商的 notify 槽位数
            if (link.linkAttr.linkProtocol != CommProtocol::COMM_PROTOCOL_UBC_CTP) {
                continue;
            }

            desc.remoteRank = remoteRank;
            desc.notifyNum = CHANNEL_NOTIFY_NUM;
            desc.channelProtocol = link.linkAttr.linkProtocol;
            desc.localEndpoint.protocol = link.srcEndpointDesc.protocol;
            desc.localEndpoint.commAddr = link.srcEndpointDesc.commAddr;
            desc.localEndpoint.loc = link.srcEndpointDesc.loc;
            desc.remoteEndpoint.protocol = link.dstEndpointDesc.protocol;
            desc.remoteEndpoint.commAddr = link.dstEndpointDesc.commAddr;
            desc.remoteEndpoint.loc = link.dstEndpointDesc.loc;

            uint32_t channelDieId = 0;
            RETURN_IF_HCCL_FAIL(asccomm_examples::QueryEndpointDie(comm, rankId, link.srcEndpointDesc, channelDieId));
            RETURN_IF_HCCL_FAIL(asccomm_examples::MergeKernelDie(channelDieId, hasDieId, dieId));
            protocolExists = true;
            break;
        }
        if (!protocolExists) {
            return HCCL_E_NOT_FOUND;
        }

        RETURN_IF_HCCL_FAIL(
            HcclChannelAcquire(comm, CommEngine::COMM_ENGINE_CCU, &desc, 1, &kernelChannels[channelIndex]));
        channelIndex++;
    }

    return HCCL_SUCCESS;
}

constexpr int OUTPUT_XN_ID = 1;
constexpr int TOKEN_XN_ID = 2;
constexpr int CKE_IDX_0 = 0;
constexpr int INIT_SYNC_ID = 3;
constexpr int POST_SYNC_ID = 4;
// SC2（gather + local_reduce）交换对端输入地址所用的通道变量槽位与 CKE 掩码位：
// 通道仅预留 4 个变量槽（下标 0-3），槽 1/2 已被 output/token 占用，对端输入地址与
// token 使用空闲槽 0/3；CKE[0] 掩码位 1/2/3/4 已被占用，登记完成信号使用空闲的 5/6 位
constexpr int REMOTE_INPUT_XN_ID = 3;
constexpr int REMOTE_INPUT_TOKEN_XN_ID = 0;
constexpr int REMOTE_INPUT_XN_MASK_BIT = 5;
constexpr int REMOTE_INPUT_TOKEN_MASK_BIT = 6;

// 把本 rank 输入先拷入本端输出，再 write_reduce 到各对端输出并等待完成
static CcuResult ExecuteAllReduceTransfer(AllReduceMesh1DMem2MemContext& ctx)
{
    ccu::local_addr src_;
    ccu::local_addr localDst;
    std::vector<ccu::remote_addr> dst_;

    dst_.resize(ctx.arg->rankSize);

    src_.addr = ctx.input;
    src_.token = ctx.token[ctx.arg->rankId];

    for (uint32_t rankIdx = 0; rankIdx < ctx.arg->rankSize; rankIdx++) {
        if (rankIdx == ctx.arg->rankId) {
            localDst.addr = ctx.output[rankIdx];
            localDst.token = ctx.token[rankIdx];
        } else {
            dst_[rankIdx].addr = ctx.output[rankIdx];
            dst_[rankIdx].token = ctx.token[rankIdx];
        }
    }

    CCU_IF(ctx.sliceSize != 0)
    {
        const uint16_t selfMask = 1U << ctx.arg->rankId;
        RETURN_IF_CCU_FAIL(ccu::local_copy(localDst, src_, ctx.sliceSize, ctx.event, selfMask));
        RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, selfMask));

        for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
            RETURN_IF_CCU_FAIL(ccu::notify_record(ctx.arg->channels[i], CKE_IDX_0, 1U << INIT_SYNC_ID));
        }
        for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
            RETURN_IF_CCU_FAIL(ccu::notify_wait(ctx.arg->channels[i], CKE_IDX_0, 1U << INIT_SYNC_ID));
        }

        uint32_t channelId = 0;
        uint16_t remoteMask = 0;
        for (uint64_t rankIdx = 0; rankIdx < ctx.arg->rankSize; rankIdx++) {
            const uint16_t mask = 1U << rankIdx;
            if (rankIdx != ctx.arg->rankId) {
                RETURN_IF_CCU_FAIL(ccu::write_reduce(
                    ctx.arg->channels[channelId], dst_[rankIdx], src_, ctx.sliceSize, HCCL_DATA_TYPE_FP32,
                    HCCL_REDUCE_SUM, ctx.event, mask));
                remoteMask |= mask;
                channelId++;
            }
        }
        RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, remoteMask));
    }

    return CcuResult::CCU_SUCCESS;
}

// SC2 前同步：仅交换本端输入地址与 token（gather 需要读取对端输入；
// SC2 无远端写，不交换 output 地址），并等待所有对端完成登记
static CcuResult ExchangeRemoteInput(AllReduceMesh1DMem2MemContext& ctx)
{
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        RETURN_IF_CCU_FAIL(ccu::write_variable_with_notify(
            ctx.arg->channels[i], ctx.input, REMOTE_INPUT_XN_ID, CKE_IDX_0, 1U << REMOTE_INPUT_XN_MASK_BIT));
        RETURN_IF_CCU_FAIL(ccu::write_variable_with_notify(
            ctx.arg->channels[i], ctx.token[ctx.arg->rankId], REMOTE_INPUT_TOKEN_XN_ID, CKE_IDX_0,
            1U << REMOTE_INPUT_TOKEN_MASK_BIT));
    }

    const uint32_t allBits = (1U << REMOTE_INPUT_XN_MASK_BIT) | (1U << REMOTE_INPUT_TOKEN_MASK_BIT);
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        RETURN_IF_CCU_FAIL(ccu::notify_wait(ctx.arg->channels[i], CKE_IDX_0, allBits));
    }
    return CcuResult::CCU_SUCCESS;
}

// SC2：gather + local_reduce，独立的"聚合-归约"AllReduce 实现路径（与场景1 的
// write_reduce 散射归约殊途同归，输出同为全 rank 逐元素和）：
//   1. 本端 input 拷入 bufs[rankId]；
//   2. 逐个对端 read（对端片上内存 -> bufs[对端 rankId]），把各 rank 数据搬运到本地；
//   3. local_reduce 的 N 路 ccu_buffer 重载把 bufs[0..N-1] 归约到 bufs[0]；
//   4. bufs[0] 拷回本端 output。
// 约束：ccu_buffer 归约重载支持 2~8 路，单片缓存 4096 字节
static CcuResult ExecuteGatherLocalReduce(AllReduceMesh1DMem2MemContext& ctx)
{
    const uint64_t rankSize = ctx.arg->rankSize;
    if (rankSize < 2U || rankSize > 8U) {
        return CcuResult::CCU_E_NOT_SUPPORT;
    }

    ccu::array<ccu::ccu_buffer> bufs(static_cast<uint32_t>(rankSize));

    // 1) 本端贡献落入 bufs[rankId]
    ccu::local_addr src;
    src.addr = ctx.input;
    src.token = ctx.token[ctx.arg->rankId];
    RETURN_IF_CCU_FAIL(ccu::local_copy(bufs[ctx.arg->rankId], src, ctx.sliceSize, ctx.event, 1U));
    RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, 1U));

    // 2) gather：逐个对端 read（对端片上内存 -> 本端 ccu_buffer）
    uint32_t channelIdx = 0;
    for (uint64_t peerId = 0; peerId < rankSize; peerId++) {
        if (peerId == ctx.arg->rankId) {
            continue;
        }
        ccu::remote_addr remote;
        remote.addr = ctx.remoteInput[peerId];
        remote.token = ctx.remoteInputToken[peerId];
        RETURN_IF_CCU_FAIL(ccu::read(
            ctx.arg->channels[channelIdx], bufs[static_cast<uint32_t>(peerId)], remote, ctx.sliceSize, ctx.event, 1U));
        RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, 1U));
        channelIdx++;
    }

    // 3) N 路 ccu_buffer 归约：bufs[0] = SUM(bufs[0..N-1])，结果落在 bufs[0]
    RETURN_IF_CCU_FAIL(ccu::local_reduce(
        bufs.data(), static_cast<uint32_t>(rankSize), HcclDataType::HCCL_DATA_TYPE_FP32,
        HcclDataType::HCCL_DATA_TYPE_FP32, HcclReduceOp::HCCL_REDUCE_SUM, ctx.sliceSize, ctx.event, 1U));
    RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, 1U));

    // 4) 结果拷回本端 output
    ccu::local_addr dst;
    dst.addr = ctx.output[ctx.arg->rankId];
    dst.token = ctx.token[ctx.arg->rankId];
    RETURN_IF_CCU_FAIL(ccu::local_copy(dst, bufs[0], ctx.sliceSize, ctx.event, 1U));
    RETURN_IF_CCU_FAIL(ccu::event_wait(ctx.event, 1U));

    return CcuResult::CCU_SUCCESS;
}

__ccu_host__ void CcuAllReduceMesh1DMem2MemKernel(
    uint64_t sqeArgs1, uint64_t sqeArgs2, uint64_t sqeArgs3, uint64_t sqeArgs4, ccu_kernel_arg arg)
{
    auto* kernelArg = static_cast<CcuKernelArgAllReduceMesh1DMem2Mem*>(arg);
    AllReduceMesh1DMem2MemContext ctx;
    ctx.arg = kernelArg;

    if (ctx.arg->channelCount == 0) {
        return;
    }

    ctx.output.resize(ctx.arg->rankSize);
    ctx.token.resize(ctx.arg->rankSize);
#if SCENARIO_NUM == 2
    ctx.remoteInput.resize(ctx.arg->rankSize);
    ctx.remoteInputToken.resize(ctx.arg->rankSize);
#endif

    uint32_t channelIdx = 0;
    for (uint64_t peerId = 0; peerId < ctx.arg->rankSize; peerId++) {
        if (peerId != ctx.arg->rankId) {
#if SCENARIO_NUM == 2
            // SC2：读取各对端经通道登记的输入地址与 token（槽 0/3）
            ctx.remoteInput[peerId] =
                ccu::get_res_by_channel<ccu::variable>(ctx.arg->channels[channelIdx], REMOTE_INPUT_XN_ID);
            ctx.remoteInputToken[peerId] =
                ccu::get_res_by_channel<ccu::variable>(ctx.arg->channels[channelIdx], REMOTE_INPUT_TOKEN_XN_ID);
#else
            ctx.output[peerId] = ccu::get_res_by_channel<ccu::variable>(ctx.arg->channels[channelIdx], OUTPUT_XN_ID);
            ctx.token[peerId] = ccu::get_res_by_channel<ccu::variable>(ctx.arg->channels[channelIdx], TOKEN_XN_ID);
#endif
            channelIdx++;
        }
    }

    // 按 SQE 声明顺序加载任务参数，load_arg 必须在程序最开始时调用
    uint32_t argId = 0;
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.input, argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.output[ctx.arg->rankId], argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.token[ctx.arg->rankId], argId++));
    CCU_CHK_VOID_RET(ccu::load_arg(ctx.sliceSize, argId++));

#if SCENARIO_NUM == 2
    // SC2 前同步：仅交换本端输入地址与 token（gather 读取对端输入需要；
    // SC2 无远端写，不交换 output 地址）
    CCU_CHK_VOID_RET(ExchangeRemoteInput(ctx));

    // SC2：gather + local_reduce 的独立"聚合-归约"流程，输出与场景1 相同
    CCU_CHK_VOID_RET(ExecuteGatherLocalReduce(ctx));
#else
    // 前同步：本端 output 地址与 token 写入对端并置位对端 notify，
    // 再等待对端把其地址与 token 写回本端，避免读到旧值
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::write_variable_with_notify(
            ctx.arg->channels[i], ctx.output[ctx.arg->rankId], OUTPUT_XN_ID, CKE_IDX_0, 1U << OUTPUT_XN_ID));
        CCU_CHK_VOID_RET(ccu::write_variable_with_notify(
            ctx.arg->channels[i], ctx.token[ctx.arg->rankId], TOKEN_XN_ID, CKE_IDX_0, 1U << TOKEN_XN_ID));
    }

    const uint32_t allBits = (1U << OUTPUT_XN_ID) | (1U << TOKEN_XN_ID);
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::notify_wait(ctx.arg->channels[i], CKE_IDX_0, allBits));
    }

    CCU_CHK_VOID_RET(ExecuteAllReduceTransfer(ctx));
#endif

    // 后同步：告知所有对端本 rank 搬运完成，并等所有对端完成
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::notify_record(ctx.arg->channels[i], CKE_IDX_0, 1U << POST_SYNC_ID));
    }
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::notify_wait(ctx.arg->channels[i], CKE_IDX_0, 1U << POST_SYNC_ID));
    }
}

static HcclResult HcclAllReduceCustom(
    void* sendBuf, void* recvBuf, uint64_t count_, HcclDataType data_type_, HcclComm comm, aclrtStream stream)
{
    if (comm == nullptr || sendBuf == nullptr || recvBuf == nullptr || stream == nullptr) {
        return HCCL_E_PTR;
    }
    if (data_type_ != HCCL_DATA_TYPE_FP32 || count_ == 0) {
        return count_ == 0 ? HCCL_SUCCESS : HCCL_E_NOT_SUPPORT;
    }

    uint32_t rankId = 0;
    uint32_t rankSize = 0;
    RETURN_IF_HCCL_FAIL(HcclGetRankId(comm, &rankId));
    RETURN_IF_HCCL_FAIL(HcclGetRankSize(comm, &rankSize));
    if (rankSize == 0 || rankSize > CCU_MAX_RANK_SIZE) {
        return HCCL_E_PARA;
    }

    constexpr uint64_t dataTypeSize = sizeof(float);
    const uint64_t dataSize = count_ * dataTypeSize;
    if (rankSize == 1) {
        ThreadHandle thread;
        constexpr uint32_t notifyNumOnMainThread = 0;
        RETURN_IF_HCCL_FAIL(
            HcclThreadAcquireWithStream(comm, CommEngine::COMM_ENGINE_CCU, stream, notifyNumOnMainThread, &thread));
        return static_cast<HcclResult>(HcommLocalCopyOnThread(thread, recvBuf, sendBuf, dataSize));
    }

    std::vector<ChannelHandle> kernelChannels;
    uint32_t dieId = 0;
    RETURN_IF_HCCL_FAIL(AcquireCcuChannels(comm, rankId, rankSize, kernelChannels, dieId));
    if (dieId >= CCU_DIE_NUM) {
        return HCCL_E_PARA;
    }

    void* insHandle{};
    RETURN_IF_HCCL_FAIL(asccomm_examples::QueryCcuInstance(comm, insHandle));

    uint64_t token = 0;
    const uint64_t baseInputAddr = reinterpret_cast<uint64_t>(sendBuf);
    const uint64_t baseOutputAddr = reinterpret_cast<uint64_t>(recvBuf);
    RETURN_IF_HCCL_FAIL(ConvertCcuToHccl(asccomm_ccu_get_mem_token(baseInputAddr, dataSize, &token)));

    constexpr uint64_t ubMaxDataSize = 256ULL * 1024 * 1024;
    const uint64_t maxDataCountPerLoop = ubMaxDataSize / dataTypeSize;
    const uint64_t loopCount = count_ / maxDataCountPerLoop + static_cast<uint64_t>(count_ % maxDataCountPerLoop != 0);
    uint64_t processedDataCount = 0;

    auto kernelArg = std::make_shared<CcuKernelArgAllReduceMesh1DMem2Mem>();
    kernelArg->rankSize = rankSize;
    kernelArg->rankId = rankId;
    kernelArg->channelCount = static_cast<uint32_t>(kernelChannels.size());
    for (uint32_t i = 0; i < kernelChannels.size(); ++i) {
        kernelArg->channels[i] = kernelChannels[i];
    }

    const uint64_t dieMask = 1ULL << dieId;
    asccomm_ccu_schd schd = {1, 0, dieMask, 0};
    for (uint64_t loop = 0; loop < loopCount; loop++) {
        const uint64_t sliceCount = std::min(maxDataCountPerLoop, count_ - loop * maxDataCountPerLoop);
        const uint64_t inputAddr = baseInputAddr + processedDataCount * dataTypeSize;
        const uint64_t outputAddr = baseOutputAddr + processedDataCount * dataTypeSize;
        const uint64_t sliceSize = sliceCount * dataTypeSize;

        CcuAllReduceMesh1DMem2MemKernel<<<schd, insHandle, stream>>>(
            inputAddr, outputAddr, token, sliceSize, kernelArg.get());

        processedDataCount += sliceCount;
    }

    return HCCL_SUCCESS;
}

int Sample(void* arg)
{
    ThreadContext* ctx = (ThreadContext*)arg;
    void* sendBuf = nullptr;
    void* recvBuf = nullptr;
    uint32_t device = ctx->device;
    uint64_t sendCount = ctx->devCount;
    uint64_t recvCount = sendCount;
    size_t sendSize = sendCount * sizeof(float);
    size_t recvSize = recvCount * sizeof(float);
    // 设置当前线程使用的 device
    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(device)));

    // 初始化 HCCL 通信域
    HcclComm hcclComm;
    HCCLCHECK(HcclCommInitRootInfo(ctx->devCount, ctx->rootInfo, device, &hcclComm));

    // 创建任务流
    aclrtStream stream;
    ACLCHECK(aclrtCreateStream(&stream));

    // 申请 Device 侧输入和输出内存
    ACLCHECK(aclrtMalloc(&sendBuf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&recvBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));

    // 申请 Host 内存保存输入数据，并初始化为 [0, 1, ..., sendCount - 1]
    void* hostBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&hostBuf, sendSize));
    float* tmpHostBuff = static_cast<float*>(hostBuf);
    for (uint64_t i = 0; i < sendCount; ++i) {
        tmpHostBuff[i] = static_cast<float>(i + device * sendCount);
    }
    // 各 rank 线程并发打印：整行先拼装成字符串再一次性插入 std::cout（单次插入
    // 具有原子性），避免多次 << 调用在线程间交错导致输出交叉
    std::ostringstream inputOss;
    inputOss << "rankId: " << device << ", input: [";
    for (uint64_t i = 0; i < sendCount; ++i) {
        inputOss << " " << tmpHostBuff[i];
    }
    inputOss << " ]" << std::endl;
    std::cout << inputOss.str();

    // 将 Host 输入数据拷贝到 Device
    ACLCHECK(aclrtMemcpy(sendBuf, sendSize, hostBuf, sendSize, ACL_MEMCPY_HOST_TO_DEVICE));
    // 释放 Host 侧输入内存
    ACLCHECK(aclrtFreeHost(hostBuf));

    // 执行 AllReduce SUM，所有 rank 的 recvBuf 都会得到逐元素求和结果
    HCCLCHECK(HcclAllReduceCustom(sendBuf, recvBuf, sendCount, HCCL_DATA_TYPE_FP32, hcclComm, stream));
    // 等待 stream 中任务执行完成
    ACLCHECK(aclrtSynchronizeStream(stream));

    // 将 Device 侧结果拷贝回 Host，并打印结果
    void* resultBuff;
    ACLCHECK(aclrtMallocHost(&resultBuff, recvSize));
    ACLCHECK(aclrtMemcpy(resultBuff, recvSize, recvBuf, recvSize, ACL_MEMCPY_DEVICE_TO_HOST));
    float* tmpResBuff = static_cast<float*>(resultBuff);
    std::ostringstream outputOss;
    outputOss << "rankId: " << ctx->device << ", output: [";
    for (uint32_t i = 0; i < recvCount; i++) {
        outputOss << " " << tmpResBuff[i];
    }
    outputOss << " ]" << std::endl;
    std::cout << outputOss.str();
    ACLCHECK(aclrtFreeHost(resultBuff));

    // 释放资源
    HCCLCHECK(HcclCommDestroy(hcclComm)); // 销毁通信域
    if (sendBuf) {
        ACLCHECK(aclrtFree(sendBuf)); // 释放 Device 侧输入内存
    }
    if (recvBuf) {
        ACLCHECK(aclrtFree(recvBuf)); // 释放 Device 侧输出内存
    }
    ACLCHECK(aclrtDestroyStream(stream)); // 销毁任务流
    ACLCHECK(aclrtResetDevice(device));   // 重置 device
    return 0;
}

int main()
{
    // 初始化 ACL
    ACLCHECK(aclInit(NULL));
    // 查询 device 数量
    uint32_t devCount;
    ACLCHECK(aclrtGetDeviceCount(&devCount));
    std::cout << "Found " << devCount << " NPU device(s) available" << std::endl;

    int32_t rootRank = 0;
    ACLCHECK(aclrtSetDevice(rootRank));
    // 生成 root 节点信息，各线程使用同一份 RootInfo
    void* rootInfoBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoBuf, sizeof(HcclRootInfo)));
    HcclRootInfo* rootInfo = (HcclRootInfo*)rootInfoBuf;
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    // 启动线程执行集合通信操作
    std::vector<std::thread> threads(devCount);
    std::vector<ThreadContext> args_(devCount);
    for (uint32_t i = 0; i < devCount; i++) {
        args_[i].rootInfo = rootInfo;
        args_[i].device = i;
        args_[i].devCount = devCount;
        threads[i] = std::thread(Sample, (void*)&args_[i]);
    }
    for (uint32_t i = 0; i < devCount; i++) {
        threads[i].join();
    }

    // 释放资源
    ACLCHECK(aclrtFreeHost(rootInfoBuf)); // 释放 Host 内存
    ACLCHECK(aclFinalize());              // ACL 去初始化
    return 0;
}
