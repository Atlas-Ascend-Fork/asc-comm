extern "C" __vector__ __global__ __aicore__ void hcomm_batch_write_kernel(GM_ADDR context, bool performance);

namespace {

using namespace HcommBatchWriteExample;

constexpr int32_t SUCCESS = 0;
constexpr int32_t FAILURE = 1;
constexpr uint32_t BARRIER_FLAG = 1U;

#define CHECK_RESULT(call, expected, rank)                                                                           \
    do {                                                                                                             \
        auto checkResult = (call);                                                                                   \
        if (checkResult != (expected)) {                                                                             \
            std::fprintf(                                                                                            \
                stderr, "[ERROR] rank %u: %s failed, ret=%lld, expected=%lld\n", static_cast<unsigned>(rank), #call, \
                static_cast<long long>(checkResult), static_cast<long long>(expected));                              \
            return FAILURE;                                                                                          \
        }                                                                                                            \
    } while (0)

struct EndpointGroup {
    EndpointDesc localEndpoint{};
    std::vector<uint32_t> peerRanks;
    std::vector<HcclChannelDesc> channelDescs;
    std::vector<MultiChannelHandle> multiChannels;
};

struct RankResources {
    RankResources() = default;

    ~RankResources()
    {
        for (MultiChannelHandle handle : multiChannels) {
            if (handle != 0U) {
                (void)DestroyMultiChannelHandle(handle);
            }
        }
        if (comm != nullptr) {
            (void)HcclCommDestroy(comm);
        }
        if (deviceContext != nullptr) {
            (void)aclrtFree(deviceContext);
        }
        if (deviceBuffer != nullptr) {
            (void)aclrtFree(deviceBuffer);
        }
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (controlSocket >= 0) {
            (void)close(controlSocket);
        }
        if (deviceSet) {
            (void)aclrtResetDevice(static_cast<int32_t>(rank));
        }
        if (aclInitialized) {
            (void)aclFinalize();
        }
    }

    RankResources(const RankResources&) = delete;
    RankResources& operator=(const RankResources&) = delete;

    uint32_t rank{0U};
    uint32_t rankNum{0U};
    bool aclInitialized{false};
    bool deviceSet{false};
    int32_t controlSocket{-1};
    aclrtStream stream{nullptr};
    HcclComm comm{nullptr};
    void* deviceBuffer{nullptr};
    uint8_t* deviceContext{nullptr};
    HcclMemHandle memHandle{nullptr};
    std::vector<MultiChannelHandle> multiChannels;
};

int32_t SendAll(int32_t socket, const void* buffer, size_t length)
{
    size_t sent = 0U;
    while (sent < length) {
        ssize_t result = send(socket, static_cast<const uint8_t*>(buffer) + sent, length - sent, 0);
        if (result < 0 && errno == EINTR) {
            continue;
        }
        if (result <= 0) {
            std::fprintf(stderr, "[ERROR] send failed: %s\n", std::strerror(errno));
            return FAILURE;
        }
        sent += static_cast<size_t>(result);
    }
    return SUCCESS;
}

int32_t RecvAll(int32_t socket, void* buffer, size_t length)
{
    size_t received = 0U;
    while (received < length) {
        ssize_t result = recv(socket, static_cast<uint8_t*>(buffer) + received, length - received, 0);
        if (result < 0 && errno == EINTR) {
            continue;
        }
        if (result <= 0) {
            std::fprintf(stderr, "[ERROR] recv failed: %s\n", result == 0 ? "peer closed" : std::strerror(errno));
            return FAILURE;
        }
        received += static_cast<size_t>(result);
    }
    return SUCCESS;
}

int32_t ChildBarrier(int32_t socket)
{
    uint32_t release = 0U;
    if (SendAll(socket, &BARRIER_FLAG, sizeof(BARRIER_FLAG)) != SUCCESS ||
        RecvAll(socket, &release, sizeof(release)) != SUCCESS || release != BARRIER_FLAG) {
        std::fprintf(stderr, "[ERROR] child barrier failed\n");
        return FAILURE;
    }
    return SUCCESS;
}

int32_t ParentBarrier(const std::vector<int32_t>& sockets)
{
    uint32_t flag = 0U;
    for (int32_t socket : sockets) {
        if (RecvAll(socket, &flag, sizeof(flag)) != SUCCESS || flag != BARRIER_FLAG) {
            return FAILURE;
        }
    }
    for (int32_t socket : sockets) {
        if (SendAll(socket, &BARRIER_FLAG, sizeof(BARRIER_FLAG)) != SUCCESS) {
            return FAILURE;
        }
    }
    return SUCCESS;
}

uint8_t GetDataValue(uint32_t rank, uint32_t coreIndex, uint32_t offset)
{
    return static_cast<uint8_t>(rank * 53U + coreIndex * 97U + offset);
}

void FillSourceData(std::vector<uint8_t>& buffer, uint32_t rank)
{
    for (uint32_t coreIndex = 0U; coreIndex < AIV_CORE_NUM; ++coreIndex) {
        uint64_t sendOffset = SEND_BASE_OFFSET + static_cast<uint64_t>(coreIndex) * DATA_SIZE;
        for (uint32_t offset = 0U; offset < DATA_SIZE; ++offset) {
            buffer[sendOffset + offset] = GetDataValue(rank, coreIndex, offset);
        }
    }
}

const char* GetKernelError(KernelResult result)
{
    switch (result) {
        case KERNEL_MAKE_BATCH_HANDLE_FAILED:
            return "MakeBatchHandle failed";
        case KERNEL_GET_HANDLE_REF_FAILED:
            return "GetHandleRef failed";
        case KERNEL_WRITE_FAILED:
            return "WriteNbi failed";
        case KERNEL_COMMIT_FAILED:
            return "BatchCommit failed";
        case KERNEL_DRAIN_FAILED:
            return "Drain failed";
        default:
            return "unknown kernel error";
    }
}

int32_t InitAcl(RankResources& resources)
{
    CHECK_RESULT(aclInit(nullptr), ACL_SUCCESS, resources.rank);
    resources.aclInitialized = true;

    uint32_t deviceCount = 0U;
    CHECK_RESULT(aclrtGetDeviceCount(&deviceCount), ACL_SUCCESS, resources.rank);
    if (deviceCount < resources.rankNum) {
        std::fprintf(
            stderr, "[ERROR] rank %u: %u devices are required, found %u\n", resources.rank, resources.rankNum,
            deviceCount);
        return FAILURE;
    }
    CHECK_RESULT(aclrtSetDevice(static_cast<int32_t>(resources.rank)), ACL_SUCCESS, resources.rank);
    resources.deviceSet = true;
    CHECK_RESULT(aclrtCreateStream(&resources.stream), ACL_SUCCESS, resources.rank);
    return SUCCESS;
}

int32_t InitCommunicator(RankResources& resources)
{
    HcclRootInfo rootInfo{};
    if (resources.rank == 0U) {
        CHECK_RESULT(HcclGetRootInfo(&rootInfo), HCCL_SUCCESS, resources.rank);
        CHECK_RESULT(SendAll(resources.controlSocket, &rootInfo, sizeof(rootInfo)), SUCCESS, resources.rank);
    } else {
        CHECK_RESULT(RecvAll(resources.controlSocket, &rootInfo, sizeof(rootInfo)), SUCCESS, resources.rank);
    }

    HcclCommConfig config{};
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = resources.rank;
    CHECK_RESULT(
        HcclCommInitRootInfoConfig(resources.rankNum, &rootInfo, resources.rank, &config, &resources.comm),
        HCCL_SUCCESS, resources.rank);
    return SUCCESS;
}

int32_t PrepareMemory(RankResources& resources, std::vector<uint64_t>& remoteBuffers)
{
    const uint64_t commBufferSize = COMM_BUFFER_SIZE;
    CHECK_RESULT(
        aclrtMalloc(&resources.deviceBuffer, commBufferSize, ACL_MEM_MALLOC_HUGE_FIRST), ACL_SUCCESS, resources.rank);
    CHECK_RESULT(
        aclrtMalloc(
            reinterpret_cast<void**>(&resources.deviceContext), sizeof(BatchContext) * AIV_CORE_NUM,
            ACL_MEM_MALLOC_HUGE_FIRST),
        ACL_SUCCESS, resources.rank);

    std::vector<uint8_t> hostBuffer(static_cast<size_t>(commBufferSize), 0U);
    FillSourceData(hostBuffer, resources.rank);
    CHECK_RESULT(
        aclrtMemcpy(
            resources.deviceBuffer, commBufferSize, hostBuffer.data(), commBufferSize, ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, resources.rank);

    CommMem memory{};
    memory.type = COMM_MEM_TYPE_DEVICE;
    memory.addr = resources.deviceBuffer;
    memory.size = commBufferSize;
    CHECK_RESULT(
        HcclCommMemReg(resources.comm, MEMORY_TAG, &memory, &resources.memHandle), HCCL_SUCCESS, resources.rank);

    uint64_t localBuffer = reinterpret_cast<uint64_t>(resources.deviceBuffer);
    CHECK_RESULT(SendAll(resources.controlSocket, &localBuffer, sizeof(localBuffer)), SUCCESS, resources.rank);
    remoteBuffers.resize(resources.rankNum);
    CHECK_RESULT(
        RecvAll(resources.controlSocket, remoteBuffers.data(), remoteBuffers.size() * sizeof(remoteBuffers.front())),
        SUCCESS, resources.rank);
    for (uint32_t rank = 0U; rank < resources.rankNum; ++rank) {
        if (remoteBuffers[rank] == 0U) {
            std::fprintf(stderr, "[ERROR] rank %u: received null buffer for rank %u\n", resources.rank, rank);
            return FAILURE;
        }
    }
    return SUCCESS;
}

bool HasSameEndpoint(const EndpointDesc& lhs, const EndpointDesc& rhs)
{
    return AscCommIsSameEndpoint(&lhs, &rhs) != 0;
}

int32_t InitChannelDesc(
    RankResources& resources, uint32_t peerRank, const CommLink& link, EndpointGroup& group)
{
    HcclChannelDesc desc{};
    CHECK_RESULT(HcclChannelDescInit(&desc, 1U), HCCL_SUCCESS, resources.rank);
    desc.remoteRank = peerRank;
    desc.channelProtocol = COMM_PROTOCOL_UBC_CTP;
    desc.localEndpoint = link.srcEndpointDesc;
    desc.remoteEndpoint = link.dstEndpointDesc;
    desc.memHandles = &resources.memHandle;
    desc.memHandleNum = 1U;

    group.peerRanks.push_back(peerRank);
    group.channelDescs.push_back(desc);
    return SUCCESS;
}

int32_t CollectPeerLinks(
    RankResources& resources, const uint32_t* layers, uint32_t layerCount, uint32_t peerRank,
    std::vector<CommLink>& peerLinks)
{
    for (uint32_t layerIndex = 0U; layerIndex < layerCount; ++layerIndex) {
        CommLink* links = nullptr;
        uint32_t linkCount = 0U;
        CHECK_RESULT(
            HcclRankGraphGetLinks(resources.comm, layers[layerIndex], resources.rank, peerRank, &links, &linkCount),
            HCCL_SUCCESS, resources.rank);
        for (uint32_t linkIndex = 0U; linkIndex < linkCount; ++linkIndex) {
            if (links[linkIndex].linkAttr.linkProtocol == COMM_PROTOCOL_UBC_CTP) {
                peerLinks.push_back(links[linkIndex]);
            }
        }
    }
    if (peerLinks.empty()) {
        std::fprintf(stderr, "[ERROR] rank %u: no UBC_CTP link to rank %u\n", resources.rank, peerRank);
        return FAILURE;
    }
    return SUCCESS;
}

int32_t BuildEndpointGroups(RankResources& resources, std::vector<EndpointGroup>& groups)
{
    uint32_t* layers = nullptr;
    uint32_t layerCount = 0U;
    CHECK_RESULT(HcclRankGraphGetLayers(resources.comm, &layers, &layerCount), HCCL_SUCCESS, resources.rank);

    std::vector<uint32_t> peerRanks;
    if (resources.rank == 0U) {
        for (uint32_t peerRank = 1U; peerRank < resources.rankNum; ++peerRank) {
            peerRanks.push_back(peerRank);
        }
    } else {
        peerRanks.push_back(0U);
    }

    std::vector<std::vector<CommLink>> peerLinks(peerRanks.size());
    for (size_t peerIndex = 0U; peerIndex < peerRanks.size(); ++peerIndex) {
        CHECK_RESULT(
            CollectPeerLinks(resources, layers, layerCount, peerRanks[peerIndex], peerLinks[peerIndex]), SUCCESS,
            resources.rank);
    }

    for (const CommLink& anchorLink : peerLinks.front()) {
        EndpointGroup group{};
        group.localEndpoint = anchorLink.srcEndpointDesc;
        bool sharedEndpointFound = true;
        for (size_t peerIndex = 0U; peerIndex < peerRanks.size(); ++peerIndex) {
            const CommLink* selectedLink = nullptr;
            for (const CommLink& link : peerLinks[peerIndex]) {
                if (HasSameEndpoint(group.localEndpoint, link.srcEndpointDesc)) {
                    selectedLink = &link;
                    break;
                }
            }
            if (selectedLink == nullptr) {
                sharedEndpointFound = false;
                break;
            }
            CHECK_RESULT(
                InitChannelDesc(resources, peerRanks[peerIndex], *selectedLink, group), SUCCESS, resources.rank);
        }
        if (sharedEndpointFound) {
            groups.push_back(group);
            return SUCCESS;
        }
    }

    std::fprintf(
        stderr, "[ERROR] rank %u: no local UBC_CTP endpoint is shared by all %zu peer(s)\n", resources.rank,
        peerRanks.size());
    return FAILURE;
}

int32_t CreateMultiChannelHandles(RankResources& resources, std::vector<EndpointGroup>& groups)
{
    resources.multiChannels.reserve(groups.size() * AIV_CORE_NUM);
    for (size_t groupIndex = 0U; groupIndex < groups.size(); ++groupIndex) {
        EndpointGroup& group = groups[groupIndex];
        group.multiChannels.resize(AIV_CORE_NUM, 0U);
        for (uint32_t coreIndex = 0U; coreIndex < AIV_CORE_NUM; ++coreIndex) {
            std::string tag = std::string(SHARED_QUEUE_TAG_PREFIX) + "_" + std::to_string(resources.rank) + "_" +
                              std::to_string(groupIndex) + "_" + std::to_string(coreIndex);
            CHECK_RESULT(
                MakeMultiChannelHandle(
                    resources.comm, tag.c_str(), group.channelDescs.data(),
                    static_cast<uint32_t>(group.channelDescs.size()), &group.multiChannels[coreIndex]),
                HCCL_SUCCESS, resources.rank);
            resources.multiChannels.push_back(group.multiChannels[coreIndex]);
            std::printf(
                "rank %u: core %u shared Jetty has %zu channel(s)\n", resources.rank, coreIndex,
                group.peerRanks.size());
        }
    }
    return SUCCESS;
}

int32_t LaunchBatchKernel(RankResources& resources, std::vector<BatchContext>& contexts, bool performance)
{
    const size_t contextSize = contexts.size() * sizeof(contexts.front());
    CHECK_RESULT(
        aclrtMemcpy(
            resources.deviceContext, contextSize, contexts.data(), contextSize, ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, resources.rank);
    hcomm_batch_write_kernel<<<AIV_CORE_NUM, nullptr, resources.stream>>>(resources.deviceContext, performance);
    CHECK_RESULT(aclrtSynchronizeStream(resources.stream), ACL_SUCCESS, resources.rank);
    CHECK_RESULT(
        aclrtMemcpy(
            contexts.data(), contextSize, resources.deviceContext, contextSize, ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, resources.rank);
    for (uint32_t coreIndex = 0U; coreIndex < AIV_CORE_NUM; ++coreIndex) {
        const BatchContext& context = contexts[coreIndex];
        if (context.result != KERNEL_SUCCESS) {
            std::fprintf(
                stderr, "[ERROR] rank %u core %u: %s, hcomm ret=%d\n", resources.rank, coreIndex,
                GetKernelError(context.result), context.hcommResult);
            return FAILURE;
        }
    }
    return SUCCESS;
}

int32_t RunGroupKernel(RankResources& resources, const EndpointGroup& group, const std::vector<uint64_t>& remoteBuffers)
{
    if (group.peerRanks.empty() || group.peerRanks.size() > MAX_CHANNEL_NUM) {
        return FAILURE;
    }

    std::vector<BatchContext> contexts(AIV_CORE_NUM);
    for (uint32_t coreIndex = 0U; coreIndex < AIV_CORE_NUM; ++coreIndex) {
        BatchContext& context = contexts[coreIndex];
        context.multiChannel = group.multiChannels[coreIndex];
        context.localBuffer = reinterpret_cast<uint64_t>(resources.deviceBuffer);
        context.channelNum = static_cast<uint32_t>(group.peerRanks.size());
        context.result = KERNEL_SUCCESS;
        context.hcommResult = 0;
        context.startCycles = 0U;
        context.endCycles = 0U;
        for (size_t channelIndex = 0U; channelIndex < group.peerRanks.size(); ++channelIndex) {
            context.remoteBuffers[channelIndex] = remoteBuffers[group.peerRanks[channelIndex]];
        }
    }

    CHECK_RESULT(LaunchBatchKernel(resources, contexts, false), SUCCESS, resources.rank);
    CHECK_RESULT(LaunchBatchKernel(resources, contexts, true), SUCCESS, resources.rank);

    uint64_t earliestStart = contexts.front().startCycles;
    uint64_t latestEnd = contexts.front().endCycles;
    for (uint32_t coreIndex = 0U; coreIndex < AIV_CORE_NUM; ++coreIndex) {
        const BatchContext& context = contexts[coreIndex];
        earliestStart = context.startCycles < earliestStart ? context.startCycles : earliestStart;
        latestEnd = context.endCycles > latestEnd ? context.endCycles : latestEnd;
        uint64_t coreCycles = context.endCycles - context.startCycles;
        double corePayloadBytes = static_cast<double>(PERF_LOOP_COUNT) * static_cast<double>(DATA_SIZE) *
                                  static_cast<double>(WRITES_PER_CHANNEL_PER_BATCH) *
                                  static_cast<double>(group.peerRanks.size());
        double averageBatchCycles =
            static_cast<double>(coreCycles) / static_cast<double>(PERF_LOOP_COUNT);
        double coreBytesPerCycle = coreCycles == 0U ? 0.0 : corePayloadBytes / static_cast<double>(coreCycles);
        std::printf(
            "rank %u core %u: cycles=%llu, average batch cycles=%.3f, payload throughput=%.3f B/cycle\n",
            resources.rank, coreIndex, static_cast<unsigned long long>(coreCycles), averageBatchCycles,
            coreBytesPerCycle);
    }
    uint64_t aggregateCycles = latestEnd - earliestStart;
    double totalPayloadBytes = static_cast<double>(PERF_LOOP_COUNT) * static_cast<double>(DATA_SIZE) *
                               static_cast<double>(WRITES_PER_CHANNEL_PER_BATCH) *
                               static_cast<double>(group.peerRanks.size()) * static_cast<double>(AIV_CORE_NUM);
    double aggregateBytesPerCycle =
        aggregateCycles == 0U ? 0.0 : totalPayloadBytes / static_cast<double>(aggregateCycles);
    double averageBatchCycles =
        static_cast<double>(aggregateCycles) / static_cast<double>(PERF_LOOP_COUNT);
    std::printf(
        "batch performance: cores=%u, channels/core=%zu, total channels=%zu, writes/channel/batch=%u, "
        "request=%u B, loops=%u, cycles=%llu, average batch cycles=%.3f, "
        "aggregate payload throughput=%.3f B/cycle\n",
        AIV_CORE_NUM, group.peerRanks.size(), static_cast<size_t>(AIV_CORE_NUM) * group.peerRanks.size(),
        WRITES_PER_CHANNEL_PER_BATCH, DATA_SIZE, PERF_LOOP_COUNT, static_cast<unsigned long long>(aggregateCycles),
        averageBatchCycles, aggregateBytesPerCycle);
    return SUCCESS;
}

int32_t ValidateResults(const RankResources& resources)
{
    const uint64_t commBufferSize = COMM_BUFFER_SIZE;
    std::vector<uint8_t> hostBuffer(static_cast<size_t>(commBufferSize), 0U);
    CHECK_RESULT(
        aclrtMemcpy(
            hostBuffer.data(), commBufferSize, resources.deviceBuffer, commBufferSize, ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, resources.rank);

    for (uint32_t coreIndex = 0U; coreIndex < AIV_CORE_NUM; ++coreIndex) {
        uint64_t receiveOffset = RECV_BASE_OFFSET + static_cast<uint64_t>(coreIndex) * DATA_SIZE;
        for (uint32_t offset = 0U; offset < DATA_SIZE; ++offset) {
            uint8_t actual = hostBuffer[receiveOffset + offset];
            uint8_t expected = GetDataValue(0U, coreIndex, offset);
            if (actual != expected) {
                std::fprintf(
                    stderr,
                    "[ERROR] rank %u: core %u data from rank 0 mismatch at %u, actual=0x%02x, expected=0x%02x\n",
                    resources.rank, coreIndex, offset, actual, expected);
                return FAILURE;
            }
        }
    }
    std::printf("rank %u: received and verified data from rank 0 on %u core(s)\n", resources.rank, AIV_CORE_NUM);
    return SUCCESS;
}

int32_t RunRank(uint32_t rank, uint32_t rankNum, int32_t controlSocket)
{
    RankResources resources{};
    resources.rank = rank;
    resources.rankNum = rankNum;
    resources.controlSocket = controlSocket;

    CHECK_RESULT(InitAcl(resources), SUCCESS, rank);
    CHECK_RESULT(InitCommunicator(resources), SUCCESS, rank);

    std::vector<uint64_t> remoteBuffers;
    CHECK_RESULT(PrepareMemory(resources, remoteBuffers), SUCCESS, rank);

    std::vector<EndpointGroup> groups;
    CHECK_RESULT(BuildEndpointGroups(resources, groups), SUCCESS, rank);
    CHECK_RESULT(CreateMultiChannelHandles(resources, groups), SUCCESS, rank);

    CHECK_RESULT(ChildBarrier(resources.controlSocket), SUCCESS, rank);
    if (rank == 0U) {
        for (const EndpointGroup& group : groups) {
            CHECK_RESULT(RunGroupKernel(resources, group, remoteBuffers), SUCCESS, rank);
        }
    }
    CHECK_RESULT(ChildBarrier(resources.controlSocket), SUCCESS, rank);
    return rank == 0U ? SUCCESS : ValidateResults(resources);
}

int32_t CoordinateRanks(const std::vector<int32_t>& sockets, uint32_t rankNum)
{
    HcclRootInfo rootInfo{};
    if (RecvAll(sockets[0], &rootInfo, sizeof(rootInfo)) != SUCCESS) {
        return FAILURE;
    }
    for (uint32_t rank = 1U; rank < rankNum; ++rank) {
        if (SendAll(sockets[rank], &rootInfo, sizeof(rootInfo)) != SUCCESS) {
            return FAILURE;
        }
    }

    std::vector<uint64_t> buffers(rankNum, 0U);
    for (uint32_t rank = 0U; rank < rankNum; ++rank) {
        if (RecvAll(sockets[rank], &buffers[rank], sizeof(buffers[rank])) != SUCCESS) {
            return FAILURE;
        }
    }
    for (int32_t socket : sockets) {
        if (SendAll(socket, buffers.data(), buffers.size() * sizeof(buffers.front())) != SUCCESS) {
            return FAILURE;
        }
    }
    return ParentBarrier(sockets) == SUCCESS && ParentBarrier(sockets) == SUCCESS ? SUCCESS : FAILURE;
}

bool ParseRankNum(const char* value, uint32_t& rankNum)
{
    if (value == nullptr || std::strlen(value) == 0U || value[0] == '-') {
        return false;
    }
    const size_t valueLength = std::strlen(value);
    char* end = nullptr;
    errno = 0;
    unsigned long parsed = std::strtoul(value, &end, 10);
    if (errno != 0 || end == value || static_cast<size_t>(end - value) != valueLength || parsed < 2U ||
        parsed > MAX_RANK_NUM) {
        return false;
    }
    rankNum = static_cast<uint32_t>(parsed);
    return true;
}

void StopChildren(const std::vector<pid_t>& children)
{
    for (pid_t child : children) {
        if (child > 0) {
            (void)kill(child, SIGKILL);
        }
    }
    for (pid_t child : children) {
        if (child > 0) {
            (void)waitpid(child, nullptr, 0);
        }
    }
}

} // namespace

int32_t main(int32_t argc, char** argv)
{
    uint32_t rankNum = DEFAULT_RANK_NUM;
    if (argc > 2 || (argc == 2 && !ParseRankNum(argv[1], rankNum))) {
        std::fprintf(stderr, "Usage: %s [rank_size]\n", argv[0]);
        return FAILURE;
    }
    (void)signal(SIGPIPE, SIG_IGN);

    std::vector<int32_t> parentSockets(rankNum, -1);
    std::vector<int32_t> childSockets(rankNum, -1);
    for (uint32_t rank = 0U; rank < rankNum; ++rank) {
        int32_t sockets[2] = {-1, -1};
        if (socketpair(AF_UNIX, SOCK_STREAM, 0, sockets) != 0) {
            std::fprintf(stderr, "[ERROR] socketpair for rank %u failed: %s\n", rank, std::strerror(errno));
            return FAILURE;
        }
        parentSockets[rank] = sockets[0];
        childSockets[rank] = sockets[1];
    }

    std::vector<pid_t> children(rankNum, -1);
    for (uint32_t rank = 0U; rank < rankNum; ++rank) {
        children[rank] = fork();
        if (children[rank] < 0) {
            std::fprintf(stderr, "[ERROR] fork rank %u failed: %s\n", rank, std::strerror(errno));
            StopChildren(children);
            return FAILURE;
        }
        if (children[rank] == 0) {
            for (uint32_t index = 0U; index < rankNum; ++index) {
                (void)close(parentSockets[index]);
                if (index != rank) {
                    (void)close(childSockets[index]);
                }
            }
            int32_t result = RunRank(rank, rankNum, childSockets[rank]);
            std::fflush(nullptr);
            _exit(result);
        }
    }

    for (int32_t socket : childSockets) {
        (void)close(socket);
    }
    bool passed = CoordinateRanks(parentSockets, rankNum) == SUCCESS;
    for (int32_t socket : parentSockets) {
        (void)close(socket);
    }
    if (!passed) {
        StopChildren(children);
        std::fprintf(stderr, "[ERROR] rank coordination failed\n");
        return FAILURE;
    }

    for (pid_t child : children) {
        int32_t status = 0;
        if (waitpid(child, &status, 0) < 0 || !WIFEXITED(status) || WEXITSTATUS(status) != SUCCESS) {
            passed = false;
        }
    }
    std::printf("hcomm %u-rank grouped batch write test %s\n", rankNum, passed ? "passed" : "failed");
    return passed ? SUCCESS : FAILURE;
}
