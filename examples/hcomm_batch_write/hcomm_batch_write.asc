#include "hcomm_batch_write_def.h"

extern "C" __vector__ __global__ __aicore__ void hcomm_batch_write_kernel(GM_ADDR context);

namespace {

using namespace HcommBatchWriteExample;

constexpr int32_t SUCCESS = 0;
constexpr int32_t FAILURE = 1;

#define CHECK_RESULT(call, expected, rank)                                                                           \
    do {                                                                                                             \
        auto checkResult = (call);                                                                                   \
        if (checkResult != (expected)) {                                                                             \
            std::fprintf(                                                                                            \
                stderr, "[ERROR] rank %u: %s failed, ret=%lld, expected=%lld\n", static_cast<unsigned>(rank), #call, \
                static_cast<long long>(checkResult), static_cast<long long>(expected));                              \
            return FAILURE;                                                                                          \
        }                                                                                                            \
    } while (0)

struct RankResources {
    RankResources() = default;

    ~RankResources()
    {
        if (multiChannel != 0U) {
            (void)DestroyMultiChannelHandle(multiChannel);
        }
        if (comm != nullptr) {
            (void)HcclCommDestroy(comm);
        }
        if (deviceContext != nullptr) {
            (void)aclrtFree(deviceContext);
        }
        if (deviceBuffer != nullptr) {
            (void)aclrtFree(deviceBuffer);
        }
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (peerSocket >= 0) {
            (void)close(peerSocket);
        }
        if (deviceSet) {
            (void)aclrtResetDevice(static_cast<int32_t>(rank));
        }
        if (aclInitialized) {
            (void)aclFinalize();
        }
    }

    RankResources(const RankResources&) = delete;
    RankResources& operator=(const RankResources&) = delete;

    uint32_t rank{0U};
    bool aclInitialized{false};
    bool deviceSet{false};
    int32_t peerSocket{-1};
    aclrtStream stream{nullptr};
    HcclComm comm{nullptr};
    void* deviceBuffer{nullptr};
    uint8_t* deviceContext{nullptr};
    HcclMemHandle memHandle{nullptr};
    MultiChannelHandle multiChannel{0U};
};

int32_t SendAll(int32_t socket, const void* buffer, size_t length)
{
    size_t sent = 0U;
    while (sent < length) {
        ssize_t result = send(socket, static_cast<const uint8_t*>(buffer) + sent, length - sent, 0);
        if (result <= 0) {
            std::fprintf(stderr, "[ERROR] send failed: %s\n", std::strerror(errno));
            return FAILURE;
        }
        sent += static_cast<size_t>(result);
    }
    return SUCCESS;
}

int32_t RecvAll(int32_t socket, void* buffer, size_t length)
{
    size_t received = 0U;
    while (received < length) {
        ssize_t result = recv(socket, static_cast<uint8_t*>(buffer) + received, length - received, 0);
        if (result <= 0) {
            std::fprintf(stderr, "[ERROR] recv failed: %s\n", std::strerror(errno));
            return FAILURE;
        }
        received += static_cast<size_t>(result);
    }
    return SUCCESS;
}

int32_t PeerBarrier(int32_t socket)
{
    uint32_t flag = 1U;
    uint32_t peerFlag = 0U;
    if (SendAll(socket, &flag, sizeof(flag)) != SUCCESS || RecvAll(socket, &peerFlag, sizeof(peerFlag)) != SUCCESS ||
        peerFlag != flag) {
        std::fprintf(stderr, "[ERROR] peer barrier failed\n");
        return FAILURE;
    }
    return SUCCESS;
}

uint8_t GetDataValue(uint32_t rank, uint32_t channelIndex, uint32_t offset)
{
    return static_cast<uint8_t>(rank * 53U + channelIndex * 97U + offset);
}

void FillSourceData(std::vector<uint8_t>& buffer, uint32_t rank)
{
    for (uint32_t offset = 0U; offset < DATA_SIZE; ++offset) {
        buffer[SEND_OFFSET_0 + offset] = GetDataValue(rank, 0U, offset);
        buffer[SEND_OFFSET_1 + offset] = GetDataValue(rank, 1U, offset);
    }
}

const char* GetKernelError(KernelResult result)
{
    switch (result) {
        case KERNEL_MAKE_BATCH_HANDLE_FAILED:
            return "MakeBatchHandle failed";
        case KERNEL_GET_HANDLE_REF_FAILED:
            return "GetHandleRef failed";
        case KERNEL_WRITE_FAILED:
            return "WriteNbi failed";
        case KERNEL_COMMIT_FAILED:
            return "BatchCommit failed";
        case KERNEL_DRAIN_FAILED:
            return "Drain failed";
        default:
            return "unknown kernel error";
    }
}

int32_t InitAcl(RankResources& resources)
{
    CHECK_RESULT(aclInit(nullptr), ACL_SUCCESS, resources.rank);
    resources.aclInitialized = true;

    uint32_t deviceCount = 0U;
    CHECK_RESULT(aclrtGetDeviceCount(&deviceCount), ACL_SUCCESS, resources.rank);
    if (deviceCount < RANK_NUM) {
        std::fprintf(stderr, "[ERROR] two devices are required, found %u\n", deviceCount);
        return FAILURE;
    }
    CHECK_RESULT(aclrtSetDevice(static_cast<int32_t>(resources.rank)), ACL_SUCCESS, resources.rank);
    resources.deviceSet = true;
    CHECK_RESULT(aclrtCreateStream(&resources.stream), ACL_SUCCESS, resources.rank);
    return SUCCESS;
}

int32_t InitCommunicator(RankResources& resources)
{
    HcclRootInfo rootInfo{};
    if (resources.rank == 0U) {
        CHECK_RESULT(HcclGetRootInfo(&rootInfo), HCCL_SUCCESS, resources.rank);
        CHECK_RESULT(SendAll(resources.peerSocket, &rootInfo, sizeof(rootInfo)), SUCCESS, resources.rank);
    } else {
        CHECK_RESULT(RecvAll(resources.peerSocket, &rootInfo, sizeof(rootInfo)), SUCCESS, resources.rank);
    }

    HcclCommConfig config{};
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = resources.rank;
    CHECK_RESULT(
        HcclCommInitRootInfoConfig(RANK_NUM, &rootInfo, resources.rank, &config, &resources.comm), HCCL_SUCCESS,
        resources.rank);
    return SUCCESS;
}

int32_t PrepareMemory(RankResources& resources, uint64_t& remoteBuffer)
{
    CHECK_RESULT(
        aclrtMalloc(&resources.deviceBuffer, COMM_BUFFER_SIZE, ACL_MEM_MALLOC_HUGE_FIRST), ACL_SUCCESS, resources.rank);
    CHECK_RESULT(
        aclrtMalloc(
            reinterpret_cast<void**>(&resources.deviceContext), sizeof(BatchContext), ACL_MEM_MALLOC_HUGE_FIRST),
        ACL_SUCCESS, resources.rank);

    std::vector<uint8_t> hostBuffer(static_cast<size_t>(COMM_BUFFER_SIZE), 0U);
    FillSourceData(hostBuffer, resources.rank);
    CHECK_RESULT(
        aclrtMemcpy(
            resources.deviceBuffer, COMM_BUFFER_SIZE, hostBuffer.data(), COMM_BUFFER_SIZE, ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, resources.rank);

    CommMem memory{};
    memory.type = COMM_MEM_TYPE_DEVICE;
    memory.addr = resources.deviceBuffer;
    memory.size = COMM_BUFFER_SIZE;
    CHECK_RESULT(
        HcclCommMemReg(resources.comm, MEMORY_TAG, &memory, &resources.memHandle), HCCL_SUCCESS, resources.rank);

    uint64_t localBuffer = reinterpret_cast<uint64_t>(resources.deviceBuffer);
    CHECK_RESULT(SendAll(resources.peerSocket, &localBuffer, sizeof(localBuffer)), SUCCESS, resources.rank);
    CHECK_RESULT(RecvAll(resources.peerSocket, &remoteBuffer, sizeof(remoteBuffer)), SUCCESS, resources.rank);
    if (remoteBuffer == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: received null remote buffer\n", resources.rank);
        return FAILURE;
    }
    return SUCCESS;
}

int32_t BuildChannelDescs(RankResources& resources, HcclChannelDesc (&channelDescs)[CHANNEL_NUM])
{
    uint32_t* layers = nullptr;
    uint32_t layerCount = 0U;
    CHECK_RESULT(HcclRankGraphGetLayers(resources.comm, &layers, &layerCount), HCCL_SUCCESS, resources.rank);

    const uint32_t peerRank = 1U - resources.rank;
    bool found = false;
    for (uint32_t layerIndex = 0U; layerIndex < layerCount && !found; ++layerIndex) {
        CommLink* links = nullptr;
        uint32_t linkCount = 0U;
        CHECK_RESULT(
            HcclRankGraphGetLinks(resources.comm, layers[layerIndex], resources.rank, peerRank, &links, &linkCount),
            HCCL_SUCCESS, resources.rank);
        for (uint32_t linkIndex = 0U; linkIndex < linkCount; ++linkIndex) {
            if (links[linkIndex].linkAttr.linkProtocol != COMM_PROTOCOL_UBC_CTP) {
                continue;
            }
            CHECK_RESULT(HcclChannelDescInit(channelDescs, CHANNEL_NUM), HCCL_SUCCESS, resources.rank);
            channelDescs[0].remoteRank = peerRank;
            channelDescs[0].channelProtocol = COMM_PROTOCOL_UBC_CTP;
            channelDescs[0].localEndpoint = links[linkIndex].srcEndpointDesc;
            channelDescs[0].remoteEndpoint = links[linkIndex].dstEndpointDesc;
            channelDescs[0].memHandles = &resources.memHandle;
            channelDescs[0].memHandleNum = 1U;
            channelDescs[1] = channelDescs[0];
            found = true;
            break;
        }
    }
    if (!found) {
        std::fprintf(stderr, "[ERROR] rank %u: no UBC_CTP link to rank %u\n", resources.rank, peerRank);
        return FAILURE;
    }
    return SUCCESS;
}

int32_t RunKernel(RankResources& resources, uint64_t remoteBuffer)
{
    BatchContext context{};
    context.multiChannel = resources.multiChannel;
    context.localBuffer = reinterpret_cast<uint64_t>(resources.deviceBuffer);
    context.remoteBuffer = remoteBuffer;
    context.result = KERNEL_SUCCESS;
    CHECK_RESULT(
        aclrtMemcpy(resources.deviceContext, sizeof(context), &context, sizeof(context), ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, resources.rank);

    hcomm_batch_write_kernel<<<1U, nullptr, resources.stream>>>(resources.deviceContext);
    CHECK_RESULT(aclrtSynchronizeStream(resources.stream), ACL_SUCCESS, resources.rank);

    CHECK_RESULT(
        aclrtMemcpy(&context, sizeof(context), resources.deviceContext, sizeof(context), ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, resources.rank);
    if (context.result != KERNEL_SUCCESS) {
        std::fprintf(stderr, "[ERROR] rank %u: %s\n", resources.rank, GetKernelError(context.result));
        return FAILURE;
    }
    return SUCCESS;
}

int32_t ValidateResults(const RankResources& resources)
{
    std::vector<uint8_t> hostBuffer(static_cast<size_t>(COMM_BUFFER_SIZE), 0U);
    CHECK_RESULT(
        aclrtMemcpy(
            hostBuffer.data(), COMM_BUFFER_SIZE, resources.deviceBuffer, COMM_BUFFER_SIZE, ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, resources.rank);

    const uint32_t peerRank = 1U - resources.rank;
    const uint64_t receiveOffsets[CHANNEL_NUM] = {RECV_OFFSET_0, RECV_OFFSET_1};
    for (uint32_t channelIndex = 0U; channelIndex < CHANNEL_NUM; ++channelIndex) {
        for (uint32_t offset = 0U; offset < DATA_SIZE; ++offset) {
            uint8_t actual = hostBuffer[receiveOffsets[channelIndex] + offset];
            uint8_t expected = GetDataValue(peerRank, channelIndex, offset);
            if (actual != expected) {
                std::fprintf(
                    stderr, "[ERROR] rank %u: channel %u data mismatch at %u, actual=0x%02x, expected=0x%02x\n",
                    resources.rank, channelIndex, offset, actual, expected);
                return FAILURE;
            }
        }
    }
    std::printf("rank %u: shared-Jetty batch write passed\n", resources.rank);
    return SUCCESS;
}

int32_t RunRank(uint32_t rank, int32_t peerSocket)
{
    RankResources resources{};
    resources.rank = rank;
    resources.peerSocket = peerSocket;

    CHECK_RESULT(InitAcl(resources), SUCCESS, rank);
    CHECK_RESULT(InitCommunicator(resources), SUCCESS, rank);

    uint64_t remoteBuffer = 0U;
    CHECK_RESULT(PrepareMemory(resources, remoteBuffer), SUCCESS, rank);

    HcclChannelDesc channelDescs[CHANNEL_NUM];
    CHECK_RESULT(BuildChannelDescs(resources, channelDescs), SUCCESS, rank);
    CHECK_RESULT(
        MakeMultiChannelHandle(resources.comm, channelDescs, CHANNEL_NUM, &resources.multiChannel), HCCL_SUCCESS, rank);

    CHECK_RESULT(PeerBarrier(resources.peerSocket), SUCCESS, rank);
    CHECK_RESULT(RunKernel(resources, remoteBuffer), SUCCESS, rank);
    CHECK_RESULT(PeerBarrier(resources.peerSocket), SUCCESS, rank);
    return ValidateResults(resources);
}

} // namespace

int32_t main()
{
    int32_t sockets[2] = {-1, -1};
    if (socketpair(AF_UNIX, SOCK_STREAM, 0, sockets) != 0) {
        std::fprintf(stderr, "[ERROR] socketpair failed: %s\n", std::strerror(errno));
        return FAILURE;
    }

    pid_t children[RANK_NUM] = {-1, -1};
    for (uint32_t rank = 0U; rank < RANK_NUM; ++rank) {
        children[rank] = fork();
        if (children[rank] < 0) {
            std::fprintf(stderr, "[ERROR] fork rank %u failed: %s\n", rank, std::strerror(errno));
            for (uint32_t index = 0U; index < rank; ++index) {
                (void)kill(children[index], SIGKILL);
                (void)waitpid(children[index], nullptr, 0);
            }
            (void)close(sockets[0]);
            (void)close(sockets[1]);
            return FAILURE;
        }
        if (children[rank] == 0) {
            (void)close(sockets[1U - rank]);
            int32_t result = RunRank(rank, sockets[rank]);
            std::fflush(nullptr);
            _exit(result);
        }
    }

    (void)close(sockets[0]);
    (void)close(sockets[1]);
    bool passed = true;
    for (uint32_t rank = 0U; rank < RANK_NUM; ++rank) {
        int32_t status = 0;
        if (waitpid(children[rank], &status, 0) < 0 || !WIFEXITED(status) || WEXITSTATUS(status) != SUCCESS) {
            passed = false;
        }
    }
    std::printf("hcomm batch write test %s\n", passed ? "passed" : "failed");
    return passed ? SUCCESS : FAILURE;
}
