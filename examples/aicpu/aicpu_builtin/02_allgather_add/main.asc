#include <cstdio>
#include <iostream>
#include <vector>
#include <thread>

#include <acl/acl_rt.h>
#include <hccl/hccl_comm.h>
#include <hccl/hccl_res.h>
#include <hccl/hccl_types.h>

#include "adv_api/hccl/hccl.h"
#include "adv_api/hccl/hccl_mc2.h"
#include "kernel_operator.h"

#ifdef ACLCHECK
#undef ACLCHECK
#endif

#define ACLCHECK(call)                                                                            \
    do {                                                                                          \
        aclError aclRet = static_cast<aclError>(call);                                            \
        if (aclRet != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, aclRet); \
            return aclRet;                                                                        \
        }                                                                                         \
    } while (0)

#define HCCLCHECK(call)                                                                                               \
    do {                                                                                                              \
        HcclResult hcclRet = static_cast<HcclResult>(call);                                                           \
        if (hcclRet != HCCL_SUCCESS) {                                                                                \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, static_cast<int>(hcclRet)); \
            return hcclRet;                                                                                           \
        }                                                                                                             \
    } while (0)

#define CHK_PTR_NULL(ptr)       \
    do {                        \
        if ((ptr) == nullptr) { \
            return HCCL_E_PTR;  \
        }                       \
    } while (0)

constexpr uint64_t MC2_MAX_RANK_SIZE = 8;
constexpr uint32_t TILE_LEN = 256U;

constexpr uint32_t UNFOLD_TAG_MAX_LENGTH = COMM_NAME_MAX_LENGTH + 16U;
constexpr uint32_t UNFOLD_THREAD_NUM = 1U;

__aicore__ inline void AddCompute(GM_ADDR x1, GM_ADDR x2, GM_ADDR tmp, uint64_t count)
{
    AscendC::GlobalTensor<float> x1Gm;
    AscendC::GlobalTensor<float> x2Gm;
    AscendC::GlobalTensor<float> tmpGm;
    x1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x1), count);
    x2Gm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x2), count);
    tmpGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(tmp), count);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> x1Local = ubAllocator.Alloc<float, TILE_LEN>();
    AscendC::LocalTensor<float> x2Local = ubAllocator.Alloc<float, TILE_LEN>();
    AscendC::LocalTensor<float> tmpLocal = ubAllocator.Alloc<float, TILE_LEN>();

    for (uint64_t offset = 0; offset < count; offset += TILE_LEN) {
        const uint64_t remain = count - offset;
        const uint32_t curLen = static_cast<uint32_t>(remain > TILE_LEN ? TILE_LEN : remain);
        AscendC::DataCopy(x1Local, x1Gm[offset], curLen);
        AscendC::DataCopy(x2Local, x2Gm[offset], curLen);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::Add(tmpLocal, x1Local, x2Local, static_cast<int32_t>(curLen));
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(tmpGm[offset], tmpLocal, curLen);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

__global__ __vector__ void all_gather_add_kernel(
    __gm__ void* x1GM, __gm__ void* x2GM, __gm__ void* tmpGM, __gm__ void* yGM, __gm__ void* contextGM,
    uint64_t sendCount)
{
    if (g_coreType != AscendC::AIV) {
        return;
    }
    AscendC::InitSocState();
    AscendC::Hccl<AscendC::HcclServerType::HCCL_SERVER_TYPE_AICPU> hccl;
    hccl.InitV2((GM_ADDR)contextGM, nullptr);
    // AllGather<false>仅Prepare不Commit，服务端组装并下发任务的过程与下面的Add计算流水重叠
    AscendC::HcclHandle handleId =
        hccl.AllGather<false>((GM_ADDR)tmpGM, (GM_ADDR)yGM, sendCount, AscendC::HcclDataType::HCCL_DATA_TYPE_FP32, 0);
    AddCompute((GM_ADDR)x1GM, (GM_ADDR)x2GM, (GM_ADDR)tmpGM, sendCount);
    hccl.Commit(handleId);
    hccl.Wait(handleId);
    AscendC::SyncAll<true>();
    hccl.Finalize();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// 获取通信域的unfold线程：与hccl/opbase侧约定一致，unfold线程以"%s_unfold"为tag
// 持久化在COMM_ENGINE_CPU_TS通信引擎上下文中，已存在时直接复用，否则申请后落盘
HcclResult GetUnfoldThread(HcclComm comm, ThreadHandle* threadHandle)
{
    char commName[COMM_NAME_MAX_LENGTH] = {};
    HCCLCHECK(HcclGetCommName(comm, commName));
    char unfoldCtxTag[UNFOLD_TAG_MAX_LENGTH] = {};
    if (snprintf(unfoldCtxTag, sizeof(unfoldCtxTag), "%s_unfold", commName) <= 0) {
        printf("failed to fill unfoldCtxTag, commName: %s \n", commName);
        return HCCL_E_INTERNAL;
    }

    void* ctx = nullptr;
    uint64_t ctxSize = sizeof(ThreadHandle);
    if (HcclEngineCtxGet(comm, unfoldCtxTag, COMM_ENGINE_CPU_TS, &ctx, &ctxSize) == HCCL_SUCCESS && ctx != nullptr) {
        *threadHandle = *(static_cast<ThreadHandle*>(ctx));
        return HCCL_SUCCESS;
    }

    // 线程资源由通信域统一管理，无对外释放接口；若下方落盘失败，已申请线程随通信域销毁兜底释放
    HCCLCHECK(HcclThreadAcquire(comm, COMM_ENGINE_CPU, UNFOLD_THREAD_NUM, 0, threadHandle));
    HCCLCHECK(HcclEngineCtxCreate(comm, unfoldCtxTag, COMM_ENGINE_CPU_TS, sizeof(ThreadHandle), &ctx));
    CHK_PTR_NULL(ctx);
    *(static_cast<ThreadHandle*>(ctx)) = *threadHandle;
    return HCCL_SUCCESS;
}

// 获取unfold线程绑定的展开流，展开流由HCCL通信域创建并管理，调用者不可销毁
HcclResult AcquireUnfoldStream(HcclComm comm, ThreadHandle threadHandle, aclrtStream* stream)
{
    void* unfoldStream = nullptr;
    HCCLCHECK(HcclThreadResGetInfo(comm, threadHandle, THREAD_RES_TYPE_STREAM, sizeof(void*), &unfoldStream));
    *stream = static_cast<aclrtStream>(unfoldStream);
    return HCCL_SUCCESS;
}

HcclResult AllGatherAddCustom(
    void* x1Buf, void* x2Buf, void* tmpBuf, void* recvBuf, uint64_t sendCount, HcclComm comm, aclrtStream streamAiv,
    aclrtStream* unfoldStream)
{
    CHK_PTR_NULL(streamAiv);
    CHK_PTR_NULL(unfoldStream);
    CHK_PTR_NULL(comm);
    CHK_PTR_NULL(x1Buf);
    CHK_PTR_NULL(x2Buf);
    CHK_PTR_NULL(tmpBuf);
    CHK_PTR_NULL(recvBuf);

    void* ccArgs = nullptr;
    void* ccResCtx = nullptr;
    constexpr uint8_t kAicpuTsEngine = 2U; // OpExecuteConfig::AICPU_TS
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLGATHER);
    uint32_t ccResCtxSize = 0U;
    Mc2Result mc2Ret = HCCL_SUCCESS;

    mc2Ret = Mc2GetCcArgs(&ccArgs);
    if (mc2Ret != HCCL_SUCCESS) {
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcCommEngine(ccArgs, kAicpuTsEngine);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcSrcDataType(ccArgs, HCCL_DATA_TYPE_FP32);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcDstDataType(ccArgs, HCCL_DATA_TYPE_FP32);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }

    mc2Ret = Mc2AcquireCcResCtx(comm, ccType, ccArgs, &ccResCtx, &ccResCtxSize);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    HCCLCHECK(Mc2FreeCcArgs(ccArgs));

    ThreadHandle unfoldThread = 0U;
    HCCLCHECK(GetUnfoldThread(comm, &unfoldThread));
    HCCLCHECK(AcquireUnfoldStream(comm, unfoldThread, unfoldStream));

    // AICPU 通路上 Mc2CcKernelLaunch 在展开流上下发 KFC server，server 会阻塞
    // 等待 AICore client 消息，因此必须与 AICore kernel 使用不同的任务流。
    // 这里复用通信域 unfold 线程的展开流而非自建任务流，便于与 HCCL 自身通信任务混跑。
    mc2Ret = Mc2CcKernelLaunch(*unfoldStream, ccResCtx, ccResCtxSize);
    if (mc2Ret != HCCL_SUCCESS) {
        return static_cast<HcclResult>(mc2Ret);
    }

    all_gather_add_kernel<<<1, nullptr, streamAiv>>>(x1Buf, x2Buf, tmpBuf, recvBuf, ccResCtx, sendCount);

    return HCCL_SUCCESS;
}

struct ThreadContext {
    HcclRootInfo* rootInfo;
    uint32_t device;
    uint32_t devCount;
};

int Sample(void* arg)
{
    ThreadContext* ctx = static_cast<ThreadContext*>(arg);
    void* x1Buf = nullptr;
    void* x2Buf = nullptr;
    void* tmpBuf = nullptr;
    void* recvBuf = nullptr;
    uint32_t device = ctx->device;
    if (ctx->devCount > MC2_MAX_RANK_SIZE) {
        std::cout << "devCount " << ctx->devCount << " exceeds MC2_MAX_RANK_SIZE " << MC2_MAX_RANK_SIZE << std::endl;
        return HCCL_E_PARA;
    }
    constexpr uint64_t sendCount = 256;
    const uint64_t recvCount = sendCount * ctx->devCount;
    size_t sendSize = sendCount * sizeof(float);
    size_t recvSize = recvCount * sizeof(float);
    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(device)));

    HcclComm hcclComm;
    HCCLCHECK(HcclCommInitRootInfo(ctx->devCount, ctx->rootInfo, device, &hcclComm));

    aclrtStream streamAiv;
    ACLCHECK(aclrtCreateStream(&streamAiv));

    ACLCHECK(aclrtMalloc(&x1Buf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&x2Buf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&tmpBuf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&recvBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));

    void* hostBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&hostBuf, sendSize));
    float* tmpHostBuff = static_cast<float*>(hostBuf);
    for (uint64_t i = 0; i < sendCount; ++i) {
        tmpHostBuff[i] = static_cast<float>(device) + 1;
    }
    std::cout << "rankId: " << device << ", input x1/x2: [";
    for (uint64_t i = 0; i < sendCount; ++i) {
        std::cout << " " << tmpHostBuff[i];
    }
    std::cout << " ]" << std::endl;

    ACLCHECK(aclrtMemcpy(x1Buf, sendSize, hostBuf, sendSize, ACL_MEMCPY_HOST_TO_DEVICE));
    ACLCHECK(aclrtMemcpy(x2Buf, sendSize, hostBuf, sendSize, ACL_MEMCPY_HOST_TO_DEVICE));
    ACLCHECK(aclrtFreeHost(hostBuf));

    aclrtStream unfoldStream = nullptr;
    HCCLCHECK(AllGatherAddCustom(x1Buf, x2Buf, tmpBuf, recvBuf, sendCount, hcclComm, streamAiv, &unfoldStream));

    ACLCHECK(aclrtSynchronizeStream(streamAiv));
    ACLCHECK(aclrtSynchronizeStream(unfoldStream));

    void* resultBuff = nullptr;
    ACLCHECK(aclrtMallocHost(&resultBuff, recvSize));
    ACLCHECK(aclrtMemcpy(resultBuff, recvSize, recvBuf, recvSize, ACL_MEMCPY_DEVICE_TO_HOST));
    float* tmpResBuff = static_cast<float*>(resultBuff);
    std::cout << "rankId: " << device << ", recvBuf: [";
    for (uint64_t i = 0; i < recvCount; ++i) {
        std::cout << " " << tmpResBuff[i];
    }
    std::cout << " ]" << std::endl;

    bool valid = true;
    for (uint32_t r = 0; r < ctx->devCount && valid; ++r) {
        const float expected = 2 * (static_cast<float>(r) + 1);
        for (uint64_t i = 0; i < sendCount; ++i) {
            if (tmpResBuff[r * sendCount + i] != expected) {
                valid = false;
                break;
            }
        }
    }
    std::cout << "rankId: " << device << ", validation: " << (valid ? "PASS" : "FAIL") << std::endl;

    ACLCHECK(aclrtFreeHost(resultBuff));

    HCCLCHECK(HcclCommDestroy(hcclComm));
    if (x1Buf) {
        ACLCHECK(aclrtFree(x1Buf));
    }
    if (x2Buf) {
        ACLCHECK(aclrtFree(x2Buf));
    }
    if (tmpBuf) {
        ACLCHECK(aclrtFree(tmpBuf));
    }
    if (recvBuf) {
        ACLCHECK(aclrtFree(recvBuf));
    }
    ACLCHECK(aclrtDestroyStream(streamAiv));
    ACLCHECK(aclrtResetDevice(device));
    return valid ? 0 : HCCL_E_INTERNAL;
}

int main()
{
    ACLCHECK(aclInit(NULL));
    uint32_t devCount;
    ACLCHECK(aclrtGetDeviceCount(&devCount));
    std::cout << "Found " << devCount << " NPU device(s) available" << std::endl;
    if (devCount < 1) {
        std::cout << "no available NPU device" << std::endl;
        return -1;
    }

    int32_t rootRank = 0;
    ACLCHECK(aclrtSetDevice(rootRank));
    void* rootInfoBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoBuf, sizeof(HcclRootInfo)));
    HcclRootInfo* rootInfo = static_cast<HcclRootInfo*>(rootInfoBuf);
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    std::vector<std::thread> threads(devCount);
    std::vector<ThreadContext> args(devCount);
    std::vector<int> results(devCount, -1);
    for (uint32_t i = 0; i < devCount; i++) {
        args[i].rootInfo = rootInfo;
        args[i].device = i;
        args[i].devCount = devCount;
        threads[i] = std::thread([&results, &args, i]() { results[i] = Sample(static_cast<void*>(&args[i])); });
    }
    for (uint32_t i = 0; i < devCount; i++) {
        threads[i].join();
    }

    ACLCHECK(aclrtFreeHost(rootInfoBuf));
    ACLCHECK(aclFinalize());

    for (uint32_t i = 0; i < devCount; i++) {
        if (results[i] != 0) {
            std::cout << "AllGatherAdd sample failed" << std::endl;
            return -1;
        }
    }
    std::cout << "AllGatherAdd sample pass" << std::endl;
    return 0;
}
