#include <cstdio>
#include <iostream>
#include <vector>
#include <thread>

#include <acl/acl_rt.h>
#include <hccl/hccl_comm.h>
#include <hccl/hccl_types.h>

#include "adv_api/hccl/hccl.h"
#include "adv_api/hccl/hccl_mc2.h"
#include "kernel_operator.h"

#ifdef ACLCHECK
#undef ACLCHECK
#endif

#define ACLCHECK(call)                                                                            \
    do {                                                                                          \
        aclError aclRet = static_cast<aclError>(call);                                            \
        if (aclRet != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, aclRet); \
            return aclRet;                                                                        \
        }                                                                                         \
    } while (0)

#define HCCLCHECK(call)                                                                                               \
    do {                                                                                                              \
        HcclResult hcclRet = static_cast<HcclResult>(call);                                                           \
        if (hcclRet != HCCL_SUCCESS) {                                                                                \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, static_cast<int>(hcclRet)); \
            return hcclRet;                                                                                           \
        }                                                                                                             \
    } while (0)

#define CHK_PTR_NULL(ptr)       \
    do {                        \
        if ((ptr) == nullptr) { \
            return HCCL_E_PTR;  \
        }                       \
    } while (0)

constexpr uint64_t MC2_MAX_RANK_SIZE = 8;
constexpr uint64_t BASE_COUNT = 8;

// AlltoAllV收发数据量公式，Device侧kernel与Host侧真值计算共用：
// rank i发往rank j的数据量为BASE_COUNT * (1 + ((2 * i + j) % rankSize))；
// rank i从rank j接收的数据量为BASE_COUNT * (1 + ((i + 2 * j) % rankSize))。
static uint64_t GetSendCount(uint32_t rank, uint32_t peer, uint32_t rankSize)
{
    return BASE_COUNT * (1 + ((2 * rank + peer) % rankSize));
}

static uint64_t GetRecvCount(uint32_t rank, uint32_t peer, uint32_t rankSize)
{
    return BASE_COUNT * (1 + ((rank + 2 * peer) % rankSize));
}

static uint64_t GetSendTotal(uint32_t rank, uint32_t rankSize)
{
    uint64_t total = 0;
    for (uint32_t peer = 0; peer < rankSize; peer++) {
        total += GetSendCount(rank, peer, rankSize);
    }
    return total;
}

static uint64_t GetRecvTotal(uint32_t rank, uint32_t rankSize)
{
    uint64_t total = 0;
    for (uint32_t peer = 0; peer < rankSize; peer++) {
        total += GetRecvCount(rank, peer, rankSize);
    }
    return total;
}

__global__ __vector__ void all_to_all_v_kernel(__gm__ void* sendBuf, __gm__ void* recvBuf, __gm__ void* contextGM)
{
    if (g_coreType != AscendC::AIV) {
        return;
    }
    AscendC::InitSocState();
    AscendC::Hccl<AscendC::HcclServerType::HCCL_SERVER_TYPE_AICPU> hccl;
    hccl.InitV2((GM_ADDR)contextGM, nullptr);
    uint64_t sendCounts[MC2_MAX_RANK_SIZE] = {0};
    uint64_t sdispls[MC2_MAX_RANK_SIZE] = {0};
    uint64_t recvCounts[MC2_MAX_RANK_SIZE] = {0};
    uint64_t rdispls[MC2_MAX_RANK_SIZE] = {0};
    const uint32_t rankDim = hccl.GetRankDim();
    const uint32_t rankId = hccl.GetRankId();
    uint64_t sendOffset = 0;
    uint64_t recvOffset = 0;
    for (uint32_t peer = 0; peer < rankDim; peer++) {
        const uint64_t sendCnt = BASE_COUNT * (1 + ((2 * rankId + peer) % rankDim));
        const uint64_t recvCnt = BASE_COUNT * (1 + ((rankId + 2 * peer) % rankDim));
        sendCounts[peer] = sendCnt;
        sdispls[peer] = sendOffset;
        sendOffset += sendCnt;
        recvCounts[peer] = recvCnt;
        rdispls[peer] = recvOffset;
        recvOffset += recvCnt;
    }
    AscendC::HcclHandle handleId = hccl.AlltoAllV<true>(
        (GM_ADDR)sendBuf, sendCounts, sdispls, AscendC::HcclDataType::HCCL_DATA_TYPE_FP32, (GM_ADDR)recvBuf, recvCounts,
        rdispls, AscendC::HcclDataType::HCCL_DATA_TYPE_FP32);
    hccl.Wait(handleId);
    AscendC::SyncAll<true>();
    hccl.Finalize();
    AscendC::PipeBarrier<PIPE_ALL>();
}

HcclResult AllToAllVCustom(void* sendBuf, void* recvBuf, HcclComm comm, aclrtStream aicpuStream, aclrtStream streamAiv)
{
    CHK_PTR_NULL(aicpuStream);
    CHK_PTR_NULL(streamAiv);
    CHK_PTR_NULL(comm);
    CHK_PTR_NULL(sendBuf);
    CHK_PTR_NULL(recvBuf);

    void* ccArgs = nullptr;
    void* ccResCtx = nullptr;
    constexpr uint8_t kAicpuTsEngine = 2U; // OpExecuteConfig::AICPU_TS
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLTOALLV);
    uint32_t ccResCtxSize = 0U;
    Mc2Result mc2Ret = HCCL_SUCCESS;

    mc2Ret = Mc2GetCcArgs(&ccArgs);
    if (mc2Ret != HCCL_SUCCESS) {
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcCommEngine(ccArgs, kAicpuTsEngine);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcSrcDataType(ccArgs, HCCL_DATA_TYPE_FP32);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcDstDataType(ccArgs, HCCL_DATA_TYPE_FP32);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }

    mc2Ret = Mc2AcquireCcResCtx(comm, ccType, ccArgs, &ccResCtx, &ccResCtxSize);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    HCCLCHECK(Mc2FreeCcArgs(ccArgs));

    // AICPU 通路上 Mc2CcKernelLaunch 在 aicpuStream 上下发 KFC server，server 会阻塞
    // 等待 AICore client 消息，因此必须与 AICore kernel 使用不同的任务流。
    mc2Ret = Mc2CcKernelLaunch(aicpuStream, ccResCtx, ccResCtxSize);
    if (mc2Ret != HCCL_SUCCESS) {
        return static_cast<HcclResult>(mc2Ret);
    }

    all_to_all_v_kernel<<<1, nullptr, streamAiv>>>(sendBuf, recvBuf, ccResCtx);

    return HCCL_SUCCESS;
}

struct ThreadContext {
    HcclRootInfo* rootInfo;
    uint32_t device;
    uint32_t devCount;
};

int Sample(void* arg)
{
    ThreadContext* ctx = static_cast<ThreadContext*>(arg);
    void* sendBuf = nullptr;
    void* recvBuf = nullptr;
    uint32_t device = ctx->device;
    if (ctx->devCount > MC2_MAX_RANK_SIZE) {
        std::cout << "devCount " << ctx->devCount << " exceeds MC2_MAX_RANK_SIZE " << MC2_MAX_RANK_SIZE << std::endl;
        return HCCL_E_PARA;
    }

    const uint64_t sendCount = GetSendTotal(device, ctx->devCount);
    const uint64_t recvCount = GetRecvTotal(device, ctx->devCount);
    const size_t sendSize = sendCount * sizeof(float);
    const size_t recvSize = recvCount * sizeof(float);

    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(device)));

    HcclComm hcclComm;
    HCCLCHECK(HcclCommInitRootInfo(ctx->devCount, ctx->rootInfo, device, &hcclComm));

    aclrtStream aicpuStream;
    aclrtStream streamAiv;
    ACLCHECK(aclrtCreateStream(&aicpuStream));
    ACLCHECK(aclrtCreateStream(&streamAiv));

    ACLCHECK(aclrtMalloc(&sendBuf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&recvBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));

    void* hostBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&hostBuf, sendSize));
    float* inputHost = static_cast<float*>(hostBuf);
    for (uint64_t i = 0; i < sendCount; ++i) {
        inputHost[i] = static_cast<float>(device * 1000U + i);
    }
    std::cout << "rankId: " << device << ", sendCount: " << sendCount << ", recvCount: " << recvCount << std::endl;

    ACLCHECK(aclrtMemcpy(sendBuf, sendSize, hostBuf, sendSize, ACL_MEMCPY_HOST_TO_DEVICE));
    ACLCHECK(aclrtFreeHost(hostBuf));

    HCCLCHECK(AllToAllVCustom(sendBuf, recvBuf, hcclComm, aicpuStream, streamAiv));

    ACLCHECK(aclrtSynchronizeStream(streamAiv));
    ACLCHECK(aclrtSynchronizeStream(aicpuStream));

    void* resultBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&resultBuf, recvSize));
    ACLCHECK(aclrtMemcpy(resultBuf, recvSize, recvBuf, recvSize, ACL_MEMCPY_DEVICE_TO_HOST));
    float* resultHost = static_cast<float*>(resultBuf);

    // 构造真值：来自peer的数据块对应peer发送缓冲区中发往本卡的那一段
    std::vector<float> golden(recvCount, 0);
    uint64_t recvOffset = 0;
    for (uint32_t peer = 0; peer < ctx->devCount; ++peer) {
        const uint64_t recvCnt = GetRecvCount(device, peer, ctx->devCount);
        uint64_t peerSendOffset = 0;
        for (uint32_t before = 0; before < device; ++before) {
            peerSendOffset += GetSendCount(peer, before, ctx->devCount);
        }
        for (uint64_t m = 0; m < recvCnt; ++m) {
            golden[recvOffset + m] = static_cast<float>(peer * 1000U + peerSendOffset + m);
        }
        recvOffset += recvCnt;
    }

    bool valid = true;
    for (uint64_t i = 0; i < recvCount; ++i) {
        if (resultHost[i] != golden[i]) {
            std::cout << "rankId: " << device << ", mismatch at " << i << ", got " << resultHost[i] << ", expect "
                      << golden[i] << std::endl;
            valid = false;
            break;
        }
    }
    std::cout << "rankId: " << device << ", recvBuf head: [";
    for (uint64_t i = 0; i < recvCount && i < 16; ++i) {
        std::cout << " " << resultHost[i];
    }
    std::cout << " ], validation: " << (valid ? "PASS" : "FAIL") << std::endl;

    ACLCHECK(aclrtFreeHost(resultBuf));
    HCCLCHECK(HcclCommDestroy(hcclComm));
    if (sendBuf != nullptr) {
        ACLCHECK(aclrtFree(sendBuf));
    }
    if (recvBuf != nullptr) {
        ACLCHECK(aclrtFree(recvBuf));
    }
    ACLCHECK(aclrtDestroyStream(streamAiv));
    ACLCHECK(aclrtDestroyStream(aicpuStream));
    ACLCHECK(aclrtResetDevice(device));
    return valid ? 0 : HCCL_E_INTERNAL;
}

int main()
{
    ACLCHECK(aclInit(NULL));
    uint32_t devCount;
    ACLCHECK(aclrtGetDeviceCount(&devCount));
    std::cout << "Found " << devCount << " NPU device(s) available" << std::endl;
    if (devCount < 1) {
        std::cout << "no available NPU device" << std::endl;
        return -1;
    }

    int32_t rootRank = 0;
    ACLCHECK(aclrtSetDevice(rootRank));
    void* rootInfoBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoBuf, sizeof(HcclRootInfo)));
    HcclRootInfo* rootInfo = static_cast<HcclRootInfo*>(rootInfoBuf);
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    std::vector<std::thread> threads(devCount);
    std::vector<ThreadContext> args(devCount);
    std::vector<int> results(devCount, -1);
    for (uint32_t i = 0; i < devCount; i++) {
        args[i].rootInfo = rootInfo;
        args[i].device = i;
        args[i].devCount = devCount;
        threads[i] = std::thread([&results, &args, i]() { results[i] = Sample(static_cast<void*>(&args[i])); });
    }
    for (uint32_t i = 0; i < devCount; i++) {
        threads[i].join();
    }

    ACLCHECK(aclrtFreeHost(rootInfoBuf));
    ACLCHECK(aclFinalize());

    for (uint32_t i = 0; i < devCount; i++) {
        if (results[i] != 0) {
            std::cout << "AlltoAllV sample failed" << std::endl;
            return -1;
        }
    }
    std::cout << "AlltoAllV sample pass" << std::endl;
    return 0;
}
