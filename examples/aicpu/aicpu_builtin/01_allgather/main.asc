#include <cstdio>
#include <iostream>
#include <vector>
#include <thread>

#include <acl/acl_rt.h>
#include <hccl/hccl_comm.h>
#include <hccl/hccl_types.h>

#include "adv_api/hccl/hccl.h"
#include "adv_api/hccl/hccl_mc2.h"
#include "kernel_operator.h"

#ifdef ACLCHECK
#undef ACLCHECK
#endif

#define ACLCHECK(call)                                                                            \
    do {                                                                                          \
        aclError aclRet = static_cast<aclError>(call);                                            \
        if (aclRet != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, aclRet); \
            return aclRet;                                                                        \
        }                                                                                         \
    } while (0)

#define HCCLCHECK(call)                                                                                               \
    do {                                                                                                              \
        HcclResult hcclRet = static_cast<HcclResult>(call);                                                           \
        if (hcclRet != HCCL_SUCCESS) {                                                                                \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, static_cast<int>(hcclRet)); \
            return hcclRet;                                                                                           \
        }                                                                                                             \
    } while (0)

#define CHK_PTR_NULL(ptr)       \
    do {                        \
        if ((ptr) == nullptr) { \
            return HCCL_E_PTR;  \
        }                       \
    } while (0)

constexpr uint64_t MC2_MAX_RANK_SIZE = 8;
__global__ __vector__ void all_gather_kernel(
    __gm__ void* sendBuf, __gm__ void* recvBuf, __gm__ void* contextGM, uint64_t sendCount)
{
    if (g_coreType != AscendC::AIV) {
        return;
    }
    AscendC::InitSocState();
    AscendC::Hccl<AscendC::HcclServerType::HCCL_SERVER_TYPE_AICPU> hccl;
    hccl.InitV2((GM_ADDR)contextGM, nullptr);
    AscendC::HcclHandle handleId = hccl.AllGather<true>(
        (GM_ADDR)sendBuf, (GM_ADDR)recvBuf, sendCount, AscendC::HcclDataType::HCCL_DATA_TYPE_FP32, 0);
    hccl.Wait(handleId);
    AscendC::SyncAll<true>();
    hccl.Finalize();
    AscendC::PipeBarrier<PIPE_ALL>();
}

HcclResult AllGatherCustom(
    void* sendBuf, void* recvBuf, uint64_t sendCount, HcclComm comm, aclrtStream aicpuStream, aclrtStream streamAiv)
{
    CHK_PTR_NULL(aicpuStream);
    CHK_PTR_NULL(streamAiv);
    CHK_PTR_NULL(comm);
    CHK_PTR_NULL(sendBuf);
    CHK_PTR_NULL(recvBuf);

    void* ccArgs = nullptr;
    void* ccResCtx = nullptr;
    constexpr uint8_t kAicpuTsEngine = 2U; // OpExecuteConfig::AICPU_TS
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLGATHER);
    uint32_t ccResCtxSize = 0U;
    Mc2Result mc2Ret = HCCL_SUCCESS;

    mc2Ret = Mc2GetCcArgs(&ccArgs);
    if (mc2Ret != HCCL_SUCCESS) {
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcCommEngine(ccArgs, kAicpuTsEngine);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcSrcDataType(ccArgs, HCCL_DATA_TYPE_FP32);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcDstDataType(ccArgs, HCCL_DATA_TYPE_FP32);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }

    mc2Ret = Mc2AcquireCcResCtx(comm, ccType, ccArgs, &ccResCtx, &ccResCtxSize);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    HCCLCHECK(Mc2FreeCcArgs(ccArgs));

    mc2Ret = Mc2CcKernelLaunch(aicpuStream, ccResCtx, ccResCtxSize);
    if (mc2Ret != HCCL_SUCCESS) {
        return static_cast<HcclResult>(mc2Ret);
    }

    all_gather_kernel<<<1, nullptr, streamAiv>>>(sendBuf, recvBuf, ccResCtx, sendCount);

    return HCCL_SUCCESS;
}

struct ThreadContext {
    HcclRootInfo* rootInfo;
    uint32_t device;
    uint32_t devCount;
};

int Sample(void* arg)
{
    ThreadContext* ctx = static_cast<ThreadContext*>(arg);
    void* sendBuf = nullptr;
    void* recvBuf = nullptr;
    uint32_t device = ctx->device;
    if (ctx->devCount > MC2_MAX_RANK_SIZE) {
        std::cout << "devCount " << ctx->devCount << " exceeds MC2_MAX_RANK_SIZE " << MC2_MAX_RANK_SIZE << std::endl;
        return HCCL_E_PARA;
    }
    constexpr uint64_t sendCount = 256;
    const uint64_t recvCount = sendCount * ctx->devCount;
    size_t sendSize = sendCount * sizeof(float);
    size_t recvSize = recvCount * sizeof(float);
    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(device)));

    HcclComm hcclComm;
    HCCLCHECK(HcclCommInitRootInfo(ctx->devCount, ctx->rootInfo, device, &hcclComm));

    aclrtStream aicpuStream;
    aclrtStream streamAiv;
    ACLCHECK(aclrtCreateStream(&aicpuStream));
    ACLCHECK(aclrtCreateStream(&streamAiv));

    ACLCHECK(aclrtMalloc(&sendBuf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&recvBuf, recvSize, ACL_MEM_MALLOC_HUGE_ONLY));

    void* hostBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&hostBuf, sendSize));
    float* tmpHostBuff = static_cast<float*>(hostBuf);
    for (uint64_t i = 0; i < sendCount; ++i) {
        tmpHostBuff[i] = static_cast<float>(device) + 1;
    }
    std::cout << "rankId: " << device << ", input: [";
    for (uint64_t i = 0; i < sendCount; ++i) {
        std::cout << " " << tmpHostBuff[i];
    }
    std::cout << " ]" << std::endl;

    ACLCHECK(aclrtMemcpy(sendBuf, sendSize, hostBuf, sendSize, ACL_MEMCPY_HOST_TO_DEVICE));
    ACLCHECK(aclrtFreeHost(hostBuf));

    HCCLCHECK(AllGatherCustom(sendBuf, recvBuf, sendCount, hcclComm, aicpuStream, streamAiv));

    ACLCHECK(aclrtSynchronizeStream(streamAiv));
    ACLCHECK(aclrtSynchronizeStream(aicpuStream));

    void* resultBuff = nullptr;
    ACLCHECK(aclrtMallocHost(&resultBuff, recvSize));
    ACLCHECK(aclrtMemcpy(resultBuff, recvSize, recvBuf, recvSize, ACL_MEMCPY_DEVICE_TO_HOST));
    float* tmpResBuff = static_cast<float*>(resultBuff);
    std::cout << "rankId: " << device << ", recvBuf: [";
    for (uint64_t i = 0; i < recvCount; ++i) {
        std::cout << " " << tmpResBuff[i];
    }
    std::cout << " ]" << std::endl;

    bool valid = true;
    for (uint32_t r = 0; r < ctx->devCount && valid; ++r) {
        const float expected = static_cast<float>(r) + 1;
        for (uint64_t i = 0; i < sendCount; ++i) {
            if (tmpResBuff[r * sendCount + i] != expected) {
                valid = false;
                break;
            }
        }
    }
    std::cout << "rankId: " << device << ", validation: " << (valid ? "PASS" : "FAIL") << std::endl;

    ACLCHECK(aclrtFreeHost(resultBuff));

    HCCLCHECK(HcclCommDestroy(hcclComm));
    if (sendBuf) {
        ACLCHECK(aclrtFree(sendBuf));
    }
    if (recvBuf) {
        ACLCHECK(aclrtFree(recvBuf));
    }
    ACLCHECK(aclrtDestroyStream(streamAiv));
    ACLCHECK(aclrtDestroyStream(aicpuStream));
    ACLCHECK(aclrtResetDevice(device));
    return valid ? 0 : HCCL_E_INTERNAL;
}

int main()
{
    ACLCHECK(aclInit(NULL));
    uint32_t devCount;
    ACLCHECK(aclrtGetDeviceCount(&devCount));
    std::cout << "Found " << devCount << " NPU device(s) available" << std::endl;
    if (devCount < 1) {
        std::cout << "no available NPU device" << std::endl;
        return -1;
    }

    int32_t rootRank = 0;
    ACLCHECK(aclrtSetDevice(rootRank));
    void* rootInfoBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoBuf, sizeof(HcclRootInfo)));
    HcclRootInfo* rootInfo = static_cast<HcclRootInfo*>(rootInfoBuf);
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    std::vector<std::thread> threads(devCount);
    std::vector<ThreadContext> args(devCount);
    std::vector<int> results(devCount, -1);
    for (uint32_t i = 0; i < devCount; i++) {
        args[i].rootInfo = rootInfo;
        args[i].device = i;
        args[i].devCount = devCount;
        threads[i] = std::thread([&results, &args, i]() { results[i] = Sample(static_cast<void*>(&args[i])); });
    }
    for (uint32_t i = 0; i < devCount; i++) {
        threads[i].join();
    }

    ACLCHECK(aclrtFreeHost(rootInfoBuf));
    ACLCHECK(aclFinalize());

    for (uint32_t i = 0; i < devCount; i++) {
        if (results[i] != 0) {
            std::cout << "AllGather sample failed" << std::endl;
            return -1;
        }
    }
    std::cout << "AllGather sample pass" << std::endl;
    return 0;
}
