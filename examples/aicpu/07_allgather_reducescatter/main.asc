#include <cstdio>
#include <iostream>
#include <vector>
#include <thread>

#include <acl/acl_rt.h>
#include <hccl/hccl_comm.h>
#include <hccl/hccl_types.h>

#include "adv_api/hccl/hccl.h"
#include "adv_api/hccl/hccl_mc2.h"
#include "kernel_operator.h"

#ifdef ACLCHECK
#undef ACLCHECK
#endif

#define ACLCHECK(ret)                                                                          \
    do {                                                                                       \
        if (ret != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                        \
        }                                                                                      \
    } while (0)

#define HCCLCHECK(call)                                                                                               \
    do {                                                                                                              \
        HcclResult hcclRet = static_cast<HcclResult>(call);                                                           \
        if (hcclRet != HCCL_SUCCESS) {                                                                                \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, static_cast<int>(hcclRet)); \
            return hcclRet;                                                                                           \
        }                                                                                                             \
    } while (0)

#define CHK_PTR_NULL(ptr)       \
    do {                        \
        if ((ptr) == nullptr) { \
            return HCCL_E_PTR;  \
        }                       \
    } while (0)

constexpr uint64_t MC2_MAX_RANK_SIZE = 8;
// 每个 rank 参与 AllGather 的 FP32 元素个数。AllGather 输出为 SEND_COUNT * rankSize
// 个元素，恰好等于 ReduceScatter 的输入规模，因此 AllGather 输出可直接作为
// ReduceScatter 输入，无需补齐或切分。
constexpr uint64_t SEND_COUNT = 256;

// Mc2CcKernelLaunch starts the AICPU KFC server on a dedicated stream. AllGather and
// ReduceScatter are two independent kernels: one resource context (ccResCtx) serves a
// single communication command, so the two stages hold separate contexts.
__global__ __vector__ void all_gather_stage_kernel(__gm__ void* sendBuf, __gm__ void* gatherBuf, __gm__ void* contextGM)
{
    if (g_coreType != AscendC::AIV) {
        return;
    }
    AscendC::InitSocState();
    AscendC::Hccl<AscendC::HcclServerType::HCCL_SERVER_TYPE_AICPU> hccl;
    hccl.InitV2((GM_ADDR)contextGM, nullptr);
    AscendC::HcclHandle handleId = hccl.AllGather<true>(
        (GM_ADDR)sendBuf, (GM_ADDR)gatherBuf, SEND_COUNT, AscendC::HcclDataType::HCCL_DATA_TYPE_FP32, 0);
    hccl.Wait(handleId);
    AscendC::SyncAll<true>();
    hccl.Finalize();
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void reduce_scatter_stage_kernel(
    __gm__ void* gatherBuf, __gm__ void* recvBuf, __gm__ void* contextGM)
{
    if (g_coreType != AscendC::AIV) {
        return;
    }
    AscendC::InitSocState();
    AscendC::Hccl<AscendC::HcclServerType::HCCL_SERVER_TYPE_AICPU> hccl;
    hccl.InitV2((GM_ADDR)contextGM, nullptr);
    AscendC::HcclHandle handleId = hccl.ReduceScatter<true>(
        (GM_ADDR)gatherBuf, (GM_ADDR)recvBuf, SEND_COUNT, AscendC::HcclDataType::HCCL_DATA_TYPE_FP32,
        AscendC::HcclReduceOp::HCCL_REDUCE_SUM, 0);
    hccl.Wait(handleId);
    AscendC::SyncAll<true>();
    hccl.Finalize();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// 阶段一：申请 AllGather 通信资源，启动 AICPU KFC server 并下发 AllGather kernel
HcclResult AllGatherStageCustom(
    void* sendBuf, void* gatherBuf, HcclComm comm, aclrtStream aicpuStream, aclrtStream streamAiv)
{
    CHK_PTR_NULL(aicpuStream);
    CHK_PTR_NULL(streamAiv);
    CHK_PTR_NULL(comm);
    CHK_PTR_NULL(sendBuf);
    CHK_PTR_NULL(gatherBuf);

    void* ccArgs = nullptr;
    void* ccResCtx = nullptr;
    constexpr uint8_t kAicpuTsEngine = 2U; // OpExecuteConfig::AICPU_TS
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_ALLGATHER);
    uint32_t ccResCtxSize = 0U;
    Mc2Result mc2Ret = HCCL_SUCCESS;

    mc2Ret = Mc2GetCcArgs(&ccArgs);
    if (mc2Ret != HCCL_SUCCESS) {
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcCommEngine(ccArgs, kAicpuTsEngine);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcSrcDataType(ccArgs, HCCL_DATA_TYPE_FP32);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcDstDataType(ccArgs, HCCL_DATA_TYPE_FP32);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }

    mc2Ret = Mc2AcquireCcResCtx(comm, ccType, ccArgs, &ccResCtx, &ccResCtxSize);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    HCCLCHECK(Mc2FreeCcArgs(ccArgs));

    // AICPU 通路上 Mc2CcKernelLaunch 在 aicpuStream 上下发 KFC server，server 会阻塞
    // 等待 AICore client 消息，因此必须与 AICore kernel 使用不同的任务流。
    Mc2CcKernelLaunch(aicpuStream, ccResCtx, ccResCtxSize);

    all_gather_stage_kernel<<<1, nullptr, streamAiv>>>(sendBuf, gatherBuf, ccResCtx);

    return HCCL_SUCCESS;
}

// 阶段二：按 HCCL_CMD_REDUCE_SCATTER 重新申请通信资源并下发 ReduceScatter kernel。
// AllGather 与 ReduceScatter 不能共用同一 ccResCtx，须独立申请。
HcclResult ReduceScatterStageCustom(
    void* gatherBuf, void* recvBuf, HcclComm comm, aclrtStream aicpuStream, aclrtStream streamAiv)
{
    CHK_PTR_NULL(aicpuStream);
    CHK_PTR_NULL(streamAiv);
    CHK_PTR_NULL(comm);
    CHK_PTR_NULL(gatherBuf);
    CHK_PTR_NULL(recvBuf);

    void* ccArgs = nullptr;
    void* ccResCtx = nullptr;
    constexpr uint8_t kAicpuTsEngine = 2U; // OpExecuteConfig::AICPU_TS
    const uint8_t ccType = static_cast<uint8_t>(AscendC::HcclCMDType::HCCL_CMD_REDUCE_SCATTER);
    uint32_t ccResCtxSize = 0U;
    Mc2Result mc2Ret = HCCL_SUCCESS;

    mc2Ret = Mc2GetCcArgs(&ccArgs);
    if (mc2Ret != HCCL_SUCCESS) {
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcCommEngine(ccArgs, kAicpuTsEngine);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcSrcDataType(ccArgs, HCCL_DATA_TYPE_FP32);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcDstDataType(ccArgs, HCCL_DATA_TYPE_FP32);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    mc2Ret = Mc2SetCcReduceType(ccArgs, static_cast<uint8_t>(HCCL_REDUCE_SUM));
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }

    mc2Ret = Mc2AcquireCcResCtx(comm, ccType, ccArgs, &ccResCtx, &ccResCtxSize);
    if (mc2Ret != HCCL_SUCCESS) {
        (void)Mc2FreeCcArgs(ccArgs);
        return static_cast<HcclResult>(mc2Ret);
    }
    HCCLCHECK(Mc2FreeCcArgs(ccArgs));

    Mc2CcKernelLaunch(aicpuStream, ccResCtx, ccResCtxSize);

    reduce_scatter_stage_kernel<<<1, nullptr, streamAiv>>>(gatherBuf, recvBuf, ccResCtx);

    return HCCL_SUCCESS;
}

struct ThreadContext {
    HcclRootInfo* rootInfo;
    uint32_t device;
    uint32_t devCount;
};

int Sample(void* arg)
{
    ThreadContext* ctx = static_cast<ThreadContext*>(arg);
    void* sendBuf = nullptr;
    void* gatherBuf = nullptr;
    void* recvBuf = nullptr;
    uint32_t device = ctx->device;
    if (ctx->devCount > MC2_MAX_RANK_SIZE) {
        std::cout << "devCount " << ctx->devCount << " exceeds MC2_MAX_RANK_SIZE " << MC2_MAX_RANK_SIZE << std::endl;
        return HCCL_E_PARA;
    }
    const uint64_t gatherCount = SEND_COUNT * ctx->devCount;
    const size_t sendSize = SEND_COUNT * sizeof(float);
    const size_t gatherSize = gatherCount * sizeof(float);
    // 设置当前线程操作的设备
    ACLCHECK(aclrtSetDevice(static_cast<int32_t>(device)));

    // 初始化集合通信域
    HcclComm hcclComm;
    HCCLCHECK(HcclCommInitRootInfo(ctx->devCount, ctx->rootInfo, device, &hcclComm));

    // 创建任务流：AICPU KFC server 与 AICore kernel 各用一条
    aclrtStream aicpuStream;
    aclrtStream streamAiv;
    ACLCHECK(aclrtCreateStream(&aicpuStream));
    ACLCHECK(aclrtCreateStream(&streamAiv));

    // 申请 Device 内存，gatherBuf 同时作为 AllGather 输出和 ReduceScatter 输入
    ACLCHECK(aclrtMalloc(&sendBuf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&gatherBuf, gatherSize, ACL_MEM_MALLOC_HUGE_ONLY));
    ACLCHECK(aclrtMalloc(&recvBuf, sendSize, ACL_MEM_MALLOC_HUGE_ONLY));

    // 申请 Host 内存用于存放输入数据，并将内容初始化为 Device ID
    void* hostBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&hostBuf, sendSize));
    float* tmpHostBuff = static_cast<float*>(hostBuf);
    for (uint64_t i = 0; i < SEND_COUNT; ++i) {
        tmpHostBuff[i] = static_cast<float>(device) + 1;
    }
    std::cout << "rankId: " << device << ", input: [";
    for (uint64_t i = 0; i < SEND_COUNT; ++i) {
        std::cout << " " << tmpHostBuff[i];
    }
    std::cout << " ]" << std::endl;

    // 将 Host 侧输入数据拷贝到 Device 侧
    ACLCHECK(aclrtMemcpy(sendBuf, sendSize, hostBuf, sendSize, ACL_MEMCPY_HOST_TO_DEVICE));
    // 释放 Host 侧内存
    ACLCHECK(aclrtFreeHost(hostBuf));

    // 阶段一：执行 AllGather，将通信域内所有 rank 的 sendBuf 按照 rank_id 顺序拼接到 gatherBuf
    HCCLCHECK(AllGatherStageCustom(sendBuf, gatherBuf, hcclComm, aicpuStream, streamAiv));
    // 先等待 AICore client 完成，再等待收到 Finalize 消息后退出的 AICPU server
    ACLCHECK(aclrtSynchronizeStream(streamAiv));
    ACLCHECK(aclrtSynchronizeStream(aicpuStream));

    // 阶段二：执行 ReduceScatter，将各 rank 的 gatherBuf 按元素求和后按 rank_id 切分，
    // 每个 rank 收到第 rank_id 块
    HCCLCHECK(ReduceScatterStageCustom(gatherBuf, recvBuf, hcclComm, aicpuStream, streamAiv));
    ACLCHECK(aclrtSynchronizeStream(streamAiv));
    ACLCHECK(aclrtSynchronizeStream(aicpuStream));

    // 将两级结果拷贝回 Host，并打印、校验
    void* gatherHost = nullptr;
    ACLCHECK(aclrtMallocHost(&gatherHost, gatherSize));
    ACLCHECK(aclrtMemcpy(gatherHost, gatherSize, gatherBuf, gatherSize, ACL_MEMCPY_DEVICE_TO_HOST));
    float* gatherResult = static_cast<float*>(gatherHost);
    std::cout << "rankId: " << device << ", allgather output: [";
    for (uint64_t i = 0; i < gatherCount; ++i) {
        std::cout << " " << gatherResult[i];
    }
    std::cout << " ]" << std::endl;

    void* resultBuff = nullptr;
    ACLCHECK(aclrtMallocHost(&resultBuff, sendSize));
    ACLCHECK(aclrtMemcpy(resultBuff, sendSize, recvBuf, sendSize, ACL_MEMCPY_DEVICE_TO_HOST));
    float* tmpResBuff = static_cast<float*>(resultBuff);
    std::cout << "rankId: " << device << ", reducescatter output: [";
    for (uint64_t i = 0; i < SEND_COUNT; ++i) {
        std::cout << " " << tmpResBuff[i];
    }
    std::cout << " ]" << std::endl;

    // 阶段一校验：gatherBuf 中第 r 个数据块应全部为 r + 1
    bool valid = true;
    for (uint32_t r = 0; r < ctx->devCount && valid; ++r) {
        const float expected = static_cast<float>(r) + 1;
        for (uint64_t i = 0; i < SEND_COUNT; ++i) {
            if (gatherResult[r * SEND_COUNT + i] != expected) {
                valid = false;
                break;
            }
        }
    }
    std::cout << "rankId: " << device << ", allgather stage validation: " << (valid ? "PASS" : "FAIL") << std::endl;

    // 阶段二校验：各 rank 的 ReduceScatter 输入均为 AllGather 输出且内容一致，
    // 求和后第 rank_id 块等于 rankSize 份 (rank_id + 1)，即每个元素为 rankSize * (device + 1)
    bool scatterValid = true;
    const float scatterExpected = static_cast<float>(ctx->devCount * (device + 1));
    for (uint64_t i = 0; i < SEND_COUNT; ++i) {
        if (tmpResBuff[i] != scatterExpected) {
            scatterValid = false;
            break;
        }
    }
    std::cout << "rankId: " << device << ", expected: " << scatterExpected
              << ", reducescatter stage validation: " << (scatterValid ? "PASS" : "FAIL") << std::endl;
    valid = valid && scatterValid;

    ACLCHECK(aclrtFreeHost(gatherHost));
    ACLCHECK(aclrtFreeHost(resultBuff));

    // 释放资源
    HCCLCHECK(HcclCommDestroy(hcclComm)); // 销毁通信域
    if (sendBuf) {
        ACLCHECK(aclrtFree(sendBuf)); // 释放 Device 侧内存
    }
    if (gatherBuf) {
        ACLCHECK(aclrtFree(gatherBuf)); // 释放 Device 侧内存
    }
    if (recvBuf) {
        ACLCHECK(aclrtFree(recvBuf)); // 释放 Device 侧内存
    }
    ACLCHECK(aclrtDestroyStream(streamAiv));   // 销毁 AICore 任务流
    ACLCHECK(aclrtDestroyStream(aicpuStream)); // 销毁 AICPU 任务流
    ACLCHECK(aclrtResetDevice(device));        // 重置设备
    return valid ? 0 : HCCL_E_INTERNAL;
}

int main()
{
    // 设备资源初始化
    ACLCHECK(aclInit(NULL));
    // 查询设备数量
    uint32_t devCount;
    ACLCHECK(aclrtGetDeviceCount(&devCount));
    std::cout << "Found " << devCount << " NPU device(s) available" << std::endl;
    if (devCount < 1) {
        std::cout << "no available NPU device" << std::endl;
        return -1;
    }

    int32_t rootRank = 0;
    ACLCHECK(aclrtSetDevice(rootRank));
    // 生成 Root 节点信息，各线程使用同一份 RootInfo
    void* rootInfoBuf = nullptr;
    ACLCHECK(aclrtMallocHost(&rootInfoBuf, sizeof(HcclRootInfo)));
    HcclRootInfo* rootInfo = static_cast<HcclRootInfo*>(rootInfoBuf);
    HCCLCHECK(HcclGetRootInfo(rootInfo));

    // 启动线程执行集合通信操作
    std::vector<std::thread> threads(devCount);
    std::vector<ThreadContext> args(devCount);
    std::vector<int> results(devCount, -1);
    for (uint32_t i = 0; i < devCount; i++) {
        args[i].rootInfo = rootInfo;
        args[i].device = i;
        args[i].devCount = devCount;
        threads[i] = std::thread([&results, &args, i]() { results[i] = Sample(static_cast<void*>(&args[i])); });
    }
    for (uint32_t i = 0; i < devCount; i++) {
        threads[i].join();
    }

    // 释放资源
    ACLCHECK(aclrtFreeHost(rootInfoBuf)); // 释放 Host 内存
    ACLCHECK(aclFinalize());              // 设备去初始化

    for (uint32_t i = 0; i < devCount; i++) {
        if (results[i] != 0) {
            std::cout << "AllGatherReduceScatter sample failed" << std::endl;
            return -1;
        }
    }
    std::cout << "AllGatherReduceScatter sample pass" << std::endl;
    return 0;
}
