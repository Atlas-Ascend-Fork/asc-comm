/*!
 * \file send_with_imm.asc
 * \brief asccomm_send_with_imm_on_thread 双卡端到端真机样例的 Host 侧流程。
 *
 * 每个 rank 建 UB_CTP 通道与 AICPU_TS 线程资源，把用例表拷到设备侧，由 AICPU Kernel
 * 逐个调用 asccomm_send_with_imm_on_thread，Host 侧回读结果并断言返回码、WQE 内容与 pi 推进。
 */

#include <cstdio>
#include <cstring>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "hccl/hccl.h"
#include "hccl/hccl_comm.h"
#include "hccl/hccl_rank_graph.h"
#include "hccl/hccl_res.h"
#include "hccl/hccl_types.h"
#include "hcomm_res_entity_defs.h"

#include "utils/arg_parser.h"
#include "utils/check.h"
#include "utils/hccl_comm_init.h"
#include "utils/process_manager.h"
#include "utils/rank_sync.h"

#include "send_with_imm_def.h"

// AICPU Kernel 入口，实现见 send_with_imm_kernel.aicpu。
extern __global__ __aicpu__ uint32_t send_with_imm_case_kernel(SendWithImmExample::KernelArgs args);

namespace {

using SendWithImmExample::CaseArgs;
using SendWithImmExample::CaseResult;
using SendWithImmExample::KernelContext;

constexpr const char* MEMORY_TAG = "swiBuf";
constexpr uint32_t THREAD_NOTIFY_NUM = 0U;
constexpr int32_t KERNEL_SYNC_TIMEOUT_MS = 60000;
constexpr CommProtocol UB_PROTOCOL = COMM_PROTOCOL_UB_CTP;

// Host 侧同步点 tag。
constexpr uint32_t kTagReady = examples::kTagUserBase;
constexpr uint32_t kTagSent = examples::kTagUserBase + 1U;

struct CaseSpec {
    uint32_t caseType;
    uint64_t len;
    uint32_t immData;
    int32_t expectRet;
    const char* name;
};

// 用例表：正向覆盖 immData 边界与多切片分片，负向覆盖参数与协议拒绝路径。
// 数量必须与 SendWithImmExample::MAX_CASE_NUM 一致。
const CaseSpec CASE_TABLE[] = {
    {SendWithImmExample::CASE_POSITIVE, SendWithImmExample::DATA_SIZE, 0xA5A5A5A5U, SendWithImmExample::RET_SUCCESS,
     "positive/typical"},
    {SendWithImmExample::CASE_POSITIVE, 1ULL, 0x00000000U, SendWithImmExample::RET_SUCCESS, "positive/min-len-imm-low"},
    {SendWithImmExample::CASE_POSITIVE, SendWithImmExample::DATA_SIZE, 0xFFFFFFFFU, SendWithImmExample::RET_SUCCESS,
     "positive/imm-high"},
    {SendWithImmExample::CASE_POSITIVE, SendWithImmExample::MULTI_SLICE_LEN, 0x5A5A5A5AU,
     SendWithImmExample::RET_SUCCESS, "positive/multi-slice"},
    {SendWithImmExample::CASE_ZERO_LENGTH, 0ULL, 0x12345678U, SendWithImmExample::RET_SUCCESS, "zero-length"},
    {SendWithImmExample::CASE_NULL_SRC, SendWithImmExample::DATA_SIZE, 0U, SendWithImmExample::RET_E_PTR, "null-src"},
    {SendWithImmExample::CASE_BAD_THREAD, SendWithImmExample::DATA_SIZE, 0U, SendWithImmExample::RET_E_PTR,
     "bad-thread-magic"},
    {SendWithImmExample::CASE_NON_UB, SendWithImmExample::DATA_SIZE, 0U, SendWithImmExample::RET_E_NOT_SUPPORT,
     "non-ub-protocol"},
};
constexpr uint32_t CASE_NUM = sizeof(CASE_TABLE) / sizeof(CASE_TABLE[0]);
static_assert(CASE_NUM <= SendWithImmExample::MAX_CASE_NUM, "case table exceeds KernelContext capacity");

struct RankCtx {
    ~RankCtx()
    {
        if (devContext != nullptr) {
            aclrtFree(devContext);
        }
        if (devBuf != nullptr) {
            aclrtFree(devBuf);
        }
        if (comm != nullptr) {
            HcclCommDestroy(comm);
        }
        if (stream != nullptr) {
            aclrtDestroyStream(stream);
        }
        if (isDevSet) {
            aclrtResetDevice(rankId);
        }
        if (aclInitialized) {
            aclFinalize();
        }
    }

    RankCtx(const RankCtx&) = delete;
    RankCtx& operator=(const RankCtx&) = delete;

    uint32_t rankId{0};
    uint32_t peerRank{0};
    bool aclInitialized{false};
    bool isDevSet{false};
    aclrtStream stream{nullptr};
    HcclComm comm{nullptr};
    void* devBuf{nullptr};
    void* devContext{nullptr};
    HcclMemHandle memHandle{nullptr};
    ChannelHandle channel{0};
    ThreadHandle thread{0};
};

// 发送数据填充为 rank 相关的可校验图案：第 0 字节是 rankId，其余是 rankId + index。
uint8_t GetDataValue(uint32_t rank, uint32_t index)
{
    return index == 0U ? static_cast<uint8_t>(rank) : static_cast<uint8_t>(rank + index);
}

template <typename T>
bool ExpectEq(uint32_t rank, const char* caseName, const char* field, T actual, T expected)
{
    if (actual == expected) {
        return true;
    }
    std::fprintf(
        stderr, "[ERROR] rank %u case[%s]: %s mismatch, actual=%llu, expected=%llu\n", rank, caseName, field,
        static_cast<unsigned long long>(actual), static_cast<unsigned long long>(expected));
    return false;
}

int32_t AclInit(RankCtx& ctx)
{
    EXAMPLES_CHECK(aclInit(nullptr), ACL_SUCCESS, ctx.rankId);
    ctx.aclInitialized = true;
    EXAMPLES_CHECK(aclrtSetDevice(ctx.rankId), ACL_SUCCESS, ctx.rankId);
    ctx.isDevSet = true;
    EXAMPLES_CHECK(aclrtCreateStream(&ctx.stream), ACL_SUCCESS, ctx.rankId);
    return SendWithImmExample::SUCCESS;
}

int32_t AllocDevMem(RankCtx& ctx)
{
    EXAMPLES_CHECK(
        aclrtMalloc(&ctx.devBuf, SendWithImmExample::COMM_BUF_SIZE, ACL_MEM_MALLOC_HUGE_ONLY), ACL_SUCCESS, ctx.rankId);
    EXAMPLES_CHECK(
        aclrtMalloc(&ctx.devContext, sizeof(KernelContext), ACL_MEM_MALLOC_HUGE_ONLY), ACL_SUCCESS, ctx.rankId);
    if (ctx.devBuf == nullptr || ctx.devContext == nullptr) {
        std::fprintf(stderr, "[ERROR] rank %u: allocate device memory failed\n", ctx.rankId);
        return SendWithImmExample::FAIL;
    }
    return SendWithImmExample::SUCCESS;
}

int32_t RegisterMem(RankCtx& ctx)
{
    CommMem memory = {};
    memory.type = COMM_MEM_TYPE_DEVICE;
    memory.addr = ctx.devBuf;
    memory.size = SendWithImmExample::COMM_BUF_SIZE;
    EXAMPLES_CHECK(HcclCommMemReg(ctx.comm, MEMORY_TAG, &memory, &ctx.memHandle), HCCL_SUCCESS, ctx.rankId);
    if (ctx.memHandle == nullptr) {
        std::fprintf(stderr, "[ERROR] rank %u: HcclCommMemReg failed\n", ctx.rankId);
        return SendWithImmExample::FAIL;
    }
    return SendWithImmExample::SUCCESS;
}

// 在 rank 图上找到通往对端的 UB_CTP 链路，并按 AICPU_TS 引擎申请通道。
int32_t AcquireUbChannel(RankCtx& ctx)
{
    uint32_t* networkLayers = nullptr;
    uint32_t layerNum = 0U;
    EXAMPLES_CHECK(HcclRankGraphGetLayers(ctx.comm, &networkLayers, &layerNum), HCCL_SUCCESS, ctx.rankId);
    if (layerNum == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: HcclRankGraphGetLayers returned no layer\n", ctx.rankId);
        return SendWithImmExample::FAIL;
    }

    CommLink* links = nullptr;
    uint32_t linkNum = 0U;
    EXAMPLES_CHECK(
        HcclRankGraphGetLinks(ctx.comm, networkLayers[0], ctx.rankId, ctx.peerRank, &links, &linkNum), HCCL_SUCCESS,
        ctx.rankId);
    if (links == nullptr || linkNum == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: no link to peer rank %u\n", ctx.rankId, ctx.peerRank);
        return SendWithImmExample::FAIL;
    }

    HcclChannelDesc desc;
    EXAMPLES_CHECK(HcclChannelDescInit(&desc, 1U), HCCL_SUCCESS, ctx.rankId);
    bool found = false;
    for (uint32_t i = 0; i < linkNum; ++i) {
        if (links[i].linkAttr.linkProtocol != UB_PROTOCOL) {
            continue;
        }
        desc.remoteRank = ctx.peerRank;
        desc.channelProtocol = UB_PROTOCOL;
        desc.notifyNum = 0U;
        desc.memHandles = &ctx.memHandle;
        desc.memHandleNum = 1U;
        desc.localEndpoint = links[i].srcEndpointDesc;
        desc.remoteEndpoint = links[i].dstEndpointDesc;
        found = true;
        break;
    }
    if (!found) {
        std::fprintf(stderr, "[ERROR] rank %u: no UB_CTP link to peer rank %u\n", ctx.rankId, ctx.peerRank);
        return SendWithImmExample::FAIL;
    }

    EXAMPLES_CHECK(
        HcclChannelAcquire(ctx.comm, COMM_ENGINE_AICPU_TS, &desc, 1U, &ctx.channel), HCCL_SUCCESS, ctx.rankId);
    if (ctx.channel == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: HcclChannelAcquire failed\n", ctx.rankId);
        return SendWithImmExample::FAIL;
    }
    return SendWithImmExample::SUCCESS;
}

int32_t AcquireThread(RankCtx& ctx)
{
    EXAMPLES_CHECK(
        HcclThreadAcquireWithStream(ctx.comm, COMM_ENGINE_AICPU_TS, ctx.stream, THREAD_NOTIFY_NUM, &ctx.thread),
        HCCL_SUCCESS, ctx.rankId);
    if (ctx.thread == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u: HcclThreadAcquireWithStream failed\n", ctx.rankId);
        return SendWithImmExample::FAIL;
    }
    return SendWithImmExample::SUCCESS;
}

// asc-comm 数据面要求句柄是 POD 资源实体地址。控制面版本不匹配时在此提前失败，
// 避免下发到 AICPU 后只看到 ASCCOMM_E_PTR 而难以定位。
int32_t CheckPodAbi(RankCtx& ctx)
{
    struct {
        CommAbiHeader thread;
        CommAbiHeader channel;
    } headers = {};
    EXAMPLES_CHECK(
        aclrtMemcpy(
            &headers.thread, sizeof(CommAbiHeader), reinterpret_cast<void*>(ctx.thread), sizeof(CommAbiHeader),
            ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, ctx.rankId);
    EXAMPLES_CHECK(
        aclrtMemcpy(
            &headers.channel, sizeof(CommAbiHeader), reinterpret_cast<void*>(ctx.channel), sizeof(CommAbiHeader),
            ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, ctx.rankId);
    if (headers.thread.magicWord != HCOMM_RESOURCE_THREAD_MAGIC_WORD ||
        headers.thread.version != HCOMM_RESOURCE_THREAD_VERSION) {
        std::fprintf(
            stderr,
            "[ERROR] rank %u: ThreadHandle is not a POD v2 ThreadEntity (version=%u, magicWord=0x%x); "
            "the control plane does not match include/aicpu/hcomm/hcomm_res_entity_defs.h\n",
            ctx.rankId, headers.thread.version, headers.thread.magicWord);
        return SendWithImmExample::FAIL;
    }
    if (headers.channel.magicWord != HCOMM_RESOURCE_CHANNEL_MAGIC_WORD ||
        headers.channel.version != HCOMM_RESOURCE_CHANNEL_VERSION) {
        std::fprintf(
            stderr,
            "[ERROR] rank %u: ChannelHandle is not a POD v2 ChannelEntity (version=%u, magicWord=0x%x); "
            "the control plane does not match include/aicpu/hcomm/hcomm_res_entity_defs.h\n",
            ctx.rankId, headers.channel.version, headers.channel.magicWord);
        return SendWithImmExample::FAIL;
    }
    return SendWithImmExample::SUCCESS;
}

int32_t InitSendBuffer(RankCtx& ctx)
{
    std::vector<uint8_t> hostBuffer(static_cast<size_t>(SendWithImmExample::COMM_BUF_SIZE), 0U);
    for (uint32_t i = 0; i < SendWithImmExample::DATA_SIZE; ++i) {
        hostBuffer[SendWithImmExample::SEND_DATA_OFFSET + i] = GetDataValue(ctx.rankId, i);
    }
    EXAMPLES_CHECK(
        aclrtMemcpy(
            ctx.devBuf, SendWithImmExample::COMM_BUF_SIZE, hostBuffer.data(), SendWithImmExample::COMM_BUF_SIZE,
            ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, ctx.rankId);
    return SendWithImmExample::SUCCESS;
}

void BuildCases(RankCtx& ctx, KernelContext& context)
{
    context.caseNum = CASE_NUM;
    context.reserved = 0U;
    const uint64_t srcAddr = reinterpret_cast<uint64_t>(ctx.devBuf) + SendWithImmExample::SEND_DATA_OFFSET;
    for (uint32_t i = 0; i < CASE_NUM; ++i) {
        CaseArgs& args = context.args[i];
        args.threadHandle = ctx.thread;
        args.channelHandle = ctx.channel;
        args.srcAddr = CASE_TABLE[i].caseType == SendWithImmExample::CASE_NULL_SRC ? 0ULL : srcAddr;
        args.len = CASE_TABLE[i].len;
        args.immData = CASE_TABLE[i].immData;
        args.caseType = CASE_TABLE[i].caseType;
        args.expectRet = CASE_TABLE[i].expectRet;
        args.reserved = 0U;
    }
}

int32_t RunKernel(RankCtx& ctx, const KernelContext& context)
{
    EXAMPLES_CHECK(
        aclrtMemcpy(ctx.devContext, sizeof(KernelContext), &context, sizeof(KernelContext), ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, ctx.rankId);

    SendWithImmExample::KernelArgs args = {};
    args.context = reinterpret_cast<KernelContext*>(ctx.devContext);
    send_with_imm_case_kernel<<<1, 0, ctx.stream>>>(args);

    const aclError syncRet = aclrtSynchronizeStreamWithTimeout(ctx.stream, KERNEL_SYNC_TIMEOUT_MS);
    if (syncRet != ACL_SUCCESS) {
        std::fprintf(
            stderr, "[ERROR] rank %u: AICPU kernel did not finish within %d ms, ret=%d\n", ctx.rankId,
            KERNEL_SYNC_TIMEOUT_MS, static_cast<int32_t>(syncRet));
        return SendWithImmExample::FAIL;
    }
    return SendWithImmExample::SUCCESS;
}

int32_t VerifyPositiveCase(
    RankCtx& ctx, const CaseArgs& args, const CaseResult& result, const char* caseName, bool& passed)
{
    const auto& wqe = result.wqe;
    passed &= ExpectEq(ctx.rankId, caseName, "jfsValid", wqe.jfsValid, 1U);
    if (wqe.jfsValid == 0U || wqe.maxWriteSize == 0U) {
        std::fprintf(stderr, "[ERROR] rank %u case[%s]: channel has no usable UB JFS context\n", ctx.rankId, caseName);
        return SendWithImmExample::FAIL;
    }

    const uint32_t sliceNum = SendWithImmExample::ExpectSliceNum(args.len, wqe.maxWriteSize);
    const uint32_t expectPi = (wqe.piBefore + sliceNum) & SendWithImmExample::PI_MASK;
    passed &= ExpectEq(ctx.rankId, caseName, "piAfter", wqe.piAfter, expectPi);
    if (args.len == 0ULL) {
        // len 为 0 时不产生 WQE，也不应回读到新的 SQE。
        passed &= ExpectEq(ctx.rankId, caseName, "wqeValid", wqe.wqeValid, 0U);
        return SendWithImmExample::SUCCESS;
    }

    passed &= ExpectEq(ctx.rankId, caseName, "wqeValid", wqe.wqeValid, 1U);
    if (wqe.wqeValid == 0U) {
        return SendWithImmExample::SUCCESS;
    }
    const uint64_t firstSliceLen = args.len < wqe.maxWriteSize ? args.len : static_cast<uint64_t>(wqe.maxWriteSize);
    const uint32_t expectSgeLen = static_cast<uint32_t>(firstSliceLen);
    passed &= ExpectEq(ctx.rankId, caseName, "opcode", wqe.opcode, SendWithImmExample::OPC_SEND_WITH_IMM);
    passed &= ExpectEq(ctx.rankId, caseName, "immDataLow", wqe.immDataLow, args.immData);
    passed &= ExpectEq(ctx.rankId, caseName, "immDataHigh", wqe.immDataHigh, 0U);
    passed &= ExpectEq(ctx.rankId, caseName, "inlineEn", wqe.inlineEn, 0U);
    passed &= ExpectEq(ctx.rankId, caseName, "sgeNum", wqe.sgeNum, 1U);
    passed &= ExpectEq(ctx.rankId, caseName, "sgeAddr", wqe.sgeAddr, args.srcAddr);
    passed &= ExpectEq(ctx.rankId, caseName, "sgeLength", wqe.sgeLength, expectSgeLen);
    // 只有 ONLY/LAST 切片置 cqe，首片在多切片场景下不置位。
    passed &= ExpectEq(ctx.rankId, caseName, "cqe", wqe.cqe, sliceNum == 1U ? 1U : 0U);
    return SendWithImmExample::SUCCESS;
}

int32_t VerifyCases(RankCtx& ctx, const KernelContext& context)
{
    bool allPassed = true;
    for (uint32_t i = 0; i < context.caseNum; ++i) {
        const CaseArgs& args = context.args[i];
        const CaseResult& result = context.results[i];
        const char* caseName = CASE_TABLE[i].name;

        bool passed = ExpectEq(ctx.rankId, caseName, "apiRet", result.apiRet, args.expectRet);
        if (args.expectRet != SendWithImmExample::RET_SUCCESS) {
            // 拒绝路径不得推进 pi，即不产生任何 WQE。
            passed &= ExpectEq(ctx.rankId, caseName, "piUnchanged", result.wqe.piAfter, result.wqe.piBefore);
        } else if (VerifyPositiveCase(ctx, args, result, caseName, passed) != SendWithImmExample::SUCCESS) {
            passed = false;
        }

        std::printf(
            "[rank %u] case[%s] apiRet=%d expectRet=%d pi %u->%u sliceNum=%u | %s\n", ctx.rankId, caseName,
            result.apiRet, args.expectRet, result.wqe.piBefore, result.wqe.piAfter,
            SendWithImmExample::ExpectSliceNum(args.len, result.wqe.maxWriteSize), passed ? "PASS" : "FAIL");
        allPassed &= passed;
    }
    return allPassed ? SendWithImmExample::SUCCESS : SendWithImmExample::FAIL;
}

// 双边 SEND_WITH_IMM 的立即数由对端特殊 CQE 承载，asc-comm 数据面当前没有 recv/poll CQE 接口，
// 因此这里只观测对端数据落地区，作为非门禁诊断信息输出。
int32_t ReportPeerPayload(RankCtx& ctx)
{
    std::vector<uint8_t> hostBuffer(static_cast<size_t>(SendWithImmExample::COMM_BUF_SIZE), 0U);
    EXAMPLES_CHECK(
        aclrtMemcpy(
            hostBuffer.data(), SendWithImmExample::COMM_BUF_SIZE, ctx.devBuf, SendWithImmExample::COMM_BUF_SIZE,
            ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, ctx.rankId);

    bool observed = true;
    for (uint32_t i = 0; i < SendWithImmExample::DATA_SIZE; ++i) {
        if (hostBuffer[SendWithImmExample::RECV_DATA_OFFSET + i] != GetDataValue(ctx.peerRank, i)) {
            observed = false;
            break;
        }
    }
    std::printf(
        "[rank %u] PEER_PAYLOAD | from rank %u | Status=%s\n", ctx.rankId, ctx.peerRank,
        observed ? "OBSERVED" : "NOT_LANDED");
    if (!observed) {
        std::printf(
            "[rank %u] PEER_PAYLOAD note: SEND_WITH_IMM is two-sided; the immediate and the landing buffer are\n"
            "              delivered through the peer receive CQE, which the asc-comm data plane does not expose "
            "yet.\n",
            ctx.rankId);
    }
    return SendWithImmExample::SUCCESS;
}

int32_t SendWithImmRank(uint32_t rank, uint32_t nranks, const std::string& ctrlEndpoint)
{
    RankCtx ctx{};
    ctx.rankId = rank;
    ctx.peerRank = (rank + 1U) % nranks;

    examples::RankSyncContext sync = rank == 0U ? examples::RankSyncContext::Listen(ctrlEndpoint, nranks) :
                                                  examples::RankSyncContext::Connect(rank, nranks, ctrlEndpoint);
    if (!sync.Ok()) {
        std::fprintf(stderr, "[ERROR] rank %u: control channel setup failed\n", ctx.rankId);
        return SendWithImmExample::FAIL;
    }

    EXAMPLES_CHECK(AclInit(ctx), SendWithImmExample::SUCCESS, ctx.rankId);

    HcclCommConfig config;
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = ctx.rankId;
    EXAMPLES_CHECK(examples::InitCommByRootInfoConfig(sync, &config, &ctx.comm), HCCL_SUCCESS, ctx.rankId);
    EXAMPLES_CHECK(AllocDevMem(ctx), SendWithImmExample::SUCCESS, ctx.rankId);
    EXAMPLES_CHECK(RegisterMem(ctx), SendWithImmExample::SUCCESS, ctx.rankId);
    EXAMPLES_CHECK(AcquireUbChannel(ctx), SendWithImmExample::SUCCESS, ctx.rankId);
    EXAMPLES_CHECK(AcquireThread(ctx), SendWithImmExample::SUCCESS, ctx.rankId);
    EXAMPLES_CHECK(CheckPodAbi(ctx), SendWithImmExample::SUCCESS, ctx.rankId);
    EXAMPLES_CHECK(InitSendBuffer(ctx), SendWithImmExample::SUCCESS, ctx.rankId);

    KernelContext context = {};
    BuildCases(ctx, context);
    if (!sync.Barrier(kTagReady)) {
        std::fprintf(stderr, "[ERROR] rank %u: ready barrier failed\n", ctx.rankId);
        return SendWithImmExample::FAIL;
    }

    EXAMPLES_CHECK(RunKernel(ctx, context), SendWithImmExample::SUCCESS, ctx.rankId);

    KernelContext deviceContext = {};
    EXAMPLES_CHECK(
        aclrtMemcpy(
            &deviceContext, sizeof(KernelContext), ctx.devContext, sizeof(KernelContext), ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, ctx.rankId);
    const int32_t verifyRet = VerifyCases(ctx, deviceContext);

    if (!sync.Barrier(kTagSent)) {
        std::fprintf(stderr, "[ERROR] rank %u: sent barrier failed\n", ctx.rankId);
        return SendWithImmExample::FAIL;
    }
    EXAMPLES_CHECK(ReportPeerPayload(ctx), SendWithImmExample::SUCCESS, ctx.rankId);

    std::printf(
        "[rank %u] asccomm_send_with_imm_on_thread | peer rank %u | %s\n", ctx.rankId, ctx.peerRank,
        verifyRet == SendWithImmExample::SUCCESS ? "PASS" : "FAIL");
    return verifyRet;
}

} // namespace

int32_t RunSendWithImmRank(uint32_t rank, uint32_t nranks, const std::string& ctrlEndpoint)
{
    return SendWithImmRank(rank, nranks, ctrlEndpoint) == SendWithImmExample::SUCCESS ? SendWithImmExample::SUCCESS : 1;
}

int32_t main(int32_t argc, char* argv[])
{
    if (argc != 3) {
        std::fprintf(stderr, "Usage: %s <tcp://ip:port> <nranks>\n", argv[0]);
        return SendWithImmExample::FAIL;
    }
    uint32_t nranks = 0;
    if (!examples::ParseUint32(argv[2], nranks, 2)) {
        std::fprintf(stderr, "invalid nranks: %s, expected an integer >= 2\n", argv[2]);
        return SendWithImmExample::FAIL;
    }
    const std::string endpoint = argv[1];

    std::vector<examples::ArgsOf<decltype(RunSendWithImmRank)>> perRankArgs;
    perRankArgs.reserve(nranks);
    for (uint32_t rank = 0; rank < nranks; ++rank) {
        perRankArgs.emplace_back(rank, nranks, endpoint);
    }

    examples::ProcessGroup group;
    if (!group.Launch(nranks, RunSendWithImmRank, std::move(perRankArgs))) {
        return SendWithImmExample::FAIL;
    }
    const bool allPassed = group.WaitAll();
    if (group.Interrupted()) {
        std::printf("RESULT | Example=asccomm_send_with_imm | Status=INTERRUPTED\n");
        return SendWithImmExample::FAIL;
    }
    std::printf("RESULT | Example=asccomm_send_with_imm | Status=%s\n", allPassed ? "PASS" : "FAIL");
    return allPassed ? SendWithImmExample::SUCCESS : SendWithImmExample::FAIL;
}
