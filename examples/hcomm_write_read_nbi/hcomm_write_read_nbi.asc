#include <cstdio>
#include <cstring>
#include <signal.h>
#include <sys/wait.h>
#include <unistd.h>
#include <vector>

#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "adv_api/hcomm/hcomm.h"
#include "hccl/hccl.h"
#include "hccl/hccl_comm.h"
#include "hccl/hccl_rank_graph.h"
#include "hccl/hccl_res.h"
#include "hccl/hccl_types.h"
#include "kernel_operator.h"

#include "hcomm_rw_def.h"
#include "utils.h"

#define CHECK(func, expect)                             \
do {                                                    \
    int ret = (func);                                   \
    if (ret != (expect)) {                              \
        printf("[%s:%d] %s failed, ret=%d expect=%d\n", \
               __FILE__, __LINE__, #func, ret, expect); \
        return -1;                                      \
    }                                                   \
} while(0)

namespace {

constexpr const char *SERVER_IP = "127.0.0.1";
constexpr uint16_t SERVER_PORT = 29621U;
constexpr const char *MEMORY_TAG = "shareBuf";

struct RankResources {
    ~RankResources()
    {
        if (comm != nullptr) {
            HcclCommDestroy(comm);
        }
        if (deviceContext != nullptr) {
            aclrtFree(deviceContext);
        }
        if (deviceBuffer != nullptr) {
            aclrtFree(deviceBuffer);
        }
        if (socket >= 0) {
            close(socket);
        }
        if (stream != nullptr) {
            aclrtDestroyStream(stream);
        }
        if (deviceSet) {
            aclrtResetDevice(deviceId);
        }
        if (aclInitialized) {
            aclFinalize();
        }
    }

    RankResources(const RankResources &) = delete;
    RankResources &operator=(const RankResources &) = delete;

    uint32_t deviceId{0};
    bool aclInitialized{false};
    bool deviceSet{false};
    aclrtStream stream{nullptr};
    HcclComm comm{nullptr};
    int32_t socket{-1};
    void *deviceBuffer{nullptr};
    uint8_t *deviceContext{nullptr};
    ChannelHandle channel{0};
    uint64_t remoteBuffer{0};
};

int32_t ExchangeRootInfo(uint32_t rank, int32_t socket, HcclRootInfo &rootInfo)
{
    if (rank == 0U) {
        if (HcclGetRootInfo(&rootInfo) != HCCL_SUCCESS) {
            fprintf(stderr, "[ERROR] HcclGetRootInfo failed\n");
            return -1;
        }
        return SendAll(socket, &rootInfo, sizeof(rootInfo));
    }
    return RecvAll(socket, &rootInfo, sizeof(rootInfo));
}

uint8_t GetDataValue(uint32_t rank, uint32_t index)
{
    return rank == 0U ? static_cast<uint8_t>(index) : static_cast<uint8_t>(DATA_SIZE - 1U - index);
}

void FillSendData(std::vector<uint8_t> &buffer, uint32_t rank)
{
    for (uint32_t i = 0; i < DATA_SIZE; ++i) {
        buffer[SEND_DATA_OFFSET + i] = GetDataValue(rank, i);
    }
}

int32_t ValidateData(
    const std::vector<uint8_t> &buffer, uint64_t offset, uint32_t peerRank, uint32_t rank, const char *name)
{
    for (uint32_t i = 0; i < DATA_SIZE; ++i) {
        uint8_t actual = buffer[offset + i];
        uint8_t expected = GetDataValue(peerRank, i);
        if (actual != expected) {
            fprintf(stderr, "[ERROR] rank %u: %s mismatch at %u, actual=0x%02x, expected=0x%02x\n", rank, name, i,
                actual, expected);
            return -1;
        }
    }
    return 0;
}

const char *GetKernelError(uint32_t result)
{
    switch (result) {
        case TEST_HCOMM_INIT_FAILED:
            return "Hcomm Init failed";
        case TEST_WRITE_FAILED:
            return "WriteNbi failed";
        case TEST_READ_FAILED:
            return "ReadNbi failed";
        case TEST_DRAIN_FAILED:
            return "Drain failed";
        default:
            return "unknown kernel error";
    }
}

int32_t AclInit(RankResources &resources, uint32_t rank)
{
    if (aclInit(nullptr) != ACL_SUCCESS) {
        fprintf(stderr, "[ERROR] rank %u: aclInit failed\n", rank);
        return -1;
    }
    resources.aclInitialized = true;

    if (aclrtSetDevice(rank) != ACL_SUCCESS) {
        fprintf(stderr, "[ERROR] rank %u: aclrtSetDevice failed\n", rank);
        return -1;
    }
    resources.deviceSet = true;

    if (aclrtCreateStream(&resources.stream) != ACL_SUCCESS) {
        fprintf(stderr, "[ERROR] rank %u: aclrtCreateStream failed\n", rank);
        return -1;
    }
    return 0;
}

int32_t AllocDevMem(RankResources &resources, uint32_t rank)
{
    if (aclrtMalloc(&resources.deviceBuffer, COMM_BUF_SIZE, ACL_MEM_MALLOC_HUGE_ONLY) != ACL_SUCCESS
        || resources.deviceBuffer == nullptr) {
        fprintf(stderr, "[ERROR] rank %u: allocate communication buffer failed\n", rank);
        return -1;
    }
    if (aclrtMalloc(reinterpret_cast<void **>(&resources.deviceContext), sizeof(HcommExample::CommContext),
            ACL_MEM_MALLOC_HUGE_ONLY)
            != ACL_SUCCESS
        || resources.deviceContext == nullptr) {
        fprintf(stderr, "[ERROR] rank %u: allocate communication context failed\n", rank);
        return -1;
    }
    return 0;
}

int32_t FindLink(RankResources &resources, HcclChannelDesc &channelDesc, uint32_t rank, uint32_t peerRank)
{
    CommMem registeredMemory = {};
    registeredMemory.type = COMM_MEM_TYPE_DEVICE;
    registeredMemory.addr = resources.deviceBuffer;
    registeredMemory.size = COMM_BUF_SIZE;

    HcclMemHandle memoryHandle = nullptr;
    if (HcclCommMemReg(resources.comm, MEMORY_TAG, &registeredMemory, &memoryHandle) != HCCL_SUCCESS
        || memoryHandle == nullptr) {
        fprintf(stderr, "[ERROR] rank %u: HcclCommMemReg failed\n", rank);
        return -1;
    }

    uint32_t *networkLayers = nullptr;
    uint32_t networkLayerCount = 0;
    if (HcclRankGraphGetLayers(resources.comm, &networkLayers, &networkLayerCount) != HCCL_SUCCESS
        || networkLayerCount == 0U) {
        fprintf(stderr, "[ERROR] rank %u: HcclRankGraphGetLayers failed\n", rank);
        return -1;
    }

    CommLink *links = nullptr;
    uint32_t linkCount = 0;
    if (HcclRankGraphGetLinks(resources.comm, networkLayers[0], rank, peerRank, &links, &linkCount) != HCCL_SUCCESS
        || links == nullptr || linkCount == 0U) {
        fprintf(stderr, "[ERROR] rank %u: HcclRankGraphGetLinks failed\n", rank);
        return -1;
    }

    HcclChannelDescInit(&channelDesc, 1U);
    channelDesc.remoteRank = peerRank;
    channelDesc.channelProtocol = HOST_COMM_PROTOCOL;
    channelDesc.memHandles = &memoryHandle;
    channelDesc.memHandleNum = 1U;

    bool linkFound = false;
    for (uint32_t i = 0; i < linkCount; ++i) {
        if (links[i].linkAttr.linkProtocol == HOST_COMM_PROTOCOL) {
            channelDesc.localEndpoint = links[i].srcEndpointDesc;
            channelDesc.remoteEndpoint = links[i].dstEndpointDesc;
            linkFound = true;
            break;
        }
    }
    if (!linkFound) {
        fprintf(stderr, "[ERROR] rank %u: no matching link for protocol\n", rank);
        return -1;
    }
    return 0;
}

int32_t AcquireChannel(RankResources &resources, uint32_t rank, uint32_t peerRank)
{
    HcclChannelDesc channelDesc;
    CHECK(FindLink(resources, channelDesc, rank, peerRank), 0);

    if (HcclChannelAcquire(resources.comm, COMM_ENGINE_AIV, &channelDesc, 1U, &resources.channel) != HCCL_SUCCESS
        || resources.channel == 0U) {
        fprintf(stderr, "[ERROR] rank %u: HcclChannelAcquire failed\n", rank);
        return -1;
    }
    return 0;
}

int32_t GetRemoteMems(RankResources &resources, uint32_t rank)
{
    uint32_t remoteMemoryCount = 0;
    CommMem *remoteMemories = nullptr;
    char **memoryTags = nullptr;
    if (HcclChannelGetRemoteMems(resources.comm, resources.channel, &remoteMemoryCount, &remoteMemories, &memoryTags)
            != HCCL_SUCCESS
        || remoteMemories == nullptr || remoteMemoryCount == 0U) {
        fprintf(stderr, "[ERROR] rank %u: HcclChannelGetRemoteMems failed\n", rank);
        return -1;
    }

    for (uint32_t i = 0; i < remoteMemoryCount; ++i) {
        if (memoryTags != nullptr && memoryTags[i] != nullptr && std::strcmp(memoryTags[i], MEMORY_TAG) == 0) {
            resources.remoteBuffer = reinterpret_cast<uint64_t>(remoteMemories[i].addr);
            break;
        }
    }
    if (resources.remoteBuffer == 0U && remoteMemoryCount == 1U) {
        resources.remoteBuffer = reinterpret_cast<uint64_t>(remoteMemories[0].addr);
    }
    if (resources.remoteBuffer == 0U) {
        fprintf(stderr, "[ERROR] rank %u: remote communication buffer not found\n", rank);
        return -1;
    }
    return 0;
}

int32_t RunRank(uint32_t rank)
{
    RankResources resources{};
    resources.deviceId = rank;
    uint32_t peerRank = 1U - rank;

    CHECK(AclInit(resources, rank), 0);

    int32_t peerSocket = -1;
    if (ConnectPeer(rank, SERVER_IP, SERVER_PORT, peerSocket) != 0) {
        fprintf(stderr, "[ERROR] rank %u: connect peer failed\n", rank);
        return -1;
    }
    resources.socket = peerSocket;

    HcclRootInfo rootInfo = {};
    if (ExchangeRootInfo(rank, resources.socket, rootInfo) != 0) {
        fprintf(stderr, "[ERROR] rank %u: exchange root info failed\n", rank);
        return -1;
    }

    HcclCommConfig config;
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = rank;
    if (HcclCommInitRootInfoConfig(NRANKS, &rootInfo, rank, &config, &resources.comm) != HCCL_SUCCESS) {
        fprintf(stderr, "[ERROR] rank %u: HcclCommInitRootInfoConfig failed\n", rank);
        return -1;
    }

    CHECK(AllocDevMem(resources, rank), 0);

    CHECK(AcquireChannel(resources, rank, peerRank), 0);

    CHECK(GetRemoteMems(resources, rank), 0);

    std::vector<uint8_t> hostBuffer(static_cast<size_t>(COMM_BUF_SIZE), 0U);
    FillSendData(hostBuffer, rank);
    if (aclrtMemcpy(resources.deviceBuffer, COMM_BUF_SIZE, hostBuffer.data(), COMM_BUF_SIZE, ACL_MEMCPY_HOST_TO_DEVICE)
        != ACL_SUCCESS) {
        fprintf(stderr, "[ERROR] rank %u: copy communication buffer to device failed\n", rank);
        return -1;
    }

    HcommExample::CommContext context = {};
    context.channelHandle = resources.channel;
    context.localBufferAddr = reinterpret_cast<uint64_t>(resources.deviceBuffer);
    context.remoteBufferAddr = resources.remoteBuffer;
    context.testResult = TEST_SUCCESS;
    if (aclrtMemcpy(resources.deviceContext, sizeof(context), &context, sizeof(context), ACL_MEMCPY_HOST_TO_DEVICE)
        != ACL_SUCCESS) {
        fprintf(stderr, "[ERROR] rank %u: copy communication context to device failed\n", rank);
        return -1;
    }

    if (TcpBarrier(resources.socket) != 0) {
        fprintf(stderr, "[ERROR] rank %u: pre-kernel barrier failed\n", rank);
        return -1;
    }

    kernel_hcomm_write_read_nbi<<<1, nullptr, resources.stream>>>(resources.deviceContext);
    if (aclrtSynchronizeStream(resources.stream) != ACL_SUCCESS) {
        fprintf(stderr, "[ERROR] rank %u: synchronize kernel stream failed\n", rank);
        return -1;
    }

    if (TcpBarrier(resources.socket) != 0) {
        fprintf(stderr, "[ERROR] rank %u: post-kernel barrier failed\n", rank);
        return -1;
    }

    if (aclrtMemcpy(&context, sizeof(context), resources.deviceContext, sizeof(context), ACL_MEMCPY_DEVICE_TO_HOST)
        != ACL_SUCCESS) {
        fprintf(stderr, "[ERROR] rank %u: copy communication context to host failed\n", rank);
        return -1;
    }
    if (context.testResult != TEST_SUCCESS) {
        fprintf(stderr, "[ERROR] rank %u: %s\n", rank, GetKernelError(context.testResult));
        return -1;
    }

    if (aclrtMemcpy(hostBuffer.data(), COMM_BUF_SIZE, resources.deviceBuffer, COMM_BUF_SIZE, ACL_MEMCPY_DEVICE_TO_HOST)
        != ACL_SUCCESS) {
        fprintf(stderr, "[ERROR] rank %u: copy communication buffer to host failed\n", rank);
        return -1;
    }
    if (ValidateData(hostBuffer, WRITE_RESULT_OFFSET, peerRank, rank, "WriteNbi result") != 0
        || ValidateData(hostBuffer, READ_RESULT_OFFSET, peerRank, rank, "ReadNbi result") != 0) {
        return -1;
    }

    printf("rank %u test pass!\n", rank);
    return 0;
}

} // namespace

int32_t main()
{
    pid_t pids[NRANKS] = {-1, -1};

    for (uint32_t rank = 0; rank < NRANKS; ++rank) {
        pids[rank] = fork();
        if (pids[rank] < 0) {
            fprintf(stderr, "[ERROR] fork rank %u failed\n", rank);
            for (uint32_t i = 0; i < rank; ++i) {
                kill(pids[i], SIGKILL);
                waitpid(pids[i], nullptr, 0);
            }
            return -1;
        }
        if (pids[rank] == 0) {
            int32_t result = RunRank(rank);
            fflush(nullptr);
            _exit(result == 0 ? 0 : 1);
        }
    }

    bool allPassed = true;
    for (uint32_t rank = 0; rank < NRANKS; ++rank) {
        int32_t status = 0;
        if (waitpid(pids[rank], &status, 0) < 0 || !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
            allPassed = false;
        }
    }

    if (!allPassed) {
        printf("test failed!\n");
        return -1;
    }
    printf("test pass!\n");
    return 0;
}
