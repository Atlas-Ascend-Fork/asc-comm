#include <cstdio>
#include <cerrno>
#include <cstdlib>
#include <cstring>
#include <limits>
#include <signal.h>
#include <sys/wait.h>
#include <unistd.h>
#include <vector>

#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "adv_api/hcomm/hcomm.h"
#include "hccl/hccl.h"
#include "hccl/hccl_comm.h"
#include "hccl/hccl_rank_graph.h"
#include "hccl/hccl_res.h"
#include "hccl/hccl_types.h"
#include "kernel_operator.h"

#include "hcomm_rw_def.h"
#include "utils.h"

namespace {

constexpr const char* SERVER_IP = "127.0.0.1";
constexpr const char* MEMORY_TAG = "shareBuf";

// 相邻节点相关资源
struct PeerRankCtx {
    uint32_t rankId{0};
    int32_t socket{-1};
    uint8_t* devContext{nullptr};
    ChannelHandle channel{0};
    uint64_t remoteBuf{0};
};

// 本节点资源
struct RankCtx {
    ~RankCtx()
    {
        if (comm != nullptr) {
            HcclCommDestroy(comm);
        }
        ReleasePeer(prev);
        ReleasePeer(next);
        if (devBuf != nullptr) {
            aclrtFree(devBuf);
        }
        if (stream != nullptr) {
            aclrtDestroyStream(stream);
        }
        if (isDevSet) {
            aclrtResetDevice(rankId);
        }
        if (aclInitialized) {
            aclFinalize();
        }
    }

    RankCtx(const RankCtx&) = delete;
    RankCtx& operator=(const RankCtx&) = delete;

    static void ReleasePeer(PeerRankCtx& peer)
    {
        if (peer.devContext != nullptr) {
            aclrtFree(peer.devContext);
        }
        if (peer.socket >= 0) {
            close(peer.socket);
        }
    }

    uint32_t rankId{0};
    bool aclInitialized{false};
    bool isDevSet{false};
    aclrtStream stream{nullptr};
    HcclComm comm{nullptr};
    void* devBuf{nullptr};
    HcclMemHandle memHandle{nullptr};
    PeerRankCtx prev;
    PeerRankCtx next;
};

// 第 0 个字节是 rankId，其余是 rankId + index(对256取余)，用于逐字节校验
uint8_t GetDataValue(uint32_t rank, uint32_t index)
{
    return index == 0U ? static_cast<uint8_t>(rank) : static_cast<uint8_t>(rank + index);
}

// 在发送区填充本节点的待发送数据
void FillSendData(std::vector<uint8_t>& buffer, uint32_t rank)
{
    for (uint32_t i = 0; i < DATA_SIZE; ++i) {
        buffer[SEND_DATA_OFFSET + i] = GetDataValue(rank, i);
    }
}

// 逐字节校验 buffer 中 offset 处的数据是否与对端 peerRank 的预期数据一致
int32_t ValidateData(
    const std::vector<uint8_t>& buffer, uint64_t offset, uint32_t peerRank, uint32_t rank, const char* name)
{
    for (uint32_t i = 0; i < DATA_SIZE; ++i) {
        uint8_t actual = buffer[offset + i];
        uint8_t expected = GetDataValue(peerRank, i);
        if (actual != expected) {
            fprintf(
                stderr, "[ERROR] rank %u: %s mismatch at %u, actual=0x%02x, expected=0x%02x\n", rank, name, i, actual,
                expected);
            return FAIL;
        }
    }
    return SUCCESS;
}

// 将核函数返回的结果状态转换为可读的错误描述
const char* GetKernelError(TestResult result)
{
    switch (result) {
        case TEST_HCOMM_INIT_FAILED:
            return "Hcomm Init failed";
        case TEST_WRITE_FAILED:
            return "WriteNbi failed";
        case TEST_READ_FAILED:
            return "ReadNbi failed";
        case TEST_DRAIN_FAILED:
            return "Drain failed";
        default:
            return "unknown kernel error";
    }
}

// 初始化 ACL、绑定本节点对应的 device 并创建 stream
int32_t AclInit(RankCtx& rankCtx)
{
    CHECK(aclInit(nullptr), ACL_SUCCESS, rankCtx.rankId);
    rankCtx.aclInitialized = true;

    uint32_t devNum = 0;
    aclrtGetDeviceCount(&devNum);
    fprintf(stderr, "[INFO] rank %u: devNum = %u\n", rankCtx.rankId, devNum);

    CHECK(aclrtSetDevice(rankCtx.rankId), ACL_SUCCESS, rankCtx.rankId);
    rankCtx.isDevSet = true;

    CHECK(aclrtCreateStream(&rankCtx.stream), ACL_SUCCESS, rankCtx.rankId);
    return SUCCESS;
}

// 为指定相邻节点分配 device 侧通信上下文内存
int32_t AllocPeerDevContext(RankCtx& rankCtx, PeerRankCtx& peer, const char* name)
{
    CHECK(
        aclrtMalloc(
            reinterpret_cast<void**>(&peer.devContext), sizeof(HcommExample::CommContext), ACL_MEM_MALLOC_HUGE_ONLY),
        ACL_SUCCESS, rankCtx.rankId);
    if (peer.devContext == nullptr) {
        fprintf(stderr, "[ERROR] rank %u: allocate %s communication context failed\n", rankCtx.rankId, name);
        return FAIL;
    }
    return SUCCESS;
}

// 分配本节点通信 buffer，以及 prev/next 两个相邻节点的通信上下文
int32_t AllocDevMem(RankCtx& rankCtx)
{
    CHECK(aclrtMalloc(&rankCtx.devBuf, COMM_BUF_SIZE, ACL_MEM_MALLOC_HUGE_ONLY), ACL_SUCCESS, rankCtx.rankId);
    if (rankCtx.devBuf == nullptr) {
        fprintf(stderr, "[ERROR] rank %u: allocate communication buffer failed\n", rankCtx.rankId);
        return FAIL;
    }
    CHECK(AllocPeerDevContext(rankCtx, rankCtx.prev, "prev"), SUCCESS, rankCtx.rankId);
    CHECK(AllocPeerDevContext(rankCtx, rankCtx.next, "next"), SUCCESS, rankCtx.rankId);
    return SUCCESS;
}

// 将本节点通信 buffer 注册到通信域，得到通道建链所需的内存句柄
int32_t RegisterMem(RankCtx& rankCtx)
{
    CommMem registeredMemory = {};
    registeredMemory.type = COMM_MEM_TYPE_DEVICE;
    registeredMemory.addr = rankCtx.devBuf;
    registeredMemory.size = COMM_BUF_SIZE;

    CHECK(
        HcclCommMemReg(rankCtx.comm, MEMORY_TAG, &registeredMemory, &rankCtx.memHandle), HCCL_SUCCESS, rankCtx.rankId);
    if (rankCtx.memHandle == nullptr) {
        fprintf(stderr, "[ERROR] rank %u: HcclCommMemReg failed\n", rankCtx.rankId);
        return FAIL;
    }
    return SUCCESS;
}

// 从 rank 图中查找与对端匹配的链路，并据此填充通道描述信息
int32_t FindLink(RankCtx& rankCtx, PeerRankCtx& peer, HcclChannelDesc& channelDesc)
{
    uint32_t* networkLayers = nullptr;
    uint32_t networkLayerCount = 0;
    CHECK(HcclRankGraphGetLayers(rankCtx.comm, &networkLayers, &networkLayerCount), HCCL_SUCCESS, rankCtx.rankId);
    if (networkLayerCount == 0U) {
        fprintf(stderr, "[ERROR] rank %u: HcclRankGraphGetLayers failed\n", rankCtx.rankId);
        return FAIL;
    }

    CommLink* links = nullptr;
    uint32_t linkCount = 0;
    CHECK(
        HcclRankGraphGetLinks(rankCtx.comm, networkLayers[0], rankCtx.rankId, peer.rankId, &links, &linkCount),
        HCCL_SUCCESS, rankCtx.rankId);
    if (links == nullptr || linkCount == 0U) {
        fprintf(stderr, "[ERROR] rank %u: HcclRankGraphGetLinks failed\n", rankCtx.rankId);
        return FAIL;
    }

    HcclChannelDescInit(&channelDesc, 1U);
    channelDesc.remoteRank = peer.rankId;
    channelDesc.channelProtocol = HOST_COMM_PROTOCOL;
    channelDesc.memHandles = &rankCtx.memHandle;
    channelDesc.memHandleNum = 1U;

    bool linkFound = false;
    for (uint32_t i = 0; i < linkCount; ++i) {
        if (links[i].linkAttr.linkProtocol == HOST_COMM_PROTOCOL) {
            channelDesc.localEndpoint = links[i].srcEndpointDesc;
            channelDesc.remoteEndpoint = links[i].dstEndpointDesc;
            linkFound = true;
            break;
        }
    }
    if (!linkFound) {
        fprintf(stderr, "[ERROR] rank %u: no matching link for protocol\n", rankCtx.rankId);
        return FAIL;
    }
    return SUCCESS;
}

// 与指定相邻节点建链，获取 AIV 引擎使用的通道句柄
int32_t AcquireChannel(RankCtx& rankCtx, PeerRankCtx& peer)
{
    HcclChannelDesc channelDesc;
    CHECK(FindLink(rankCtx, peer, channelDesc), SUCCESS, rankCtx.rankId);

    CHECK(
        HcclChannelAcquire(rankCtx.comm, COMM_ENGINE_AIV, &channelDesc, 1U, &peer.channel), HCCL_SUCCESS,
        rankCtx.rankId);
    if (peer.channel == 0U) {
        fprintf(stderr, "[ERROR] rank %u: HcclChannelAcquire failed\n", rankCtx.rankId);
        return FAIL;
    }
    return SUCCESS;
}

// 通过已建立的通道查询对端注册的内存，按 tag 匹配出对端通信 buffer 地址
int32_t GetRemoteMems(RankCtx& rankCtx, PeerRankCtx& peer)
{
    uint32_t remoteMemoryCount = 0;
    CommMem* remoteMemories = nullptr;
    char** memoryTags = nullptr;
    CHECK(
        HcclChannelGetRemoteMems(rankCtx.comm, peer.channel, &remoteMemoryCount, &remoteMemories, &memoryTags),
        HCCL_SUCCESS, rankCtx.rankId);
    if (remoteMemories == nullptr || remoteMemoryCount == 0U) {
        fprintf(stderr, "[ERROR] rank %u: HcclChannelGetRemoteMems failed\n", rankCtx.rankId);
        return FAIL;
    }

    for (uint32_t i = 0; i < remoteMemoryCount; ++i) {
        if (memoryTags != nullptr && memoryTags[i] != nullptr && std::strcmp(memoryTags[i], MEMORY_TAG) == 0) {
            peer.remoteBuf = reinterpret_cast<uint64_t>(remoteMemories[i].addr);
            break;
        }
    }
    if (peer.remoteBuf == 0U && remoteMemoryCount == 1U) {
        peer.remoteBuf = reinterpret_cast<uint64_t>(remoteMemories[0].addr);
    }
    if (peer.remoteBuf == 0U) {
        fprintf(stderr, "[ERROR] rank %u: remote communication buffer not found\n", rankCtx.rankId);
        return FAIL;
    }
    return SUCCESS;
}

// 在 host 侧填充待发送数据，并整体拷贝到 device 侧通信 buffer
int32_t InitBuffer(RankCtx& rankCtx)
{
    std::vector<uint8_t> hostBuffer(static_cast<size_t>(COMM_BUF_SIZE), 0U);
    FillSendData(hostBuffer, rankCtx.rankId);
    CHECK(
        aclrtMemcpy(rankCtx.devBuf, COMM_BUF_SIZE, hostBuffer.data(), COMM_BUF_SIZE, ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, rankCtx.rankId);
    return SUCCESS;
}

// 组装通道句柄、本端/对端 buffer 地址等信息，拷贝到 device 侧供核函数使用
int32_t InitPeerContext(RankCtx& rankCtx, PeerRankCtx& peer)
{
    HcommExample::CommContext context = {};
    context.channelHandle = peer.channel;
    context.localBufferAddr = reinterpret_cast<uint64_t>(rankCtx.devBuf);
    context.remoteBufferAddr = peer.remoteBuf;
    context.testResult = TEST_SUCCESS;
    CHECK(
        aclrtMemcpy(peer.devContext, sizeof(context), &context, sizeof(context), ACL_MEMCPY_HOST_TO_DEVICE),
        ACL_SUCCESS, rankCtx.rankId);
    return SUCCESS;
}

// 按 operationType 下发对应的读/写核函数，并等待 stream 执行完成
template <uint32_t operationType>
int32_t RunPeerKernel(RankCtx& rankCtx, PeerRankCtx& peer)
{
    static_assert(
        operationType == HCOMM_READ_ONLY || operationType == HCOMM_WRITE_ONLY || operationType == HCOMM_READ_WRITE,
        "Unsupported Hcomm operation type");
    if constexpr (operationType == HCOMM_READ_ONLY) {
        kernel_hcomm_read_nbi<<<1, nullptr, rankCtx.stream>>>(peer.devContext);
    } else if constexpr (operationType == HCOMM_WRITE_ONLY) {
        kernel_hcomm_write_nbi<<<1, nullptr, rankCtx.stream>>>(peer.devContext);
    } else {
        kernel_hcomm_write_read_nbi<<<1, nullptr, rankCtx.stream>>>(peer.devContext);
    }
    CHECK(aclrtSynchronizeStream(rankCtx.stream), ACL_SUCCESS, rankCtx.rankId);
    return SUCCESS;
}

// 从 device 侧回读通信上下文，检查核函数执行结果状态
int32_t CheckPeerKernelResult(RankCtx& rankCtx, PeerRankCtx& peer, const char* name)
{
    HcommExample::CommContext context = {};
    CHECK(
        aclrtMemcpy(&context, sizeof(context), peer.devContext, sizeof(context), ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, rankCtx.rankId);
    if (context.testResult != TEST_SUCCESS) {
        fprintf(stderr, "[ERROR] rank %u %s: %s\n", rankCtx.rankId, name, GetKernelError(context.testResult));
        return FAIL;
    }
    return SUCCESS;
}

// 回读 device 侧通信 buffer，校验指定区域的数据是否符合预期
int32_t CheckBufferRegion(RankCtx& rankCtx, uint64_t offset, PeerRankCtx& peer, const char* name)
{
    std::vector<uint8_t> hostBuffer(static_cast<size_t>(COMM_BUF_SIZE), 0U);
    CHECK(
        aclrtMemcpy(hostBuffer.data(), COMM_BUF_SIZE, rankCtx.devBuf, COMM_BUF_SIZE, ACL_MEMCPY_DEVICE_TO_HOST),
        ACL_SUCCESS, rankCtx.rankId);
    return ValidateData(hostBuffer, offset, peer.rankId, rankCtx.rankId, name);
}

// 单个 rank 的完整流程：建链、建通信域、准备内存、执行读写核函数并校验结果
int32_t HcommRW(uint32_t rank, uint32_t nranks)
{
    RankCtx rankCtx{};
    rankCtx.rankId = rank;
    rankCtx.prev.rankId = (rankCtx.rankId - 1U + nranks) % nranks;
    rankCtx.next.rankId = (rankCtx.rankId + 1U) % nranks;

    // Hcomm P2P 的准备流程有严格的先后顺序：
    // 步骤 1：初始化 ACL 设备资源，并建立 host 侧 TCP 环。
    // 步骤 2：交换 rootInfo，初始化 HCCL 通信域。
    // 步骤 3：分配本节点 device 侧内存，并在获取通道前完成内存注册。
    // 步骤 4：获取 prev/next 通道，再通过已获取的通道查询对端内存。
    // 步骤 5：在下发核函数前，初始化本节点数据和 device 侧的对端通信上下文。
    // 步骤 6：所有 rank 同步后执行 WriteNbi/ReadNbi，再次同步确认完成，最后校验结果。
    CHECK(AclInit(rankCtx), SUCCESS, rankCtx.rankId);

    CHECK(
        SetupRingTopo(rankCtx.rankId, nranks, SERVER_IP, rankCtx.prev.socket, rankCtx.next.socket), SUCCESS,
        rankCtx.rankId);

    uint16_t rootPort = static_cast<uint16_t>(BASE_PORT + nranks);
    HcclRootInfo rootInfo = {};
    // 使用RootInfo建立拓扑，root节点会获取rootInfo
    if (rankCtx.rankId == ROOT_SERVER_RANK) {
        CHECK(HcclGetRootInfo(&rootInfo), HCCL_SUCCESS, rankCtx.rankId);
    }
    // 将root节点的rootInfo同步到其他节点
    CHECK(
        ExchangeRootInfoRing(rankCtx.rankId, nranks, SERVER_IP, rootPort, &rootInfo, sizeof(rootInfo)), SUCCESS,
        rankCtx.rankId);

    HcclCommConfig config;
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = rankCtx.rankId;
    // 使用rootInfo初始化通信域
    CHECK(
        HcclCommInitRootInfoConfig(nranks, &rootInfo, rankCtx.rankId, &config, &rankCtx.comm), HCCL_SUCCESS,
        rankCtx.rankId);
    // 分配本节点设备侧内存和与相邻节点的通信上下文
    CHECK(AllocDevMem(rankCtx), SUCCESS, rankCtx.rankId);
    // 注册本节点通道绑定的内存
    CHECK(RegisterMem(rankCtx), SUCCESS, rankCtx.rankId);

    // rankId分奇偶获取通道顺序不同，避免建链循环等待阻塞
    if (rankCtx.rankId % 2 == 0) {
        CHECK(AcquireChannel(rankCtx, rankCtx.prev), SUCCESS, rankCtx.rankId);
        CHECK(AcquireChannel(rankCtx, rankCtx.next), SUCCESS, rankCtx.rankId);
    } else {
        CHECK(AcquireChannel(rankCtx, rankCtx.next), SUCCESS, rankCtx.rankId);
        CHECK(AcquireChannel(rankCtx, rankCtx.prev), SUCCESS, rankCtx.rankId);
    }
    // 获取相邻节点注册的内存
    CHECK(GetRemoteMems(rankCtx, rankCtx.prev), SUCCESS, rankCtx.rankId);
    CHECK(GetRemoteMems(rankCtx, rankCtx.next), SUCCESS, rankCtx.rankId);
    // 填充本节点校验数据，并拷贝到device侧
    CHECK(InitBuffer(rankCtx), SUCCESS, rankCtx.rankId);
    // 初始化与相邻节点的通信上下文（其中保存有核函数执行结果状态：testResult）
    CHECK(InitPeerContext(rankCtx, rankCtx.prev), SUCCESS, rankCtx.rankId);
    CHECK(InitPeerContext(rankCtx, rankCtx.next), SUCCESS, rankCtx.rankId);
    // 下发核函数前同步：确保所有 rank 都已获取通道，并完成对端内存和通信上下文的初始化
    CHECK(RingBarrier(rankCtx.prev.socket, rankCtx.next.socket, nranks), SUCCESS, rankCtx.rankId);
    // 执行核函数
    CHECK(RunPeerKernel<HCOMM_READ_WRITE>(rankCtx, rankCtx.next), SUCCESS, rankCtx.rankId);
    // 核函数执行后同步：确保所有 rank 都已完成 WriteNbi/ReadNbi/Drain，再在 host 侧校验
    CHECK(RingBarrier(rankCtx.prev.socket, rankCtx.next.socket, nranks), SUCCESS, rankCtx.rankId);
    // 校验结果
    CHECK(CheckPeerKernelResult(rankCtx, rankCtx.next, "next"), SUCCESS, rankCtx.rankId);
    CHECK(CheckBufferRegion(rankCtx, WRITE_RESULT_OFFSET, rankCtx.prev, "WriteNbi result"), SUCCESS, rankCtx.rankId);
    CHECK(CheckBufferRegion(rankCtx, READ_RESULT_OFFSET, rankCtx.next, "ReadNbi result"), SUCCESS, rankCtx.rankId);

    printf("rank %u test pass!\n", rankCtx.rankId);
    return SUCCESS;
}

// 解析命令行传入的 rank 数量，未指定时使用默认值 NRANKS
int32_t ParseNranks(int32_t argc, char* argv[], uint32_t& nranks)
{
    nranks = NRANKS;
    if (argc == 1) {
        return SUCCESS;
    }
    if (argc != 2) {
        fprintf(stderr, "Usage: %s [nranks]\n", argv[0]);
        return FAIL;
    }

    errno = 0;
    char* end = nullptr;
    unsigned long value = std::strtoul(argv[1], &end, 10);
    if (errno != 0 || end == argv[1] || *end != '\0' || value < 2UL || value > std::numeric_limits<uint32_t>::max()) {
        fprintf(stderr, "[ERROR] invalid nranks: %s, expected an integer >= 2\n", argv[1]);
        return FAIL;
    }
    if (value > static_cast<unsigned long>(std::numeric_limits<uint16_t>::max() - BASE_PORT)) {
        fprintf(stderr, "[ERROR] invalid nranks: %s, BASE_PORT + nranks exceeds uint16_t range\n", argv[1]);
        return FAIL;
    }

    nranks = static_cast<uint32_t>(value);
    return SUCCESS;
}

} // namespace

int32_t main(int32_t argc, char* argv[])
{
    uint32_t nranks = NRANKS;
    if (ParseNranks(argc, argv, nranks) != SUCCESS) {
        return FAIL;
    }

    std::vector<pid_t> pids(nranks, -1);
    for (uint32_t rank = 0; rank < nranks; ++rank) {
        pids[rank] = fork();
        if (pids[rank] < 0) {
            fprintf(stderr, "[ERROR] fork rank %u failed\n", rank);
            for (uint32_t i = 0; i < rank; ++i) {
                kill(pids[i], SIGKILL);
                waitpid(pids[i], nullptr, 0);
            }
            return FAIL;
        }
        if (pids[rank] == 0) {
            int32_t result = HcommRW(rank, nranks);
            fflush(nullptr);
            _exit(result == SUCCESS ? SUCCESS : 1);
        }
    }

    bool allPassed = true;
    for (uint32_t rank = 0; rank < nranks; ++rank) {
        int32_t status = 0;
        if (waitpid(pids[rank], &status, 0) < 0 || !WIFEXITED(status) || WEXITSTATUS(status) != SUCCESS) {
            allPassed = false;
        }
    }

    if (!allPassed) {
        printf("test failed!\n");
        return FAIL;
    }
    printf("test pass!\n");
    return SUCCESS;
}
