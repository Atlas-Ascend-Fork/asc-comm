/*!
 * \file hcomm_write_read_nbi.asc
 * \brief Hcomm WriteNbi/ReadNbi点对点通信样例
 */

#include <cstdio>
#include <cstring>
#include <ctime>
#include <unistd.h>
#include <string>
#include <vector>
#include <sys/wait.h>
#include <signal.h>

#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "hccl/hccl.h"
#include "hccl/hccl_comm.h"
#include "hccl/hccl_res.h"
#include "hccl/hccl_types.h"
#include "hccl/hccl_rank_graph.h"
#include "kernel_operator.h"
#include "comm_api/aicore/hcomm/hcomm.h"

#include "utils.h"
#include "hcomm_rw_def.h"

extern "C" __global__ __aicore__ void kernel_hcomm_write_read_nbi(GM_ADDR context);

constexpr const char* DEFAULT_ENDPOINT = "tcp://127.0.0.1:29621";

//  HCCL 通信与 P2P 通道聚合管理器 (RAII)
class HcclManager {
private:
    uint32_t rank_;
    uint32_t nranks_;
    int32_t sock_;

    // acl
    aclrtStream stream_;
    bool initialized_;

    HcclComm comm_;
    // P2P Channel 相关状态
    ChannelHandle channel_;
    void* devBuf_;
    uint64_t remoteBufAddr_;
    uint8_t* devContext_;

public:
    HcclManager(uint32_t rank, uint32_t nranks)
        : rank_(rank),
          nranks_(nranks),
          stream_(nullptr),
          initialized_(false),
          sock_(-1),
          comm_(nullptr),
          channel_(0),
          devBuf_(nullptr),
          remoteBufAddr_(0),
          devContext_(nullptr)
    {}

    ~HcclManager()
    {
        // 先销毁 HCCL 通信域 (内部会自动清理关联的 Channel 和 MemHandle)
        if (comm_) {
            HcclCommDestroy(comm_);
            comm_ = nullptr;
        }

        // 再释放设备内存
        if (devContext_) {
            aclrtFree(devContext_);
            devContext_ = nullptr;
        }
        if (devBuf_) {
            aclrtFree(devBuf_);
            devBuf_ = nullptr;
        }

        // 3. 关闭 TCP Socket
        if (sock_ >= 0) {
            close(sock_);
            sock_ = -1;
        }

        // 最后释放 acl 资源
        if (stream_) {
            aclrtDestroyStream(stream_);
            stream_ = nullptr;
        }
        if (initialized_) {
            aclrtResetDevice(rank_);
            aclFinalize();
        }
    }

    HcclManager(const HcclManager&) = delete;
    HcclManager& operator=(const HcclManager&) = delete;

    bool Init(const std::string& endpoint)
    {
        // 初始化顺序：先 ACL，后 HCCL
        // acl 环境初始化
        if (!AclInit()) {
            return false;
        }

        std::string ip;
        uint16_t port = 0;
        if (!ParseEndpoint(endpoint, ip, port)) {
            fprintf(stderr, "[ERROR] rank %u: invalid endpoint: %s\n", rank_, endpoint.c_str());
            return false;
        }

        // 1. 建立 TCP 连接并交换 RootInfo
        if (ConnectPeer(rank_, ip, port, sock_) != 0) {
            fprintf(stderr, "[ERROR] rank %u: connect peer failed\n", rank_);
            return false;
        }

        HcclRootInfo rootInfo;
        if (ExchangeRootInfo(rank_, sock_, &rootInfo) != 0) {
            return false;
        }

        // 2. 初始化 HCCL Comm
        HcclCommConfig config;
        HcclCommConfigInit(&config);
        config.hcclWorldRankID = rank_;

        if (HcclCommInitRootInfoConfig(nranks_, &rootInfo, rank_, &config, &comm_) != HCCL_SUCCESS) {
            fprintf(stderr, "[ERROR] rank %u: HcclCommInitRootInfoConfig failed\n", rank_);
            return false;
        }

        // 3. 分配并注册通信 Buffer
        if (aclrtMalloc(&devBuf_, COMM_BUF_SIZE, ACL_MEM_MALLOC_HUGE_ONLY) != ACL_SUCCESS || !devBuf_) {
            fprintf(stderr, "[ERROR] rank %u: aclrtMalloc failed\n", rank_);
            return false;
        }

        // 分配 CommContext
        if (aclrtMalloc(
                reinterpret_cast<void**>(&devContext_), sizeof(HcommExample::CommContext), ACL_MEM_MALLOC_HUGE_ONLY) !=
                ACL_SUCCESS ||
            !devContext_) {
            fprintf(stderr, "[ERROR] rank %u: aclrtMalloc devContext failed\n", rank_);
            return false;
        }

        CommMem regMem = {};
        regMem.type = COMM_MEM_TYPE_DEVICE;
        regMem.addr = devBuf_;
        regMem.size = COMM_BUF_SIZE;

        HcclMemHandle memHandle = nullptr;
        if (HcclCommMemReg(comm_, "shareBuf", &regMem, &memHandle) != HCCL_SUCCESS || !memHandle) {
            fprintf(stderr, "[ERROR] rank %u: HcclCommMemReg failed\n", rank_);
            return false;
        }

        // 4. 构建并获取 P2P Channel
        uint32_t peerRank = (rank_ + 1U) % nranks_;
        HcclChannelDesc channelDesc;
        HcclChannelDescInit(&channelDesc, 1);
        channelDesc.remoteRank = peerRank;
        channelDesc.channelProtocol = TARGET_COMM_PROTOCOL;
        channelDesc.memHandles = &memHandle;
        channelDesc.memHandleNum = 1;

        uint32_t* netLayers = nullptr;
        uint32_t netLayerNum = 0;
        if (HcclRankGraphGetLayers(comm_, &netLayers, &netLayerNum) != HCCL_SUCCESS || netLayerNum == 0) {
            fprintf(stderr, "[ERROR] rank %u: HcclRankGraphGetLayers failed\n", rank_);
            return false;
        }

        uint32_t layerId = netLayers[0];
        CommLink* links = nullptr;
        uint32_t linkNum = 0;
        if (HcclRankGraphGetLinks(comm_, layerId, rank_, peerRank, &links, &linkNum) != HCCL_SUCCESS || linkNum == 0 ||
            !links) {
            fprintf(stderr, "[ERROR] rank %u: HcclRankGraphGetLinks failed\n", rank_);
            return false;
        }

        bool linkFound = false;
        for (uint32_t i = 0; i < linkNum; i++) {
            if (links[i].linkAttr.linkProtocol == TARGET_COMM_PROTOCOL) {
                channelDesc.localEndpoint = links[i].srcEndpointDesc;
                channelDesc.remoteEndpoint = links[i].dstEndpointDesc;
                linkFound = true;
                break;
            }
        }
        if (!linkFound) {
            fprintf(stderr, "[ERROR] rank %u: no matching link for protocol\n", rank_);
            return false;
        }

        if (HcclChannelAcquire(comm_, COMM_ENGINE_AIV, &channelDesc, 1, &channel_) != HCCL_SUCCESS || channel_ == 0) {
            fprintf(stderr, "[ERROR] rank %u: HcclChannelAcquire failed\n", rank_);
            return false;
        }

        // 5. 获取对端注册的内存地址
        uint32_t memNum = 0;
        CommMem* remoteMems = nullptr;
        char** memTags = nullptr;
        if (HcclChannelGetRemoteMems(comm_, channel_, &memNum, &remoteMems, &memTags) != HCCL_SUCCESS || memNum == 0 ||
            !remoteMems) {
            fprintf(stderr, "[ERROR] rank %u: HcclChannelGetRemoteMems failed\n", rank_);
            return false;
        }

        for (uint32_t i = 0; i < memNum; i++) {
            if (memTags != nullptr && memTags[i] != nullptr && std::strcmp(memTags[i], "shareBuf") == 0) {
                remoteBufAddr_ = reinterpret_cast<uint64_t>(remoteMems[i].addr);
                break;
            }
        }
        // 兼容未返回 tag 的单内存场景
        if (remoteBufAddr_ == 0 && memNum == 1) {
            remoteBufAddr_ = reinterpret_cast<uint64_t>(remoteMems[0].addr);
        }

        if (remoteBufAddr_ == 0) {
            fprintf(stderr, "[ERROR] rank %u: no remote memory for shareBuf\n", rank_);
            return false;
        }

        return true;
    }

    // Getters
    void* GetDevBuf() const { return devBuf_; }
    uint8_t* GetDevContext() const { return devContext_; }
    uint64_t GetRemoteBufAddr() const { return remoteBufAddr_; }
    ChannelHandle GetChannel() const { return channel_; }
    int32_t GetSock() const { return sock_; }
    HcclComm GetComm() const { return comm_; }
    aclrtStream GetStream() const { return stream_; }

private:
    bool AclInit()
    {
        if (aclInit(nullptr) != ACL_SUCCESS) {
            fprintf(stderr, "[ERROR] rank %u: aclInit failed\n", rank_);
            return false;
        }
        initialized_ = true;

        uint32_t devCount = 0;
        aclrtGetDeviceCount(&devCount);
        fprintf(stderr, "[INFO] rank %u: dev cnt = %u\n", rank_, devCount);

        if (aclrtSetDevice(rank_) != ACL_SUCCESS) {
            fprintf(stderr, "[ERROR] rank %u: aclrtSetDevice failed\n", rank_);
            return false;
        }

        if (aclrtCreateStream(&stream_) != ACL_SUCCESS) {
            fprintf(stderr, "[ERROR] rank %u: aclrtCreateStream failed\n", rank_);
            return false;
        }
        return true;
    }

    // 通过TCP交换rootInfo: rank 0 生成rootInfo后发送给rank 1
    int32_t ExchangeRootInfo(uint32_t rank, int32_t sock, HcclRootInfo* rootInfo)
    {
        if (rank == 0) {
            if (HcclGetRootInfo(rootInfo) != HCCL_SUCCESS) {
                fprintf(stderr, "[ERROR] HcclGetRootInfo failed\n");
                return -1;
            }
            if (SendAll(sock, rootInfo, sizeof(HcclRootInfo)) != 0) {
                fprintf(stderr, "[ERROR] send rootInfo failed\n");
                return -1;
            }
        } else {
            if (RecvAll(sock, rootInfo, sizeof(HcclRootInfo)) != 0) {
                fprintf(stderr, "[ERROR] recv rootInfo failed\n");
                return -1;
            }
        }
        return 0;
    }

public:
    int32_t SyncBuf2Dev(std::vector<uint8_t>& hostBuf)
    {
        if (aclrtMemcpy(devBuf_, COMM_BUF_SIZE, hostBuf.data(), COMM_BUF_SIZE, ACL_MEMCPY_HOST_TO_DEVICE) !=
            ACL_SUCCESS) {
            fprintf(stderr, "[ERROR] rank %u: aclrtMemcpy H2D failed\n", rank_);
            return -1;
        }
        return 0;
    }

    int32_t SyncContext2Dev()
    {
        HcommExample::CommContext hostCtx = {};
        hostCtx.channelHandle = channel_;
        hostCtx.localBufferAddr = reinterpret_cast<uint64_t>(devBuf_);
        hostCtx.remoteBufferAddr = remoteBufAddr_;
        hostCtx.rankId = rank_;
        hostCtx.worldSize = nranks_;
        hostCtx.testResult = 0;

        // CommContext Host -> Device
        if (aclrtMemcpy(
                devContext_, sizeof(HcommExample::CommContext), &hostCtx, sizeof(HcommExample::CommContext),
                ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
            fprintf(stderr, "[ERROR] rank %u: aclrtMemcpy context H2D failed\n", rank_);
            return -1;
        }
        return 0;
    }

    int32_t SyncBuf2Host(std::vector<uint8_t>& resultBuf)
    {
        if (aclrtMemcpy(resultBuf.data(), COMM_BUF_SIZE, devBuf_, COMM_BUF_SIZE, ACL_MEMCPY_DEVICE_TO_HOST) !=
            ACL_SUCCESS) {
            fprintf(stderr, "[ERROR] rank %u: aclrtMemcpy buf D2H failed\n", rank_);
            return -1;
        }
        return 0;
    }

    int32_t SyncContext2Host(HcommExample::CommContext& resultCtx)
    {
        if (aclrtMemcpy(
                &resultCtx, sizeof(HcommExample::CommContext), devContext_, sizeof(HcommExample::CommContext),
                ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
            fprintf(stderr, "[ERROR] rank %u: aclrtMemcpy context D2H failed\n", rank_);
            return -1;
        }
        return 0;
    }
};

//  业务逻辑执行器 (组合 ACL 和 HCCL)
class HcommWorker {
private:
    uint32_t rank_;
    uint32_t nranks_;
    std::string endpoint_;

    HcclManager hcclMgr_;

public:
    HcommWorker(uint32_t rank, uint32_t nranks, const std::string& endpoint)
        : rank_(rank), nranks_(nranks), endpoint_(endpoint), hcclMgr_(rank, nranks)
    {}

    ~HcommWorker() = default;

    bool Init()
    {
        if (!hcclMgr_.Init(endpoint_)) {
            return false;
        }
        return true;
    }

    int32_t Run()
    {
        uint8_t* devContext = hcclMgr_.GetDevContext();
        aclrtStream stream = hcclMgr_.GetStream();
        int32_t sock = hcclMgr_.GetSock();

        // 1. 生成随机 pattern 并通过 TCP 交换
        std::vector<uint8_t> hostBuf(static_cast<size_t>(COMM_BUF_SIZE), 0);
        GenPattern(hostBuf);

        // 对端 seg0
        std::vector<uint8_t> peerPattern(DATA_SIZE, 0);
        if (SendAll(sock, hostBuf.data(), DATA_SIZE) != 0 || RecvAll(sock, peerPattern.data(), DATA_SIZE) != 0) {
            fprintf(stderr, "[ERROR] rank %u: TCP pattern exchange failed\n", rank_);
            return -1;
        }

        // 将接收到的对端 pattern 写入本端 seg3
        for (uint32_t i = 0; i < DATA_SIZE; i++) {
            hostBuf[3 * DATA_SIZE + i] = peerPattern[i];
        }
        // 2. 准备数据，将数据拷贝到 dev
        // Pattern Buf Host -> Dev
        if (hcclMgr_.SyncBuf2Dev(hostBuf) != 0) {
            return -1;
        }

        //  CommContext Host -> Dev
        if (hcclMgr_.SyncContext2Dev() != 0) {
            return -1;
        }

        // 3. Barrier 同步后执行 Kernel
        if (TcpBarrier(sock) != 0) {
            return -1;
        }
        // 4. 执行核函数
        kernel_hcomm_write_read_nbi<<<1, nullptr, stream>>>(devContext);

        if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
            return -1;
        }

        // 5. 再次 Barrier 同步，确保双方都完成计算后再回读校验
        if (TcpBarrier(sock) != 0) {
            return -1;
        }
        // 6. 将 buf 和 context 拷贝回 host，校验结果
        HcommExample::CommContext resultCtx = {};
        std::vector<uint8_t> resultBuf(static_cast<size_t>(COMM_BUF_SIZE), 0);
        if (hcclMgr_.SyncBuf2Host(resultBuf) != 0) {
            return -1;
        }
        if (hcclMgr_.SyncContext2Host(resultCtx) != 0) {
            return -1;
        }

        return VailidateRes(resultBuf, resultCtx, peerPattern);
    }

private:
    bool GenPattern(std::vector<uint8_t>& hostBuf)
    {
        uint32_t seed = static_cast<uint32_t>(time(nullptr)) ^ (rank_ * 0x9E3779B9U);
        for (uint32_t i = 0; i < DATA_SIZE; i++) {
            seed = seed * 1664525U + 1013904223U;
            hostBuf[i] = static_cast<uint8_t>(seed >> 16);
        }
        return true;
    }

    int32_t VailidateRes(
        std::vector<uint8_t>& resultBuf, HcommExample::CommContext& resultCtx, std::vector<uint8_t>& peerPattern)
    {
        uint32_t hostCheckResult = resultCtx.testResult;
        uint32_t mismatchIndex = resultCtx.mismatchIndex;
        uint32_t actualValue = resultCtx.actualValue;
        uint32_t expectedValue = resultCtx.expectedValue;

        if (hostCheckResult == 0) {
            for (uint32_t i = 0; i < DATA_SIZE; i++) {
                if (resultBuf[DATA_SIZE + i] != peerPattern[i]) { // seg1 校验
                    hostCheckResult = 6;
                    mismatchIndex = i;
                    actualValue = resultBuf[DATA_SIZE + i];
                    expectedValue = peerPattern[i];
                    break;
                }
            }
        }
        if (hostCheckResult == 0) {
            for (uint32_t i = 0; i < DATA_SIZE; i++) {
                if (resultBuf[2 * DATA_SIZE + i] != peerPattern[i]) { // seg2 校验
                    hostCheckResult = 7;
                    mismatchIndex = i;
                    actualValue = resultBuf[2 * DATA_SIZE + i];
                    expectedValue = peerPattern[i];
                    break;
                }
            }
        }

        if (hostCheckResult == 0) {
            printf("rank %u test pass!\n", rank_);
            return 0;
        } else {
            printf(
                "rank %u test failed! result=%u mismatchIndex=%u actual=0x%02x expected=0x%02x\n", rank_,
                hostCheckResult, mismatchIndex, actualValue, expectedValue);
            return -1;
        }
    }
};

// 单rank执行流程，供fork后的子进程调用
int32_t RunRank(uint32_t rank, uint32_t nranks, const std::string& endpoint)
{
    HcommWorker worker(rank, nranks, endpoint);
    if (!worker.Init()) {
        return -1;
    }
    return worker.Run();
}

int32_t main(int32_t argc, char* argv[])
{
    // 无参数：自动fork两个子进程后台执行
    if (argc == 1) {
        std::string endpoint = DEFAULT_ENDPOINT;
        pid_t pid1 = fork();
        if (pid1 < 0) {
            fprintf(stderr, "[ERROR] fork failed\n");
            return -1;
        }
        if (pid1 == 0) {
            // 子进程1：rank 0
            _exit(RunRank(0, NRANKS, endpoint));
        }
        // 父进程稍等rank 0启动server
        usleep(200000);
        pid_t pid2 = fork();
        if (pid2 < 0) {
            fprintf(stderr, "[ERROR] fork failed\n");
            kill(pid1, SIGKILL);
            waitpid(pid1, nullptr, 0);
            return -1;
        }
        if (pid2 == 0) {
            // 子进程2：rank 1
            _exit(RunRank(1, NRANKS, endpoint));
        }
        // 父进程等待两个子进程结束
        int32_t status1 = 0;
        int32_t status2 = 0;
        waitpid(pid1, &status1, 0);
        waitpid(pid2, &status2, 0);
        int32_t ret1 = WIFEXITED(status1) ? WEXITSTATUS(status1) : -1;
        int32_t ret2 = WIFEXITED(status2) ? WEXITSTATUS(status2) : -1;
        if (ret1 == 0 && ret2 == 0) {
            printf("test pass!\n");
            return 0;
        }
        printf("test failed! rank0=%d rank1=%d\n", ret1, ret2);
        return -1;
    }

    // 有参数：单进程运行指定rank
    if (argc < 4) {
        fprintf(stderr, "Usage: %s [<rank> <nranks> <endpoint>]\n", argv[0]);
        fprintf(stderr, "  No args: auto fork two processes (rank0, rank1 symmetric write+read)\n");
        fprintf(stderr, "  With args: run single rank, e.g. %s 0 2 tcp://127.0.0.1:29621\n", argv[0]);
        return -1;
    }

    uint32_t rank = static_cast<uint32_t>(atoi(argv[1]));
    uint32_t nranks = static_cast<uint32_t>(atoi(argv[2]));
    std::string endpoint = argv[3];
    if (nranks != NRANKS || rank >= NRANKS) {
        fprintf(stderr, "[ERROR] nranks must be %u, rank must be 0~%u\n", NRANKS, NRANKS - 1);
        return -1;
    }
    return RunRank(rank, nranks, endpoint);
}
