#include "kernel_operator.h"
#include "adv_api/hcomm/hcomm.h"

// Hcomm工作空间大小下限，小于此值Init返回失败
constexpr uint32_t HCOMM_WORKSPACE_SIZE = 512U;
// 单次通信数据量（字节），需32字节对齐
constexpr uint32_t DATA_SIZE = 256U;
// 每张卡的通信窗口大小：4段DATA_SIZE（seg0/seg1/seg2/expected）< COMM_BUF_SIZE
constexpr uint64_t COMM_BUF_SIZE = 4096U;
// 通信卡数：样例简化为2卡点对点，可扩展为星形拓扑支持N卡
constexpr uint32_t NRANKS = 2U;
// UBC_CTP通道需要的notify资源数量，需在HcclChannelAcquire前写入channelDesc
constexpr uint32_t CHANNEL_NOTIFY_NUM = 3U;
// Host侧建链协议需与Kernel侧Hcomm模板协议保持一致
constexpr CommProtocol TARGET_COMM_PROTOCOL = COMM_PROTOCOL_UBC_CTP;
// 最少的卡数
constexpr uint16_t MIN_RANKS = 2U;

namespace HcommExample {

// Kernel与Host共享的通信上下文，存放在GM上
// Host侧构造后通过aclrtMemcpy下发到各卡GM，Kernel侧Init时从GM读取
struct CommContext {
    uint64_t channelHandle; // 本rank到对端的通道句柄
    uint64_t localBufferAddr; // 本rank的通信buffer基址（4段：seg0=本地pattern, seg1=WriteNbi目的, seg2=ReadNbi目的,
                              // seg3=对端pattern期望值）
    uint64_t remoteBufferAddr; // 对端的通信buffer基址
    uint32_t rankId;           // 本rank编号
    uint32_t worldSize;        // 通信域rank总数
    // 校验结果：kernel写入，host读回。0=通过，非0=失败
    uint32_t testResult;
    uint32_t mismatchIndex;
    uint32_t actualValue;
    uint32_t expectedValue;
};

class KernelHcommWriteRead {
public:
    __aicore__ inline KernelHcommWriteRead() {}

    __aicore__ inline void Init(GM_ADDR context, AscendC::TPipe *pipe)
    {
        tpipe_ = pipe;
        context_ = reinterpret_cast<__gm__ CommContext*>(context);
        channel_ = context_->channelHandle;
        localBuf_ = reinterpret_cast<GM_ADDR>(context_->localBufferAddr);
        remoteBuf_ = reinterpret_cast<GM_ADDR>(context_->remoteBufferAddr);
        rankId_ = context_->rankId;
        worldSize_ = context_->worldSize;

        // Hcomm内部WQE/CQE队列需要一块UB空间存放，调用Init分配并初始化工作空间
        tpipe_->InitBuffer(hcommBuf_, HCOMM_WORKSPACE_SIZE);
        hcommTensor_ = hcommBuf_.Get<uint8_t>();
        if (hcomm_.Init(hcommTensor_, HCOMM_WORKSPACE_SIZE) != AscendC::HCOMM_SUCCESS) {
            initOk_ = false;
        }
    }

    __aicore__ inline void Process()
    {
        context_->testResult = 0;
        context_->mismatchIndex = 0;
        context_->actualValue = 0;
        context_->expectedValue = 0;
        // worldSize_是总卡数，必须>=2，不然无法构成通信的两个节点
        if (!initOk_ || worldSize_ < MIN_RANKS || rankId_ >= worldSize_) {
            Fail(1);
            return;
        }

        DoWriteAndRead();
    }

private:
    // 两卡对称执行WriteNbi+ReadNbi，通过偏移区分四段地址：
    //   seg0: [0, DATA_SIZE)             本卡pattern（Host预初始化，随机值）
    //   seg1: [DATA_SIZE, 2*DATA_SIZE)   接收对端WriteNbi写入的数据
    //   seg2: [2*DATA_SIZE, 3*DATA_SIZE) 接收本卡ReadNbi从对端seg0读回的数据
    __aicore__ inline void DoWriteAndRead()
    {
        // WriteNbi(channel, dst=远端seg1, src=本地seg0, len)：将本地pattern写入对端seg1
        GM_ADDR localSrc = reinterpret_cast<GM_ADDR>(localBuf_);
        GM_ADDR remoteDst = remoteBuf_ + DATA_SIZE;
        if (hcomm_.WriteNbi(channel_, remoteDst, localSrc, DATA_SIZE) != AscendC::HCOMM_SUCCESS) {
            Fail(2);
            return;
        }

        // ReadNbi(channel, dst=本地seg2, src=远端seg0, len)：从对端seg0读回pattern到本地seg2
        __gm__ uint8_t* readDst = localBuf_ + 2 * DATA_SIZE;
        GM_ADDR localDst = reinterpret_cast<GM_ADDR>(readDst);
        if (hcomm_.ReadNbi(channel_, localDst, remoteBuf_, DATA_SIZE) != AscendC::HCOMM_SUCCESS) {
            Fail(3);
            return;
        }

        // Drain轮询CQ等待通信任务完成，返回后数据可见性才有保证
        if (hcomm_.Drain(channel_) != AscendC::HCOMM_SUCCESS) {
            Fail(4);
            return;
        }
    }

    __aicore__ inline void Fail(uint32_t code) { context_->testResult = code; }

    AscendC::TPipe *tpipe_{nullptr};
    AscendC::TBuf<AscendC::TPosition::VECOUT> hcommBuf_;
    AscendC::LocalTensor<uint8_t> hcommTensor_;
    // COMM_PROTOCOL_UBC_CTP（URMA协议）适用于Ascend 950系列；RoCE协议使用COMM_PROTOCOL_ROCE
    AscendC::Hcomm<AscendC::COMM_PROTOCOL_UBC_CTP> hcomm_;
    __gm__ CommContext* context_{nullptr};
    AscendC::ChannelHandle channel_{0};
    __gm__ uint8_t* localBuf_{nullptr};
    GM_ADDR remoteBuf_{nullptr};
    uint32_t rankId_{0};
    uint32_t worldSize_{0};
    bool initOk_{true};
};

} // namespace HcommExample

// using namespace HcommExample;

// Kernel入口
extern "C" __global__ __aicore__ void kernel_hcomm_write_read_nbi(GM_ADDR context)
{
    AscendC::TPipe pipe;
    HcommExample::KernelHcommWriteRead op;
    op.Init(context, &pipe);
    op.Process();
}

// ============================================================================
// Host侧主函数：多进程方式，每个进程对应一个rank
// 用法:
//   ./demo [<rank> <nranks> <endpoint>]
//   无参数时自动fork两个子进程（两卡对称执行WriteNbi+ReadNbi），使用默认endpoint
//   有参数时单进程运行指定rank: ./demo 0 2 tcp://127.0.0.1:29621
//   endpoint 格式: tcp://<ip>:<port>，用于进程间TCP通信交换rootInfo和同步
// ============================================================================

// 默认endpoint
constexpr const char* DEFAULT_ENDPOINT = "tcp://127.0.0.1:29621";

// 单rank执行流程，供fork后的子进程调用
static int32_t RunRank(uint32_t rank, uint32_t nranks, const std::string &endpoint);

// rank 0作为server监听，rank 1作为client连接，建立TCP通道
static int32_t ConnectPeer(uint32_t rank, const std::string &ip, uint16_t port, int32_t &sock)
{
    if (rank == 0) {
        int32_t listenSock = socket(AF_INET, SOCK_STREAM, 0);
        if (listenSock < 0) {
            return -1;
        }
        int32_t opt = 1;
        setsockopt(listenSock, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
        struct sockaddr_in addr = {};
        addr.sin_family = AF_INET;
        addr.sin_port = htons(port);
        inet_pton(AF_INET, ip.c_str(), &addr.sin_addr);
        if (bind(listenSock, reinterpret_cast<struct sockaddr*>(&addr), sizeof(addr)) < 0 ||
            listen(listenSock, 1) < 0) {
            close(listenSock);
            return -1;
        }
        sock = accept(listenSock, nullptr, nullptr);
        close(listenSock);
        return sock < 0 ? -1 : 0;
    } else {
        sock = socket(AF_INET, SOCK_STREAM, 0);
        if (sock < 0) {
            return -1;
        }
        struct sockaddr_in addr = {};
        addr.sin_family = AF_INET;
        addr.sin_port = htons(port);
        inet_pton(AF_INET, ip.c_str(), &addr.sin_addr);
        // 重试连接，等待rank 0的server就绪
        for (int32_t i = 0; i < 100; i++) {
            if (connect(sock, reinterpret_cast<struct sockaddr*>(&addr), sizeof(addr)) == 0) {
                return 0;
            }
            usleep(100000); // 100ms
        }
        close(sock);
        return -1;
    }
}

// 通过socket收发完整数据
static int32_t SendAll(int32_t sock, const void *buf, size_t len)
{
    size_t sent = 0;
    while (sent < len) {
        ssize_t n = send(sock, static_cast<const char*>(buf) + sent, len - sent, 0);
        if (n <= 0) {
            return -1;
        }
        sent += static_cast<size_t>(n);
    }
    return 0;
}

static int32_t RecvAll(int32_t sock, void *buf, size_t len)
{
    size_t received = 0;
    while (received < len) {
        ssize_t n = recv(sock, static_cast<char*>(buf) + received, len - received, 0);
        fprintf(stderr, "[INFO] recvall recv %zd bytes\n", n);
        if (n <= 0) {
            int code = errno;
            fprintf(stderr, "[ERROR] recvall code=%s\n", strerror(code));
            return -1;
        }
        received += static_cast<size_t>(n);
    }
    return 0;
}

// 通过TCP交换rootInfo：rank 0生成rootInfo后发送给rank 1
static int32_t ExchangeRootInfo(uint32_t rank, int32_t sock, HcclRootInfo *rootInfo)
{
    if (rank == 0) {
        HcclResult r = HcclGetRootInfo(rootInfo);
        if (r != HCCL_SUCCESS) {
            fprintf(stderr, "[ERROR] HcclGetRootInfo failed, ret=%d\n", static_cast<int32_t>(r));
            return -1;
        }
        if (SendAll(sock, rootInfo, sizeof(HcclRootInfo)) != 0) {
            fprintf(stderr, "[ERROR] send rootInfo failed\n");
            return -1;
        }
    } else {
        if (RecvAll(sock, rootInfo, sizeof(HcclRootInfo)) != 0) {
            fprintf(stderr, "[ERROR] recv rootInfo failed\n");
            return -1;
        }
    }
    return 0;
}

// TCP barrier：双方各发一个int再收一个int，确保同时到达同步点
static int32_t TcpBarrier(int32_t sock)
{
    int32_t flag = 1;
    if (SendAll(sock, &flag, sizeof(flag)) != 0) {
        fprintf(stderr, "[ERROR] TcpBarrier sendall failed\n");
        return -1;
    }
    int32_t recv = 0;
    if (RecvAll(sock, &recv, sizeof(recv)) != 0) {
        fprintf(stderr, "[ERROR] TcpBarrier recvall failed\n");
        return -1;
    };
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    // 无参数：自动fork两个子进程后台执行
    if (argc == 1) {
        std::string endpoint = DEFAULT_ENDPOINT;
        pid_t pid1 = fork();
        if (pid1 < 0) {
            fprintf(stderr, "[ERROR] fork failed\n");
            return -1;
        }
        if (pid1 == 0) {
            // 子进程1：rank 0
            _exit(RunRank(0, NRANKS, endpoint));
        }
        // 父进程稍等rank 0启动server
        usleep(200000);
        pid_t pid2 = fork();
        if (pid2 < 0) {
            fprintf(stderr, "[ERROR] fork failed\n");
            kill(pid1, SIGKILL);
            waitpid(pid1, nullptr, 0);
            return -1;
        }
        if (pid2 == 0) {
            // 子进程2：rank 1
            _exit(RunRank(1, NRANKS, endpoint));
        }
        // 父进程等待两个子进程结束
        int32_t status1 = 0;
        int32_t status2 = 0;
        waitpid(pid1, &status1, 0);
        waitpid(pid2, &status2, 0);
        int32_t ret1 = WIFEXITED(status1) ? WEXITSTATUS(status1) : -1;
        int32_t ret2 = WIFEXITED(status2) ? WEXITSTATUS(status2) : -1;
        if (ret1 == 0 && ret2 == 0) {
            printf("test pass!\n");
            return 0;
        }
        printf("test failed! rank0=%d rank1=%d\n", ret1, ret2);
        return -1;
    }

    // 有参数：单进程运行指定rank
    if (argc < 4) {
        fprintf(stderr, "Usage: %s [<rank> <nranks> <endpoint>]\n", argv[0]);
        fprintf(stderr, "  No args: auto fork two processes (rank0, rank1 symmetric write+read)\n");
        fprintf(stderr, "  With args: run single rank, e.g. %s 0 2 tcp://127.0.0.1:29621\n", argv[0]);
        return -1;
    }

    uint32_t rank = static_cast<uint32_t>(atoi(argv[1]));
    uint32_t nranks = static_cast<uint32_t>(atoi(argv[2]));
    std::string endpoint = argv[3];
    if (nranks != NRANKS || rank >= NRANKS) {
        fprintf(stderr, "[ERROR] nranks must be %u, rank must be 0~%u\n", NRANKS, NRANKS - 1);
        return -1;
    }
    return RunRank(rank, nranks, endpoint);
}

static int32_t InitAclEnvironment(uint32_t rank, aclrtStream& stream) {
    aclError ret = ACL_SUCCESS;
    ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) { 
        // 【关键】：aclInit 失败时，底层环境没建立起来，绝对不能调用 aclFinalize()，否则会引发二次崩溃。
        fprintf(stderr, "[ERROR] rank %u: aclInit failed, ret=%d\n", rank, (int)ret);
        return -1; // 直接退出
    }

    uint32_t devCount = 0;
    aclrtGetDeviceCount(&devCount);
    fprintf(stderr, "[INFO] dev cnt = %d\n", devCount);
    
    ret = aclrtSetDevice(rank);
    if (ret != ACL_SUCCESS) { 
        fprintf(stderr, "[ERROR] rank %u: aclrtSetDevice(%u) failed, ret=%d\n", rank, rank, (int)ret);
        // 【关键】：SetDevice 失败意味着设备没绑定成功，所以不需要调用 aclrtResetDevice()，
        // 只需要调用 aclFinalize() 清理 aclInit 的状态即可。
        aclFinalize();
        return -1;
    }
    
    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) { 
        fprintf(stderr, "[ERROR] rank %u: aclrtCreateStream(%u) failed, ret=%d\n", rank, rank, (int)ret);
        aclFinalize();
        return -1;
    }
    return 0;
}

static int32_t InitHcclComm(uint32_t rank, uint32_t nranks, const std::string& ip, 
                            uint16_t port, int32_t& sock, HcclComm& comm) {

    // 1. 建立TCP连接，交换rootInfo，barrier同步后创建通信域
    // 950需多进程方式：每进程一个rank，通过TCP交换rootInfo后各自调用HcclCommInitRootInfo
    if (ConnectPeer(rank, ip, port, sock) != 0) {
        fprintf(stderr, "[ERROR] rank %u connect peer failed\n", rank);
        return -1;
    }
    
    HcclRootInfo rootInfo;
    if (ExchangeRootInfo(rank, sock, &rootInfo) != 0) return -1;

    // barrier确保两个rank都拿到rootInfo后再同时调用HcclCommInitRootInfo
    // if (TcpBarrier(sock) == -1) return -1;
    
    // AIV直驱模式，无需配置hcclOpExpansionMode
    HcclCommConfig config;
    HcclCommConfigInit(&config);
    config.hcclWorldRankID = rank;
    HcclResult hcclRet = HcclCommInitRootInfoConfig(nranks, &rootInfo, rank, &config, &comm);
 
    if (hcclRet != HCCL_SUCCESS) {
        fprintf(stderr, "[ERROR] rank %u HcclCommInitRootInfo failed, ret=%d\n", rank, static_cast<int32_t>(hcclRet));
        return -1;
    }
    return 0;
}

static int32_t RunRank(uint32_t rank, uint32_t nranks, const std::string &endpoint)
{
    std::string ip;
    uint16_t port = 0;
    if (!ParseEndpoint(endpoint, ip, port)) {
        fprintf(stderr, "[ERROR] invalid endpoint: %s\n", endpoint.c_str());
        return -1;
    }

    // 参考hccl_op样例的初始化顺序：先aclInit+SetDevice+CreateStream，再交换rootInfo
    aclrtStream stream = nullptr;

    // 1. 建立TCP连接，交换rootInfo，barrier同步后创建通信域
    // 950需多进程方式：每进程一个rank，通过TCP交换rootInfo后各自调用HcclCommInitRootInfo
    int32_t sock = -1;

    HcclComm comm = nullptr;

    // 2. 分配通信buffer、注册内存、创建到对端的P2P通道、获取对端内存地址
    void* devBuf = nullptr;
    uint8_t* devContext = nullptr;
    // 默认失败，只有Kernel校验通过才置0，避免中途break后父进程误判通过
    int32_t runRet = -1;

    do {
        if (InitAclEnvironment(rank, stream) != 0) break;
        if (InitHcclComm(rank, nranks, ip, port, sock, comm) != 0) break;

        aclError mallocRet = aclrtMalloc(&devBuf, COMM_BUF_SIZE, ACL_MEM_MALLOC_HUGE_ONLY);
        if (mallocRet != ACL_SUCCESS || devBuf == nullptr) {
            fprintf(stderr, "[ERROR] rank %u aclrtMalloc failed, ret=%d\n", rank, (int32_t)mallocRet);
            break; // 直接 break 出 do-while，走到最后的统一资源清理逻辑
        }

        CommMem regMem = {};
        regMem.type = COMM_MEM_TYPE_DEVICE;
        regMem.addr = devBuf;
        regMem.size = COMM_BUF_SIZE;
        
        HcclResult hcclRet;
        HcclMemHandle memHandle = nullptr;
        hcclRet = HcclCommMemReg(comm, "shareBuf", &regMem, &memHandle);
        if (hcclRet != HCCL_SUCCESS || memHandle == nullptr) {
            fprintf(
                stderr, "[ERROR] rank %u HcclCommMemReg failed, ret=%d memHandle=%p\n", rank, static_cast<int32_t>(hcclRet),
                memHandle);
            break;
        }

        // 创建到对端的P2P通道
        uint32_t peerRank = (rank + 1U) % nranks;
        HcclChannelDesc channelDesc;
        HcclChannelDescInit(&channelDesc, 1);
        channelDesc.remoteRank = peerRank;
        channelDesc.channelProtocol = TARGET_COMM_PROTOCOL;
        // notifyNum由通道实现使用，需与URMA/UBC_CTP通道要求保持一致
        // channelDesc.notifyNum = CHANNEL_NOTIFY_NUM;
        channelDesc.memHandles = &memHandle;
        channelDesc.memHandleNum = 1;

        // 单机双卡样例只有一层网络，取第0层中的UBC_CTP链路填充endpoint
        uint32_t* netLayers = nullptr;
        uint32_t netLayerNum = 0;
        hcclRet = HcclRankGraphGetLayers(comm, &netLayers, &netLayerNum);
        if (hcclRet != HCCL_SUCCESS || netLayerNum == 0) {
            fprintf(stderr, "[ERROR] rank %u HcclRankGraphGetLayers failed, ret=%d\n", rank, static_cast<int32_t>(hcclRet));
            break;
        }
        uint32_t layerId = netLayers[0];
        CommLink* links = nullptr;
        uint32_t linkNum = 0;
        hcclRet = HcclRankGraphGetLinks(comm, layerId, rank, peerRank, &links, &linkNum);
        if (hcclRet != HCCL_SUCCESS || linkNum == 0 || links == nullptr) {
            fprintf(
                stderr, "[ERROR] rank %u HcclRankGraphGetLinks failed, ret=%d linkNum=%u\n", rank, static_cast<int32_t>(hcclRet),
                linkNum);
            break;
        }
        bool linkFound = false;
        for (uint32_t i = 0; i < linkNum; i++) {
            if (links[i].linkAttr.linkProtocol == TARGET_COMM_PROTOCOL) {
                channelDesc.localEndpoint = links[i].srcEndpointDesc;
                channelDesc.remoteEndpoint = links[i].dstEndpointDesc;
                linkFound = true;
                break;
            }
        }
        if (!linkFound) {
            fprintf(stderr, "[ERROR] rank %u no matching link for UBC_CTP protocol\n", rank);
            break;
        }

        ChannelHandle channel = 0;
        hcclRet = HcclChannelAcquire(comm, COMM_ENGINE_AIV, &channelDesc, 1, &channel);
        if (hcclRet != HCCL_SUCCESS || channel == 0) {
            fprintf(
                stderr, "[ERROR] rank %u HcclChannelAcquire failed, ret=%d channel=%lu\n", rank, static_cast<int32_t>(hcclRet),
                static_cast<unsigned long>(channel));
            break;
        }

        // 获取对端注册的内存地址
        uint32_t memNum = 0;
        CommMem* remoteMems = nullptr;
        char** memTags = nullptr;
        hcclRet = HcclChannelGetRemoteMems(comm, channel, &memNum, &remoteMems, &memTags);
        if (hcclRet != HCCL_SUCCESS || memNum == 0 || remoteMems == nullptr) {
            fprintf(
                stderr, "[ERROR] rank %u HcclChannelGetRemoteMems failed, ret=%d memNum=%u remoteMems=%p\n", rank,
                static_cast<int32_t>(hcclRet), memNum, remoteMems);
            break;
        }
        uint64_t remoteBufAddr = 0;
        // 通道可能交换多块注册内存，优先按注册tag找到本样例使用的shareBuf
        for (uint32_t i = 0; i < memNum; i++) {
            if (memTags != nullptr && memTags[i] != nullptr && std::strcmp(memTags[i], "shareBuf") == 0) {
                remoteBufAddr = reinterpret_cast<uint64_t>(remoteMems[i].addr);
                break;
            }
        }
        // 当前样例只注册一块内存时，兼容未返回tag的场景
        if (remoteBufAddr == 0 && memNum == 1) {
            remoteBufAddr = reinterpret_cast<uint64_t>(remoteMems[0].addr);
        }
        if (remoteBufAddr == 0) {
            fprintf(stderr, "[ERROR] rank %u no remote memory for shareBuf\n", rank);
            break;
        }

        // 3. 生成随机pattern写入seg0，通过TCP交换对端pattern写入seg3
        //    两卡同时执行kernel，Host预初始化seg0可消除竞态
        // seed做的两次数学计算，目的是生成用于通信校验的随机数据
        // 0x9E3779B9U(Knuth 的乘法哈希常数，黄金分割常数)
        std::vector<uint8_t> hostBuf(static_cast<size_t>(COMM_BUF_SIZE), 0);
        uint32_t seed = static_cast<uint32_t>(time(nullptr)) ^ (rank * 0x9E3779B9U);
        for (uint32_t i = 0; i < DATA_SIZE; i++) {
            //线性同余伪随机数生成器参数(LCG)
            seed = seed * 1664525U + 1013904223U;
            hostBuf[i] = static_cast<uint8_t>(seed >> 16);
        }
        // 通过TCP交换各自的seg0 pattern，写入对端期望区域seg3
        std::vector<uint8_t> peerPattern(DATA_SIZE, 0);
        SendAll(sock, hostBuf.data(), DATA_SIZE);
        RecvAll(sock, peerPattern.data(), DATA_SIZE);
        for (uint32_t i = 0; i < DATA_SIZE; i++) {
            hostBuf[3 * DATA_SIZE + i] = peerPattern[i];
        }

        aclError ret = ACL_SUCCESS;
        ret = aclrtMemcpy(devBuf, COMM_BUF_SIZE, hostBuf.data(), COMM_BUF_SIZE, ACL_MEMCPY_HOST_TO_DEVICE);
        if( ret != ACL_SUCCESS) {
            fprintf(stderr, "[ERROR] rank %u: aclrtMemcpy failed, ret=%d\n", rank, (int)ret);
            break;
        }

        // 4. 构造CommContext并下发到GM，Kernel侧Init从GM读取
        HcommExample::CommContext hostCtx = {};
        hostCtx.channelHandle = channel;
        hostCtx.localBufferAddr = reinterpret_cast<uint64_t>(devBuf);
        hostCtx.remoteBufferAddr = remoteBufAddr;
        hostCtx.rankId = rank;
        hostCtx.worldSize = nranks;
        hostCtx.testResult = 0;
        hostCtx.mismatchIndex = 0;
        hostCtx.actualValue = 0;
        hostCtx.expectedValue = 0;
        ret = aclrtMalloc(reinterpret_cast<void**>(&devContext), sizeof(HcommExample::CommContext), ACL_MEM_MALLOC_HUGE_ONLY);
        if (ret != ACL_SUCCESS || devContext == nullptr) {
            fprintf(stderr, "[ERROR] rank %u: aclrtMalloc failed, ret=%d\n", rank, (int)ret);
            break;
        }
        ret = aclrtMemcpy(devContext, sizeof(HcommExample::CommContext), &hostCtx, sizeof(HcommExample::CommContext), ACL_MEMCPY_HOST_TO_DEVICE);
        if (ret != ACL_SUCCESS) {
            fprintf(stderr, "[ERROR] rank %u: aclrtMemcpy failed, ret=%d\n", rank, (int)ret);
            break;
        }

        // 5. 两卡同时执行kernel：对称执行WriteNbi+ReadNbi。
        //    barrier确保两卡都完成seg0预初始化后再launch，消除跨卡竞态
        // if (TcpBarrier(sock)) break;
        kernel_hcomm_write_read_nbi<<<1, nullptr, stream>>>(devContext);
        aclrtSynchronizeStream(stream);

        // 6. 两个rank的kernel都完成后再回读并校验。
        // 先执行完 rw 操作的 rank 等待另一张 rank 执行完
        if (TcpBarrier(sock)) break;
        HcommExample::CommContext resultCtx = {};
        ret = aclrtMemcpy(&resultCtx, sizeof(HcommExample::CommContext), devContext, sizeof(HcommExample::CommContext), ACL_MEMCPY_DEVICE_TO_HOST);
        if (ret != ACL_SUCCESS) {
            fprintf(stderr, "[ERROR] rank %u: aclrtMemcpy failed, ret=%d\n", rank, (int)ret);
            break;
        }
        std::vector<uint8_t> resultBuf(static_cast<size_t>(COMM_BUF_SIZE), 0);
        ret = aclrtMemcpy(resultBuf.data(), COMM_BUF_SIZE, devBuf, COMM_BUF_SIZE, ACL_MEMCPY_DEVICE_TO_HOST);
        if (ret != ACL_SUCCESS) {
            fprintf(stderr, "[ERROR] rank %u: aclrtMemcpy failed, ret=%d\n", rank, (int)ret);
            break;
        }
        
        uint32_t hostCheckResult = resultCtx.testResult;
        uint32_t mismatchIndex = resultCtx.mismatchIndex;
        uint32_t actualValue = resultCtx.actualValue;
        uint32_t expectedValue = resultCtx.expectedValue;
        if (hostCheckResult == 0) {
            for (uint32_t i = 0; i < DATA_SIZE; i++) {
                if (resultBuf[DATA_SIZE + i] != peerPattern[i]) {
                    // seg1 出错，对端write出错
                    hostCheckResult = 6;
                    mismatchIndex = i;
                    actualValue = resultBuf[DATA_SIZE + i];
                    expectedValue = peerPattern[i];
                    break;
                }
            }
        }
        if (hostCheckResult == 0) {
            for (uint32_t i = 0; i < DATA_SIZE; i++) {
                if (resultBuf[2 * DATA_SIZE + i] != peerPattern[i]) {
                    // seg2 出错，本端read出错
                    hostCheckResult = 7;
                    mismatchIndex = i;
                    actualValue = resultBuf[2 * DATA_SIZE + i];
                    expectedValue = peerPattern[i];
                    break;
                }
            }
        }

        if (hostCheckResult == 0) {
            printf("rank %u test pass!\n", rank);
            runRet = 0;
        } else {
            printf(
                "rank %u test failed! result=%u mismatchIndex=%u actual=0x%02x expected=0x%02x\n", rank,
                hostCheckResult, mismatchIndex, actualValue, expectedValue);
        }
    } while (0);

    if (devContext) aclrtFree(devContext);
    if (devBuf) aclrtFree(devBuf);
    aclrtDestroyStream(stream);
    if (comm != nullptr) {
        HcclCommDestroy(comm);
    }
    aclrtResetDevice(rank);
    aclFinalize();
    close(sock);
    return runRet;
}