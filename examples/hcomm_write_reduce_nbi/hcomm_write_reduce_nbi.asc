#include "acl/acl.h"
#include "hcomm/hcomm.h"
#include "kernel_operator.h"

constexpr uint32_t HCOMM_WORKSPACE_BYTES = 512;
constexpr uint64_t HCOMM_NOTIFY_VALUE = 1;
constexpr uint64_t HCOMM_NOTIFY_BYTES = sizeof(uint64_t);

enum class SampleDataType : uint32_t {
    INT8,
    INT16,
    INT32,
    UINT32,
    FP16,
    FP32,
    BFP16,
};

using HcommType = AscendC::Hcomm<AscendC::COMM_PROTOCOL_UBC_CTP>;

template <typename T, AscendC::HcommUrmaReduceOp reduceOp>
__aicore__ inline void RunWriteReduce(
    HcommType& hcomm, AscendC::ChannelHandle channel, __gm__ uint8_t* localAddr, __gm__ uint8_t* remoteAddr,
    __gm__ uint8_t* remoteNotifyAddr, __gm__ uint64_t* cycleOut, uint64_t count, uint32_t warmupTimes,
    uint32_t measureTimes)
{
    int32_t ret = AscendC::HCOMM_SUCCESS;
    for (uint32_t i = 0; i < warmupTimes; ++i) {
        ret = hcomm.WriteReduceNbi<false, PIPE_S, PIPE_MTE3, AscendC::URMA_DEFAULT_CFG, T, reduceOp>(
            channel, remoteAddr, localAddr, count);
        if (ret != AscendC::HCOMM_SUCCESS) {
            return;
        }
    }
    ret = hcomm.Commit(channel);
    if (ret != AscendC::HCOMM_SUCCESS) {
        return;
    }
    ret = hcomm.Drain(channel);
    if (ret != AscendC::HCOMM_SUCCESS) {
        return;
    }

    AscendC::PipeBarrier<PIPE_ALL>();
    uint64_t cycleBefore = static_cast<uint64_t>(AscendC::GetSystemCycle());
    for (uint32_t i = 0; i < measureTimes; ++i) {
        ret = hcomm.WriteReduceNbi<false, PIPE_S, PIPE_MTE3, AscendC::URMA_DEFAULT_CFG, T, reduceOp>(
            channel, remoteAddr, localAddr, count);
        if (ret != AscendC::HCOMM_SUCCESS) {
            return;
        }
    }
    AscendC::PipeBarrier<PIPE_ALL>();
    uint64_t cycleAfter = static_cast<uint64_t>(AscendC::GetSystemCycle());
    cycleOut[0] = cycleAfter - cycleBefore;

    ret = hcomm.Commit(channel);
    if (ret != AscendC::HCOMM_SUCCESS) {
        return;
    }
    ret = hcomm.Drain(channel);
    if (ret != AscendC::HCOMM_SUCCESS) {
        return;
    }

    ret = hcomm.WriteWithNotifyNbi<false>(
        channel, remoteNotifyAddr, localAddr, HCOMM_NOTIFY_BYTES, remoteNotifyAddr, HCOMM_NOTIFY_VALUE);
    if (ret != AscendC::HCOMM_SUCCESS) {
        return;
    }
    ret = hcomm.Commit(channel);
    if (ret != AscendC::HCOMM_SUCCESS) {
        return;
    }
    (void)hcomm.Drain(channel);
}

template <typename T>
__aicore__ inline void DispatchReduceOp(
    HcommType& hcomm, AscendC::ChannelHandle channel, __gm__ uint8_t* localAddr, __gm__ uint8_t* remoteAddr,
    __gm__ uint8_t* remoteNotifyAddr, __gm__ uint64_t* cycleOut, uint64_t count, uint32_t reduceOp,
    uint32_t warmupTimes, uint32_t measureTimes)
{
    switch (static_cast<AscendC::HcommUrmaReduceOp>(reduceOp)) {
        case AscendC::HcommUrmaReduceOp::MAX:
            RunWriteReduce<T, AscendC::HcommUrmaReduceOp::MAX>(
                hcomm, channel, localAddr, remoteAddr, remoteNotifyAddr, cycleOut, count, warmupTimes, measureTimes);
            break;
        case AscendC::HcommUrmaReduceOp::MIN:
            RunWriteReduce<T, AscendC::HcommUrmaReduceOp::MIN>(
                hcomm, channel, localAddr, remoteAddr, remoteNotifyAddr, cycleOut, count, warmupTimes, measureTimes);
            break;
        case AscendC::HcommUrmaReduceOp::SUM:
            RunWriteReduce<T, AscendC::HcommUrmaReduceOp::SUM>(
                hcomm, channel, localAddr, remoteAddr, remoteNotifyAddr, cycleOut, count, warmupTimes, measureTimes);
            break;
        default:
            break;
    }
}

__aicore__ inline void DispatchDataType(
    HcommType& hcomm, AscendC::ChannelHandle channel, __gm__ uint8_t* localAddr, __gm__ uint8_t* remoteAddr,
    __gm__ uint8_t* remoteNotifyAddr, __gm__ uint64_t* cycleOut, uint64_t count, uint32_t dataType, uint32_t reduceOp,
    uint32_t warmupTimes, uint32_t measureTimes)
{
    switch (static_cast<SampleDataType>(dataType)) {
        case SampleDataType::INT8:
            DispatchReduceOp<int8_t>(
                hcomm, channel, localAddr, remoteAddr, remoteNotifyAddr, cycleOut, count, reduceOp, warmupTimes,
                measureTimes);
            break;
        case SampleDataType::INT16:
            DispatchReduceOp<int16_t>(
                hcomm, channel, localAddr, remoteAddr, remoteNotifyAddr, cycleOut, count, reduceOp, warmupTimes,
                measureTimes);
            break;
        case SampleDataType::INT32:
            DispatchReduceOp<int32_t>(
                hcomm, channel, localAddr, remoteAddr, remoteNotifyAddr, cycleOut, count, reduceOp, warmupTimes,
                measureTimes);
            break;
        case SampleDataType::UINT32:
            DispatchReduceOp<uint32_t>(
                hcomm, channel, localAddr, remoteAddr, remoteNotifyAddr, cycleOut, count, reduceOp, warmupTimes,
                measureTimes);
            break;
        case SampleDataType::FP16:
            DispatchReduceOp<half>(
                hcomm, channel, localAddr, remoteAddr, remoteNotifyAddr, cycleOut, count, reduceOp, warmupTimes,
                measureTimes);
            break;
        case SampleDataType::FP32:
            DispatchReduceOp<float>(
                hcomm, channel, localAddr, remoteAddr, remoteNotifyAddr, cycleOut, count, reduceOp, warmupTimes,
                measureTimes);
            break;
        case SampleDataType::BFP16:
            DispatchReduceOp<bfloat16_t>(
                hcomm, channel, localAddr, remoteAddr, remoteNotifyAddr, cycleOut, count, reduceOp, warmupTimes,
                measureTimes);
            break;
        default:
            break;
    }
}

__vector__ __global__ void hcomm_write_reduce_nbi(
    AscendC::ChannelHandle channel, __gm__ uint8_t* localAddr, __gm__ uint8_t* remoteAddr,
    __gm__ uint8_t* remoteNotifyAddr, __gm__ uint64_t* cycleOut, uint64_t count, uint32_t dataType, uint32_t reduceOp,
    uint32_t warmupTimes, uint32_t measureTimes)
{
    AscendC::InitSocState();

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<uint8_t> workspace = ubAllocator.Alloc<uint8_t, HCOMM_WORKSPACE_BYTES>();

    HcommType hcomm;
    int32_t ret = hcomm.Init(reinterpret_cast<__ubuf__ uint8_t*>(workspace.GetPhyAddr()), HCOMM_WORKSPACE_BYTES);
    if (ret != AscendC::HCOMM_SUCCESS) {
        return;
    }
    DispatchDataType(
        hcomm, channel, localAddr, remoteAddr, remoteNotifyAddr, cycleOut, count, dataType, reduceOp, warmupTimes,
        measureTimes);
}

extern "C" void run_hcomm_single_jetty_multi_peer(
    AscendC::ChannelHandle channel, uint8_t* localAddr, uint8_t* remoteAddr, uint8_t* remoteNotifyAddr, uint64_t count,
    uint64_t* cycleOut, uint32_t dataType, uint32_t reduceOp, uint32_t warmupTimes, uint32_t measureTimes,
    aclrtStream stream)
{
    hcomm_write_reduce_nbi<<<1, 0, stream>>>(
        channel, localAddr, remoteAddr, remoteNotifyAddr, cycleOut, count, dataType, reduceOp, warmupTimes,
        measureTimes);
}
